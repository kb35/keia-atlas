---
// Reports and requests from room guides, live on a staff page (src/lib/guide-client.mjs). One line on the
// page: <GuideLive where="board" />, "office" with site, "home", or "room" (the room page's own block marks
// itself). With no `where` it only loads the script (the guide's own pages).
import { base } from '../lib/data.mjs';
interface Props { where?: 'board' | 'office' | 'home'; site?: string }
const { where, site } = Astro.props;
---
{where && <span hidden data-guide-host={where} data-site={site} data-base={base}></span>}
<script>
  import { mountAll } from '../lib/guide-client.mjs';
  mountAll();
  document.addEventListener('astro:page-load', mountAll);
</script>
