---
// Four equal tiles under a comms room's rack, on the same grid and in the same type as every room page's
// tiles: the questions a technician asks before touching anything. Rack space (how much is free), Access
// ports (how many are free, and the PoE the vendor states), Power (the UPS and its feeds) and Uplinks
// (where the room connects to). Everything comes from src/lib/comms.mjs; what the data does not hold says
// "Not recorded". What the room serves is in the band and in "Rooms it serves".
import { href, plural } from '../lib/data.mjs';
const { facts: f, size = null } = Astro.props;
const pct = (a, b) => (b ? Math.round((a / b) * 100) : 0);
const tone = (a, b) => (b && a / b >= 0.9 ? 'hi' : '');
const poe = f.poe.filter((p) => p.text);
// What the floor needs (src/lib/comms.mjs, sizeFor): the shortfall or spare against what is installed.
const need = (id) => size?.rows.find((r) => r.id === id) ?? null;
const portsNeed = need('ports'), rackNeed = need('rack');
---
<div class="g12 cm-sum">
  <section class="card side-card s-3" aria-labelledby="cm-u">
    <h3 id="cm-u" data-help="comms.space">Rack space</h3>
    {f.rackSpace ? (
      <>
        <p class="cm-big"><b class="num">{f.rackSpace.free}U</b> free <span class="faint">of {f.rackSpace.total}U</span></p>
        <div class={`cm-meter ${tone(f.rackSpace.used, f.rackSpace.total)}`} role="img" aria-label={`${f.rackSpace.used} of ${f.rackSpace.total} units used`}><i style={`width:${pct(f.rackSpace.used, f.rackSpace.total)}%`}></i></div>
        <p class="cm-foot">{f.rackSpace.used}U used.{f.rackSpace.kept.map((k) => ` ${k.size}U kept for ${k.label.replace(/^Space for /, '').toLowerCase()}.`)}</p>
        {rackNeed && rackNeed.v.tone !== 'faint' && <p class="cm-foot"><a href="#sizing">Needs {rackNeed.need}</a> for what it serves: <b class={rackNeed.v.tone === 'bad' ? 'cm-bad' : ''}>{rackNeed.v.text.toLowerCase()}</b>.</p>}
      </>
    ) : <p class="cm-foot faint">No rack recorded.</p>}
  </section>

  <section class="card side-card s-3" aria-labelledby="cm-ports">
    <h3 id="cm-ports" data-help="comms.ports">Access ports</h3>
    {f.ports?.known ? (
      <>
        <p class="cm-big"><b class="num">{f.ports.total - f.ports.used}</b> free <span class="faint">of {f.ports.total}</span></p>
        <div class={`cm-meter ${tone(f.ports.used, f.ports.total)}`} role="img" aria-label={`${f.ports.used} of ${f.ports.total} access ports patched`}><i style={`width:${pct(f.ports.used, f.ports.total)}%`}></i></div>
        <ul class="cm-lines">
          {f.ports.switches.map((s) => <li><span>{s.label}</span><b class="num">{s.used} of {s.total}</b></li>)}
          {f.outlets && <li><span>Outlets patched</span><b class="num">{f.outlets.live} of {f.outlets.total}</b></li>}
          {f.ports.av && <li><span>AV switch</span><b class="num">{f.ports.av.used} of {f.ports.av.total}</b></li>}
        </ul>
        {portsNeed && portsNeed.v.tone !== 'faint' && <p class="cm-foot"><a href="#sizing">Needs {portsNeed.need}</a> ({portsNeed.needNote}): <b class={portsNeed.v.tone === 'bad' ? 'cm-bad' : ''}>{portsNeed.v.text.toLowerCase()}</b>.</p>}
        {poe.length > 0 && <p class="cm-foot">PoE {poe.map((p) => `${p.text}${p.count > 1 ? ` on each of ${p.count}` : ''}`).join('; ')}, as the vendor states. The draw is not measured.</p>}
      </>
    ) : f.ports ? (
      <><p class="cm-big"><b class="num">{f.ports.total}</b> ports</p><p class="cm-foot faint">Which are patched is not recorded.</p></>
    ) : <p class="cm-foot faint">No access switches in this rack.</p>}
  </section>

  <section class="card side-card s-3" aria-labelledby="cm-pw">
    <h3 id="cm-pw" data-help="comms.power">Power</h3>
    {f.power.ups ? (
      <p class="cm-big cm-big-s"><b>{f.power.ups.model}</b>{f.power.battery && <span class="faint">, with a battery pack</span>}</p>
    ) : <p class="cm-big cm-big-s faint">No UPS recorded</p>}
    <ul class="cm-lines">
      <li><span>Feeds</span><b>{f.power.feeds.length ? f.power.feeds.join(' and ') : 'Not recorded'}</b></li>
      <li><span>Load and runtime</span><b class="faint">Not recorded</b></li>
    </ul>
    {f.power.strip && <p class="cm-foot">{plural(f.power.feeds.length || 1, 'power strip')} at the back: {f.power.strip.replace(/, 0U$/, '')}.</p>}
  </section>

  <section class="card side-card s-3" aria-labelledby="cm-up">
    <h3 id="cm-up" data-help="comms.uplinks">{f.isMdf ? 'Internet and uplinks' : 'Uplink'}</h3>
    <ul class="cm-links">
      {f.uplinks.map((u) => (
        <li class={`k-${u.kind}`}>
          <b>{u.to ? <a href={href(u.to)}>{u.title}</a> : u.title}</b>
          {u.sub && <small>{u.sub}</small>}
        </li>
      ))}
      {f.uplinks.length === 0 && <li class="faint">Not recorded.</li>}
    </ul>
    {f.oob.length > 0 && <p class="cm-foot">Out-of-band: {f.oob.map((o) => `${o.label.toLowerCase()} (${o.model})`).join('; ')}.</p>}
  </section>
</div>

<style is:global>
  .cm-sum .side-card { gap: 10px; }
  .cm-big { margin: 0; font-size: var(--fs-body); color: var(--text-2); }
  .cm-big b { font: var(--fw-title) 26px/1 var(--font-display, var(--font-sans)); color: var(--text); }
  .cm-big-s b { font: var(--fw-title) var(--fs-h3)/1.3 var(--font-sans); }
  .cm-lines { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; font-size: var(--fs-code); }
  .cm-lines li { display: flex; justify-content: space-between; gap: 12px; }
  .cm-lines li > span { color: var(--text-2); min-width: 0; }
  .cm-lines li > b { font-weight: var(--fw-name); white-space: nowrap; }
  .cm-links { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; }
  .cm-links b { display: block; font-size: var(--fs-body); font-weight: var(--fw-name); line-height: 1.3; }
  .cm-links small { display: block; font-size: var(--fs-code); color: var(--text-2); line-height: 1.35; margin-top: 1px; }
  .cm-foot { margin: 0; font-size: var(--fs-code); color: var(--text-2); line-height: 1.4; }
  .cm-foot b { color: var(--text); font-weight: var(--fw-name); } .cm-foot b.cm-bad { color: var(--red-ink); }
  .cm-meter { height: 7px; border-radius: 4px; background: var(--surface-3, var(--line)); overflow: hidden; }
  .cm-meter i { display: block; height: 100%; background: var(--blue); border-radius: inherit; transition: width var(--dur-morph) var(--ease-settle); }
  .cm-meter.hi i { background: var(--amber); }
</style>
