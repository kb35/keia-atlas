---
// Small line drawings of each device class (40 x 28 grid). Colour follows --art-line.
import { GLYPHS } from '../lib/glyphs.mjs';
const { cls, size = 40 } = Astro.props;
const G = GLYPHS;
---
<svg viewBox="0 0 40 28" width={size} height={size * 0.7} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={G[cls] ?? '<rect x="8" y="7" width="24" height="14" rx="2"/>'} />
