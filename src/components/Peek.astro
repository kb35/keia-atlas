---
/* Peek: the site-wide "hover to look, click to keep" card.
   Any element with data-peek and a <template data-peek-body> inside it gets a floating card:
   hover (or focus) shows it, a click pins it open, a second click, Escape or a click elsewhere hides it.
   The card lives on <body>, so it is never clipped or painted over by the grid it came from.
   Motion (M11, M12): it grows from the item it describes (--dur-pop, from --pop-scale) and shrinks back
   (--dur-exit); moving to the next item slides the open card there instead of closing and opening it. */
---
<div class="peek" data-peek-card role="dialog" aria-modal="false" hidden><div class="peek-in" data-peek-in></div><button type="button" class="peek-x" data-peek-x aria-label="Close">×</button></div>

<script is:inline data-astro-rerun>
  (function () {
    var card = document.querySelector('[data-peek-card]'); if (!card) return;
    var inner = card.querySelector('[data-peek-in]');
    var S = window.__rsPeek = window.__rsPeek || {};
    S.card = card; S.inner = inner; S.from = null; S.pinned = false;
    function place(el) {
      var r = el.getBoundingClientRect(), cw = card.offsetWidth, ch = card.offsetHeight, m = 10;
      var x = Math.min(Math.max(m, r.left + r.width / 2 - cw / 2), innerWidth - cw - m);
      var below = r.bottom + 8, y = below + ch > innerHeight - m && r.top - ch - 8 > m ? r.top - ch - 8 : below;
      var top = Math.max(m, Math.min(y, innerHeight - ch - m));
      card.style.left = x + 'px'; card.style.top = top + 'px';
      card.dataset.side = y < r.top ? 'above' : 'below';
      // Grow from, and shrink to, the middle of the item's near edge.
      card.style.transformOrigin = Math.round(r.left + r.width / 2 - x) + 'px ' + Math.round((y < r.top ? r.top : r.bottom) - top) + 'px';
    }
    S.show = function (el) {
      var t = el.querySelector('template[data-peek-body]'); if (!t) return;
      if (S.from && S.from !== el) S.from.classList.remove('peek-on', 'peek-pinned');
      var M = window.rsMotion ? window.rsMotion() : { reduced: true };
      var open = !card.hidden && !card.classList.contains('out'), r0 = open ? card.getBoundingClientRect() : null;
      clearTimeout(S.ht);
      S.from = el; inner.innerHTML = ''; inner.appendChild(t.content.cloneNode(true));
      card.hidden = false; el.classList.add('peek-on');
      if (open) card.classList.add('moving');
      card.classList.remove('out'); place(el);
      // Already open on another item: slide there (persist) rather than pop again.
      if (r0 && !M.reduced && card.animate) {
        var r1 = card.getBoundingClientRect(), dx = r0.left - r1.left, dy = r0.top - r1.top;
        if (Math.abs(dx) + Math.abs(dy) > 1) card.animate([{ transform: 'translate(' + dx + 'px,' + dy + 'px)' }, { transform: 'none' }], { duration: M.pop, easing: M.ease });
      }
      // Help on: the card also says what a preview is (the entry "peek" in src/lib/help.mjs).
      var H = window.__rsHelp;
      if (H && H.load && document.documentElement.getAttribute('data-help') === 'on') H.load().then(function (D) {
        var h = D['peek']; if (!h || S.from !== el) return;
        [['What it is', h.what], ['What to do', h.do]].forEach(function (r) {
          if (!r[1]) return;
          var e = document.createElement('em'), t = document.createElement('small');
          e.textContent = r[0]; t.textContent = r[1]; inner.appendChild(e); inner.appendChild(t);
        });
        place(el);
      });
    };
    S.hide = function (force) {
      if (S.pinned && !force) return;
      if (S.from) S.from.classList.remove('peek-on', 'peek-pinned');
      S.pinned = false; card.classList.remove('pinned', 'moving'); card.classList.add('out');
      var ex = window.rsMotion ? window.rsMotion().exit : 240;
      clearTimeout(S.ht); S.ht = setTimeout(function () { if (card.classList.contains('out')) card.hidden = true; }, ex);
      S.from = null;
    };
    if (window.__rsPeekHook) return;
    window.__rsPeekHook = true;
    var st;
    // While Help is on, a thing that has a help card explains itself there (HelpMode.astro), not here.
    var helped = function (el) { return document.documentElement.getAttribute('data-help') === 'on' && el && el.hasAttribute('data-help'); };
    document.addEventListener('mouseover', function (e) {
      var P = window.__rsPeek, el = e.target.closest && e.target.closest('[data-peek]');
      if (e.target.closest && e.target.closest('[data-peek-card]')) { clearTimeout(st); return; }
      if (!el || P.pinned || helped(el)) return;
      clearTimeout(st); st = setTimeout(function () { P.show(el); }, P.from ? 40 : 120);
    });
    document.addEventListener('mouseout', function (e) {
      var P = window.__rsPeek, to = e.relatedTarget;
      if (P.pinned || !P.from) { clearTimeout(st); return; }
      if (to && to.closest && (to.closest('[data-peek-card]') || to.closest('[data-peek]') === P.from)) return;
      clearTimeout(st); st = setTimeout(function () { P.hide(); }, 140);
    });
    document.addEventListener('click', function (e) {
      var P = window.__rsPeek;
      if (e.target.closest('[data-peek-x]')) { P.hide(true); return; }
      if (e.target.closest('[data-peek-card]')) return;
      var el = e.target.closest('[data-peek]');
      if (el && !e.target.closest('a') && !helped(el)) {
        e.preventDefault();
        if (P.pinned && P.from === el) { P.hide(true); return; }
        P.pinned = false; P.show(el); P.pinned = true; P.card.classList.add('pinned'); el.classList.add('peek-pinned');
        return;
      }
      if (P.pinned) P.hide(true);
    });
    document.addEventListener('focusin', function (e) { var P = window.__rsPeek, el = e.target.closest && e.target.closest('[data-peek]'); if (el && !P.pinned && !helped(el)) P.show(el); });
    document.addEventListener('keydown', function (e) { var P = window.__rsPeek; if (e.key === 'Escape' && P.from) { var f = P.from; P.hide(true); f.focus && f.focus(); } });
    addEventListener('scroll', function () { var P = window.__rsPeek; if (P.from && !P.card.hidden) { if (P.pinned) P.hide(true); else P.hide(); } }, { passive: true });
    document.addEventListener('astro:before-swap', function () { var P = window.__rsPeek; P.pinned = false; P.from = null; });
  })();
</script>

<style is:global>
  .peek { position: fixed; z-index: 90; width: min(340px, calc(100vw - 20px)); max-height: min(70vh, 520px); overflow: auto; padding: 12px 14px; border-radius: var(--radius-lg); background: var(--surface); border: var(--border-card); box-shadow: var(--shadow-lg); font: 400 13.5px/1.45 var(--font-sans); color: var(--text); animation: rs-pop-in var(--dur-pop) var(--ease-settle) both; transition: box-shadow var(--dur-state) var(--ease-settle); }
  .peek.moving { animation: none; }
  .peek.out { animation: rs-pop-out var(--dur-exit) var(--ease-exit) both; pointer-events: none; }
  .peek.pinned { box-shadow: var(--shadow-lg), 0 0 0 2px var(--accent); }
  .peek-x { position: absolute; top: 6px; right: 6px; width: 24px; height: 24px; border: 0; border-radius: 50%; background: transparent; color: var(--text-3); font-size: 16px; cursor: pointer; opacity: 0; transition: opacity var(--dur-state); }
  .peek.pinned .peek-x { opacity: 1; } .peek-x:hover { background: var(--surface-2); color: var(--text); }
  .peek-in { display: grid; gap: 6px; }
  .peek-in > b:first-child, .peek-in > .peek-h { font-size: 13px; padding-right: 22px; }
  .peek-in em { font-style: normal; font: 700 10px var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--text-3); margin-top: 4px; }
  .peek-in a { color: inherit; text-decoration: none; display: block; padding: 5px 7px; margin: 0 -7px; border-radius: 6px; transition: background var(--dur-state); }
  .peek-in a:hover { background: var(--surface-2); }
  .peek-in small { display: block; color: var(--text-2); font-size: 12px; }
  [data-peek] { cursor: pointer; }
  :root[data-help="on"] [data-peek]:not([data-help]) { outline: 1.5px dotted color-mix(in srgb, var(--accent) 65%, transparent); outline-offset: 2px; }
  [data-peek].peek-pinned { outline: 2px solid var(--accent); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .peek, .peek.out { animation: none; } }
</style>
