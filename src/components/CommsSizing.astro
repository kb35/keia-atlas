---
// What a comms room needs for the rooms it serves against what is installed (src/lib/comms.mjs,
// sizeFor): one row per figure (data outlets, access ports with headroom, switches, PoE, rack space,
// UPS), each with the need, what it has and a verdict ("Short by 5"). Unknowns say so. On a narrow
// screen each row stacks its three parts. Goes inside a Section.
const { size } = Astro.props;
---
<div class="cz-wrap">
  <div class="cz-head" aria-hidden="true"><span>What</span><span>Needs</span><span>Has</span><span>Verdict</span></div>
  <ol class="cz-rows">
    {size.rows.map((r) => (
      <li class="cz-r" data-help="comms.sizing" data-help-name={r.name}>
        <span class="cz-w">{r.name}</span>
        <span class="cz-n"><b class="num">{r.need}</b>{r.needNote && <small>{r.needNote}</small>}</span>
        <span class="cz-h">{r.have != null ? <><b class="num">{r.have}</b>{r.haveNote && <small>{r.haveNote}</small>}</> : <span class="faint">Not recorded</span>}</span>
        <span class="cz-v">{r.v.tone === 'faint' ? <span class="faint">{r.v.text}</span> : <span class={`pill ${r.v.tone}`}>{r.v.text}</span>}</span>
      </li>
    ))}
  </ol>
</div>

<style is:global>
  .cz-wrap { container: cz / inline-size; background: var(--surface); border: var(--border-card); border-radius: var(--radius-lg); overflow: hidden; }
  .cz-head, .cz-r { display: grid; grid-template-columns: minmax(120px, 1.2fr) minmax(0, 2fr) minmax(0, 1.4fr) minmax(120px, auto); gap: 14px; align-items: start; padding: 9px 18px; }
  .cz-head { font: 500 var(--fs-overline)/1.3 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--text-3); border-bottom: var(--border-rule); padding-top: 11px; padding-bottom: 8px; }
  .cz-rows { list-style: none; margin: 0; padding: 0; }
  .cz-r { border-top: var(--border-rule); font-size: var(--fs-body); }
  .cz-r:first-child { border-top: 0; }
  .cz-rows li:nth-child(even) { background: var(--surface-2); }
  .cz-w { font-weight: var(--fw-name); }
  .cz-n b, .cz-h b { font-weight: var(--fw-name); }
  .cz-n small, .cz-h small { display: block; font-size: var(--fs-code); color: var(--text-2); }
  .cz-v { justify-self: end; text-align: right; }
  .cz-v .pill { white-space: nowrap; }
  @container cz (max-width: 640px) {
    .cz-head { display: none; }
    .cz-r { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "w v" "n n" "h h"; gap: 4px 12px; padding: 10px 14px; }
    .cz-w { grid-area: w; } .cz-v { grid-area: v; } .cz-n { grid-area: n; } .cz-h { grid-area: h; }
    .cz-n::before { content: "Needs "; color: var(--text-3); } .cz-h::before { content: "Has "; color: var(--text-3); }
    .cz-n small, .cz-h small { display: inline; margin-left: 6px; }
  }
</style>
