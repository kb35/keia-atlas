---
// A thin bar split by Keia lifecycle stage, with a text equivalent for screen readers.
import { STAGES, STAGE_LABEL } from '../lib/data.mjs';
const { stages } = Astro.props;
const total = STAGES.reduce((n, s) => n + (stages[s] ?? 0), 0) || 1;
const words = STAGES.filter((s) => stages[s]).map((s) => `${stages[s]} ${STAGE_LABEL[s].toLowerCase()}`).join(', ');
---
<span class="bar" role="img" aria-label={words}>
  {STAGES.filter((s) => stages[s]).map((s) => <i class={s} style={`width:${(stages[s] / total) * 100}%`} title={`${STAGE_LABEL[s]}: ${stages[s]}`}></i>)}
</span>
