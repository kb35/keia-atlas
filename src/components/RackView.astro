  .rv-pic { container: rackv / inline-size; padding: 14px 16px 16px; display: grid; gap: 12px; align-content: start; min-width: 0; }
  .rv-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
