  .rv-svg .gbar { fill: var(--gc); }
  .rv-svg .chassis { fill: var(--art-body); stroke: var(--art-podline); stroke-width: .8; } .rv-svg .chassis-2 { fill: var(--art-tile); stroke: var(--art-tile-edge); stroke-width: .8; }
  .rv-svg .ear { fill: var(--art-grille-edge); } .rv-svg .ear-tray, .rv-svg .ear-dark { fill: var(--art-podline); } .rv-svg .ear-silver { fill: var(--art-vent); } .rv-svg .screw { fill: var(--art-metal); }
