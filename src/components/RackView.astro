  .rv-big .pt:hover > :first-child, .rv-big .pt.pt-on > :first-child { stroke: var(--accent); stroke-width: 1.4; }
  .rv-tip { position: absolute; z-index: 5; width: min(300px, 100%); padding: 10px 12px; border-radius: var(--radius-lg); background: var(--surface); border: var(--border-card); box-shadow: var(--shadow-lg); font: 400 13px/1.4 var(--font-sans); color: var(--text); pointer-events: none; display: grid; gap: 4px; }
