---
// One person on the Team org chart: a button that shows their details in the side panel beside the
// chart. Styles live with the Team page (.pc). Props: p (a person from demo.mjs), sub (a second line),
// tag (a short code on the right, such as a site), size ('row', 'lead' or 'node': an upright card for
// the head and the team leads), away (away today), ghost (a pointer to someone who sits elsewhere on
// the chart), manager (manages people: a bar on its left edge).
const { p, sub = '', tag = '', size = 'row', away = false, ghost = false, manager = false } = Astro.props;
---
<button
  type="button"
  class:list={['pc', `pc-${size}`, { 'pc-ghost': ghost, 'pc-mgr': manager && !ghost }]}
  data-pid={p.id}
  data-help="team.chip"
  data-help-name={p.name}
  aria-pressed="false"
  aria-label={`${p.name}, ${p.role}${away ? ', away today' : ''}${ghost ? ', shown again here' : ''}`}
>
  <span class="pc-av" aria-hidden="true">{p.initials}</span>
  <span class="pc-txt"><b>{p.name}</b>{sub && <small>{sub}</small>}</span>
  {away && <span class="pc-away" aria-hidden="true">Away</span>}
  {tag && <span class="pc-tag" aria-hidden="true">{tag}</span>}
</button>
