---
/* Settings › Accessibility (/settings/#accessibility; docs/accessibility.md; src/lib/a11y.mjs). Saved in this browser
   as rs7-a11y, for the person at the keyboard (not per View as), and applied before first paint by the boot script
   in each layout. Every choice applies at once and can be undone the same way. A clean list: each switch on the
   right with one line under its name (iOS style).
   Motion changes nothing on screen by itself, so it is set directly; the rest change sizes or add words, so they go
   through rsChange, which keeps what you were looking at still (M12). High contrast is the High contrast look
   (rs4-skin), switched with rsTheme like the looks. */
import { href } from '../lib/data.mjs';
import { A11Y_SWITCHES, MOTION_NOTE, TEXT_STEPS } from '../lib/settings.mjs';
const MOTION = [{ id: 'system', name: 'Follow my device' }, { id: 'reduced', name: 'Reduced' }, { id: 'off', name: 'Off' }];
---
<ul class="card st-list" data-st-a11y data-help="settings.a11y">
  <li class="st-item st-stack" data-fi data-find="motion animation reduced off follow device movement">
    <div class="st-item-t"><b id="st-motion-l">Motion</b><small data-a11y-motion-note>{MOTION_NOTE.system}</small></div>
    <div class="st-seg" role="radiogroup" aria-labelledby="st-motion-l" data-seg>
      {MOTION.map((m) => (<label><input type="radio" name="a11y-motion" value={m.id} /><span>{m.name}</span></label>))}
    </div>
  </li>
  <li class="st-item st-stack" data-fi data-find="text size larger largest font bigger zoom">
    <div class="st-item-t"><b id="st-text-l">Text size</b><small>Pages reflow to fit, even on a phone</small></div>
    <div class="st-seg" role="radiogroup" aria-labelledby="st-text-l" data-seg>
      {TEXT_STEPS.map((m) => (<label><input type="radio" name="a11y-text" value={m.id} /><span>{m.name}</span></label>))}
    </div>
  </li>
  {A11Y_SWITCHES.map((s) => (
    <li class="st-item" data-fi data-find={`${s.name} ${s.note}`.toLowerCase()}>
      <label class="st-item-t" for={`a11y-${s.id}`}><b>{s.name}</b></label>
      <label class="st-switch"><input type="checkbox" role="switch" id={`a11y-${s.id}`} name={`a11y-${s.id}`} data-a11y={s.id} aria-describedby={`a11y-${s.id}-d`} /><span class="sw" aria-hidden="true"></span></label>
      <small class="st-sub" id={`a11y-${s.id}-d`}>{s.note}</small>
    </li>
  ))}
  <li class="st-item st-link" data-fi data-find="accessibility statement what works gaps report">
    <a href={href('/about/accessibility/')}><span class="st-item-t"><b>What works, and what does not yet</b><small>Known gaps, and how to report one</small></span><span aria-hidden="true">›</span></a>
  </li>
</ul>

<script is:inline data-astro-rerun define:vars={{ NOTE: MOTION_NOTE }}>
  (function () {
    var box = document.querySelector('[data-st-a11y]'); if (!box || box.__st) return; box.__st = true;
    var W = window;
    var get = function (k, d) { try { return localStorage.getItem(k) || d; } catch (_) { return d; } };
    var put = function (k, v) { try { localStorage.setItem(k, v); } catch (_) {} };
    function sync() {
      var p = W.rsA11y ? W.rsA11y() : {};
      box.querySelectorAll('input[name=a11y-motion]').forEach(function (i) { i.checked = i.value === (p.motion || 'system'); });
      box.querySelectorAll('input[name=a11y-text]').forEach(function (i) { i.checked = i.value === (p.text || 'default'); });
      box.querySelectorAll('input[data-a11y]').forEach(function (i) { i.checked = i.dataset.a11y === 'contrast' ? get('rs4-skin', 'studio') === 'contrast' : !!p[i.dataset.a11y]; });
      var n = box.querySelector('[data-a11y-motion-note]'); if (n) n.textContent = NOTE[p.motion || 'system'];
      box.querySelectorAll('[data-seg]').forEach(function (g) {
        if (W.rsMarker) W.rsMarker(g, function () { var i = g.querySelector('input:checked'); return i && i.closest('label'); });
      });
    }
    box.addEventListener('change', function (e) {
      var i = e.target, set;
      if (i.name === 'a11y-motion') { W.rsSetA11y({ motion: i.value }); sync(); return; }
      if (i.name === 'a11y-text') set = { text: i.value };
      else if (i.dataset && i.dataset.a11y === 'contrast') {
        // The High contrast look, and back to the look chosen before it.
        var now = get('rs4-skin', 'studio'), to;
        if (i.checked) { if (now !== 'contrast') put('rs7-skin-before', now); to = 'contrast'; }
        else to = get('rs7-skin-before', 'studio') === 'contrast' ? 'studio' : get('rs7-skin-before', 'studio');
        put('rs4-skin', to);
        W.rsTheme(function () { W.rsApplyTheme(); }, to);
        document.dispatchEvent(new CustomEvent('rs:settings-change', { detail: { what: 'skin' } }));
        sync(); return;
      } else if (i.dataset && i.dataset.a11y) { set = {}; set[i.dataset.a11y] = i.checked; }
      if (!set) return;
      var apply = function () { W.rsSetA11y(set); };
      if (W.rsChange) W.rsChange(apply); else apply();
      sync();
    });
    ['rs:settings-change', 'rs:a11y', 'rs:demo-change'].forEach(function (ev) { document.addEventListener(ev, function () { if (box.isConnected) sync(); }); });
    // (on a first visit the Shell's helpers, rsModules, rsMarker and the rest, are defined after this script)
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { sync(); }, { once: true }); else sync();
  })();
</script>

