---
/* FeatureGate: a page that belongs to one capability (src/lib/modules.mjs), such as /assets/licences/. Its content
   sits in the default slot and shows while the capability is on; while it is off, the page says so in the same
   words as a switched-off module, and offers to switch it on (and whatever it needs with it: rsEnableFeature in
   Shell.astro). Keyed on <html> (featureCss), so it is right before first paint, and a switch in Organisation settings cross-fades
   the page in place (rsChange). */
import { capability, MODULES } from '../lib/modules.mjs';
import { href } from '../lib/data.mjs';
interface Props { id: string }
const { id } = Astro.props;
const cap = capability(id);
if (!cap) throw new Error(`FeatureGate: no capability "${id}" in src/lib/modules.mjs`);
const mod = MODULES.find((m) => m.id === cap.module);
---
<section class="stage-gate feat-gate" data-feat-offshow={id}>
  <p class="kind">{mod?.label} capability</p>
  <h1>{cap.label} is switched off</h1>
  <p class="lede">{cap.what}. This demo has {cap.label} switched off in Organisation settings, so nothing of it shows anywhere.</p>
  <div class="gate-acts">
    <button class="btn primary" type="button" data-help="shell.feature-gate" data-enable-feature={id}>Switch on {cap.label}</button>
    <a class="btn ghost" href={href(`/settings/organisation/#${cap.module}`)}>Organisation settings</a>
  </div>
</section>
<div class="feat-page" data-feature={id}><slot /></div>

<script is:inline data-astro-rerun>
  document.querySelectorAll('[data-enable-feature]').forEach(function (b) {
    if (b.__rsFg) return; b.__rsFg = true;
    b.addEventListener('click', function () { if (window.rsEnableFeature) window.rsEnableFeature(b.dataset.enableFeature); });
  });
</script>

<style is:global>
  .feat-gate[data-feat-offshow] { display: grid; }
  .feat-page { display: contents; }
</style>
