---
// One idea's card, the same four lines everywhere the idea is shown: Instead of, You, You'll know it's working when,
// and In Keia Atlas. The first three are the method and make sense with no software, so they sit together; the last
// is the product, set apart on its own strip so the two are never confused. The words are the method's own
// (docs/keia-method.md, Level 1, read by src/lib/method.mjs).
//   idea   one of LEVEL1.ideas: { n, slug, name, card }
//   link   true on the overview: the name opens the idea's page, and "In full" says where it goes
//   at     the time of the story step this idea is (the overview), linked to that step
//   art    true: the idea's small drawing beside its name (the idea page, where the card leads)
import IdeaArt from './IdeaArt.astro';
import { href } from '../../lib/data.mjs';
import { CARD, md } from '../../lib/method.mjs';
interface Props { idea: { n: number; slug: string; name: string; card: Record<string, string> }; link?: boolean; at?: string; art?: boolean; as?: 'li' | 'section' }
const { idea, link = false, at, art = false, as: Tag = 'section' } = Astro.props;
const lines = CARD.filter((k) => k.key !== 'atlas');
const atlas = CARD.find((k) => k.key === 'atlas')!;
const hid = `ic-${idea.slug}`;
---
<Tag class="card ic" aria-labelledby={hid} data-help="method.card">
  <header class="ic-h">
    {art && <IdeaArt idea={idea.slug} class="ic-art" />}
    <div class="ic-name">
      <span class="ic-n">Idea {idea.n}{at && <> · <a href={`#st-${at.replace(':', '')}`} class="ic-at">{at} in the story</a></>}</span>
      <h3 id={hid}>{link ? <a href={href(`/method/${idea.slug}/`)}>{idea.name}</a> : idea.name}</h3>
    </div>
  </header>
  <dl class="ic-lines">
    {lines.map((k) => (
      <div class:list={['ic-line', `ic-${k.key}`]}>
        <dt>{k.label}</dt>
        <dd set:html={md(idea.card[k.key])} />
      </div>
    ))}
  </dl>
  <p class="ic-atlas"><b>{atlas.label}:</b> <span set:html={md(idea.card.atlas)} /></p>
  {link && <a class="ic-more" href={href(`/method/${idea.slug}/`)}>{idea.name}, in full →</a>}
</Tag>

<style>
  .ic { display: grid; gap: 12px; padding: 16px 18px 0; align-content: start; overflow: hidden; container: ic / inline-size; }
  .ic-h { display: flex; gap: 14px; align-items: center; }
  .ic-name { display: grid; gap: 2px; min-width: 0; }
  .ic-n { font: 500 10.5px/1.3 var(--font-mono); letter-spacing: .09em; text-transform: uppercase; color: var(--text-3); }
  .ic-at { color: inherit; text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 2px; }
  .ic-at:hover { color: var(--text); }
  .ic h3 { margin: 0; font: 600 17px/1.3 var(--font-sans); }
  .ic h3 a { color: var(--text); text-decoration: none; }
  .ic h3 a:hover { text-decoration: underline; }
  :global(.method) .ic-art { width: 120px; flex: none; }
  .ic-lines { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .ic-line { display: grid; gap: 4px; align-content: start; }
  .ic-line dt { font-size: 12.5px; font-weight: 600; color: var(--text-2); }
  .ic-line dd { margin: 0; font-size: 14px; line-height: 1.5; }
  .ic-you dd { color: var(--text); font-weight: 500; }
  /* The product line: its own strip at the foot, so the method above it reads without it. */
  .ic-atlas { margin: 0 -18px; padding: 10px 18px; background: var(--surface-2); border-top: 1px solid var(--line); font-size: 13.5px; line-height: 1.5; color: var(--text-2); }
  .ic-atlas b { font-weight: 600; color: var(--text); }
  .ic-more { justify-self: start; margin: -4px 0 12px; font-size: 13.5px; min-height: 32px; display: inline-flex; align-items: center; }
  .ic:has(.ic-more) .ic-atlas { margin-bottom: 0; }
  @container ic (max-width: 640px) {
    .ic-lines { grid-template-columns: minmax(0, 1fr); gap: 10px; }
    :global(.method) .ic-art { width: 88px; }
  }
</style>
