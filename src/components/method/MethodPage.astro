---
// One method page: an Atlas page about Atlas (FRONT-DOOR section 1). The band names the page, its level and its
// place in the method text, with one action, "Try it in the demo". Then the page's own content, the thing to try,
// and where the page sits in the method. The level is shown on every page.
import Shell from '../../layouts/Shell.astro';
import PageBand from '../PageBand.astro';
import TryIt from './TryIt.astro';
import MethodNav from './MethodNav.astro';
import { href } from '../../lib/data.mjs';
interface Props {
  slug: string; title: string; lede: string; level: number; num?: string;
  try: { to: string; as?: string; label: string; steps: string[] };
}
const { slug, title, lede, level, num, try: t } = Astro.props;
const crumbs = slug === 'level1' ? [{ label: 'The Keia Method' }] : [{ label: 'The Keia Method', to: '/method/' }, { label: title }];
---
<Shell title={slug === 'level1' ? title : `${title} · The Keia Method`} section="method" crumbs={crumbs} about={{ kind: 'page', label: `${title} (the Keia Method)` }}>
  <PageBand overline="Keia Method" title={title} lede={lede}>
    <span slot="overline" class="mp-level">· Level {level}{num ? ` · ${num}` : ''}</span>
    <a slot="action" class="btn primary" href={href(t.to)} data-as={t.as}>Try it in the demo</a>
  </PageBand>
  <div class="content method">
    <slot />
    <TryIt t={t} />
    <MethodNav current={slug} />
  </div>
</Shell>

<script>
  // A "Try it" link opens the demo as the right person (View as), set just before the page changes. The person you
  // were stays "you", so the console shows the View as ribbon with Back to you.
  function viewAs(e: Event) {
    const a = (e.target as Element | null)?.closest?.('.method a[data-as], .pb a[data-as]') as HTMLAnchorElement | null;
    if (!a) return;
    const id = a.dataset.as!;
    const w = window as any;
    if (w.rsSetWho) w.rsSetWho(id);
    else { try { sessionStorage.setItem('rs5-who', id); localStorage.setItem('rs4-who', id); } catch (_) { /* storage blocked: the demo opens as the default person */ } }
  }
  if (!(window as any).__mpViewAs) { (window as any).__mpViewAs = true; document.addEventListener('click', viewAs, true); }
</script>

<style is:global>
  .mp-level { font: 500 10.5px/1.2 var(--font-mono); letter-spacing: .09em; text-transform: uppercase; color: var(--text-3); }
  .method .mp-prose { display: grid; gap: 10px; max-width: 76ch; }
  .method .mp-prose p { margin: 0; font-size: 14px; line-height: 1.55; }
  .method .mp-parts { margin: 0; display: grid; gap: 12px; max-width: 80ch; }
  .method .mp-parts div { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 16px; padding-top: 12px; border-top: 1px solid var(--line); }
  .method .mp-parts div:first-child { border-top: 0; padding-top: 0; }
  .method .mp-parts dt { font-size: 13.5px; font-weight: 550; }
  .method .mp-parts dd { margin: 0; font-size: 14px; line-height: 1.55; }
  .method .mp-table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  .method .mp-table th { text-align: left; font: 500 10.5px/1.3 var(--font-mono); letter-spacing: .09em; text-transform: uppercase; color: var(--text-3); padding: 8px 12px; border-bottom: 1px solid var(--line-strong); }
  .method .mp-table td { padding: 10px 12px; border-bottom: 1px solid var(--line); vertical-align: top; line-height: 1.5; }
  .method .mp-table tr:last-child td { border-bottom: 0; }
  .method .mp-table td:first-child { font-weight: 550; }
  .method .mp-left { display: grid; gap: var(--gutter); align-content: start; }   /* the picture and How to do it share the left column, so it is as long as the paragraph beside it */
  .method .mp-pic { display: grid; gap: 10px; align-content: start; }
  .method .mp-pic > h2, .method .mp-side h3 { font: 600 15px/1.3 var(--font-sans); }
  .method .mp-side { display: grid; gap: 12px; align-content: start; }
  .method .mp-side p { margin: 0; font-size: 14px; line-height: 1.55; }
  .method .mp-example { padding: 10px 12px; border-radius: 8px; background: var(--surface-2); font-size: 14px; }
  @container content (max-width: 700px) {
    .method .mp-parts div { grid-template-columns: minmax(0, 1fr); gap: 4px; }
  }
</style>
