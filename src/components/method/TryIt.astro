---
// "Try it in the demo": the steps, who the demo opens as (View as), and the deep link. Every method page ends with
// one (FRONT-DOOR section 3). The link sets View as just before the page changes (MethodPage's script).
import { href } from '../../lib/data.mjs';
import { PEOPLE } from '../../pages/method/_pages.mjs';
interface Props { t: { to: string; as?: string; label: string; steps: string[] } }
const { t } = Astro.props;
---
<section class="card pad ti" aria-labelledby="ti-h" data-help="method.try">
  <h2 id="ti-h">Try it in the demo</h2>
  {t.as && <p class="ti-as">Opens as {PEOPLE[t.as]}. Everyone in the demo is made up; nothing you do leaves this browser.</p>}
  <ol class="ti-steps">{t.steps.map((s) => <li>{s}</li>)}</ol>
  <a class="btn primary" href={href(t.to)} data-as={t.as} data-try>{t.label}</a>
</section>

<style>
  .ti { display: grid; gap: 10px; justify-items: start; }
  .ti h2 { font: 600 15px/1.3 var(--font-sans); }
  .ti-as { margin: 0; font-size: 13px; color: var(--text-2); }
  .ti-steps { margin: 0; padding-left: 20px; display: grid; gap: 4px; font-size: 14px; max-width: 72ch; }
</style>
