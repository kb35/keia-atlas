---
// A health ring with its word (UI-V2 section 6). Shape carries the state; colour reinforces it; the word sits beside
// it. `quiet` draws Fine in the quiet grey (nothing fine is coloured on an overview). `label` is the full text for
// screen readers ("Fault: video bar offline since 07:52"); without it the word is used.
import { ringParts, RING_WORD } from '../../lib/ring.mjs';
interface Props { state?: string; size?: number; word?: boolean | string; quiet?: boolean; label?: string; class?: string }
const { state = 'fine', size = 16, word = false, quiet = false, label, class: cls } = Astro.props;
const text = typeof word === 'string' ? word : RING_WORD[state] ?? state;
const parts = ringParts(state);
---
<span class:list={['ring', `ring-${state}`, { 'ring-quiet': quiet }, cls]} role="img" aria-label={label ?? text}>
  <svg viewBox="0 0 16 16" width={size} height={size} aria-hidden="true">
    {parts.map(({ tag, attrs }) => tag === 'path' ? <path {...attrs} stroke="currentColor" /> : tag === 'line' ? <line {...attrs} stroke="currentColor" /> : <circle {...attrs} stroke={attrs.stroke ?? 'currentColor'} />)}
  </svg>
  {word && <span class="ring-word">{text}</span>}
</span>

<style is:global>
  .ring { display: inline-flex; align-items: center; gap: 6px; vertical-align: middle; line-height: 1; color: var(--ring-fill); }
  .ring svg { flex: none; display: block; overflow: visible; }
  .ring-word { color: var(--ring-ink); font-size: 12.5px; font-weight: 550; white-space: nowrap; }
  .ring-fine { --ring-fill: var(--h-fine, var(--green)); --ring-ink: var(--h-fine-ink, var(--green-ink)); }
  .ring-fine.ring-quiet { --ring-fill: var(--quiet, var(--text-3)); --ring-ink: var(--text-2); }
  .ring-review { --ring-fill: var(--h-review, var(--amber)); --ring-ink: var(--h-review-ink, var(--amber-ink)); }
  .ring-fault, .ring-silent { --ring-fill: var(--h-fault, var(--red)); --ring-ink: var(--h-fault-ink, var(--red-ink)); }
  .ring-progress { --ring-fill: var(--h-progress, var(--blue)); --ring-ink: var(--h-progress-ink, var(--blue-ink)); }
  .ring-planned { --ring-fill: var(--h-planned, var(--violet)); --ring-ink: var(--h-planned-ink, var(--violet-ink)); }
  .ring-off { --ring-fill: var(--h-off, var(--grey)); --ring-ink: var(--h-off-ink, var(--grey-ink)); }
</style>
