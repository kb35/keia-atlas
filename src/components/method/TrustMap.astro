---
// Why IT can trust it: the method's trust table drawn as what surrounds the record (FRONT-DOOR section 3). A still
// picture: the record in the middle, the eight guarantees around it, each with the first clause of its row. The
// full rows are the table below the picture on the same page. No motion.
import { SEC2, plain } from '../../lib/method.mjs';
const rows = SEC2.trust.tables[0].rows.map(([k, v]) => ({ k: plain(k), v: plain(v).split(/;\s/)[0] }));
// Around the middle: four above, four below on wide screens; one column on narrow ones.
const top = rows.slice(0, 4), bottom = rows.slice(4);
---
<figure class="tm" data-help="method.trust">
  <ul class="tm-ring">
    {top.map((r) => <li><b>{r.k}</b><span>{r.v}</span></li>)}
    <li class="tm-core" aria-label="The record"><b>The record</b><span>Every space, device and job; who, what, when, before, after</span></li>
    {bottom.map((r) => <li><b>{r.k}</b><span>{r.v}</span></li>)}
  </ul>
  <figcaption>Eight guarantees around one record. Each row in full is in the table below.</figcaption>
</figure>

<style>
  .tm { margin: 0; display: grid; gap: 10px; container: tm / inline-size; }
  .tm-ring { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
  .tm-ring li { border: 1px solid var(--line); border-radius: 10px; background: var(--surface); padding: 10px 12px; display: grid; gap: 4px; align-content: start; min-width: 0; }
  .tm-ring b { font-size: 13px; font-weight: 600; }
  .tm-ring span { font-size: 12px; color: var(--text-2); overflow-wrap: anywhere; }
  .tm-core { grid-column: 1 / -1; border: 1.5px solid var(--line-strong) !important; background: var(--bg) !important; text-align: center; padding: 16px !important; }
  .tm-core b { font-size: 15px; }
  .tm figcaption { font-size: 12.5px; color: var(--text-2); }
  @container tm (max-width: 560px) { .tm-ring { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @container tm (max-width: 340px) { .tm-ring { grid-template-columns: minmax(0, 1fr); } }
</style>
