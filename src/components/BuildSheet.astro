---
/* BuildSheet: one unit's build sheet, the settings it gets worked out to its own values (src/lib/buildsheet.mjs),
   grouped where you set them and in setup order. Each row: the setting and where exactly, the value (monospace,
   with a copy button), Set or Check, and what Keia Atlas has seen of it (painted live by integrate-client.mjs,
   [data-sck]). A value that cannot be worked out says Not recorded and why. Secrets are never shown: the row
   names the password vault entry. Each group has Copy all; the page has Print and Export (CSV).
   Rows are FilterBar items (data-fi): Status, Where, Set or check and Scope filter them; a group with nothing
   showing hides (data-fb-group).
   Props:  sheet   buildSheet(...)
           M       the Deploy model as built (buildModel), for the checks
           uid     the unit's id
           head    { label: value } for the top of the CSV and the printed page */
import { sheetCkHtml, sheetCheck } from '../lib/integrate-view.mjs';
interface Props { sheet: any; M: any; uid: string; head: Record<string, string> }
const { sheet, M, uid, head } = Astro.props;
const COPY = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8.5" y="8.5" width="11" height="11" rx="2"/><path d="M15.5 8.5V6a1.5 1.5 0 0 0-1.5-1.5H6A1.5 1.5 0 0 0 4.5 6v8A1.5 1.5 0 0 0 6 15.5h2.5"/></svg><svg class="bs-done" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
const LOCK = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10.5" width="14" height="9.5" rx="2"/><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5"/></svg>';
const statusOf = (r) => {
  if (r.missing) return 'missing';
  const c = sheetCheck(M, uid, r.ck, r.t).st;
  return c === 'issue' ? 'issue' : c === 'verified' || c === 'done' ? 'seen' : 'todo';
};
const copyText = (r) => (r.missing ? '' : r.val);
const json = JSON.stringify({ groups: sheet.groups, head }).replace(/</g, '\\u003c');
---
<div class="bs" data-bs>
  <header class="bs-print" aria-hidden="true">
    <p class="bs-print-k">Build sheet</p>
    <dl>{Object.entries(head).map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
  </header>
  <div class="bs-cols" aria-hidden="true"><span>Setting and where</span><span>Value</span><span>Set or check</span><span>Check</span></div>
  {sheet.groups.map((g) => (
    <section class="card bs-g" data-fb-group data-g={g.id} aria-labelledby={`bs-${g.id}`}>
      <header class="bs-gh">
        <span class="bs-n num" aria-hidden="true">{g.n}</span>
        <span class="bs-gt"><h3 id={`bs-${g.id}`}>{g.title}</h3><small class="mono">{g.where}</small></span>
        <button type="button" class="btn small ghost bs-all" data-bs-copy-group={g.id} data-help="integrate.sheet-copy-all"><span class="bs-ic" set:html={COPY} /><span data-l>Copy all</span></button>
      </header>
      <ol class="bs-rows">
        {g.rows.map((r) => (
          <li id={r.k} class:list={['bs-r', { miss: r.missing, sec: r.secret, per: r.per }]} data-fi data-k={r.k}
            data-find={[r.t, r.missing ? 'Not recorded' : r.val, r.alt?.val, r.path, g.title].filter(Boolean).join(' ')}
            data-f-status={statusOf(r)} data-f-where={g.id} data-f-act={r.act} data-f-scope={r.per ? 'unit' : 'same'} data-help="integrate.sheet-row">
            <div class="bs-s">
              <b>{r.t}</b>
              <small class="bs-path">{r.path}</small>
            </div>
            <div class="bs-v">
              {r.missing ? (
                <p class="bs-miss"><span class="bs-nr">Not recorded</span><small>{r.why}</small></p>
              ) : (
                <>
                  <p class="bs-line">
                    {r.secret && <span class="bs-lock" title="Never shown here" set:html={LOCK} />}
                    <span class="bs-val">{r.secret && <small class="bs-vault">From the password vault, </small>}<code>{r.val}</code></span>
                    <button type="button" class="bs-copy" data-bs-copy={copyText(r)} aria-label={`Copy ${r.t}${r.secret ? ' vault entry name' : ''}`} data-help="integrate.sheet-copy" set:html={COPY} />
                  </p>
                  {r.alt && (
                    <p class="bs-line bs-alt"><span class="bs-val"><small>{r.alt.label}</small><code>{r.alt.val}</code></span><button type="button" class="bs-copy" data-bs-copy={r.alt.val} aria-label={`Copy ${r.alt.label}`} data-help="integrate.sheet-copy" set:html={COPY} /></p>
                  )}
                  {r.note && <small class="bs-note">{r.note}</small>}
                  {r.from && <small class="bs-from">{r.from}</small>}
                </>
              )}
            </div>
            <div class="bs-a"><span class:list={['pill', r.act === 'verify' ? 'plain' : 'deploy']}>{r.act === 'verify' ? 'Check' : 'Set'}</span>{r.per ? <small>This unit</small> : <small>Every unit</small>}</div>
            <div class="bs-c" set:html={sheetCkHtml(M, uid, r.ck, r.t)} />
          </li>
        ))}
      </ol>
    </section>
  ))}
  <script type="application/json" data-bs-json set:html={json}></script>
</div>

<script>
  import { sheetCsv } from '../lib/buildsheet.mjs';
  // Copy a value, a group or the whole sheet; print; export as CSV. A copied row eases to a highlight and its
  // button shows a tick for a moment (motion tokens); nothing moves or jumps.
  function start() {
    const root = document.querySelector('[data-bs]');
    if (!root || (root as any).__bs) return;
    (root as any).__bs = true;
    const W = window as any;
    const data = JSON.parse(root.querySelector('[data-bs-json]')?.textContent || '{}');
    const linger = () => Math.min(1600, W.rsMotion?.().linger ?? 1600);
    const copy = async (text: string) => {
      try { await navigator.clipboard.writeText(text); return true; } catch (_) {
        const ta = document.createElement('textarea'); ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select(); let ok = false; try { ok = document.execCommand('copy'); } catch (_) {} ta.remove(); return ok;
      }
    };
    const flash = (btn: HTMLElement, row: HTMLElement | null, label?: string) => {
      btn.classList.add('copied'); row?.classList.add('copied');
      const l = btn.querySelector('[data-l]'); const was = l?.textContent;
      if (l && label) l.textContent = label;
      setTimeout(() => { btn.classList.remove('copied'); row?.classList.remove('copied'); if (l && was) l.textContent = was; }, linger());
    };
    const lineOf = (r: any) => `${r.t}: ${r.missing ? 'Not recorded' : r.secret ? `From the password vault, ${r.val}` : r.val}${r.alt ? ` (${r.alt.label}: ${r.alt.val})` : ''}`;
    const visible = (g: any) => g.rows.filter((r: any) => { const li = root.querySelector(`[data-k="${CSS.escape(r.k)}"]`); return !li || !(li as HTMLElement).hidden; });
    const groupText = (g: any) => [`${g.n}. ${g.title} (${g.where})`, ...visible(g).map(lineOf)].join('\n');
    root.addEventListener('click', async (ev) => {
      const t = ev.target as Element;
      const one = t.closest('[data-bs-copy]') as HTMLElement | null;
      if (one) { if (await copy(one.dataset.bsCopy || '')) flash(one, one.closest('.bs-r')); return; }
      const grp = t.closest('[data-bs-copy-group]') as HTMLElement | null;
      if (grp) { const g = data.groups.find((x: any) => x.id === grp.dataset.bsCopyGroup); if (g && await copy(groupText(g))) flash(grp, null, 'Copied'); }
    });
    // The page's own buttons (in the side panel and the band) sit outside the sheet.
    document.addEventListener('click', async (ev) => {
      const b = (ev.target as Element).closest('[data-bs-act]') as HTMLElement | null;
      if (!b || !document.body.contains(root)) return;
      const act = b.dataset.bsAct;
      if (act === 'print') { window.print(); return; }
      if (act === 'copy-sheet') { if (await copy(data.groups.map(groupText).join('\n\n'))) flash(b, null, 'Copied'); return; }
      if (act === 'csv') {
        const csv = sheetCsv(data, data.head);
        const a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8' }));
        a.download = `${(b.dataset.name || 'build-sheet').replace(/[^a-z0-9.-]+/gi, '-')}.csv`;
        document.body.appendChild(a); a.click(); setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 0);
        flash(b, null, 'Exported');
      }
    });
  }
  document.addEventListener('astro:page-load', start);
  if (document.readyState !== 'loading') start(); else document.addEventListener('DOMContentLoaded', start, { once: true });
</script>

<style>
  .bs { display: grid; gap: var(--gutter); container: sheet / inline-size; min-width: 0; }
  .bs-print { display: none; }
  .bs-cols { display: grid; grid-template-columns: var(--bs-grid); gap: 12px; padding: 0 18px; font: 600 var(--fs-code)/1.2 var(--font-sans); color: var(--text-3); }
  .bs { --bs-grid: minmax(0, 1.05fr) minmax(0, 1.25fr) 84px 112px; }
  .bs-g { padding: 0; min-width: 0; overflow: clip; }
  .bs-g[hidden] { display: none; }
  .bs-gh { display: grid; grid-template-columns: 26px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 12px 14px 10px 18px; border-bottom: 1px solid var(--line); }
  .bs-n { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; background: var(--surface-2); font: var(--fw-title) var(--fs-code)/1 var(--font-mono); color: var(--text-2); }
  .bs-gt { display: grid; gap: 1px; min-width: 0; }
  .bs-gt h3 { margin: 0; font-size: var(--fs-lede); }
  .bs-gt small { font-size: var(--fs-mark); color: var(--text-3); overflow-wrap: anywhere; }
  .bs-rows { list-style: none; margin: 0; padding: 0; }
  .bs-r { display: grid; grid-template-columns: var(--bs-grid); gap: 4px 12px; align-items: start; padding: 10px 18px; border-top: 1px solid var(--line); transition: background-color var(--dur-state) var(--ease-settle); }
  .bs-r:first-child { border-top: 0; }
  .bs-r[hidden] { display: none; }
  .bs-r.copied { background: color-mix(in srgb, var(--green) 9%, transparent); }
  .bs-s { display: grid; gap: 2px; min-width: 0; }
  .bs-s b { font-size: var(--fs-body); font-weight: 600; line-height: 1.3; }
  .bs-path { font-size: 11.5px; color: var(--text-3); overflow-wrap: anywhere; line-height: 1.35; }
  .bs-v { display: grid; gap: 3px; min-width: 0; }
  .bs-v p { margin: 0; }
  .bs-line { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: start; gap: 6px; }
  .bs-line:not(:has(.bs-lock)) { grid-template-columns: minmax(0, 1fr) auto; }
  .bs-val { min-width: 0; display: grid; gap: 1px; }
  .bs-val code { font: 600 var(--fs-support)/1.4 var(--font-mono); color: var(--text); background: none; padding: 0; overflow-wrap: anywhere; }
  .bs-val small, .bs-vault { font-size: var(--fs-mark); color: var(--text-3); font-family: var(--font-sans); }
  .bs-alt .bs-val code { font-weight: 500; font-size: var(--fs-code); }
  .bs-lock { color: var(--text-3); padding-top: 3px; }
  .bs-lock :global(svg) { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2; }
  .bs-note, .bs-from { font-size: var(--fs-mark); line-height: 1.35; color: var(--text-2); }
  .bs-from { color: var(--text-3); }
  .bs-miss { display: grid; gap: 2px; }
  .bs-nr { justify-self: start; font-size: var(--fs-code); font-weight: var(--fw-name); color: var(--amber-ink); padding: 1px 8px; border-radius: var(--pill-radius); background: color-mix(in srgb, var(--amber) 14%, transparent); }
  .bs-miss small { font-size: var(--fs-mark); color: var(--text-2); line-height: 1.35; }
  .bs-a { display: grid; gap: 3px; justify-items: start; }
  .bs-a small { font-size: var(--fs-mark); color: var(--text-3); }
  .bs-r.per .bs-a small { color: var(--text-2); font-weight: 600; }
  .bs-c :global(.bs-ck) { display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-code); color: var(--text-2); }
  .bs-c :global(.bs-ck[data-st=verified]), .bs-c :global(.bs-ck[data-st=done]) { color: var(--green-ink); }
  .bs-c :global(.bs-ck[data-st=issue]) { color: var(--amber-ink); font-weight: 600; }
  .bs-c :global(.bs-ckl) { transition: color var(--dur-state) var(--ease-settle); }
  .bs-copy { appearance: none; position: relative; flex: none; width: 28px; height: 28px; margin: -4px -4px 0 0; display: grid; place-items: center; border: 0; border-radius: var(--radius); background: none; color: var(--text-3); cursor: pointer; transition: background-color var(--dur-hover) var(--ease-settle), color var(--dur-hover) var(--ease-settle); }
  .bs-copy:hover { background: var(--surface-2); color: var(--text); }
  .bs-copy:focus-visible, .bs-all:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
  .bs-copy :global(svg), .bs-ic :global(svg) { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; grid-area: 1 / 1; transition: opacity var(--dur-pop) var(--ease-settle), transform var(--dur-pop) var(--ease-settle); }
  .bs-copy :global(.bs-done), .bs-ic :global(.bs-done) { opacity: 0; transform: scale(var(--pop-scale, .94)); stroke: var(--green); stroke-width: 2.4; }
  .copied :global(.bs-done) { opacity: 1; transform: none; }
  .copied > :global(svg:not(.bs-done)), .copied .bs-ic :global(svg:not(.bs-done)) { opacity: 0; }
  .bs-copy.copied { color: var(--green-ink); }
  .bs-ic { display: inline-grid; place-items: center; }
  .bs-all { gap: 6px; }

  /* Narrow sheets: the setting, then the value with its copy button, then Set or check and the check in a row. */
  @container sheet (max-width: 639px) {
    .bs-cols { display: none; }
    .bs-r { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "s s" "v v" "a c"; gap: 6px 10px; padding: 12px 14px; }
    .bs-s { grid-area: s; } .bs-v { grid-area: v; } .bs-a { grid-area: a; display: flex; align-items: center; gap: 8px; } .bs-c { grid-area: c; justify-self: end; }
    .bs-gh { padding: 12px 10px 10px 14px; grid-template-columns: 26px minmax(0, 1fr); }
    .bs-all { grid-column: 2; justify-self: start; }
  }

  /* On paper: the sheet alone, black on white, a header naming the unit. */
  @media print {
    @page { margin: 14mm; }
    :global(html), :global(body) { background: #fff !important; color: #000 !important; }
    :global(.mast), :global(.side), :global(.sec-tabs), :global(.band), :global(.fb), :global(.livebar), :global([data-side-panel]), :global(dialog), :global(.toast), :global(.peek), :global(.empty) { display: none !important; }
    :global(.shell) { display: block !important; background: none !important; }
    :global(main), :global(.content) { padding: 0 !important; margin: 0 !important; max-width: none !important; }
    :global(.g12) { display: block !important; }
    .bs { display: block; }
    .bs-print { display: block; margin-bottom: 10pt; }
    .bs-print-k { margin: 0 0 4pt; font: 700 16pt/1.2 var(--font-sans); }
    .bs-print dl { margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2pt 14pt; font-size: 9pt; }
    .bs-print dt { color: #555; } .bs-print dd { margin: 0; font-weight: 600; }
    .bs-cols { display: grid; padding: 4pt 0; border-bottom: 1px solid #000; color: #000; }
    .bs-g { border: 0 !important; box-shadow: none !important; background: #fff !important; margin-top: 10pt; break-inside: auto; }
    .bs-gh { padding: 4pt 0; border-bottom: 1px solid #000; break-after: avoid; }
    .bs-r { padding: 4pt 0; break-inside: avoid; border-top-color: #bbb; }
    .bs-r[hidden] { display: grid !important; }
    .bs-g[hidden] { display: block !important; }
    .bs *, .bs :global(*) { color: #000 !important; background: transparent !important; }
    .bs-copy, .bs-all { display: none !important; }
    .bs-nr { border: 1px solid #000; }
  }
</style>
