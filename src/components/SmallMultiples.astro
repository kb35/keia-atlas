---
/* SmallMultiples: a set of identical cards, each the office's own floor map at thumbnail size (UI-V2 §8.7). The
   drawing is FloorMap's thumbnail detail, from the same geometry as the office plan and the isometric floor
   (src/lib/floorplan.mjs), so people learn the shape of their floor once and meet it everywhere. The largest floor
   in the set sets the scale; smaller ones sit centred, never enlarged, so sizes compare honestly.
   A fine space is simply calm: no ring, no colour. A space with a fault or to review takes its state's soft wash
   and its glyph, sized to its space. Hover or focus on a space shows a peek with its name, state and who has it;
   pressing a space opens it with the zoom, and pressing the plan opens the office plan on that floor, the thumbnail
   growing into the plan (MOTION-V2 4.6). Used on Home (the office's floors, the estate), region pages, leadership
   and a vendor's coverage.
   Props:  cards   [{ key, site, floor, title, sub?, to?, figure? }]: one card per floor plan
           health  { <space id>: { h: 'fault' | 'review', why, who? } }: spaces that are not fine
           people  { <id>: first name } for "With Liam"
           min     the smallest card width in px (default 220)
           label   what the set shows, for screen readers ("The Dublin office's floors")
           legend  false leaves out the Key (when another set on the page already shows it)
   Motion: each thumbnail draws in once; a state change eases the tint and the glyph in place; when the feed is not
   reporting, the fine spaces' edges turn dashed (MOTION-V2 4.14) and come back when it reports again. */
import { building } from '../lib/floors.mjs';
import { href } from '../lib/data.mjs';
import { planOf, frameOf } from '../lib/floorplan.mjs';
import { tally } from '../lib/health.mjs';
import FloorMap from './FloorMap.astro';
import HealthKey from './HealthKey.astro';
interface Card { key: string; site: string; floor: string; title: string; sub?: string; to?: string; figure?: string }
interface Props { cards: Card[]; health?: Record<string, { h: string; why?: string; who?: string | null }>; people?: Record<string, string>; min?: number; label?: string; legend?: boolean }
const { cards, health = {}, people = {}, min = 220, label = 'Floor plans', legend = true } = Astro.props;
const models = new Map<string, any>();
const model = (s: string) => { if (!models.has(s)) models.set(s, building(s)); return models.get(s); };
const plans = cards.map((c) => ({ c, P: planOf(model(c.site), c.floor) })).filter((x) => x.P);
const frame = frameOf(plans.map((x) => x.P));
// The floor's own count, in the site's words: "1 fault · 2 to review", or "All fine".
const countOf = (P: any) => {
  const on = P.rooms.map((r: any) => health[r.id]?.h).filter(Boolean);
  return tally(on.filter((h: string) => h === 'fault').length, on.filter((h: string) => h === 'review').length);
};
// Only a card that opens an office's plan zooms into it.
const zooms = (to?: string) => !!to && to.startsWith('/locations/');
---
<div class="sm" data-sm style={`--sm-min:${min}px`} role="group" aria-label={label}>
  <ul class="sm-grid">
    {plans.map(({ c, P }) => (
      <li class="sm-card" data-sm-card={c.key} data-site={c.site}>
        <FloorMap site={c.site} floor={c.floor} detail="thumb" frame={frame} health={health} people={people} to={c.to} zoom={zooms(c.to)} title={c.title} />
        <div class="sm-foot">
          {c.to ? <a class="sm-name" href={href(c.to)}>{c.title}</a> : <b class="sm-name">{c.title}</b>}
          <span class="sm-fig" data-sm-fig>{c.figure ?? countOf(P)}</span>
          {c.sub && <span class="sm-sub">{c.sub}</span>}
        </div>
      </li>
    ))}
  </ul>
  {legend && <HealthKey only={['fine', 'review', 'fault', 'stale']} />}
</div>

<style is:global>
  .sm { display: grid; gap: 12px; container: sm / inline-size; }
  .sm-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(var(--sm-min, 220px), 100%), 1fr)); gap: 12px; margin: 0; padding: 0; list-style: none; }
  .sm-card { display: grid; grid-template-rows: auto 1fr; gap: 10px; min-width: 0; padding: 14px 14px 12px; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface); transition: border-color var(--dur-hover) var(--ease-settle); }
  .sm-card:hover { border-color: var(--line-strong); }
  .sm-card[hidden] { display: none; }
  .sm-foot { display: flex; align-items: baseline; flex-wrap: wrap; gap: 2px 10px; min-width: 0; }
  .sm-name { font-size: var(--fs-name, 14px); font-weight: var(--fw-name, 550); color: var(--text); text-decoration: none; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  a.sm-name:hover { color: var(--accent-ink); text-decoration: underline; text-underline-offset: 2px; }
  /* The count is words, not a code: the normal sans, tabular figures. */
  .sm-fig { margin-left: auto; font: 400 var(--fs-support, 13px)/1.3 var(--font-sans); color: var(--text-2); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .sm-sub { flex-basis: 100%; font-size: var(--fs-support, 13px); color: var(--text-2); }
  .sm .hkey { justify-self: start; }
</style>
