---
// The quick menu behind the gear (Keith, 30 Sept 2026: "way too much in that one settings button"). Short, and it
// never scrolls: who you are viewing as (Change opens View as), light or dark, the look, text size, and three ways
// on: All settings (/settings/), Accessibility and Organisation (/settings/organisation/, which affects everyone).
// Everything else lives on those pages (src/lib/settings.mjs lists the sections).
// Storage is unchanged: rs4-skin and rs4-theme (applied before first paint by the Shell's boot script) and rs7-a11y
// for text size (src/lib/a11y.mjs).
// Motion (docs/rules/motion.md, M11 and M12): it grows from the button that opened it and shrinks back to it; the
// markers slide (the segment, the ring round the chosen look); a look or a mode cross-fades the page (rsTheme);
// text size eases the page to its new size and holds your place (rsChange). Reduced motion: all at once.
import Icon from './Icon.astro';
import { href } from '../lib/data.mjs';
import { LOOKS, MODES, TEXT_STEPS } from '../lib/settings.mjs';
---
<dialog class="qm" id="settings" aria-labelledby="qm-title" tabindex="-1">
  <div class="qm-in">
    <header class="qm-head">
      <h2 id="qm-title">Settings</h2>
      <button type="button" class="icon-btn qm-x" data-settings-close aria-label="Close settings">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </header>

    <button type="button" class="qm-who" data-open-viewas data-help="shell.account" aria-label="Viewing as Anna Byrne. Change who you view as" data-qm-who>
      <span class="avatar" aria-hidden="true" data-who-initials>AB</span>
      <span class="qm-who-t"><small>Viewing as</small><b data-who-name>Anna Byrne</b></span>
      <span class="qm-go">Change<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></span>
    </button>

    <div class="qm-row">
      <span class="qm-l" id="qm-mode-l">Appearance</span>
      <div class="st-seg st-seg-sm" role="radiogroup" aria-labelledby="qm-mode-l" data-qm-seg data-help="shell.mode">
        {MODES.map((m) => (<label><input type="radio" name="qm-mode" value={m.id} /><span>{m.name}</span></label>))}
      </div>
    </div>

    <div class="qm-row">
      <span class="qm-l" id="qm-look-l">Look<small data-qm-look-name>Studio</small></span>
      <div class="qm-looks" role="radiogroup" aria-labelledby="qm-look-l">
        <span class="qm-ring" aria-hidden="true"></span>
        {LOOKS.map((l) => (
          <label class="qm-look" title={`${l.name}: ${l.note}`}>
            <input type="radio" name="qm-skin" value={l.id} aria-label={l.name} />
            <span class="st-swatch" aria-hidden="true">{l.sw.map((c) => <i style={`background:${c}`}></i>)}</span>
          </label>
        ))}
      </div>
    </div>

    <div class="qm-row">
      <span class="qm-l" id="qm-text-l">Text size</span>
      <div class="qm-step" role="group" aria-labelledby="qm-text-l">
        <button type="button" data-text-step="-1" aria-label="Smaller text"><span aria-hidden="true">A<sup>−</sup></span></button>
        <output data-text-now aria-live="polite">{TEXT_STEPS[0].name}</output>
        <button type="button" data-text-step="1" aria-label="Larger text"><span aria-hidden="true">A<sup>+</sup></span></button>
      </div>
    </div>

    <nav class="qm-links" aria-label="More settings">
      <a href={href('/settings/')} data-qm-link data-verb="settings" data-verb-name="Open settings" data-verb-always><Icon name="sliders" size={16} /><span>All settings</span><Icon name="arrow" size={14} /></a>
      <a href={href('/settings/#accessibility')} data-qm-link data-verb="settings-a11y" data-verb-name="Accessibility settings" data-verb-always><Icon name="about" size={16} /><span>Accessibility</span><Icon name="arrow" size={14} /></a>
      <a href={href('/settings/organisation/')} data-qm-link data-verb="settings-org" data-verb-name="Organisation settings" data-verb-always><Icon name="sites" size={16} /><span>Organisation<small>Affects everyone</small></span><Icon name="arrow" size={14} /></a>
    </nav>
  </div>
</dialog>

<script is:inline data-astro-rerun define:vars={{ LOOKS, TEXT_STEPS }}>
  (function () {
    // (a page can have its own #settings section, such as the Settings page, so look for the dialog itself)
    var dlg = document.querySelector('dialog#settings');
    if (!dlg || dlg.__qm) return;
    dlg.__qm = true;
    var W = window, opener = null;
    var get = function (k, d) { try { return localStorage.getItem(k) || d; } catch (_) { return d; } };
    var put = function (k, v) { try { localStorage.setItem(k, v); } catch (_) {} };
    var NAME = {}; LOOKS.forEach(function (l) { NAME[l.id] = l.name; });
    var STEPS = TEXT_STEPS.map(function (s) { return s.id; });
    // The ring round the chosen look slides from swatch to swatch (M12).
    function ring() {
      var box = dlg.querySelector('.qm-looks'), mk = box.querySelector('.qm-ring'), on = box.querySelector('.qm-look:has(input:checked)');
      if (!on) { mk.classList.remove('on'); return; }
      var first = !mk.classList.contains('on');
      if (first) mk.style.transition = 'none';
      mk.style.transform = 'translate(' + on.offsetLeft + 'px,' + on.offsetTop + 'px)';
      if (first) { mk.classList.add('on'); void mk.offsetWidth; mk.style.transition = ''; }
    }
    function sync() {
      var s = get('rs4-skin', 'studio'), t = get('rs4-theme', 'system'), a = W.rsA11y ? W.rsA11y() : { text: 'default' };
      dlg.querySelectorAll('input[name=qm-skin]').forEach(function (i) { i.checked = i.value === s; });
      dlg.querySelectorAll('input[name=qm-mode]').forEach(function (i) { i.checked = i.value === t; });
      var ln = dlg.querySelector('[data-qm-look-name]'); if (ln) ln.textContent = NAME[s] || NAME.studio;
      var n = STEPS.indexOf(a.text); if (n < 0) n = 0;
      dlg.querySelector('[data-text-now]').textContent = TEXT_STEPS[n].name;
      dlg.querySelector('[data-text-step="-1"]').disabled = n === 0;
      dlg.querySelector('[data-text-step="1"]').disabled = n === STEPS.length - 1;
      var who = dlg.querySelector('[data-qm-who]'), nm = who.querySelector('[data-who-name]');
      who.setAttribute('aria-label', 'Viewing as ' + nm.textContent + '. Change who you view as');
      ring();
      dlg.querySelectorAll('[data-qm-seg]').forEach(function (g) {
        if (W.rsMarker) W.rsMarker(g, function () { var i = g.querySelector('input:checked'); return i && i.closest('label'); });
      });
    }
    // Open beside the button that opened it, top edge fixed, so nothing moves under the pointer as you choose.
    function place() {
      var vw = document.documentElement.clientWidth, vh = innerHeight, g = 12, w = dlg.offsetWidth, h = dlg.offsetHeight;
      var r = opener && opener.getClientRects().length ? opener.getBoundingClientRect() : null;
      var left = r ? (r.left + w > vw - g ? r.right - w : r.left) : (vw - w) / 2;
      left = Math.max(g, Math.min(left, vw - w - g));
      var top;
      if (!r) top = Math.max(g, (vh - h) / 2);
      else if (r.top > vh / 2) top = Math.max(g, r.top - 8 - h);   // the button is low: open upwards
      else top = Math.min(r.bottom + 8, Math.max(g, vh - h - g));
      dlg.style.left = Math.round(left) + 'px'; dlg.style.top = Math.round(top) + 'px';
    }
    function open(from) {
      opener = from || null;
      if (dlg.open && !dlg.classList.contains('closing')) return;
      if (W.rsPreloadLooks) W.rsPreloadLooks();
      dlg.classList.remove('closing'); dlg.getAnimations().forEach(function (a) { a.cancel(); });
      if (W.rsSyncDemo) W.rsSyncDemo();
      if (!dlg.open) dlg.showModal();
      sync(); place(); sync();
      dlg.focus({ preventScroll: true });
      if (W.rsPopIn) W.rsPopIn(dlg, opener);
    }
    function close(then) {
      if (!dlg.open || dlg.classList.contains('closing')) { if (then) then(); return; }
      dlg.classList.add('closing');
      var done = function () {
        dlg.classList.remove('closing'); dlg.close();
        if (then) then();
        else if (opener && opener.focus && opener.isConnected && opener.getClientRects().length) opener.focus({ preventScroll: true });
      };
      if (W.rsPopOut) W.rsPopOut(dlg, opener && opener.isConnected ? opener : null, done); else done();
    }
    dlg.addEventListener('change', function (e) {
      var i = e.target, v = i.value;
      if (i.name === 'qm-skin') { put('rs4-skin', v); W.rsTheme(function () { W.rsApplyTheme(); if (W.rsSyncMode) W.rsSyncMode(); }, v); }
      if (i.name === 'qm-mode') { put('rs4-theme', v); W.rsTheme(function () { W.rsApplyTheme(); if (W.rsSyncMode) W.rsSyncMode(); }); }
      sync();
      document.dispatchEvent(new CustomEvent('rs:settings-change', { detail: { what: i.name.replace('qm-', '') } }));
    });
    dlg.addEventListener('click', function (e) {
      if (e.target === dlg) { close(); return; }
      var st = e.target.closest && e.target.closest('[data-text-step]');
      if (st) {
        var a = W.rsA11y ? W.rsA11y() : { text: 'default' }, n = Math.max(0, STEPS.indexOf(a.text)) + Number(st.dataset.textStep);
        if (n < 0 || n >= STEPS.length) return;
        var apply = function () { W.rsSetA11y({ text: STEPS[n] }); };
        if (W.rsChange) W.rsChange(apply); else apply();
        sync(); place();
        return;
      }
      if (e.target.closest && e.target.closest('[data-qm-link]')) {
        // A link to where you already are (the Settings page, another section) only needs the menu out of the way.
        dlg.classList.remove('closing'); dlg.close();
      }
    });
    dlg.querySelector('[data-settings-close]').addEventListener('click', function () { close(); });
    dlg.addEventListener('cancel', function (e) { e.preventDefault(); close(); });
    document.addEventListener('rs:a11y', function () { if (dlg.isConnected && dlg.open) sync(); });
    document.querySelectorAll('[data-open-settings]').forEach(function (b) {
      b.addEventListener('click', function () { var acct = document.querySelector('[data-acct-menu]'); open(b.closest('.vp') ? acct : b); });
    });
    if (!W.__rsQmHook) {
      W.__rsQmHook = true;
      W.addEventListener('resize', function () { var d = document.querySelector('dialog#settings'); if (d && d.open && d.__rsPlace) d.__rsPlace(); });
    }
    dlg.__rsPlace = function () { place(); sync(); };
    W.rsQuickSettings = { open: open, close: close };
  })();
</script>

<style is:global>
  /* One short card beside its button. It never scrolls: at most six things, none of them wraps. */
  .qm { position: fixed; inset: auto; margin: 0; width: min(344px, calc(100vw - 24px)); max-height: none; padding: 0; overflow: visible; border: var(--border-card); border-radius: var(--radius-lg); background: var(--surface); color: var(--text); box-shadow: var(--shadow-lg); }
  .qm:focus { outline: none; }   /* it takes focus itself on opening, so no control lights up unasked */
  .qm::backdrop { background: color-mix(in srgb, #000 14%, transparent); animation: rs-fade-in var(--dur-pop) var(--ease-settle); }
  .qm.closing::backdrop { animation: rs-fade-out var(--dur-exit) var(--ease-settle) forwards; }
  .qm-in { display: grid; gap: 4px; padding: 12px 16px 12px; }
  .qm-head { display: flex; align-items: center; justify-content: space-between; min-height: 36px; }
  .qm-head h2 { margin: 0; font: 600 var(--fs-h3, 15px)/1.2 var(--font-sans); }
  .qm-x { margin-right: -8px; }

  .qm-who { display: flex; align-items: center; gap: 12px; width: 100%; min-width: 0; margin: 6px 0 8px; padding: 10px 12px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface-2); color: var(--text); font: inherit; text-align: left; cursor: pointer; transition: background var(--dur-hover) var(--ease-settle), border-color var(--dur-hover) var(--ease-settle); }
  .qm-who:hover { border-color: var(--line-strong); }
  .qm-who:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .qm-who .avatar { flex: none; width: 2.5em; height: 2.5em; border-radius: 50%; display: grid; place-items: center; background: var(--accent-soft); color: var(--accent-ink); font: 650 13px/1 var(--font-sans); }
  .qm-who-t { display: grid; gap: 1px; min-width: 0; flex: 1; }
  .qm-who-t small { font-size: var(--fs-code, 12.5px); color: var(--text-2); }
  .qm-who-t b { font: 600 var(--fs-name, 14px)/1.3 var(--font-sans); overflow-wrap: anywhere; }
  .qm-go { display: inline-flex; align-items: center; gap: 2px; flex: none; font: 600 13px/1 var(--font-sans); color: var(--accent-ink); }

  /* A row: its name on the left, its control on the right; 52 px tall, a rule between. */
  .qm-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 52px; padding: 6px 0; border-top: 1px solid var(--line); }
  .qm-l { display: grid; gap: 1px; font: 550 var(--fs-body, 14px)/1.25 var(--font-sans); color: var(--text); white-space: nowrap; }
  .qm-l small { font: 400 var(--fs-code, 12.5px)/1.25 var(--font-sans); color: var(--text-2); }

  .qm-looks { position: relative; display: flex; gap: 6px; }
  .qm-look { position: relative; z-index: 1; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; cursor: pointer; }
  .qm-look input { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }
  .qm-look .st-swatch { width: 26px; height: 26px; transition: transform var(--dur-press) var(--ease-settle); }
  .qm-look:hover .st-swatch { transform: rotate(45deg) scale(1.08); }
  .qm-look:has(input:focus-visible) { outline: 2px solid var(--focus); outline-offset: 1px; }
  .qm-ring { position: absolute; left: 0; top: 0; width: 34px; height: 34px; border-radius: 50%; box-shadow: inset 0 0 0 2px var(--accent); pointer-events: none; transition: transform var(--dur-morph) var(--ease-settle); }
  .qm-ring:not(.on) { opacity: 0; }

  .qm-step { display: inline-flex; align-items: center; gap: 2px; padding: 3px; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--line); }
  .qm-step button { display: grid; place-items: center; min-width: 36px; height: 30px; padding: 0 8px; border: 0; border-radius: 999px; background: none; color: var(--text); font: 650 14px/1 var(--font-sans); cursor: pointer; transition: background var(--dur-hover) var(--ease-settle); }
  .qm-step button:hover:not(:disabled) { background: var(--surface); }
  .qm-step button:disabled { color: var(--text-3); cursor: default; }
  .qm-step sup { font-size: .7em; vertical-align: .45em; margin-left: 1px; }
  .qm-step output { min-width: 60px; text-align: center; font: 600 12.5px/1 var(--font-sans); color: var(--text-2); }

  .qm-links { display: grid; margin: 4px -8px 0; padding-top: 6px; border-top: 1px solid var(--line); }
  .qm-links a { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 12px; min-height: 44px; padding: 6px 8px; border-radius: var(--radius); color: var(--text); text-decoration: none; font: 550 var(--fs-body, 14px)/1.25 var(--font-sans); transition: background var(--dur-hover) var(--ease-settle); }
  .qm-links a:hover { background: var(--surface-2); color: var(--text); }
  .qm-links a > svg:first-child { color: var(--text-2); }
  .qm-links a > svg:last-child { color: var(--text-3); }
  .qm-links span { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; white-space: nowrap; }
  .qm-links small { font: 400 var(--fs-code, 12.5px)/1.2 var(--font-sans); color: var(--text-3); }
  @media (prefers-reduced-motion: reduce) { .qm::backdrop, .qm.closing::backdrop { animation: none; } }
</style>
