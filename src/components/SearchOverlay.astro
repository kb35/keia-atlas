---
/* Global search: the overlay behind the search button in the top bar, "/" and Cmd or Ctrl+K.
   Also defines window.rsSearch, the small UI library the full results page (/search/) uses too.

   What it is: faceted search plus a small rule-based query parser (src/lib/search-query.mjs), not
   an AI model. The parser spots what you want back (rooms, devices, configurations...), the things
   you named (a region, a site, a model, a status, an age) and how they relate ("with", "without"),
   and shows each as a chip you can remove or change. The same words always give the same answer.

   The engine is inlined here from src/lib/search-query.mjs (exports stripped) so the unit tests and
   the browser run the same code. The index (/search/index.json) loads the first time search opens.

   Three modes, on the first character (UX-V2 §2.3):
     words  Find: objects, as above. Before you type, the objects you opened last (rs6-recent-objects).
     >      Do: the verbs on this page (src/lib/verbs.mjs): each is a button on the page carrying data-verb,
            listed under its own name, and Enter presses it. The palette never does what the page cannot.
     ?      Ask: the plain-words parser (Enter opens the search page with its chips), the glossary and the
            method pages.
   Rows render from memory on the keystroke's next frame; the first row is under 50 ms (tests/palette.test.mjs). */
import Icon from './Icon.astro';
import { href } from '../lib/data.mjs';
import engineRaw from '../lib/search-query.mjs?raw';
import verbsRaw from '../lib/verbs.mjs?raw';
import { IDEAS, METHOD, plain } from '../lib/method.mjs';

const API = ['load', 'parse', 'search', 'alternatives', 'canon', 'removeSpan', 'replaceSpan', 'addToQuery', 'setKind', 'KINDS'];
const body = engineRaw
  .replace(/^export \{[^}]*\};?\s*$/m, '')
  .split('\n').filter((l) => !/^\s*\/\//.test(l) && l.trim()).map((l) => l.trim()).join('\n');
const engine = `if(!window.KeiaSearch){(function(){\n${body}\nwindow.KeiaSearch={${API.map((k) => `${k}:${k}`).join(',')}};})();}`;
// The verbs, the same way (src/lib/verbs.mjs, exports stripped).
const verbsBody = verbsRaw.replace(/^export \{[^}]*\};?\s*$/m, '').split('\n').filter((l) => !/^\s*\/\//.test(l) && l.trim()).map((l) => l.trim()).join('\n');
const verbsJs = `if(!window.KeiaVerbs){(function(){\n${verbsBody}\nwindow.KeiaVerbs={VERBS:VERBS,verbRows:verbRows,matchVerbs:matchVerbs,paletteMode:paletteMode};})();}`;
// Ask mode also offers the method pages (/method/): the method in one screen, then one page per idea.
const METHOD_PAGES = [{ t: 'The Keia Method', s: plain(METHOD.sentence), u: 'method/' }, ...IDEAS.map((i) => ({ t: plain(i.name), s: plain(i.line), u: `method/${i.slug}/` }))];
const ASK_EXAMPLES = ['who is on site in APAC', 'EMEA spaces with X52', 'displays older than 7 years', 'what is a known error'];
const ICONS = { room: 'room', unit: 'barcode', model: 'box', dp: 'devices', rp: 'types', cfg: 'sliders', set: 'sliders', fw: 'chip', prj: 'project', task: 'check', pb: 'playbook',
  inc: 'alert', lab: 'flask', adv: 'shield', person: 'team', ven: 'kit', site: 'sites', rack: 'rack', plan: 'calendar', spare: 'box', cable: 'wire', svc: 'devices', ki: 'shield', recent: 'refresh', try: 'search',
  verb: 'arrow', term: 'book', method: 'decisions', ask: 'search' };
const EXAMPLES = ['EMEA spaces with X52', 'x52 in Dublin', 'retired codecs', 'setup guides for poly', 'projects at the Dublin office', 'displays older than 7 years', 'who is on site in APAC', 'cafeteria'];
---
<template data-ks-icons>{Object.entries(ICONS).map(([k, n]) => <span data-icon={k}><Icon name={n} size={16} /></span>)}</template>
<div class="ks" data-ks hidden data-index={href('/search/index.json')} data-page={href('/search/')} data-help-index={href('/help/index.json')} data-method={JSON.stringify(METHOD_PAGES)}>
  <div class="ks-back" data-ks-close></div>
  <div class="ks-panel" role="dialog" aria-modal="true" aria-label="Search Keia Atlas" data-ks-root data-mode="overlay">
    <div class="ks-top">
      <label class="ks-field">
        <Icon name="search" size={20} />
        <span class="sr-only">Search Keia Atlas</span>
        <input type="text" data-ks-input placeholder="Find anything · > to act on this page · ? to ask" autocomplete="off" autocapitalize="off" spellcheck="false"
          role="combobox" aria-expanded="true" aria-controls="ks-results" aria-autocomplete="list" enterkeyhint="search" />
        <button type="button" class="ks-clear" data-ks-clear aria-label="Clear" hidden>×</button>
      </label>
      <button type="button" class="ks-esc" data-ks-close aria-label="Close search"><kbd>Esc</kbd><span>Close</span></button>
    </div>
    <div class="ks-chips" data-ks-chips aria-label="What Keia Atlas understood"></div>
    <p class="ks-note" data-ks-note hidden></p>
    <div class="ks-body" data-ks-scroll>
      <div class="ks-results" id="ks-results" role="listbox" aria-label="Results" data-ks-results></div>
      <div class="ks-empty" data-ks-empty>
        <section data-ks-recent-wrap hidden>
          <header><span class="overline">Recent</span><button type="button" class="ks-link" data-ks-recent-clear>Clear</button></header>
          <div class="ks-list" data-ks-recent></div>
        </section>
        <section>
          <header><span class="overline">Try</span></header>
          <div class="ks-try">{EXAMPLES.map((q) => <button type="button" class="ks-ex" data-ks-q={q}>{q}</button>)}</div>
        </section>
        <p class="ks-how faint">Type the way you would ask a colleague. Keia Atlas picks out what you want, where, which model and which status, and shows each as a chip you can remove or change.</p>
      </div>
    </div>
    <footer class="ks-foot">
      <span class="ks-keys"><kbd>↑</kbd><kbd>↓</kbd> move <kbd>↵</kbd> open <kbd data-ks-mod>Ctrl</kbd><kbd>↵</kbd> all results · <kbd>&gt;</kbd> act <kbd>?</kbd> ask</span>
      <a class="ks-all" data-ks-all href={href('/search/')}>All results</a>
    </footer>
  </div>
</div>

<script is:inline data-astro-rerun set:html={engine}></script>
<script is:inline data-astro-rerun set:html={verbsJs}></script>
<template data-ks-ask-ex>{ASK_EXAMPLES.map((q) => <button type="button" class="ks-ex" data-ks-q={`?${q}`}>{q}</button>)}</template>
<script is:inline data-astro-rerun>
  (function () {
    /* The shared UI: loading the index, links, recent searches, and binding a search box to results.
       Defined once per visit; everything it touches is looked up in the current page each time. */
    if (!window.rsSearch) {
      var S = window.KeiaSearch;
      var RECENT = 'rs4-search-recent', RECENT_OBJ = 'rs6-recent-objects';
      var V = window.KeiaVerbs;
      var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
      var reduced = function () { return (window.rsReduced ? window.rsReduced() : matchMedia('(prefers-reduced-motion: reduce)').matches); };
      var host = function () { return document.querySelector('[data-ks]'); };
      var indexUrl = function () { var h = host(); return new URL(h ? h.getAttribute('data-index') : 'search/index.json', location.href); };
      var lib = window.rsSearch = {
        esc: esc,
        ready: function () {
          if (!window.__rsSearchIndex) {
            window.__rsSearchIndex = fetch(indexUrl()).then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); }).then(function (raw) { return S.load(raw); });
            window.__rsSearchIndex.catch(function () { window.__rsSearchIndex = null; });
          }
          return window.__rsSearchIndex;
        },
        // A path inside the site ("rooms/dub-3-01/") as a link that works on the server and in the file preview.
        url: function (path) {
          var root = new URL('../', indexUrl());
          var m = /^([^?#]*)([?#].*)?$/.exec(path), p = m[1], rest = m[2] || '';
          if (window.__rsRelative && (p === '' || p.slice(-1) === '/')) p += 'index.html';
          return new URL(p + rest, root).href;
        },
        page: function (q) { return lib.url('search/' + (q ? '?q=' + encodeURIComponent(q) : '')); },
        icon: function (k) { var t = document.querySelector('template[data-ks-icons]'); var el = t && t.content.querySelector('[data-icon="' + k + '"]'); return el ? el.innerHTML : ''; },
        recent: {
          get: function () { try { var v = JSON.parse(localStorage.getItem(RECENT) || '[]'); return Array.isArray(v) ? v : []; } catch (_) { return []; } },
          add: function (q) { q = String(q || '').trim(); if (q.length < 2) return; var l = lib.recent.get().filter(function (x) { return x.toLowerCase() !== q.toLowerCase(); }); l.unshift(q); try { localStorage.setItem(RECENT, JSON.stringify(l.slice(0, 8))); } catch (_) {} },
          clear: function () { try { localStorage.removeItem(RECENT); } catch (_) {} },
        },
        // The records you opened last (a space, an incident, a project), newest first, for the palette before you type.
        objects: {
          get: function () { try { var v = JSON.parse(localStorage.getItem(RECENT_OBJ) || '[]'); return Array.isArray(v) ? v : []; } catch (_) { return []; } },
          add: function (o) {
            if (!o || !o.t || !o.u) return;
            var l = lib.objects.get().filter(function (x) { return x.u.split('?')[0] !== o.u.split('?')[0]; }); l.unshift(o);
            try { localStorage.setItem(RECENT_OBJ, JSON.stringify(l.slice(0, 8))); } catch (_) {}
          },
        },
        // The glossary, from the help registry (term:<id> cards), loaded the first time Ask needs it.
        terms: function () {
          if (!window.__rsTerms) {
            var h = host(), src = h && h.getAttribute('data-help-index');
            window.__rsTerms = src ? fetch(new URL(src, location.href)).then(function (r) { return r.ok ? r.json() : {}; }).then(function (j) {
              return Object.keys(j).filter(function (k) { return k.indexOf('term:') === 0; }).map(function (k) { return { id: k.slice(5), t: j[k].name, s: j[k].what }; });
            }).catch(function () { window.__rsTerms = null; return []; }) : Promise.resolve([]);
          }
          return window.__rsTerms;
        },
        // Mark the words you typed inside a title.
        hl: function (text, terms) {
          var out = esc(text);
          (terms || []).forEach(function (t) {
            (t.alts || []).forEach(function (a) {
              if (!a || a.length < 2) return;
              var re = new RegExp('(^|[\\s(,.-])(' + a.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'ig');
              out = out.replace(re, '$1<mark>$2</mark>');
            });
          });
          return out;
        },
        VENDOR_KINDS: { model: 1, dp: 1, cfg: 1, set: 1, fw: 1, adv: 1 },
        bind: bind,
      };

      // Binds one search UI (the overlay or the results page). Each needs [data-ks-input],
      // [data-ks-chips], [data-ks-note], [data-ks-results] and [data-ks-empty]; the page adds facets.
      function bind(root, opts) {
        opts = opts || {};
        var $ = function (s) { return root.querySelector(s); };
        var input = $('[data-ks-input]'), chipsEl = $('[data-ks-chips]'), note = $('[data-ks-note]'), list = $('[data-ks-results]'), empty = $('[data-ks-empty]');
        var facetsEl = $('[data-ks-facets]'), countEl = $('[data-ks-count]'), allLink = root.querySelector('[data-ks-all]') || (root.parentElement && root.parentElement.querySelector('[data-ks-all]'));
        var clearBtn = $('[data-ks-clear]');
        var I = null, last = null, prevKeys = new Set(), active = -1, expanded = {}, menu = null, verbs = [], terms = null;
        var palette = opts.mode === 'overlay' && !!V;
        var per = opts.perGroup || 4;
        var ctl = { root: root, input: input };

        function renderRecent() {
          var wrap = $('[data-ks-recent-wrap]'), box = $('[data-ks-recent]'); if (!wrap || !box) return;
          var l = lib.recent.get(); wrap.hidden = !l.length;
          box.innerHTML = l.map(function (q) { return '<button type="button" class="ks-rec" data-ks-q="' + esc(q) + '"><span class="ks-ic">' + lib.icon('recent') + '</span><span>' + esc(q) + '</span></button>'; }).join('');
        }
        function row(r, i, P) {
          var it = r.it, k = S.KINDS.find(function (x) { return x.code === it.k; });
          var tag = it.z && it.z.indexOf('retired') >= 0 ? 'Retired' : it.z && it.z.indexOf('legacy') >= 0 && it.k === 'unit' ? 'Older kit' : it.st && it.st.length === 1 && I.sites[it.st[0]] ? I.sites[it.st[0]][0] : '';
          var key = it.k + '|' + it.u + '|' + it.t;
          return '<a class="ks-row" role="option" id="' + root.id + '-o' + i + '" data-i="' + i + '" data-key="' + esc(key) + '" href="' + esc(lib.url(it.u)) + '">' +
            '<span class="ks-ic" title="' + esc(k ? k.one : '') + '">' + lib.icon(it.k) + '</span>' +
            '<span class="ks-tx"><b>' + lib.hl(it.t, P.terms) + '</b><small>' + esc(it.s) + '</small></span>' +
            (tag ? '<span class="ks-tag">' + esc(tag) + '</span>' : '') + '</a>';
        }
        function chipHtml(c, i) {
          var editable = c.type !== 'term' && c.type !== 'age' && c.type !== 'year' && c.type !== 'floor';
          return '<span class="ks-chip t-' + c.type + (c.neg ? ' neg' : '') + '" style="--i:' + i + '">' +
            (editable ? '<button type="button" class="ks-chip-l" data-chip="' + i + '" aria-haspopup="menu" title="Change">' + esc(c.label) + '<svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="M7 10l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></button>'
              : '<span class="ks-chip-l">' + esc(c.label) + '</span>') +
            '<button type="button" class="ks-chip-x" data-chip-x="' + i + '" aria-label="Remove ' + esc(c.label) + '">×</button></span>';
        }
        function facetHtml(F, P) {
          var block = function (title, key, vals, max) {
            if (!vals || !vals.length || (vals.length < 2 && !vals.some(function (v) { return v.on; }))) return '';
            return '<section class="ks-fc"><p class="overline">' + title + '</p>' + vals.slice(0, max || 8).map(function (v) {
              return '<button type="button" class="ks-fv' + (v.on ? ' on' : '') + '" aria-pressed="' + (v.on ? 'true' : 'false') + '" data-facet="' + key + '" data-v="' + esc(v.v) + '" data-q="' + esc(v.q) + '"><span>' + esc(v.label) + '</span><span class="num">' + v.n + '</span></button>';
            }).join('') + '</section>';
          };
          return block('Show', 'kind', F.kind, 21) + block('Region', 'region', F.region) + block('Office', 'site', F.site, 11) + block('Status', 'status', F.status) +
            block('Device kind', 'class', F.class) + block('Make', 'make', F.make) + block('Space type', 'profile', F.profile);
        }
        // A kind of record (Shell's about.kind) as a search kind, for its icon.
        var OBJ_KIND = { room: 'room', comms: 'rack', office: 'site', region: 'site', incident: 'inc', project: 'prj', task: 'task', model: 'model', 'known-issue': 'ki', 'maker-case': 'ki', playbook: 'pb', service: 'svc', standard: 'rp', config: 'cfg', profile: 'dp', unit: 'unit', device: 'unit' };
        function objRow(o, i) {
          return '<a class="ks-row" role="option" id="' + root.id + '-o' + i + '" data-i="' + i + '" data-key="obj|' + esc(o.u) + '" href="' + esc(o.u) + '">' +
            '<span class="ks-ic">' + lib.icon(OBJ_KIND[o.k] || 'recent') + '</span><span class="ks-tx"><b>' + esc(o.t) + '</b><small>' + esc(o.s || 'Opened recently') + '</small></span></a>';
        }
        function linkRow(it, i, icon) {
          return '<a class="ks-row" role="option" id="' + root.id + '-o' + i + '" data-i="' + i + '" data-key="' + esc(icon + '|' + it.u) + '" href="' + esc(it.href || lib.url(it.u)) + '">' +
            '<span class="ks-ic">' + lib.icon(icon) + '</span><span class="ks-tx"><b>' + esc(it.t) + '</b><small>' + esc(it.s || '') + '</small></span></a>';
        }
        function group(label, html) { return '<section class="ks-grp" role="group" aria-label="' + esc(label) + '"><header><span class="overline">' + esc(label) + '</span></header>' + html + '</section>'; }
        // The page's verbs, as the buttons they are (src/lib/verbs.mjs): only what you can see and press now.
        function pageVerbs() {
          var seen = function (el) { return el.isConnected && el.getClientRects().length > 0 && !el.disabled && !el.closest('[hidden], [inert], [data-ks]'); };
          var name = function (el) { return (el.dataset.verbName || el.textContent || el.getAttribute('aria-label') || el.title || '').replace(/\s+/g, ' ').trim(); };
          var found = [];
          document.querySelectorAll('[data-verb]').forEach(function (el) { if (seen(el)) found.push({ id: el.dataset.verb, label: name(el), ref: el }); });
          document.querySelectorAll('main .pb-act a, main .pb-act button').forEach(function (el) { if (seen(el) && !el.hasAttribute('data-verb')) found.push({ id: 'action', label: name(el), ref: el }); });
          // Zoom out: the path's parent step, under its own name ([ does the same).
          var ups = document.querySelectorAll('.mast .crumbs a[href]'), up = ups[ups.length - 1];
          if (up && seen(up)) found.push({ id: 'zoom-out', label: name(up), hint: 'Zoom out one level, or press [', ref: up });
          var rows = V.verbRows(found);
          rows.forEach(function (r, i) { r.ref = found.filter(function (f) { return f.id === r.id && f.label.trim().toLowerCase() === r.label.toLowerCase(); })[0].ref; });
          return rows;
        }
        function runDo(q) {
          if (!verbs.length) verbs = pageVerbs();
          var rows = V.matchVerbs(verbs, q);
          chipsEl.innerHTML = ''; chipsEl.hidden = true; empty.hidden = true;
          note.innerHTML = rows.length ? '' : 'No verb on this page matches. Type > on its own to see them all.'; note.hidden = !!rows.length;
          list.innerHTML = rows.length ? group('On this page', rows.map(function (r, i) {
            return '<button type="button" class="ks-row ks-verb" role="option" id="' + root.id + '-o' + i + '" data-i="' + i + '" data-verb-row="' + verbs.indexOf(r) + '">' +
              '<span class="ks-ic">' + lib.icon('verb') + '</span><span class="ks-tx"><b>' + esc(r.label) + '</b><small>' + esc(r.hint || '') + '</small></span></button>';
          }).join('')) : '';
          if (countEl) countEl.textContent = '';
          setActive(rows.length ? 0 : -1);
        }
        function runAsk(q) {
          var t = q.trim(), html = '', i = 0;
          empty.hidden = true;
          if (!t) {
            chipsEl.innerHTML = ''; chipsEl.hidden = true; note.hidden = true;
            var ex = document.querySelector('template[data-ks-ask-ex]');
            list.innerHTML = '<div class="ks-ask-help"><p class="faint">Ask in plain words: what you want back, where, and anything about it. Enter opens the search page with what Keia Atlas understood.</p><div class="ks-try">' + (ex ? ex.innerHTML : '') + '</div></div>';
            setActive(-1); return;
          }
          if (I) {
            var R = S.search(I, t, {}), P = R.P;
            chipsEl.innerHTML = P.chips.map(chipHtml).join(''); chipsEl.hidden = !P.chips.length;
            last = R;
            html += group('Ask', linkRow({ t: t, s: (R.total ? R.total.toLocaleString('en-IE') + (R.total === 1 ? ' result' : ' results') : 'No results yet') + ' · opens the search page with these chips', href: lib.page(t), u: 'search' }, i++, 'ask'));
          } else html += '<p class="ks-wait faint">Loading the index…</p>';
          var words = t.toLowerCase().split(/\s+/).filter(function (w) { return w.length > 2 && !/^(what|who|how|the|and|for|with|is|are|does|mean|means)$/.test(w); });
          var hit = function (x) { var h = (x.t + ' ' + x.s).toLowerCase(); return words.length && words.some(function (w) { return h.indexOf(w) >= 0; }); };
          var tl = (terms || []).filter(hit).slice(0, 4);
          if (tl.length) html += group('In the glossary', tl.map(function (x) { return linkRow({ t: x.t, s: x.s, u: 'learn/#g-' + x.id }, i++, 'term'); }).join(''));
          var mp = (JSON.parse(host().getAttribute('data-method') || '[]')).filter(hit).slice(0, 3);
          if (mp.length) html += group('In the method', mp.map(function (x) { return linkRow(x, i++, 'method'); }).join(''));
          note.hidden = true;
          list.innerHTML = html;
          setActive(0);
        }
        function runRecentObjects() {
          var l = lib.objects.get().filter(function (o) { return o.u.split('?')[0] !== location.pathname; }).slice(0, 5);
          list.innerHTML = l.length ? group('Recently opened', l.map(objRow).join('')) : '';
          setActive(l.length ? 0 : -1);
        }
        function setActive(n) {
          var rows = list.querySelectorAll('.ks-row');
          if (!rows.length || n < 0) { active = -1; input.removeAttribute('aria-activedescendant'); rows.forEach(function (r) { r.setAttribute('aria-selected', 'false'); }); return; }
          active = Math.max(0, Math.min(n, rows.length - 1));
          rows.forEach(function (r, i) { r.setAttribute('aria-selected', i === active ? 'true' : 'false'); });
          input.setAttribute('aria-activedescendant', rows[active].id);
          var scroller = root.querySelector('[data-ks-scroll]');
          if (opts.mode === 'page') rows[active].scrollIntoView({ block: 'nearest' });
          else if (scroller) { var r = rows[active].getBoundingClientRect(), b = scroller.getBoundingClientRect(); if (r.bottom > b.bottom - 8) scroller.scrollTop += r.bottom - b.bottom + 8; else if (r.top < b.top + 30) scroller.scrollTop -= b.top + 30 - r.top; }
        }
        function run() {
          var q = input.value;
          var pm = palette ? V.paletteMode(q) : { mode: 'find', q: q };
          if (clearBtn) clearBtn.hidden = !q;
          if (allLink) allLink.href = lib.page(pm.mode === 'do' ? '' : pm.q.trim());
          root.setAttribute('data-pmode', pm.mode);
          if (pm.mode === 'do') { runDo(pm.q); return; }
          if (pm.mode === 'ask') { if (!terms) lib.terms().then(function (t) { terms = t || []; if (V.paletteMode(input.value).mode === 'ask') run(); }); runAsk(pm.q); return; }
          if (!I) { list.innerHTML = q.trim() ? '<p class="ks-wait faint">Loading the index…</p>' : ''; empty.hidden = !!q.trim(); renderRecent(); if (!q.trim() && palette) runRecentObjects(); return; }
          var R = S.search(I, q, { facets: !!facetsEl });
          var vendor = document.documentElement.getAttribute('data-who-kind') === 'vendor';
          if (vendor) { R.top = R.top.filter(function (r) { return lib.VENDOR_KINDS[r.it.k]; }); R.groups = R.groups.filter(function (g) { return lib.VENDOR_KINDS[g.k]; }); R.total = R.top.length + R.groups.reduce(function (n, g) { return n + g.total; }, 0); }
          last = R;
          var P = R.P, has = !!q.trim();
          if (!has && palette) { chipsEl.innerHTML = ''; chipsEl.hidden = true; note.hidden = true; empty.hidden = false; renderRecent(); runRecentObjects(); if (opts.onRun) opts.onRun(q, R); return; }
          empty.hidden = has; if (!has) renderRecent();
          chipsEl.innerHTML = P.chips.map(chipHtml).join('');
          chipsEl.hidden = !P.chips.length;
          // Did you mean: a correction already applied, or a suggestion to try.
          var bits = [];
          if (P.corrected && !P.suggest && P.corrected.trim().toLowerCase() !== q.trim().toLowerCase()) bits.push('Read as <b>' + esc(P.corrected) + '</b>');
