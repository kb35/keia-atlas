---
/* SimTag: the one tag that says a page is not live (rule P5). Three wordings exist:
   "Simulated" (made-up figures or people), "Simulated live" (made-up figures that change as you watch,
   kind="live") and "Stage n" (arrives at a later adoption stage).
   Used by PageBand's overline row only; pages pass `sim` (true or "live") or `stage` to PageBand instead. */
interface Props { kind: string }
const { kind } = Astro.props;
const stage = /^stage:(\d)$/.exec(kind ?? '')?.[1];
if (!stage && kind !== 'simulated' && kind !== 'live') throw new Error(`SimTag: kind must be "simulated", "live" or "stage:<n>", not "${kind}"`);
const live = kind === 'live';
const text = stage ? `Stage ${stage}` : live ? 'Simulated live' : 'Simulated';
const tip = stage ? `Arrives at adoption stage ${stage}. Switch stages in Settings.` : live ? 'Made-up figures that change as you watch, until the real feeds plug in.' : 'Made-up figures for the demo. Nothing here is live.';
---
<span class:list={['sim-t', stage ? 'is-stage' : 'is-sim']} title={tip} data-help={stage ? 'simtag:stage' : 'simtag:simulated'}>{text}</span>

<style is:global>
  .sim-t { display: inline-flex; align-items: center; height: 20px; padding: 0 8px; border-radius: var(--pill-radius); font: 700 10.5px/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; }
  .sim-t.is-sim { border: 1px dashed var(--amber-ink); color: var(--amber-ink); background: transparent; }
  .sim-t.is-stage { border: 1px solid transparent; background: var(--violet-soft); color: var(--violet-ink); }
</style>
