---
/* Arrive: the arrival motion for record blocks (src/lib/arrive.mjs). A page that has [data-arrive] blocks, .rs-tick
   figures or [data-draw] strips includes this once. It wires the page on every arrival, and gives pages that draw
   their markup in a script window.rsArrive(root) to call once the markup is in. */
import '../styles/arrive.css';
---
<script>
  import { arrive } from '../lib/arrive.mjs';
  (window as any).rsArrive = arrive;
  const run = () => arrive(document);
  run();
  document.addEventListener('astro:page-load', run);
</script>
