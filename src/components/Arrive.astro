---
/* Arrive: the arrival motion for record blocks (src/lib/arrive.mjs). A page with .rs-tick figures includes this once:
   it ticks them as they arrive. A page that draws its markup in a script calls window.rsArrive(root) once the markup
   is in, which also draws in that markup's strips (the site-wide watcher ran before they existed). */
import '../styles/arrive.css';
---
<script>
  import { arrive, arriveDrawn } from '../lib/arrive.mjs';
  (window as any).rsArrive = arriveDrawn;
  const run = () => arrive(document);
  run();
  document.addEventListener('astro:page-load', run);
</script>
