---
// A room's QR code, drawn at build time as inline SVG (src/lib/qr.mjs, no dependency). It opens the room
// guide at the site's public address, so a printed card works from any phone. Black on white in every
// look and in dark mode, because that is what phone cameras read best, with the quiet zone included.
import { qrPath } from '../lib/qr.mjs';
import { href } from '../lib/data.mjs';
interface Props { room: string; label: string; size?: number; class?: string }
const { room, label, size = 160, class: cls } = Astro.props;
const url = new URL(href(`/guide/${room}/`), Astro.site ?? 'https://kb35.github.io').href;
const q = qrPath(url);
---
<svg class:list={['room-qr', cls]} viewBox={`0 0 ${q.size} ${q.size}`} width={size} height={size} role="img" aria-label={`QR code for the room guide of ${label}: ${url}`} data-url={url} shape-rendering="crispEdges">
  <rect width={q.size} height={q.size} fill="#fff" />
  <path d={q.d} fill="#000" />
</svg>

<style>
  .room-qr { display: block; max-width: 100%; height: auto; border-radius: 6px; }
</style>
