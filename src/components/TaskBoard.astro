---
/* TaskBoard: a project's tasks as a board (only the columns that have work, each sized to its
   content) or a list; a closed project gets a summary of what was done by phase, with the captured
   fixes as lessons learned, instead of a board. Cards are compact: title, room, due, status and the
   owner's avatar. The avatar is a button that opens the people picker (PeoplePicker) anchored to it;
   the status word opens a small menu; cards can be dragged between columns. Every change is an
   event in the live layer (src/lib/live.mjs): who, when, undo, live between windows.
   "Add a task" (for work the playbook does not list) is kept in this browser (rs4-added-tasks);
   a suggestion for the playbook becomes a proposed change on the Changes page. */
import Icon from './Icon.astro';
import PeoplePicker from './PeoplePicker.astro';
import { spaces, playbooks, PHASE_LABEL, phasesOf, TASK_STATUS, DEMO_TODAY, PHASES, fmtDate, href, plural, className } from '../lib/data.mjs';
import { person, PEOPLE, PROJECT_ROLE, TASK_ADDERS } from '../lib/demo.mjs';
import { pickable, byPhase, lessons } from '../lib/project-status.mjs';
const { project: p } = Astro.props;
const home = `/projects/${p.id.toLowerCase()}/`;
const closed = p.phase === 'closed';
const COLS = ['todo', 'doing', 'blocked', 'done'];
const short = (d) => fmtDate(d, { day: 'numeric', month: 'short' });
const spaceName = (id) => (spaces[id]?.number ? `${spaces[id].number} ${spaces[id].name}` : spaces[id]?.name ?? id);
const tHref = (t) => href(`${home}tasks/${t.id.toLowerCase()}/`);
const people = pickable(p);
const open = p.tasks.filter((t) => t.status !== 'done').length;
const order = (t) => `${PHASES.indexOf(t.phase ?? 'closed')}-${t.status === 'done' ? 1 : 0}-${t.due ?? '9'}`;
const listed = [...p.tasks].sort((a, b) => order(a).localeCompare(order(b)));
const groups = closed ? byPhase(p) : [];
const LL = closed ? lessons(p) : [];
const pb = playbooks[p.playbook];
// "Add a task": rooms and devices come from this project's rooms; the people are the project team; a
// suggestion for the playbook goes to its owners (programme manager with the service manager).
const roomOpts = (p.spaces ?? []).map((s) => ({ id: s.space, label: spaceName(s.space), devices: (spaces[s.space]?.positions ?? []).filter((x) => x.model || x.hostname).map((x) => ({ id: `${s.space}/${x.position}`, label: `${spaces[s.space].name}: ${(x.role ?? className(x.cls)).replace(/:.*$/, '').replace(/^./, (c) => c.toLowerCase())}` })) }));
const teamOpts = (p.roles ?? []).map((r) => ({ id: r.person, label: `${person(r.person).name} (${PROJECT_ROLE[r.as]})` }));
const ownerRoles = ['infra-refresh', 'network-refresh'].includes(pb?.kind) ? ['programme', 'sm-infra'] : ['programme', 'sm-av'];
const approvers = ownerRoles.map((r) => PEOPLE.find((x) => x.roleId === r)).filter(Boolean);
const bump = (v) => String(v).replace(/(\d+)$/, (n) => String(+n + 1));
const dueDefault = new Date(new Date(DEMO_TODAY).getTime() + 7 * 864e5).toISOString().slice(0, 10);
const atCfg = { project: p.id, name: p.name, phase: p.phase, phaseLabel: PHASE_LABEL[p.phase], pb: pb?.id ?? '', pbName: pb?.name ?? '', ver: pb?.version ?? '', next: pb ? bump(pb.version) : '', approver: approvers.map((x) => `${x.name}, ${x.role}`).join(' with '), approverNames: approvers.map((x) => x.name).join(' and '), changes: href('/changes/'), owner: p.owner };
const adderCss = TASK_ADDERS.map((r) => `:root[data-role="${r}"] .at-open`).join(',') + ' { display: inline-flex !important; }';
---
<div class="tb" data-tb data-project={p.id} data-closed={closed ? '' : undefined} data-people={JSON.stringify(people)} data-today={DEMO_TODAY}>
  <div class="tb-bar">
    <div class="tb-views" role="group" aria-label="View" data-help="project.taskviews">
      <button type="button" class="tb-view" data-tv="board" aria-pressed="true">{closed ? 'Summary' : 'Board'}</button>
      <button type="button" class="tb-view" data-tv="list" aria-pressed="false">List</button>
    </div>
    <span class="faint tb-count" data-tb-count>{closed ? `${plural(p.tasks.length, 'task')}, all done` : `${open} open of ${p.tasks.length}`}</span>
    <button type="button" class="btn small at-open" data-at-open aria-expanded="false" aria-controls="at-form" data-help="project.addtask"><Icon name="plus" size={15} />Add a task</button>
  </div>
  <div class="at-wrap" data-at-wrap>
    <form class="card at-form" id="at-form" data-at-form novalidate data-cfg={JSON.stringify(atCfg)} inert>
      <div class="at-h"><h3>Add a task</h3><p class="faint">For work this project needs that the playbook does not list. It is added straight away, and you can undo it.</p></div>
      <label class="ef"><span class="ef-l">What needs doing?</span><input name="title" maxlength="120" placeholder="For example: Label both ends of every patch cable" autocomplete="off" required /></label>
      <label class="ef"><span class="ef-l">What is it about?</span>
        <select name="about">
          <option value="">Nothing in particular</option>
          <optgroup label="Rooms">{roomOpts.map((r) => <option value={`room:${r.id}`} data-label={r.label}>{r.label}</option>)}</optgroup>
          <optgroup label="Devices">{roomOpts.flatMap((r) => r.devices).map((d) => <option value={`device:${d.id}`} data-label={d.label}>{d.label}</option>)}</optgroup>
        </select>
      </label>
      <div class="ef-2">
        <label class="ef"><span class="ef-l">Who will do it?</span><select name="owner">{teamOpts.map((o) => <option value={o.id} data-label={person(o.id).name}>{o.label}</option>)}</select></label>
        <label class="ef"><span class="ef-l">Due</span><input type="date" name="due" value={dueDefault} /></label>
      </div>
      <fieldset class="at-modes">
        <legend class="ef-l">How should it count?</legend>
        <label class="at-mode"><input type="radio" name="mode" value="one-off" checked /><span><b>Just for this project</b><small>A one-off. It does not change the playbook.</small></span></label>
        <label class="at-mode"><input type="radio" name="mode" value="optional" /><span><b>Optional</b><small>Shows as optional. Anyone can skip it.</small></span></label>
        {pb && <label class="at-mode"><input type="radio" name="mode" value="suggest" /><span><b>Suggest adding it to the playbook</b><small>Also sends it to {atCfg.approverNames} to approve for every {pb.name} project.</small></span></label>}
      </fieldset>
      <p class="at-err" data-at-err role="alert" hidden>Say what needs doing first.</p>
      <div class="at-acts"><button type="submit" class="btn primary">Add task</button><button type="button" class="btn ghost" data-at-cancel>Cancel</button></div>
    </form>
  </div>
  <p class="at-note" data-at-note role="status" hidden></p>

  <div data-view-board>
    {closed ? (
      <div class="tb-sum">
        {LL.length > 0 && (
          <div class="card tb-less" data-help="project.lessons">
            <p class="tb-less-h"><Icon name="check" size={15} />Lessons learned<span class="faint">{plural(LL.length, 'captured fix')}{LL.filter((x) => x.inPlaybook).length ? `, ${LL.filter((x) => x.inPlaybook).length} now in the ${pb?.name ?? ''} playbook` : ''}</span></p>
            <ul class="tb-less-l">
              {LL.map((x) => <li><q>{x.fix}</q><small><a href={tHref(x.task)}>{x.task.id}</a> · {x.phase} · {x.owner.name}{x.inPlaybook ? <> · <a href={href(`/playbooks/${pb.id}/`)}>in the playbook since {short(x.inPlaybook.date)}</a></> : ''}</small></li>)}
            </ul>
          </div>
        )}
        <div class="g12 tb-phases">
          {groups.map((g) => (
            <section class="card side-card s-4 tb-ph" aria-label={g.label} data-help="project.phasedone">
              <h3>{g.label}<span class="num faint">{g.tasks.length ? plural(g.tasks.length, 'task') : ''}</span></h3>
              {g.history && <p class="tb-ph-w">{g.history.ended ? `Ended ${short(g.history.ended)}` : `Due ${short(g.history.planned)}`}{g.history.signed_off_by ? `, signed off by ${person(g.history.signed_off_by).name}` : ''}</p>}
              <ul class="tb-ph-l">
                {g.tasks.map((t) => <li><i class="tk-dot" data-s={t.status} aria-hidden="true"></i><span><a href={tHref(t)}>{t.title}</a><small>{[t.space ? spaceName(t.space) : null, person(t.owner).name].filter(Boolean).join(' · ')}</small>{t.captured_fix && <small class="tb-fix">Fix: {t.captured_fix}</small>}</span></li>)}
              </ul>
            </section>
          ))}
        </div>
      </div>
    ) : (
      <div class="board" data-board style={`--cols:${COLS.filter((st) => p.tasks.some((t) => t.status === st)).length || 1}`}>
        {COLS.map((st) => {
          const ts = p.tasks.filter((t) => t.status === st);
          return (
            <div class={`col col-${st}`} data-col={st} hidden={ts.length === 0} data-help="project.column" data-help-name={TASK_STATUS[st]}>
              <p class="col-h"><span>{TASK_STATUS[st]}</span><span class="num" data-count>{ts.length}</span></p>
              <div class="col-cards" data-cards>
                {ts.map((t) => (
                  <article class="tk" data-live-task={t.id} data-status={t.status} data-owner={t.owner} data-title={t.title} data-blocked={t.blocked_by} draggable="true" data-help="project.card">
                    <a class="tk-t" href={tHref(t)}>{t.title}</a>
                    <span class="tk-m">{t.space && <span class="tk-room"><Icon name="room" size={12} />{spaceName(t.space)}</span>}{t.due && <span class:list={['mono', { late: t.status !== 'done' && t.due < DEMO_TODAY }]}>{t.status === 'done' ? short(t.due) : `Due ${short(t.due)}`}</span>}</span>
                    <span class="tk-end">
                      <button type="button" class="tk-st" data-lt-status aria-haspopup="menu" aria-expanded="false" data-help="project.status" title={t.blocked_by}><i class="tk-dot" aria-hidden="true"></i><span data-st-word>{TASK_STATUS[t.status]}</span></button>
                      <button type="button" class="av tk-av" data-lt-owner aria-haspopup="dialog" aria-expanded="false" data-help="project.assign" aria-label={`Assigned to ${person(t.owner).name}. Change`} title={person(t.owner).name}>{person(t.owner).initials}</button>
                    </span>
                    <small class="tk-note" data-lt-note hidden></small>
                  </article>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    )}
  </div>

  <div class="list tb-list" data-view-list hidden>
    {listed.map((t) => (
      <div class="row plain tk-row" data-live-task={t.id} data-status={t.status} data-owner={t.owner} data-title={t.title} data-help="project.card">
        <span class="tk-rm">
          <span class="tk-rt"><i class="tk-dot" aria-hidden="true"></i><a class="name" href={tHref(t)}>{t.title}</a></span>
          <span class="sub">{[PHASE_LABEL[t.phase], t.space ? spaceName(t.space) : null].filter(Boolean).join(' · ')}</span>
        </span>
        <span class="end">
          {t.due && <span class:list={['mono faint tk-due', { late: t.status !== 'done' && t.due < DEMO_TODAY }]}>{t.status === 'done' ? short(t.due) : `Due ${short(t.due)}`}</span>}
          <button type="button" class="tk-st" data-lt-status aria-haspopup="menu" aria-expanded="false" data-help="project.status" title={t.blocked_by}><i class="tk-dot" aria-hidden="true"></i><span data-st-word>{TASK_STATUS[t.status]}</span></button>
          <button type="button" class="av tk-av" data-lt-owner aria-haspopup="dialog" aria-expanded="false" data-help="project.assign" aria-label={`Assigned to ${person(t.owner).name}. Change`} title={person(t.owner).name}>{person(t.owner).initials}</button>
        </span>
      </div>
    ))}
  </div>
  <details class="at-arch" data-at-arch hidden><summary>Archived tasks <span class="num" data-at-arch-n>0</span></summary><div data-at-arch-list></div></details>
  <div class="tk-menu" data-tk-menu hidden role="menu" aria-label="Status"></div>
</div>
<PeoplePicker />

<script is:inline data-astro-rerun>
  (function () {
    var tb = document.querySelector('[data-tb]'); if (!tb) return;
    var STATUS = { todo: 'To do', doing: 'Doing', blocked: 'Blocked', done: 'Done' }, ORDER = ['todo', 'doing', 'blocked', 'done'];
    var board = tb.querySelector('[data-board]'), menu = tb.querySelector('[data-tk-menu]');
    var people = JSON.parse(tb.dataset.people || '[]');
    var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
    var M = function () { return window.rsMotion ? window.rsMotion() : { reduced: true, pop: 0, exit: 0, enter: 0, morph: 0, ease: 'ease', stagger: 0 }; };
    var person = function (id) { return people.filter(function (x) { return x.id === id; })[0] || (window.RS_PEOPLE || []).filter(function (x) { return x.id === id; })[0] || { id: id, name: id, initials: String(id).slice(0, 2).toUpperCase() }; };
    var elsOf = function (id) { return Array.prototype.slice.call(tb.querySelectorAll('[data-live-task="' + id + '"]')); };
    var base = function (id) { var el = elsOf(id)[0]; return el ? { status: el.dataset.status, owner: el.dataset.owner } : {}; };
    var time = function (at) { return new Date(at).toLocaleTimeString('en-IE', { hour: '2-digit', minute: '2-digit' }); };
    var hold = function (fn) { if (window.rsHold) window.rsHold(tb, fn); else fn(); };

    /* Columns: only the ones with work show; each says how many. While a card is being dragged every
       column shows, so an empty one can take it. The band's Open tasks figure follows. */
    var syncCols = function () {
      if (!board) return;
      board.querySelectorAll('[data-col]').forEach(function (c) {
        var n = c.querySelectorAll('.tk:not(.leaving)').length;
        c.querySelector('[data-count]').textContent = n;
        c.hidden = n === 0 && !board.classList.contains('dragging');
      });
      board.style.setProperty('--cols', String(board.querySelectorAll('[data-col]:not([hidden])').length || 1));
      var all = board.querySelectorAll('.tk:not(.leaving)').length, open = all - board.querySelectorAll('[data-col="done"] .tk:not(.leaving)').length;
      var c = tb.querySelector('[data-tb-count]'); if (c) c.textContent = open + ' open of ' + all;
      var blocked = board.querySelectorAll('[data-col="blocked"] .tk:not(.leaving)').length;
      if (window.rsKeyNumber) window.rsKeyNumber('open', open, { label: blocked ? 'Open tasks, ' + blocked + ' blocked' : 'Open tasks', tone: blocked ? 'bad' : '' });
    };
    /* FLIP: remember where every card is, change the DOM, then slide each moved card from its old place. */
    var flip = function (change) {
      var m = M();
      if (m.reduced || !board) { hold(function () { change(); syncCols(); }); return; }
      var before = new Map();
      board.querySelectorAll('.tk').forEach(function (c) { before.set(c, c.getBoundingClientRect()); });
      var shown = new Set(); board.querySelectorAll('[data-col]:not([hidden])').forEach(function (c) { shown.add(c); });
      hold(function () { change(); syncCols(); });
      board.querySelectorAll('[data-col]:not([hidden])').forEach(function (c) { if (!shown.has(c)) c.animate([{ opacity: 0, transform: 'scale(.96)' }, { opacity: 1, transform: 'none' }], { duration: m.enter, easing: m.ease }); });
      board.querySelectorAll('.tk').forEach(function (c) {
        var a = before.get(c), b = c.getBoundingClientRect(); if (!a) { c.animate([{ opacity: 0, transform: 'scale(.6)' }, { opacity: 1, transform: 'none' }], { duration: m.enter, easing: m.ease }); return; }
        var dx = a.left - b.left, dy = a.top - b.top, sx = a.width / b.width;
        if (Math.abs(dx) + Math.abs(dy) < 1 && Math.abs(sx - 1) < 0.01) return;
        c.style.transformOrigin = '0 0';
        c.animate([{ transform: 'translate(' + dx + 'px,' + dy + 'px) scale(' + sx + ',1)' }, { transform: 'none' }], { duration: m.morph, easing: m.ease });
      });
    };
    var placeCard = function (card, st) {
      var col = board && board.querySelector('[data-col="' + st + '"] [data-cards]');
      if (col && card.parentElement !== col) col.insertBefore(card, col.querySelector('.tk.added'));
    };

    var describe = function (e) {
      var what = e.field === 'status' ? (e.after === 'done' ? 'Ticked done' : e.before === 'done' ? 'Reopened, back to ' + STATUS[e.after] : 'Moved to ' + STATUS[e.after])
        : e.field === 'owner' ? 'Assigned to ' + person(e.after).name : e.field + ' changed';
      return e.undoes ? e.note + ': ' + what.charAt(0).toLowerCase() + what.slice(1) : what;
    };
    var paint = function (L, id, fresh, remote) {
      var item = 'task:' + id, st = L.live.stateOf(item, base(id)), els = elsOf(id);
      var last = L.live.historyOf(item)[0];
      var apply = function () {
        els.forEach(function (el) {
          el.setAttribute('data-status', st.status);
          var w = el.querySelector('[data-st-word]'); if (w) w.textContent = STATUS[st.status];
          var av = el.querySelector('[data-lt-owner]'); if (av) { av.textContent = person(st.owner).initials; av.title = person(st.owner).name; av.setAttribute('aria-label', 'Assigned to ' + person(st.owner).name + '. Change'); }
          var note = el.querySelector('[data-lt-note]'); if (note) { note.hidden = !last; if (last) note.textContent = describe(last) + ': ' + person(last.who).name + ', ' + time(last.at); }
        });
      };
      var card = els.filter(function (el) { return el.classList.contains('tk'); })[0];
      var moves = card && board && card.closest('[data-col]') && card.closest('[data-col]').dataset.col !== st.status;
      if (moves && fresh) flip(function () { apply(); placeCard(card, st.status); });
      else { apply(); if (moves) { placeCard(card, st.status); syncCols(); } }
      if (fresh && remote && window.rsMarkChanged) els.forEach(function (el) { window.rsMarkChanged(el, last ? person(last.who).name : ''); });
      else if (fresh) els.forEach(function (el) { el.classList.remove('lt-flash'); void el.offsetWidth; el.classList.add('lt-flash'); });
    };

    /* The status menu grows from the status word; a pick records the change. */
    var menuFor = null, closing = null;
    var closeMenu = function (back) {
      if (menu.hidden) return; var m = M(), b = menuFor; menuFor = null;
      if (b) b.setAttribute('aria-expanded', 'false');
      var done = function () { menu.hidden = true; closing = null; if (back && b) b.focus({ preventScroll: true }); };
      if (m.reduced) done(); else { closing = menu.animate([{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'scale(.7)' }], { duration: m.exit, easing: m.ease, fill: 'forwards' }); closing.onfinish = done; }
    };
    var openMenu = function (btn, current, opts) {
      if (closing) { closing.cancel(); closing = null; }
      if (menuFor === btn) { closeMenu(true); return; }
      menuFor = btn; btn.setAttribute('aria-expanded', 'true');
      menu.innerHTML = ORDER.map(function (s) { return '<button type="button" role="menuitemradio" aria-checked="' + (s === current) + '" data-tk-set="' + s + '"><i class="tk-dot" data-s="' + s + '"></i>' + STATUS[s] + '</button>'; }).join('') + (opts && opts.extra ? opts.extra : '');
      menu.hidden = false;
      var r = btn.getBoundingClientRect(), h = menu.offsetHeight, below = innerHeight - r.bottom > h + 10;
      var left = Math.max(8, Math.min(r.left, innerWidth - menu.offsetWidth - 8));
      menu.style.left = left + 'px'; menu.style.top = (below ? r.bottom + 4 : r.top - h - 4) + 'px';
      menu.style.transformOrigin = (r.left - left + 12) + 'px ' + (below ? '0' : '100%');
      var m = M(); if (!m.reduced) menu.animate([{ opacity: 0, transform: 'scale(.6)' }, { opacity: 1, transform: 'none' }], { duration: m.pop, easing: m.ease });
      setTimeout(function () { var c = menu.querySelector('[aria-checked=true]') || menu.querySelector('button'); if (c) c.focus({ preventScroll: true }); }, 0);
    };

    var stop = null, L = null;
    var go = function () {
      L = window.rsLive; if (!L || !document.body.contains(tb)) return;
      L.register('task:', { base: function (item) { return base(item.replace(/^task:/, '')); }, describe: describe });
      var ids = {}; tb.querySelectorAll('[data-live-task]').forEach(function (el) { ids[el.dataset.liveTask] = 1; });
      Object.keys(ids).forEach(function (id) { paint(L, id, false); });
      syncCols();
      if (stop) stop();
      stop = L.live.subscribe('task:', function (e, info) { var id = e.item.replace(/^task:/, ''); if (elsOf(id).length) paint(L, id, true, info && info.remote); });
      document.addEventListener('astro:before-swap', function () { if (stop) stop(); stop = null; }, { once: true });
    };
    var record = function (id, field, after) {
      if (!L) return; var item = 'task:' + id, now = L.live.stateOf(item, base(id));
      if (now[field] === after) return;
      L.live.record({ item: item, field: field, before: now[field], after: after, who: L.who() });
    };
    var handle = {
      paint: paint, syncCols: syncCols, flip: flip, record: record, openMenu: openMenu, closeMenu: closeMenu, menu: menu, tb: tb, board: board, people: people, person: person, esc: esc, M: M, hold: hold,
      state: function (id) { return L ? L.live.stateOf('task:' + id, base(id)) : base(id); }, live: function () { return L; },
    };
    window.__rsTb = handle;
    if (window.rsLive) go(); else document.addEventListener('rs:live-ready', go, { once: true });

    /* The view switch: Board (or Summary) | List, remembered. */
    var VKEY = 'rs5-project-tasks-view';
    var setView = function (v, animate) {
      var swap = function () {
        tb.querySelectorAll('[data-tv]').forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.tv === v)); });
        tb.querySelector('[data-view-board]').hidden = v !== 'board'; tb.querySelector('[data-view-list]').hidden = v !== 'list';
      };
      if (animate && window.rsMorphPanels) { var cur = tb.querySelector('[data-view-board]:not([hidden]), [data-view-list]:not([hidden])'), next = tb.querySelector(v === 'board' ? '[data-view-board]' : '[data-view-list]'); if (cur !== next) window.rsMorphPanels(cur, next, swap); else swap(); } else swap();
      try { localStorage.setItem(VKEY, v); } catch (_) {}
    };
    var v0 = 'board'; try { v0 = localStorage.getItem(VKEY) || 'board'; } catch (_) {}
    if (v0 === 'list') setView('list', false);

    if (!window.__rsTbHook) {
      window.__rsTbHook = true;
      document.addEventListener('click', function (e) {
        var H = window.__rsTb; if (!H || !document.body.contains(H.tb)) return;
        var t = e.target;
        var tv = t.closest('[data-tv]'); if (tv && H.tb.contains(tv)) { setView(tv.dataset.tv, true); return; }
        var set = t.closest('[data-tk-set]');
        if (set && H.menu.contains(set)) { var id = menuFor && menuFor.closest('[data-live-task]') ? menuFor.closest('[data-live-task]').dataset.liveTask : null; var added = menuFor && menuFor.closest('[data-added-id]'); closeMenu(true); if (added && window.__rsAt) window.__rsAt.setStatus(added.dataset.addedId, set.dataset.tkSet); else if (id) H.record(id, 'status', set.dataset.tkSet); return; }
