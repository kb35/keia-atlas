---
// View as: who this window shows Keia Atlas as (a demo; nobody signs in for real). Roles first, not people: a grid
// of role tiles grouped by team. A role with one person switches at once; a role with several opens in place to
// show them. At the top: who you are viewing as, up to three recent picks, Back to you, and a find field.
// Opened from the name in the sidebar, the View as ribbon, Settings (on a phone too) and the palette (⌘K, then
// "> Liam"): window.rsViewAs.open(from).
// Storage is the Shell's: the person per window (sessionStorage rs5-who), the next window's start (localStorage
// rs4-who) and "you" (rs5-me). Recent picks are kept in this browser (localStorage rs6-who-recent).
// Motion (docs/rules/motion.md, M11, M12, M13 row 39): it grows from the control that opened it and shrinks back to
// it; a role opens in place (its tile grows into its row, the others slide on the zero-bounce spring, its people
// arrive a beat later); the find field dims what does not match and moves nothing; the switch itself is
// rsPickWho (rsChange: Home changes in place). Reduced motion: every step happens at once.
import Icon from './Icon.astro';
import { href } from '../lib/data.mjs';
import { PEOPLE, ROLES, TEAMS } from '../lib/demo.mjs';

// Roles by team. Each row of Delivery reads across: the people who do the work, then the people who lead them.
const GROUPS = [
  { id: 'delivery', name: 'Delivery', span: 4, roles: ['delivery', 'pm', 'tech', 'programme', 'eng-manager', 'pm-manager', 'tech-manager', 'delivery-manager'] },
  { id: 'service', name: 'Support and service', span: 4, roles: ['desk', 'network', 'sm-av', 'sm-infra'] },
  { id: 'lab', name: 'The Lab', span: 1, roles: ['innovation'] },
  { id: 'lead', name: 'Leadership', span: 1, roles: ['head'] },
  { id: 'partners', name: 'Partners', span: 2, roles: ['vendor', 'service-vendor'] },
];
// A short name for the tile (the full name shows at the top once chosen) and one line on what that view is for.
const TILE = {
  delivery: ['Delivery engineer', 'Designs and commissions spaces'],
  pm: ['Project manager', 'Runs projects day to day'],
  tech: ['On-site technician', 'Installs and fixes on site'],
  programme: ['Programme manager', 'Plans the year of projects'],
  'eng-manager': ['Engineering manager', 'Leads the delivery engineers'],
  'pm-manager': ['Project management lead', 'Leads the project managers'],
  'tech-manager': ['On-site services manager', 'Leads the on-site technicians'],
  'delivery-manager': ['Delivery manager', 'The whole delivery team'],
  desk: ['Service desk analyst', 'Takes incidents as they arrive'],
  network: ['Network engineer', 'Ports, VLANs and patching'],
  'sm-av': ['Service manager, AV', 'Owns the AV standard'],
  'sm-infra': ['Service manager, network', 'Owns the network standard'],
  innovation: ['Innovation engineer', 'Tests new kit before it ships'],
  head: ['Head of AV and IT', 'The whole service, every region'],
  vendor: ['Integration vendor', 'Their own installations only'],
  'service-vendor': ['Service vendor', 'Repairs under the contract'],
};
const FACES = 4;
const EVERYONE = { id: 'everyone', name: 'Everyone (overview)', role: 'Every role at once', short: 'Everyone', where: 'Every role at once', initials: 'All' };
const lc = (s) => String(s ?? '').toLowerCase();
const groups = GROUPS.map((g) => ({
  ...g,
  tiles: g.roles.map((r) => {
    const ps = PEOPLE.filter((p) => p.roleId === r);
    return { r, short: TILE[r][0], blurb: TILE[r][1], ps, text: lc(`${TILE[r][0]} ${TILE[r][1]} ${ROLES[r].name} ${g.name} ${TEAMS[ROLES[r].team]}`) };
  }),
}));
// What the script needs about each person: the top card, recent picks and the palette's rows.
const VP_PEOPLE = [EVERYONE, ...PEOPLE.map((p) => ({ id: p.id, name: p.name, role: p.role, short: TILE[p.roleId][0], where: p.where, initials: p.initials }))];
---
<dialog class="vp" id="view-as" data-vp aria-labelledby="vp-title" data-help="shell.viewas" tabindex="-1">
  <div class="vp-in">
    <header class="vp-top">
      <p class="vp-h" id="vp-title">View as <span>· demo</span></p>
      <button type="button" class="icon-btn vp-x" data-vp-close aria-label="Close">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </header>

    <div class="vp-now">
      <div class="vp-me" data-help="shell.viewas-current">
        <span class="avatar vp-av-l" aria-hidden="true" data-vp-me-av>AB</span>
        <span class="vp-me-t">
          <small>You're viewing as</small>
          <b data-vp-me-name>Anna Byrne</b>
          <span class="vp-me-r" data-vp-me-role>AV and IT delivery engineer · EMEA</span>
        </span>
        <button type="button" class="vp-back" data-vp-nav data-vp-back data-help="shell.back-to-you" hidden>Back to you</button>
      </div>
      <div class="vp-recent" data-help="shell.viewas-recent">
        <p class="vp-lab" data-vp-recent-lab>Recent</p>
        <div class="vp-rc" data-vp-recent></div>
      </div>
    </div>

    <div class="vp-find">
      <label class="vp-q" data-help="shell.viewas-find"><Icon name="search" size={15} /><input type="search" placeholder="Type a name, role or place" data-vp-q aria-label="Find a person or role" autocomplete="off" spellcheck="false" /></label>
      <p class="vp-hint" data-vp-hint aria-live="polite"></p>
    </div>

    <div class="vp-grid" data-vp-grid>
      {groups.map((g) => (
        <section class={`vp-grp s${g.span}`} data-vp-grp aria-labelledby={`vp-g-${g.id}`}>
          <h3 class="vp-g" id={`vp-g-${g.id}`}>{g.name}</h3>
          {g.tiles.map((t) => (
            <div class="vp-tile" data-vp-tile={t.r} data-text={t.text} data-n={t.ps.length}>
              <span class="vp-bg" aria-hidden="true"></span>
              {t.ps.length === 1 ? (
                <button type="button" class="vp-head" data-vp-nav data-pick-who={t.ps[0].id} data-help="shell.viewas-person" data-text={lc(`${t.ps[0].name} ${t.ps[0].where} ${t.ps[0].scope ?? ''}`)} aria-label={`${t.ps[0].name}, ${t.ps[0].role}, ${t.ps[0].where}`}>
                  <b class="vp-name">{t.short}</b>
                  <span class="vp-blurb">{t.blurb}</span>
                  <span class="vp-foot"><span class="vp-faces" aria-hidden="true"><span class="avatar" data-who={t.ps[0].id}>{t.ps[0].initials}</span></span><span class="vp-count">{t.ps[0].name}</span></span>
                </button>
              ) : (
                <>
                  <button type="button" class="vp-head" data-vp-nav data-vp-open aria-expanded="false" aria-controls={`vp-p-${t.r}`} data-help="shell.viewas-role">
                    <b class="vp-name">{t.short}</b>
                    <span class="vp-blurb">{t.blurb}</span>
                    <span class="vp-foot">
                      <span class="vp-faces" aria-hidden="true">
                        {t.ps.slice(0, t.ps.length > FACES ? FACES - 1 : FACES).map((p) => <span class="avatar" data-who={p.id}>{p.initials}</span>)}
                        {t.ps.length > FACES && <span class="avatar vp-more">+{t.ps.length - FACES + 1}</span>}
                      </span>
                      <span class="vp-count" data-vp-count={`${t.ps.length} people`}>{t.ps.length} people</span>
                    </span>
                  </button>
                </>
              )}
            </div>
          ))}
          {g.tiles.filter((t) => t.ps.length > 1).map((t) => (
            <div class="vp-people" id={`vp-p-${t.r}`} data-for={t.r} role="group" aria-label={t.short} hidden>
              {t.ps.map((p) => (
                <button type="button" class="vp-person" data-vp-nav data-pick-who={p.id} data-help="shell.viewas-person" data-text={lc(`${p.name} ${p.where} ${p.scope ?? ''}`)}>
                  <span class="avatar" aria-hidden="true">{p.initials}</span>
                  <span class="vp-pt"><b>{p.name}</b><small>{p.where}</small></span>
                </button>
              ))}
            </div>
          ))}
        </section>
      ))}
    </div>

    <footer class="vp-end">
      <div class="vp-tile vp-all" data-vp-tile="everyone" data-text="everyone overview all roles every role at once" data-n="1">
        <button type="button" class="vp-head" data-vp-nav data-pick-who="everyone" data-help="shell.viewas-everyone" data-text="everyone overview all">
          <span class="avatar" aria-hidden="true">All</span>
          <span class="vp-pt"><b>Everyone (overview)</b><small>Every role's first screen at once</small></span>
        </button>
      </div>
      <nav class="vp-links" aria-label="More">
        <button type="button" data-open-settings data-vp-link><Icon name="gear" size={15} />Settings</button>
        <a href={href('/welcome/')} data-vp-link><Icon name="globe" size={15} />Welcome page</a>
        <a href={href('/about/')} data-vp-link><Icon name="about" size={15} />About</a>
        <a href={href('/about/#decisions')} data-vp-link><Icon name="decisions" size={15} />Decisions</a>
      </nav>
    </footer>
  </div>
</dialog>

<script is:inline data-astro-rerun define:vars={{ VP_PEOPLE }}>
  (function () {
    var W = window, D = document;
    var dlg = D.querySelector('dialog[data-vp]');
    if (!dlg || dlg.__vp) return;
    dlg.__vp = true;
    var KEY = 'rs6-who-recent', STARTERS = ['liam', 'priya', 'claire', 'sofia'];
    var byId = {}; VP_PEOPLE.forEach(function (p) { byId[p.id] = p; });
    var q = dlg.querySelector('[data-vp-q]'), hint = dlg.querySelector('[data-vp-hint]'), grid = dlg.querySelector('[data-vp-grid]');
    var tiles = Array.prototype.slice.call(dlg.querySelectorAll('[data-vp-tile]'));
    var opener = null, openTile = null, hits = [];
    var fine = matchMedia('(hover: hover) and (pointer: fine)');
    var reduced = function () { return W.km ? W.km.reduced() : !W.rsMotion || W.rsMotion().reduced; };
    var M = function () { return W.rsMotion ? W.rsMotion() : { springSettle: 360, spring: 'ease-out', enter: 440, exit: 240, stagger: 24, state: 300, ease: 'ease-out', exitEase: 'ease-in' }; };
    var esc = function (s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
    var cur = function () { return W.rsWhoId ? W.rsWhoId() : 'anna'; };
    var me = function () { return W.rsMeId ? W.rsMeId() : cur(); };
    var first = function (n) { return n === 'Everyone (overview)' ? 'Everyone' : n.split(' ')[0]; };

    /* Recent picks: the people this browser has viewed as, newest first. */
    var recent = function () { var l = []; try { l = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (_) { l = W.__vpRecent || []; } return Array.isArray(l) ? l.filter(function (id) { return byId[id]; }) : []; };
    W.__vpPush = W.__vpPush || function (id) {
      if (!id) return;
      var l = [id].concat(recent().filter(function (x) { return x !== id; })).slice(0, 6);
      W.__vpRecent = l; try { localStorage.setItem(KEY, JSON.stringify(l)); } catch (_) {}
    };
    if (!W.__vpHook) {   // once per visit: whoever you leave goes to the front of Recent, however you switched
      W.__vpHook = true; W.__vpLast = cur();
      D.addEventListener('rs:demo-change', function (e) {
        if (!e.detail || e.detail.what !== 'who') return;
        var now = cur(), was = W.__vpLast; W.__vpLast = now;
        if (was && was !== now) W.__vpPush(was);
      });
    }

    /* The top: who you are viewing as, Back to you, and up to three people to switch to in one press. */
    function render() {
      var id = cur(), p = byId[id] || VP_PEOPLE[1];
      dlg.querySelector('[data-vp-me-av]').textContent = p.initials;
      dlg.querySelector('[data-vp-me-name]').textContent = p.name;
      dlg.querySelector('[data-vp-me-role]').textContent = id === 'everyone' ? 'Every role\'s first screen at once' : p.role + ' · ' + p.where;
      var back = dlg.querySelector('[data-vp-back]'), mine = byId[me()];
      back.hidden = !mine || me() === id;
      if (mine) { back.title = 'Back to ' + mine.name + ', ' + mine.role; back.setAttribute('aria-label', 'Back to you: ' + mine.name); }
      var rec = recent().filter(function (x) { return x !== id; }), lab = dlg.querySelector('[data-vp-recent-lab]');
      var list = rec.length ? rec : STARTERS.filter(function (x) { return x !== id; });
      lab.textContent = rec.length ? 'Recent' : 'Start with';
      dlg.querySelector('[data-vp-recent]').innerHTML = list.slice(0, 3).map(function (x) {
        var r = byId[x];
        return '<button type="button" class="vp-chip" data-vp-nav data-pick-who="' + esc(x) + '" data-help="shell.viewas-person" title="' + esc(r.name + ', ' + r.role + ', ' + r.where) + '">' +
          '<span class="avatar" aria-hidden="true">' + esc(r.initials) + '</span><span class="vp-pt"><b>' + esc(first(r.name)) + '<span class="vp-ln">' + esc(r.name.slice(first(r.name).length)) + '</span></b><small>' + esc(r.short) + '</small></span></button>';
      }).join('');
      dlg.querySelectorAll('[data-pick-who]').forEach(function (b) { if (b.dataset.pickWho === id) b.setAttribute('aria-current', 'true'); else b.removeAttribute('aria-current'); });
      tiles.forEach(function (t) { var pn = panelOf(t); t.classList.toggle('vp-cur', !!(pn || t).querySelector('[data-pick-who="' + id + '"]')); });
      dlg.querySelectorAll('.vp-faces [data-who]').forEach(function (a) { a.classList.toggle('on', a.dataset.who === id); });
    }

    /* Find: dims what does not match (nothing moves), and says what Enter will do. */
    var norm = function (s) { return String(s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim(); };
    var panelOf = function (t) { return dlg.querySelector('.vp-people[data-for="' + t.dataset.vpTile + '"]'); };
    function filter() {
      var toks = norm(q.value).split(/\s+/).filter(Boolean), shown = [];
      hits = [];
      tiles.forEach(function (t) {
        var tt = norm(t.dataset.text), pan = panelOf(t), any = false, some = [];
        var picks = Array.prototype.slice.call((pan || t).querySelectorAll('[data-pick-who]'));
        var roleHit = toks.length && toks.every(function (k) { return tt.indexOf(k) >= 0; });
        picks.forEach(function (b) {
          var pt = norm(b.dataset.text), ok = !toks.length || toks.every(function (k) { return (tt + ' ' + pt).indexOf(k) >= 0; });
          b.classList.toggle('vp-dim', !ok && !!toks.length);
          if (ok) { any = true; if (toks.length && !roleHit && some.indexOf(b.dataset.pickWho) < 0) some.push(b.dataset.pickWho); }
        });
        t.classList.toggle('vp-off', !any);
        if (any) shown.push(t);
        some.forEach(function (id) { if (hits.indexOf(id) < 0) hits.push(id); });
        // A role with several people names the one you typed, in place of the count.
        var c = t.querySelector('[data-vp-count]');
        if (c) c.textContent = some.length === 1 ? byId[some[0]].name : some.length > 1 ? some.length + ' of ' + t.dataset.n + ' match' : c.dataset.vpCount;
      });
      dlg.querySelectorAll('[data-vp-grp]').forEach(function (g) { g.classList.toggle('vp-off', !g.querySelector('.vp-tile:not(.vp-off)')); });
      var t = q.value.trim();
      if (!t) hint.textContent = fine.matches ? 'Arrow keys to move, Enter to choose' : '';
      else if (!shown.length) hint.textContent = 'No one matches "' + t + '". Try a first name, a role or an office.';
      else if (hits.length === 1 || (shown.length === 1 && shown[0].dataset.n === '1')) {
        var id = hits.length === 1 ? hits[0] : shown[0].querySelector('[data-pick-who]').dataset.pickWho;
        hint.textContent = 'Enter to view as ' + byId[id].name;
      } else hint.textContent = shown.length + (shown.length === 1 ? ' role matches' : ' roles match');
      if (openTile && openTile.classList.contains('vp-off')) toggle(openTile, false);
      return shown;
    }

    /* A role opens in place: its people open in a panel right under its row, growing out of the tile (from the
       tile's own width to the row's) while the rows below slide down on the zero-bounce spring, and the people
       arrive a beat later. The tiles never change order. Everything is measured where it is right now (even
       mid-move), so a second press carries on from there. */
    // The panel goes after the last tile in the chosen tile's row, so the grid puts it on the next row.
    function seat(tile, pan) {
      var sec = tile.parentElement, top = tile.offsetTop, last = tile;
      Array.prototype.forEach.call(sec.querySelectorAll(':scope > .vp-tile'), function (x) { if (Math.abs(x.offsetTop - top) < 2) last = x; });
      if (last.nextElementSibling !== pan) sec.insertBefore(pan, last.nextElementSibling);
      var pr = pan.getBoundingClientRect(), tr = tile.getBoundingClientRect();
      pan.style.setProperty('--nx', Math.round(tr.left + tr.width / 2 - pr.left) + 'px');
    }
    var parts = function () { return Array.prototype.slice.call(grid.querySelectorAll('.vp-tile, .vp-g')).concat([dlg.querySelector('.vp-end')]); };
    // A clip for a panel whose box is p, showing only the columns of r and the top h pixels.
    var inside = function (p, r, h) { return 'inset(-8px ' + Math.max(0, p.right - r.right) + 'px ' + Math.max(0, p.height - h) + 'px ' + Math.max(0, r.left - p.left) + 'px round var(--radius-lg))'; };
    function relayout(change, opened, closed) {
      var m = M();
      if (reduced() || !dlg.open) { change(); return; }
      var els = parts(), before = new Map(), h0 = dlg.getBoundingClientRect().height;
      els.forEach(function (el) { before.set(el, el.getBoundingClientRect()); });
      var ghost = null, gr = null, oldPan = closed && panelOf(closed);
      if (oldPan && !oldPan.hidden) {   // the people of the role that closes fold back into its tile
        gr = oldPan.getBoundingClientRect(); ghost = oldPan.cloneNode(true);
        ghost.removeAttribute('id'); ghost.removeAttribute('data-for'); ghost.setAttribute('aria-hidden', 'true'); ghost.inert = true; ghost.classList.add('vp-ghost');
        ghost.querySelectorAll('[data-pick-who]').forEach(function (b) { b.removeAttribute('data-pick-who'); b.removeAttribute('data-vp-nav'); });
      }
      dlg.getAnimations({ subtree: true }).forEach(function (a) { if (a.id === 'vp') a.cancel(); });
      dlg.querySelectorAll('.vp-ghost').forEach(function (g) { g.remove(); });
      change();
      var h1 = dlg.getBoundingClientRect().height, dur = m.springSettle || 360, ease = m.spring || m.ease;
      var go = function (el, k, o) { var a = el.animate(k, Object.assign({ duration: dur, easing: ease }, o || {})); a.id = 'vp'; return a; };
      els.forEach(function (el) {
        var a = before.get(el), b = el.getBoundingClientRect(), dx = a.left - b.left, dy = a.top - b.top;
        if (Math.abs(dx) >= 0.5 || Math.abs(dy) >= 0.5) go(el, [{ transform: 'translate(' + dx + 'px,' + dy + 'px)' }, { transform: 'none' }]);
      });
      var pan = opened && panelOf(opened);
      if (pan) {
        var pr = pan.getBoundingClientRect(), tr = opened.getBoundingClientRect();
        go(pan, [{ clipPath: inside(pr, tr, 0) }, { clipPath: inside(pr, pr, pr.height) }]);
        Array.prototype.forEach.call(pan.querySelectorAll('.vp-person'), function (c, i) {
          go(c, [{ opacity: 0, transform: 'scale(.96)' }, { opacity: getComputedStyle(c).opacity, transform: 'none' }], { duration: m.enter, delay: (m.stagger || 24) * (1 + Math.min(i, 12)), easing: m.ease, fill: 'backwards' });
        });
      }
      if (ghost) {
        var sec = closed.parentElement, sr = sec.getBoundingClientRect(), ct = closed.getBoundingClientRect();
        ghost.style.left = (gr.left - sr.left) + 'px'; ghost.style.top = (gr.top - sr.top) + 'px'; ghost.style.width = gr.width + 'px'; ghost.style.height = gr.height + 'px';
        sec.appendChild(ghost);
        go(ghost, [{ clipPath: inside(gr, gr, gr.height), opacity: 1 }, { clipPath: inside(gr, ct, 0), opacity: 0 }], { duration: m.exit, easing: m.exitEase || m.ease, fill: 'forwards' })
          .finished.then(function () { ghost.remove(); }, function () { ghost.remove(); });
      }
      if (Math.abs(h1 - h0) > 1) go(dlg, [{ height: h0 + 'px', overflow: 'hidden' }, { height: h1 + 'px', overflow: 'hidden' }]);
    }
    function shut(t) {
      t.classList.remove('open'); t.querySelector('[data-vp-open]').setAttribute('aria-expanded', 'false');
      var p = panelOf(t); if (p) p.hidden = true;
      if (openTile === t) openTile = null;
    }
    function toggle(tile, on) {
      var head = tile.querySelector('[data-vp-open]'), pan = panelOf(tile);
      if (!head || !pan) return;
      var was = openTile;
      if (on && was === tile) return;
      if (!on && was !== tile) return;
      relayout(function () {
        if (was) shut(was);
        if (on) { tile.classList.add('open'); head.setAttribute('aria-expanded', 'true'); pan.hidden = false; seat(tile, pan); openTile = tile; }
      }, on ? tile : null, was);
    }

    /* Choosing someone: this closes, then the page changes to them in one move (rsPickWho). */
    function pick(id) {
      if (id === cur()) { close(); return; }
      var m = M();
      close();
      if (reduced()) W.rsPickWho(id); else setTimeout(function () { W.rsPickWho(id); }, m.exit);
    }

    /* Open beside nothing: centred, a little above the middle, top edge fixed so a role opening grows downwards. */
    function place() {
      if (matchMedia('(max-width: 640px)').matches) { dlg.style.left = dlg.style.top = ''; return; }
      var vw = D.documentElement.clientWidth, vh = innerHeight, w = dlg.offsetWidth, h = dlg.offsetHeight;
      dlg.style.left = Math.round(Math.max(16, (vw - w) / 2)) + 'px';
      // room below for the tallest role to open (the technicians: two rows of people) without scrolling
      dlg.style.top = Math.round(Math.max(16, Math.min((vh - h) / 2 - 40, vh - h - 16 - 124))) + 'px';
    }
    function open(from) {
      opener = from || null;
      if (dlg.open && !dlg.classList.contains('closing')) return;
      dlg.getAnimations({ subtree: true }).forEach(function (a) { a.cancel(); });
      dlg.classList.remove('closing');
      if (openTile) shut(openTile);
      q.value = ''; render(); filter();
      if (!dlg.open) dlg.showModal();
      place();
      D.querySelectorAll('[data-acct-menu]').forEach(function (b) { b.setAttribute('aria-expanded', 'true'); });
      if (W.rsPopIn) W.rsPopIn(dlg, opener);
      if (fine.matches) q.focus({ preventScroll: true }); else dlg.focus({ preventScroll: true });
    }
    function close() {
      if (!dlg.open || dlg.classList.contains('closing')) return;
      dlg.classList.add('closing');
      D.querySelectorAll('[data-acct-menu]').forEach(function (b) { b.setAttribute('aria-expanded', 'false'); });
      var done = function () {
        dlg.classList.remove('closing'); dlg.close();
        if (opener && opener.focus && opener.isConnected && opener.getClientRects().length) opener.focus({ preventScroll: true });
      };
      if (W.rsPopOut) W.rsPopOut(dlg, opener && opener.isConnected ? opener : null, done); else done();
    }

    /* Keys: arrows move to the nearest tile, person or chip that way; Enter chooses; Escape closes a role, then this. */
