---
// View as: who this window shows Keia Atlas as (a demo; nobody signs in for real). A sheet (Keith, 30 Sept 2026:
// "keep things simple to understand"): who you are viewing as now, a find field, three suggested people, then every
// role as a plain list grouped by team, each with one whole line on what that view is for and its people as named
// chips. Nothing is cut short and nothing overlaps, at any text size. A phone gets it full screen.
// Opened from the name in the sidebar, the View as ribbon, Change in the quick menu and on the Settings page, and
// the palette (⌘K, then "> Liam"): window.rsViewAs.open(from).
// Storage is the Shell's: the person per window (sessionStorage rs5-who), the next window's start (localStorage
// rs4-who) and "you" (rs5-me). Recent picks are kept in this browser (localStorage rs6-who-recent).
// Motion (docs/rules/motion.md, M11, M12, row 40): the sheet grows from the control that opened it; its rows settle
// in, a stagger apart; finding hides what does not match at once (nothing slides); choosing someone folds the sheet
// into your name in the sidebar (or the gear on a phone), then Home changes in place (rsPickWho, rsChange).
// Reduced motion: every step happens at once.
import Icon from './Icon.astro';
import { PEOPLE, ROLES, TEAMS } from '../lib/demo.mjs';

// Roles by team, in the order people look for them.
const GROUPS = [
  { id: 'delivery', name: 'Delivery', roles: ['delivery', 'pm', 'tech', 'programme', 'eng-manager', 'pm-manager', 'tech-manager', 'delivery-manager'] },
  { id: 'service', name: 'Support and service', roles: ['desk', 'network', 'sm-av', 'sm-infra'] },
  { id: 'lab', name: 'The Lab', roles: ['innovation'] },
  { id: 'lead', name: 'Leadership', roles: ['head'] },
  { id: 'partners', name: 'Partners', roles: ['vendor', 'service-vendor'] },
];
// A short name for the role and one whole line on what that view is for.
const ROLE = {
  delivery: ['Delivery engineer', 'Designs and commissions spaces, from survey to handover'],
  pm: ['Project manager', 'Runs projects day to day: dates, suppliers and who does what'],
  tech: ['On-site technician', 'Installs and fixes kit in the offices'],
  programme: ['Programme manager', 'Plans the year of projects across every region'],
  'eng-manager': ['Engineering manager', 'Leads the delivery engineers'],
  'pm-manager': ['Project management lead', 'Leads the project managers'],
  'tech-manager': ['On-site services manager', 'Leads the on-site technicians'],
  'delivery-manager': ['Delivery manager', 'The whole delivery team, every region'],
  desk: ['Service desk analyst', 'Takes incidents as they arrive and routes them'],
  network: ['Network engineer', 'Ports, VLANs and patching'],
  'sm-av': ['Service manager, AV', 'Owns the AV standard and its service'],
  'sm-infra': ['Service manager, network', 'Owns the network standard and its service'],
  innovation: ['Innovation engineer', 'Tests new kit before it ships'],
  head: ['Head of AV and IT', 'The whole service, every region'],
  vendor: ['Integration vendor', 'Sees their own installations only'],
  'service-vendor': ['Service vendor', 'Repairs under the service contract'],
};
const EVERYONE = { id: 'everyone', name: 'Everyone (overview)', role: 'Every role at once', short: 'Everyone', where: 'Every role at once', initials: 'All' };
const lc = (s) => String(s ?? '').toLowerCase();
const groups = GROUPS.map((g) => ({
  ...g,
  roles: g.roles.map((r) => {
    const ps = PEOPLE.filter((p) => p.roleId === r);
    return { r, name: ROLE[r][0], line: ROLE[r][1], ps, text: lc(`${ROLE[r][0]} ${ROLE[r][1]} ${ROLES[r].name} ${g.name} ${TEAMS[ROLES[r].team]}`) };
  }),
}));
// What the script needs about each person: the top line, the suggestions and the palette's rows.
const VP_PEOPLE = [EVERYONE, ...PEOPLE.map((p) => ({ id: p.id, name: p.name, role: p.role, short: ROLE[p.roleId][0], where: p.where, initials: p.initials }))];
---
<dialog class="vp" id="view-as" data-vp aria-labelledby="vp-title" data-help="shell.viewas" tabindex="-1">
  <div class="vp-top">
    <div class="vp-head">
      <div class="vp-ht">
        <h2 id="vp-title">View as</h2>
        <p>See Keia Atlas the way someone else does. A demo: nobody signs in.</p>
      </div>
      <button type="button" class="icon-btn vp-x" data-vp-close aria-label="Close View as">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
    <div class="vp-now" data-help="shell.viewas-current">
      <span class="avatar vp-av" aria-hidden="true" data-vp-me-av>AB</span>
      <span class="vp-now-t"><small>Viewing as</small><b data-vp-me-name>Anna Byrne</b><span data-vp-me-role>AV and IT delivery engineer · EMEA</span></span>
      <button type="button" class="btn small vp-back" data-vp-back data-help="shell.back-to-you" hidden>Back to you</button>
    </div>
    <label class="vp-q" data-help="shell.viewas-find"><Icon name="search" size={16} /><input type="search" placeholder="Find a name, role or place" data-vp-q aria-label="Find a person or role" aria-describedby="vp-hint" autocomplete="off" spellcheck="false" /></label>
    <p class="vp-hint" id="vp-hint" data-vp-hint aria-live="polite"></p>
  </div>

  <div class="vp-body" data-vp-body>
    <section class="vp-grp vp-sug" data-vp-sug data-help="shell.viewas-recent" aria-labelledby="vp-sug-h">
      <h3 id="vp-sug-h" data-vp-sug-h>Suggested</h3>
      <div class="vp-chips" data-vp-recent></div>
    </section>
    {groups.map((g) => (
      <section class="vp-grp" data-vp-grp aria-labelledby={`vp-g-${g.id}`}>
        <h3 id={`vp-g-${g.id}`}>{g.name}</h3>
        <ul class="vp-roles">
          {g.roles.map((t) => (
            <li class="vp-role" data-vp-role={t.r} data-text={t.text} data-help="shell.viewas-role">
              <div class="vp-role-t"><b id={`vp-r-${t.r}`}>{t.name}</b><span>{t.line}</span></div>
              <div class="vp-chips" role="group" aria-labelledby={`vp-r-${t.r}`}>
                {t.ps.map((p) => (
                  <button type="button" class="vp-person" data-pick-who={p.id} data-help="shell.viewas-person" data-text={lc(`${p.name} ${p.where} ${p.scope ?? ''}`)} aria-label={`View as ${p.name}, ${ROLE[p.roleId][0]}, ${p.where}`}>
                    <span class="avatar" aria-hidden="true">{p.initials}</span>
                    <span class="vp-pt"><b>{p.name}</b><small>{p.where}</small></span>
                  </button>
                ))}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <section class="vp-grp" data-vp-grp aria-labelledby="vp-g-all">
      <h3 id="vp-g-all">Overview</h3>
      <ul class="vp-roles">
        <li class="vp-role" data-vp-role="everyone" data-text="everyone overview all roles every role at once">
          <div class="vp-role-t"><b id="vp-r-everyone">Everyone</b><span>Every role's first screen at once, to see the whole picture</span></div>
          <div class="vp-chips" role="group" aria-labelledby="vp-r-everyone">
            <button type="button" class="vp-person" data-pick-who="everyone" data-help="shell.viewas-everyone" data-text="everyone overview all" aria-label="View as Everyone (overview)">
              <span class="avatar" aria-hidden="true">All</span>
              <span class="vp-pt"><b>Everyone</b><small>Overview</small></span>
            </button>
          </div>
        </li>
      </ul>
    </section>
  </div>
</dialog>

<script is:inline data-astro-rerun define:vars={{ VP_PEOPLE }}>
  (function () {
    var W = window, D = document;
    var dlg = D.querySelector('dialog[data-vp]');
    if (!dlg || dlg.__vp) return;
    dlg.__vp = true;
    var KEY = 'rs6-who-recent', STARTERS = ['liam', 'priya', 'claire', 'sofia'];
    var byId = {}; VP_PEOPLE.forEach(function (p) { byId[p.id] = p; });
    var q = dlg.querySelector('[data-vp-q]'), hint = dlg.querySelector('[data-vp-hint]'), body = dlg.querySelector('[data-vp-body]');
    var roles = Array.prototype.slice.call(dlg.querySelectorAll('[data-vp-role]'));
    var opener = null, hits = [];
    var fine = matchMedia('(hover: hover) and (pointer: fine)');
    var reduced = function () { return W.km ? W.km.reduced() : !W.rsMotion || W.rsMotion().reduced; };
    var M = function () { return W.rsMotion ? W.rsMotion() : { enter: 440, exit: 240, stagger: 24, ease: 'ease-out', exitEase: 'ease-in' }; };
    var esc = function (s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
    var cur = function () { return W.rsWhoId ? W.rsWhoId() : 'anna'; };
    var me = function () { return W.rsMeId ? W.rsMeId() : cur(); };
    var shown = function (el) { return !!el && el.isConnected && el.getClientRects().length > 0; };

    /* Recent picks: the people this browser has viewed as, newest first. */
    var recent = function () { var l = []; try { l = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (_) { l = W.__vpRecent || []; } return Array.isArray(l) ? l.filter(function (id) { return byId[id]; }) : []; };
    W.__vpPush = W.__vpPush || function (id) {
      if (!id) return;
      var l = [id].concat(recent().filter(function (x) { return x !== id; })).slice(0, 6);
      W.__vpRecent = l; try { localStorage.setItem(KEY, JSON.stringify(l)); } catch (_) {}
    };
    if (!W.__vpHook) {   // once per visit: whoever you leave goes to the front of Recent, however you switched
      W.__vpHook = true; W.__vpLast = cur();
      D.addEventListener('rs:demo-change', function (e) {
        if (!e.detail || e.detail.what !== 'who') return;
        var now = cur(), was = W.__vpLast; W.__vpLast = now;
        if (was && was !== now) W.__vpPush(was);
      });
    }
    var chip = function (x) {
      var r = byId[x];
      return '<button type="button" class="vp-person" data-pick-who="' + esc(x) + '" data-help="shell.viewas-person" aria-label="View as ' + esc(r.name + ', ' + r.short + ', ' + r.where) + '">' +
        '<span class="avatar" aria-hidden="true">' + esc(r.initials) + '</span><span class="vp-pt"><b>' + esc(r.name) + '</b><small>' + esc(r.short) + '</small></span></button>';
    };

    /* The top: who you are viewing as, Back to you, and three people to switch to in one press. */
    function render() {
      var id = cur(), p = byId[id] || VP_PEOPLE[1];
      dlg.querySelector('[data-vp-me-av]').textContent = p.initials;
      dlg.querySelector('[data-vp-me-name]').textContent = p.name;
      dlg.querySelector('[data-vp-me-role]').textContent = id === 'everyone' ? 'Every role\'s first screen at once' : p.role + ' · ' + p.where;
      var back = dlg.querySelector('[data-vp-back]'), mine = byId[me()];
      back.hidden = !mine || me() === id;
      if (mine) { back.title = 'Back to ' + mine.name + ', ' + mine.role; back.setAttribute('aria-label', 'Back to you: ' + mine.name); }
      var rec = recent().filter(function (x) { return x !== id; });
      var list = (rec.length ? rec : STARTERS.filter(function (x) { return x !== id; })).slice(0, 3);
      dlg.querySelector('[data-vp-sug-h]').textContent = rec.length ? 'Recent' : 'Suggested';
      dlg.querySelector('[data-vp-recent]').innerHTML = list.map(chip).join('');
      dlg.querySelectorAll('[data-pick-who]').forEach(function (b) { if (b.dataset.pickWho === id) b.setAttribute('aria-current', 'true'); else b.removeAttribute('aria-current'); });
    }

    /* Find: roles and people that do not match leave the list at once (nothing slides); one line says what Enter does. */
    var norm = function (s) { return String(s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').trim(); };
    function filter() {
      var toks = norm(q.value).split(/\s+/).filter(Boolean), roleHits = [];
      hits = [];
      roles.forEach(function (t) {
        var tt = norm(t.dataset.text), any = false;
        var roleHit = toks.length && toks.every(function (k) { return tt.indexOf(k) >= 0; });
        t.querySelectorAll('[data-pick-who]').forEach(function (b) {
          var pt = norm(b.dataset.text), ok = !toks.length || roleHit || toks.every(function (k) { return (tt + ' ' + pt).indexOf(k) >= 0; });
          b.hidden = !ok;
          if (ok) { any = true; if (toks.length && hits.indexOf(b.dataset.pickWho) < 0) hits.push(b.dataset.pickWho); }
        });
        t.hidden = !any;
        if (any) roleHits.push(t);
      });
      dlg.querySelectorAll('[data-vp-grp]').forEach(function (g) { g.hidden = !g.querySelector('[data-vp-role]:not([hidden])'); });
      dlg.querySelector('[data-vp-sug]').hidden = !!toks.length;
      var t = q.value.trim();
      if (!t) hint.textContent = '';
      else if (!roleHits.length) hint.textContent = 'No one matches "' + t + '". Try a first name, a role or an office.';
      else if (hits.length === 1) hint.textContent = 'Enter to view as ' + byId[hits[0]].name;
      else hint.textContent = hits.length + ' people in ' + roleHits.length + (roleHits.length === 1 ? ' role' : ' roles');
    }

    /* Choosing someone: the sheet folds into your name (the account button, or the gear on a phone), then the page
       changes to them in one move (rsPickWho). */
    var chipNow = function () {
      var a = D.querySelector('[data-acct-menu]');
      if (shown(a)) return a;
      var g = Array.prototype.filter.call(D.querySelectorAll('[data-open-settings]'), shown)[0];
      return g || opener;
    };
    function pick(id) {
      if (id === cur()) { close(); return; }
      close(chipNow());
      if (reduced()) W.rsPickWho(id); else setTimeout(function () { W.rsPickWho(id); }, M().exit);
    }

    /* The rows settle in, a stagger apart (the first dozen; the rest are already in place). */
    function settle() {
      if (reduced()) return;
      var m = M(), vh = innerHeight, i = 0;
      dlg.querySelectorAll('.vp-now, .vp-grp > h3, .vp-role, .vp-sug .vp-chips').forEach(function (el) {
        if (!shown(el) || el.getBoundingClientRect().top > vh || i > 14) return;
        el.animate([{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }], { duration: m.enter, delay: m.delay + (i++) * m.stagger, easing: m.ease, fill: 'backwards' });
      });
    }
    function place() {}
    function open(from) {
      opener = from || null;
      if (dlg.open && !dlg.classList.contains('closing')) return;
      dlg.getAnimations({ subtree: true }).forEach(function (a) { a.cancel(); });
      dlg.classList.remove('closing');
      q.value = ''; render(); filter();
      if (!dlg.open) dlg.showModal();
      body.scrollTop = 0;
      D.querySelectorAll('[data-acct-menu]').forEach(function (b) { b.setAttribute('aria-expanded', 'true'); });
      if (W.rsPopIn) W.rsPopIn(dlg, opener);
      settle();
      if (fine.matches) q.focus({ preventScroll: true }); else dlg.focus({ preventScroll: true });
    }
    function close(to) {
      if (!dlg.open || dlg.classList.contains('closing')) return;
      dlg.classList.add('closing');
      D.querySelectorAll('[data-acct-menu]').forEach(function (b) { b.setAttribute('aria-expanded', 'false'); });
      var target = to || (opener && opener.isConnected ? opener : null);
      var done = function () {
        dlg.classList.remove('closing'); dlg.close();
        var f = target && target.isConnected && shown(target) ? target : null;
        if (f && f.focus) f.focus({ preventScroll: true });
      };
      if (W.rsPopOut) W.rsPopOut(dlg, target, done); else done();
    }

    /* Keys: Down from the find field goes to the first person; Enter chooses; Escape clears the find, then closes. */
    dlg.addEventListener('keydown', function (e) {
      var t = e.target;
      if (e.key === 'Escape') {
        e.preventDefault();
        if (t === q && q.value) { q.value = ''; filter(); return; }
        close(); return;
      }
      if (t === q) {
        if (e.key === 'ArrowDown') { e.preventDefault(); var f = Array.prototype.filter.call(body.querySelectorAll('[data-pick-who]'), shown)[0]; if (f) f.focus(); return; }
        if (e.key === 'Enter') { e.preventDefault(); if (q.value.trim() && hits.length === 1) pick(hits[0]); }
        return;
      }
      // Up and Down move between people too; typing a letter goes to the find field.
      if ((e.key === 'ArrowDown' || e.key === 'ArrowUp') && t.hasAttribute && t.hasAttribute('data-pick-who')) {
        e.preventDefault();
        var all = Array.prototype.filter.call(body.querySelectorAll('[data-pick-who]'), shown), n = all.indexOf(t) + (e.key === 'ArrowDown' ? 1 : -1);
        if (n < 0) q.focus(); else if (all[n]) all[n].focus();
        return;
      }
      if (e.key.length === 1 && e.key !== ' ' && !e.metaKey && !e.ctrlKey && !e.altKey && t !== q) q.focus({ preventScroll: true });
    });
    dlg.addEventListener('cancel', function (e) { e.preventDefault(); });
    q.addEventListener('input', filter);
    dlg.addEventListener('click', function (e) {
      if (e.target === dlg) { close(); return; }
      var t = e.target.closest ? e.target : null; if (!t) return;
      if (t.closest('[data-vp-close]')) { close(); return; }
      var pk = t.closest('[data-pick-who]'); if (pk) { pick(pk.dataset.pickWho); return; }
      if (t.closest('[data-vp-back]')) { pick(me()); return; }
    });
    // Anything marked data-open-viewas opens this (the ribbon's Change, the quick menu, the Settings page), as does
    // the name in the sidebar; listened for on the document, so a part drawn after this one is covered too. Opened
    // from inside the quick menu, the menu steps aside first.
    function from(b) {
      if (dlg.open && !dlg.classList.contains('closing')) { close(); return; }
      var host = b.closest('dialog');
      if (host && host !== dlg && host.open) { var c = host.querySelector('[data-settings-close]'); if (c) c.click(); else host.close(); }
      open(b);
    }
    if (!W.__vpHooks) {   // once per visit; each page's picker replaces window.rsViewAs
      W.__vpHooks = true;
      D.addEventListener('click', function (e) {
        var b = e.target && e.target.closest ? e.target.closest('[data-acct-menu], [data-open-viewas]') : null;
        if (b && W.rsViewAs) W.rsViewAs.from(b);
      });
    }
    W.rsViewAs = {
      open: open, close: close, from: from, place: place,
      pick: function (id) { var b = dlg.querySelector('[data-vp-role] [data-pick-who="' + id + '"]'); if (b) b.click(); else if (byId[id]) pick(id); },
      people: function () { return VP_PEOPLE.map(function (p) { return { id: p.id, name: p.name, role: p.role, short: p.short, where: p.where, initials: p.initials }; }); },
    };
  })();
</script>

<style is:global>
  /* A sheet: centred on a computer, the whole screen on a phone. Its top stays put while the list scrolls. */
  .vp { position: fixed; inset: 0; margin: auto; width: min(760px, calc(100vw - 48px)); height: min(860px, calc(100dvh - 64px)); max-width: none; max-height: none; padding: 0; border: var(--border-card); border-radius: var(--radius-lg); background: var(--surface); color: var(--text); box-shadow: var(--shadow-lg); overflow: hidden; display: none; }
  .vp[open] { display: grid; grid-template-rows: auto minmax(0, 1fr); }
  .vp:focus { outline: none; }
  .vp::backdrop { background: color-mix(in srgb, #000 36%, transparent); animation: rs-fade-in var(--dur-pop) var(--ease-settle); }
  .vp.closing::backdrop { animation: rs-fade-out var(--dur-exit) var(--ease-settle) forwards; }
  .vp .avatar { flex: none; display: grid; place-items: center; width: 2.4em; height: 2.4em; border-radius: 50%; background: var(--surface-3); color: var(--text); font: 650 12px/1 var(--font-sans); letter-spacing: .01em; }

  .vp-top { display: grid; gap: 14px; padding: 22px 28px 16px; border-bottom: 1px solid var(--line); }
  .vp-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
  .vp-ht { display: grid; gap: 4px; min-width: 0; }
  .vp-ht h2 { margin: 0; font: 600 var(--fs-title-s, 22px)/1.2 var(--font-sans); letter-spacing: -.01em; }
  .vp-ht p { margin: 0; font-size: var(--fs-support, 13px); color: var(--text-2); }
  .vp-x { margin: -6px -10px 0 0; flex: none; }

  .vp-now { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: var(--radius); background: var(--surface-2); }
  .vp-now .vp-av { font-size: 13.5px; background: var(--accent-soft); color: var(--accent-ink); }
  .vp-now-t { display: grid; gap: 1px; min-width: 0; flex: 1; }
  .vp-now-t small { font-size: var(--fs-code, 12.5px); color: var(--text-2); }
  .vp-now-t b { font: 600 var(--fs-name, 14px)/1.3 var(--font-sans); }
  .vp-now-t span { font-size: var(--fs-support, 13px); color: var(--text-2); line-height: 1.4; }
  .vp-back { flex: none; }
  .vp-back[hidden] { display: none; }

  .vp-q { display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 14px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface); color: var(--text-3); transition: border-color var(--dur-hover) var(--ease-settle); }
  .vp-q:focus-within { border-color: var(--line-strong); }
  .vp-q input { flex: 1; min-width: 0; border: 0; background: transparent; outline: none; font: inherit; font-size: max(16px, var(--fs-body, 14px)); color: var(--text); }
  .vp-q input::-webkit-search-cancel-button { display: none; }
  .vp-hint { margin: -6px 0 0; font-size: var(--fs-code, 12.5px); color: var(--text-2); }
  .vp-hint:empty { display: none; }

  /* The list: a team's name, then its roles, each a name, one whole line, and its people as named chips. */
  .vp-body { overflow-y: auto; overscroll-behavior: contain; padding: 8px 28px 28px; }
  .vp-grp { padding-top: 20px; }
  .vp-grp[hidden], .vp-role[hidden], .vp-person[hidden] { display: none; }
  .vp-grp > h3 { margin: 0 0 4px; font: 600 var(--fs-support, 13px)/1.3 var(--font-sans); color: var(--text-2); }
  .vp-roles { list-style: none; margin: 0; padding: 0; }
  .vp-role { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); align-items: start; gap: 10px 24px; padding: 14px 0; border-top: 1px solid var(--line); }
  .vp-grp > h3 + .vp-roles > .vp-role:first-child { border-top: 0; }
  .vp-role-t { display: grid; gap: 3px; min-width: 0; padding-top: 4px; }
  .vp-role-t b { font: 600 var(--fs-name, 14px)/1.35 var(--font-sans); }
  .vp-role-t span { font-size: var(--fs-support, 13px); line-height: 1.45; color: var(--text-2); }
