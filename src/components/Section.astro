---
/* Section: one full-width block of secondary detail, below the main area (docs/rules/layout.md, L1 and L6).
   Props:  title    the h2. Leave it out for a block with no heading that only needs "Show all" (a list
                    or table that already has its own card and title).
           aside    a short note on the right of the heading
           id       for links (#outlets) and the heading's id; made from the title when left out
           showAll  n: show the first n items, then a "Show all" button (rule L6, "Show all" instead of a
                    box that scrolls). The items are the children of the element marked data-items inside
                    the section (a .list, a <tbody>, a grid). Only items that are showing count: one a
                    filter bar has hidden (.fb-out) or that is [hidden] does not use up a place, and the
                    button says how many are showing ("Show all 38"). It follows the bar's filters, search,
                    sort and any change to the list.
           rows     n: fold after n rows, not n items (design notes: 8 rows, 16 in Compact). A row of a card grid is as
                    many cards as its columns, counted as the page is laid out, so a grid folds after 8 rows of
                    cards at every width: 16 cards in two columns on a phone, 40 in five on a wide screen. A list or
                    a table has one item a row. Several boxes may carry data-items (the cards and the list of a
                    Cards | List page); each folds on its own and the button counts the one showing. It follows
                    the filters, search and sort as showAll does, so they still reach every item.
           rowsAt   'phone': fold only below 768 px wide (a long table that is short enough on a big screen).
                    data-sa-noun="kinds" adds a word to the button ("Show all 20 kinds") when a count alone is unclear.
           to       the page that owns this list (rule P10, docs/rules/platform.md): a path ('/incidents/?status=new')
                    or a filter on this page ('?status=problem'). With `to`, the section never expands in place:
                    it shows the first `showAll` items (all of them when showAll is left out) and a link that says
                    where it goes, "See all 288 in the Work list →", counting what shows, as the button does. Use it
                    on every overview and summary; keep plain showAll for a list on its own page, or a short
                    extra of a few rows inside a record. The count in the link flies into the destination's band
                    title (data-vt-rec="dd-<path>", "dd-work-list" for /work/list/; the destination sets PageBand rec to it).
           place    the words after "in": 'Incidents', 'the Work list'. Default: the section's title.
           carry    true: the link also takes this page's filters from the address (?site=dub&q=hdmi), for a
                    preview whose page has the same filter bar as the destination (the Work overview and list).
                    A list of keys carries only those.
           help     the help key for the heading (src/lib/help.mjs), when the block has words of its own; default "section"
           class    added to the section
           ...      any other attribute goes on the section (data-fb-group, data-min-stage, and so on), so a
                    filter bar can hide the whole block when none of its items show.
   Slots:  default  the content. It may hold its own button, .btn with data-sa-btn and hidden, to put
                    "Show all" somewhere else than below the content (a card's footer). Otherwise the
                    section adds one under the content.
           aside    the right of the heading, when it needs a link or a button
                    With `to`, an <a data-sa-to hidden> inside the content puts the "See all" link there instead.
   Collapsing again keeps the button under the pointer (M6). */
import { href } from '../lib/data.mjs';
// The shared-element name for a drill-down to a page: '/work/list/?kind=task' -> 'dd-work-list'.
const ddId = (to: string) => 'dd' + new URL(to, 'http://x').pathname.replace(/[^a-z0-9]+/gi, '-').replace(/-$/, '');
interface Props { title?: string; aside?: string; id?: string; showAll?: number; rows?: number; rowsAt?: 'phone'; to?: string; place?: string; carry?: boolean | string[]; class?: string; help?: string; [attr: string]: unknown }
const { title, aside, showAll: showAllProp, rows, rowsAt, to, place, carry, class: cls, id: idProp, help, ...rest } = Astro.props;
const showAll = showAllProp ?? rows;
const id = idProp ?? (title ? title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') : undefined);
const hid = title && id ? `${id}-h` : undefined;
const toHref = to ? (to.startsWith('/') ? href(to) : to) : undefined;
const where = place ?? title ?? 'the list';
---
<section class:list={['sec', cls]} id={id} aria-labelledby={hid} data-show-all={showAll ?? (to ? 100000 : undefined)} data-sa-rows={rows ? '' : undefined} data-sa-at={rows ? rowsAt : undefined} data-sa-place={to ? where : undefined} data-sa-carry={carry === true ? '*' : Array.isArray(carry) ? carry.join(',') : undefined} {...rest}>
  {(title || aside || Astro.slots.has('aside')) && (
    <header class="section-head" data-help={help ?? 'section'} data-help-name={title}>
      {title && <h2 id={hid}>{title}</h2>}
      {aside && <span class="aside faint">{aside}</span>}
      {Astro.slots.has('aside') && <span class="aside"><slot name="aside" /></span>}
    </header>
  )}
  <slot />
  {to ? (
    <a class="sec-all sec-to" href={toHref} data-help="section.seeall" data-sa-to data-sa-default data-vt-rec={to.startsWith('/') ? ddId(to) : undefined}><span data-sa-t>See all in {where}</span> <span aria-hidden="true">→</span></a>
  ) : showAll && <button type="button" class="btn small ghost sec-all" data-help="section.showall" data-sa-btn data-sa-default hidden aria-expanded="false"></button>}
</section>

<script is:inline data-astro-rerun>
  (function () {
    function bind(sec) {
      // A section can hold sections: a script inside it may run before this one's end has been read, so it is
      // only marked bound once its button is there.
      if (sec.__sa) return;
      var n = +sec.dataset.showAll, box = sec.querySelector('[data-items]');
      var link = sec.querySelector('[data-sa-to]:not([data-sa-default])') || sec.querySelector('[data-sa-to]');
      if (link) { sec.__sa = true; return bindTo(sec, n, box, link); }
      var btn = sec.querySelector('[data-sa-btn]:not([data-sa-default])') || sec.querySelector('[data-sa-btn]');
      if (!box || !btn) return;
      sec.__sa = true;
      // A button the page put in the content wins; drop the one the section added.
      sec.querySelectorAll('[data-sa-default]').forEach(function (d) { if (d !== btn) d.remove(); });
      // rows: the limit is n rows, so a grid's columns (as it is laid out now) multiply it; Compact doubles it.
      var boxes = Array.prototype.slice.call(sec.querySelectorAll('[data-items]'));
      var byRows = sec.hasAttribute('data-sa-rows'), phoneOnly = sec.dataset.saAt === 'phone';
      var colsOf = function (b) {
        var cs = getComputedStyle(b);
        if (cs.display.indexOf('grid') < 0) return 1;
        var t = (cs.gridTemplateColumns || '').replace(/\[[^\]]*\]/g, ' ').trim();
        return t && t !== 'none' ? t.split(/\s+/).length : 1;
      };
      var limit = function (b) {
        if (!byRows) return n;
        if (phoneOnly && !matchMedia('(max-width: 767px)').matches) return Infinity;
        return n * (document.documentElement.dataset.density === 'compact' ? 2 : 1) * colsOf(b);
      };
      var shows = function (b) { var p = b.closest('[hidden]'); return !p || !sec.contains(p); };
      // Count what is showing, mark the ones past the limit, say how many there are.
      var apply = function () {
        var open = sec.classList.contains('sa-open'), seen = 0, fold = false, first = true;
        boxes.forEach(function (b) {
          var lim = limit(b), s = 0;
          Array.prototype.forEach.call(b.children, function (el) {
            if (el.classList.contains('fb-out') || el.hidden) { el.classList.remove('sa-x'); return; }
            s++; el.classList.toggle('sa-x', s > lim);
          });
          // The button speaks for the box that is showing (the first, when none is hidden).
          if (first && shows(b)) { seen = s; fold = s > lim; first = false; }
        });
        if (btn.hidden !== !fold) btn.hidden = !fold;
        var t = open ? 'Show fewer' : 'Show all ' + seen.toLocaleString('en-IE') + (sec.dataset.saNoun ? ' ' + sec.dataset.saNoun : '');
        if (btn.textContent !== t) btn.textContent = t;
        btn.setAttribute('aria-expanded', String(open));
      };
      sec.__saApply = apply;
      btn.addEventListener('click', function () {
        var y0 = btn.getBoundingClientRect().top, opening = !sec.classList.contains('sa-open');
        var M = window.rsMotion ? window.rsMotion() : { reduced: true };
        var box = boxes.filter(shows)[0] || boxes[0];
        var was = opening ? Array.prototype.filter.call(box.children, function (el) { return el.classList.contains('sa-x'); }) : [];
        var h0 = box.getBoundingClientRect().height;
        sec.classList.toggle('sa-open');
        apply();
        if (opening) {
          // docs/rules/motion.md: the box eases to its new height and the new rows enter, --stagger apart, up to 12;
          // the rest arrive together. The button below moves down with the box, away from nothing it covers.
          if (M.reduced || !box.animate) return;
          var h1 = box.getBoundingClientRect().height;
          if (h1 - h0 > 2 && box.tagName !== 'TBODY') box.animate([{ height: h0 + 'px', overflow: 'clip' }, { height: h1 + 'px', overflow: 'clip' }], { duration: M.morph, easing: M.ease });
          was.forEach(function (el, i) {
            el.animate([{ opacity: 0, transform: 'translateY(4px)' }, { opacity: 1, transform: 'none' }], { duration: M.enter, delay: M.delay + Math.min(i, 12) * M.stagger, easing: M.ease, fill: 'backwards' });
          });
          return;
        }
        // Showing fewer: the button stays where the pointer is (M6), so the page does not pull up under it.
        var dy = btn.getBoundingClientRect().top - y0;
        if (Math.abs(dy) > 1) window.scrollBy(0, dy);
      });
      // Rows added, removed or re-ordered by the page (a sort, a live update) are counted again.
      if (window.MutationObserver) {
        var raf = 0;
        var mo = new MutationObserver(function () { cancelAnimationFrame(raf); raf = requestAnimationFrame(apply); });
        boxes.forEach(function (b) { mo.observe(b, { childList: true }); });
        // Cards | List: the view that shows changes which box the button speaks for.
        if (boxes.length > 1) mo.observe(sec, { subtree: true, attributes: true, attributeFilter: ['hidden'] });
      }
      apply();
      // A link to something folded away (#id) opens the fold, so the page can scroll to it.
      var h = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
      if (h && sec.contains(h) && h.closest('.sa-x')) { sec.classList.add('sa-open'); apply(); }
    }
    // Drill-down (rule P10): the first n items, then a link to the page that owns the list. Never expands here.
    function bindTo(sec, n, box, link) {
      sec.querySelectorAll('[data-sa-default]').forEach(function (d) { if (d !== link) d.remove(); });
      // The link's own address is its base; a page script may change it later (Home adds who is signed in).
      var place = sec.dataset.saPlace || 'the list';
      if (!link.dataset.saBase) link.dataset.saBase = link.getAttribute('href') || '';
      var carry = sec.dataset.saCarry ? sec.dataset.saCarry.split(',') : null;
      // The link takes this page's filters from the address when asked (the address follows the filter bar).
      var target = function () {
        var u = new URL(link.dataset.saBase, location.href), here = new URLSearchParams(location.search);
        here.forEach(function (v, k) { if ((carry[0] === '*' || carry.indexOf(k) >= 0) && !u.searchParams.has(k)) u.searchParams.set(k, v); });
        return u.pathname + u.search.replace(/%2C/g, ",") + u.hash;
      };
      var apply = function () {
        var seen = 0;
        if (box) Array.prototype.forEach.call(box.children, function (el) {
          if (el.classList.contains('fb-out') || el.hidden) { el.classList.remove('sa-x'); return; }
          seen++; el.classList.toggle('sa-x', seen > n);
        });
        link.hidden = !!box && seen === 0;
        var t = link.querySelector('[data-sa-t]') || link;
        t.textContent = box ? 'See all ' + seen.toLocaleString('en-IE') + ' in ' + place : 'See all in ' + place;
        if (carry) link.setAttribute('href', target());
      };
      sec.__saApply = apply;
      // Right before the click is followed, the address may have changed (a filter picked since): read it again.
      if (carry) link.addEventListener('click', function () { link.setAttribute('href', target()); });
      if (box && window.MutationObserver) {
        var raf = 0;
        new MutationObserver(function () { cancelAnimationFrame(raf); raf = requestAnimationFrame(apply); }).observe(box, { childList: true });
      }
      apply();
    }
    document.querySelectorAll('.sec[data-show-all]').forEach(bind);
    if (!window.__rsSaHook) {   // once per visit, not once per page
      window.__rsSaHook = true;
      var again = function () { document.querySelectorAll('.sec[data-show-all]').forEach(function (s) { if (s.__saApply) s.__saApply(); }); };
      // The filter bar recounts after a filter, a search or a sort; a page can ask too ("rs:sa-refresh").
      document.addEventListener('fb:change', again);
      document.addEventListener('rs:sa-refresh', again);
      // A fold by rows is counted from the columns as laid out: a new width or density counts it again.
      var rz = 0;
      window.addEventListener('resize', function () { cancelAnimationFrame(rz); rz = requestAnimationFrame(again); });
      if (window.MutationObserver) new MutationObserver(again).observe(document.documentElement, { attributes: true, attributeFilter: ['data-density'] });
    }
  })();
</script>

<style is:global>
  .sec { min-width: 0; }
  .sec > .sec-all { margin-top: 12px; }
  /* The drill-down link: a quiet link, not a button, so it reads as "go there" (rule P10). */
  .sec-to { display: inline-flex; align-items: center; gap: 6px; width: fit-content; font-weight: 600; font-size: var(--fs-body); text-decoration: none; }
  .sec-to:hover { text-decoration: underline; text-underline-offset: 3px; }
  .sec-to[hidden] { display: none; }
  .sec > .sec-to { margin-top: 12px; }
  .sec:not(.sa-open) [data-items] > .sa-x { display: none !important; }
</style>
