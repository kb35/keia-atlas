---
// A work report page (used for a whole project and for one closed task): the generated record on screen,
// print styles that leave only the record on the paper, and downloads as HTML or Markdown.
// Anything added to the project in this browser (tasks and suggested playbook changes) is added below
// the fixed part, so the report always shows what actually happened.
import Shell from '../layouts/Shell.astro';
import Icon from './Icon.astro';
import PageBand from './PageBand.astro';
import { href, fmtDate, plural } from '../lib/data.mjs';
import { reportMarkdown } from '../lib/report.mjs';

const { report: r, backTo, backLabel, crumbs, about, projectId, extra = null } = Astro.props;
// A project report also carries its charter, the three lights, the log, changes to scope and lessons learned.
const X = extra;
const short = (d) => fmtDate(d, { day: 'numeric', month: 'short' });
const LIGHT = { ok: 'Fine', warn: 'To review', bad: 'Past target', off: 'Not set' };
let mdExtra = '';
if (X) {
  const L = [['Schedule', X.lights.schedule], ['Cost', X.lights.cost], ['Scope', X.lights.scope]];
  const cell = (c) => String(c ?? '').replace(/\|/g, '/');
  mdExtra += `\n## Charter\n\n${X.charter.why}\n\nSuccess looks like:\n\n${X.charter.success.map((x) => `- ${x}`).join('\n')}\n`;
  mdExtra += `\n## Status ${X.closed ? 'at close' : 'now'}\n\n${L.map(([k, l]) => `- **${k}:** ${LIGHT[l.state]}, ${l.word}. ${l.why}`).join('\n')}\n`;
  if (X.log.length) mdExtra += `\n## Risks, issues, decisions and dependencies\n\n| Id | Kind | What | Owner | Status |\n| --- | --- | --- | --- | --- |\n${X.log.map((l) => `| ${[l.id, l.kindLabel, l.title + (l.note ? `. ${l.note}` : ''), l.ownerName, l.statusLabel].map(cell).join(' | ')} |`).join('\n')}\n`;
  if (X.changes.length) mdExtra += `\n## Changes to scope\n\n${X.changes.map((c) => `- **${c.id} ${c.title}** (${c.statusLabel.toLowerCase()}${c.decided ? ` ${short(c.decided)}` : ''}, approver ${c.approverName}${c.effect ? `, ${c.effect}` : ''})${c.why ? `: ${c.why}` : ''}`).join('\n')}\n`;
  if (X.lessons.length) mdExtra += `\n## Lessons learned\n\n${X.lessons.map((x) => `- "${x.fix}" (${x.task.id}, ${x.owner.name}${x.inPlaybook ? `; in the playbook since ${short(x.inPlaybook.date)}` : ''})`).join('\n')}\n`;
}
// The answer: done or not, and whether anything differed from the plan.
const differed = r.deviations.length ? `${plural(r.deviations.length, 'difference')} from the plan` : 'no differences from the plan';
const answer = r.complete ? `Complete · ${differed}` : r.taskCount ? `${r.doneCount} of ${r.taskCount} tasks done · ${differed}` : `Not closed yet · ${differed}`;
const md = reportMarkdown(r).replace(/\n## Who\n/, `${mdExtra}\n## Who\n`);
---
<Shell title={r.title} section="projects" minStage={3} crumbs={crumbs} about={about}>
  <PageBand overline="Work report" title={r.title} sim answer={answer} lede="The record of the work: what was done, who, which devices, the evidence, what differed and who signed it off.">
    <Fragment slot="overline"><span class={`pill ${r.complete ? 'manage' : 'deploy'}`}>{r.status}</span></Fragment>
    <button slot="action" type="button" class="btn primary" data-rp-print><Icon name="book" size={16} />Print</button>
  </PageBand>

  <div class="content">
    <p class="rp-tools" data-rp-tools>
      <button type="button" class="btn small" data-rp-dl="html">Download as HTML</button>
      <button type="button" class="btn small" data-rp-dl="md">Download as Markdown</button>
      <a class="btn small ghost" href={href(backTo)}><Icon name="back" size={15} />{backLabel}</a>
    </p>
    {!r.complete && <p class="card pad rp-draft"><b>Not final.</b> This is not closed yet, so the report shows the work so far and changes as the work does.</p>}
    <article class="rp card" data-report data-project={projectId ?? ''} data-file={r.file}>
      <header class="rp-head">
        <p class="rp-brand"><b>Keia Atlas</b> · Work report</p>
        <h2 class="rp-title">{r.title.replace(/^Work report: /, '')}</h2>
        <p class="rp-sub"><span class={`rp-pill${r.complete ? ' done' : ''}`}>{r.status}</span><span>Generated {r.generated}</span></p>
      </header>

      <dl class="rp-facts">
        {r.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>

      <section class="rp-sec">
        <h3>What was done</h3>
        <p>{r.summary}</p>
        {r.phases.length > 0 && (
          <ol class="rp-phases">
            {r.phases.map((ph) => <li><b>{ph.name}</b><span class="rp-when">{ph.when}{ph.by ? `, signed off by ${ph.by}` : ''}</span><span>{ph.summary}</span></li>)}
          </ol>
        )}
        {r.steps.length > 0 && (<><p class="rp-lead">Steps followed</p><ol class="rp-steps">{r.steps.map((s) => <li>{s}</li>)}</ol></>)}
      </section>

      {X && (
        <section class="rp-sec">
          <h3>Charter</h3>
          <p>{X.charter.why}</p>
          <p class="rp-lead">Success looks like</p>
          <ul class="rp-list">{X.charter.success.map((x) => <li>{x}</li>)}</ul>
        </section>
      )}
      {X && (
        <section class="rp-sec">
          <h3>Status {X.closed ? 'at close' : 'now'}</h3>
          <ul class="rp-lights">
            {[['Schedule', X.lights.schedule], ['Cost', X.lights.cost], ['Scope', X.lights.scope]].map(([k, l]) => <li><i class="hg-m" data-state={l.state} aria-hidden="true"></i><b>{k}: {l.word}</b><span>{LIGHT[l.state]}. {l.why}</span></li>)}
          </ul>
        </section>
      )}

      <section class="rp-sec">
        <h3>Who</h3>
        <ul class="rp-who">
          {r.team.map((x) => <li><b>{x.name}</b><span>{x.role}</span>{x.hours && <span class="mono">{x.hours}</span>}{x.detail && <em>{x.detail}</em>}</li>)}
        </ul>
      </section>

      {r.tasks.length > 0 && (
        <section class="rp-sec">
          <h3>Tasks <span class="rp-count">{r.doneCount} of {r.taskCount} done</span></h3>
          <div class="rp-scroll"><table class="rp-t">
            <thead><tr><th>Task</th><th>Owner</th><th>Due</th><th>How it closed</th></tr></thead>
            <tbody>{r.tasks.map((t) => <tr><td><span class="mono">{t.id}</span> {t.title}</td><td>{t.owner}</td><td>{t.due}</td><td>{t.status === 'Done' ? (t.how || 'Done') : t.status}</td></tr>)}</tbody>
          </table></div>
        </section>
      )}

      {X && X.log.length > 0 && (
        <section class="rp-sec">
          <h3>Risks, issues, decisions and dependencies</h3>
          <div class="rp-scroll"><table class="rp-t">
            <thead><tr><th>Id</th><th>Kind</th><th>What</th><th>Owner</th><th>Status</th></tr></thead>
            <tbody>{X.log.map((l) => <tr><td class="mono">{l.id}</td><td>{l.kindLabel}</td><td>{l.title}{l.note && <small>{l.note}</small>}</td><td>{l.ownerName}</td><td>{l.statusLabel}{l.decided && <small>{short(l.decided)}</small>}</td></tr>)}</tbody>
          </table></div>
        </section>
      )}
      {X && X.changes.length > 0 && (
        <section class="rp-sec">
          <h3>Changes to scope</h3>
          <ul class="rp-list">{X.changes.map((c) => <li><b>{c.id} {c.title}</b>: {c.statusLabel.toLowerCase()}{c.decided ? ` ${short(c.decided)}` : ''} by {c.approverName}{c.effect ? `, ${c.effect}` : ''}.{c.why ? ` ${c.why}` : ''}</li>)}</ul>
        </section>
      )}
      {X && X.lessons.length > 0 && (
        <section class="rp-sec">
          <h3>Lessons learned</h3>
          <ul class="rp-list">{X.lessons.map((x) => <li>"{x.fix}" ({x.task.id}, {x.owner.name}{x.inPlaybook ? `; in the playbook since ${short(x.inPlaybook.date)}` : ''})</li>)}</ul>
        </section>
      )}

      <section class="rp-sec">
        <h3>Devices installed or changed</h3>
        {r.devices.length > 0 ? (
          <div class="rp-scroll"><table class="rp-t">
            <thead><tr><th>Room</th><th>Position</th><th>Model</th><th>Serial</th><th>Asset tag</th><th>Note</th></tr></thead>
            <tbody>{r.devices.map((d) => <tr><td>{d.room}</td><td>{d.position}{d.hostname && <small class="mono">{d.hostname}</small>}</td><td>{d.model}{d.firmware && <small class="mono">Standard firmware {d.firmware}</small>}</td><td class="mono">{d.serial}</td><td class="mono">{d.tag}</td><td>{d.replaced}</td></tr>)}</tbody>
          </table></div>
        ) : <p class="rp-none">No devices were installed or changed by this work.</p>}
      </section>

      <section class="rp-sec">
        <h3>Evidence</h3>
        {r.evidence.length > 0 ? <ul class="rp-list">{r.evidence.map((e) => <li>{e}</li>)}</ul> : <p class="rp-none">None recorded.</p>}
      </section>

      <section class="rp-sec" data-rp-dev>
        <h3>Deviations and added tasks</h3>
        {r.deviations.length > 0 ? <ul class="rp-list">{r.deviations.map((e) => <li>{e}</li>)}</ul> : <p class="rp-none" data-rp-nodev>No deviations recorded.</p>}
        <div data-rp-added></div>
      </section>

      <section class="rp-sec rp-sign">
        <h3>Sign-off</h3>
        <ul class="rp-list">
          {r.signoff.gates.map((g) => <li>{g.phase}: signed off by <b>{g.by}</b>, {g.date}</li>)}
          <li><b>{r.signoff.closed}</b></li>
        </ul>
        <div class="rp-lines">
          {r.signoff.lines.map((l) => <div class="rp-line"><span>{l.role}</span><b>{l.name}</b><i>Signature</i><i>Date</i></div>)}
        </div>
      </section>

      <footer class="rp-foot">Generated by Keia Atlas on {r.generated}. Made-up demo data.</footer>
    </article>
  </div>

  <script is:inline data-astro-rerun define:vars={{ MD: md }} slot="end">
    (function () {
      var art = document.querySelector('[data-report]'); if (!art) return;
      var project = art.dataset.project, S = window.rsStore;
      var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
      var fmt = function (d) { return d ? new Date(d).toLocaleDateString('en-IE', { day: 'numeric', month: 'short', year: 'numeric' }) : ''; };
      /* What was added to this project in this browser: tasks (with their outcome) and suggested playbook changes. */
      var added = S.get('rs4-added-tasks', []).filter(function (t) { return t.project === project; });
      var sugg = S.get('rs4-changes', []).filter(function (c) { return c.project === project; });
      var STATE = { todo: 'not done yet', done: 'done', skipped: 'skipped' };
      var CH = { review: 'waiting for review', approved: 'approved', merged: 'in the playbook', changes: 'changes asked for', withdrawn: 'withdrawn' };
      var lines = [];
      added.forEach(function (t) {
        lines.push('Task added: ' + t.title + ' (' + t.id + (t.mode === 'optional' ? ', optional' : t.mode === 'suggest' ? ', suggested for the playbook' : ', one-off') + ')' + (t.aboutLabel ? ', about ' + t.aboutLabel : '') + '. Owner ' + t.ownerName + ', added by ' + t.addedBy + '. ' + (t.archived ? 'Archived.' : 'Now ' + STATE[t.status] + (t.status === 'skipped' ? ': ' + t.skipReason : t.status === 'done' && t.doneAt ? ' on ' + fmt(t.doneAt) : '') + '.'));
      });
      sugg.forEach(function (c) { lines.push('Playbook change suggested: ' + c.title + ' (' + c.id + ', ' + (CH[c.status] || c.status) + ', approver ' + c.approver + ').'); });
      var box = art.querySelector('[data-rp-added]');
      if (lines.length) {
        box.innerHTML = '<ul class="rp-list rp-local">' + lines.map(function (l) { return '<li>' + esc(l) + '</li>'; }).join('') + '</ul>';
        var nd = art.querySelector('[data-rp-nodev]'); if (nd) nd.remove();
      }
      var mdFinal = MD.replace('{{ADDED}}', lines.length ? '\n' + lines.map(function (l) { return '- ' + l; }).join('\n') : '');
      var save = function (name, type, text) {
        var a = document.createElement('a'), url = URL.createObjectURL(new Blob([text], { type: type }));
        a.href = url; a.download = name; document.body.appendChild(a); a.click(); a.remove(); setTimeout(function () { URL.revokeObjectURL(url); }, 500);
      };
      var CSS = 'body{font:15px/1.5 system-ui,-apple-system,Segoe UI,sans-serif;color:#1c1c1c;max-width:820px;margin:32px auto;padding:0 20px}h2{font-size:26px;margin:.2em 0}h3{font-size:16px;margin:1.6em 0 .5em;border-bottom:2px solid #1c1c1c;padding-bottom:4px}table{border-collapse:collapse;width:100%;font-size:13px}th,td{text-align:left;padding:6px 8px;border-bottom:1px solid #ccc;vertical-align:top}th{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:#555}small{display:block;color:#555}.mono{font-family:ui-monospace,Menlo,monospace}dl{display:grid;grid-template-columns:1fr 1fr;gap:6px 24px}dl div{border-bottom:1px solid #ddd;padding-bottom:4px}dt{font-size:11px;text-transform:uppercase;color:#555}dd{margin:0}ul,ol{padding-left:20px}.rp-line{display:grid;grid-template-columns:1.2fr 1.4fr 1.4fr .8fr;gap:12px;align-items:end;margin-top:22px}.rp-line i{border-top:1px solid #1c1c1c;font-size:11px;font-style:normal;color:#555}.rp-brand,.rp-foot,.rp-sub{color:#555;font-size:13px}';
      art.__save = function (kind) {
        var name = art.dataset.file;
        if (kind === 'md') save(name + '.md', 'text/markdown;charset=utf-8', mdFinal);
        else save(name + '.html', 'text/html;charset=utf-8', '<!doctype html><html lang="en"><head><meta charset="utf-8"><title>' + esc(document.title) + '</title><style>' + CSS + '</style></head><body>' + art.outerHTML + '</body></html>');
      };
      if (!window.__rsReportHook) {
        window.__rsReportHook = true;
        document.addEventListener('click', function (e) {
          var a = document.querySelector('[data-report]'); if (!a) return;
          if (e.target.closest('[data-rp-print]')) { window.print(); return; }
          var d = e.target.closest('[data-rp-dl]'); if (d && a.__save) a.__save(d.dataset.rpDl);
        });
      }
    })();
  </script>
</Shell>
<style is:global>
  .tag.sim { border-style: dashed; color: var(--amber-ink); }
  .rp-status.done { background: var(--green-soft); color: var(--green-ink); }
  .rp-tools { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 14px; }
  .rp-tools .btn { display: inline-flex; gap: 6px; align-items: center; }
  .rp-draft { background: var(--amber-soft); color: var(--amber-ink); font-size: 14px; }
  .rp { padding: clamp(18px, 3vw, 36px); display: grid; gap: 22px; max-width: 960px; }
  :root[data-look="classic"] .rp { border: 2px solid var(--ink); }
  .rp-brand { margin: 0 0 6px; font-size: 13px; color: var(--text-3); letter-spacing: .04em; text-transform: uppercase; }
  .rp-title { margin: 0; font-size: 28px; line-height: 1.15; }
  .rp-sub { margin: 8px 0 0; display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; font-size: 13px; color: var(--text-2); }
  .rp-pill { padding: 3px 10px; border-radius: 999px; background: var(--amber-soft); color: var(--amber-ink); font-weight: 700; font-size: 12px; }
  .rp-pill.done { background: var(--green-soft); color: var(--green-ink); }
  .rp-facts { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px 26px; padding: 14px 0; border-top: var(--border-rule); border-bottom: var(--border-rule); }
  .rp-facts dt { font: 700 10.5px/1.2 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--text-3); margin-bottom: 2px; }
  .rp-facts dd { margin: 0; font-size: 14px; }
  .rp-sec { display: grid; gap: 10px; align-content: start; break-inside: avoid-page; }
  .rp-sec h3 { margin: 0; font-size: 18px; display: flex; align-items: baseline; gap: 10px; padding-bottom: 6px; border-bottom: 2px solid var(--ink); }
  .rp-count { font: 500 12.5px var(--font-sans); color: var(--text-3); }
  .rp-sec p { margin: 0; }
  .rp-lead { font-weight: 650; }
  .rp-phases, .rp-steps { margin: 0; padding-left: 20px; display: grid; gap: 8px; font-size: 14px; }
  .rp-phases li { display: grid; gap: 1px; } .rp-when { font-size: 12.5px; color: var(--text-3); }
  .rp-who { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .rp-who li { display: grid; grid-template-columns: minmax(150px, 1.1fr) minmax(120px, 1fr) minmax(70px, .6fr); gap: 4px 14px; font-size: 14px; }
  .rp-who li span:nth-child(2) { color: var(--text-2); } .rp-who .mono { font-size: 12.5px; color: var(--text-3); }
  .rp-who em { grid-column: 1 / -1; font-style: normal; font-size: 13px; color: var(--text-2); }
  .rp-scroll { overflow-x: auto; }
  .rp-t { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  :root[data-look] .rp-t th, :root[data-look] .rp-t td { text-align: left; padding: 8px 10px 8px 0; border-bottom: 1px solid var(--line); vertical-align: top; font-family: var(--font-sans); text-transform: none; letter-spacing: 0; color: var(--text); }
  :root[data-look] .rp-t th { font: 700 10.5px var(--font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--text-3); }
  :root[data-look] .rp-t td.mono { font-family: var(--font-mono); font-size: 12.5px; }
  .rp-t small { display: block; font-size: 11.5px; color: var(--text-3); }
  .rp-list { margin: 0; padding-left: 20px; display: grid; gap: 6px; font-size: 14px; }
  .rp-lights { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: 14px; }
  .rp-lights li { display: grid; grid-template-columns: 12px minmax(0, 1fr); gap: 2px 10px; align-items: center; }
  .rp-lights li span { grid-column: 2; font-size: 13px; color: var(--text-2); }
  .rp-local li { color: var(--text); }
  .rp-none { font-size: 14px; color: var(--text-2); }
  .rp-lines { display: grid; gap: 18px; margin-top: 8px; }
  .rp-line { display: grid; grid-template-columns: minmax(110px, 1fr) minmax(130px, 1.2fr) minmax(130px, 1.3fr) minmax(80px, .6fr); gap: 14px; align-items: end; font-size: 13.5px; }
  .rp-line span { color: var(--text-3); } .rp-line i { font-style: normal; font-size: 11px; color: var(--text-3); border-top: 1.5px solid var(--text-2); padding-top: 3px; margin-top: 24px; }
  .rp-foot { font-size: 12px; color: var(--text-3); border-top: var(--border-rule); padding-top: 10px; }
  @media (max-width: 700px) { .rp-who li { grid-template-columns: 1fr; } .rp-line { grid-template-columns: 1fr 1fr; } }

  /* On paper: only the record. Chrome, tools and the band go; the report takes the whole page in black on white. */
  @media print {
    @page { margin: 16mm; }
    html, body { background: #fff !important; color: #000 !important; }
    .mast, .side, .sec-tabs, .band, .rp-tools, .rp-draft, dialog, .toast, .peek, .stage-gate, .vendor-gate, .sr-only { display: none !important; }
    .shell { display: block !important; background: none !important; }
    main { padding: 0 !important; }
    .content { padding: 0 !important; margin: 0 !important; max-width: none !important; }
    .rp { display: block; border: 0 !important; box-shadow: none !important; background: #fff !important; padding: 0 !important; max-width: none; color: #000; }
    .rp > * + * { margin-top: 16pt; }
    .rp * { color: #000 !important; background: transparent !important; box-shadow: none !important; }
    .rp-title { font-size: 22pt; } .rp-brand, .rp-foot, .rp-when, .rp-t small, .rp-line span, .rp-line i, .rp-count { color: #444 !important; }
    .rp-pill { border: 1px solid #000; }
    .rp-sec h3 { border-bottom-color: #000; }
    .rp-lights .hg-m { background: #000 !important; }
    .rp-sec, .rp-t tr, .rp-line { break-inside: avoid; }
    .rp-scroll { overflow: visible; }
    .rp-t { font-size: 9.5pt; } .rp-t th, .rp-t td { border-bottom: 1px solid #999 !important; }
    .rp-facts { border-color: #000; }
    a { text-decoration: none; }
  }
</style>
