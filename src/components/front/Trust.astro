---
// Trust (the front door): security, privacy, standards and open source, plain and short, with the one link that
// backs each. Nothing here is claimed that the product does not do today; what is a target says so.
import { href } from '../../lib/data.mjs';
import { LINKS } from '../../lib/brand.mjs';

const ROWS = [
  { word: 'Security', line: 'Vault references, never passwords, in the YAML; the validator and the CI secret scan both check. Automatic work runs only under a rule a named owner approved, with the least access it needs, and every run has its full trace in the audit log.', to: LINKS.security, door: 'Security policy' },
  { word: 'Privacy', line: 'Every device that senses people carries a privacy record: what it captures, where that is processed, who may see it. Occupancy is a count, never a person, and a small room shows "fewer than five".', to: href('/method/trust/'), door: 'How trust works' },
  { word: 'Standards', line: 'Evidence mapped to ISO/IEC 20000 and 27001, ITIL and PMI vocabulary alongside ours, NIS2 incident timers where they apply. Supported, never claimed: certification is yours to earn.', to: href('/standards/'), door: 'The standards map' },
  { word: 'Open source', line: 'Apache 2.0 for the code, CC BY-SA 4.0 for the method. Your record is YAML in your own repository, readable without us; export is a copy, and there is no tier that keeps your data.', to: LINKS.licence, door: 'The licence' },
];
---
<section class="tr" id="trust" data-shot="trust" aria-labelledby="tr-h">
  <header class="fd-head">
    <p class="fd-eyebrow">Trust</p>
    <h2 id="tr-h">Safe to run, safe to publish.</h2>
  </header>
  <dl class="tr-list">
    {ROWS.map((r) => <div class="tr-row"><dt>{r.word}</dt><dd>{r.line}</dd><dd class="tr-door"><a href={r.to}>{r.door} →</a></dd></div>)}
  </dl>
</section>

<style>
  .tr { display: grid; gap: 22px; }
  .tr-list { margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .tr-row { display: grid; gap: 6px; align-content: start; padding-top: 14px; border-top: 2px solid var(--line-strong); min-width: 0; }
  .tr-row dt { font: 600 16px/1.2 var(--font-sans); letter-spacing: -.015em; }
  .tr-row dd { margin: 0; font-size: 13.5px; line-height: 1.5; color: var(--text-2); text-wrap: pretty; }
  .tr-door { margin-top: 2px !important; }
  .tr-door a { display: inline-flex; align-items: center; min-height: 32px; font-size: 13.5px; font-weight: 600; }
  @container fd (max-width: 1099px) { .tr-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @container fd (max-width: 559px) { .tr-list { grid-template-columns: minmax(0, 1fr); gap: 16px; } }
</style>
