---
// The front door's hero (FRONT-DOOR-V2 sections 2 and 3): the product, four levels deep, and the zoom that joins
// them. Building (the Dublin office as a model, from src/lib/floors.mjs), floor (the third floor, every space a
// ring, one broken), space (3.09 Whooper Swan) and device (the video bar, the same product drawing, DeviceArt).
// Each level answers first, in words placed where the thing is: the office and its counts; every space's number,
// name and kind, the core and who is on site; the room's devices and its booking; the device's facts.
//
// Two ways to draw it, one story:
//   3D    on a wide screen that draws WebGL, src/lib/hero3d.mjs builds the office in three.js after first paint from
//         the building data and the room drawings (furniture, displays, the bar, from src/lib/room3d.mjs) and plays
//         one cinematic sequence (MOTION-V2 4.36): a slow dolly over the building, the fourth floor lifting away,
//         the rings coming on in turn, one breaking once, then the camera easing into the space. The visitor can
//         drag a little, point at a space, click one, or use the level strip; the device level is the product
//         drawing over the scene. The words over the scene are src/lib/hero-labels.mjs.
//   2D    the first frame everywhere, and the whole hero on a phone: an isometric SVG of the same building
//         (src/lib/iso.mjs), the floor, the real room drawing (src/lib/room3d.mjs) and the device, joined by a
//         continuous zoom on the settle spring, each parent scaling up around the point its child lives at. Each
//         layer carries its own words, so they fade with the level.
// The run loops on its own (Keith, 30 Sept): it settles on its end frame, holds a calm pause (--dur-hero-rest), cross-
// fades back to its first frame and runs again. It waits while the stage is off screen or the tab is hidden, and ends
// for good once the visitor takes over (the strip, a key, a drag or a click). There is no replay control.
// Reduced motion: the final frame, still and labelled, no loop; every level a click away and changing at once.
import { building } from '../../lib/floors.mjs';
import { isoBuilding, isoFloor, fit, iso } from '../../lib/iso.mjs';
import { buildRoom, render } from '../../lib/room3d.mjs';
import { roomItems } from '../../lib/scene.mjs';
import { ringParts } from '../../lib/ring.mjs';
import { spaces, spaceTypes, sites, models, DEMO_TODAY } from '../../lib/data.mjs';
import { PEOPLE } from '../../lib/demo.mjs';
import { interiorCss } from '../../lib/interior-palette.mjs';
import RoomShot from './RoomShot.astro';
import DeviceArt from '../DeviceArt.astro';

const SITE = 'dub', FLOOR = '3', ROOM = 'dub-3-09', DEVICE = 'video-bar';
const STORY = { since: '07:52', who: 'Liam', whoSince: '08:10', next: '09:00', people: 8, model: 'Poly Studio X72', host: 'dub-309-vc01', firmware: '4.6.1', firmwareAgo: '12 days ago' };
const VW = 960, VH = 600;

// ---- Building and floor, in isometric.
const M = building(SITE);
const F = M.floors.find((f) => f.id === FLOOR);
const roomsOf = (fid) => Object.values(M.rooms).filter((r) => r.floor === fid && r.rect);
const B = isoBuilding(M, { gap: 8, h: 1.1 });
const fb = fit(B.prims, { width: VW, height: VH, pad: 60 });
const FL = isoFloor(F, roomsOf(FLOOR), { h: 1.1 });
const ff = fit(FL.prims, { width: VW, height: VH, pad: 46 });
const swan = FL.rings.find((r) => r.room.id === ROOM);
const floorCentre = fb.T(iso((FL.box[0] + FL.box[2]) / 2, (FL.box[1] + FL.box[3]) / 2, FL.z));
const swanTop = ff.T(swan.top);
const nRooms = Object.values(M.rooms).filter((r) => r.rect).length;
const siteName = sites[SITE].name;
const SITE_LINE = `${M.floors.length} floors · ${nRooms} spaces · 1 fault`;
const topFloor = B.floors[B.floors.length - 1];
const siteAt = fb.T(iso((topFloor.box[0] + topFloor.box[2]) / 2, (topFloor.box[1] + topFloor.box[3]) / 2, topFloor.z + 9));

// ---- The space: the real drawing of 3.09.
const space = spaces[ROOM];
const items = roomItems(space.option, { fitted: space.fitted, space });
const RM = buildRoom(space.space_type, space.option, items, { plugs: sites[SITE].mains?.plugs ?? null, country: space.country ?? sites[SITE].country ?? null, fitted: space.fitted, models });
const R = render(RM, { width: 900, pad: 12, aspect: 1.6 });
const roomH = VH - 40, roomW = Math.round((roomH * R.width) / R.height), roomX = Math.round((VW - roomW) / 2), roomY = 20;
const markAt = (sk) => { const m = R.marks.find((x) => x.sk === sk); return m ? { x: roomX + ((m.bb.x0 + m.bb.x1) / 2) * (roomW / R.width), y: roomY + m.bb.y0 * (roomH / R.height), w: (m.bb.x1 - m.bb.x0) * (roomW / R.width), cy: roomY + ((m.bb.y0 + m.bb.y1) / 2) * (roomH / R.height) } : null; };
const bar = markAt(DEVICE);
const barAt = [bar.x, bar.cy];
const barW = bar.w;
const DEV_WORDS = { 'display#1': 'Display 1', 'display#2': 'Display 2', 'video-bar': `${STORY.model} video bar`, 'touch-controller': 'Touch controller' };
const dev2 = ['display#1', 'display#2', 'touch-controller'].map((sk) => ({ sk, word: DEV_WORDS[sk], at: markAt(sk) })).filter((d) => d.at);

// ---- The device: the product drawing, 320 x 180 art units, with its facts beside it.
const ART = { s: 0.62, x: 84, y: 30 };
const art = (x, y) => [ART.x + x * 3 * ART.s, ART.y + (30 + y * 3) * ART.s];
const devAt = art(160, 62);
const FACTS = [['Model', STORY.model], ['Hostname', STORY.host], ['Firmware', `${STORY.firmware}, changed ${STORY.firmwareAgo}`], ['Booked', `${STORY.next}, ${STORY.people} people`], ['With', `${STORY.who} since ${STORY.whoSince}`]];

// ---- How far each level zooms into the next (clamped so a leaving layer never grows past what a GPU draws well).
const clamp = (v) => Math.max(1.5, Math.min(5, v));
const swanW = (swan.room.rect[2] - swan.room.rect[0]) + (swan.room.rect[3] - swan.room.rect[1]);
const S = [clamp(ff.k / fb.k), clamp(roomW / (swanW * 0.866 * ff.k)), clamp((294 * 3 * ART.s) / barW)];
const hot = [floorCentre, swanTop, barAt];

// ---- What the 3D scene needs, inline (no fetch): each floor, every room, the furniture, who is on site, the story.
const r2 = (v) => Math.round(v * 100) / 100;
// A space's kind, as the floor plan's key has it (src/components/FloorMap.astro), plus the IT store.
const kindOf = (t) => (t === 'mdf' || t === 'idf' ? 'comms' : t === 'it-store' ? 'store' : t?.startsWith('workstation') ? 'desks' : t === 'reception-concierge' ? 'reception'
  : ['pantry', 'pantry-expanded', 'cafeteria'].includes(t) ? 'pantry' : t === 'copy-print-room' ? 'print'
  : t === 'focus-room' || t === 'office' || t?.startsWith('huddle-room') ? 'small' : 'meeting');
const wallsOf = (k) => (['meeting', 'small'].includes(k) ? 'glass' : ['comms', 'store', 'print'].includes(k) ? 'solid' : 'none');
const typeWord = (t) => spaceTypes[t]?.profile?.name ?? '';
const peekOf = (r) => { const n = (r.positions ?? []).reduce((k, p) => k + (p.units?.length ?? 0), 0); return r.id === ROOM ? `Fault · video bar offline since ${STORY.since} · With ${STORY.who}` : `Fine · ${n === 1 ? '1 device' : `${n} devices`}`; };
const floorIndex = Object.fromEntries(M.floors.map((f, i) => [f.id, i]));

// The room drawings' materials, grouped for the scene (the index is hero3d's FURN list). Calm (Keith, 30 Sept): every
// chair in one tone, no legs, bases or small kit in any room, and each table one clean shape (its parts joined).
const FURN_MAT = { table: 0, wood: 0, counter: 0, chair: 2, 'chair-back': 2, sofa: 4, 'sofa-back': 4, dev: 5, bezel: 5, 'led-wall': 5, board: 7, stone: 7, appliance: 7, printer: 7, 'printer-top': 7, leaf: 9, pot: 10 };
const NO_DRAWING = new Set(['mdf', 'idf', 'it-store', 'open-area']);
// A part as the scene draws it: [floor index, material, 1 if in the story's room, z0, z1, x, y, x, y, ...], its outline
// in the room's own frame (the profile's) stretched, mirrored and turned onto the plan, with the floor's level.
// Millimetres, not centimetres: a screen stands 8 mm proud of its bezel, and rounding it to the centimetre would lay
// the two faces in one plane (they would fight for the same pixels).
const r3 = (v) => Math.round(v * 1000) / 1000;
const part = (geo, fi, mi, story, level, pts, z0, z1) => [fi, mi, story ? 1 : 0, r3(level + z0), r3(level + z1), ...pts.flatMap(([x, y]) => geo.toFloor(geo.fromProfile([x, y, 0])).slice(0, 2).map(r3))];
// A table drawn in pieces (the hybrid room's C-shaped table is ten) as one outline: the pieces' shared edges cancel
// and what is left is chained into one loop. Null when the pieces do not make one simple outline.
const areaOf = (P) => P.reduce((a, [x1, y1], i) => { const [x2, y2] = P[(i + 1) % P.length]; return a + x1 * y2 - x2 * y1; }, 0) / 2;
function joined(polys) {
  const key = ([x, y]: number[]) => `${Math.round(x * 1000)},${Math.round(y * 1000)}`;
  const edges = new Map();
  for (let P of polys) {
    if (areaOf(P) < 0) P = [...P].reverse();
    P.forEach((a, i) => { const b = P[(i + 1) % P.length], k = `${key(a)}|${key(b)}`, back = `${key(b)}|${key(a)}`; if (edges.has(back)) edges.delete(back); else edges.set(k, [a, b]); });
  }
  const from = new Map(); for (const e of edges.values()) from.set(key(e[0]), e);
  if (from.size !== edges.size || !edges.size) return null;
  const first = edges.values().next().value, out = [first[0]];
  for (let at = first[1], n = 0; key(at) !== key(first[0]); n++) { if (n > edges.size) return null; out.push(at); const e = from.get(key(at)); if (!e) return null; at = e[1]; }
  return out.length === edges.size ? out : null;
}
const furn = [];
const storyDev = {};
let booking = null;
for (const r of Object.values(M.rooms)) {
  if (!r.geo || r.count > 1 || NO_DRAWING.has(r.space_type)) continue;
  const sp = spaces[r.id]; if (!sp?.option) continue;
  const fl = M.floors.find((f) => f.id === r.floor), fi = floorIndex[r.floor], isStory = r.id === ROOM;
  const drawn = isStory ? RM : buildRoom(sp.space_type, sp.option, roomItems(sp.option, { fitted: sp.fitted, space: sp }), { plugs: sites[SITE].mains?.plugs ?? null, country: sp.country ?? sites[SITE].country ?? null, fitted: sp.fitted, models });
  const tables = new Map();
  for (const s of drawn.b.S) {
    if (s.ghost || s.outside || s.hid || s.mat === 'plate' || s.mat === 'floorbox') continue;
    const mi = FURN_MAT[s.mat]; if (mi == null) continue;
    const { x0, x1, y0, y1 } = s.bb;
    if ((x1 - x0) * (y1 - y0) < 0.02) continue;
    if (s.mat === 'table') { const k = `${s.z0}:${s.z1}`; if (!tables.has(k)) tables.set(k, []); tables.get(k).push(s); continue; }
    furn.push(part(r.geo, fi, mi, isStory, fl.level_m, s.pts, s.z0, s.z1));
    // A display's lit screen, on the face towards the room.
    if (s.mat === 'bezel') furn.push(part(r.geo, fi, 6, isStory, fl.level_m, [[x0 + 0.02, y1], [x1 - 0.02, y1], [x1 - 0.02, y1 + 0.008], [x0 + 0.02, y1 + 0.008]], s.z0 + 0.02, s.z1 - 0.02));
  }
  for (const list of tables.values()) {
    const one = list.length > 1 ? joined(list.map((s) => s.pts)) : list[0].pts;
    for (const pts of one ? [one] : list.map((s) => s.pts)) furn.push(part(r.geo, fi, 0, isStory, fl.level_m, pts, list[0].z0, list[0].z1));
  }
  if (isStory) {
    // Where each named device sits, for its ring and its label: a little in front of a wall device, above a table one.
    for (const key of Object.keys(DEV_WORDS)) {
      const parts = drawn.placed.get(key); if (!parts?.length) continue;
      const bb = { x0: Math.min(...parts.map((p) => p.bb.x0)), x1: Math.max(...parts.map((p) => p.bb.x1)), y0: Math.min(...parts.map((p) => p.bb.y0)), y1: Math.max(...parts.map((p) => p.bb.y1)), z0: Math.min(...parts.map((p) => p.z0)), z1: Math.max(...parts.map((p) => p.z1)) };
      const onWall = bb.y0 < 0.2, mid = (bb.x0 + bb.x1) / 2;
      // A display's ring sits at its outer top corner, so two displays and the bar between them each keep their words.
      const dx = key.startsWith('display') ? (mid < drawn.room.W / 2 ? bb.x0 + 0.12 : bb.x1 - 0.12) : mid;
      const p = onWall ? [dx, bb.y1 + 0.3, key === DEVICE ? (bb.z0 + bb.z1) / 2 : bb.z1 + 0.42] : [mid, (bb.y0 + bb.y1) / 2, bb.z1 + 0.3];
      const q = r.geo.toFloor(r.geo.fromProfile(p));
      storyDev[key] = [r2(q[0]), r2(q[1]), r2(fl.level_m + p[2])];
    }
    const t = drawn.anchors.table ?? drawn.anchors.desk;
    if (t) { const q = r.geo.toFloor(r.geo.fromProfile([(t.x0 + t.x1) / 2, t.y1 + 1.1, 0])); booking = { at: [r2(q[0]), r2(q[1]), r2(fl.level_m + (t.z ?? 0.74) + 0.75)], text: `${STORY.next} · booked, ${STORY.people} people` }; }
  }
}
// Who is on site today (the demo's day), and where they plausibly are: the technician by the IT store, the vendor
// in the town hall she is fitting out, the managers at the assigned desks upstairs, the rest in the café.
const DAY = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'][new Date(DEMO_TODAY).getDay()];
const deskD = M.rooms['dub-4-20']?.desks ?? [];
const PLACES = {
  liam: { f: '3', at: [41.6, 7.2] }, lena: { f: '3', at: [9.2, 3.4] }, sofia: { f: '3', at: [37.6, 20.4] }, nora: { f: '3', at: [35.6, 21.8] },
  claire: { f: '4', at: deskD[1]?.at }, olivia: { f: '4', at: deskD[4]?.at }, finn: { f: '4', at: deskD[9]?.at }, declan: { f: '4', at: deskD[12]?.at },
};
const onSite = PEOPLE.filter((p) => p.base === SITE && p.office_days.includes(DAY) && PLACES[p.id]?.at);
const people = onSite.map((p) => ({ i: p.initials, n: p.name, r: p.role, f: PLACES[p.id].f, at: PLACES[p.id].at.slice(0, 2).map(r2), story: p.id === 'liam' }));
const DEV_SUB = { [DEVICE]: `Fault: offline since ${STORY.since}` };
const D3 = {
  site: { name: siteName, line: SITE_LINE },
  floors: M.floors.map((f) => ({ id: f.id, name: f.name, level: f.level_m, outline: f.outline, core: f.core.map((c) => ({ r: c.rect.map(r2), kind: c.kind, flat: !!c.circulation || c.kind === 'lift-lobby' })), corr: f.corridors.map((c) => c.rect.map(r2)), areas: f.areas.map((a) => ({ r: a.rect.map(r2), k: a.kind, n: a.name })) })),
  rooms: Object.values(M.rooms).filter((r) => r.rect).map((r) => { const k = kindOf(r.space_type); return { id: r.id, no: r.number ?? '', n: `${r.number ? `${r.number} ` : ''}${r.name}`, t: typeWord(r.space_type) === r.name ? '' : typeWord(r.space_type), f: r.floor, r: r.rect.map(r2), h: 1, peek: peekOf(r), k, w: r.count > 1 ? 'none' : wallsOf(k),
    ...(r.count > 1 ? { bank: 1, desks: r.desks.map((d) => [...d.at.slice(0, 2).map(r2), ...r.geo.toFloor(d.module).slice(0, 2).map(r2)]) } : {}) }; }),
  furn, people,
  story: { room: ROOM, floor: FLOOR, devices: Object.entries(DEV_WORDS).filter(([k]) => storyDev[k]).map(([key, label]) => ({ key, label, sub: DEV_SUB[key] ?? 'Fine', at: storyDev[key], fault: key === DEVICE })), booking },
};

const LEVELS = [
  { id: 'building', word: 'Building', cap: `The Dublin office: two floors, ${nRooms} spaces, every one a ring.` },
  { id: 'floor', word: 'Floor', cap: `Third floor: ${roomsOf(FLOOR).length - 1} of ${roomsOf(FLOOR).length} spaces fine. One fault: 3.09 Whooper Swan.` },
  { id: 'space', word: 'Space', cap: `3.09 Whooper Swan: two displays, the video bar under them. Offline since ${STORY.since}.` },
  { id: 'device', word: 'Device', cap: `The video bar, ${STORY.model}: with ${STORY.who} since ${STORY.whoSince}, next booking ${STORY.next}.` },
];
const ring = (state, [cx, cy], r, sw) => ringParts(state, cx, cy, r, sw);
const rb = Math.max(3.4, 0.42 * fb.k), rf = Math.max(5, 0.5 * ff.k);
const P = (t, pts) => t.pts(pts);
const CORE_WORD = { stair: 'Stairs', lift: 'Lifts', toilets: 'Toilets' };
---
<style is:global set:html={interiorCss()} />
<div class="hz" data-hz>
  <div class="hz-stage" data-hz-stage role="group" tabindex="0" aria-label="The demo office, four levels deep: building, floor, space, device. Press ] to go deeper and [ to come back, or use the level buttons.">
    <div class="hz-light" aria-hidden="true"></div>
    <div class="hz-3d" data-hz-3d aria-hidden="true"></div>
    <script type="application/json" data-hz-data set:html={JSON.stringify(D3)} />

    <!-- Building -->
    <div class="hz-layer" data-hz-layer data-hx={hot[0][0]} data-hy={hot[0][1]} data-s={S[0].toFixed(3)} data-cap={LEVELS[0].cap}>
      <svg class="hz-svg" viewBox={`0 0 ${VW} ${VH}`} aria-hidden="true">
        <defs><filter id="hz-shadow" x="-20%" y="-40%" width="140%" height="200%"><feGaussianBlur stdDeviation="14" /></filter></defs>
        <polygon class="hz-ground" points={P(fb, B.ground.map(([x, y]) => [x, y + 2.2]))} filter="url(#hz-shadow)" />
        {B.prims.map((p) => <polygon class:list={['hz-p', `hz-${p.kind}`, p.room && `hz-k-${kindOf(p.room.space_type)}`, { 'is-fault': p.room?.id === ROOM }]} points={P(fb, p.pts)} />)}
        {B.rings.map((r) => {
          const fault = r.room.id === ROOM, at = fb.T(r.at);
          return <g class:list={['hz-ring', { 'is-fault': fault }]}>{ring(fault ? 'fault' : 'fine', at, fault ? rb * 1.35 : rb, fault ? 1.5 : 1.1).map(({ tag, attrs }) => tag === 'circle' ? <circle {...attrs} stroke={attrs.stroke ?? 'currentColor'} /> : <path {...attrs} stroke="currentColor" />)}</g>;
        })}
        {B.floors.map((f) => { const at = fb.T(f.label); return <text class="hz-floor-name" x={at[0] - 8} y={at[1] + 4}>{f.F.name}</text>; })}
      </svg>
      <div class="hz-lab2 hz-lab2-site" data-hz-tag data-x={siteAt[0]} data-y={siteAt[1]}><b>{siteName}</b><span>{SITE_LINE}</span></div>
    </div>

    <!-- Floor -->
    <div class="hz-layer is-off" data-hz-layer data-hx={hot[1][0]} data-hy={hot[1][1]} data-s={S[1].toFixed(3)} data-cap={LEVELS[1].cap}>
      <svg class="hz-svg" viewBox={`0 0 ${VW} ${VH}`} aria-hidden="true">
        <polygon class="hz-ground" points={P(ff, FL.prims[2].pts.map(([x, y]) => [x, y + 2.6]))} filter="url(#hz-shadow)" />
        {FL.prims.map((p) => <polygon class:list={['hz-p', `hz-${p.kind}`, p.room && `hz-k-${kindOf(p.room.space_type)}`, { 'is-fault': p.room?.id === ROOM }]} points={P(ff, p.pts)} />)}
        {F.core.filter((c) => CORE_WORD[c.kind]).map((c) => { const at = ff.T(iso((c.rect[0] + c.rect[2]) / 2, (c.rect[1] + c.rect[3]) / 2, FL.z)); return <text class="hz-core2" x={at[0]} y={at[1] + 3}>{CORE_WORD[c.kind]}</text>; })}
        {FL.rings.map((r) => {
          const fault = r.room.id === ROOM, at = ff.T(r.at), top = ff.T(r.top);
          const area = (r.room.rect[2] - r.room.rect[0]) * (r.room.rect[3] - r.room.rect[1]);
          const words = fault ? null : area > 24 && r.room.count === 1 ? `${r.room.number} ${r.room.name}` : area > 9 ? r.room.number : null;
          return (<>
            {words && <text class="hz-no" x={top[0]} y={top[1] + rf + 12}>{words}</text>}
            <g class:list={['hz-ring', { 'is-fault': fault }]}>{ring(fault ? 'fault' : 'fine', at, fault ? rf * 1.3 : rf, fault ? 2 : 1.6).map(({ tag, attrs }) => tag === 'circle' ? <circle {...attrs} stroke={attrs.stroke ?? 'currentColor'} /> : <path {...attrs} stroke="currentColor" />)}</g>
          </>);
        })}
      </svg>
      <div class="hz-tag is-fault" data-hz-tag data-x={hot[1][0]} data-y={hot[1][1] - rf * 2.2}><b>3.09 Whooper Swan</b><span><em class="hz-type">{typeWord(space.space_type)} · </em>Fault: video bar offline since {STORY.since}</span></div>
    </div>

    <!-- Space -->
    <div class="hz-layer is-off" data-hz-layer data-hx={hot[2][0]} data-hy={hot[2][1]} data-s={S[2].toFixed(3)} data-cap={LEVELS[2].cap}>
      <svg class="hz-svg" viewBox={`0 0 ${VW} ${VH}`} aria-hidden="true">
        <RoomShot R={R} label={`3.09 Whooper Swan, drawn to scale`} x={roomX} y={roomY} width={roomW} height={roomH} />
        <g class="hz-ring is-fault">{ring('fault', [barAt[0], barAt[1] - 30], 11, 2.4).map(({ tag, attrs }) => tag === 'circle' ? <circle {...attrs} stroke={attrs.stroke ?? 'currentColor'} /> : <path {...attrs} stroke="currentColor" />)}</g>
        {dev2.map((d) => (<g class="hz-dev2">
          <g class="hz-ring">{ring('fine', [d.at.x, d.at.y - 14], 6, 1.6).map(({ tag, attrs }) => tag === 'circle' ? <circle {...attrs} stroke={attrs.stroke ?? 'currentColor'} /> : <path {...attrs} stroke="currentColor" />)}</g>
          <text x={d.at.x} y={d.at.y - 26}>{d.word}</text>
        </g>))}
      </svg>
      <div class="hz-tag is-fault" data-hz-tag data-x={barAt[0]} data-y={barAt[1] - 48}><b>{STORY.model} video bar</b><span>Fault: offline since {STORY.since} · With {STORY.who} since {STORY.whoSince}</span></div>
      {booking && <div class="hz-lab2 hz-lab2-booking" data-hz-tag data-x={roomX + roomW * 0.5} data-y={roomY + roomH * 0.62}><b>{booking.text}</b></div>}
    </div>

    <!-- Device -->
    <div class="hz-layer is-off" data-hz-layer data-hx={devAt[0]} data-hy={devAt[1]} data-s="4" data-cap={LEVELS[3].cap}>
      <div class="hz-veil" aria-hidden="true"></div>
      <svg class="hz-svg" viewBox={`0 0 ${VW} ${VH}`} aria-hidden="true">
        <g transform={`translate(${ART.x} ${ART.y}) scale(${ART.s})`}><DeviceArt model="poly-studio-x72" label={`${STORY.model}, the video bar`} /></g>
        <g class="hz-ring is-fault">{ring('fault', devAt, 13, 2.6).map(({ tag, attrs }) => tag === 'circle' ? <circle {...attrs} stroke={attrs.stroke ?? 'currentColor'} /> : <path {...attrs} stroke="currentColor" />)}</g>
      </svg>
      <div class="hz-tag is-fault" data-hz-tag data-x={devAt[0]} data-y={devAt[1] - 22}><b>{STORY.model} video bar</b><span>Fault: offline since {STORY.since}</span></div>
      <dl class="hz-facts" data-hz-tag data-x={VW / 2} data-y={art(160, 132)[1] + 8}>
        {FACTS.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>

    <!-- Words over the 3D scene: each level's labels (src/lib/hero-labels.mjs), the space under the pointer, and the key. -->
    <div class="hz-labels" data-hz-labels aria-hidden="true"></div>
    <div class="hz-tag hz-hover" data-hz-hover hidden><b data-hz-hover-name></b><span data-hz-hover-state></span></div>
    <ul class="hz-key" data-hz-key aria-label="Key">
      <li><i class="hz-key-ring"></i>Fine</li>
      <li><i class="hz-key-ring is-fault"></i>Fault</li>
    </ul>
  </div>

  <div class="hz-foot">
    <p class="hz-cap"><span data-hz-cap aria-live="polite">{LEVELS[0].cap}</span> <span class="hz-beat" data-hz-beat hidden>checked just now</span></p>
    <div class="hz-levels" role="group" aria-label="Level" data-hz-levels>
      <span class="hz-mark" aria-hidden="true" data-hz-mark></span>
      {LEVELS.map((l, i) => <button type="button" data-hz-go={i} aria-pressed={i === 0 ? 'true' : 'false'}>{l.word}</button>)}
    </div>
  </div>
</div>

<script>
  import { motion } from '../../lib/motion-read.mjs';
  import { springEasing } from '../../lib/spring.mjs';

  const VW = 960, VH = 600;
  // A duration token in ms. The build writes "760ms" as ".76s", so the unit is read, not assumed.
  const ms = (cs: CSSStyleDeclaration, name: string, d: number) => { const v = cs.getPropertyValue(name).trim(), n = parseFloat(v); return Number.isNaN(n) ? d : /ms$/.test(v) ? n : /s$/.test(v) ? n * 1000 : n; };
  const settleEasing = (fallback: string, o: { duration: number; bounce: number }) => {
    try { if (CSS.supports('animation-timing-function', 'linear(0, 1)')) return springEasing(o); } catch (_) { /* fall through */ }
    return fallback;
  };
  // Read what the layer shows now (its animated matrix and opacity), drop the move in flight, and start one move
  // from there to `to`, so a zoom interrupted twice still reads as one motion.
  const retarget = (el: HTMLElement, to: { transform: string; opacity: number }, opts: KeyframeAnimationOptions) => {
    const cs = getComputedStyle(el);
    const from = { transform: cs.transform, opacity: cs.opacity };
    el.getAnimations().forEach((a) => a.cancel());
    return el.animate([from, { transform: to.transform, opacity: String(to.opacity) }], { fill: 'forwards', ...opts });
  };
  const hasGL = () => { try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; } };

  function init(root: HTMLElement) {
    if ((root as any).__hz) return; (root as any).__hz = true;
    const stage = root.querySelector<HTMLElement>('[data-hz-stage]')!;
    const layers = Array.from(root.querySelectorAll<HTMLElement>('[data-hz-layer]'));
    const cap = root.querySelector<HTMLElement>('[data-hz-cap]')!;
    const beat = root.querySelector<HTMLElement>('[data-hz-beat]')!;
    const btns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-hz-go]'));
    const mark = root.querySelector<HTMLElement>('[data-hz-mark]')!;
    const key = root.querySelector<HTMLElement>('[data-hz-key]')!;
    const S = layers.map((l) => +l.dataset.s! || 4);
    const hot = layers.map((l) => [+l.dataset.hx!, +l.dataset.hy!]);
    const cs = getComputedStyle(root);
    const dur = ms(cs, '--dur-hero', 760), hold = ms(cs, '--dur-hero-hold', 700), rest = ms(cs, '--dur-hero-rest', 3200);
    // Like every front-door loop (src/lib/front-loop.mjs), the pause gets a random extra beat so loops never fall into step.
    const restFor = () => rest + Math.random() * hold;
    let cur = 0, auto = true, gen = 0;

    // A point in the drawing (viewBox units) as pixels inside the stage: the drawing is fitted, centred (meet).
    const px = ([x, y]: number[]) => {
      const w = stage.clientWidth, h = stage.clientHeight, k = Math.min(w / VW, h / VH);
      return [(w - VW * k) / 2 + x * k, (h - VH * k) / 2 + y * k];
    };
    // Where layer i sits while level L is shown. Every transform is about the origin, so a move retargeted mid-flight
    // interpolates one matrix into the next with no jump.
    const target = (i: number, L: number) => {
      if (i === L) return { transform: 'none', opacity: 1 };
      if (i < L) { const [x, y] = px(hot[i]); return { transform: `translate(${x}px, ${y}px) scale(${S[i]}) translate(${-x}px, ${-y}px)`, opacity: 0 }; }
      const [x, y] = px(hot[i - 1]), cx = stage.clientWidth / 2, cy = stage.clientHeight / 2;
      return { transform: `translate(${x}px, ${y}px) scale(${1 / S[i - 1]}) translate(${-cx}px, ${-cy}px)`, opacity: 0 };
    };
    const apply = (el: HTMLElement, t: { transform: string; opacity: number }) => { el.getAnimations().forEach((a) => a.cancel()); el.style.transform = t.transform; el.style.opacity = String(t.opacity); };
    // A tag is centred on its point but kept inside the stage (a phone is narrower than the words).
    const placeTags = () => root.querySelectorAll<HTMLElement>('[data-hz-tag]').forEach((t) => { const [x, y] = px([+t.dataset.x!, +t.dataset.y!]); const half = t.offsetWidth / 2 + 8, W = stage.clientWidth; t.style.left = `${half * 2 < W ? Math.min(W - half, Math.max(half, x)) : x}px`; t.style.top = `${y}px`; });
    const setStrip = (L: number, words?: string) => {
      btns.forEach((b, k) => b.setAttribute('aria-pressed', String(k === L)));
      const b = btns[L]; mark.style.width = `${b.offsetWidth}px`; mark.style.transform = `translateX(${b.offsetLeft}px)`;
      cap.textContent = words ?? layers[L].dataset.cap ?? '';
      stage.classList.toggle('at-end', L === layers.length - 1);
      key.classList.toggle('is-on', L === 1);
    };
    // The heartbeat: words that change every 10 s, no motion.
    let t0 = 0;
    const tick = () => { if (!root.isConnected || !t0) return; const s = Math.round((Date.now() - t0) / 10000) * 10; beat.textContent = s < 10 ? 'checked just now' : s < 60 ? `checked ${s} s ago` : `checked ${Math.floor(s / 60)} min ago`; setTimeout(tick, 10000); };
    const startBeat = () => { if (t0) return; t0 = Date.now(); beat.hidden = false; setTimeout(tick, 10000); };

    // ---- 2D: the zoom between the drawn layers.
    function go2d(L: number, animate = true) {
      if (L < 0 || L >= layers.length || L === cur) return;
      const from = cur; cur = L;
      const m = motion();
      const ease = settleEasing(m.ease, { duration: dur, bounce: 0 });
      layers.forEach((el, i) => {
        const t = target(i, L);
        const moving = animate && !m.reduced && (i === from || i === L || el.getAnimations().length > 0);
        el.classList.toggle('is-off', !(i === L || moving));
        el.setAttribute('aria-hidden', String(i !== L));
        if (!moving) { apply(el, t); return; }
        retarget(el, t, { duration: dur, easing: ease }).onfinish = () => { if (cur === L) { apply(el, t); el.classList.toggle('is-off', i !== L); } };
      });
      if (L >= 1) startBeat();
      setStrip(L);
    }
    // The loop's gate: it moves only while the stage is on screen and the tab is shown, and waits otherwise.
    let inView = false;
    const waiters: (() => void)[] = [];
    const visible = () => inView && document.visibilityState === 'visible';
    const wake = () => { if (visible()) waiters.splice(0).forEach((f) => f()); };
    const whenVisible = () => (visible() ? Promise.resolve() : new Promise<void>((r) => waiters.push(r)));
    if ('IntersectionObserver' in window) new IntersectionObserver((es) => { inView = es[es.length - 1].intersectionRatio >= 0.4; wake(); }, { threshold: [0, 0.4] }).observe(stage); else inView = true;
    document.addEventListener('visibilitychange', wake);
    const wait = (t: number) => new Promise<void>((r) => setTimeout(r, t));
    // The visitor takes over: the loop ends (each loop owns one generation, so a newer loop also ends an older one).
    const stop = () => { auto = false; gen++; };
    // 2D soft reset: the end frame cross-fades to the first (opacity only, no zoom), and the strip goes home.
    const reset2d = () => new Promise<void>((res) => {
      const m = motion(), fromI = cur, from = layers[fromI], zero = layers[0];
      cur = 0;
      layers.forEach((el, i) => { if (i !== 0 && i !== fromI) { apply(el, target(i, 0)); el.classList.add('is-off'); } });
      zero.getAnimations().forEach((a) => a.cancel()); zero.style.transform = 'none'; zero.classList.remove('is-off'); zero.setAttribute('aria-hidden', 'false');
      zero.animate([{ opacity: 0 }, { opacity: 1 }], { duration: m.morph, easing: m.ease, fill: 'forwards' });
      from.getAnimations().forEach((a) => a.cancel());
      const a = from.animate([{ opacity: 1 }, { opacity: 0 }], { duration: m.morph, easing: m.ease, fill: 'forwards' });
      a.onfinish = () => { apply(from, target(fromI, 0)); from.classList.add('is-off'); from.setAttribute('aria-hidden', 'true'); if (cur === 0) apply(zero, target(0, 0)); res(); };
      a.oncancel = () => res();
      setStrip(0);
    });
    // 2D: building, floor, space, device, a step each; hold the end frame; cross-fade home; again.
    async function loop2d() {
      const my = ++gen, live = () => auto && my === gen;
      if (motion().reduced) return;
      for (;;) {
        await whenVisible(); if (!live()) return;
        await wait(hold);
        for (const L of [1, 2, 3]) { await whenVisible(); if (!live()) return; go2d(L); await wait(dur + (L === 3 ? restFor() : hold)); }
        await whenVisible(); if (!live()) return;
        await reset2d(); if (!live()) return;
      }
    }

    layers.forEach((el, i) => apply(el, target(i, 0)));
    placeTags(); setStrip(0);
    mark.classList.add('no-slide'); void mark.offsetWidth; mark.classList.remove('no-slide');
    if ('ResizeObserver' in window) new ResizeObserver(() => { layers.forEach((el, i) => { if (!el.getAnimations().length) apply(el, target(i, cur)); }); placeTags(); setStrip(cur); }).observe(stage);

    // ---- 3D: the office in three.js, loaded after first paint on a wide screen that draws WebGL.
    const host = root.querySelector<HTMLElement>('[data-hz-3d]')!;
    const labelsHost = root.querySelector<HTMLElement>('[data-hz-labels]')!;
    const hover = root.querySelector<HTMLElement>('[data-hz-hover]')!, hoverName = root.querySelector<HTMLElement>('[data-hz-hover-name]')!, hoverState = root.querySelector<HTMLElement>('[data-hz-hover-state]')!;
    const wide = stage.clientWidth >= 700;
    const saveData = (navigator as any).connection?.saveData === true;
    let hero: any = null, hoverAt: (() => number[] | null) | null = null;
    const place = (el: HTMLElement, p: number[] | null, dy = -14) => { if (!p) { el.hidden = true; return; } el.hidden = false; el.style.left = `${Math.round(p[0])}px`; el.style.top = `${Math.round(p[1] + dy)}px`; };
    const use3d = wide && !saveData && hasGL();

    // The device level in 3D: the product drawing over the scene, fading in; the scene stays behind it.
    let over = false;
    const overlay = (on: boolean) => {
      if (on === over) return; over = on;
      const m = motion(), el = layers[3];
      el.classList.remove('is-off'); el.setAttribute('aria-hidden', String(!on));
      el.style.transform = 'none';
      if (m.reduced) { el.style.opacity = on ? '1' : '0'; if (!on) el.classList.add('is-off'); return; }
      el.getAnimations().forEach((a) => a.cancel());
      el.animate([{ opacity: on ? 0 : 1 }, { opacity: on ? 1 : 0 }], { duration: m.morph, easing: m.ease, fill: 'forwards' }).onfinish = () => { el.style.opacity = on ? '1' : '0'; if (!on) el.classList.add('is-off'); };
    };
    function go3d(L: number) {
      if (L === 3) { cur = 3; overlay(true); host.classList.add('is-under'); labelsHost.classList.add('is-under'); hero.go(3); setStrip(3); return; }
      overlay(false); host.classList.remove('is-under'); labelsHost.classList.remove('is-under');
      cur = L; hero.go(L); setStrip(L); startBeat();
    }
    const go = (L: number) => (hero ? go3d(L) : go2d(L));
    // 3D soft reset: the scene and its words fade out, the scene goes back to its first frame unseen, and fades in.
    const fade3d = (to: number) => new Promise<void>((res) => {
      const m = motion(), els = [host, labelsHost]; let n = 0;
      els.forEach((el) => {
        el.getAnimations().forEach((a) => a.cancel());
        const a = el.animate([{ opacity: to ? 0 : 1 }, { opacity: to }], { duration: to ? m.enter : m.exit, easing: to ? m.ease : m.exitEase, fill: 'forwards' });
        a.onfinish = a.oncancel = () => { if (to) a.cancel(); if (++n === els.length) res(); };
      });
    });
    // 3D: run, hold the end frame, cross-fade home, again. Reduced motion: the end frame once, no loop.
    async function loop3d(h: any) {
      const my = ++gen, live = () => auto && my === gen;
      if (motion().reduced) { h.run(); return; }
      for (;;) {
        await whenVisible(); if (!live()) return;
        const done = await h.run(); if (!done || !live()) return;
        await wait(restFor()); await whenVisible(); if (!live()) return;
        await fade3d(0); if (!live()) { fade3d(1); return; }
        h.reset(); await fade3d(1); if (!live()) return;
      }
    }

    async function mount3d() {
      const { mountHero } = await import('../../lib/hero3d.mjs');
      const D = JSON.parse(root.querySelector<HTMLElement>('[data-hz-data]')!.textContent || '{}');
      if (!root.isConnected) return;
      const h = mountHero(host, D, {
        onReady() {
          hero = h; host.classList.add('is-on');
          // The drawn first frame gives way to the model; the drawn levels stay for the device overlay only.
          const m = motion();
          layers.forEach((el, i) => { if (i < 3) { el.setAttribute('aria-hidden', 'true'); if (m.reduced) { el.classList.add('is-off'); } else el.animate([{ opacity: 1 }, { opacity: 0 }], { duration: m.morph, easing: m.ease, fill: 'forwards' }).onfinish = () => el.classList.add('is-off'); } });
          layers[3].classList.add('is-off'); layers[3].style.opacity = '0';
          // The 2D loop (if it began) gives way to the model's; the visitor may already have taken over.
          if (auto) loop3d(h); else gen++;
        },
        onLevel(i: number, room?: any) {
          if (over) return;
          cur = i;
          if (room && room.id !== D.story.room) setStrip(2, `${room.n}: ${room.peek.replace(' · ', ', ').toLowerCase()}.`); else setStrip(i);
          if (i >= 1) startBeat();
        },
        onBeat() { startBeat(); },
        onHover(o: any) { hoverAt = o ? o.at : null; if (o) { hoverName.textContent = o.room.n; hoverState.textContent = `${o.room.t ? `${o.room.t} · ` : ''}${o.room.peek}`; } else hover.hidden = true; h.requestRender(); },
        onPick(_room: any, goThere: () => void) { stop(); overlay(false); goThere(); },
        onTouch() { stop(); },
        onFrame() { if (hoverAt) place(hover, hoverAt(), -16); },
      }, { labels: labelsHost });
    }

    btns.forEach((b, k) => b.addEventListener('click', () => { stop(); go(k); }));
    stage.addEventListener('click', () => { if (hero) return; stop(); if (cur < layers.length - 1) go2d(cur + 1); });
    root.addEventListener('keydown', (e) => {
      if (e.key === ']') { e.preventDefault(); stop(); if (cur < 3) go(cur + 1); }
      else if (e.key === '[' || e.key === 'Escape') { if (cur === 0) return; e.preventDefault(); stop(); go(cur - 1); }
    });
    stage.addEventListener('pointerdown', () => { if (!hero) stop(); }, { passive: true });
    // Light and dark: the scene reads its colours again when the page's look changes.
    matchMedia('(prefers-color-scheme: dark)').addEventListener?.('change', () => hero?.recolour());
    new MutationObserver(() => hero?.recolour()).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'data-look'] });

    if (use3d) {
      const kick = () => { mount3d().catch(() => { if (!hero && auto) loop2d(); }); };
      if ('requestIdleCallback' in window) (window as any).requestIdleCallback(kick, { timeout: 1200 }); else setTimeout(kick, 300);
    } else loop2d();
  }
  const boot = () => document.querySelectorAll<HTMLElement>('[data-hz]').forEach(init);
  boot();
  document.addEventListener('astro:page-load', boot);
</script>

<style>
  .hz {
    --dur-hero: 760ms; --dur-hero-hold: 700ms; --dur-hero-move: 1800ms; --dur-hero-lift: 1400ms; --dur-hero-rest: 3200ms;
    /* The stage follows the look: its page ground with a little of the floor in it, lit from above, and a soft glow
       from the lamps (the interior palette's, so Enterprise is cool and Studio warm; never the accent, never health). */
    --hz-bg: color-mix(in srgb, var(--bg) 86%, var(--in-slab)); --hz-light: var(--surface); --hz-glow: color-mix(in srgb, var(--in-lamp) 30%, transparent);
    /* The drawn first frame (2D): floors, corridors and desks are the interior palette's (src/lib/interior-palette.mjs);
       the room tops keep the UI's kind tints, which the key explains. */
    --hz-slab-top: var(--in-slab); --hz-slab-east: color-mix(in srgb, var(--in-slab) 78%, #000); --hz-slab-north: color-mix(in srgb, var(--in-slab) 89%, #000);
    --hz-area: var(--in-rug); --hz-corr: var(--in-corr); --hz-core: var(--in-core); --hz-desk: var(--in-oak);
    --hz-top: #FBF9F5; --hz-east: #D3CABB; --hz-north: #E5DED2; --hz-edge: rgba(28, 26, 23, .16); --hz-ground: rgba(40, 30, 15, .32);
    --hz-k-meeting: #EEF1F6; --hz-k-small: #F2EEF6; --hz-k-shared: #F8EFDF;
    display: grid; gap: 14px; min-width: 0;
  }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .hz {
    --hz-light: color-mix(in srgb, var(--surface) 70%, var(--in-slab)); --hz-glow: color-mix(in srgb, var(--in-lamp) 6%, transparent);
    --hz-top: #4A453E; --hz-east: #221F1B; --hz-north: #2E2A25; --hz-edge: rgba(255, 235, 210, .09); --hz-ground: rgba(0, 0, 0, .7);
    --hz-k-meeting: #434850; --hz-k-small: #48434F; --hz-k-shared: #4F4739;
  } }
  :root[data-theme="dark"] .hz {
    --hz-light: color-mix(in srgb, var(--surface) 70%, var(--in-slab)); --hz-glow: color-mix(in srgb, var(--in-lamp) 6%, transparent);
    --hz-top: #4A453E; --hz-east: #221F1B; --hz-north: #2E2A25; --hz-edge: rgba(255, 235, 210, .09); --hz-ground: rgba(0, 0, 0, .7);
    --hz-k-meeting: #434850; --hz-k-small: #48434F; --hz-k-shared: #4F4739;
  }

  .hz-stage {
    /* The stage takes the viewport left after the masthead, three rows of text, the caption and strip: the whole hero fits one screen. */
    position: relative; height: clamp(300px, calc(100svh - 420px), 720px); overflow: clip; border-radius: 22px; background: var(--hz-bg); cursor: zoom-in; outline: none;
    box-shadow: inset 0 0 0 1px var(--hairline);
  }
  .hz-stage.at-end { cursor: default; }
  .hz-stage:focus-visible { box-shadow: inset 0 0 0 1px var(--hairline), 0 0 0 3px var(--focus); }
  .hz-light { position: absolute; inset: 0; pointer-events: none; background:
    radial-gradient(90% 70% at 28% 8%, var(--hz-light) 0%, transparent 62%),
    radial-gradient(60% 46% at 78% 100%, var(--hz-glow) 0%, transparent 70%); }
  .hz-3d { position: absolute; inset: 0; opacity: 0; transition: opacity var(--dur-morph) var(--ease-settle); cursor: default; }
  .hz-3d.is-on { opacity: 1; }
  .hz-3d.is-under { filter: blur(6px); opacity: .55; transition: opacity var(--dur-morph) var(--ease-settle), filter var(--dur-morph) var(--ease-settle); }
  .hz-3d :global(.hz-canvas) { position: absolute; inset: 0; width: 100% !important; height: 100% !important; display: block; touch-action: pan-y; }
  .hz-layer { position: absolute; inset: 0; transform-origin: 0 0; will-change: transform, opacity; }
  .hz-layer.is-off { visibility: hidden; }
  .hz-veil { position: absolute; inset: 0; background: color-mix(in srgb, var(--hz-bg) 78%, transparent); }
  .hz-svg { display: block; width: 100%; height: 100%; font-family: var(--font-sans); position: relative; }
  .hz-ground { fill: var(--hz-ground); }
  .hz-p { stroke: var(--hz-edge); stroke-width: .8; stroke-linejoin: round; }
  .hz-slab-top { fill: var(--hz-slab-top); } .hz-slab-east { fill: var(--hz-slab-east); } .hz-slab-north { fill: var(--hz-slab-north); }
  .hz-corr { fill: var(--hz-corr); stroke: none; } .hz-core { fill: var(--hz-core); stroke: none; }
  .hz-room-top { fill: var(--hz-top); } .hz-room-east { fill: var(--hz-east); } .hz-room-north { fill: var(--hz-north); }
  .hz-room-top.hz-k-meeting { fill: var(--hz-k-meeting); } .hz-room-top.hz-k-small { fill: var(--hz-k-small); }
  .hz-room-top.hz-k-reception, .hz-room-top.hz-k-pantry, .hz-room-top.hz-k-print, .hz-room-top.hz-k-store, .hz-room-top.hz-k-comms { fill: var(--hz-k-shared); }
  .hz-room-top.hz-k-desks { fill: var(--hz-corr); }
