---
// One morning, five ideas (FRONT-DOOR-V2 section 4): the five ideas as five visual moments in the order they happen
// when a video bar fails at 07:52. Each moment is one screen: a short heading and one sentence on the left, and a
// large stage on the right whose picture moves once as it scrolls into view, then stays still.
//   07:52  the ring on the floor breaks                          Start from the building
//   07:52  the incident's fields fill themselves in             Capture, don't ask
//   07:53  Liam's Home changes one sentence and one figure       Answer first
//   08:10  the With chip slides; the record under it stays       Own it, hand it on
//   08:31  the same checklist, shorter on the fifth setup        Learn as you go
// Motion (MOTION-V2 4.37): each moment plays once on `is-on` using CSS transitions on the tokens; the floor's ring
// and the With chip are the product's own parts, changed in place by their own scripts (setSpace, setChip).
// Reduced motion: every moment is drawn in its final state; the chip's three states are listed as a row.
import IsoFloor from './IsoFloor.astro';
import WithChip from '../WithChip.astro';
import { building } from '../../lib/floors.mjs';
import { floorScene } from '../../lib/isofloor.mjs';
import { href, spaces, DEMO_TODAY } from '../../lib/data.mjs';
import { IDEAS } from '../../lib/method.mjs';

const M = building('dub');
const S = floorScene(M, '3', { width: 900, height: 500, pad: 40, rings: 'all' });
const swan = S.rings.find((r) => r.id === 'dub-3-09');
const others = Object.values(spaces).filter((s) => s.site === 'dub').length - 1;
const idea = (n) => IDEAS[n - 1];
const CHIPS = [['With Liam', 'since 08:10'], ['With Network team', 'switch config'], ['With Poly (vendor)', 'case 48812']];
const FIELDS = [
  ['Space', '3.09 Whooper Swan, third floor', 'from the space record'],
  ['Unit', 'Poly Studio X72 · dub-309-vc01', 'from Poly Lens'],
  ['Last change', 'Firmware 4.6.1, twelve days ago', 'from the change log'],
  ['Priority', 'P2, proposed from the 09:00 booking', 'from the calendar'],
];
const CHECK = ['Mount the bar under the display', 'Patch data 1 to the switch', 'Set the room name and time zone', 'Pair the touch controller', 'Set the camera framing', 'Run the audio check', 'Photograph the plate'];
const FADE = { third: [2, 6], fifth: [1, 2, 4, 6] };
const MOMENTS = [
  { t: '07:52', n: 1, line: 'The fault shows on the floor, in the space where it happened. Click the room for its kit, its bookings and its history.' },
  { t: '07:52', n: 2, line: 'The incident arrives filled in: the space, the unit, the last change, the priority from the 09:00 booking. Closing it asks one thing.' },
  { t: '07:53', n: 3, line: 'Liam’s Home changes one sentence and one figure. Nothing else on the page is red, because nothing else is broken.' },
  { t: '08:10', n: 4, line: 'One named owner at a time. The job moves whole, with its history, to a colleague, a team or a vendor. Nobody explains twice.' },
  { t: '08:31', n: 5, line: '“What fixed it?” is kept where the next person will look. On her fifth setup the checklist is shorter.' },
];
---
<ol class="mos" data-mos>
  {MOMENTS.map((mo) => (
    <li class:list={['mo', `mo-${mo.n}`]} data-mo data-shot={`idea-${mo.n}`}>
      <div class="mo-text">
        <p class="mo-time"><time>{mo.t}</time> · idea {mo.n} of 5</p>
        <h3>{idea(mo.n).name}</h3>
        <p class="mo-line-t">{mo.line}</p>
        <a class="mo-more" href={href(`/method/${idea(mo.n).slug}/`)}>Read the idea</a>
      </div>
      <div class="mo-stage" aria-hidden="true">
        <div class="mo-light"></div>
        {mo.n === 1 && (
          <div class="mo-floor">
            <IsoFloor scene={S} numbers label="The third floor, every space a ring" />
            <div class="mo-tag is-fault" style={`left:${(swan.at[0] / S.width) * 100}%; top:${(swan.at[1] / S.height) * 100}%`}><b>3.09 Whooper Swan</b><span>Fault · video bar offline · 07:52</span></div>
          </div>
        )}
        {mo.n === 2 && (
          <div class="mo-card mo-inc">
            <p class="mo-over">Incident · 3.09 Whooper Swan · 07:52</p>
            <p class="mo-h"><span class="mo-ring is-fault"></span>Video bar offline</p>
            <dl class="mo-fields">
              {FIELDS.map(([k, v, src], i) => <div style={`--i:${i}`}><dt>{k}</dt><dd><span class="mo-v">{v}</span><span class="mo-src">{src}</span></dd></div>)}
              <div class="mo-ask" style="--i:4"><dt>What fixed it?</dt><dd><span class="mo-blank"></span><span class="mo-src mo-src-ask">asked when it closes</span></dd></div>
            </dl>
          </div>
        )}
        {mo.n === 3 && (
          <div class="mo-home">
            <p class="mo-over">Home · Tuesday 30 September · Dublin office</p>
            <p class="mo-name">Liam, ready for you</p>
            <p class="mo-line"><span class="mo-x mo-s1">Dublin: {others + 1} spaces ready · checked 40 s ago</span><span class="mo-x mo-s2">1 space failing before a booking · checked 10 s ago</span></p>
            <dl class="mo-figs">
              <div><dd><span class="mo-x mo-f1">0</span><span class="mo-x mo-f2">1</span></dd><dt>ready for you</dt></div>
              <div><dd>2</dd><dt>with you</dt></div>
              <div><dd>3</dd><dt>today</dt></div>
              <div><dd>1</dd><dt>to review</dt></div>
            </dl>
            <div class="mo-day"><span style="left:4%;width:26%">Rack re-patch, IDF 3</span><span style="left:36%;width:13%">Lab test</span><span style="left:58%;width:28%">Hand over 2.02 Heron</span></div>
            <div class="mo-ready">
              <p class="mo-over">Ready for you</p>
              <p class="mo-x mo-empty">Nothing needs you.</p>
              <p class="mo-x mo-row"><span class="mo-ring is-fault"></span><b>3.09 Whooper Swan</b> · video bar offline · booked 09:00</p>
            </div>
          </div>
        )}
        {mo.n === 4 && (
          <div class="mo-card mo-own">
            <div class="mo-chip" data-mo-chip><WithChip own={{ s: 'with', to: 'liam', kind: 'person', at: `${DEMO_TODAY}T08:10:00` }} history={[{ at: `${DEMO_TODAY}T08:10:00`, text: 'Liam took it' }]} /></div>
            <ul class="mo-chips-still">{CHIPS.map(([a, b]) => <li><b>{a}</b> · {b}</li>)}</ul>
            <p class="mo-h"><span class="mo-ring is-fault"></span>Video bar offline · 3.09 Whooper Swan</p>
            <dl class="mo-rec">
              <div><dt>Known error</dt><dd>HDMI handshake after firmware 4.6.1 · used on 14 installs</dd></div>
              <div><dt>History</dt><dd>07:52 offline, from Poly Lens · 07:52 incident filled in · 08:10 with Liam</dd></div>
              <div><dt>Booked</dt><dd>09:00, 8 people · the room is held until it is fixed</dd></div>
            </dl>
            <p class="mo-quiet">The record under the chip never changes hands. Only the chip does.</p>
          </div>
        )}
        {mo.n === 5 && (
          <div class="mo-learn">
            <div class="mo-lists">
              {[['First setup', 7, []], ['Third', 5, FADE.third], ['Fifth', 3, FADE.fifth]].map(([name, n, fade]) => (
                <div class="mo-list">
                  <p class="mo-over">{name}</p>
                  <p class="mo-count"><span class="mo-x mo-c1">7</span><span class:list={['mo-x', 'mo-c2', { 'is-same': n === 7 }]}>{n}</span> <small>steps</small></p>
                  <ul>{CHECK.map((c, i) => <li class:list={{ 'is-fade': fade.includes(i) }} style={`--i:${fade.indexOf(i)}`}><span class="mo-box"></span>{c}</li>)}</ul>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </li>
  ))}
</ol>

<script>
  import { motion, onceInView } from '../../lib/motion-read.mjs';
  import { setSpace } from '../../lib/isofloor-client.mjs';
  import { chipOf } from '../../lib/ownership.mjs';
  import { setChip } from '../../lib/withchip.mjs';
  const PEOPLE = { liam: { name: 'Liam Doyle', first: 'Liam', initials: 'LD' } };
  function init(ol: HTMLElement) {
    if ((ol as any).__mos) return; (ol as any).__mos = true;
    const reduced = motion().reduced;
    const W = window as any;
    if (!W.rsWhoId) W.rsWhoId = () => 'liam';
    if (!W.RS_PEOPLE) W.RS_PEOPLE = [{ id: 'liam', name: 'Liam Doyle', initials: 'LD' }];
    ol.querySelectorAll<HTMLElement>('[data-mo]').forEach((mo) => {
      const floor = mo.querySelector<HTMLElement>('svg.ifl');
      const chipHost = mo.querySelector<HTMLElement>('[data-wc-host]');
      const on = () => {
        mo.classList.add('is-on');
        if (floor) setSpace(floor, 'dub-3-09', 'fault');
        if (chipHost && !reduced) {
          const today = chipHost.dataset.wcToday || '', m = motion();
          const to = (rec: Record<string, unknown>, hist: { at: string; text: string }[]) => { const el = chipHost.querySelector<HTMLElement>('[data-wc]'); if (el) setChip(el, chipOf(rec, null, { people: PEOPLE, today }), { history: hist }); };
          setTimeout(() => to({ s: 'with', to: 'net', kind: 'team', name: 'Network team', at: `${today}T08:14:00`, why: 'switch config' }, [{ at: '08:14', text: 'Liam handed it to the Network team' }, { at: '08:10', text: 'Liam took it' }]), m.state * 3);
          setTimeout(() => to({ s: 'with', to: 'poly', kind: 'vendor', name: 'Poly', at: `${today}T08:22:00`, why: 'case 48812' }, [{ at: '08:22', text: 'Network team handed it to Poly' }, { at: '08:14', text: 'Liam handed it to the Network team' }, { at: '08:10', text: 'Liam took it' }]), m.state * 3 + m.chip + 1400);
        }
      };
      if (reduced) { on(); return; }
      onceInView(mo, on, 0.45);
    });
  }
  const boot = () => document.querySelectorAll<HTMLElement>('[data-mos]').forEach(init);
  boot();
  document.addEventListener('astro:page-load', boot);
</script>

<style>
  .mos { list-style: none; margin: 0; padding: 0; display: grid; gap: 56px; }
  .mo { display: grid; grid-template-columns: minmax(260px, 4fr) minmax(0, 9fr); gap: 24px 40px; align-items: center; min-width: 0; }
  .mo-text { display: grid; gap: 12px; align-content: center; max-width: 34ch; }
  .mo-time { margin: 0; font-size: 13px; font-weight: 550; color: var(--text-3); font-variant-numeric: tabular-nums; }
  .mo-text h3 { margin: 0; font: 600 clamp(24px, 2.4vw, 32px)/1.12 var(--font-sans); letter-spacing: -.028em; text-wrap: balance; }
  .mo-line-t { margin: 0; font-size: 16px; line-height: 1.5; color: var(--text-2); text-wrap: pretty; }
  .mo-more { font-size: 14.5px; font-weight: 550; display: inline-flex; align-items: center; min-height: 32px; width: max-content; }
  .mo-more::after { content: " \2192"; white-space: pre; }

  /* The stage: the same warm room as the hero, the picture at its centre. */
  .mo-stage {
    --mo-bg: #EFE9DF; --mo-light: #FFFDF9; --mo-glow: rgba(226, 122, 58, .14);
    position: relative; display: grid; place-items: center; min-height: 460px; padding: 28px; border-radius: 24px; background: var(--mo-bg); box-shadow: inset 0 0 0 1px var(--hairline); overflow: clip; min-width: 0;
  }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .mo-stage { --mo-bg: #15130F; --mo-light: #2B2621; --mo-glow: rgba(238, 138, 78, .12); } }
  :root[data-theme="dark"] .mo-stage { --mo-bg: #15130F; --mo-light: #2B2621; --mo-glow: rgba(238, 138, 78, .12); }
  .mo-light { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(80% 70% at 22% 6%, var(--mo-light) 0%, transparent 62%), radial-gradient(60% 46% at 90% 100%, var(--mo-glow) 0%, transparent 70%); }
  .mo-stage > :not(.mo-light) { position: relative; }

  /* Shared picture parts */
  .mo-over { margin: 0; font-size: 12.5px; font-weight: 550; color: var(--text-3); }
  .mo-card { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; width: min(100%, 560px); padding: 24px 26px; border-radius: 18px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-lg); }
  .mo-h { margin: 0; display: flex; align-items: center; gap: 10px; font-size: 18px; font-weight: 600; letter-spacing: -.015em; }
  .mo-ring { display: inline-block; width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--quiet, var(--text-3)); flex: none; }
  .mo-ring.is-fault { border-color: var(--h-fault, var(--red)); position: relative; }
  .mo-ring.is-fault::after { content: ""; position: absolute; left: 50%; top: 50%; width: 4px; height: 4px; border-radius: 50%; background: var(--h-fault, var(--red)); transform: translate(-50%, -50%); }
  .mo-tag { position: absolute; transform: translate(-50%, -100%); display: grid; gap: 1px; padding: 8px 12px; border-radius: 10px; background: var(--surface); border: 1px solid var(--line-strong); box-shadow: var(--shadow-md); white-space: nowrap; font-size: 13px; line-height: 1.35; color: var(--text); pointer-events: none; }
  .mo-tag b { font-weight: 600; } .mo-tag span { color: var(--text-2); }
  .mo-tag.is-fault b::before { content: ""; display: inline-block; width: 8px; height: 8px; border-radius: 50%; border: 2px solid var(--h-fault, var(--red)); margin-right: 7px; vertical-align: -1px; }

  /* 1. The floor: one ring breaks, the room tints, the tag appears. */
  .mo-floor { position: relative; width: 100%; }
  .mo-floor :global(.ifl) { width: 100%; }
  .mo-1 .mo-tag { opacity: 0; transform: translate(-50%, calc(-100% - 14px)) scale(var(--pop-scale)); transition: opacity var(--dur-pop) var(--ease-settle) var(--dur-state), transform var(--dur-pop) var(--ease-settle) var(--dur-state); }
  .mo.is-on .mo-tag { opacity: 1; transform: translate(-50%, calc(-100% - 14px)) scale(1); }

  /* 2. The incident: the fields arrive, each with its source, then the one line a person is asked. */
  .mo-fields { margin: 0; display: grid; gap: 12px; }
  .mo-fields div { display: grid; grid-template-columns: 104px minmax(0, 1fr); gap: 12px; align-items: baseline; }
  .mo-fields dt { font-size: 13px; color: var(--text-3); }
  .mo-fields dd { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; font-size: 15px; font-weight: 550; }
  .mo-src { font-size: 12.5px; font-weight: 450; color: var(--text-3); }
  .mo-fields .mo-v, .mo-fields .mo-src { opacity: 0; transform: translateY(4px); transition: opacity var(--dur-state) var(--ease-settle) calc(var(--dur-state) * .8 * var(--i)), transform var(--dur-state) var(--ease-settle) calc(var(--dur-state) * .8 * var(--i)); }
  .mo.is-on .mo-fields .mo-v, .mo.is-on .mo-fields .mo-src { opacity: 1; transform: none; }
  .mo-ask dt { color: var(--text); font-weight: 550; }
  .mo-blank { display: inline-block; width: 170px; height: 1.1em; border-bottom: 2px solid var(--accent); vertical-align: -3px; }
  .mo-src-ask { color: var(--accent-ink); }

  /* 3. Home, in the dark cockpit whatever the mode: one sentence and one figure change; a row appears. */
  .mo-home { --bg: #12110F; --surface: #191816; --surface-2: #201F1C; --text: #F2EEE7; --text-2: #B5AEA3; --text-3: #978F83; --line: #2A2825; --quiet: #978F83;
    display: grid; gap: 14px; width: min(100%, 600px); padding: 24px 26px; border-radius: 18px; background: var(--bg); color: var(--text); border: 1px solid #2A2825; box-shadow: var(--shadow-lg); font-size: 14px; }
  .mo-name { margin: 0; font: 600 24px/1.15 var(--font-sans); letter-spacing: -.02em; }
  .mo-line { margin: 0; display: grid; font-size: 15px; }
  .mo-x { grid-area: 1 / 1; transition: opacity var(--dur-state) var(--ease-settle); }
  .mo-s2, .mo-f2, .mo-row { opacity: 0; }
  .mo-s2 { color: var(--h-fault-ink, #F5B1A9); font-weight: 550; }
  .mo.is-on .mo-s1, .mo.is-on .mo-f1, .mo.is-on .mo-empty { opacity: 0; }
  .mo.is-on .mo-s2, .mo.is-on .mo-f2, .mo.is-on .mo-row { opacity: 1; }
  .mo-figs { margin: 0; display: flex; gap: 28px; flex-wrap: wrap; }
  .mo-figs div { display: grid; gap: 2px; }
  .mo-figs dd { margin: 0; display: grid; font: 600 34px/1 var(--font-sans); font-variant-numeric: tabular-nums; letter-spacing: -.02em; }
  .mo-f2 { color: var(--h-fault-ink, #F5B1A9); }
  .mo-figs dt { font-size: 13px; color: var(--text-2); }
  .mo-day { position: relative; height: 28px; border-radius: 6px; background: var(--surface); border: 1px solid var(--line); }
  .mo-day span { position: absolute; top: 4px; bottom: 4px; border-radius: 4px; background: var(--surface-2); border: 1px solid #3A3733; font-size: 11px; line-height: 18px; padding: 0 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text-2); }
  .mo-ready { display: grid; gap: 6px; padding: 12px 14px; border-radius: 10px; background: var(--surface); border: 1px solid var(--line); grid-template-rows: auto auto; }
  .mo-ready p { margin: 0; }
  .mo-ready .mo-x { grid-area: auto; }
  .mo-empty, .mo-row { grid-row: 2; grid-column: 1; }
  .mo-empty { color: var(--text-3); }
  .mo-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .mo-row b { font-weight: 600; }
  .mo.is-on .mo-row { transition-delay: var(--dur-state); }

  /* 4. The chip slides, once, twice; the record under it stays. The chip is the product's own, drawn larger. */
  .mo-chip { display: flex; transform-origin: left center; transform: scale(1.3); margin-bottom: 8px; width: max-content; }
  .mo-chip :global(.wc-host), .mo-chip :global(.wc) { max-width: none; }
  .mo-chips-still { display: none; list-style: none; margin: 0; padding: 0; gap: 6px; }
  .mo-chips-still li { font-size: 13px; padding: 6px 12px; border-radius: 999px; background: var(--h-progress-soft, var(--blue-soft)); color: var(--h-progress-ink, var(--blue-ink)); width: max-content; max-width: 100%; }
  .mo-rec { margin: 0; display: grid; gap: 8px; border-top: 1px solid var(--line); padding-top: 12px; }
  .mo-rec div { display: grid; grid-template-columns: 104px minmax(0, 1fr); gap: 12px; align-items: baseline; }
  .mo-rec dt { font-size: 13px; color: var(--text-3); }
  .mo-rec dd { margin: 0; font-size: 14px; line-height: 1.45; }
  .mo-quiet { margin: 0; color: var(--text-3); font-size: 13px; }

  /* 5. The same checklist three times; the lines a fifth-timer no longer needs leave, and the figure changes. */
  .mo-learn { width: 100%; }
  .mo-lists { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .mo-list { display: grid; gap: 8px; align-content: start; padding: 18px 18px 14px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-md); min-width: 0; }
  .mo-count { margin: 0 0 4px; display: flex; align-items: baseline; gap: 6px; font: 600 30px/1 var(--font-sans); font-variant-numeric: tabular-nums; letter-spacing: -.02em; }
  .mo-count .mo-x { grid-area: auto; }
  .mo-count { display: grid; grid-template-columns: max-content max-content; justify-content: start; column-gap: 8px; }
  .mo-count .mo-c1, .mo-count .mo-c2 { grid-area: 1 / 1; }
  .mo-count small { grid-area: 1 / 2; font-size: 13px; font-weight: 500; color: var(--text-2); align-self: baseline; }
  .mo-count .mo-c2 { opacity: 0; transition-delay: calc(var(--dur-state) * 2); }
  .mo.is-on .mo-count .mo-c1 { opacity: 0; transition-delay: calc(var(--dur-state) * 2); }
  .mo.is-on .mo-count .mo-c2 { opacity: 1; }
  .mo-count .mo-c2.is-same, .mo.is-on .mo-count .mo-c2.is-same { opacity: 0; }
  .mo.is-on .mo-list:first-child .mo-c1 { opacity: 1; }
  .mo-list ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .mo-list li { display: flex; align-items: center; gap: 9px; font-size: 13.5px; line-height: 1.3; color: var(--text); max-height: 32px; padding: 5px 0; overflow: hidden; transition: opacity var(--dur-state) var(--ease-settle) calc(var(--dur-state) * .5 * var(--i, 0)), transform var(--dur-state) var(--ease-settle) calc(var(--dur-state) * .5 * var(--i, 0)), max-height var(--dur-morph) var(--ease-settle) calc(var(--dur-state) * .5 * var(--i, 0) + var(--dur-state)), padding var(--dur-morph) var(--ease-settle) calc(var(--dur-state) * .5 * var(--i, 0) + var(--dur-state)); }
  .mo-box { width: 13px; height: 13px; flex: none; border-radius: 3px; border: 1.5px solid var(--line-strong); }
  .mo.is-on .mo-list li.is-fade { opacity: 0; transform: scale(.94); max-height: 0; padding: 0; }

  @container fd (max-width: 1099px) {
    .mo { grid-template-columns: minmax(240px, 5fr) minmax(0, 8fr); gap: 20px 28px; }
    .mo-stage { min-height: 420px; padding: 22px; }
  }
  @container fd (max-width: 899px) {
    .mo { grid-template-columns: minmax(0, 1fr); gap: 18px; }
    .mo-text { max-width: 60ch; }
    .mos { gap: 48px; }
    .mo-stage { min-height: 0; }
  }
  @container fd (max-width: 559px) {
    .mo-stage { padding: 16px; border-radius: 18px; }
    .mo-card, .mo-home { padding: 18px; }
    .mo-lists { grid-template-columns: minmax(0, 1fr); }
    .mo-fields div, .mo-rec div { grid-template-columns: minmax(0, 1fr); gap: 2px; }
    .mo-tag { font-size: 11px; padding: 5px 8px; }
    .mo-chip { transform: scale(1.05); }
    .mo-figs { gap: 18px; }
    .mo-figs dd { font-size: 28px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mo *, .mo *::before, .mo *::after { transition: none !important; animation: none !important; }
    .mo-chip { display: none; } .mo-chips-still { display: grid; }
  }
</style>
