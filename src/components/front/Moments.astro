---
// One morning, five ideas (FRONT-DOOR-V2 section 4): the five ideas as five visual moments in the order they happen
// when a video bar fails at 07:52, each a picture that moves once as it scrolls into view, then stays still.
//   07:52  the ring on the plan breaks                         Start from the building
//   07:52  the incident's fields fill themselves in            Capture, don't ask
//   07:53  Liam's Home changes one sentence and one figure      Answer first
//   08:10  the With chip slides; the record under it stays      Own it, hand it on
//   08:31  the same checklist, shorter on the fifth setup       Learn as you go
// Motion (MOTION-V2 4.37): each moment plays once on `is-on` using CSS transitions on the tokens; the chip is one
// CSS animation of three steps, once. Reduced motion: every moment is drawn in its final state; the chip's three
// states are listed as a row.
import { building } from '../../lib/floors.mjs';
import { href, spaces } from '../../lib/data.mjs';
import { ringSvg } from '../../lib/ring.mjs';
import { IDEAS } from '../../lib/method.mjs';

const M = building('dub');
const F = M.floors.find((f) => f.id === '3');
const rooms = Object.values(M.rooms).filter((r) => r.floor === '3' && r.rect);
const others = Object.values(spaces).filter((s) => s.site === 'dub').length - 1;
const K = 10, PAD = 14, W = 60 * K + PAD * 2, H = 24 * K + PAD * 2;
const rc = ([x0, y0, x1, y1]) => ({ x: PAD + x0 * K, y: PAD + (24 - y1) * K, width: (x1 - x0) * K, height: (y1 - y0) * K });
const centre = (r) => [PAD + ((r.rect[0] + r.rect[2]) / 2) * K, PAD + (24 - (r.rect[1] + r.rect[3]) / 2) * K];
const ring = (state, [cx, cy], r, sw) => ringSvg(state, cx, cy, r, sw);
const swan = rooms.find((r) => r.id === 'dub-3-09');
const idea = (n) => IDEAS[n - 1];
const CHIPS = [['With Liam', 'since 08:10'], ['With Network team', 'needs a switch config change'], ['With Poly (vendor)', 'case 48812']];
const FIELDS = [
  ['Space', '3.09 Whooper Swan, third floor', 'from the space record'],
  ['Unit', 'Poly Studio X72 · dub-309-vc01', 'from Poly Lens'],
  ['Last change', 'Firmware 4.6.1, twelve days ago', 'from the change log'],
  ['Priority', 'P2, proposed from the 09:00 booking', 'from the calendar'],
];
const CHECK = ['Mount the bar under the display', 'Patch data 1 to the switch', 'Set the room name and time zone', 'Pair the touch controller', 'Set the camera framing', 'Run the audio check', 'Photograph the plate'];
const FADE = { third: [2, 6], fifth: [1, 2, 4, 6] };
const MOMENTS = [
  { t: '07:52', n: 1, line: 'The fault shows on the plan, in the space where it happened. Click the room for its kit, its bookings and its history.' },
  { t: '07:52', n: 2, line: 'The incident arrives filled in: the space, the unit, the last change, the priority from the 09:00 booking. Closing it asks one thing.' },
  { t: '07:53', n: 3, line: 'Liam’s Home changes one sentence and one figure. Nothing else on the page is red, because nothing else is broken.' },
  { t: '08:10', n: 4, line: 'One named owner at a time. The job moves whole, with its history, to a colleague, a team or a vendor. Nobody explains twice.' },
  { t: '08:31', n: 5, line: '“What fixed it?” is kept where the next person will look. On her fifth setup the checklist is shorter.' },
];
---
<ol class="mos" data-mos>
  {MOMENTS.map((mo) => (
    <li class:list={['mo', `mo-${mo.n}`]} data-mo>
      <div class="mo-pic" aria-hidden="true">
        {mo.n === 1 && (
          <svg class="mo-plan" viewBox={`0 0 ${W} ${H}`}>
            <rect class="mp-out" x={PAD} y={PAD} width={60 * K} height={24 * K} rx="6" />
            {F.corridors.map((c) => <rect class="mp-corr" {...rc(c.rect)} />)}
            {F.core.map((c) => <rect class="mp-core" {...rc(c.rect)} />)}
            {rooms.map((r) => <rect class:list={['mp-room', { 'is-hot': r.id === swan.id }]} {...rc(r.rect)} rx="3" />)}
            {rooms.map((r) => r.id === swan.id ? (
              <g class="mp-ring">
                <g class="mp-was" set:html={ring('fine', centre(r), 7, 2)} />
                <g class="mp-now" set:html={ring('fault', centre(r), 9, 2.2)} />
              </g>
            ) : <g class="mp-ring" set:html={ring('fine', centre(r), 7, 2)} />)}
          </svg>
          <div class="mo-tag is-fault" style={`left:${(centre(swan)[0] / W) * 100}%; top:${((centre(swan)[1] + 18) / H) * 100}%`}><b>3.09 Whooper Swan</b><span>Fault · video bar offline · 07:52</span></div>
        )}
        {mo.n === 2 && (
          <div class="mo-card mo-inc">
            <p class="mo-over">Incident · 3.09 Whooper Swan · 07:52</p>
            <p class="mo-h"><span class="mo-ring is-fault"></span>Video bar offline</p>
            <dl class="mo-fields">
              {FIELDS.map(([k, v, src], i) => <div style={`--i:${i}`}><dt>{k}</dt><dd><span class="mo-v">{v}</span><span class="mo-src">{src}</span></dd></div>)}
              <div class="mo-ask" style="--i:4"><dt>What fixed it?</dt><dd><span class="mo-blank"></span><span class="mo-src mo-src-ask">asked when it closes</span></dd></div>
            </dl>
          </div>
        )}
        {mo.n === 3 && (
          <div class="mo-home">
            <p class="mo-over">Home · Tuesday 30 September · Dublin office</p>
            <p class="mo-name">Liam, ready for you</p>
            <p class="mo-line"><span class="mo-x mo-s1">Dublin: {others + 1} spaces ready · checked 40 s ago</span><span class="mo-x mo-s2">1 space failing before a booking · checked 10 s ago</span></p>
            <dl class="mo-figs">
              <div><dd><span class="mo-x mo-f1">0</span><span class="mo-x mo-f2">1</span></dd><dt>ready for you</dt></div>
              <div><dd>2</dd><dt>with you</dt></div>
              <div><dd>3</dd><dt>today</dt></div>
              <div><dd>1</dd><dt>to review</dt></div>
            </dl>
            <div class="mo-day"><span style="left:6%;width:14%">Rack re-patch, IDF 3</span><span style="left:34%;width:9%">Lab test</span><span style="left:62%;width:16%">Hand over 2.02 Heron</span></div>
            <div class="mo-ready">
              <p class="mo-over">Ready for you</p>
              <p class="mo-x mo-empty">Nothing needs you.</p>
              <p class="mo-x mo-row"><span class="mo-ring is-fault"></span><b>3.09 Whooper Swan</b> · video bar offline · booked 09:00</p>
            </div>
          </div>
        )}
        {mo.n === 4 && (
          <div class="mo-card mo-own">
            <div class="mo-chip"><span class="mo-track">{CHIPS.map(([a, b]) => <span class="mo-c"><b>{a}</b> · {b}</span>)}</span></div>
            <ul class="mo-chips-still">{CHIPS.map(([a, b]) => <li><b>{a}</b> · {b}</li>)}</ul>
            <p class="mo-h"><span class="mo-ring is-fault"></span>Video bar offline · 3.09 Whooper Swan</p>
            <p class="mo-rec">Known error: HDMI handshake after firmware 4.6.1 · used on 14 installs</p>
            <p class="mo-rec">07:52 offline, from Poly Lens · 07:52 incident filled in · 08:10 with Liam</p>
            <p class="mo-rec mo-quiet">The record under the chip never changes.</p>
          </div>
        )}
        {mo.n === 5 && (
          <div class="mo-lists">
            {[['First setup', []], ['Third', FADE.third], ['Fifth', FADE.fifth]].map(([name, fade]) => (
              <div class="mo-list">
                <p class="mo-over">{name}</p>
                <ul>{CHECK.map((c, i) => <li class:list={{ 'is-fade': fade.includes(i) }} style={`--i:${fade.indexOf(i)}`}><span class="mo-box"></span>{c}</li>)}</ul>
              </div>
            ))}
          </div>
        )}
      </div>
      <div class="mo-text">
        <p class="mo-time"><time>{mo.t}</time></p>
        <h3><span class="mo-n">{mo.n}</span>{idea(mo.n).name}</h3>
        <p class="mo-line-t">{mo.line}</p>
        <a class="mo-more" href={href(`/method/${idea(mo.n).slug}/`)}>Read the idea</a>
      </div>
    </li>
  ))}
</ol>

<script>
  import { motion, onceInView } from '../../lib/motion-read.mjs';
  function init(ol: HTMLElement) {
    if ((ol as any).__mos) return; (ol as any).__mos = true;
    const reduced = motion().reduced;
    ol.querySelectorAll<HTMLElement>('[data-mo]').forEach((mo) => {
      if (reduced) { mo.classList.add('is-on'); return; }
      onceInView(mo, () => mo.classList.add('is-on'), 0.45);
    });
  }
  const boot = () => document.querySelectorAll<HTMLElement>('[data-mos]').forEach(init);
  boot();
  document.addEventListener('astro:page-load', boot);
</script>

<style>
  .mos { list-style: none; margin: 0; padding: 0; display: grid; gap: 72px; }
  .mo { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 24px 56px; align-items: center; min-width: 0; }
  .mo:nth-child(even) .mo-pic { order: 2; }
  .mo-pic { position: relative; min-width: 0; }
  .mo-text { display: grid; gap: 10px; align-content: center; max-width: 40ch; }
  .mo-time { margin: 0; font: 500 12.5px/1.4 var(--font-mono); color: var(--text-3); font-variant-numeric: tabular-nums; }
  .mo-text h3 { margin: 0; font: 600 clamp(20px, 2vw, 26px)/1.2 var(--font-sans); letter-spacing: -.02em; display: flex; align-items: baseline; gap: 12px; }
  .mo-n { font: 500 13px/1 var(--font-mono); color: var(--accent-ink); }
  .mo-line-t { margin: 0; font-size: 15.5px; line-height: 1.5; color: var(--text-2); }
  .mo-more { font-size: 14px; font-weight: 550; display: inline-flex; align-items: center; min-height: 32px; width: max-content; }
  .mo-more::after { content: " \2192"; white-space: pre; }

  /* Shared picture parts */
  .mo-over { margin: 0; font: 500 10.5px/1.2 var(--font-mono); letter-spacing: .09em; text-transform: uppercase; color: var(--text-3); }
  .mo-card { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; padding: 20px 22px; border-radius: 14px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-md); }
  .mo-h { margin: 0; display: flex; align-items: center; gap: 9px; font-size: 15px; font-weight: 600; letter-spacing: -.01em; }
  .mo-ring { display: inline-block; width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--quiet, var(--text-3)); flex: none; }
  .mo-ring.is-fault { border-color: var(--h-fault, var(--red)); position: relative; }
  .mo-ring.is-fault::after { content: ""; position: absolute; left: 50%; top: 50%; width: 3px; height: 3px; border-radius: 50%; background: var(--h-fault, var(--red)); transform: translate(-50%, -50%); }
  .mo-tag { position: absolute; transform: translate(-50%, -100%); display: grid; gap: 1px; padding: 7px 11px; border-radius: 10px; background: var(--surface); border: 1px solid var(--line-strong); box-shadow: var(--shadow-md); white-space: nowrap; font-size: 12.5px; line-height: 1.35; color: var(--text); pointer-events: none; }
  .mo-tag b { font-weight: 600; } .mo-tag span { color: var(--text-2); }
  .mo-tag.is-fault b::before { content: ""; display: inline-block; width: 8px; height: 8px; border-radius: 50%; border: 2px solid var(--h-fault, var(--red)); margin-right: 7px; vertical-align: -1px; }

  /* 1. The plan: one ring breaks, the room tints, the tag appears. */
  .mo-plan { display: block; width: 100%; height: auto; border-radius: 14px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-md); padding: 8px; box-sizing: border-box; }
  .mp-out { fill: var(--bg); stroke: var(--line-strong); stroke-width: 1.5; }
  .mp-corr { fill: var(--surface-2); } .mp-core { fill: var(--surface-3); }
  .mp-room { fill: var(--surface); stroke: var(--line-strong); stroke-width: 1.2; transition: fill var(--dur-state) var(--ease-settle); }
  .mo.is-on .mp-room.is-hot { fill: color-mix(in srgb, var(--h-fault, var(--red)) 14%, var(--surface)); }
  .mp-ring { color: var(--quiet, var(--text-3)); }
  .mp-ring [fill="none"] { stroke: currentColor; }
  .mp-now { color: var(--h-fault, var(--red)); opacity: 0; transition: opacity var(--dur-state) var(--ease-settle); }
  .mp-was { opacity: 1; transition: opacity var(--dur-state) var(--ease-settle); }
  .mo.is-on .mp-now { opacity: 1; } .mo.is-on .mp-was { opacity: 0; }
  .mo-1 .mo-tag { opacity: 0; transform: translate(-50%, 0) scale(var(--pop-scale)); transition: opacity var(--dur-pop) var(--ease-settle) var(--dur-state), transform var(--dur-pop) var(--ease-settle) var(--dur-state); }
  .mo.is-on .mo-tag { opacity: 1; transform: translate(-50%, 0) scale(1); }

  /* 2. The incident: the fields arrive, each with its source, then the one line a person is asked. */
  .mo-fields { margin: 0; display: grid; gap: 10px; }
  .mo-fields div { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 12px; align-items: baseline; }
  .mo-fields dt { font-size: 12.5px; color: var(--text-3); }
  .mo-fields dd { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; font-size: 14px; font-weight: 550; }
  .mo-src { font: 500 11px/1.4 var(--font-mono); color: var(--quiet, var(--text-3)); }
  .mo-fields .mo-v, .mo-fields .mo-src { opacity: 0; transform: translateY(4px); transition: opacity var(--dur-state) var(--ease-settle) calc(var(--dur-state) * .7 * var(--i)), transform var(--dur-state) var(--ease-settle) calc(var(--dur-state) * .7 * var(--i)); }
  .mo.is-on .mo-fields .mo-v, .mo.is-on .mo-fields .mo-src { opacity: 1; transform: none; }
  .mo-ask dt { color: var(--text); font-weight: 550; }
  .mo-blank { display: inline-block; width: 150px; height: 1.1em; border-bottom: 2px solid var(--accent); vertical-align: -3px; }
  .mo-src-ask { color: var(--accent-ink); }

  /* 3. Home, in the dark cockpit whatever the mode: one sentence and one figure change; a row appears. */
  .mo-home { --bg: #12110F; --surface: #191816; --surface-2: #201F1C; --text: #F2EEE7; --text-2: #B5AEA3; --text-3: #978F83; --line: #2A2825; --quiet: #978F83;
    display: grid; gap: 12px; padding: 20px 22px; border-radius: 14px; background: var(--bg); color: var(--text); border: 1px solid #2A2825; box-shadow: var(--shadow-md); font-size: 13.5px; }
  .mo-name { margin: 0; font: 600 20px/1.15 var(--font-sans); letter-spacing: -.02em; }
  .mo-line { margin: 0; display: grid; font-size: 13.5px; }
  .mo-x { grid-area: 1 / 1; transition: opacity var(--dur-state) var(--ease-settle); }
  .mo-s2, .mo-f2, .mo-row { opacity: 0; }
  .mo-s2 { color: var(--h-fault-ink, #F5B1A9); font-weight: 550; }
  .mo.is-on .mo-s1, .mo.is-on .mo-f1, .mo.is-on .mo-empty { opacity: 0; }
  .mo.is-on .mo-s2, .mo.is-on .mo-f2, .mo.is-on .mo-row { opacity: 1; }
  .mo-figs { margin: 0; display: flex; gap: 22px; flex-wrap: wrap; }
  .mo-figs div { display: grid; gap: 2px; }
  .mo-figs dd { margin: 0; display: grid; font: 600 24px/1 var(--font-sans); font-variant-numeric: tabular-nums; letter-spacing: -.01em; }
  .mo-f2 { color: var(--h-fault-ink, #F5B1A9); }
  .mo-figs dt { font-size: 12.5px; color: var(--text-2); }
  .mo-day { position: relative; height: 26px; border-radius: 6px; background: var(--surface); border: 1px solid var(--line); }
  .mo-day span { position: absolute; top: 4px; bottom: 4px; border-radius: 4px; background: var(--surface-2); border: 1px solid #3A3733; font-size: 10.5px; line-height: 16px; padding: 0 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text-2); }
  .mo-ready { display: grid; gap: 6px; padding: 12px 14px; border-radius: 8px; background: var(--surface); border: 1px solid var(--line); }
  .mo-ready p { margin: 0; }
  .mo-ready .mo-x { grid-area: auto; }
  .mo-ready { grid-template-rows: auto auto; }
  .mo-empty, .mo-row { grid-row: 2; grid-column: 1; }
  .mo-empty { color: var(--text-3); }
  .mo-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .mo-row b { font-weight: 600; }
  .mo.is-on .mo-row { transition-delay: var(--dur-state); }

  /* 4. The chip slides, once; the record under it stays. */
  .mo-chip { display: block; height: 30px; overflow: hidden; border-radius: 999px; background: var(--h-progress-soft, var(--blue-soft)); color: var(--h-progress-ink, var(--blue-ink)); width: max-content; max-width: 100%; min-width: 0; }
  .mo-track { display: block; }
  .mo.is-on .mo-track { animation: mo-chip calc(var(--dur-chip) * 8) var(--ease-settle) forwards; }
  @keyframes mo-chip { 0%, 30% { transform: translateY(0); } 42%, 66% { transform: translateY(-30px); } 78%, 100% { transform: translateY(-60px); } }
  .mo-c { display: block; height: 30px; line-height: 30px; padding: 0 14px; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mo-c b { font-weight: 600; }
  .mo-chips-still { display: none; list-style: none; margin: 0; padding: 0; gap: 6px; }
  .mo-chips-still li { font-size: 13px; padding: 5px 12px; border-radius: 999px; background: var(--h-progress-soft, var(--blue-soft)); color: var(--h-progress-ink, var(--blue-ink)); width: max-content; max-width: 100%; }
  .mo-rec { margin: 0; font-size: 13.5px; color: var(--text-2); }
  .mo-quiet { color: var(--text-3); font-size: 12.5px; }

  /* 5. The same checklist three times; the lines a fifth-timer no longer needs leave. */
  .mo-lists { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .mo-list { display: grid; gap: 10px; align-content: start; padding: 16px 16px 12px; border-radius: 14px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-md); min-width: 0; }
  .mo-list ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .mo-list li { display: flex; align-items: center; gap: 8px; font-size: 12px; line-height: 1.3; color: var(--text); max-height: 30px; padding: 4px 0; overflow: hidden; transition: opacity var(--dur-state) var(--ease-settle) calc(var(--dur-state) * .5 * var(--i, 0)), transform var(--dur-state) var(--ease-settle) calc(var(--dur-state) * .5 * var(--i, 0)), max-height var(--dur-morph) var(--ease-settle) calc(var(--dur-state) * .5 * var(--i, 0) + var(--dur-state)), padding var(--dur-morph) var(--ease-settle) calc(var(--dur-state) * .5 * var(--i, 0) + var(--dur-state)); }
  .mo-box { width: 12px; height: 12px; flex: none; border-radius: 3px; border: 1.5px solid var(--line-strong); }
  .mo.is-on .mo-list li.is-fade { opacity: 0; transform: scale(.94); max-height: 0; padding: 0; }

  @container fd (max-width: 899px) {
    .mo { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .mo:nth-child(even) .mo-pic { order: 0; }
    .mo-text { max-width: 60ch; }
    .mos { gap: 56px; }
  }
  @container fd (max-width: 559px) {
    .mo-lists { grid-template-columns: minmax(0, 1fr); }
    .mo-fields div { grid-template-columns: minmax(0, 1fr); gap: 2px; }
    .mo-tag { font-size: 11px; padding: 5px 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mo *, .mo *::before, .mo *::after { transition: none !important; animation: none !important; }
    .mo-chip { display: none; } .mo-chips-still { display: grid; }
  }
</style>
