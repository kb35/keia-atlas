  .fx-step .fx-n { grid-row: 1 / span 2; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; font: 600 13px/1 var(--font-sans); font-variant-numeric: tabular-nums; color: var(--text-2); border: 1.5px solid var(--line-strong); }
