---
// Fix it yourself (the front door, after the hero finds the fault): the incident the hero found, in the product's
// own interface at showcase scale, and five steps the visitor takes, one click each. Take it · Check remotely ·
// Fix (a standing rule, with "How was this done?") · Verify (a test call) · Close ("What fixed it?" pre-filled).
// The record beside it logs every step as it happens (time, who, what, source), the glyph and the With chip change
// in place, and the floor's one broken ring closes. Self-contained: no backend, no state kept.
// Every step is a button, clickable at any time: clicking one makes the steps before it complete quickly, in order,
// and that step the current one; a thin line under the steps shows how far the fix has got. Left alone, the section
// plays itself (src/lib/front-loop.mjs): step by step, into the resolved frame, a calm hold, a soft reset, and again.
// A click, a hover or focus yields to the visitor; after about eight seconds idle it carries on from where they left it.
//
// One stage, one screen at 1440 x 900: the incident card with the product drawing on the left, the record and the
// floor on the right, the five clicks along the bottom. Motion (docs/rules/motion.md): each step changes
// exactly the things it changed, once: the chip's words slide (--dur-chip), the glyph's state eases in place
// (--dur-state), a new entry grows at its centre (--dur-enter), the ring closes. Reduced motion: every change at once.
// Skipping Verify and closing anyway is allowed and honest: the close reads "Unable to complete: not verified".
import HealthGlyph from '../HealthGlyph.astro';
import WithChip from '../WithChip.astro';
import DeviceArt from '../DeviceArt.astro';
import IsoFloor from './IsoFloor.astro';
import { building } from '../../lib/floors.mjs';
import { floorScene } from '../../lib/isofloor.mjs';
import { href, DEMO_TODAY } from '../../lib/data.mjs';

const M = building('dub');
const S = floorScene(M, '3', { width: 640, height: 330, pad: 26, rings: 'all' });
const nRooms = S.rings.length;
const STEPS = [
  { id: 'take', n: 1, verb: 'Take it', what: 'It becomes yours until the room works.' },
  { id: 'check', n: 2, verb: 'Check remotely', what: 'The unit’s status and last change, from your desk.' },
  { id: 'fix', n: 3, verb: 'Restart the bar', what: 'A standing rule runs it. It can be put back.' },
  { id: 'verify', n: 4, verb: 'Run a test call', what: 'Prove it: the call, the camera, the audio.' },
  { id: 'close', n: 5, verb: 'Close', what: 'One question, pre-filled from what you did.' },
];
---
<section class="fx" id="fix" data-fx data-shot="fix" aria-labelledby="fx-h" data-rooms={nRooms}>
  <header class="fd-head">
    <p class="fd-eyebrow">One morning</p>
    <h2 id="fx-h">Fix it</h2>
    <p class="fd-sub">The fault the hero found, as Liam sees it. Five clicks, every one on the record; take each step yourself. Simulated: the room, the unit and the fault are made up.</p>
  </header>

  <div class="fx-stage">
    <div class="fx-light" aria-hidden="true"></div>
    <ol class="fx-do" aria-label="Five clicks: press any step to go to it" data-fx-steps>
      {STEPS.map((s, i) => <li><button type="button" class="fx-step" data-fx-step={s.id} data-k={i} aria-current="false" title={`Go to step ${s.n}: ${s.verb}`}><span class="fx-n">{s.n}</span><b>{s.verb}</b><small>{s.what}</small></button></li>)}
    </ol>
    <div class="fx-progress" aria-hidden="true"><i data-fx-progress></i></div>
    <article class="fx-inc" aria-labelledby="fx-t">
      <p class="fx-over"><span>Incident · P2</span><span class="fx-src">from Poly Lens, 07:52</span></p>
      <h3 id="fx-t" class="fx-title"><HealthGlyph state="fault" size={40} title="video bar offline since 07:52" class="fx-glyph lit" /><span>Video bar offline<small>3.09 Whooper Swan · third floor</small></span></h3>
      <p class="fx-answer" data-fx-answer aria-live="polite">Offline since 07:52. Booked 09:00, 8 people.</p>
      <div class="fx-with" data-fx-with aria-live="polite">
        <WithChip own={{ s: 'ready', to: 'liam', kind: 'person', at: `${DEMO_TODAY}T07:52:00` }} history={[{ at: `${DEMO_TODAY}T07:52:00`, text: 'Offered to Liam by the record' }]} />
      </div>
      <dl class="fx-facts">
        <div><dt>Unit</dt><dd>Poly Studio X72 · dub-309-vc01 <span class="fx-src">from the build sheet</span></dd></div>
        <div><dt>Last change</dt><dd>Firmware 4.6.1 · 02:10 today <span class="fx-src">from the change log</span></dd></div>
        <div class="fx-fact-hid" data-fx-fact="check"><dt>Status</dt><dd>Reachable; the codec is not responding <span class="fx-src">read at <span data-fx-now>08:11</span></span></dd></div>
        <div class="fx-fact-hid" data-fx-fact="check"><dt>Known error</dt><dd>Codec hang after firmware 4.6.x · used on 14 installs <span class="fx-src">matched from the last change</span></dd></div>
        <div class="fx-fact-hid" data-fx-fact="fix"><dt>Done automatically</dt><dd>Restarted · under the restart rule (owner: Nora) <button type="button" class="fx-how" data-fx-how aria-expanded="false">How was this done?</button></dd></div>
        <div class="fx-fact-hid fx-howcard" data-fx-fact="how" hidden><dt></dt><dd>The rule read the unit from the build sheet, sent a restart over its management port, waited 40 s and read the status back. Roll back returns the unit to how it was.</dd></div>
        <div class="fx-fact-hid" data-fx-fact="verify"><dt>Test</dt><dd>Test call connected · camera and audio fine <span class="fx-src">read at <span data-fx-now2>08:13</span></span></dd></div>
        <div class="fx-fact-hid fx-ask" data-fx-fact="ask"><dt>What fixed it?</dt><dd><span class="fx-answer-box" data-fx-what>Restart under the restart rule; codec hang after firmware 4.6.x.</span></dd></div>
      </dl>
      <div class="fx-art" aria-hidden="true"><DeviceArt model="poly-studio-x72" label="" /><span class="fx-art-cap">The unit: Poly Studio X72</span></div>
      <p class="fx-done" data-fx-done hidden><b>Resolved.</b> Every step is on the record, with who did it and where each fact came from. <a href={href('/')} data-as="liam">Open the full demo</a> or <a href={href('/method/')}>read the method</a>.</p>
    </article>

    <aside class="fx-side">
      <section class="fx-log" aria-labelledby="fx-log-h">
        <h4 id="fx-log-h" class="fx-h4">The record</h4>
        <ol class="fx-entries" data-fx-log aria-live="polite">
          <li><time>07:52</time><span><b>Offline</b> · video bar</span><small>from Poly Lens</small></li>
          <li><time>07:52</time><span><b>Incident opened</b>, filled in: space, unit, last change, priority</span><small>by the record</small></li>
        </ol>
      </section>
      <section class="fx-plan-box" aria-label="Third floor">
        <p class="fx-h4"><span data-fx-plan-cap>Third floor · {nRooms} spaces · 1 fault</span> <span class="fx-beat" data-fx-beat>checked just now</span></p>
        <IsoFloor scene={S} states={{ 'dub-3-09': 'fault' }} label="The third floor: every space a ring, 3.09 broken" />
      </section>
    </aside>

  </div>
</section>

<script>
  import { motion } from '../../lib/motion-read.mjs';
  import { setGlyph } from '../../lib/health.mjs';
  import { chipOf } from '../../lib/ownership.mjs';
  import { setChip } from '../../lib/withchip.mjs';
  import { setSpace } from '../../lib/isofloor-client.mjs';
  import { loop, clock as loopClock } from '../../lib/front-loop.mjs';

  const ORDER = ['take', 'check', 'fix', 'verify', 'close'];
  const PEOPLE = { liam: { name: 'Liam', first: 'Liam', initials: 'L' }, nora: { name: 'Nora', first: 'Nora', initials: 'N' } };
  const clock = (mins: number) => { const t = 8 * 60 + 10 + mins; return `${String(Math.floor(t / 60)).padStart(2, '0')}:${String(t % 60).padStart(2, '0')}`; };

  function init(root: HTMLElement) {
    if ((root as any).__fx) return; (root as any).__fx = true;
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const steps = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-fx-step]'));
    const log = q<HTMLOListElement>('[data-fx-log]'), answer = q('[data-fx-answer]'), progress = q('[data-fx-progress]');
    const nRooms = root.dataset.rooms || '';
    // The With chip (WithChip.astro), drawn for Liam as the viewer: "Ready for you", then "With you", then "Done".
    const chipHost = q('[data-wc-host]'), today = chipHost.dataset.wcToday || '';
    const own = (s: string, at: string, extra: Record<string, unknown> = {}) => ({ s, to: 'liam', kind: 'person', at: `${today}T${at}:00`, ...extra });
    const chipTo = (rec: Record<string, unknown>, history?: { at: string; text: string }[]) => { const el = chipHost.querySelector<HTMLElement>('[data-wc]'); if (el) setChip(el, chipOf(rec, 'liam', { people: PEOPLE, today }), history ? { history } : {}); };
    const history: { at: string; text: string }[] = [{ at: '07:52', text: 'Offered to you by the record' }];
    // The front door has no Shell, so WithChip's own script is told who is looking: Liam, the Dublin technician.
    const W = window as any;
    if (!W.rsWhoId) W.rsWhoId = () => 'liam';
    if (!W.RS_PEOPLE) W.RS_PEOPLE = [{ id: 'liam', name: 'Liam Doyle', initials: 'LD' }, { id: 'nora', name: 'Nora', initials: 'N' }];
    chipTo(own('ready', '07:52'), history);
    setTimeout(() => chipTo(own('ready', '07:52'), history), 0);
    const glyph = q('.fx-glyph'), floor = q('svg.ifl'), planCap = q('[data-fx-plan-cap]'), beat = q('[data-fx-beat]');
    const done = q('[data-fx-done]'), how = q<HTMLButtonElement>('[data-fx-how]'), howCard = q('[data-fx-fact="how"]');
    const facts = (id: string) => Array.from(root.querySelectorAll<HTMLElement>(`[data-fx-fact="${id}"]`));
    const firstLog = log.innerHTML, firstAnswer = answer.textContent;
    let i = 0, lp: ReturnType<typeof loop> | null = null;
    const clk = loopClock();
    const later = (ms: number, fn: () => void) => { clk.later(ms, fn); };
    const clearTimers = () => clk.clear();

    const entry = (t: string, what: string, src: string, quick = false) => {
      const li = document.createElement('li');
      li.innerHTML = `<time>${t}</time><span>${what}</span><small>${src}</small>`;
      log.appendChild(li);
      const m = motion();
      if (!m.reduced && !quick) li.animate([{ opacity: 0, transform: 'scale(.94)' }, { opacity: 1, transform: 'none' }], { duration: m.enter, easing: m.ease });
    };
    const reveal = (id: string) => facts(id).forEach((f) => { f.hidden = false; f.classList.add('is-in'); });
    // The steps: done ones ticked, the current one filled, the line under them at how far the fix has got.
    const paint = () => {
      steps.forEach((b, k) => { b.classList.toggle('is-done', k < i - 1 || (k === i - 1 && i === ORDER.length)); b.classList.toggle('is-current', k === i - 1); b.setAttribute('aria-current', k === i - 1 ? 'step' : 'false'); });
      progress.style.transform = `scaleX(${i / ORDER.length})`;
    };
    const act: Record<string, (quick: boolean) => void> = {
      take(quick) { history.unshift({ at: clock(0), text: 'You took it' }); chipTo(own('with', clock(0)), history); entry(clock(0), '<b>With Liam</b>', 'by Liam', quick); answer.textContent = 'With you. Offline since 07:52; booked 09:00, 8 people.'; },
      check(quick) { root.querySelector('[data-fx-now]')!.textContent = clock(1); reveal('check'); entry(clock(1), '<b>Checked remotely</b>: reachable, codec not responding; known error matched', 'from the unit and the change log', quick); answer.textContent = 'The codec is not responding after a firmware change at 02:10. A known error matches.'; },
      fix(quick) {
        reveal('fix'); setGlyph(glyph, 'progress', { title: 'restarting, read back in 40 s' }); setSpace(floor, 'dub-3-09', 'progress');
        entry(clock(2), '<b>Done automatically</b> · restarted under the restart rule (owner: Nora)', 'by the rule, for Liam', quick);
        answer.textContent = 'Restarting. Read back in 40 s.';
        const back = () => { setGlyph(glyph, 'fine', { title: 'in service again' }); answer.textContent = 'Back in service. Not yet verified.'; };
        // Skipping ahead (or with motion off), the read-back lands now, so a later step's words are never overwritten.
        if (quick || motion().reduced) back(); else later(900, back);
      },
      verify(quick) { root.querySelector('[data-fx-now2]')!.textContent = clock(3); reveal('verify'); entry(clock(3), '<b>Test call connected</b> · camera and audio fine', 'from the test', quick); answer.textContent = 'Verified: test call connected, camera and audio fine.'; },
      close(quick) {
        reveal('ask'); history.unshift({ at: clock(4), text: 'You resolved it' }); chipTo(own('done', clock(4)), history);
        entry(clock(4), '<b>Resolved</b> · what fixed it: restart under the restart rule; codec hang after firmware 4.6.x', 'by Liam · kept on the known error, now used on 15', quick);
        answer.textContent = 'Resolved in 24 min, before the 09:00 booking.';
        setSpace(floor, 'dub-3-09', 'fine'); planCap.textContent = `Third floor · all ${nRooms} spaces fine`;
        done.hidden = false;
        const m = motion(); if (!m.reduced && !quick) done.animate([{ opacity: 0, transform: 'scale(.97)' }, { opacity: 1, transform: 'none' }], { duration: m.enter, easing: m.ease });
      },
    };
    const doStep = (k: number, quick = false) => { act[ORDER[k]](quick); i = k + 1; paint(); };
    // Back to 07:52: the incident as it arrived, nothing done yet.
    const reset = () => {
      clearTimers(); i = 0;
      log.innerHTML = firstLog; answer.textContent = firstAnswer;
      root.querySelectorAll<HTMLElement>('.fx-fact-hid').forEach((f) => { f.classList.remove('is-in'); if (f.dataset.fxFact === 'how') f.hidden = true; });
      how.setAttribute('aria-expanded', 'false');
      setGlyph(glyph, 'fault', { title: 'video bar offline since 07:52' }); setSpace(floor, 'dub-3-09', 'fault');
      planCap.textContent = `Third floor · ${nRooms} spaces · 1 fault`; done.hidden = true;
      history.length = 0; history.push({ at: '07:52', text: 'Offered to you by the record' }); chipTo(own('ready', '07:52'), history);
      paint();
    };
    // Go to step k: the steps before it complete quickly, in order; k itself at its own pace. Going back rewinds first.
    const goTo = (k: number) => {
      clearTimers();
      if (k < i) { root.classList.add('fd-resetting'); reset(); void root.offsetWidth; root.classList.remove('fd-resetting'); }
      let t = 0;
      for (let s = i; s < k; s++) { const at = s; later(t, () => doStep(at, true)); t += 200; }
      later(t, () => doStep(k));
    };
    // Left alone: from wherever it is to the end, one step at a time.
    const play = () => {
      const gap = 1700; let t = 700;
      for (let s = i; s < ORDER.length; s++) { const at = s; later(t, () => doStep(at)); t += gap; }
      return Math.max(0, t - gap + 900 + motion().enter);
    };
    const yieldTo = () => lp?.pause(8000);
    const list = q('[data-fx-steps]');
    list.addEventListener('pointerenter', yieldTo);
    list.addEventListener('focusin', yieldTo);
    steps.forEach((b, k) => b.addEventListener('click', () => { yieldTo(); goTo(k); }));
    // Arrow keys move between the steps; Enter and Space press them, as buttons do.
    list.addEventListener('keydown', (e) => {
      const at = steps.indexOf(document.activeElement as HTMLButtonElement); if (at < 0) return;
      const to = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? at + 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? at - 1 : e.key === 'Home' ? 0 : e.key === 'End' ? steps.length - 1 : -1;
      if (to < 0 || to >= steps.length) return;
      e.preventDefault(); steps[to].focus();
    });
    how.addEventListener('click', () => { yieldTo(); const open = how.getAttribute('aria-expanded') === 'true'; how.setAttribute('aria-expanded', String(!open)); howCard.classList.add('is-in'); howCard.hidden = open; if (!open) { const m = motion(); if (!m.reduced) howCard.animate([{ opacity: 0, transform: 'scale(.96)' }, { opacity: 1, transform: 'none' }], { duration: m.pop, easing: m.ease }); } });
    // The heartbeat: words that change every 10 s.
    const t0 = Date.now();
    const tick = () => { if (!root.isConnected) return; const s = Math.round((Date.now() - t0) / 10000) * 10; beat.textContent = s < 10 ? 'checked just now' : s < 60 ? `checked ${s} s ago` : `checked ${Math.floor(s / 60)} min ago`; setTimeout(tick, 10000); };
    setTimeout(tick, 10000);
    paint();
    // Reduced motion: the finished frame, drawn after the chip's first paint above so the record's last state wins.
    if (motion().reduced) { setTimeout(() => { for (let s = 0; s < ORDER.length; s++) doStep(s, true); }, 0); return; }
    lp = loop(q('.fx-stage'), { play, reset, hold: 3200, clock: clk, finish: () => { clearTimers(); for (let s = i; s < ORDER.length; s++) doStep(s, true); } });
  }
  const boot = () => document.querySelectorAll<HTMLElement>('[data-fx]').forEach(init);
  boot();
  document.addEventListener('astro:page-load', boot);
</script>

<style>
  .fx { display: grid; gap: 22px; }
  .fx-stage {
    --fx-bg: #EFE9DF; --fx-light: #FFFDF9; --fx-glow: rgba(226, 122, 58, .14);
    position: relative; display: grid; grid-template-columns: minmax(0, 7fr) minmax(300px, 4fr); grid-template-rows: auto auto auto; gap: 18px 24px; padding: 22px 28px 24px; border-radius: 24px;
    background: var(--fx-bg); box-shadow: inset 0 0 0 1px var(--hairline); overflow: clip; align-items: start;
  }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .fx-stage { --fx-bg: #15130F; --fx-light: #2B2621; --fx-glow: rgba(238, 138, 78, .12); } }
  :root[data-theme="dark"] .fx-stage { --fx-bg: #15130F; --fx-light: #2B2621; --fx-glow: rgba(238, 138, 78, .12); }
  .fx-light { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(80% 70% at 22% 6%, var(--fx-light) 0%, transparent 62%), radial-gradient(60% 46% at 90% 100%, var(--fx-glow) 0%, transparent 70%); }

  .fx-inc { position: relative; display: grid; gap: 12px; padding: 22px 24px 20px; border-radius: 18px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-md); min-width: 0; align-self: stretch; align-content: start; }
  .fx-art { position: absolute; right: 24px; top: 176px; width: 38%; max-width: 300px; display: grid; gap: 6px; justify-items: center; pointer-events: none; }
  .fx-art :global(svg) { width: 100%; height: auto; display: block; }
  .fx-art-cap { font-size: 12px; color: var(--text-3); }
  .fx-over { margin: 0; display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: 13px; font-weight: 550; color: var(--text-3); }
  .fx-src { font-size: 12px; font-weight: 450; color: var(--text-3); }
  .fx-title { margin: 0; display: flex; align-items: center; gap: 14px; font: 600 clamp(20px, 2vw, 26px)/1.12 var(--font-sans); letter-spacing: -.025em; }
  .fx-title small { display: block; margin-top: 3px; font-size: 14px; font-weight: 500; color: var(--text-2); letter-spacing: 0; }
  .fx-answer { margin: 0; font-size: 16px; line-height: 1.4; }
  .fx-with { display: flex; }
  .fx-with :global(.wc) { height: 30px; font-size: 13px; }
  .fx-facts { margin: 0; display: grid; gap: 9px; border-top: 1px solid var(--line); padding-top: 12px; width: 56%; }
  .fx-facts div { display: grid; grid-template-columns: calc(96px * var(--rs-text, 1)) minmax(0, 1fr); gap: 2px 12px; align-items: baseline; min-width: 0; }
  .fx-facts dt { font-size: 12.5px; color: var(--text-3); }
  .fx-facts dd { margin: 0; font-size: 13.5px; font-weight: 550; display: flex; flex-wrap: wrap; gap: 2px 8px; align-items: baseline; line-height: 1.4; }
  .fx-facts .fx-fact-hid:not(.is-in), .fx-facts .fx-fact-hid[hidden] { display: none; }
  .fx-facts .fx-fact-hid.is-in { animation: fx-in var(--dur-enter) var(--ease-settle) both; }
  @keyframes fx-in { from { opacity: 0; transform: translateY(4px); } }
  .fx-how { font: 550 12.5px/1 var(--font-sans); color: var(--accent-ink); background: none; border: 0; padding: 4px 0; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; min-height: 28px; }
  .fx-howcard dd { font-weight: 400; font-size: 13px; color: var(--text-2); padding: 10px 12px; border-radius: 8px; background: var(--surface-2); }
  .fx-ask dt { color: var(--text); font-weight: 550; }
  .fx-answer-box { padding: 6px 10px; border-radius: 6px; border: 1px solid var(--line-strong); background: var(--bg); font-weight: 500; }
  .fx-done { margin: 0; width: 56%; font-size: 14px; line-height: 1.5; padding: 12px 14px; border-radius: 10px; background: var(--h-fine-soft, var(--green-soft)); color: var(--h-fine-ink, var(--green-ink)); }
  .fx-done a { color: inherit; font-weight: 600; }

  .fx-side { display: grid; gap: 14px; min-width: 0; align-self: stretch; grid-template-rows: minmax(0, 1fr) auto; }
  .fx-log, .fx-plan-box { display: grid; gap: 10px; padding: 16px 18px; border-radius: 18px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-md); min-width: 0; align-content: start; }
  .fx-h4 { margin: 0; display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; font-size: 13px; font-weight: 550; color: var(--text-3); }
  .fx-entries { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .fx-entries :global(li) { display: grid; grid-template-columns: 42px minmax(0, 1fr); gap: 1px 10px; font-size: 13.5px; line-height: 1.4; transform-origin: center; }
  .fx-entries :global(time) { font-size: 13px; line-height: 1.5; color: var(--text-3); font-variant-numeric: tabular-nums; grid-row: 1 / span 2; }
  .fx-entries :global(b) { font-weight: 600; }
  .fx-entries :global(small) { grid-column: 2; font-size: 12px; color: var(--text-3); }
  .fx-beat { font-size: 12px; font-weight: 450; color: var(--text-3); font-variant-numeric: tabular-nums; }
  .fx-plan-box :global(.ifl) { width: 100%; }

  .fx-do { position: relative; grid-column: 1 / -1; order: 0; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; counter-reset: none; }
  .fx-inc { order: 2; } .fx-side { order: 3; }
  .fx-do li { display: grid; min-width: 0; }
