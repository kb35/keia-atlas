---
// A device profile: what healthy means for one kind of device (a Keia object profile), with a drawing
// of each model (Record archetype, docs/standards/page-anatomy.md).
//   Band      the kind of device, what it is for, and its fleet in figures.
//   Picture   the chosen model drawn big, with the models to switch between on top of it (7 columns).
//   Panel     the chosen model: status, figures, meeting platforms, why it is in the standard, advisories.
//   Tabs      Ports, What healthy looks like, Configuration, Firmware, Troubleshoot, Fleet.
// The model switcher changes the model in place: the page fetches the other model's page and morphs
// keyed parts (data-k), so the drawing and ports move rather than flash (decision 0015, docs/rules/devices.md).
import Shell from '../layouts/Shell.astro';
import Icon from './Icon.astro';
import DeviceArt from './DeviceArt.astro';
import ProfilePorts from './ProfilePorts.astro';
import StageBar from './StageBar.astro';
import HealthCard from './HealthCard.astro';
import ConfigView from './ConfigView.astro';
import ConfigScript from './ConfigScript.astro';
import PageBand from './PageBand.astro';
import SidePanel from './SidePanel.astro';
import DetailTabs from './DetailTabs.astro';
import { recHere } from '../lib/vt.mjs';
import { classes, models, spaces, sites, spaceTypes, usedIn, typesUsing, STAGES, STAGE_LABEL, SITE_ORDER, modelName, plural, href, roomWords, modelChoices, advisoriesFor, configFor, firmwareFor, standardFirmware, ADV_LEVEL, FW_STATUS, MODEL_STATUS, LAYER_LABEL, src as sourceOf, fmtDate } from '../lib/data.mjs';
import { artSource } from '../lib/art.mjs';
import { classFaces, FACE_LABEL } from '../lib/ports.mjs';
import { layoutPorts } from '../lib/ports.mjs';


const { cls, model } = Astro.props;
const C = classes[cls];
const ids = Object.keys(models).filter((id) => models[id].class === cls);
const M = model ? models[model] : null;
const faces = classFaces(ids);
const sizes = ids.map((id) => layoutPorts(id, faces));
const panelW = Math.max(200, ...sizes.map((s) => s.w)), panelH = Math.max(0, ...sizes.map((s) => s.h));
const hasPorts = ids.some((id) => models[id].ports?.length);

const PLATFORM = { keia_atlas: 'Keia Atlas', inventory: 'Asset register', dhcp_dns: 'Addresses and DNS', device_management: 'Device management', room_booking: 'Room booking', monitoring: 'Monitoring' };
const nice = (s) => s.replace(/_/g, ' ').replace(/^./, (c) => c.toUpperCase());
const cap = (s) => s[0].toUpperCase() + s.slice(1);
const stages = Object.fromEntries(STAGES.map((s) => [s, 0]));
// Units are counted the way the Units list counts them (a row for each position and each piece of older kit), so
// "Units" here opens Units showing the same number (rule P10). The stages count every unit record.
let units = 0;
for (const s of Object.values(spaces)) for (const p of s.positions) if (p.cls === cls) for (const u of p.units) stages[u.stage]++;
for (const s of Object.values(spaces)) for (const p of [...s.positions, ...s.olderKit]) if (p.cls === cls) units++;
const types = Object.entries(spaceTypes).filter(([, t]) => t.keia_atlas.options.some((o) => o.equipment.some((e) => e.class === cls)));
const url = (id) => href(`/profiles/${cls}/${id}/`);
const short = (id) => models[id].model.replace(/\s*\(.*\)$/, '');
const src = model ? artSource(model) : null;
const symptoms = Object.entries(C.discrimination ?? {});

// Facts shown under the drawing: only what the model file states.
const mm = (n) => `${(+n).toLocaleString('en-IE', { maximumFractionDigits: 1 })} mm`;
const facts = M ? [
  M.dimensions_mm?.width && ['Width', mm(M.dimensions_mm.width)],
  M.dimensions_mm?.height && ['Height', mm(M.dimensions_mm.height)],
  M.dimensions_mm?.depth && ['Depth', mm(M.dimensions_mm.depth)],
  M.weight_kg && ['Weight', `${M.weight_kg} kg`],
  M.power?.consumption_w?.max && ['Power', `${M.power.consumption_w.max} W max`],
  ['Ports', String(M.ports?.length ?? 0)],
].filter(Boolean) : [];
// One example device of this kind, so the health cards can show what the evidence looks like.
// Hostname, serial and tag come from the data; address, MAC and firmware are demo values.
let exPos = null;
for (const sp of Object.values(spaces)) for (const pos of sp.positions) {
  if (pos.cls !== cls || pos.current?.stage !== 'manage') continue;
  // Prefer a unit of the chosen model, then one with a hostname.
  const score = (x) => (x.model === model ? 2 : 0) + (x.hostname ? 1 : 0);
  if (!exPos || score(pos) > score(exPos.p)) exPos = { s: sp, p: pos };
}
const h = (str) => [...str].reduce((n, c) => (n * 31 + c.charCodeAt(0)) >>> 0, 7);
const ex = exPos && (() => {
  const { s: sp, p: pos } = exPos, n = h(pos.current.serial);
  const hex = (v) => (v & 255).toString(16).padStart(2, '0');
  return {
    space: sp.number ? `${sp.number} ${sp.name}` : sp.name, site: sites[sp.site].name, ports: models[pos.model]?.ports?.length ?? 6,
    asset: pos.current.asset_tag, serial: pos.current.serial,
    host: `${pos.hostname ?? `${sp.id}-${C.profile.naming_prefixes?.[0] ?? 'dev'}01`}.aigna.example`,
    ip: `10.${(SITE_ORDER.indexOf(sp.site) + 1) * 10}.${sp.floor ?? 1}.${20 + (n % 200)}`,
    mac: ['02', hex(n), hex(n >> 8), hex(n >> 16), hex(n >> 24), hex(n >> 4)].join(':'),
    fw: `${4 + (n % 2)}.${n % 5}.${n % 3}`, day: 28, month: 'Sep', seats: sp.capacity ?? sp.seats ?? 8,
    model: pos.model, cls, stage: pos.current.stage, siteId: sp.site, floor: sp.floor, fwStd: standardFirmware(pos.model)?.version,
  };
})();
// What anyone installing, updating or troubleshooting this model needs: why it is in the standard,
// its advisories, its configuration and its firmware line (all cited).
const choice = model ? modelChoices[model] : null;
const advs = model ? advisoriesFor(model) : [];
const cfg = model ? configFor(model) : null;
const cfgCount = cfg ? cfg.groups.reduce((n, g) => n + g.settings.filter((x) => x.action !== 'leave').length, 0) : 0;
const fwl = model ? firmwareFor(model) : null;
const fwStd = model ? standardFirmware(model) : null;
let mUnits = 0, mService = 0; const mSites = new Set();
for (const s of Object.values(spaces)) for (const p of s.positions) if (p.model === model) for (const u of p.units) { mUnits++; if (u.stage === 'manage') mService++; mSites.add(s.site); }
const SUPPORT = { yes: 'Supported', no: 'Not supported', 'not-confirmed': 'Not confirmed', 'via-partner': 'Through a partner app' };
const SUPPORT_ICON = { yes: 'check', no: 'stop', 'not-confirmed': 'about', 'via-partner': 'link' };
const monthYear = (d) => (d ? new Date(d.length === 7 ? `${d}-01` : d).toLocaleDateString('en-IE', { month: 'short', year: 'numeric' }) : '');
const srcLink = (id) => sourceOf(id);
const choiceStatus = (id) => modelChoices[id]?.status;
const portFaces = M ? [...new Set((M.ports ?? []).map((p) => p.face ?? 'none'))].map((f) => FACE_LABEL[f]).join(' and ') : '';
const statusOf = (id) => choiceStatus(id) ?? (typesUsing[id] ? 'standard' : 'legacy');
const title = M ? `${C.profile.name}: ${modelName(model)}` : C.profile.name;
// The band: the fleet of this kind of device, in figures that link where they can.
const NUMBERS = [
  { n: units, label: units === 1 ? 'Unit' : 'Units', to: `/devices/?cls=${cls}` },
  { n: stages.manage, label: STAGE_LABEL.manage, to: `/devices/?cls=${cls}&state=service` },
  { n: types.length, label: types.length === 1 ? 'Space type' : 'Space types', to: '#fleet' },
  { n: symptoms.length, label: symptoms.length === 1 ? 'Symptom' : 'Symptoms', to: '#troubleshoot' },
];
const TABS = [
  hasPorts && M && { id: 'ports', label: 'Ports', count: M.ports?.length ?? 0 },
  { id: 'healthy', label: 'What healthy looks like', count: Object.keys(C.platforms).length },
  { id: 'configuration', label: 'Setup guide', count: cfgCount || undefined },
  { id: 'firmware', label: 'Firmware', count: fwl ? fwl.releases.length : undefined },
  { id: 'troubleshoot', label: 'Troubleshoot', count: symptoms.length },
  { id: 'fleet', label: 'Fleet', count: units },
].filter(Boolean);
---
<Shell vendorOk about={{ kind: 'profile', cls, label: title, model: M ? modelName(model) : undefined, to: `/profiles/${cls}/${model ?? ''}` }} title={title} section="profiles" crumbs={M ? [{ label: 'Device types', to: '/profiles/' }, { label: C.profile.name, to: `/profiles/${cls}/` }, { label: modelName(model) }] : [{ label: 'Device types', to: '/profiles/' }, { label: C.profile.name }]}>
  <PageBand overline="Device type" title={C.profile.name} lede={`${roomWords(C.profile.object_role)}.`} numbers={NUMBERS}>
    <Fragment slot="overline">
      <span class="code mono">{cls}</span>
      <span>Version {C.profile.version}</span>
      <span>{ids.length ? plural(ids.length, 'model') : 'Model set per project'}</span>
    </Fragment>
    <button slot="action" type="button" class="btn primary" data-open-report="change">Propose an edit</button>
  </PageBand>

  <div class="content pv-page" data-morph-root>
    <div class="g12 top" data-k="top">
      <!-- The chosen model, drawn big, with the models to switch between on top of it. -->
      <section class="card product s-7 stick" aria-label={M ? `${modelName(model)}, drawn front-on` : C.profile.name} data-k="product" {...recHere(cls)}>
        {ids.length > 0 ? (
          <div class="mp" data-k="mp">
            <div class="seg mp-tiles" role="group" aria-label="Model" data-k="seg">
              <span class="seg-thumb" data-k="seg-thumb" aria-hidden="true"></span>
              {ids.map((id) => (
                <a class="seg-item mp-tile" href={url(id)} data-model-link data-k={`chip-${id}`} aria-current={id === model ? 'true' : undefined}>
                  <span class="mp-art" data-k={`mpa-${id}`}><DeviceArt model={id} cls={cls} small /></span>
                  <span class="mp-name" data-k={`mpn-${id}`}>{short(id)}</span>
                  <span class:list={['mp-st', `ms-${statusOf(id)}`]} data-k={`mps-${id}`}>{MODEL_STATUS[statusOf(id)]}</span>
                </a>
              ))}
            </div>
          </div>
        ) : <p class="muted mp-none">No specific model: each project picks one.</p>}
        <div class="stage product-stage" data-k="stage">
          {M ? <DeviceArt model={model} cls={cls} label={`${modelName(model)}, drawn front-on`} /> : <DeviceArt model={null} cls={cls} label={C.profile.name} />}
        </div>
        <div class="product-foot" data-k="pfoot">
          <p class="product-dims" data-k="pdims">{M ? <>{facts.filter(([k]) => ['Width', 'Height', 'Depth'].includes(k)).map(([, v]) => v).join(' × ') || 'Size not published'}{src ? ', front, to scale' : ', outline for its kind'}</> : 'Outline for its kind'}</p>
          {M && <a class="product-link" href={href(`/models/${model}/`)} data-k="pb-link">Every spec and port <Icon name="arrow" size={14} /></a>}
        </div>
      </section>

      <!-- The chosen model: what it is, where it runs, and what to know before touching it. -->
      <SidePanel class="s-5 mb" title={M ? modelName(model) : 'No model chosen'} meta={M ? MODEL_STATUS[statusOf(model)] : undefined}>
        {M ? (
          <div class="mb-body" data-k="mb-body">
            {(choice?.since || choice?.review) && <p class="mb-status" data-k="mb-status">{choice?.since && <span>In the standard since {monthYear(choice.since)}</span>}{choice?.review && <span class="faint">Next review {fmtDate(choice.review)}</span>}</p>}
            <dl class="mb-stats" data-k="mb-stats">
              <div><dt>Units</dt><dd class="num">{mUnits ? <a class="dd-n" href={href(`/devices/?q=${encodeURIComponent(modelName(model))}`)} data-vt-rec="dd-devices" title={`Every ${modelName(model)} in Units`}>{mUnits}</a> : mUnits}</dd></div>
              <div><dt>{STAGE_LABEL.manage}</dt><dd class="num">{mService ? <a class="dd-n" href={href(`/devices/?q=${encodeURIComponent(modelName(model))}&state=service`)} data-vt-rec="dd-devices" title={`Every ${modelName(model)} in service, in Units`}>{mService}</a> : mService}</dd></div>
              <div><dt>Offices</dt><dd class="num" data-dd-fact>{mSites.size}</dd></div>
              <div><dt>Standard firmware</dt><dd class="mono">{fwStd?.version ?? 'Not tracked'}</dd></div>
            </dl>
            {choice && (
              <ul class="plat" data-k="plat" aria-label="Meeting platforms">
                {choice.platforms.map((pl) => (
                  <li class={`pl pl-${pl.support}`} title={pl.note}>
                    <span class="pl-i"><Icon name={SUPPORT_ICON[pl.support]} size={13} /></span>
                    <span><b>{pl.name}</b><small>{SUPPORT[pl.support]}</small></span>
                  </li>
                ))}
              </ul>
            )}
            {choice && (
              <details class="why" data-k="why">
                <summary>Why Aigna uses the {models[model].model} <span class="faint">({choice.why.length})</span></summary>
                <ul>{choice.why.map((w) => <li>{w.point}{w.source && srcLink(w.source) && <a class="cite" href={srcLink(w.source).url} target="_blank" rel="noopener" title={srcLink(w.source).title}>source</a>}</li>)}</ul>
              </details>
            )}
            {advs.length > 0 && (
              <section class="advs" data-k="advs" aria-label="Advisories">
                {advs.map((a) => (
                  <article class={`adv lv-${a.level}`} data-k={`adv-${a.id}`} tabindex="0">
                    <span class="adv-i"><Icon name={a.level === 'do-not-install' ? 'stop' : a.level === 'act' ? 'alert' : 'about'} size={18} /></span>
                    <div class="adv-body">
                      <p class="adv-top"><span class="adv-lv">{ADV_LEVEL[a.level]}</span><span class="mono faint">{a.id}</span><span class="faint">{a.status === 'open' ? 'Open' : 'Decided'} · {fmtDate(a.date)}</span></p>
                      <h3>{a.title}</h3>
                      <p class="adv-act">{a.action}</p>
                      <details class="adv-more"><summary>What the vendor says</summary><p>{a.says}</p><p class="adv-src">{a.sources.map((sid) => srcLink(sid) && <a href={srcLink(sid).url} target="_blank" rel="noopener">{srcLink(sid).title}</a>)}</p></details>
                    </div>
                  </article>
                ))}
              </section>
            )}
            {!choice && !advs.length && <p class="muted mb-note" data-k="mb-note">{typesUsing[model] ? 'In the standard: at least one space type uses it.' : 'Not in any space type today.'} {facts.length > 1 ? `${facts.filter(([k]) => k !== 'Ports').map(([k, v]) => `${k} ${v}`).join(', ')}.` : ''}</p>}
          </div>
        ) : <p class="muted">Each project chooses the model for this kind of device.</p>}
      </SidePanel>
    </div>
    <p class="sr-only" aria-live="polite" data-k="announce" id="model-announce">{M ? `Showing ${modelName(model)}` : ''}</p>

    <DetailTabs tabs={TABS} label="Profile">
      {hasPorts && M && (
        <section slot="ports" class="card ports-card" aria-labelledby="ports-h" data-k="ports-wrap">
          <div class="ports-top" data-k="ports-top">
            <h2 id="ports-h" class="sr-only">Ports</h2>
            <p class="faint port-count" data-k="port-count">{plural(M.ports?.length ?? 0, 'port')}{portFaces && `, ${portFaces.toLowerCase()}`}</p>
            <dl class="pfacts" data-k="pfacts">
              {facts.filter(([k]) => k !== 'Ports').map(([k, v]) => <div data-k={`f-${k}`}><dt>{k}</dt><dd class="mono num">{v}</dd></div>)}
            </dl>
          </div>
          <div class="ports-scroll" data-k="ports-scroll"><ProfilePorts model={model} faces={faces} width={panelW} height={panelH} /></div>
          <p class="pb-src" data-k="pb-src">{src ? `Drawing traced from ${src}. Ports from the vendor's documentation.` : 'No traced drawing yet, so it is shown as the outline for its kind. Ports from the vendor\'s documentation.'}</p>
        </section>
      )}

      <section slot="healthy" aria-label="What healthy looks like" data-health>
        <p class="tab-lede faint">{ex ? <>Checked on one example, <span class="mono">{ex.host.split('.')[0]}</span> (simulated values). <button type="button" class="btn small" data-recheck>Check again</button></> : 'What each platform must hold for this kind of device.'}</p>
        <div class="health-grid">
          {Object.entries(C.platforms).map(([k, p]) => ex ? <HealthCard k={k} name={PLATFORM[k] ?? nice(k)} p={p} ex={ex} /> : (
            <article class="hcard"><header><h3>{PLATFORM[k] ?? nice(k)}</h3></header><p class="hc-when">Healthy when {roomWords(p.healthy_indicators.join('; '))}.</p></article>
          ))}
        </div>
        <p class="faint learn-link">What each field means, and how hostnames and addresses are built: <a href={href('/learn/fields/')}>Learn: device fields</a></p>
      </section>

      <div slot="configuration" data-k="p-configuration">
        {cfg ? (
          <ConfigView cfg={cfg} pane="summary" />
        ) : (
          <div class="card empty-card">
            <p class="name">Nothing to configure on {M ? modelName(model) : 'this kind of device'}</p>
            <p class="muted">It works as it comes, or it is set up through the device it connects to. See <a href={href('/configurations/')}>every setup guide</a>.</p>
          </div>
        )}
      </div>

      <div slot="firmware" class="stack" data-k="p-firmware">
        {fwl ? (
          <>
            <section class="fw-now card">
              <span class="fw-chip mono">{fwStd?.version}</span>
              <div><p class="kind">Aigna standard · {fwl.name}</p><p class="muted">{fwStd?.aigna} Updates come through {fwl.managed_in}.</p></div>
              <button type="button" class="btn small fw-log" data-open-report="firmware" data-report-model={M ? `${M.manufacturer} ${M.model}` : C.profile.name}><Icon name="chip" size={14} />New firmware found</button>
            </section>
            <p class="fw-sum">
              {fwl.releases.filter((r) => r.status === 'lab').map((r) => <span class="fws-chip s-lab"><b class="mono">{r.version}</b> in the Lab</span>)}
              {fwl.releases.filter((r) => r.status === 'blocked').map((r) => <span class="fws-chip s-blocked"><b class="mono">{r.version}</b> do not install</span>)}
            </p>
            <details class="fw-all">
              <summary>Every release, and why each was or wasn't taken ({fwl.releases.length})</summary>
              <ol class="fw-line">
                {fwl.releases.map((r) => (
                  <li class={`fwr fw-${r.status}`}>
                    <span class="fwr-dot" aria-hidden="true"></span>
                    <div class="fwr-body">
                      <p class="fwr-top"><b class="mono">{r.version}</b><span class={`fws s-${r.status}`}>{FW_STATUS[r.status]}</span><span class="faint">{monthYear(r.released)}</span>
                        {r.lab && <a class="tag" href={href(`/lab/#${r.lab.toLowerCase()}`)}>{r.lab}</a>}{r.advisory && <span class="tag">{r.advisory}</span>}</p>
                      {r.aigna && <p class="fwr-note">{r.aigna}</p>}
                      <ul class="fwr-h">{r.headlines.map((h) => <li>{h}</li>)}</ul>
                      {r.known_issues?.length > 0 && <details><summary>{plural(r.known_issues.length, 'known error')}</summary><ul>{r.known_issues.map((k) => <li>{k}</li>)}</ul></details>}
                      {srcLink(r.source) && <a class="cite" href={srcLink(r.source).url} target="_blank" rel="noopener">Release notes</a>}
                    </div>
                  </li>
                ))}
              </ol>
            </details>
          </>
        ) : (
          <div class="card empty-card">
            <p class="name">No firmware line tracked for {M ? modelName(model) : 'this kind of device'}</p>
            <p class="muted">When the vendor watcher tracks a model, its releases, Aigna's decision on each, and any advisories appear here and on every device of that model.</p>
          </div>
        )}
      </div>

      <div slot="troubleshoot" class="stack" data-k="p-troubleshoot">
        {fwStd?.known_issues?.length > 0 && (
          <section class="card pad">
            <h3>Known errors in the standard firmware ({fwStd.version})</h3>
            <ul>{fwStd.known_issues.map((k) => <li>{k}</li>)}</ul>
          </section>
        )}
        {symptoms.length > 0 && (
          <section aria-labelledby="symptoms">
            <div class="section-head"><h2 id="symptoms">Symptoms</h2><span class="aside faint">Likely causes and where to look first</span></div>
            <div class="list">
              {symptoms.map(([k, d]) => (
                <div class="row plain">
                  <span><span class="name">{nice(k)}</span><span class="sub">{roomWords(d.likely_causes.map(cap).join('; '))}</span></span>
                  <span class="end"><span class="tag">Check {PLATFORM[d.first_check] ?? nice(d.first_check)} first</span></span>
                </div>
              ))}
            </div>
          </section>
        )}
        {C.consistency?.length > 0 && (
          <section aria-labelledby="consistency">
            <div class="section-head"><h2 id="consistency">Cross-checks</h2><span class="aside faint">The same fact must agree everywhere it is recorded</span></div>
            <div class="tablewrap"><table>
              <thead><tr><th scope="col">Check</th><th scope="col">Compares</th></tr></thead>
              <tbody>{C.consistency.map((c) => <tr><td>{nice(c.check)}</td><td class="mono small">{c.compare.join(' = ')}</td></tr>)}</tbody>
            </table></div>
          </section>
        )}
      </div>

      <div slot="fleet" class="g12" data-k="p-fleet">
        <div class="card side-card s-4">
          <h3>Fleet, all models</h3>
          <p class="fleet-num num">{units}</p>
          <p class="muted fleet-sub">{C.profile.name.toLowerCase()} units</p>
          {units > 0 && <StageBar stages={stages} />}
          <dl class="kv">{STAGES.filter((s) => stages[s]).map((s) => <div><dt><i class={`dot ${s}`}></i>{STAGE_LABEL[s]}</dt><dd class="num">{stages[s]}</dd></div>)}</dl>
          {units > 0 && <a class="btn small" href={href(`/devices/?cls=${cls}`)}>Every unit<Icon name="arrow" size={14} /></a>}
        </div>
        <div class="card side-card s-4">
          <h3>Used in</h3>
          {types.length > 0 ? <div class="tagwrap">{types.map(([id, t]) => <a class="tag" href={href(`/room-profiles/${id}/`)}>{roomWords(t.profile.name)}</a>)}</div> : <p class="muted">No space type uses it yet.</p>}
        </div>
        <div class="card side-card s-4">
          <h3>Profile file</h3>
          <dl class="kv">
            <div><dt>File</dt><dd class="mono small">data/device-classes/{cls}.yaml</dd></div>
            <div><dt>Version</dt><dd>{C.profile.version}</dd></div>
            <div><dt>Updated</dt><dd>{C.profile.last_updated}</dd></div>
            <div><dt>Hostname prefix</dt><dd class="mono">{C.profile.naming_prefixes?.join(', ')}</dd></div>
          </dl>
        </div>
      </div>
    </DetailTabs>
  </div>

  <script is:inline data-astro-rerun slot="end">
    (function () {
      /* Runs on every page load, including pages the client router swaps in. Document-level
         handlers are attached once; per-page setup runs each time. Tabs belong to DetailTabs.
         Motion takes its durations and curve from window.rsMotion (motion.css). */
      var P = window.__rsProfile;
      if (!P) {
        P = window.__rsProfile = {};
        var reduced = function () { return matchMedia('(prefers-reduced-motion: reduce)').matches; };
        var M0 = function () { return window.rsMotion ? window.rsMotion() : { morph: 520, exit: 240, stagger: 24, state: 300, delay: 120, reduced: reduced() }; };
