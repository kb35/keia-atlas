---
// A page that moved. Astro's own redirects drop the site's base path from the target,
// so old links use this instead: it sends the browser on and says where, with the base added.
import { href } from '../lib/data.mjs';
const { to } = Astro.props;
const url = href(to);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved to {url}</title>
    <meta http-equiv="refresh" content={`0;url=${url}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={url} />
  </head>
  <body><p>This page moved. <a href={url}>Go to its new place</a>.</p></body>
</html>
