---
// The room drawn to scale (src/lib/room3d.mjs): a cut-away view from the front right corner, the
// display wall at the back. Furniture and devices sit where the room profile puts them, at their real
// sizes; the ruler along the front edge is in metres. Outlets are the real plates, floor boxes and desk
// modules, to scale, lettered A, B, C, with their sockets (the site's plug type) and data jacks
// (coloured by signal) on the face.
//
// One rule for markers: a solid marker is something you can see in the room, a dashed one something
// hidden (behind the display, under the table, behind storage, outside the door). A hidden thing is
// drawn where it really is, under what hides it; its marker sits just outside, with a short leader
// line. By default the drawing shows the room and the devices' markers only. "See behind" makes what
// hides things see-through and outlines the hidden ones; "Cables" draws every cable along the room's
// containment (src/lib/cableroute.mjs, rule R7): from the port it really leaves, in its lane along the
// track, trunking, tray or duct, to the port it plugs into, coloured by signal, with each plate's feed
// back to where the data comes in above the door. The plates' letters show with either.
//
// Two states only (motion.md rows 55 to 58): the full view, or focus. Choosing a device, a plate or a
// cable (a click or tap on it, its marker or its row in the Key) focuses it: it, its plate or ports and
// its cable route stay at full strength with a clear outline and glow; everything else drops to a quiet
// silhouette (the room a thin outline, furniture and other kit faint and grey, other markers and cables
// hidden). "Show everything", a click on empty space or Escape goes back to the full view. Pointing at
// a marker, a cable or a Key row with a mouse previews its focus; touch never leaves a hover behind.
// The behaviour and the room-to-room morph are in src/lib/scene-client.mjs.
//
// highlight: scene keys (data-sk: "video-bar", "display#2") to focus from the start. An incident page
// uses it to show the affected device; tone "bad" makes its outline, glow and marker red.
// simple: the room guide's drawing for employees: devices only, no plates' letters, no cables, no layers.
//
// pair: the record layout (room profile and room pages). The drawing sits in its own card beside the
// "side" slot (the Key, as a SidePanel), and is only as wide as the room needs: every room is drawn at
// the same number of pixels a metre (PX_PER_M), so a small office is drawn small and a boardroom
// large, until the cap: at most 58% of the width and never taller than 60% of the window. With less
// room (a container query) the side panel goes under the drawing. rec: attributes for the picture card
// (recHere from src/lib/vt.mjs).
import { roomItems } from '../lib/scene.mjs';
import { buildRoom, render, layoutLabels, HOUSE_OUTLET_Z } from '../lib/room3d.mjs';
import { routeCables, cableWords, itemName, commsRoomOf } from '../lib/cableroute.mjs';
import { sites, models, className, spaces } from '../lib/data.mjs';
const { option, type, fitted = null, space = null, uid = option.id, summary = null, highlight = [], tone = null, pair = false, rec = {}, help = null, label = 'The space', simple = false } = Astro.props;
const items = roomItems(option, { fitted, space });
const site = space ? sites[space.site] : null;
const plugs = site?.mains?.plugs ?? null;
const country = space?.country ?? site?.country ?? null;
// A room profile shows every optional item, so its cables and plates count them all as fitted.
const fitList = fitted ?? option.equipment.filter((e) => e.requirement === 'optional').map((e) => e.key);
const M = buildRoom(type, option, items, { plugs, country, fitted: fitList, models });
const R = render(M, { width: 760, pad: 12 });
const PX_PER_M = 80, MIN_W = 440;
const natW = Math.max(MIN_W, Math.round((R.width * PX_PER_M) / R.k));
// A small drawing keeps its labels and numbers readable: they grow as the drawing shrinks.
const tsN = Math.min(1.7, Math.max(1, (R.width / natW) * 0.72));
const ts = tsN.toFixed(3);
const labels = layoutLabels(R, pair ? tsN : 1);
const aspect = (R.width / R.height).toFixed(3);
const Pair = pair ? 'div' : Fragment, Grid = pair ? 'div' : Fragment, Card = pair ? 'section' : Fragment;
const room = M.room;
const PL = M.plates;
const groups = PL.groups.filter((g) => g.at);
const plateOf = new Map(groups.map((g) => [g.sk, g]));
const pins = new Set(highlight.filter((k) => items.some((it) => it.key === k)));
const pinHid = items.some((it) => pins.has(it.key) && it.hidden);
const byKey = new Map(items.map((it) => [it.key, it]));
const nameOf = (k) => (k === 'laptop' ? 'Laptop' : k === 'home-router' ? 'Home router' : plateOf.get(k) ? `Plate ${plateOf.get(k).id}` : byKey.get(k)?.label ?? k);
// Which plates each device plugs into, and which devices each plate feeds (for hover).
const relOf = new Map();
const addRel = (a, b) => { if (!relOf.has(a)) relOf.set(a, new Set()); relOf.get(a).add(b); };
for (const g of groups) for (const d of g.devs) if (byKey.has(d)) { addRel(g.sk, d); addRel(d, g.sk); }
const rel = (sk) => (relOf.has(sk) ? [...relOf.get(sk)].join(' ') : undefined);
// What the page's highlight focuses from the start (the same as the script's focus, so nothing flashes):
// the pinned things are chosen (sel), and what they plug into is lit with them (hit).
const pinRel = new Set([...pins].flatMap((k) => [...(relOf.get(k) ?? [])]));
const focusCls = (sk) => (!sk ? '' : pins.has(sk) ? ' hit sel pin' : pinRel.has(sk) ? ' hit' : '');
// Morph keys (data-mk): the same thing in two drawings (two build options, or two sizes of room) moves from
// one to the other. A device is its class and its number among its class; a plate its place; furniture its
// material and its number in the order the room was built; the room's walls, floor and rulers their part.
const seen = {};
const vk = new Map(items.map((it) => [it.key, `${it.e.class}-${(seen[it.e.class] = (seen[it.e.class] ?? 0) + 1)}`]));
for (const g of groups) vk.set(g.sk, `plate-${g.loc}-${g.part}`);
const mkOf = new Map(), part = {}, byMat = {};
for (const s of M.b.S) {
  if (s.sk && vk.get(s.sk)) mkOf.set(s, `${vk.get(s.sk)}-${(part[s.sk] = (part[s.sk] ?? 0) + 1)}`);
  else mkOf.set(s, `f-${s.mat}-${(byMat[s.mat] = (byMat[s.mat] ?? 0) + 1)}`);
}
const shN = {};
const shKey = (s) => `sh-${s.cls.replace(/\s+/g, '.')}-${(shN[s.cls] = (shN[s.cls] ?? 0) + 1)}`;
// Words for plates and ports.
const socketWord = PL.socket ? `Type ${PL.socket}` : 'plain';
const count = (n, one, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;
const portLine = (p) => `${p.svc === 'power' ? 'Power' : p.svc === 'data' ? 'Data' : 'Direct run'} ${p.n}: ${p.dev ? nameOf(p.dev) : p.name === 'spare' ? 'spare' : p.name}${p.optional ? ' (only in bigger builds)' : ''}`;
const plateSummary = (g) => [g.power.length && count(g.power.length, `${socketWord} socket`), g.data.length && count(g.data.length, 'data port'), g.runs.length && count(g.runs.length, 'direct run')].filter(Boolean).join(', ');
const plateTitle = (g) => `Plate ${g.id}: ${g.name} ${g.where}. ${plateSummary(g)}.\n${[...g.ports, ...g.runs].map(portLine).join('\n')}`;
const titleOf = (s) => (s.pl ? plateTitle(s.pl) : s.it ? `${s.it.no}. ${s.it.label}${s.it.model ? `, ${s.it.model}` : ''}${s.inches ? ` (${s.inches} in shown)` : ''} · ${s.outside ? 'outside the door' : s.it.where}` : s.label ?? null);
// Cables: every one the option lists, routed along the room's containment (src/lib/cableroute.mjs).
const home = type === 'remote-home';
const RT = routeCables(M, option, fitList, { models, project: R.project, cacheKey: `${type}/${option.id}/${fitList.join(',')}/${PL.fmt}/${PL.socket}` });
const CAB = { 'usb-c': 'USB-C', usb: 'USB', thunderbolt: 'Thunderbolt', cat6: 'Cat 6', cat6a: 'Cat 6A', hdmi: 'HDMI', displayport: 'DisplayPort', power: 'Power', 'poly-mic': 'Microphone', audio: 'Audio', speaker: 'Speaker', proprietary: 'Vendor cable' };
const eqName = (k) => { const e = option.equipment.find((x) => x.key === k); return (e?.role?.split(/[:,]/)[0] ?? className(e?.class ?? k)).toLowerCase(); };
const wordName = (k, closet) => (closet ? eqName(k) : byKey.get(k) ? itemName(byKey.get(k)) : nameOf(k));
const P = (p) => R.project(...p);
// A path through projected points with small rounded corners, the same radius everywhere, so a bundle
// turns a corner as one.
const roundPath = (pts, rad = 2.6) => {
  const q = pts.map(P).filter((p, i, a) => i === 0 || Math.hypot(p[0] - a[i - 1][0], p[1] - a[i - 1][1]) > 0.05);
  if (q.length < 2) return '';
  let d = `M${q[0][0]} ${q[0][1]}`;
  for (let i = 1; i < q.length - 1; i++) {
    const [a, b, c] = [q[i - 1], q[i], q[i + 1]];
    const l1 = Math.hypot(b[0] - a[0], b[1] - a[1]), l2 = Math.hypot(c[0] - b[0], c[1] - b[1]), r = Math.min(rad, l1 / 2, l2 / 2);
    const p1 = [b[0] - ((b[0] - a[0]) / l1) * r, b[1] - ((b[1] - a[1]) / l1) * r], p2 = [b[0] + ((c[0] - b[0]) / l2) * r, b[1] + ((c[1] - b[1]) / l2) * r];
    d += ` L${p1[0].toFixed(1)} ${p1[1].toFixed(1)} Q${b[0]} ${b[1]} ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
  }
  return `${d} L${q.at(-1)[0]} ${q.at(-1)[1]}`;
};
const routed = RT.cables.filter((c) => c.pts && c.pts.length > 1);
// The stretches of a cable under the floor (the floor duct), drawn dashed: you would not see them.
const underFloor = (pts) => {
  const out = []; let cur = null;
  for (let i = 1; i < pts.length; i++) {
    const u = pts[i - 1][2] < -0.001 && pts[i][2] < -0.001;
    if (!cur || cur.u !== u) { cur = { u, pts: [pts[i - 1]] }; out.push(cur); }
    cur.pts.push(pts[i]);
  }
  return out.map((s) => ({ u: s.u, d: roundPath(s.pts) }));
};
const cables = routed.filter((c) => !c.feed).map((c) => ({ ...c, d: roundPath(c.pts), parts: underFloor(c.pts),A: P(c.pts[0]), B: c.endB.entry || c.endB.closet ? null : P(c.pts.at(-1)), title: `${CAB[c.cable] ?? c.cable}: ${cableWords(c, { nameOf: wordName, models, option })}` }));
const feeds = routed.filter((c) => c.feed).map((c) => ({ ...c, d: roundPath(c.pts), title: cableWords(c, { nameOf: wordName, models, option }) }));
// The containment the cables run in: trunking you can see as a pale channel; containment hidden in
// the floor, the ceiling or behind the display as a dashed outline.
const band = (r) => {
  const e = (p, ax, v) => { const q = [...p]; q[ax] += v; return q; };
  const a = e(r.a, r.ax, -r.pad), b = e(r.b, r.ax, r.pad);
  return [e(a, r.off, -r.half), e(b, r.off, -r.half), e(b, r.off, r.half), e(a, r.off, r.half)].map((p) => P(p).join(',')).join(' ');
};
const BAND_WORD = { track: 'Track behind the display', riser: 'Wall riser, up to the track', drop: 'Ceiling drop, from the track to the ceiling', ceiling: 'Ceiling basket', skirt: 'Skirting trunking', cover: 'Floor cable cover', duct: 'Floor duct, in the floor', box: 'Floor box', tray: 'Tray under the table', dtray: 'Tray under the desk', leg: 'Up the table leg', dleg: 'Down the desk leg', pass: 'Through the wall behind the table', side: 'Trunking behind the sideboard', void: 'Floor void', wallv: 'Inside the wall' };
const bands = RT.bands.filter((r) => !r.feedOnly).map((r) => ({ ...r, pts: band(r), title: BAND_WORD[r.kind] ?? r.kind }));
const comms = space ? commsRoomOf(space, Object.values(spaces)) : null;
const entry = RT.entry ? { at: P(RT.entry.p), title: `Where the data comes in: above the door, from ${comms ? `${comms.name} ${comms.number}${comms.floor !== space.floor ? `, on floor ${comms.floor}` : ''}` : space ? 'the comms room (not yet recorded for this site)' : "the floor's comms room"}` } : null;
const hasHidden = !simple && labels.some((l) => l.hid || l.behind);
const hasCables = !simple && cables.length > 0;
const areaNote = room.open ? `${room.area} m² per workstation (the drawing shows ${room.W.toFixed(1)} × ${room.D.toFixed(1)} m of floor)` : room.area ? `${room.W.toFixed(2)} × ${room.D.toFixed(2)} m, ${room.area} m²` : `${room.W.toFixed(2)} × ${room.D.toFixed(2)} m`;
const usesHouseZ = groups.some((g) => g.houseZ);
const kinds = new Set(groups.map((g) => g.kind));
const onPlates = kinds.has('wall') || kinds.has('ceiling');
const plateParts = [
  onPlates && `${PL.note}${usesHouseZ ? `, ${Math.round(HOUSE_OUTLET_Z * 1000)} mm up to the centre (house default; the space type gives no height)` : ''}`,
  kinds.has('floor') && 'floor boxes with a 300 mm lid',
  kinds.has('desk') && 'a desk module, 52 mm a socket (house default)',
].filter(Boolean);
const plateNote = groups.length ? ` · Outlets: ${PL.socket ? `Type ${plugs.join(', ')} sockets; ` : ''}${plateParts.join('; ')}` : '';
const markTitle = (l) => (l.pl ? `Plate ${l.pl.id}: ${l.pl.name} ${l.pl.where}` : `${l.it.no}. ${l.it.label}${l.hid ? `, ${l.it.where.toLowerCase()}` : ''}`);
// The room guide shows devices only: no plates' letters.
const marks = simple ? labels.filter((l) => !l.pl) : labels;
const pinned = pins.size > 0;
const cabHit = (c) => pins.has(c.a) || pins.has(c.b);
---
<Pair {...(pair ? { class: 'scene-pair', style: `--scene-w:${natW}px;--scene-ar:${aspect}` } : {})}>
<Grid {...(pair ? { class: 'sp-grid' } : {})}>
<Card {...(pair ? { class: 'card scene-card', 'aria-label': label, ...(help ? { 'data-help': help } : {}), ...rec } : {})}>
<div class:list={['scene-wrap', { focus: pinned, sticky: pinned, 'pin-on': pinned, 'focus-hid': pinHid, 'show-cables': home && hasCables, 'cables-default': home, simple, [`tone-${tone}`]: tone && pinned }]} data-scene-root data-morph="room" data-uid={uid} data-pin={pinned ? [...pins].join(' ') : undefined} style={pair ? `--ts:${ts}` : undefined}>
  <div class="scene-box">
    <div class="scene-tools" role="group" aria-label="Show in the drawing">
      {hasHidden && <button type="button" class="lchip" data-layer="xray" aria-pressed="false" title="Make what hides things see-through, and outline what is behind the display, under the table or outside the door"><span class="lc-ic xr" aria-hidden="true"></span>See behind</button>}
      {hasCables && <button type="button" class="lchip" data-layer="cables" aria-pressed={home ? 'true' : 'false'} title="Every cable, coloured by signal. Choose a device, a plate or a cable to follow its own."><span class="lc-ic rn" aria-hidden="true"></span>Cables</button>}
      <button type="button" class="lchip lc-all" data-scene-all aria-label="Show everything" title="Back to the whole room (Escape)"><svg class="lc-all-ic" viewBox="0 0 14 14" aria-hidden="true"><path d="M1.5 5V1.5H5M9 1.5h3.5V5M12.5 9v3.5H9M5 12.5H1.5V9" /></svg><span class="lc-all-t">Show everything</span></button>
    </div>
    <svg class="scene" viewBox={`0 0 ${R.width} ${R.height}`} role="img" aria-label={`Drawing of the space to scale, ${areaNote}, with ${items.length} devices${simple ? '' : ` and ${count(groups.length, 'outlet plate')}`}`}>
      <g class="shell">
        {R.shapes.map((s) => s.pts ? <polygon points={s.pts} class={`sh ${s.cls}`} data-mk={shKey(s)} /> : <path d={s.d} class={`sh ${s.cls}`} data-mk={shKey(s)} />)}
      </g>
      <g class="things">
      {R.drawn.map((d) => {
        const s = d.s;
        const cls = [s.pl ? 'pl' : s.it ? 'it' : 'fx', `m-${s.mat}`, (s.hid || s.pl?.hid) && 'hid', s.opt && 'opt', s.occ && 'occ', s.ghost && 'ghost', s.outside && 'outside', s.ceiling && 'ceil'].filter(Boolean).join(' ') + focusCls(s.sk);
        const t = titleOf(s);
        return (
          <g class={cls} data-sk={s.sk} data-rel={s.sk ? rel(s.sk) : undefined} data-mk={mkOf.get(s)}>
            {t && <title>{t}</title>}
            {d.fs.map((f) => <polygon points={f.pts} class={f.top ? 'ft' : 'fs'} style={f.top ? undefined : `--k:${f.k}%`} />)}
            {d.dec.map((x) => x.port
              ? <polygon points={x.pts} class={`dc d-${x.mat} pt${x.port.svc === 'power' ? ' pt-power' : ''}${x.port.dev ? ' used' : ''}${x.port.dev && pins.has(x.port.dev) ? ' hit' : ''}`} data-dev={x.port.dev} />
              : <polygon points={x.pts} class={`dc d-${x.mat}`} />)}
          </g>
        );
      })}
      </g>
      {R.dims.map((d, i) => (
        <g class="dim" data-mk={`dm-${i}`}><line x1={d.a[0]} y1={d.a[1]} x2={d.b[0]} y2={d.b[1]} /><circle cx={d.a[0]} cy={d.a[1]} r="2.5" /><circle cx={d.b[0]} cy={d.b[1]} r="2.5" /><text x={(d.a[0] + d.b[0]) / 2 + (d.side === 'left' ? -10 : 8)} y={(d.a[1] + d.b[1]) / 2 + 4} text-anchor={d.side === 'left' ? 'end' : 'start'}>{d.label}</text></g>
      ))}
      <g class="ghosts" aria-hidden="true">
        {R.marks.filter((m) => m.hid || labels.find((l) => l.sk === m.sk)?.behind).map((m) => {
          const pts = m.hull.map((p) => p.join(',')).join(' ');
          return <g class={`ghost-ol${pins.has(m.sk) ? ' hit' : ''}`} data-sk={m.sk}><polygon points={pts} class="go-halo" /><polygon points={pts} class="go-line" /></g>;
        })}
      </g>
      {!simple && (
      <g class="cable-layer">
        {bands.map((r) => <polygon points={r.pts} class={`tk tk-${r.kind}${r.hid ? ' tk-hid' : ''}${cables.some((c) => cabHit(c) && c.runs.includes(r.id)) ? ' hit' : ''}`} data-run={r.id}><title>{r.title}</title></polygon>)}
        {feeds.map((f) => <path d={f.d} class={`feed${pins.has(f.a) ? ' hit' : ''}`} data-for={f.a} data-cab={f.id}><title>{f.title}</title></path>)}
        {cables.map((c) => (
          <g class={`cab sig-${c.sig}${cabHit(c) ? ' hit' : ''}`} data-a={c.a} data-b={c.b} data-cab={c.id} data-runs={c.runs.join(' ')} tabindex="-1">
            <title>{c.title}</title>
            <path d={c.d} class="cab-hit" />{c.parts.map((p) => p.u ? <path d={p.d} class="cab-line cab-under" /> : <path d={p.d} class="cab-line" pathLength="1" />)}<path d={c.d} class="cab-flow" />
            <circle class="cab-end" cx={c.A[0]} cy={c.A[1]} r="2.2" />{c.B && <circle class="cab-end" cx={c.B[0]} cy={c.B[1]} r="2.2" />}
          </g>
        ))}
        {entry && <g class="entry"><title>{entry.title}</title><circle cx={entry.at[0]} cy={entry.at[1]} r="5.5" /><path d={`M${entry.at[0] - 2.6} ${entry.at[1]} h5.2 M${entry.at[0] + 0.6} ${entry.at[1] - 2.2} l2 2.2 l-2 2.2`} /></g>}
      </g>
      )}
      <g class="ruler" aria-hidden="true">
        {[R.widthDim, R.depthDim].map((d, i) => (
          <g class="rdim" data-mk={`rd-${i}`}>
            <line x1={d.a[0]} y1={d.a[1]} x2={d.b[0]} y2={d.b[1]} />
            <circle cx={d.a[0]} cy={d.a[1]} r="2.2" /><circle cx={d.b[0]} cy={d.b[1]} r="2.2" />
            <text x={i ? (d.a[0] + d.b[0]) / 2 + 10 : d.a[0] + (d.b[0] - d.a[0]) * 0.78} y={i ? (d.a[1] + d.b[1]) / 2 + 4 : d.a[1] + (d.b[1] - d.a[1]) * 0.78 + 20} text-anchor={i ? 'start' : 'middle'}>{d.label}</text>
          </g>
        ))}
        <g class="sbar" data-mk={`sb-${R.scale.m}`}>
          {R.scale.segs.map((s) => <polygon points={s.pts} class={s.fill ? 'on' : 'off'} />)}
          {R.scale.labels.map((l) => <text x={l.at[0]} y={l.at[1] + 14} text-anchor="middle">{l.t}</text>)}
        </g>
      </g>
      <g class="marks">
        {marks.filter((l) => l.lead).map((l) => (
          <g class:list={['lead', { hid: l.hid, tag: !!l.pl, opt: l.it?.optional, hit: pins.has(l.sk) || pinRel.has(l.sk), sel: pins.has(l.sk) }]} data-sk={l.sk} data-mk={`ld-${vk.get(l.sk)}`} aria-hidden="true">
            <line x1={l.lead.x1} y1={l.lead.y1} x2={l.lead.x2} y2={l.lead.y2} /><circle cx={l.lead.x1} cy={l.lead.y1} r="2.2" />
          </g>
        ))}
        {marks.map((l) => l.pl ? (
          <g class:list={['no', 'tag', { hid: l.hid, hit: pinRel.has(l.sk) }]} data-sk={l.sk} data-rel={rel(l.sk)} data-mk={`tag-${vk.get(l.sk)}`}>
            <title>{plateTitle(l.pl)}</title>
            <rect x={l.x - l.r * 0.95} y={l.y - l.r * 0.85} width={l.r * 1.9} height={l.r * 1.7} rx={l.r * 0.3} /><text x={l.x} y={l.y + 1} text-anchor="middle">{l.pl.id}</text>
          </g>
        ) : (
          <g class:list={['no', { hid: l.hid, opt: l.it.optional, hit: pins.has(l.sk), sel: pins.has(l.sk), pin: pins.has(l.sk) }]} data-sk={l.sk} data-rel={rel(l.sk)} data-mk={`no-${vk.get(l.sk)}`}>
            <title>{markTitle(l)}</title>
            <circle cx={l.x} cy={l.y} r="13" /><text x={l.x} y={l.y + 1} text-anchor="middle">{l.it.no}</text>
          </g>
        ))}
      </g>
    </svg>
  </div>
  <p class="scene-cap">{summary && <span class="sc-sum">{summary} </span>}<b>Drawn to scale</b> · {areaNote}{room.chairs ? ` · ${room.chairs} ${room.chairs === 1 ? 'seat' : 'seats'}` : ''}{plateNote}{room.notes.length ? ` · ${room.notes.join(' · ')}` : ''}</p>
</div>
</Card>
{pair && <slot name="side" />}
</Grid>
</Pair>

<script>
  // Focus, the layers and the room-to-room morph: one module for every drawing on the page (and for the unit
  // page, which borrows a drawing from src/pages/device/scene/).
