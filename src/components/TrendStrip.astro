---
/* TrendStrip: a small strip of bars, one per period (a month, a week), drawn in once the first time it is seen and then
   still (the library's km-draw-in, wired site-wide). Used for repeat faults and for warranties ending by month. The
   markup comes from src/lib/strip.mjs, so a page that draws in a script makes the same strip; styles are in
   src/styles/arrive.css. The markup is the end frame: with scripts off or reduced motion, the strip is simply there.
   Props:  bars    [{ label, n }] oldest first
           label   what the strip shows, for people who cannot see it ("Faults per month, last 12 months")
           tone    'fault' draws the bars in the fault ink, 'warn' in amber; otherwise the quiet ink
           height  px, 28 by default; step, px a bar, 14 by default
           ends    true: the first and last labels under the strip
           mark    the index of a bar to mark (the current period): it is drawn in full ink */
import '../styles/arrive.css';
import { trendStrip } from '../lib/strip.mjs';
interface Bar { label: string; n: number }
interface Props { bars: Bar[]; label: string; tone?: 'fault' | 'warn' | 'quiet'; height?: number; ends?: boolean; mark?: number; step?: number }
---
<Fragment set:html={trendStrip(Astro.props)} />
