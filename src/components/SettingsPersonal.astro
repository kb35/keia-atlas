---
/* Settings › You (/settings/#you; UX-V2 §5.2 and §5.3; rule P11): the look, light or dark, density, where pages
   open. Each is a row: its name, one line of what it does, its control.
   Stored in this browser as before: rs4-skin and rs4-theme (for the browser), rs6-density and rs6-depth
   (per person, src/lib/depth.mjs), all applied before first paint by the Shell's boot script.
   Motion: a look or a mode cross-fades the page (rsTheme) while the ring round the chosen look and the segment
   markers slide (M12); density eases rows and cards to their new size together, holding what you were looking at
   (rsChange, MOTION-V2 4.25); the depth line changes its words.
   Reduced motion: every change is at once. */
import { LOOKS, MODES } from '../lib/settings.mjs';
const DENSITY = [{ id: 'comfortable', name: 'Comfortable' }, { id: 'compact', name: 'Compact' }];
const DEPTH = [{ id: 'band', name: 'Band' }, { id: 'summary', name: 'Summary' }, { id: 'record', name: 'Record' }, { id: 'raw', name: 'Raw' }];
---
<ul class="card st-list" data-st-you>
  <li class="st-item st-block" data-fi data-find="look theme colours studio enterprise high contrast drawing set playful style">
    <div class="st-item-t"><b id="st-look-l">Look</b><small data-look-note>{LOOKS[0].name}: {LOOKS[0].note}</small></div>
    <div class="st-looks" role="radiogroup" aria-labelledby="st-look-l">
      <span class="st-look-mark" aria-hidden="true"></span>
      {LOOKS.map((l) => (
        <label class="st-look">
          <input type="radio" name="st-skin" value={l.id} />
          <span class="st-swatch" aria-hidden="true">{l.sw.map((c) => <i style={`background:${c}`}></i>)}</span>
          <b>{l.name}</b>
        </label>
      ))}
    </div>
  </li>
  <li class="st-item st-stack" data-fi data-find="appearance light dark auto mode colour theme night" data-help="shell.mode">
    <div class="st-item-t"><b id="st-mode-l">Appearance</b><small>Auto follows your device</small></div>
    <div class="st-seg" role="radiogroup" aria-labelledby="st-mode-l" data-seg>
      {MODES.map((m) => (<label><input type="radio" name="st-mode" value={m.id} /><span>{m.name}</span></label>))}
    </div>
  </li>
  <li class="st-item st-stack" data-fi data-find="density compact comfortable rows spacing dense" data-help="settings.density">
    <div class="st-item-t"><b id="st-density-l">Density</b><small>Smaller rows and cards. Nothing hidden.</small></div>
    <div class="st-seg" role="radiogroup" aria-labelledby="st-density-l" data-seg>
      {DENSITY.map((m) => (<label><input type="radio" name="st-density" value={m.id} /><span>{m.name}</span></label>))}
    </div>
  </li>
  <li class="st-item st-stack" data-fi data-find="where pages open depth layer band summary record raw" data-help="settings.depth">
    <div class="st-item-t"><b id="st-depth-l">Where pages open</b><small data-depth-note>Every page opens at the top.</small></div>
    <div class="st-seg" role="radiogroup" aria-labelledby="st-depth-l" data-seg>
      {DEPTH.map((m) => (<label><input type="radio" name="st-depth" value={m.id} /><span>{m.name}</span></label>))}
    </div>
  </li>
</ul>

<script is:inline data-astro-rerun define:vars={{ LOOKS }}>
  (function () {
    var box = document.querySelector('[data-st-you]'); if (!box || box.__st) return; box.__st = true;
    var W = window, R = document.documentElement;
    var who = function () { return W.rsWhoId ? W.rsWhoId() : 'anna'; };
    var KINDS = ['home', 'space', 'device', 'job', 'service', 'project', 'office', 'vendor'];
    var get = function (k, d) { try { return localStorage.getItem(k) || d; } catch (_) { return d; } };
    var put = function (k, v) { try { localStorage.setItem(k, v); } catch (_) {} };
    var read = function (k) { try { return JSON.parse(localStorage.getItem(k) || '{}') || {}; } catch (_) { return {}; } };
    var write = function (k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (_) {} };
    var NOTE = {}; LOOKS.forEach(function (l) { NOTE[l.id] = l.name + ': ' + l.note; });
    // The ring on the chosen look slides from card to card (and row to row on a phone).
    function markLook() {
      var g = box.querySelector('.st-looks'), mk = g.querySelector('.st-look-mark'), on = g.querySelector('.st-look:has(input:checked)');
      if (!on || !on.offsetWidth) { mk.classList.remove('on'); return; }
      var first = !mk.classList.contains('on');
      if (first) mk.style.transition = 'none';
      mk.style.width = on.offsetWidth + 'px'; mk.style.height = on.offsetHeight + 'px';
      mk.style.transform = 'translate(' + on.offsetLeft + 'px,' + on.offsetTop + 'px)';
      if (first) { mk.classList.add('on'); void mk.offsetWidth; mk.style.transition = ''; }
    }
    function sync() {
      var s = get('rs4-skin', 'studio'), t = get('rs4-theme', 'system'), d = R.getAttribute('data-density') || 'comfortable';
      box.querySelectorAll('input[name=st-skin]').forEach(function (i) { i.checked = i.value === s; });
      box.querySelectorAll('input[name=st-mode]').forEach(function (i) { i.checked = i.value === t; });
      box.querySelectorAll('input[name=st-density]').forEach(function (i) { i.checked = i.value === d; });
      var ln = box.querySelector('[data-look-note]'); if (ln) ln.textContent = NOTE[s] || NOTE.studio;
      // One layer for every kind of page, or "Mixed" when "Open pages like this here" has set some kinds deeper than others.
      var mine = read('rs6-depth')[who()] || {}, vals = KINDS.map(function (k) { return mine[k] || 'band'; });
      var same = vals.every(function (v) { return v === vals[0]; });
      box.querySelectorAll('input[name=st-depth]').forEach(function (i) { i.checked = same && i.value === vals[0]; });
      var note = box.querySelector('[data-depth-note]');
      if (note) note.textContent = !same ? 'Mixed: some pages open deeper than others.' : vals[0] === 'band' ? 'Every page opens at the top.' : 'Every page opens at its ' + vals[0] + ' layer.';
      markLook();
      box.querySelectorAll('[data-seg]').forEach(function (g) {
        if (W.rsMarker) W.rsMarker(g, function () { var i = g.querySelector('input:checked'); return i && i.closest('label'); });
      });
    }
    box.addEventListener('change', function (e) {
      var i = e.target, v = i.value;
      if (i.name === 'st-skin') { put('rs4-skin', v); W.rsTheme(function () { W.rsApplyTheme(); if (W.rsSyncMode) W.rsSyncMode(); sync(); }, v); }
      if (i.name === 'st-mode') { put('rs4-theme', v); W.rsTheme(function () { W.rsApplyTheme(); if (W.rsSyncMode) W.rsSyncMode(); }); }
      if (i.name === 'st-density') {
        var all = read('rs6-density'); all[who()] = v; write('rs6-density', all);
        var set = function () { R.setAttribute('data-density', v); };
        if (W.rsChange) W.rsChange(set); else set();
      }
      if (i.name === 'st-depth') {
        var dp = read('rs6-depth');
        if (v === 'band') delete dp[who()]; else dp[who()] = KINDS.reduce(function (o, k) { o[k] = v; return o; }, {});
        write('rs6-depth', dp);
        if (W.rsDepthLabels) W.rsDepthLabels();
      }
      sync();
    });
    // The quick menu, View as and Reset the demo change these too: follow them.
    ['rs:settings-change', 'rs:demo-change', 'rs:a11y'].forEach(function (ev) { document.addEventListener(ev, function () { if (box.isConnected) sync(); }); });
    if (W.ResizeObserver) new ResizeObserver(function () { markLook(); }).observe(box);
    // (on a first visit the Shell's helpers, rsModules, rsMarker and the rest, are defined after this script)
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { sync(); }, { once: true }); else sync();
  })();
</script>
