---
/* The person's own settings inside Settings (UX-V2 §5.2 and §5.3; rule P11): density, where pages open, and the demo
   switch for coming back from leave. Stored per person in this browser: rs6-density, rs6-depth (src/lib/depth.mjs),
   rs6-leave and rs6-welcomed. Density is applied before first paint by the Shell's boot script (html[data-density]).
   Motion: density eases rows and cards to their new size together, holding what you were looking at (rsChange,
   MOTION-V2 4.25); the reset line changes its words and nothing else (4.27). */
import '../styles/density.css';
---
<div class="set-row set-personal">
  <fieldset data-help="settings.density">
    <legend class="overline">Density</legend>
    <div class="seg-s" data-seg>
      <label><input type="radio" name="density" value="comfortable" /><span>Comfortable</span></label>
      <label><input type="radio" name="density" value="compact" /><span>Compact</span></label>
    </div>
  </fieldset>
  <fieldset data-help="settings.depth">
    <legend class="overline">Where pages open</legend>
    <button type="button" class="set-link" data-depth-reset>Open everything at the band again</button>
  </fieldset>
</div>
<fieldset data-help="settings.leave">
  <legend class="overline">Demo: time away</legend>
  <label class="set-switch"><input type="checkbox" name="leave" data-leave /><span class="sw" aria-hidden="true"></span><span>Aoife is back today from two weeks' leave <small class="faint">Her Home opens on Welcome back, once; Marcus sees the cover card until then</small></span></label>
</fieldset>

<script is:inline data-astro-rerun>
  (function () {
    var dlg = document.querySelector('dialog#settings'); if (!dlg) return;
    var W = window, R = document.documentElement;
    var who = function () { return W.rsWhoId ? W.rsWhoId() : 'aoife'; };
    var read = function (k) { try { return JSON.parse(localStorage.getItem(k) || '{}') || {}; } catch (_) { return {}; } };
    var write = function (k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (_) {} };
    function sync() {
      var d = R.getAttribute('data-density') || 'comfortable';
      dlg.querySelectorAll('input[name=density]').forEach(function (i) { i.checked = i.value === d; });
      var on = false; try { on = localStorage.getItem('rs6-leave') === 'on'; } catch (_) {}
      var lv = dlg.querySelector('[data-leave]'); if (lv) lv.checked = on;
      var dp = read('rs6-depth')[who()], b = dlg.querySelector('[data-depth-reset]');
      if (b && !b.__busy) { b.disabled = !dp || !Object.keys(dp).length; b.textContent = b.disabled ? 'Every page opens at the band' : 'Open everything at the band again'; }
    }
    if (dlg.__rsPersonal) { sync(); return; }
    dlg.__rsPersonal = true;
    dlg.addEventListener('change', function (e) {
      var i = e.target;
      if (i.name === 'density') {
        var all = read('rs6-density'); all[who()] = i.value; write('rs6-density', all);
        var set = function () { R.setAttribute('data-density', i.value); };
        if (W.rsChange) W.rsChange(set); else set();
      }
      if (i.name === 'leave') {
        try { if (i.checked) { localStorage.setItem('rs6-leave', 'on'); localStorage.removeItem('rs6-welcomed'); } else localStorage.removeItem('rs6-leave'); } catch (_) {}
        document.dispatchEvent(new CustomEvent('rs:leave', { detail: { on: i.checked } }));
      }
    });
    dlg.addEventListener('click', function (e) {
      var b = e.target.closest('[data-depth-reset]'); if (!b) return;
      var all = read('rs6-depth'); delete all[who()]; write('rs6-depth', all);
      b.__busy = true; b.textContent = 'Every page now opens at the band'; b.disabled = true;
      if (W.rsDepthLabels) W.rsDepthLabels();
      var linger = parseFloat(getComputedStyle(R).getPropertyValue('--dur-linger')) || 4000;
      setTimeout(function () { b.__busy = false; sync(); }, linger);
    });
    // Settings calls its own sync when it opens; follow it.
    new MutationObserver(function () { if (dlg.open) { sync(); if (dlg.__rsPlace) dlg.__rsPlace(); } }).observe(dlg, { attributes: true, attributeFilter: ['open'] });
    sync();
  })();
</script>

<style is:global>
  .settings .set-personal { grid-template-columns: auto 1fr; align-items: start; }
  .settings .set-link { appearance: none; border: 0; background: none; padding: 7px 0; font: 500 13px/1.3 var(--font-sans); color: var(--accent-ink); text-align: left; cursor: pointer; border-radius: var(--radius); }
  .settings .set-link:hover:not(:disabled) { text-decoration: underline; text-underline-offset: 2px; }
  .settings .set-link:disabled { color: var(--text-3); cursor: default; }
  .settings .set-switch { display: flex; align-items: center; gap: 10px; cursor: pointer; font-size: 13.5px; }
  .settings .set-switch small { display: block; font-size: 12px; }
  .settings .set-switch input { position: absolute; opacity: 0; pointer-events: none; }
  .settings .set-switch .sw { position: relative; flex: none; width: 34px; height: 20px; border-radius: 999px; background: var(--surface-3); box-shadow: inset 0 0 0 1px var(--line-strong); transition: background-color var(--dur-state) var(--ease-settle); }
  .settings .set-switch .sw::after { content: ""; position: absolute; top: 3px; left: 3px; width: 14px; height: 14px; border-radius: 50%; background: var(--surface); box-shadow: 0 1px 2px rgba(0, 0, 0, .2); transition: transform var(--dur-state) var(--ease-settle); }
  .settings .set-switch input:checked + .sw { background: var(--ink); }
  .settings .set-switch input:checked + .sw::after { transform: translateX(14px); }
  .settings .set-switch input:focus-visible + .sw { outline: 2px solid var(--focus); outline-offset: 2px; }
  @media (max-width: 420px) { .settings .set-personal { grid-template-columns: 1fr; } }
</style>
