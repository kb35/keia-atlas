---
/* IntegrateLive: the live part of a project's Deploy pages (overview, batch, room).
   Carries the plan (src/lib/integrate.mjs) to the browser and loads src/lib/integrate-client.mjs, which
   replays the live events over it and repaints every [data-slot] and [data-cell] inside the page's
   [data-int] root. The markup comes from src/lib/integrate-view.mjs, which the pages also use to draw
   the plan as built, so nothing jumps when the browser takes over. Styles for the shared pieces (step
   glyphs, cells, meters, the Needs you and Checked lists, unit detail, setup order, room test, installs)
   live here, once.
   Props:  plan   integratePlan(project) */
interface Props { plan: any }
const { plan } = Astro.props;
const json = JSON.stringify(plan).replace(/</g, '\\u003c');
---
<script type="application/json" data-int-plan set:html={json}></script>
<script>
  import '../lib/integrate-client.mjs';
</script>

<style is:global>
  /* ---- A step glyph: a ring that fills and draws its tick as the state changes (M2, state) ---- */
  .ig { position: relative; flex: none; width: 16px; height: 16px; border-radius: 50%; display: inline-grid; place-items: center; box-sizing: border-box; border: 1.5px solid var(--line-strong); color: transparent; background: transparent; transition: background-color var(--dur-state) var(--ease-settle), border-color var(--dur-state) var(--ease-settle), color var(--dur-state) var(--ease-settle); }
  .ig svg { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .ig .ig-t { stroke-dasharray: 12; stroke-dashoffset: 12; transition: stroke-dashoffset var(--dur-state) var(--ease-settle); }
  .ig .ig-x { opacity: 0; transition: opacity var(--dur-state) var(--ease-settle); }
  .ig[data-st=todo] { border-color: color-mix(in srgb, var(--text-3) 70%, transparent); }
  .ig[data-st=doing] { border-color: var(--text-3); background: conic-gradient(var(--text-3) 0 50%, transparent 0); }
  /* Every state is a ring (UI-V2 §6, one glyph family): Fine's closed ring, with a tick when a person accepted it; nothing is a filled disc. */
  .ig[data-st=verified] { border-color: var(--h-fine); background: var(--h-fine-soft); color: var(--h-fine-ink); }
  .ig[data-st=verified] .ig-t, .ig[data-st=done] .ig-t { stroke-dashoffset: 0; }
  .ig[data-st=done] { border-color: var(--h-fine); background: transparent; color: var(--h-fine-ink); }
  .ig[data-st=issue] { border-color: var(--h-review); background: transparent; color: var(--h-review-ink, var(--amber-ink)); }
  .ig[data-st=issue] .ig-x { opacity: 1; }
  .ig[data-st=blocked] { border-style: dashed; border-color: var(--text-3); }
  .ig[data-st=na] { border-style: dotted; border-color: var(--line); }
  @keyframes ig-spin { to { transform: rotate(1turn); } }
  .checking .ig, .ig.checking { border-color: var(--text-3); border-top-color: transparent; background: none; color: transparent; transform: rotate(45deg); }

  /* ---- A step cell in a unit row ---- */
  .ic { appearance: none; border: 0; background: none; font: inherit; color: var(--text); text-align: left; display: grid; grid-template-columns: 16px minmax(0, 1fr); align-items: center; gap: 8px; width: 100%; min-width: 0; padding: 6px 8px; border-radius: var(--radius); cursor: pointer; transition: background-color var(--dur-hover) var(--ease-settle); }
  .ic:hover { background: var(--surface-2); }
  .ic:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
  .ic.na { cursor: default; color: var(--text-3); font-size: var(--fs-code); grid-template-columns: minmax(0, 1fr); }
  .ic-w { display: grid; min-width: 0; }
  .ic-l { font-size: var(--fs-support); font-weight: 600; line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: color var(--dur-state) var(--ease-settle); }
  .ic-s { font-size: var(--fs-mark); line-height: 1.3; color: var(--text-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ic[data-st=todo] .ic-l, .ic[data-st=blocked] .ic-l { color: var(--text-2); font-weight: 500; }
  .ic[data-st=verified] .ic-l { color: var(--green-ink); }
  .ic[data-st=issue] .ic-l { color: var(--amber-ink); }
  .ic .rs-changed-mark { grid-column: 1 / -1; }

  /* ---- Batch meters: one segment per unit, filling from the left ---- */
  .im { display: grid; gap: 5px; min-width: 0; }
  .im-h { display: flex; justify-content: space-between; gap: 8px; font-size: var(--fs-code); color: var(--text-2); }
  .im-h b { font: 600 var(--fs-code)/1 var(--font-mono); color: var(--text); }
  .im-segs { display: flex; gap: 3px; }
  .im-segs i { --c: var(--surface-3); --f: 0%; flex: 1 1 0; min-width: 4px; height: 6px; border-radius: 3px; background: linear-gradient(var(--c) 0 0) no-repeat left / var(--f) 100%, var(--surface-3); transition: background-size var(--dur-morph) var(--ease-settle); }
  .im-segs i[data-st=doing] { --c: color-mix(in srgb, var(--text-3) 60%, transparent); --f: 50%; }
  .im-segs i[data-st=verified] { --c: color-mix(in srgb, var(--green) 45%, transparent); --f: 100%; }
  .im-segs i[data-st=done] { --c: var(--green); --f: 100%; }
  .im-segs i[data-st=issue] { --c: var(--amber); --f: 100%; }
  .im-segs i[data-st=na] { opacity: .35; }

  /* ---- The one line at a card's foot ---- */
  .bf { display: inline-flex; align-items: center; gap: 8px; font-size: var(--fs-support); color: var(--text-2); }
  .bf.needs { color: var(--amber-ink); font-weight: 600; }
  .bf.accept { color: var(--green-ink); font-weight: 600; }
  .bf.done { color: var(--text-2); }
  .nd-dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--amber); }

  /* ---- Needs you ---- */
  .nd-list, .rd-list, .vi-list, .rt-list { list-style: none; margin: 0; padding: 0; display: grid; }
  .nd { display: grid; grid-template-columns: 8px minmax(0, 1fr) auto; gap: 4px 12px; align-items: start; padding: 12px 0; border-top: 1px solid var(--line); }
  .nd:first-child { border-top: 0; padding-top: 2px; }
  .nd .nd-dot { margin-top: 7px; }
  .nd.quiet .nd-dot { background: var(--text-3); }
  .nd-b { display: grid; gap: 2px; min-width: 0; }
  .nd-b p { margin: 0; }
  .nd-w { font-size: var(--fs-code); color: var(--text-3); }
  .nd-w a { color: inherit; }
  .nd-t { font-size: var(--fs-body); font-weight: 600; line-height: 1.35; overflow-wrap: anywhere; }
  .nd-f { font-size: var(--fs-support); color: var(--text-2); line-height: 1.4; }
  .nd.quiet .nd-t { font-weight: 500; }
  .nd-a { display: flex; gap: 6px; align-items: center; }
  .nd-host { display: flex; gap: 6px; }
  .nd-host input { width: 150px; font: 500 var(--fs-code)/1 var(--font-mono); padding: 7px 8px; border: 1px solid var(--line-strong); border-radius: var(--radius); background: var(--surface); color: var(--text); }
  .nd-none, .rd-none { margin: 0; display: flex; align-items: center; gap: 10px; font-size: var(--fs-body); color: var(--text-2); }
  .nd-more { margin: 6px 0 0 20px; font-size: var(--fs-code); }

  /* ---- Checked by Keia Atlas, ready to accept ---- */
  .rd { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px 14px; align-items: center; padding: 12px 0; border-top: 1px solid var(--line); }
  .rd:first-child { border-top: 0; padding-top: 2px; }
  .rd-b { display: grid; gap: 3px; min-width: 0; }
  .rd-b p { margin: 0; }
  .rd-t { display: flex; align-items: center; gap: 8px; font-size: var(--fs-body); }
  .rd-e { font-size: var(--fs-code); line-height: 1.4; color: var(--text-2); padding-left: 24px; }
  .rd-all { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 12px; margin-top: 4px; padding-top: 12px; border-top: 1px solid var(--line); font-size: var(--fs-code); color: var(--text-2); }

  /* ---- A unit's detail ---- */
  .ud-top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 16px; align-items: center; }
  .ud-top p { margin: 0; }
  .ud-meta { font-size: var(--fs-code); color: var(--text-2); }
  .ud-links { display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: center; font-size: var(--fs-code); }
  .ud-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px 24px; margin-top: 12px; }
  .ud-s { display: grid; gap: 6px; align-content: start; min-width: 0; }
  .ud-s h4 { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; font-size: var(--fs-support); }
  .ud-s h4 small { font-weight: 500; color: var(--text-3); font-size: var(--fs-code); }
  .ud-l { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .ud-c { display: grid; grid-template-columns: 16px minmax(0, 1fr); gap: 8px; align-items: start; font-size: var(--fs-code); }
  .ud-c .ig { width: 14px; height: 14px; margin-top: 1px; }
  .ud-c span { display: grid; min-width: 0; }
  .ud-c small { color: var(--text-3); font-size: var(--fs-mark); overflow-wrap: anywhere; }
  .ud-c .ud-f { color: var(--text-2); font-family: var(--font-mono); font-size: var(--fs-mark); }
  .ud-c[data-ok=no] .ud-f { color: var(--text-2); }
  .ud-why { margin: 0; font-size: var(--fs-code); color: var(--text-2); font-style: italic; }
  .ud-b { margin: 0; }
  .ud-own { margin: 10px 0 0; display: flex; flex-wrap: wrap; gap: 4px 18px; font-size: var(--fs-code); }
  .ud-own dt { color: var(--text-3); } .ud-own div { display: flex; gap: 6px; } .ud-own dd { margin: 0; font-family: var(--font-mono); font-size: var(--fs-code); }
  .ud-reason { display: grid; gap: 8px; margin-top: 6px; padding: 10px 12px; border-radius: var(--radius); background: var(--surface-2); font-size: var(--fs-support); }
  .ud-reason p { margin: 0; }
  .ud-rc, .ud-ri { display: flex; flex-wrap: wrap; gap: 6px; }
  .ud-ri input { flex: 1 1 140px; min-width: 0; font: inherit; font-size: var(--fs-support); padding: 6px 8px; border: 1px solid var(--line-strong); border-radius: var(--radius); background: var(--surface); color: var(--text); }
  .rs-chip { appearance: none; border: 1px solid var(--line); background: var(--surface); color: var(--text); font: 500 var(--fs-code)/1 var(--font-sans); padding: 7px 10px; border-radius: var(--pill-radius); cursor: pointer; }
  .rs-chip:hover { border-color: var(--line-strong); }

  /* ---- The shared setup ---- */
  .sh-st { margin: 0; display: grid; grid-template-columns: 16px minmax(0, 1fr); gap: 10px; align-items: start; font-size: var(--fs-body); line-height: 1.45; color: var(--text-2); }
  .sh-st .ig { margin-top: 2px; }
  .sh-st b { color: var(--text); }
  .sh-acts { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .sh-agent { display: grid; gap: 6px; padding: 12px 14px; border-radius: var(--radius); background: var(--violet-soft); font-size: var(--fs-support); }
  .sh-agent p { margin: 0; }
  .sh-ah { font-weight: var(--fw-title); color: var(--violet-ink); }
  .sh-none { margin: 0; font-size: var(--fs-body); color: var(--text-2); }
  :root[data-agents="off"] [data-act="handoff"] { display: none; }

  /* ---- The setup order: the next step open, the rest one line ---- */
  .su { list-style: none; margin: 0; padding: 0; display: grid; }
  .su-i { border-top: 1px solid var(--line); }
  .su-i:first-child { border-top: 0; }
  .su-i > details > summary { list-style: none; display: grid; grid-template-columns: 16px 22px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 10px 4px; cursor: pointer; font-size: var(--fs-body); }
  .su-i > details > summary::-webkit-details-marker { display: none; }
  .su-i.all .su-t { color: var(--text-2); }
  .su-n { font: 600 var(--fs-mark)/1 var(--font-mono); color: var(--text-3); }
  .su-t { font-weight: 600; display: inline-flex; align-items: center; gap: 8px; min-width: 0; }
  .su-first { width: 6px; height: 6px; border-radius: 50%; background: var(--text); flex: none; }
  .su-c { font: 600 var(--fs-code)/1 var(--font-mono); color: var(--text-3); }
  .su-body { display: grid; gap: 8px; padding: 0 4px 14px 58px; font-size: var(--fs-support); color: var(--text-2); }
  .su-body p { margin: 0; line-height: 1.45; }
  .su-path { font-size: 12px; color: var(--text-3); }
  .su-note { font-weight: 600; color: var(--text); }
  .su-why summary { cursor: pointer; font-weight: 600; color: var(--text); font-size: var(--fs-code); }
  .su-why p { margin-top: 4px; }
  .su-chips { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .su-chip { appearance: none; display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--line); background: var(--surface); color: var(--text); font: 500 var(--fs-code)/1 var(--font-sans); padding: 6px 10px 6px 7px; border-radius: var(--pill-radius); cursor: pointer; transition: border-color var(--dur-hover) var(--ease-settle); }
  .su-chip .ig { width: 14px; height: 14px; }
  .su-chip:hover { border-color: var(--line-strong); }
  @container content (max-width: 559px) { .su-body { padding-left: 4px; } }

  /* ---- The room test ---- */
  .rt { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px 14px; align-items: center; padding: 12px 0; border-top: 1px solid var(--line); }
  .rt:first-child { border-top: 0; padding-top: 2px; }
  .rt-b { display: grid; grid-template-columns: 16px minmax(0, 1fr); gap: 10px; align-items: start; }
  .rt-b .ig { margin-top: 2px; }
  .rt-b span { display: grid; gap: 2px; min-width: 0; }
  .rt-b b { font-size: var(--fs-body); }
  .rt-b small { font-size: var(--fs-code); color: var(--text-2); line-height: 1.4; }
  .rt-b .rt-note { color: var(--amber-ink); font-weight: 600; }
  .rt-a { display: inline-flex; padding: 3px; gap: 2px; border-radius: var(--pill-radius); border: 1px solid var(--line); background: var(--surface); }
  .rt-btn { appearance: none; border: 0; background: none; font: 600 var(--fs-code)/1 var(--font-sans); color: var(--text-2); padding: 7px 12px; border-radius: var(--pill-radius); cursor: pointer; transition: background-color var(--dur-state) var(--ease-settle), color var(--dur-state) var(--ease-settle); }
  .rt-btn[data-r=pass][aria-pressed=true] { background: var(--green-soft); color: var(--green-ink); }
  .rt-btn[data-r=fail][aria-pressed=true] { background: var(--amber-soft); color: var(--amber-ink); }
  .rt-fail { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 6px; padding-left: 26px; }
  .rt-fail[hidden] { display: none; }
  .rt-fail input { flex: 1 1 200px; min-width: 0; font: inherit; font-size: var(--fs-support); padding: 7px 9px; border: 1px solid var(--line-strong); border-radius: var(--radius); background: var(--surface); color: var(--text); }
  .rt-go, .rt-signed, .rt-wait { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin: 14px 0 0; padding-top: 14px; border-top: 1px solid var(--line); font-size: var(--fs-support); }
  .rt-signed > span:not(.ig), .rt-wait > span:not(.ig) { flex: 1 1 200px; }
  .rt-wait { color: var(--text-2); }

  /* ---- Installs (a vendor's view, and the room page) ---- */
  .vi { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 12px; align-items: center; padding: 10px 0; border-top: 1px solid var(--line); }
  .vi:first-child { border-top: 0; }
  .vi-b { display: grid; grid-template-columns: 16px minmax(0, 1fr); gap: 10px; align-items: start; }
  .vi-b .ig { margin-top: 2px; }
  .vi-b > span { display: grid; gap: 1px; min-width: 0; }
  .vi-b b { font-size: var(--fs-body); }
  .vi-b small { font-size: var(--fs-code); color: var(--text-3); }
  .vi-b .vi-s { color: var(--green-ink); }
  .vi-more { grid-column: 1 / -1; padding-left: 26px; font-size: var(--fs-code); }
  .vi-more summary { cursor: pointer; color: var(--text-2); }
  .vi-form { display: flex; flex-wrap: wrap; gap: 8px; align-items: end; margin-top: 6px; }
  .vi-form label { display: grid; gap: 3px; font-size: var(--fs-code); color: var(--text-3); }
  .vi-form input { font: inherit; font-size: var(--fs-code); padding: 6px 8px; border: 1px solid var(--line-strong); border-radius: var(--radius); background: var(--surface); color: var(--text); max-width: 100%; }
  .vi-none { margin: 0; font-size: var(--fs-support); }

  /* ---- Deliver by: one control, the same units grouped the team's way ---- */
  .dv-ctl { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin: 26px 0 14px; }
  .dv-ctl-h { margin: 0; font-size: var(--fs-h3); }
  .dv-seg { position: relative; display: inline-flex; height: 38px; padding: 3px; gap: 2px; border-radius: var(--pill-radius); border: 1px solid var(--line); background: var(--surface); max-width: 100%; }
  .dv-opt { position: relative; z-index: 1; appearance: none; border: 0; background: none; padding: 0 14px; border-radius: var(--pill-radius); font: 600 var(--fs-support)/1 var(--font-sans); color: var(--text-2); cursor: pointer; white-space: nowrap; transition: background-color var(--dur-state) var(--ease-settle), color var(--dur-state) var(--ease-settle); }
  .dv-opt:hover { color: var(--text); background: var(--surface-2); }
  .dv-opt:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
  .dv-opt[aria-pressed=true] { background: var(--ink); color: var(--on-ink); }
  .dv-seg.rs-marked .dv-opt[aria-pressed=true], .dv-seg.rs-marked .dv-opt[aria-pressed=true]:hover { background: none; color: var(--on-ink); }
  .dv-short { display: none; }
  .dv-team { flex: 1 1 100%; margin: 0; font-size: var(--fs-support); color: var(--text-2); line-height: 1.45; }
  .dv-team b { color: var(--text); font-weight: 600; }
  .dv-link { appearance: none; border: 0; background: none; padding: 0; font: inherit; font-weight: 600; color: var(--link, var(--text)); text-decoration: underline; text-underline-offset: 2px; cursor: pointer; }
  @container content (max-width: 559px) {
    .dv-seg { width: 100%; }
    .dv-opt { flex: 1 1 auto; padding: 0 6px; }
    .dv-full { display: none; }
    .dv-short { display: inline; }
  }
  .dv-box { position: relative; }
  .dv-setslot { display: grid; gap: 12px; margin-bottom: 14px; }
  .dv-setslot[hidden] { display: none; }
  .dv-groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: var(--gutter); align-items: start; }
  .dv-g { display: grid; gap: 12px; align-content: start; padding: 16px 18px; min-width: 0; }
  .dv-g[hidden] { display: none; }
  .dv-gh { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 10px; align-items: start; }
  .dv-gh:not(:has(.iv-n)) { grid-template-columns: minmax(0, 1fr) auto; }
  .dv-gt { display: grid; gap: 2px; min-width: 0; }
  .dv-gt b { font-size: var(--fs-h3); line-height: 1.3; overflow-wrap: anywhere; }
  .dv-gl { color: var(--text); text-decoration: none; }
  .dv-gl:hover b { text-decoration: underline; text-underline-offset: 3px; }
  .dv-gl:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-radius: 4px; }
  .dv-gt small { font-size: var(--fs-code); color: var(--text-2); }
  .dv-gc { font: 600 var(--fs-code)/1.6 var(--font-mono); color: var(--text-2); white-space: nowrap; }
  .dv-ans { margin: 0; font-size: var(--fs-body); line-height: 1.45; color: var(--text); overflow-wrap: anywhere; }
  .dv-g[data-st=needs] .dv-ans::before, .dv-cur .dv-ans::before { content: ''; display: inline-block; width: 8px; height: 8px; margin-right: 8px; border-radius: 50%; background: var(--amber); vertical-align: 1px; }
  .dv-cur .dv-ans::before { display: none; }
  .dv-meters { display: grid; grid-template-columns: repeat(auto-fit, minmax(96px, 1fr)); gap: 10px 12px; }
  .dv-meters .im-h { flex-wrap: wrap; column-gap: 6px; }
  .im-bar { display: flex; height: 6px; border-radius: 3px; overflow: hidden; background: var(--surface-3); }
  .im-bar i { display: block; height: 100%; transition: width var(--dur-morph) var(--ease-settle); }
  .im-bar i[data-st=done] { background: var(--green); }
  .im-bar i[data-st=verified] { background: color-mix(in srgb, var(--green) 45%, transparent); }
  .im-bar i[data-st=issue] { background: var(--amber); }
  .im-bar i[data-st=doing] { background: color-mix(in srgb, var(--text-3) 60%, transparent); }
  .dv-list { list-style: none; margin: 0; padding: 0; display: grid; }
  .dv-u { display: grid; grid-template-columns: minmax(min(12ch, 50%), 1fr) minmax(0, max-content) auto; gap: 2px 12px; align-items: center; padding: 7px 0; border-top: 1px solid var(--line); background: var(--surface); }
  .dv-list > .dv-u:first-child { border-top: 0; }
  .dv-u.fb-out { display: none; }
  .dv-ub { display: grid; grid-template-columns: 16px minmax(0, 1fr); gap: 10px; align-items: start; min-width: 0; color: var(--text); text-decoration: none; border-radius: 4px; }
  .dv-ub > .ig { margin-top: 2px; }
  .dv-ub:hover b { text-decoration: underline; }
  .dv-ub:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .dv-un { display: grid; min-width: 0; }
  .dv-un b { font-size: var(--fs-support); font-weight: 600; line-height: 1.3; overflow-wrap: anywhere; }
