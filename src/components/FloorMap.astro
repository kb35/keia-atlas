---
// A floor plan to scale, drawn from the building model in src/lib/floors.mjs: the outline, the
// core, corridors and named areas, every room at its place with its number and door, the comms room's rack, the
// riser, the trays (and, with `cables`, every run on the floor in its purpose colour) and the access points. Each kind
// of space and building element has its own tint or symbol (stair treads, a cross per lift car, hatched stores, each
// desk drawn, filled when assigned), named in the key below the plan. It is
// the check on the data, and the 3D view's other half (decision 0030): the phone view, the keyboard route and the
// view when a browser can't draw 3D. The fictional label (rule F9) is always shown.
//
// Props: site, floor, cables (draw the runs), highlight (a room id to mark), interactive (rooms, racks, access
// points and runs carry data-sel keys, and rooms, racks and access points can be focused and chosen with Enter;
// the page's script does the choosing: src/lib/office3d-client.mjs).
//
// On a narrow box (under 520 px) the plan turns a quarter turn, so its long side runs down the screen and rooms
// stay big enough to read and tap (as room plans do on cards, rooms.md R6); the words stay upright.
import { building } from '../lib/floors.mjs';
import { doorOf } from '../lib/office3d.mjs';
import { shape } from '../lib/health.mjs';
import Restricted from '../components/Restricted.astro';


interface Props { site: string; floor: string; cables?: boolean; highlight?: string | null; interactive?: boolean }
const { site, floor, cables = false, highlight = null, interactive = false } = Astro.props;
const M = building(site);
const F = M?.floors.find((f) => f.id === floor) ?? null;
const rooms = F ? Object.values(M.rooms).filter((r) => r.floor === floor && r.rect) : [];
const xs = F ? F.outline.map((p) => p[0]) : [0], ys = F ? F.outline.map((p) => p[1]) : [0];
const W = Math.max(...xs), H = Math.max(...ys);
const pad = 1.5;
// Plan y runs north (up); SVG y runs down.
const Y = (y) => H - y;
const rectAttrs = ([x0, y0, x1, y1]) => ({ x: x0, y: Y(y1), width: x1 - x0, height: y1 - y0 });
const pts = (P) => P.map(([x, y]) => `${x},${Y(y)}`).join(' ');
const runs = cables && M ? M.runs.filter((r) => r.floor === floor && r.path) : [];
const racks = M ? M.racks.filter((r) => r.floor === floor && r.at) : [];
const aps = M ? M.aps.filter((a) => a.floor === floor) : [];
const label = (r) => r.number ?? r.name;
const roomName = (r) => `${r.number ? `${r.number} ` : ''}${r.name}`;
const apModel = (a) => (a.model === 'unifi-u7-pro-max' ? 'U7 Pro Max' : 'U7 Pro');
const pick = (key, name) => (interactive ? { 'data-sel': key, tabindex: 0, role: 'button', 'aria-label': name, 'aria-pressed': 'false' } : {});
const coreLabel = { stair: 'Stairs', lift: 'Lifts', riser: 'Riser', toilets: 'WC' };
// What each space is, for its fill and the key (rooms.md R10): one look per kind, the same in the 3D views.
const KIND_OF = (t) => (t === 'mdf' || t === 'idf' ? 'comms' : t === 'workstation-assigned' ? 'assigned' : t?.startsWith('workstation') ? 'flex'
  : t === 'reception-concierge' ? 'reception' : ['pantry', 'pantry-expanded', 'cafeteria'].includes(t) ? 'pantry' : ['copy-print-room', 'it-store'].includes(t) ? 'print'
  : t === 'focus-room' || t === 'office' || t?.startsWith('huddle-room') ? 'small' : 'meeting');
const KEY_WORD = { meeting: 'Meeting rooms', small: 'Focus, huddle and offices', reception: 'Reception', pantry: 'Pantry and café', print: 'Print and storage', flex: 'Flex desks', assigned: 'Assigned desks', comms: 'Comms room',
  stair: 'Stairs', lift: 'Lifts', toilets: 'Toilets', riser: 'Riser', store: 'Stores and ducts', 'town-hall': 'Town hall', breakout: 'Breakout', corridor: 'Corridors' };
const coreKind = (k) => (k === 'shaft' || k === 'plant' ? 'store' : k);
const pid = `fm-${site}-${floor}`;
const present = F ? [...new Set([
  ...rooms.map((r) => KIND_OF(r.space_type)),
  ...F.core.filter((c) => !c.circulation).map((c) => coreKind(c.kind)),
  ...F.areas.map((a) => a.kind),
  'corridor',
])] : [];
const KEY_ORDER = ['meeting', 'small', 'reception', 'pantry', 'print', 'flex', 'assigned', 'town-hall', 'breakout', 'corridor', 'stair', 'lift', 'toilets', 'riser', 'comms', 'store'];
const keyItems = KEY_ORDER.filter((k) => present.includes(k));
// A lift bank's cars, side by side along its long side.
const cars = (c) => {
  const n = c.count ?? 1, [x0, y0, x1, y1] = c.rect, alongX = x1 - x0 >= y1 - y0;
  return Array.from({ length: n }, (_, i) => (alongX ? [x0 + ((x1 - x0) / n) * i, y0, x0 + ((x1 - x0) / n) * (i + 1), y1] : [x0, y0 + ((y1 - y0) / n) * i, x1, y0 + ((y1 - y0) / n) * (i + 1)]));
};
// Each room's health glyph (UI-V2 §6): one ring (the km-ring, src/lib/health.mjs) at the room's centre under its number,
// shown once the page gives the room a live state (data-st: Fine, or Fault when not working). On a page with lenses
// (the office, LensStrip.astro) the figure carries data-lens and the page's script sets each room's data-h and the
// ring's data-s, so a lens switch eases every ring to its new state in place (MOTION-V2 4.9). Under the ring, a lens
// label (.fm-lt) the script fills: "2 jobs", "PRJ-16", "Keystone". data-w is the room's width, so a label that does
// not fit is left out rather than cut.
const GLYPH = shape('fine');
---
{F && (
  <figure class:list={['floormap', { 'fm-pick': interactive }]} data-fm={floor} data-fm-w={W} data-fm-h={H} data-fm-pad={pad}>
    <svg viewBox={`${-pad} ${-pad} ${W + pad * 2} ${H + pad * 2}`} role="group" aria-label={`${M.siteName}, ${F.name}: floor plan`} data-fm-svg>
      <g data-fm-plan>
        <polygon class="fm-outline" points={pts(F.outline)} />
        <defs>
          <pattern id={`${pid}-treads`} patternUnits="userSpaceOnUse" width="1" height="0.28"><line x1="0" y1="0.14" x2="1" y2="0.14" class="fm-tread" /></pattern>
          <pattern id={`${pid}-hatch`} patternUnits="userSpaceOnUse" width="0.5" height="0.5" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="0.5" class="fm-hatch" /></pattern>
        </defs>
        {F.areas.map((a) => <rect class={`fm-area fm-area-${a.kind}`} {...rectAttrs(a.rect)}><title>{a.name}</title></rect>)}
        {F.corridors.map((c) => <rect class="fm-corridor" {...rectAttrs(c.rect)}><title>{c.name}</title></rect>)}
        {F.core.map((c) => (
          <g class={`fm-core fm-core-${coreKind(c.kind)}`}>
            <rect {...rectAttrs(c.rect)}><title>{c.name}</title></rect>
            {c.kind === 'stair' && <rect class="fm-pat" {...rectAttrs(c.rect)} style={`fill:url(#${pid}-treads)`} />}
            {c.kind === 'stair' && <line class="fm-sym" x1={(c.rect[0] + c.rect[2]) / 2} x2={(c.rect[0] + c.rect[2]) / 2} y1={Y(c.rect[3]) + 0.5} y2={Y(c.rect[1]) - 0.5} />}
            {coreKind(c.kind) === 'store' && <rect class="fm-pat" {...rectAttrs(c.rect)} style={`fill:url(#${pid}-hatch)`} />}
            {c.kind === 'lift' && cars(c).map((q) => (
              <g class="fm-car"><rect {...rectAttrs([q[0] + 0.15, q[1] + 0.15, q[2] - 0.15, q[3] - 0.15])} /><line x1={q[0] + 0.15} y1={Y(q[1] + 0.15)} x2={q[2] - 0.15} y2={Y(q[3] - 0.15)} /><line x1={q[0] + 0.15} y1={Y(q[3] - 0.15)} x2={q[2] - 0.15} y2={Y(q[1] + 0.15)} /></g>
            ))}
            {coreLabel[c.kind] && c.kind !== 'lift' && c.kind !== 'stair' && Math.min(c.rect[2] - c.rect[0], c.rect[3] - c.rect[1]) > 1.2 && <text x={(c.rect[0] + c.rect[2]) / 2} y={Y((c.rect[1] + c.rect[3]) / 2)}>{coreLabel[c.kind]}</text>}
          </g>
        ))}
        {F.areas.filter((a) => a.kind !== 'open-office' && a.rect[2] - a.rect[0] > 4).map((a) => <text class="fm-area-word" x={a.rect[0] + 0.4} y={Y(a.rect[3]) + 0.8}>{a.name}</text>)}
        {rooms.map((r) => {
          const door = doorOf(r);
          return (
            <g class:list={['fm-room', `fm-k-${KIND_OF(r.space_type)}`, { 'fm-bank': r.count > 1, 'fm-comms': ['mdf', 'idf'].includes(r.space_type), 'fm-on': r.id === highlight }]} {...pick(`room:${r.id}`, roomName(r))} data-vt-rec={interactive ? r.id : undefined}>
              <rect {...rectAttrs(r.rect)}><title>{`${roomName(r)}${r.variations.length ? `: ${r.variations.map((v) => v.text).join('; ')}` : ''}`}</title></rect>
              {r.geo.odd.filter((o) => o.rect).map((o) => <rect class="fm-odd" {...rectAttrs(o.rect)} />)}
              {r.desks.map((d) => <rect class="fm-desk" x={d.at[0] - 0.72} y={Y(d.at[1]) - 0.35} width="1.44" height="0.7" />)}
              {door && <line class="fm-door" x1={door[0][0]} y1={Y(door[0][1])} x2={door[1][0]} y2={Y(door[1][1])} />}
              {r.geo.entry && r.count === 1 && <circle class="fm-entry" cx={r.geo.entry[0]} cy={Y(r.geo.entry[1])} r="0.18" />}
              <text x={(r.rect[0] + r.rect[2]) / 2} y={Y((r.rect[1] + r.rect[3]) / 2)}>{label(r)}</text>
              {r.count <= 1 && <g class="fm-g" transform={`translate(${(r.rect[0] + r.rect[2]) / 2 - 0.4} ${Y((r.rect[1] + r.rect[3]) / 2) + 0.5}) scale(0.05)`} aria-hidden="true" set:html={GLYPH} />}
              {r.count <= 1 && r.rect[3] - r.rect[1] >= 3 && <text class="fm-lt" x={(r.rect[0] + r.rect[2]) / 2} y={Y((r.rect[1] + r.rect[3]) / 2) + 1.85} data-w={(r.rect[2] - r.rect[0]).toFixed(1)} aria-hidden="true"></text>}
            </g>
          );
        })}
        {F.trays.map((t) => <polyline class={`fm-tray fm-tray-${t.kind}`} data-tray={t.id} points={pts(t.path)}><title>{`${t.name}: ${t.runs} cables${t.capacity ? ` of ${t.capacity}` : ''}`}</title></polyline>)}
        {runs.length > 0 && (
          <g class="fm-runs">
            {runs.map((r) => <polyline class="fm-run" data-sel={interactive ? `run:${r.id}` : undefined} style={`--hex:${r.hex ?? 'currentColor'}`} points={pts(r.path.map((p) => [p[0], p[1]]))}><title>{r.id}</title></polyline>)}
          </g>
        )}
        {F.risers.map((x) => <rect class="fm-riser" {...rectAttrs(x.rect)}><title>{x.name}</title></rect>)}
        {racks.map((r) => (
          <g class="fm-rack" {...pick(`rack:${r.id}`, `${r.name}, ${M.rooms[r.space]?.name ?? r.space}`)}>
            <rect class="fm-hit" x={r.at[0] - 0.9} y={Y(r.at[1]) - 0.9} width="1.8" height="1.8" />
            <rect x={r.at[0] - 0.3} y={Y(r.at[1]) - 0.53} width="0.6" height="1.07"><title>{r.name}</title></rect>
          </g>
        ))}
        {aps.map((a) => (
          <g class="fm-ap" {...pick(`ap:${a.id}`, `Access point ${a.hostname}, ${apModel(a)}`)}>
            <circle class="fm-hit" cx={a.at[0]} cy={Y(a.at[1])} r="0.9" />
            <circle cx={a.at[0]} cy={Y(a.at[1])} r="0.45" /><title>{`${a.hostname}, ${apModel(a)}`}</title>
          </g>
        ))}
        <g class="fm-scale" transform={`translate(0 ${H + 0.9})`}><line x1="0" x2="5" y1="0" y2="0" /><text x="5.4" y="0.35">5 m</text></g>
        <g class="fm-north" transform={`translate(${W - 0.6} ${H + 0.75})`} aria-hidden="true"><path d="M0,-0.6 L0.35,0.35 L0,0.15 L-0.35,0.35 Z" /><text x="0.9" y="0.1">N</text></g>
      </g>
    </svg>
    <ul class="fm-key" aria-label="Key to the plan">
      {keyItems.map((k) => (
        <li><svg viewBox="0 0 16 12" aria-hidden="true" class={`fm-sw fm-sw-${k}`}><rect x="0.5" y="0.5" width="15" height="11" />
          {k === 'stair' && [3, 6, 9].map((y) => <line x1="1" x2="15" y1={y} y2={y} />)}
          {k === 'lift' && <><line x1="1" y1="1" x2="15" y2="11" /><line x1="1" y1="11" x2="15" y2="1" /></>}
          {k === 'store' && [4, 9, 14, 19].map((x) => <line x1={x - 4} y1="11" x2={x} y2="1" />)}
          {(k === 'flex' || k === 'assigned') && <><rect class="fm-sw-desk" x="3" y="3" width="4.5" height="2.6" /><rect class="fm-sw-desk" x="8.5" y="3" width="4.5" height="2.6" /><rect class="fm-sw-desk" x="3" y="6.4" width="4.5" height="2.6" /><rect class="fm-sw-desk" x="8.5" y="6.4" width="4.5" height="2.6" /></>}
        </svg>{KEY_WORD[k]}</li>
      ))}
    </ul>
    <figcaption><Restricted view="floorPlan" /> {F.fictional}</figcaption>
  </figure>
)}

<script>
  // Turn the plan a quarter turn when its box is narrow; keep the words upright.
  function turn(fig: HTMLElement) {
    const W = +fig.dataset.fmW!, H = +fig.dataset.fmH!, pad = +fig.dataset.fmPad!;
    const svg = fig.querySelector('[data-fm-svg]') as SVGSVGElement, g = fig.querySelector('[data-fm-plan]') as SVGGElement;
    const on = fig.clientWidth > 0 && fig.clientWidth < 520;
    if (fig.classList.contains('fm-turned') === on && fig.dataset.fmDone) return;
    fig.dataset.fmDone = '1';
    fig.classList.toggle('fm-turned', on);
    svg.setAttribute('viewBox', on ? `${-pad} ${-pad} ${H + pad * 2} ${W + pad * 2}` : `${-pad} ${-pad} ${W + pad * 2} ${H + pad * 2}`);
    if (on) g.setAttribute('transform', `matrix(0 1 -1 0 ${H} 0)`); else g.removeAttribute('transform');
    g.querySelectorAll('text').forEach((t) => {
      if (!on) { t.removeAttribute('transform'); return; }
      const x = +(t.getAttribute('x') ?? 0), y = +(t.getAttribute('y') ?? 0);
      t.setAttribute('transform', `rotate(-90 ${x} ${y})`);
    });
  }
  function init() {
    document.querySelectorAll<HTMLElement>('[data-fm]').forEach((fig) => {
      if ((fig as any).__fm) return; (fig as any).__fm = true;
      turn(fig);
      if ('ResizeObserver' in window) new ResizeObserver(() => requestAnimationFrame(() => turn(fig))).observe(fig);
    });
  }
  init();
  document.addEventListener('astro:page-load', init);
  // The zoom (src/lib/zoom-client.mjs) turns the plans itself on the way in, before the page's picture is taken.
  (window as any).rsFloorMapsInit = init;
</script>

<style>
  .floormap { margin: 0; min-width: 0; }
  .floormap svg { width: 100%; height: auto; display: block; font-family: var(--font-sans); }
  .fm-outline { fill: var(--surface, var(--bg)); stroke: var(--line-strong); stroke-width: 0.12; }
  /* One look per kind (rooms.md R10), shared with the key below the plan and the 3D views: soft tints only, so the
     live state (a fault in its own colour) still reads first. */
  .floormap {
    --fm-meeting: color-mix(in srgb, var(--blue) 13%, var(--bg)); --fm-small: color-mix(in srgb, var(--violet) 13%, var(--bg));
    --fm-reception: color-mix(in srgb, var(--green) 16%, var(--bg)); --fm-pantry: color-mix(in srgb, var(--amber) 20%, var(--bg));
    --fm-print: color-mix(in srgb, var(--grey) 18%, var(--bg)); --fm-comms: var(--surface-2);
    --fm-core: color-mix(in srgb, var(--grey) 22%, var(--bg)); --fm-wc: color-mix(in srgb, var(--blue) 22%, var(--bg));
    --fm-corr: color-mix(in srgb, var(--grey) 9%, var(--bg)); --fm-hall: color-mix(in srgb, var(--amber) 11%, var(--bg)); --fm-break: color-mix(in srgb, var(--green) 9%, var(--bg));
  }
  .fm-area { fill: var(--fm-break); }
  .fm-area-town-hall { fill: var(--fm-hall); }
  .fm-area-open-office { fill: none; }
  .fm-area-word { font-size: 0.6px; fill: var(--text-2, var(--ink)); font-style: italic; dominant-baseline: middle; }
  .fm-corridor { fill: var(--fm-corr); }
  .fm-core rect { fill: var(--fm-core); stroke: var(--line-strong); stroke-width: 0.05; }
  .fm-core-toilets rect { fill: var(--fm-wc); }
  .fm-core-lift-lobby rect { fill: var(--fm-corr); stroke: none; }
  .fm-core rect.fm-pat { stroke: none; }
  .fm-tread, .fm-hatch { stroke: var(--text-3, var(--line-strong)); stroke-width: 0.05; }
  .fm-sym, .fm-car line { stroke: var(--line-strong); stroke-width: 0.05; }
  .fm-core .fm-car rect { fill: var(--bg); }
  .fm-core text { font-size: 0.7px; fill: var(--text-2, var(--ink)); text-anchor: middle; dominant-baseline: middle; }
  .fm-room rect { fill: var(--fm-fill, var(--bg)); stroke: var(--ink); stroke-width: 0.08; transition: fill var(--dur-state) var(--ease-settle), stroke var(--dur-state) var(--ease-settle), opacity var(--dur-state) var(--ease-settle); }
  .fm-k-meeting { --fm-fill: var(--fm-meeting); } .fm-k-small { --fm-fill: var(--fm-small); } .fm-k-reception { --fm-fill: var(--fm-reception); }
  .fm-k-pantry { --fm-fill: var(--fm-pantry); } .fm-k-print { --fm-fill: var(--fm-print); } .fm-k-comms { --fm-fill: var(--fm-comms); }
  .fm-bank > rect { fill: none; stroke-dasharray: 0.3 0.2; stroke: var(--line-strong); }
  .fm-comms > rect { fill: var(--surface-2); }
  .fm-on > rect { stroke: var(--accent); stroke-width: 0.2; }
  .fm-room text { font-size: 0.8px; fill: var(--ink); text-anchor: middle; dominant-baseline: middle; pointer-events: none; }
  .fm-scale text, .fm-north text { font-size: 0.8px; fill: var(--text-2, var(--ink)); dominant-baseline: middle; }
  .fm-north path { fill: var(--text-2, var(--ink)); }
  .fm-odd { fill: var(--line-strong) !important; stroke: none !important; }
  .fm-room rect.fm-desk { fill: var(--bg); stroke: var(--text-2, var(--ink)); stroke-width: 0.05; stroke-dasharray: none; }
  .fm-k-assigned rect.fm-desk { fill: var(--text-2, var(--ink)); }
  .fm-key { list-style: none; margin: 0.6rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem 1rem; font-size: 0.78rem; color: var(--text-2, var(--ink)); }
  .fm-key li { display: inline-flex; align-items: center; gap: 0.4rem; }
  .floormap svg.fm-sw { width: 1.1rem; height: 0.85rem; flex: none; overflow: hidden; display: inline-block; }
  .fm-sw > rect { fill: var(--bg); stroke: var(--ink); stroke-width: 1; }
  .fm-sw line { stroke: var(--line-strong); stroke-width: 0.8; }
  .fm-sw-meeting > rect { fill: var(--fm-meeting); } .fm-sw-small > rect { fill: var(--fm-small); } .fm-sw-reception > rect { fill: var(--fm-reception); }
  .fm-sw-pantry > rect { fill: var(--fm-pantry); } .fm-sw-print > rect { fill: var(--fm-print); } .fm-sw-comms > rect { fill: var(--fm-comms); }
  .fm-sw-flex > rect, .fm-sw-assigned > rect { fill: none; stroke: var(--line-strong); stroke-dasharray: 2 1.5; }
  .fm-sw .fm-sw-desk { fill: var(--bg); stroke: var(--text-2, var(--ink)); stroke-width: 0.6; stroke-dasharray: none; }
  .fm-sw-assigned .fm-sw-desk { fill: var(--text-2, var(--ink)); }
  .fm-sw-town-hall > rect { fill: var(--fm-hall); stroke: none; } .fm-sw-breakout > rect { fill: var(--fm-break); stroke: none; } .fm-sw-corridor > rect { fill: var(--fm-corr); stroke: none; }
  .fm-sw-stair > rect, .fm-sw-lift > rect, .fm-sw-store > rect { fill: var(--fm-core); stroke: var(--line-strong); } .fm-sw-toilets > rect { fill: var(--fm-wc); stroke: var(--line-strong); }
  .fm-sw-riser > rect { fill: var(--blue-soft); stroke: var(--blue); }
  .fm-door { stroke: var(--surface, var(--bg)); stroke-width: 0.16; }
  .fm-entry { fill: var(--c-lan); }
  .fm-tray { fill: none; stroke: var(--amber); stroke-width: 0.18; stroke-linecap: round; stroke-linejoin: round; transition: stroke var(--dur-state) var(--ease-settle), opacity var(--dur-state) var(--ease-settle); }
  .fm-tray-basket { stroke-width: 0.09; }
  .fm-tray-ladder { stroke: var(--accent); stroke-width: 0.25; }
  .fm-run { fill: none; stroke: var(--hex, currentColor); stroke-width: 0.04; opacity: 0.5; stroke-linejoin: round; transition: opacity var(--dur-state) var(--ease-settle), stroke var(--dur-state) var(--ease-settle); }
  .fm-riser { fill: var(--blue-soft); stroke: var(--blue); stroke-width: 0.08; }
  .fm-rack rect:not(.fm-hit) { fill: var(--ink); }
  .fm-hit { fill: transparent; stroke: none; }
  .fm-ap circle:not(.fm-hit) { fill: var(--bg); stroke: var(--blue); stroke-width: 0.15; transition: fill var(--dur-state) var(--ease-settle), stroke var(--dur-state) var(--ease-settle); }
  .fm-scale line { stroke: var(--ink); stroke-width: 0.1; }
  .floormap figcaption { font-size: 0.8rem; color: var(--text-2, var(--ink)); margin-top: 0.4rem; }

  /* Chosen and live (set by the page's script). The dark cockpit (UI-V2 §5.2): in use and free are neutral, and only a
     space that is not working takes a colour, with the Fault glyph at its centre. Nothing pulses. */
  .fm-pick [data-sel]:not(.fm-run) { cursor: pointer; }
  .fm-pick [data-sel]:focus { outline: none; }
  .fm-pick [data-sel]:focus-visible > rect:not(.fm-hit), .fm-pick [data-sel]:focus-visible > circle:not(.fm-hit) { stroke: var(--focus, var(--accent)); stroke-width: 0.3; }
