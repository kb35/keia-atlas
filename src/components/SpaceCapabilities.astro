---
/* SpaceCapabilities: what the capabilities know about one space (src/lib/modules.mjs), as one section of cards on the
   space page: its licences, its next room check and its call quality. Each card belongs to its capability
   (data-feature) and shows only what exists for this space, so a space with no licence has no licence card; the
   section (a Section, so featureCss takes it away with its heading when every card is gated) holds whatever is left.
   Props: space  the space id */
import Section from './Section.astro';
import FeatureSource from './FeatureSource.astro';
import { href, fmtDate, plural } from '../lib/data.mjs';
import { featureAnyCss } from '../lib/modules.mjs';
import { licences, checkRounds, checkPlans, qualityOf } from '../lib/capabilities-view.mjs';
import { qualityLine, PLATFORM_LABEL, CAUSE_WORD } from '../lib/quality.mjs';
import { sparkSvg } from '../lib/spark.mjs';
import HealthGlyph from './HealthGlyph.astro';
import { checksForSpace, dayWords } from '../lib/checks.mjs';
import { PEOPLE } from '../lib/demo.mjs';
import { rowsForSpace, inDays } from '../lib/licences.mjs';
import '../styles/capabilities.css';

interface Props { space: string }
const { space } = Astro.props;
const lic = rowsForSpace(licences, space);
const chk = checksForSpace(checkRounds, space);
const planName = (id) => checkPlans.find((p) => p.id === id)?.name ?? id;
const first = (id) => PEOPLE.find((p) => p.id === id)?.name.split(' ')[0];
// In the registry's order, so the section's data-feat-any matches its rule.
const mq = qualityOf(space);
const cards = [lic.length ? 'licences' : null, chk.next || chk.last ? 'maintenance' : null, mq ? 'meeting-quality' : null].filter(Boolean);
---
{cards.length > 0 && (
  <Section title="Upkeep" id="upkeep" help="room.upkeep" data-feat-any={cards.join(' ')}>
    <style is:global set:html={featureAnyCss(cards)}></style>
    <div class="cap-grid">
      {lic.length > 0 && (
        <section class="card pad cap-card" data-feature="licences" data-help="room.licences" aria-labelledby="up-lic">
          <h3 id="up-lic">Licences <FeatureSource id="licences" /></h3>
          <p class="cap-a">{lic.some((r) => r.soon || r.lapsed) ? `${lic.filter((r) => r.soon || r.lapsed).length === 1 ? 'One renews' : 'Some renew'} within 30 days` : lic.some((r) => r.short) ? 'Its pool is short of seats' : `${plural(lic.length, 'licence')}, each with a seat for this space`}</p>
          <ul class="cap-list">
            {lic.map((r) => (
              <li>
                <a href={href(`/assets/licences/#${r.id}`)}><b>{r.platformLabel}</b></a>
                <span>{r.name.includes(',') ? r.name.split(', ').slice(1).join(', ') : r.kindLabel} · renews {fmtDate(r.renews)} <span class:list={['cap-w', { 't-warn': r.soon, 't-bad': r.lapsed }]}>({inDays(r.days)})</span></span>
                {r.short > 0 && <small class="cap-w t-bad">{plural(r.short, 'seat')} short across the pool</small>}
              </li>
            ))}
          </ul>
        </section>
      )}
      {(chk.next || chk.last) && (
        <section class="card pad cap-card" data-feature="maintenance" data-help="room.checks" aria-labelledby="up-chk">
          <h3 id="up-chk">Room checks <FeatureSource id="maintenance" /></h3>
          <p class:list={['cap-a', { 'cap-w t-bad': chk.next?.status === 'overdue', 'cap-w t-warn': chk.next?.status === 'due' }]}>{chk.next ? `${chk.next.status === 'overdue' ? 'Overdue since' : 'Next check:'} ${dayWords(chk.next.date)}` : 'No check planned'}</p>
          <ul class="cap-list">
            {chk.next && <li><a href={href(`/work/checks/#${chk.next.id.replace(/:/g, '-')}`)}><b>{chk.next.name}</b></a><span>{dayWords(chk.next.date)}{chk.next.who[0] ? `, ${first(chk.next.who[0])}` : ''}{chk.next.spaces.length > 1 ? `, with ${chk.next.spaces.length - 1} more ${chk.next.spaces.length === 2 ? 'space' : 'spaces'}` : ''}</span></li>}
            {chk.last && <li><b>Last checked</b><span>{fmtDate(chk.last.date)}{chk.last.name ? `, ${chk.last.name.toLowerCase()}` : ''}</span></li>}
            {chk.plans.filter((p) => p !== chk.next?.plan).map((p) => <li><b>{planName(p)}</b><small>Also covers this space</small></li>)}
          </ul>
        </section>
      )}
      {mq && (
        <section class="card pad cap-card" data-feature="meeting-quality" data-help="room.quality" aria-labelledby="up-mq">
          <h3 id="up-mq">Meeting quality <FeatureSource id="meeting-quality" /></h3>
          <p class:list={['cap-a', { 'cap-w t-bad': mq.state === 'fault', 'cap-w t-warn': mq.state === 'review' }]}>{mq.score} out of 100 in the last 7 days{mq.trend !== 'steady' ? `, ${mq.trend === 'falling' ? 'getting worse' : 'getting better'}` : ''}</p>
          <ul class="cap-list">
            <li><span class="up-mq-s"><HealthGlyph state={mq.state} size={12} title={`${mq.score} out of 100`} /> Nine weeks <i set:html={sparkSvg([...mq.weeks, mq.score], { w: 96, h: 20, state: mq.state, span: '9 weeks' })} /></span></li>
            <li><b>{mq.poor_7d ? `${mq.poor_7d} of ${mq.calls_7d} calls poor` : `${mq.calls_7d} calls, none poor`}</b>{mq.poor_7d > 0 && <span>Mostly {CAUSE_WORD[mq.cause]}</span>}<small>From {PLATFORM_LABEL[mq.platform]}</small></li>
          </ul>
          <a class="sec-to" href={href(`/usage/quality/`)}>Every space's calls <span aria-hidden="true">→</span></a>
        </section>
      )}
    </div>
  </Section>
)}
