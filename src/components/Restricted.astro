---
// The small label beside Restricted content (docs/rules/data.md F10): floor plans, building models, racks and
// switch ports, IP plans, the vulnerable-firmware list and default password status. `what` says which, in
// words from RESTRICTED_VIEWS (src/lib/classification.mjs). Same markup as restrictedHtml() for pages that
// build their markup in a script.
import '../styles/classification.css';
import { RESTRICTED_VIEWS } from '../lib/classification.mjs';
interface Props { view: keyof typeof RESTRICTED_VIEWS; class?: string }
const { view, class: cls } = Astro.props;
---
<span class:list={['cls-tag', cls]} data-help="classification.restricted"><b>Restricted:</b> {RESTRICTED_VIEWS[view]}</span>
