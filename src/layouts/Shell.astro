  .va-change:hover { background: color-mix(in srgb, var(--accent-soft) 70%, var(--surface)); }
  .va-back { flex: none; font: 600 12.5px/1 var(--font-sans); padding: 6px 10px; border-radius: var(--pill-radius); border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent); background: var(--surface); color: var(--accent-ink); cursor: pointer; transition: background var(--dur-hover), border-color var(--dur-hover); }
  .va-back:hover { background: var(--accent-soft); border-color: var(--accent); }
