---
// The one page template: masthead, left navigation (a bottom tab bar on phones), page band, content.
import Icon from '../components/Icon.astro';
import { href } from '../lib/data.mjs';
import Settings from '../components/Settings.astro';
import ViewAs from '../components/ViewAs.astro';
import Report from '../components/Report.astro';
import Peek from '../components/Peek.astro';
import Motion from '../components/Motion.astro';
import HelpMode from '../components/HelpMode.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/looks/enterprise.css';
import '../styles/looks/classic.css';
import '../styles/looks/studio.css';
import '../styles/looks/drawing.css';
import '../styles/looks/contrast.css';
import '../styles/base.css';
import '../styles/motion.css';
import '../styles/nav.css';
import '../styles/craft.css';

import { PEOPLE } from '../lib/demo.mjs';
import { LINE } from '../lib/brand.mjs';
import { MODULES, MODULE_DEFAULTS, CAPABILITIES, resolveFeatures, featureCss } from '../lib/modules.mjs';
import { zoomTrail } from '../lib/zoom.mjs';
import { springEasing } from '../lib/spring.mjs';

// minStage is retired (v2: no stages, modules instead). Pages may still pass it; it is ignored. A page's module
// is the place it belongs to in NAV: while that module is Off, the page says so and offers to switch it on.
const { title, crumbs = [], section = '', vendorOk = false, about } = Astro.props;
const VENDOR_IDS = PEOPLE.filter((p) => p.vendor).map((p) => p.id);
// The sidebar (UX-V2 §2.1): Home, then one entry per module in a fixed order, then Learn below a rule. Each is one
// place; the pages inside it show as tabs at the top of the page, so the sidebar stays short and the same
// everywhere. A module that is Off is absent (Settings › Modules); one that is Connected shows its source on hover.
const NAV = [
  { id: 'home', label: 'Home', to: '/', icon: 'home', mobile: true, vendorOk: true, tabs: [] },
  { id: 'vendor', label: 'Your installation', short: 'Install', to: '/vendor/', icon: 'kit', vendorOnly: true, vendorOk: true, mobile: true, tabs: [] },
  { id: 'vschedule', label: 'Your schedule', short: 'Schedule', to: '/work/schedule/', icon: 'schedule', vendorOnly: true, vendorOk: true, tabs: [] },
  // Locations: offices, regions and home offices, with the spaces inside them. Spaces keep their
  // address (/rooms/) but live here. Region, office and home-office pages light the place, not a tab.
  { id: 'locations', label: 'Locations', to: '/locations/', icon: 'sites', mobile: true, tabs: [
    { id: 'locations-overview', label: 'Overview', to: '/locations/' },
    { id: 'offices', label: 'Offices', to: '/locations/offices/' },
    { id: 'rooms', label: 'Spaces', to: '/rooms/' },
    { id: 'types', label: 'Space types', to: '/room-profiles/' },
    { id: 'usage', label: 'Usage', to: '/usage/', lead: true },
  ], also: ['sites', 'office', 'region', 'home-offices'] },
  // Services: the health, fleet, standard and owners of each service.
  { id: 'services', label: 'Services', to: '/services/', icon: 'pulse', tabs: [
    { id: 'services-overview', label: 'Overview', to: '/services/' },
    { id: 'services-av', label: 'AV', to: '/services/av/' },
    { id: 'services-network', label: 'Network', to: '/services/network/' },
    { id: 'services-infrastructure', label: 'Infrastructure', to: '/services/infrastructure/' },
  ], also: ['service'] },
  // Assets (it was Devices; /devices/overview/ moved to /assets/): the units and everything that describes them.
  { id: 'assets', label: 'Assets', to: '/assets/', vendorTo: '/profiles/', icon: 'devices', mobile: true, vendorOk: true, tabs: [
    { id: 'devices-overview', label: 'Overview', to: '/assets/' },
    { id: 'profiles', label: 'Device types', to: '/profiles/', vendorOk: true },
    { id: 'devices', label: 'Units', to: '/devices/' },
    { id: 'models', label: 'Models', to: '/models/', vendorOk: true },
    { id: 'configurations', label: 'Setup guides', to: '/configurations/', vendorOk: true },
    { id: 'standards', label: 'Standards', to: '/standards/', vendorOk: true },
    { id: 'equipment-usage', label: 'Usage', to: '/usage/equipment/', lead: true },
    { id: 'spares', label: 'IT stores', to: '/spares/' },
    { id: 'cables', label: 'Cables', to: '/cables/' },
    // Capabilities (src/lib/modules.mjs): each tab is there while its capability is on.
    { id: 'licences', label: 'Licences', to: '/assets/licences/', feature: 'licences' },
  ] },
  // Support and Projects are what Work was (/work/ moved to /support/): the day's jobs, and the dated work.
  { id: 'support', label: 'Support', to: '/support/', icon: 'inbox', mobile: true, tabs: [
    { id: 'overview', label: 'Overview', to: '/support/' },
    { id: 'queue', label: 'Queue', to: '/support/queue/' },
    { id: 'incidents', label: 'Incidents', to: '/incidents/' },
    { id: 'support-changes', label: 'Changes', to: '/support/changes/' },
    { id: 'rules', label: 'Standing rules', to: '/support/rules/' },
    { id: 'alerts', label: 'Alert rules', to: '/support/alerts/', feature: 'alerts' },
    { id: 'audit-log', label: 'Audit log', to: '/support/log/' },
  ] },
  { id: 'projects', label: 'Projects', to: '/projects/', icon: 'project', tabs: [
    { id: 'projects', label: 'Projects', to: '/projects/' },
    { id: 'schedule', label: 'Schedule', to: '/work/schedule/' },
    { id: 'checks', label: 'Room checks', to: '/work/checks/', feature: 'maintenance' },
    { id: 'planning', label: 'Planning', to: '/work/planning/', lead: true },
    { id: 'refresh', label: 'Work plan', to: '/refresh/' },
    { id: 'lab', label: 'Lab', to: '/lab/' },
  ] },
  // Vendors (V7): the companies, each with its record, and the register of every grant of access a partner has had.
  { id: 'vendors', label: 'Vendors', to: '/vendors/', icon: 'kit', tabs: [
    { id: 'vendors', label: 'Vendors', to: '/vendors/' },
    { id: 'vendors-access', label: 'Access register', to: '/vendors/access/' },
  ], also: ['vendor-record'] },
  { id: 'team', label: 'Team', to: '/team/', icon: 'team', tabs: [] },
  { id: 'knowledge', label: 'Knowledge', to: '/known-issues/', icon: 'playbook', tabs: [
    { id: 'known-issues', label: 'Known errors', to: '/known-issues/' },
    { id: 'playbooks', label: 'Playbooks', to: '/playbooks/' },
    { id: 'changes', label: 'Proposals', to: '/changes/' },
  ] },
  { id: 'learn', label: 'Learn', to: '/learn/', icon: 'book', vendorOk: true, tabs: [] },
  // The Keia Method (/method/): what Atlas is built on, below the rule beside Learn.
  { id: 'method', label: 'Method', to: '/method/', icon: 'decisions', vendorOk: true, tabs: [] },
];
const parent = NAV.find((n) => n.id === section || n.tabs.some((t) => t.id === section) || (n.also ?? []).includes(section));
const tabs = parent && parent.tabs.length > 1 ? parent.tabs : [];
const MOD = Object.fromEntries(MODULES.map((m) => [m.id, m]));
const pageModule = parent && MOD[parent.id] ? MOD[parent.id] : null;
// Old place addresses, and the place each became. Links to them still work (Moved pages); the client router
// goes straight to the new address, so an old link never shows the Moved page on the way.
const MOVED = { '/work/': '/support/', '/devices/overview/': '/assets/' };
const MOVED_HREF = Object.fromEntries(Object.entries(MOVED).map(([a, b]) => [href(a), href(b)]));
// Usage and Scenarios (lead: true) are for everyone, but come first, marked, for the roles that decide
// where money and space go: both service managers, the head of the service and the programme manager.
const LEAD_ROLES = ['sm-av', 'sm-infra', 'head', 'programme'];
const leadCss = LEAD_ROLES.map((r) => `:root[data-role="${r}"] .sec-tabs [data-lead]{order:-1}:root[data-role="${r}"] .sec-tabs [data-lead]::before{content:"";display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--accent);margin-right:7px;vertical-align:2px}`).join('');
// Modules Off leave the sidebar (and their pages show the gate); Connected ones show their source on hover.
const moduleCss = MODULES.map((m) => `:root[data-off~="${m.id}"] .nav [data-nav="${m.id}"]{display:none!important}`
  + `:root[data-off~="${m.id}"] main[data-module="${m.id}"] .page-body{display:none!important}`
  + `:root[data-off~="${m.id}"] main[data-module="${m.id}"] .module-gate{display:grid!important}`
  + `:root[data-conn~="${m.id}"] .nav [data-nav="${m.id}"] .nav-src{display:block}`).join('');
// Capabilities (src/lib/modules.mjs): what they mark leaves the page while they are off; source marks show while
// they are Connected. The head gets the registry (id, module, default, requires) and the one resolver, as text.
const featCss = featureCss();
const RS_CAPS = CAPABILITIES.map((c) => ({ id: c.id, module: c.module, state: c.state, requires: c.requires ?? [] }));
const RESOLVE = `window.rsResolveFeatures=${resolveFeatures.toString()};`;
// The path in the top bar. A page on the zoom (region, office, space) gets the zoom trail from its address, so
// it reads the same whichever page linked there (src/lib/zoom.mjs). On other pages a step that names a retired
// place (Work, Devices), or a place the page has moved out of (Vendors was under Team), names its place now.
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = Astro.url.pathname.startsWith(basePath) ? Astro.url.pathname.slice(basePath.length) || '/' : Astro.url.pathname;
const zoom = zoomTrail(here);
const PLACE_WORDS = new Set(['Work', 'Devices', ...NAV.map((n) => n.label)]);
const trail = zoom ?? crumbs.map((c, i) => (i === 0 && c.to && parent && c.label !== parent.label && PLACE_WORDS.has(c.label) ? { label: parent.label, to: parent.to } : c))
  .filter((c, i, all) => !(i === 0 && all.length > 1 && all[1].label === c.label));   // never "Vendors / Vendors"
// The spring the zoom rides on (MOTION-V2 --spring-settle: 360 ms, no bounce), as a CSS easing.
const EASE_SPRING = springEasing({ duration: 360, bounce: 0 });
// A record page (not a list) is remembered as a recent object for the palette (⌘K, before you type).
const recent = about && about.kind && about.kind !== 'page' ? JSON.stringify({ k: about.kind, t: about.label, u: here }) : undefined;
const WHO_ROLE = Object.fromEntries(PEOPLE.map((p) => [p.id, p.roleId]));
// "Everyone (overview)" in View as is a demo viewer, not a person: Home shows every role's panels at once
// (matched by data-who="everyone"); anywhere else it reads as the default role.
const EVERYONE = { id: 'everyone', name: 'Everyone', role: 'Everyone (overview)', where: 'Every role at once', initials: 'All', scope: 'Every role at once' };
// Just enough about each person for pages that act as the viewer (task forms, proposed changes).
// In Everyone (overview) nobody in particular is signed in, so any change made there is recorded as this clearly labelled demo admin.
const DEMO_ADMIN = { id: 'demo-admin', name: 'Demo admin (Everyone view)', roleId: 'delivery', role: 'Demo admin', initials: 'DA', vendor: false };
const PEOPLE_LITE = [...PEOPLE.map((p) => ({ id: p.id, name: p.name, roleId: p.roleId, role: p.role, initials: p.initials, vendor: !!p.vendor })), DEMO_ADMIN];
const who0 = PEOPLE[0];
// The object this page is about, for the Report drawer ("Propose an edit about ...").
const aboutThis = about ?? { kind: 'page', label: title ?? 'this page' };
const pageTitle = title ? `${title} · Keia Atlas` : 'Keia Atlas';
---
<!doctype html>
<html lang="en-IE" data-look="studio">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{pageTitle}</title>
  <meta name="description" content={`Keia Atlas: ${LINE} A demo of a made-up company, built on public device data.`} />
  <script is:inline data-astro-rerun define:vars={{ VENDOR_IDS, WHO_ROLE, PEOPLE_LITE, MODULE_DEFAULTS, MOVED_HREF, RS_CAPS }}>window.RS_VENDORS = VENDOR_IDS; window.RS_WHO_ROLE = WHO_ROLE; window.RS_PEOPLE = PEOPLE_LITE; window.RS_MODULES = MODULE_DEFAULTS; window.RS_MOVED = MOVED_HREF; window.RS_CAPS = RS_CAPS;</script>
  <script is:inline data-astro-rerun set:html={RESOLVE}></script>
  <script is:inline data-astro-rerun>
    /* Small shared helpers for pages that keep demo records in this browser: read and write a JSON list
       (falling back to memory when storage is blocked), and who the viewer is right now. */
    window.rsStore = window.rsStore || {
      mem: {},
      get: function (k, d) { try { var v = localStorage.getItem(k); if (v != null) return JSON.parse(v); } catch (_) {} return k in this.mem ? this.mem[k] : d; },
      put: function (k, v) { this.mem[k] = v; if (k === 'rs4-changes') window.__rsLocalChanges = v; try { localStorage.setItem(k, JSON.stringify(v)); } catch (_) {} },
    };
    /* Who this window is signed in as (View as). Each window keeps its own person in sessionStorage
       (rs5-who), so two windows can be two people for the live demo. A window that has not chosen yet takes
       the last pick made in any window (localStorage rs4-who) once, and keeps it. */
    window.rsWhoId = function () {
      var id = null; try { id = sessionStorage.getItem('rs5-who'); } catch (_) {}
      if (!id) {
        try { id = localStorage.getItem('rs4-who'); } catch (_) {}
        id = id || 'anna';
        try { sessionStorage.setItem('rs5-who', id); } catch (_) {}
      }
      // "You" is the person this window opened as; View as anyone else shows the ribbon, and "Back to you" returns here.
      try { if (!sessionStorage.getItem('rs5-me')) sessionStorage.setItem('rs5-me', id); } catch (_) {}
      return id;
    };
    window.rsMeId = function () { var me = null; try { me = sessionStorage.getItem('rs5-me'); } catch (_) {} return me || window.rsWhoId(); };
    window.rsSetWho = function (id) {
      try { sessionStorage.setItem('rs5-who', id); } catch (_) {}
      try { localStorage.setItem('rs4-who', id); } catch (_) {}   // the next window to open starts as this person
    };
    /* Who a change is recorded as. In Everyone (overview) nobody in particular is signed in, so changes made
       there belong to a labelled demo admin instead of "everyone". */
    window.rsActorId = function () { var id = window.rsWhoId(); return id === 'everyone' ? 'demo-admin' : id; };
    window.rsWho = function () {
      var id = window.rsActorId();
      var all = window.RS_PEOPLE || []; return all.filter(function (p) { return p.id === id; })[0] || all[0] || { id: id, name: id, role: '' };
    };
    /* Add a proposed change to the Proposals page (rs4-changes, newest first) and return it. */
    window.rsPropose = function (c) {
      var list = window.rsStore.get('rs4-changes', []);
      var n = list.reduce(function (m, x) { var k = parseInt(String(x.id).replace(/\D/g, ''), 10) || 0; return Math.max(m, k); }, 40);
      var who = window.rsWho();
      var item = Object.assign({ id: 'PRO-' + (n + 1), date: new Date().toISOString().slice(0, 10), status: 'review', by: who.name, byRole: who.role }, c);
      list.unshift(item); window.rsStore.put('rs4-changes', list); return item;
    };
    window.rsSetChange = function (id, status) {
      var list = window.rsStore.get('rs4-changes', []); list.forEach(function (x) { if (x.id === id) x.status = status; }); window.rsStore.put('rs4-changes', list);
    };
  </script>
  <script is:inline data-astro-rerun>
    /* Apply the saved look and light or dark mode before first paint, so the page never flashes.
       Also loads the extra web fonts a look needs, only when that look is chosen. */
    (function () {
      var FONTS = {
        drawing: 'family=Barlow+Condensed:wght@500;600;700&family=Barlow:ital,wght@0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Mono:wght@400;500;600'
      };
      var LOOK = { classic: { look: 'classic' }, studio: { look: 'studio' }, enterprise: { look: 'enterprise' }, contrast: { look: 'enterprise', contrast: 'high' }, drawing: { look: 'draw' } };
      // Studio is the default; Playful (stored as 'classic') is last in Settings. The mode follows the system (Auto)
      // until the viewer picks one. The retired Control room look falls back to the default.
      // v2: looks chosen before Studio became the default are cleared once, so everyone starts on Studio.
      window.rsApplyTheme = function () {
        var r = document.documentElement, s = 'studio', t = 'system';
        try { if (localStorage.getItem('rs4-look-v') !== '2') { localStorage.removeItem('rs4-skin'); localStorage.setItem('rs4-look-v', '2'); } s = localStorage.getItem('rs4-skin') || s; t = localStorage.getItem('rs4-theme') || t; } catch (_) {}
        if (!LOOK[s]) s = 'studio';
        var m = LOOK[s];
        r.setAttribute('data-look', m.look);
        if (m.contrast) r.setAttribute('data-contrast', m.contrast); else r.removeAttribute('data-contrast');
        // Only clear a light or dark mode this script set itself, so a host page's own setting stays.
        if (t === 'light' || t === 'dark') { r.setAttribute('data-theme', t); r.setAttribute('data-rs-theme', ''); }
        else if (r.hasAttribute('data-rs-theme')) { r.removeAttribute('data-theme'); r.removeAttribute('data-rs-theme'); }
        r.setAttribute('data-skin', s);
        r.setAttribute('data-mode', t === 'light' || t === 'dark' ? t : 'system');
        // Demo controls from Settings: each module On, Connected or Off (src/lib/modules.mjs), and whether agents
        // are shown. Modules become two word lists on <html>: data-off and data-conn.
        var ag = 'on', mods = window.RS_MODULES || {}, saved = null;
        try { ag = localStorage.getItem('rs4-agents') || ag; saved = JSON.parse(localStorage.getItem('rs6-modules') || 'null'); localStorage.removeItem('rs4-stage'); } catch (_) {}
        var off = [], conn = [], full = {};
        saved = saved || window.__rsModMem || null;
        Object.keys(mods).forEach(function (id) {
          var v = saved && /^(on|connected|off)$/.test(saved[id]) ? saved[id] : mods[id];
          full[id] = v;
          if (v === 'off') off.push(id); else if (v === 'connected') conn.push(id);
        });
        r.setAttribute('data-off', off.join(' ')); r.setAttribute('data-conn', conn.join(' '));
        // Capabilities (src/lib/modules.mjs): off with their module or what they require. Two more word lists.
        var fsaved = null; try { fsaved = JSON.parse(localStorage.getItem('rs6-features') || 'null'); } catch (_) {}
        var feats = window.rsResolveFeatures ? window.rsResolveFeatures(window.RS_CAPS || [], full, fsaved || window.__rsFeatMem || null) : {};
        var foff = [], fconn = [];
        Object.keys(feats).forEach(function (id) { if (feats[id] === 'off') foff.push(id); else if (feats[id] === 'connected') fconn.push(id); });
        r.setAttribute('data-feat-off', foff.join(' ')); r.setAttribute('data-feat-conn', fconn.join(' '));
        r.setAttribute('data-agents', ag);
        // Help mode (the ? switch): kept per window (session storage), and put back after every page swap.
        var hp = 'off'; try { hp = sessionStorage.getItem('rs5-help') === 'on' ? 'on' : 'off'; } catch (_) {}
        r.setAttribute('data-help', hp);
        // Signed in as a vendor: Keia Atlas narrows to their installation and the device reference.
        var who = window.rsWhoId ? window.rsWhoId() : 'anna';
        r.setAttribute('data-who', who);
        r.setAttribute('data-role', (window.RS_WHO_ROLE || {})[who] || 'delivery');
        r.setAttribute('data-who-kind', (window.RS_VENDORS || []).indexOf(who) >= 0 ? 'vendor' : 'staff');
        // Density (Comfortable or Compact), per person, before first paint (src/lib/depth.mjs; the Enterprise and High contrast looks default to Compact).
        var dn = {}; try { dn = JSON.parse(localStorage.getItem('rs6-density') || '{}') || {}; } catch (_) {}
        r.setAttribute('data-density', dn[who] === 'compact' || dn[who] === 'comfortable' ? dn[who] : (s === 'enterprise' || s === 'contrast' ? 'compact' : 'comfortable'));
        fontLink(s);
      };
      /* The web fonts a look needs (a stylesheet from Google for the Drawing set; the others are bundled).
         rsLookFonts(skin) resolves once that look's faces are downloaded, so a look change never shows a
         late font swap; rsPreloadLooks() warms every look when Settings opens. */
      var FACES = {
        studio: ['400 1em "Inter Variable"', '700 1em "Inter Variable"', '400 1em "JetBrains Mono Variable"'],
        classic: ['400 1em "Instrument Sans Variable"', '700 1em "Instrument Sans Variable"', '700 1em "Bricolage Grotesque Variable"', '400 1em "JetBrains Mono Variable"'],
        enterprise: ['400 1em "Inter Variable"', '700 1em "Inter Variable"', '400 1em "JetBrains Mono Variable"'],
        drawing: ['400 1em "Barlow"', '500 1em "Barlow"', '600 1em "Barlow"', '700 1em "Barlow"', '600 1em "Barlow Condensed"', '700 1em "Barlow Condensed"', '400 1em "IBM Plex Mono"', '500 1em "IBM Plex Mono"']
      };
      FACES.contrast = FACES.enterprise;
      function fontLink(s) {
        if (!FONTS[s]) return Promise.resolve();
        var id = 'font-' + s, l = document.getElementById(id);
        if (!l) {
          l = document.createElement('link');
          l.id = id; l.rel = 'stylesheet'; l.setAttribute('data-rs-font', '');
          l.href = 'https://fonts.googleapis.com/css2?' + FONTS[s] + '&display=swap';
          l.__rsLoaded = new Promise(function (ok) { l.onload = ok; l.onerror = ok; });
          document.head.appendChild(l);
        }
        return l.__rsLoaded || Promise.resolve();
      }
      window.rsLookFonts = function (s) {
        if (!FACES[s] || !document.fonts || !document.fonts.load) return Promise.resolve();
        return fontLink(s).then(function () {
          return Promise.all(FACES[s].map(function (f) { return document.fonts.load(f, 'Aa').catch(function () {}); }));
        });
      };
      window.rsPreloadLooks = function () { Object.keys(FACES).forEach(function (s) { window.rsLookFonts(s); }); };
      window.rsApplyTheme();
      // The client router swaps in the next page's <html> attributes; put the chosen look back.
      if (!window.__rsThemeHook) {
        window.__rsThemeHook = true;
        document.addEventListener('astro:after-swap', function () { window.rsApplyTheme(); });
        // Keep the look's font stylesheets across page changes (the router drops head tags the next page
        // lacks), so text never falls back to another font for a moment on the way to the next page.
        document.addEventListener('astro:before-swap', function (e) {
          document.querySelectorAll('link[data-rs-font]').forEach(function (l) {
            if (!e.newDocument.head.querySelector('link[href="' + l.getAttribute('href') + '"]')) e.newDocument.head.appendChild(l.cloneNode());
          });
        });
        // A static preview (plain files) uses relative links. The router swaps the next page in before it
        // updates the address, so relative paths would resolve against the old page. Make them full
        // addresses first (and the current page's stylesheets too, so shared ones are kept, not reloaded).
        var REL = /^(?![a-z][a-z0-9+.-]*:|#|\/)/i;
        var absolutise = function (root, base) {
          var n = 0;
          root.querySelectorAll('[href],[src]').forEach(function (el) {
            ['href', 'src'].forEach(function (a) { var v = el.getAttribute(a); if (v && REL.test(v)) { el.setAttribute(a, new URL(v, base).href); n++; } });
          });
          return n;
        };
        // Stylesheet tags come after this script, so check once the page has been read.
        document.addEventListener('DOMContentLoaded', function () { window.__rsRelative = absolutise(document.head, location.href) > 0; });
        // Relative-link build: load the next page ourselves and fix its paths before the router
        // looks at it (its own loader preloads stylesheets against the old address).
        document.addEventListener('astro:before-preparation', function (e) {
          if (!window.__rsRelative) return;
          e.loader = async function () {
            var res = await fetch(e.to.href, { signal: e.signal });
            e.newDocument = new DOMParser().parseFromString(await res.text(), 'text/html');
            absolutise(e.newDocument, e.to);
          };
        });
        // A link to a place's old address (Work, Devices) goes straight to its new one, never via the Moved page.
        document.addEventListener('astro:before-preparation', function (e) {
          var to = (window.RS_MOVED || {})[e.to.pathname];
          if (to) { var u = new URL(e.to.href); u.pathname = to; e.to = u; }
        });
        // Remember where each navigation is going (with its #tab), for pages that open on a tab.
        document.addEventListener('astro:before-preparation', function (e) { window.__rsNavTo = e.to; });
