        try { localStorage.setItem('rs6-modules', JSON.stringify(m)); localStorage.setItem('rs6-features', JSON.stringify(fc)); } catch (_) {}
        W.rsChange(applyDemo, synced('features'), { roots: ['.side', 'main', 'dialog#settings[open] .mods'] });
      };
      W.rsSetAgents = function (v) {
        try { localStorage.setItem('rs4-agents', v); } catch (_) {}
        W.rsChange(applyDemo, synced('agents'));
      };
      W.rsPickWho = function (id) {
        if (id === (W.rsWhoId && W.rsWhoId())) return;
        W.rsSetWho(id);
        W.rsChange(applyDemo, synced('who'));
      };
    })();
  </script>
  <script is:inline data-astro-rerun>
    (function () {
      var r = document.documentElement;
      // One button flips what you see: light goes dark, dark goes light. When the flip lands on what the
      // system would show anyway, it goes back to Auto, so Auto is never lost.
      var NAME = { system: 'Auto', light: 'Light', dark: 'Dark' };
      function mode() { try { return localStorage.getItem('rs4-theme') || 'system'; } catch (_) { return 'system'; } }
      function sysDark() { return matchMedia('(prefers-color-scheme: dark)').matches; }
      function showsDark() { var t = r.getAttribute('data-theme'); return t ? t === 'dark' : sysDark(); }
      function nextMode() { var want = showsDark() ? 'light' : 'dark'; return (want === 'dark') === sysDark() ? 'system' : want; }
      function label() {
        var m = mode(), want = showsDark() ? 'Light' : 'Dark';
        r.setAttribute('data-mode', m);
        document.querySelectorAll('[data-toggle-mode]').forEach(function (b) {
          b.setAttribute('aria-label', 'Colour mode: ' + NAME[m] + '. Select for ' + want);
          b.title = 'Switch to ' + want.toLowerCase() + (m === 'system' ? ' (now Auto)' : '');
        });
      }
      window.rsSyncMode = label;
      label();
      document.querySelectorAll('[data-toggle-mode]').forEach(function (b) {
        b.addEventListener('click', function () {
          var next = nextMode();
          try { localStorage.setItem('rs4-theme', next); } catch (_) {}
          window.rsTheme(function () { window.rsApplyTheme(); label(); });
        });
      });
    })();
  </script>
</body>
</html>
