---
// The employee layout: what someone sees after scanning the QR code on a room's table. The same
// tokens, fonts and motion as the console, but none of its chrome: no sidebar, no search, no Settings.
// A slim top bar with the wordmark and the office, the page, and a quiet footer. Light and dark follow
// the phone (or the choice made in the console on this browser).
import { ClientRouter } from 'astro:transitions';
import SimTag from '../components/SimTag.astro';
import '../styles/looks/studio.css';
import '../styles/base.css';
import '../styles/motion.css';
import { href } from '../lib/data.mjs';

interface Props { title: string; office: string; home: string }
const { title, office, home } = Astro.props;
---
<!doctype html>
<html lang="en-IE" data-look="studio">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex" />
  <title>{title} · Room guide</title>
  <meta name="description" content="How this room works, and a quick way to report a problem or ask for something." />
  <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
  <script is:inline data-astro-rerun>
    (function () {
      var r = document.documentElement, t = 'system';
      try { t = localStorage.getItem('rs4-theme') || t; } catch (_) {}
      if (t === 'light' || t === 'dark') r.setAttribute('data-theme', t); else r.removeAttribute('data-theme');
    })();
  </script>
  <ClientRouter />
</head>
<body class="guide-body">
  <header class="g-top">
    <a class="g-brand" href={href(home)} aria-label="Room guide home">
      <svg class="g-mark" viewBox="0 0 32 32" aria-hidden="true"><rect class="tile" x="1.5" y="1.5" width="28" height="28" rx="7" stroke-width="2" /><path class="tick" d="M8.5 16l4.5 4.5 10-10" fill="none" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <span><b>Room guide</b><small>{office}</small></span>
    </a>
    <SimTag kind="simulated" />
  </header>
  <main class="g-main" id="main">
    <slot />
  </main>
  <footer class="g-foot">
    <p>Aigna workplace technology · a Keia Atlas demo. Reports and requests stay in this browser.</p>
  </footer>
  <slot name="end" />
</body>
</html>

<style is:global>
  .guide-body { min-height: 100svh; display: grid; grid-template-rows: auto 1fr auto; background: var(--bg); font-size: 16px; }
  .g-top {
    position: sticky; top: 0; z-index: 20; display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: max(10px, env(safe-area-inset-top)) 16px 10px; background: color-mix(in srgb, var(--bg) 86%, transparent);
    -webkit-backdrop-filter: saturate(170%) blur(18px); backdrop-filter: saturate(170%) blur(18px);
    border-bottom: 1px solid var(--line); view-transition-name: mast;
  }
  .g-brand { display: flex; align-items: center; gap: 10px; color: var(--text); text-decoration: none; min-width: 0; }
  .g-brand:hover { color: var(--text); }
  .g-mark { width: 30px; height: 30px; flex: none; }
  .g-mark .tile { fill: var(--brand-tile, var(--accent)); stroke: var(--ink); }
  .g-mark .tick { stroke: #15161B; }
  .g-brand b { display: block; font: 700 16px/1.15 var(--font-display); }
  .g-brand small { display: block; font-size: 13px; color: var(--text-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .g-main { width: 100%; max-width: 760px; margin: 0 auto; padding: 16px 16px 40px; display: grid; gap: 16px; align-content: start; }
  .g-foot { padding: 20px 16px 28px; text-align: center; }
  .g-foot p { margin: 0 auto; max-width: 56ch; font-size: 12.5px; color: var(--text-3); }
  @media (min-width: 900px) { .g-main { max-width: 1040px; padding: 28px 32px 56px; gap: 20px; } .g-top { padding-inline: 32px; } }
</style>
