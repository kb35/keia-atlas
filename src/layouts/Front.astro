---
// The front door's layout: the same tokens, fonts and motion as the console (including the motion library's
// shapes: the health ring's states, the With chip), none of its chrome. A slim top bar
// (the mark, then Method, the demo and the source), the page, and a footer with the licence line and "Talk to us".
// Light and dark follow the system, or the choice made in the console on this browser.
import { ClientRouter } from 'astro:transitions';
import '../styles/looks/studio.css';
import '../styles/looks/contrast.css';   /* High contrast (Settings): its colours over Studio's shapes */
import '../styles/base.css';
import '../styles/motion.css';
import '../styles/motion-library.css';
import '../styles/a11y.css';
import { A11Y_BOOT } from '../lib/a11y.mjs';
import { href, DEMO_TODAY, CLOCK, DEMO_CLOCK_NOTE } from '../lib/data.mjs';
import { NAME, LINE, LINKS } from '../lib/brand.mjs';
import BrandMark from '../components/BrandMark.astro';

interface Props { title: string; description?: string }
const { title, description = LINE } = Astro.props;
---
<!doctype html>
<html lang="en-IE" data-look="studio" data-demo-today={DEMO_TODAY} data-demo-anchor={CLOCK.rolling ? CLOCK.anchor : undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
  <script is:inline data-astro-rerun set:html={A11Y_BOOT}></script>
  <script is:inline data-astro-rerun>
    (function () {
      var r = document.documentElement, t = 'system', skin = '';
      try { t = localStorage.getItem('rs4-theme') || t; skin = localStorage.getItem('rs4-skin') || ''; } catch (_) {}
      // The High contrast look chosen in the console (or Settings › Accessibility) carries its colours here too.
      if (skin === 'contrast') r.setAttribute('data-contrast', 'high'); else r.removeAttribute('data-contrast');
      if (t === 'light' || t === 'dark') r.setAttribute('data-theme', t); else r.removeAttribute('data-theme');
      r.setAttribute('data-look', 'studio');
    })();
  </script>
  <ClientRouter />
</head>
<body class="fd-body">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="fd-top">
    <a class="fd-brand" href={href('/welcome/')} aria-label={`${NAME}: the front door`}>
      <!-- The Keia Atlas mark (v11): one slab at any scale, the closed ring for healthy (docs/brand.md). -->
      <span class="fd-mark" transition:persist="keia-mark-front"><BrandMark id="kam-front" size={36} motion /></span>
      <b>Keia <span class="kw">Atlas</span></b>
    </a>
    <nav class="fd-nav" aria-label="Front door">
      <a href={href('/method/')}>Method</a>
      <a href={href('/')} data-as="liam">Demo</a>
      <a href={LINKS.source}>Source</a>
    </nav>
  </header>
  <main id="main" class="fd-main">
    <slot />
  </main>
  <footer class="fd-foot">
    <p>Keia Atlas code: <a href={LINKS.licence}>Apache 2.0</a>. The Keia Method text: <a href={LINKS.ccbysa}>CC BY-SA 4.0</a>. Every company, person, room and incident in the demo is made up.{DEMO_CLOCK_NOTE && ` ${DEMO_CLOCK_NOTE}`}</p>
    <p>Copyright Red Hat, Inc. Created by Keith Brady. <a href={LINKS.discussions}>Talk to us</a> · <a href={href('/about/accessibility/')}>Accessibility</a></p>
    <p class="fd-still-row"><button type="button" class="fd-still" data-still-toggle>Pause animations</button></p>
  </footer>
  <script>
    // "See it in use" and the other demo doors open Atlas as a named person (View as), set just before the page
    // changes. The console keeps this choice per window (rs5-who) and for the next window (rs4-who).
    function viewAs(e: Event) {
      const a = (e.target as Element | null)?.closest?.('a[data-as]') as HTMLAnchorElement | null;
      if (!a) return;
      const id = a.dataset.as!;
      try { sessionStorage.setItem('rs5-who', id); sessionStorage.setItem('rs5-me', id); } catch (_) {}
      try { localStorage.setItem('rs4-who', id); } catch (_) {}
    }
    if (!(window as any).__fdViewAs) { (window as any).__fdViewAs = true; document.addEventListener('click', viewAs, true); }

    // Pause animations (WCAG 2.2.2): every moving picture on the page stops where it is, and the choice is kept, as
    // Settings › Accessibility › Keep things still (src/lib/front-loop.mjs listens for rs:a11y and follows).
    function stillButton() {
      const b = document.querySelector<HTMLButtonElement>('[data-still-toggle]');
      if (!b || (b as any).__rs) return; (b as any).__rs = true;
      const W = window as any;
      const show = () => { b.textContent = W.rsA11y?.().still ? 'Play animations' : 'Pause animations'; };
      b.addEventListener('click', () => { W.rsSetA11y?.({ still: !W.rsA11y?.().still }); show(); });
      document.addEventListener('rs:a11y', show);
      show();
    }
    stillButton();
    document.addEventListener('astro:page-load', stillButton);
  </script>
</body>
</html>

<style is:global>
  /* Motion tokens docs/rules/motion.md adds, and the colour-blind-safe health palette of design notes, on the
     front door and the method pages ahead of the console (the fallbacks in components stay the console's colours). */
  :root { --ease-exit: cubic-bezier(.4, 0, 1, 1); --dur-press: 80ms; --dur-zoom: 360ms; --dur-chip: 320ms; }
  .fd-body {
    --h-fine: #0E8A63; --h-fine-ink: #235537; --h-fine-soft: #DCEFE6;
    --h-review: #B36B00; --h-review-ink: #614B05; --h-review-soft: #F6EBD3;
    --h-fault: #D55E00; --h-fault-ink: #7E2B24; --h-fault-soft: #F9E3D4;
    --h-progress: #2A5B8F; --h-progress-ink: #214A75; --h-progress-soft: #E3EBF4;
    --h-planned: #5E479B; --h-planned-ink: #4A387C; --h-planned-soft: #EBE6F4;
    --h-off: #8C857A; --h-off-ink: #4A453F; --h-off-soft: #ECE8E1;
  }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .fd-body {
    --h-fine: #009E73; --h-fine-ink: #AEDDC1; --h-fine-soft: #15261C;
    --h-review: #E69F00; --h-review-ink: #EFD696; --h-review-soft: #2C2412;
    --h-fault: #D55E00; --h-fault-ink: #F5B1A9; --h-fault-soft: #33201A;
    --h-progress: #56B4E9; --h-progress-ink: #B4D0EE; --h-progress-soft: #16222E;
    --h-planned: #CC79A7; --h-planned-ink: #D8CCF0; --h-planned-soft: #231E30;
    --h-off: #7D766C; --h-off-ink: #CFC8BD; --h-off-soft: #22201D;
  } }
  :root[data-theme="dark"] .fd-body {
    --h-fine: #009E73; --h-fine-ink: #AEDDC1; --h-fine-soft: #15261C;
    --h-review: #E69F00; --h-review-ink: #EFD696; --h-review-soft: #2C2412;
    --h-fault: #D55E00; --h-fault-ink: #F5B1A9; --h-fault-soft: #33201A;
    --h-progress: #56B4E9; --h-progress-ink: #B4D0EE; --h-progress-soft: #16222E;
    --h-planned: #CC79A7; --h-planned-ink: #D8CCF0; --h-planned-soft: #231E30;
    --h-off: #7D766C; --h-off-ink: #CFC8BD; --h-off-soft: #22201D;
  }
  /* A control reached with Tab is never hidden under the sticky bar or the lifecycle strip (WCAG 2.4.11). */
  html:has(.fd-body) { scroll-padding-top: 128px; }
  .fd-body { min-height: 100svh; display: grid; grid-template-rows: auto 1fr auto; background: var(--bg); color: var(--text); font: 400 14px/1.5 var(--font-sans); }
  .fd-top {
    position: sticky; top: 0; z-index: 20; display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: max(10px, env(safe-area-inset-top)) var(--pad-x) 10px; background: color-mix(in srgb, var(--bg) 88%, transparent);
    -webkit-backdrop-filter: saturate(170%) blur(18px); backdrop-filter: saturate(170%) blur(18px);
    border-bottom: 1px solid var(--line); view-transition-name: mast;
  }
  .fd-brand { display: flex; align-items: center; gap: 10px; color: var(--text); text-decoration: none; min-height: 44px; }
  .fd-brand:hover { color: var(--text); }
  .fd-brand b { font: 650 16px/1 var(--font-sans); letter-spacing: -.01em; }
  .fd-brand b .kw { font-weight: 430; }
  .fd-mark { /* text-size: icon */ width: 36px; height: 36px; flex: none; display: block; } /* one logo size on every layout */
  .fd-mark .kam { display: block; width: 100%; height: 100%; }
  .fd-nav { display: flex; gap: 4px; }
  .fd-nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; border-radius: 8px; color: var(--text-2); text-decoration: none; font-size: 14px; transition: color var(--dur-hover) var(--ease-settle), background var(--dur-hover) var(--ease-settle); }
  .fd-nav a:hover { color: var(--text); background: var(--surface-2); }
  .fd-main { width: 100%; max-width: 1240px; margin: 0 auto; padding: 0 var(--pad-x) 48px; container: fd / inline-size; min-width: 0; }
  .fd-foot { border-top: 1px solid var(--line); padding: 24px var(--pad-x) 32px; display: grid; gap: 6px; }
  .fd-foot p { margin: 0 auto; width: 100%; max-width: calc(1240px - 2 * var(--pad-x)); font-size: 13px; color: var(--text-2); }
  .fd-still-row { display: flex; }
  .fd-still { font: 500 13px/1 var(--font-sans); min-height: 32px; padding: 0 12px; border-radius: 999px; border: 1px solid var(--line-strong); background: transparent; color: var(--text-2); cursor: pointer; transition: color var(--dur-hover) var(--ease-settle), background-color var(--dur-hover) var(--ease-settle); }
  .fd-still:hover { color: var(--text); background: var(--surface-2); }
  /* Nothing moves on its own under reduced motion, so there is nothing to pause. */
  @media (prefers-reduced-motion: reduce) { .fd-still-row { display: none; } }
  @media (max-width: 479px) { .fd-nav a { padding: 0 8px; } .fd-brand b { font-size: 15px; } }
</style>
