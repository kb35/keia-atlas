---
import Moved from '../../../components/Moved.astro';
import { spaceTypes } from '../../../lib/data.mjs';
import { MOVED_TYPES } from '../../../lib/moved-types.mjs';
export async function getStaticPaths() {
  return [
    ...Object.keys(spaceTypes).map((id) => ({ params: { id }, props: { to: id } })),
    ...Object.entries(MOVED_TYPES).map(([id, to]) => ({ params: { id }, props: { to } })),
  ];
}
const { to } = Astro.props;
---
<Moved to={`/room-profiles/${to}/`} />
