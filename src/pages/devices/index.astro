---
// Units: every unit in every room, by office or by model. A unit can be ordered, procured, in service or on its way out,
// so the page says "units", not "installed". Each row opens the unit's own page. The filters are FilterBar.astro
// and work in both views. (Device units were a separate page; they are the "What it is" view here now. See decision 0021.)
import Shell from '../../layouts/Shell.astro';
import DeviceArt from '../../components/DeviceArt.astro';
import { spaces, sites, spaceTypes, incidents, models, SITE_ORDER, DEVICE_STATUS, UNIT_STATUS, REGION_LABEL, className, modelName, plural, href, deviceName } from '../../lib/data.mjs';
import DeviceGlyph from '../../components/DeviceGlyph.astro';
import FilterBar from '../../components/FilterBar.astro';
import PageBand from '../../components/PageBand.astro';
import EmptyState from '../../components/EmptyState.astro';
import HealthGlyph from '../../components/HealthGlyph.astro';
// A device with an open incident radiates red, the same signal as its room on the Rooms page.
const openInc = Object.values(incidents).filter((i) => i.state !== 'resolved');
const bad = (s, p) => openInc.some((i) => i.room === s.id && i.position === p.position);
// One list of units feeds both views, so both count the same thing: one row for each position in a room
// (its current unit, or the one on order). The office view groups it by site and room, the model view by model.
const rows = (sid) => Object.values(spaces).filter((s) => s.site === sid).sort((a, b) => String(a.number ?? a.id).localeCompare(String(b.number ?? b.id), 'en', { numeric: true }))
  .flatMap((s) => [...s.positions, ...s.olderKit, ...s.spareKit].map((p) => ({ s, p, unit: p.current ?? p.units[0] })));
const ALL = SITE_ORDER.flatMap((sid) => rows(sid));
const byModel = {}, noModel = [];
for (const r of ALL) { if (r.p.model) (byModel[r.p.model] ??= []).push(r); else noModel.push(r); }
const mids = Object.keys(byModel).sort((a, b) => byModel[b].length - byModel[a].length);
const total = ALL.length;
const LIGHT = { manage: 'fine', deploy: 'progress', retire: 'progress', plan: 'planned', procure: 'planned', spare: 'off' };
// Filters for the finder: what state a device is in, and its region.
const stateOf = (p, u) => (p.spare ? 'spare' : p.older ? 'older' : p.legacy ? 'replacing' : u?.stage === 'deploy' ? 'installing' : u?.stage === 'retire' ? 'replacing' : ['plan', 'procure'].includes(u?.stage) ? 'planned' : 'service');
const regionOf = (s) => sites[s.site]?.region ?? 'none';
const nState = (k) => ALL.filter((r) => stateOf(r.p, r.unit) === k).length;
const byClass = {};
for (const id of mids) (byClass[models[id].class] ??= []).push(id);
// The filters: where (region, office, room profile), what (device class) and how far along (status).
const allSpaces = Object.values(spaces);
const STATE = { service: 'In service', installing: 'Being installed', planned: 'Planned or on order', spare: 'Spare', replacing: 'Being replaced', older: 'Older kit' };
const FACETS = [
  { key: 'region', label: 'Region', options: ['amer', 'emea', 'apac'].map((value) => ({ value, label: REGION_LABEL[value].replace('Europe, Middle East and Africa', 'EMEA') })) },
  { key: 'site', label: 'Office', options: SITE_ORDER.map((value) => ({ value, label: sites[value].name, sub: sites[value].kind === 'remote' ? 'Home offices' : sites[value].city })) },
  { key: 'cls', label: 'Kind', options: [...new Set(allSpaces.flatMap((s) => [...s.positions, ...s.olderKit, ...s.spareKit].map((p) => p.cls)))].sort((a, b) => className(a).localeCompare(className(b))).map((value) => ({ value, label: className(value) })) },
  { key: 'state', label: 'Status', options: Object.entries(STATE).map(([value, label]) => ({ value, label })) },
  { key: 'type', label: 'Space type', options: [...new Set(allSpaces.map((s) => s.space_type))].sort((a, b) => spaceTypes[a].profile.name.localeCompare(spaceTypes[b].profile.name)).map((value) => ({ value, label: spaceTypes[value].profile.name })) },
];
const VIEWS = [{ value: 'site', label: 'Where it is', show: '.dtree' }, { value: 'model', label: 'What it is', show: '.dkinds' }];
// Sort re-orders the groups: offices, or in the model view the kinds and the models in each.
const SORT = { options: [{ value: 'site', label: 'By office' }, { value: 'name', label: 'By name' }, { value: 'count', label: 'Most units first' }] };
const withInc = ALL.filter((r) => bad(r.s, r.p)).length;
const ANSWER = `${withInc ? `${withInc} ${withInc === 1 ? 'unit has' : 'units have'} an open incident` : 'No unit has an open incident'} · ${nState('installing')} being installed`;
const NUMBERS = [
  { n: total, label: 'Units', fact: true },
  { n: nState('installing'), label: 'Being installed', to: '?state=installing' },
  { n: nState('spare'), label: 'Spare', to: '?state=spare' },
  { n: nState('older'), label: 'Older kit', to: '?state=older', tone: nState('older') ? 'warn' : undefined },
];
const facetAttrs = (s, p, u) => ({ 'data-f-region': regionOf(s), 'data-f-site': s.site, 'data-f-type': s.space_type, 'data-f-cls': p.cls, 'data-f-state': stateOf(p, u) });
---
<Shell title="Units" section="devices" crumbs={[{ label: 'Units' }]}>
  <PageBand overline="Directory" title="Units" rec="dd-devices" answer={ANSWER} lede="One row for each position in a space: its current unit, or the one on order. Spare units are in each office's IT store." numbers={NUMBERS} />
  <div class="content devs">
    <FilterBar facets={FACETS} placeholder="Find a unit, hostname or serial" label="Find a unit" noun={['unit', 'units']} scope=".devs" views={VIEWS} viewKey="rs4-units-view" sort={SORT} />

    <div class="dev-panels">
    <div class="dtree">
    {SITE_ORDER.map((sid, si) => {
      const list = rows(sid);
      const rooms = [...new Set(list.map((r) => r.s))];
      const inst = list.filter((r) => r.unit?.stage === 'deploy').length;
      return (
        <details class="dsite card" open data-fb-group data-i={si} data-name={sites[sid].name} data-n={list.length}>
          <summary>
            <span class="code">{sites[sid].code}</span>
            <span class="ds-name"><b>{sites[sid].name}</b><small>{sites[sid].kind === 'remote' ? 'Home offices' : sites[sid].city} · {plural(rooms.length, 'space')}</small></span>
            <span class="ds-stats">{inst > 0 && <span class="rc-st">{inst} being installed</span>}<span class="num">{plural(list.length, 'unit')}</span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></span>
          </summary>
          <div class="ds-rooms">
            {rooms.map((s) => (
              <section class="droom" data-fb-group>
                <header><a href={href(`/rooms/${s.id}/`)}><b>{s.number ? `${s.number} ` : ''}{s.name}</b></a><small>{s.type.profile.name}</small></header>
                <ul>
                  {list.filter((r) => r.s === s).map(({ p, unit }) => (
                    <li class:list={{ alert: bad(s, p) }} data-fi data-find={`${deviceName(s, p, { site: true })} ${sites[s.site].city ?? ''} ${s.type.profile.name} ${p.hostname ?? ''} ${modelName(p.model)} ${className(p.cls)} ${unit?.serial ?? ''} ${unit?.asset_tag ?? ''} ${s.number ?? ''}`} {...facetAttrs(s, p, unit)}>
                      <a href={unit ? href(`/device/?tag=${unit.asset_tag}`) : href(`/rooms/${s.id}/`)} class:list={['dline', { 'rs-radiate': bad(s, p) }]}>
                        <span class="dg"><DeviceGlyph cls={p.cls} size={26} /></span>
                        <span class="dn"><b>{deviceName(s, p)}</b><small>{p.model ? modelName(p.model) : 'Model set per project'}{p.hostname ? ` · ${p.hostname}` : ''}</small></span>
                        <HealthGlyph state={bad(s, p) ? 'fault' : LIGHT[unit?.stage ?? 'plan']} size={12} title={bad(s, p) ? 'an open incident' : DEVICE_STATUS[unit?.stage ?? 'plan']} />
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </details>
      );
    })}
    </div>

    <div class="dkinds" hidden data-um>
      {Object.entries(byClass).map(([cls, ids], ci) => (
        <section class="dkind" data-fb-group data-i={ci} data-name={className(cls)} data-n={ids.reduce((n, id) => n + byModel[id].length, 0)}>
          <h2><a href={href(`/profiles/${cls}/`)}>{className(cls)}</a><span class="faint num">{ids.reduce((n, id) => n + byModel[id].length, 0)}</span></h2>
          <div class="dk-models">
            {ids.map((id, mi) => (
              <details class="card unit-model" data-fb-group data-i={mi} data-name={modelName(id)} data-n={byModel[id].length}>
                <summary>
                  <span class="stage um-art"><DeviceArt model={id} cls={models[id].class} small label="" /></span>
                  <span><b>{modelName(id)}</b><small class="muted">{plural(byModel[id].length, 'unit')}</small></span>
                  <span class="um-n num">{byModel[id].length}</span>
                </summary>
                <ul class="um-list">
                  {byModel[id].map(({ s, p, unit }) => (
                    <li class:list={{ alert: bad(s, p) }} data-fi data-find={`${deviceName(s, p, { site: true })} ${sites[s.site].city ?? ''} ${s.type.profile.name} ${unit?.serial ?? ''} ${unit?.asset_tag ?? ''} ${modelName(id)} ${className(p.cls)} ${p.hostname ?? ''} ${s.number ?? ''}`} {...facetAttrs(s, p, unit)}>
                      <a href={unit ? href(`/device/?tag=${unit.asset_tag}`) : href(`/rooms/${s.id}/`)} class:list={['dline', { 'rs-radiate': bad(s, p) }]}><span class="dn"><b>{deviceName(s, p, { site: true })}</b><small class="mono">{unit ? `${unit.serial} · ${unit.asset_tag}` : 'On order'}</small></span><HealthGlyph state={bad(s, p) ? 'fault' : LIGHT[unit?.stage ?? 'plan']} size={12} title={bad(s, p) ? 'an open incident' : UNIT_STATUS[unit?.stage ?? 'plan']} /></a>
                    </li>
                  ))}
                </ul>
                {byModel[id].length > 8 && <button type="button" class="btn small um-more" data-um-more>Show all {byModel[id].length}</button>}
              </details>
            ))}
          </div>
        </section>
      ))}
      {noModel.length > 0 && (
        <section class="dkind" data-fb-group data-last>
          <h2>Model not chosen yet<span class="faint num">{noModel.length}</span></h2>
          <div class="dk-models">
            <details class="card unit-model" data-fb-group>
              <summary>
                <span class="stage um-art"><DeviceGlyph cls="unknown" size={40} /></span>
                <span><b>Set per project</b><small class="muted">{plural(noModel.length, 'unit')}</small></span>
                <span class="um-n num">{noModel.length}</span>
              </summary>
              <ul class="um-list">
                {noModel.map(({ s, p, unit }) => (
                  <li class:list={{ alert: bad(s, p) }} data-fi data-find={`${deviceName(s, p, { site: true })} ${sites[s.site].city ?? ''} ${s.type.profile.name} ${unit?.serial ?? ''} ${unit?.asset_tag ?? ''} ${className(p.cls)} ${s.number ?? ''}`} {...facetAttrs(s, p, unit)}>
                    <a href={unit ? href(`/device/?tag=${unit.asset_tag}`) : href(`/rooms/${s.id}/`)} class:list={['dline', { 'rs-radiate': bad(s, p) }]}><span class="dn"><b>{deviceName(s, p, { site: true })}</b><small class="mono">{unit ? `${unit.serial} · ${unit.asset_tag}` : 'On order'}</small></span><HealthGlyph state={bad(s, p) ? 'fault' : LIGHT[unit?.stage ?? 'plan']} size={12} title={bad(s, p) ? 'an open incident' : UNIT_STATUS[unit?.stage ?? 'plan']} /></a>
                  </li>
                ))}
              </ul>
              {noModel.length > 8 && <button type="button" class="btn small um-more" data-um-more>Show all {noModel.length}</button>}
            </details>
          </div>
        </section>
      )}
    </div>
    <EmptyState text="No units match these filters." />
    </div>
  </div>
  <script is:inline data-astro-rerun slot="end">
    (function () {
      var um = document.querySelector('[data-um]'); if (!um || um.__um) return; um.__um = true;
      // Sort: offices, kinds and models re-order inside the bar's own run, so they slide into place.
      var bar = document.querySelector('[data-fb]');
      var nat = function (a, b) { return String(a).localeCompare(String(b), 'en', { numeric: true }); };
      var order = function (box, by) {
        var kids = Array.prototype.slice.call(box.children);
        kids.sort(function (a, b) {
          if ('last' in a.dataset || 'last' in b.dataset) return ('last' in a.dataset ? 1 : 0) - ('last' in b.dataset ? 1 : 0);
          var c = by === 'name' ? nat(a.dataset.name, b.dataset.name) : by === 'count' ? +b.dataset.n - +a.dataset.n : 0;
          return c || +a.dataset.i - +b.dataset.i;
        });
        kids.forEach(function (k) { box.appendChild(k); });
      };
      var reorder = function (by) {
        order(document.querySelector('.dtree'), by);
        order(um, by);
        um.querySelectorAll('.dk-models').forEach(function (m) { order(m, by); });
      };
      if (bar) {
        bar.addEventListener('fb:sort', function (e) { bar.rsFilter.run(true, function () { reorder(e.detail.value); }); });
        var s0 = bar.rsFilter ? bar.rsFilter.sort() : new URLSearchParams(location.search).get('sort');
        if (s0 && s0 !== 'site') reorder(s0);
      }
      // A long list of units shows its first eight and a "Show all"; no box scrolls inside itself.
      um.addEventListener('click', function (e) {
        var b = e.target.closest('[data-um-more]'); if (!b) return;
        var list = b.parentNode.querySelector('.um-list');
        var y0 = b.getBoundingClientRect().top;
        window.rsHold(um, function () { var open = list.classList.toggle('um-open'); b.textContent = open ? 'Show fewer' : 'Show all ' + list.children.length; });
        var dy = b.getBoundingClientRect().top - y0; if (Math.abs(dy) > 1) window.scrollBy(0, dy);
      });
      // In the model view each model opens while a filter is on, so the matching units are seen, and closes again after.
      document.addEventListener('fb:change', function (e) {
        var on = e.detail && e.detail.active;
        um.toggleAttribute('data-filtering', !!on);
        document.querySelectorAll('details.unit-model').forEach(function (d) {
          if (on && !d.classList.contains('fb-out')) { if (!('was' in d.dataset)) d.dataset.was = d.open ? '1' : '0'; d.open = true; }
          else if (!on && 'was' in d.dataset) { d.open = d.dataset.was === '1'; delete d.dataset.was; }
        });
      });
    })();
  </script>
</Shell>
<style is:global>
  .droom li.alert > .dline, .um-list li.alert > .dline { background: var(--h-fault-soft); }
  .unit-model { overflow: hidden; }
  .unit-model > summary { cursor: pointer; list-style: none; display: grid; grid-template-columns: 72px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 8px 14px 8px 8px; }
  .unit-model > summary::-webkit-details-marker { display: none; }
  .unit-model > summary b { display: block; font-size: var(--fs-lede); }
  .unit-model > summary small { display: block; font-size: var(--fs-code); }
  .um-art { display: grid; place-items: center; padding: 2px; border-radius: var(--radius); }
  .um-art .model-art { width: 64px; }
  .um-n { font: var(--weight-display) 22px/1 var(--font-display); }
</style>

<style>
  .dev-panels { display: grid; gap: 10px; }
  .dtree { display: grid; gap: 10px; }
  .dsite > summary { list-style: none; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 14px; align-items: center; padding: 10px 16px; cursor: pointer; }
  .dsite > summary::-webkit-details-marker { display: none; }
  .ds-name b { display: block; font-size: var(--fs-h3); } .ds-name small { color: var(--text-2); font-size: var(--fs-support); }
  .ds-stats { display: flex; gap: 12px; align-items: center; font-weight: var(--fw-title); }
  .ds-stats svg { color: var(--text-3); transition: transform var(--dur-state) var(--ease-settle); }
  .dsite[open] .ds-stats svg { transform: rotate(90deg); }
  /* Rooms flow down columns, so a short room never leaves a hole beside a tall one. */
  .ds-rooms { columns: 4 250px; column-gap: 10px; padding: 0 12px 4px; animation: rise var(--dur-enter, 440ms) var(--ease-settle); }
  .droom { break-inside: avoid; margin: 0 0 10px; border: 1px solid var(--line); border-radius: var(--radius); padding: 8px 8px 4px; background: var(--surface-2); }
  .droom header { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; padding: 0 4px 4px; }
  .droom header a { color: inherit; text-decoration: none; } .droom header a:hover { text-decoration: underline; }
  .droom header small { font-size: var(--fs-code); color: var(--text-3); text-align: right; }
  .droom ul, .um-list { list-style: none; margin: 0; padding: 0; }
  .dline { display: grid; grid-template-columns: 30px minmax(0, 1fr) var(--glyph-col, 14px); gap: 8px; align-items: center; padding: 3px 4px; border-radius: var(--radius); color: inherit; text-decoration: none; transition: background var(--dur-state), transform var(--dur-state) var(--ease-settle); }
  .um-list .dline { grid-template-columns: minmax(0, 1fr) var(--glyph-col, 14px); padding: 6px 12px; }
  .dline:hover { background: var(--surface); transform: translateX(3px); color: inherit; }
  .dg { display: grid; place-items: center; color: var(--art-line, var(--text-2)); }
  .dn { min-width: 0; } .dn b { display: block; font-size: var(--fs-body); font-weight: var(--fw-name); } .dn b::first-letter { text-transform: uppercase; }
  .dn small { display: block; font-size: var(--fs-mark); color: var(--text-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dkinds { display: grid; gap: 14px; }
  .dkind h2 { display: flex; gap: 10px; align-items: baseline; font-size: 17px; margin: 0 0 6px; }
  .dkind h2 a { color: inherit; }
  .dk-models { columns: 3 320px; column-gap: 10px; }
  .dk-models > .unit-model { break-inside: avoid; margin: 0 0 10px; }
  .um-list { border-top: var(--border-rule); }
  .dkinds:not([data-filtering]) .um-list:not(.um-open) > li:nth-child(n+9) { display: none; }
  .dkinds[data-filtering] .um-more { display: none; }
  .um-more { margin: 8px 12px 10px; }
  @media (max-width: 760px) { .ds-rooms, .dk-models { columns: 1; } .dsite > summary { padding: 10px 12px; grid-template-columns: auto minmax(0, 1fr); gap: 8px 12px; } .ds-stats { grid-column: 1 / -1; justify-content: space-between; } }
</style>
