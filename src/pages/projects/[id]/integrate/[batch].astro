---
// One batch of a project's Deploy work: every unit that shares a configuration. Record archetype. The units (only what differs per unit, and
// where each step stands) beside the shared setup, done once for all of them. Keia Atlas's checks fill
// the step cells; a person accepts what passed (A on the keyboard), fixes the exceptions, and opens
// one unit's full detail only when needed. The setup order and every setting follow, folded away.
import Shell from '../../../../layouts/Shell.astro';
import PageBand from '../../../../components/PageBand.astro';
import Section from '../../../../components/Section.astro';
import LiveBar from '../../../../components/LiveBar.astro';
import IntegrateLive from '../../../../components/IntegrateLive.astro';
import { projects, PHASE_LABEL, phasesOf } from '../../../../lib/data.mjs';
import { integratePlan, buildModel, batchHref } from '../../../../lib/integrate.mjs';
import { cellHtml, needsHtml, sharedHtml, setupHtml } from '../../../../lib/integrate-view.mjs';

export function getStaticPaths() {
  return Object.values(projects).filter((p) => phasesOf(p).includes('integrate')).flatMap((p) => {
    const plan = integratePlan(p);
    return plan.batches.map((b) => ({ params: { id: p.id.toLowerCase(), batch: b.id }, props: { pid: p.id, plan, bid: b.id } }));
  });
}
const { pid, plan, bid } = Astro.props;
const p = projects[pid] ?? Object.values(projects).find((x) => x.id === pid);
const M = buildModel(plan);
const b = M.B.get(bid);
const sum = M.batchSum(bid);
const PHASE = PHASE_LABEL.integrate;
const home = `/projects/${p.id.toLowerCase()}/`;
const i = plan.batches.findIndex((x) => x.id === bid);
const next = plan.batches[i + 1] ?? null;
const units = b.units.map((id) => M.U.get(id));
const hasHost = units.some((u) => u.networked);
const hasPair = units.some((u) => u.pairs);
const nIssues = new Set(sum.issues.map((z) => z.id)).size;
const plural = (n, one, many) => `${n} ${n === 1 ? one : many ?? `${one}s`}`;
const answer = nIssues ? `${plural(nIssues, 'unit')} to review · ${sum.done} of ${sum.total} set up`
  : sum.ready.length ? `${plural(sum.ready.length, 'unit')} checked, ready to accept · ${sum.done} of ${sum.total} set up`
  : sum.done === sum.total ? `All ${plural(sum.total, 'unit')} set up · nothing to review`
  : `${sum.done} of ${plural(sum.total, 'unit')} set up · nothing to review`;
const lede = b.touched ? 'Already in the spaces: re-check each one against the new units.' : b.cfg ? `${b.cfg.name} ${b.cfg.version}: the shared setup once, then only what differs per unit.` : 'Nothing to set on these: provision and install, then the room test.';
---
<Shell title={`${b.title}: ${p.name}`} section="projects" minStage={3} vendorOk about={{ kind: 'project', label: `${p.id} ${p.name}, ${b.title}`, to: `${home}integrate/${bid}/` }}
  crumbs={[{ label: 'Projects', to: '/projects/' }, { label: p.name, to: home }, { label: PHASE, to: `${home}integrate/` }, { label: b.title }]}>
  <PageBand overline={`Batch ${b.n} of ${plan.batches.length} · Project ${p.id}`} title={b.title} answer={answer} lede={lede} sim="live" rec={`int-${bid}`}
    numbers={[
      { n: nIssues, label: 'Ready for you', to: '#needs', tone: nIssues ? 'warn' : undefined, id: 'int-needs' },
      { n: sum.ready.length, label: 'Checked, to accept', to: '#units', tone: sum.ready.length ? 'good' : undefined, id: 'int-accept' },
      { n: `${sum.done}/${sum.total}`, label: 'Set up', to: '#units', id: 'int-setup' },
    ]}>
    <a slot="action" class="btn primary" data-help="integrate.next-batch" href={next ? batchHref(plan, next.id) : `${plan.base}`}>{next ? 'Open the next batch' : `Back to ${PHASE}`}</a>
  </PageBand>

  <div class="content integrate ib" data-int data-page="batch" data-focus={bid}>
    <p class="ib-vendor" data-vendor-only>Setup is done by Aigna's engineers. Your installs are on the <a href={plan.base}>{PHASE} page</a>.</p>

    <div class="g12 top ib-top">
      <section class="card s-12 ib-shared" aria-labelledby="ib-sh-h" data-engineer-only>
        <div class="ib-sh-l">
          <header class="ib-h" data-help="integrate.shared"><h2 id="ib-sh-h">{b.steps.includes('configure') ? `Once for all ${b.units.length}` : 'Nothing shared to set'}</h2>{b.via && <span class="faint">Through {b.via}</span>}</header>
          <div data-slot="shared" data-b={bid} set:html={sharedHtml(M, bid)} />
          {b.settings && (
            <p class="ib-set">
              <span>{b.settings.set} settings to set and {b.settings.verify} to check; {b.settings.leave} left at the manufacturer's default.</span>
              <a href="#every-setting">See every setting</a>
              {b.cfg && <a href={b.cfg.link}>The setup guide</a>}
            </p>
          )}
        </div>
        {b.same.length > 0 && (
          <div class="ib-same" data-help="integrate.same">
            <h3>The same on every unit</h3>
            <dl>
              {b.same.slice(0, 6).map((x) => <div><dt>{x.t}</dt><dd>{x.val}</dd></div>)}
            </dl>
            {b.same.length > 6 && <p class="faint">and {b.same.length - 6} more, all in the setup guide</p>}
          </div>
        )}
      </section>
      <section class="card s-12 ib-units" id="units" data-units aria-labelledby="ib-units-h">
        <header class="ib-h" data-help="integrate.units">
          <h2 id="ib-units-h">The units</h2>
          <span class="faint">Only what differs per unit. Each unit's build sheet has every setting worked out.</span>
        </header>
        <div class="ib-ua" data-slot="uaccept" data-b={bid} data-engineer-only></div>
        <div class="ib-needs" id="needs" data-slot="needs" data-batch={bid} data-engineer-only set:html={needsHtml(M, { batch: bid })} />
        <table class="ut" style={`--steps:${b.steps.length}`}>
          <thead>
            <tr>
              <th scope="col" class="ut-pick" data-engineer-only><input type="checkbox" data-pick="all" aria-label="Select every unit" data-help="integrate.pick" /></th>
              <th scope="col">Unit</th>
              {hasHost && <th scope="col" class="ut-hc">Hostname</th>}
              {hasPair && <th scope="col" class="ut-pc">Pairs with</th>}
              {b.steps.map((s) => <th scope="col" class="ut-sh" data-help="integrate.step" data-help-name={M.LABEL[s]} data-step-col={s}>{M.LABEL[s]}</th>)}
            </tr>
          </thead>
          <tbody>
            {units.map((u) => (
              <>
                <tr data-u={u.id} tabindex="0" data-help="integrate.row">
                  <td class="ut-pick" data-engineer-only><input type="checkbox" data-pick aria-label={`Select ${u.name}`} /></td>
                  <th scope="row" class="ut-name">
                    <button type="button" class="ut-open" data-act="expand" data-u={u.id} aria-expanded="false" data-help="integrate.expand">
                      <b data-vt-rec={`bs-${u.slug}`}>{u.roomName}</b><small>{u.short}{u.modelName && b.models.length > 1 ? ` · ${u.modelName}` : ''}</small>
                    </button>
                    <a class="ut-sheet" href={u.sheet} data-help="integrate.sheet-open">Build sheet</a>
                  </th>
                  {hasHost && <td class="ut-v mono" data-label="Hostname">{u.host ?? 'None yet'}{u.ip && u.networked ? <small>{u.ip}</small> : null}</td>}
                  {hasPair && <td class="ut-v mono" data-label="Pairs with">{u.pairs ?? 'Nothing'}</td>}
                  {b.steps.map((s) => <td class="ut-c" data-step-col={s} set:html={cellHtml(M, u.id, s)} />)}
                </tr>
                <tr class="ut-d" data-ud={u.id} hidden>
                  <td colspan={2 + (hasHost ? 1 : 0) + (hasPair ? 1 : 0) + b.steps.length}><div data-slot="udetail" data-u={u.id}></div></td>
                </tr>
              </>
            ))}
          </tbody>
        </table>
      </section>

    </div>

    {b.setup.length > 0 && (
      <Section title="Setup order" help="integrate.setup" aside="Optional: tick as you go, or let the checks do it" data-engineer-only>
        <div class="card ib-su" data-slot="setup" data-b={bid} set:html={setupHtml(M, bid)} />
      </Section>
    )}

    {b.settings && b.settings.groups.length > 0 && (
      <Section title="Every setting" id="every-setting" help="integrate.settings" aside={`${b.settings.set + b.settings.verify} in the setup guide, as patterns`} data-engineer-only>
        <p class="ib-pat muted">Values marked Per unit are patterns here. Each unit's build sheet has them worked out: {units.map((u, i) => <>{i > 0 && ', '}<a href={u.sheet}>{u.host ?? u.roomName}</a></>)}.</p>
        <div class="card ib-sets">
          {b.settings.groups.map((g) => (
            <details class="ib-g">
              <summary><b>{g.name}</b><span class="faint">{g.rows.length}</span></summary>
              <ul>
                {g.rows.map((r) => (
                  <li>
                    <span class="ib-gt"><b>{r.t}</b>{r.per && <i class="ib-per">Per unit</i>}{r.path && <small class="mono">{r.path}</small>}</span>
                    <span class="ib-gv"><small>{r.act === 'verify' ? 'Check it is' : 'Set to'}</small> <b class="mono">{r.val}</b>{r.per && <small class="ib-pe">{units.length === 1 ? <a href={units[0].sheet}>Worked out on the build sheet</a> : 'Worked out on each build sheet'}</small>}</span>
                    {r.why && <details class="ib-why"><summary>Why</summary><p>{r.why}</p></details>}
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </div>
      </Section>
    )}

    <IntegrateLive plan={plan} />
    <LiveBar page={`integrate:${p.id}`} />
  </div>
</Shell>

<style>
  .ib-vendor { margin: 0 0 14px; padding: 10px 14px; border-radius: var(--radius); background: var(--surface-2); font-size: var(--fs-body); }
  .ib-units { padding: 16px 0 8px; min-width: 0; container: units / inline-size; }
  .ib-h { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; padding: 0 20px; }
  .ib-h h2 { margin: 0; font-size: var(--fs-h3); }
  .ib-h span { font-size: var(--fs-code); }
  .ib-ua { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin: 12px 20px 0; padding: 10px 12px; border-radius: var(--radius); background: var(--surface-2); }
  .ib-ua :global(.ua-t) { margin: 0; flex: 1 1 260px; display: flex; align-items: center; gap: 8px; font-size: var(--fs-body); }
  .ib-ua :global(.ua-keys) { font-size: var(--fs-code); }
  .ib-needs { margin: 12px 20px 0; }
  .ib-needs:has(:global(.nd-none)) { display: none; }
  .ut { width: 100%; table-layout: fixed; border-collapse: separate; border-spacing: 0; margin-top: 10px; font-size: var(--fs-body); }
  .ut thead th { padding: 8px 8px; text-align: left; font: 600 var(--fs-code)/1.2 var(--font-sans); color: var(--text-3); border-bottom: 1px solid var(--line); }
  .ut thead th:first-child, .ut tbody td:first-child { padding-left: 20px; }
  .ut-pick { width: 48px; }
  .ut thead th.ut-hc { width: 16%; }
  .ut thead th.ut-pc { width: 13%; }
  .ut-pick input { width: 15px; height: 15px; accent-color: var(--green); }
  .ut-sh { width: 16%; }
  .ut tbody tr[data-u] > * { padding: 6px 8px; border-top: 1px solid var(--line); vertical-align: middle; }
  .ut tbody tr[data-u]:first-child > * { border-top: 0; }
  .ut tbody tr[data-u] { transition: background-color var(--dur-state) var(--ease-settle); }
  .ut tbody tr[data-u]:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
  .ut tbody tr[data-u]:global(.picked) > * { background: color-mix(in srgb, var(--green) 7%, transparent); }
  .ut-name { font-weight: 400; text-align: left; min-width: 0; }
  .ut-name { font-family: var(--font-sans); text-transform: none; letter-spacing: normal; white-space: normal; overflow-wrap: anywhere; }
  .ut-v { overflow-wrap: anywhere; }
  .ut-open { appearance: none; border: 0; background: none; padding: 2px 0; font: inherit; font-family: var(--font-sans); color: inherit; text-align: left; display: grid; cursor: pointer; }
  .ut-open b { font-size: var(--fs-body); font-weight: var(--fw-name); }
  .ut-open small { font-size: var(--fs-code); color: var(--text-3); }
  .ut-open:hover b { text-decoration: underline; }
  .ut-open:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-radius: 4px; }
  .ut-v { font-size: var(--fs-code); }
  .ut-sheet { display: inline-block; margin-top: 2px; font-size: var(--fs-code); font-weight: 600; }
  .ib-pat { margin: 0 0 10px; font-size: var(--fs-support); }
  .ib-pe { display: block; margin-top: 2px; font-size: var(--fs-mark); }
  .ut-v small { display: block; color: var(--text-3); font-size: var(--fs-mark); }
  .ut-c { padding: 2px 4px !important; }
  .ut-d > td { padding: 4px 20px 18px 56px; background: color-mix(in srgb, var(--surface-2) 45%, transparent); }
  @container units (max-width: 759px) {
    .ut, .ut tbody { display: block; }
    .ut thead { display: none; }
    .ut tbody tr[data-u] { display: grid; grid-template-columns: 24px repeat(var(--steps), minmax(0, 1fr)); gap: 4px 6px; padding: 12px 14px; border-top: 1px solid var(--line); }
    .ut tbody tr[data-u]:first-child { border-top: 0; }
    .ut tbody tr[data-u] > * { border: 0 !important; padding: 0 !important; }
    .ut tbody tr[data-u] > .ut-pick { grid-column: 1; grid-row: 1; padding-top: 3px !important; }
    .ut tbody tr[data-u] > .ut-name { grid-column: 2 / -1; grid-row: 1; }
    .ut tbody tr[data-u] > .ut-v { grid-column: 2 / -1; font-size: var(--fs-code); }
    .ut tbody tr[data-u] > .ut-v::before { content: attr(data-label) ": "; font-family: var(--font-sans); color: var(--text-3); }
    .ut tbody tr[data-u] > .ut-v small { display: inline; margin-left: 6px; }
    .ut tbody tr[data-u] > .ut-c:nth-child(1 of .ut-c) { grid-column: 2; }
    .ut-d { display: block; }
    .ut-d[hidden] { display: none; }
    .ut-d > td { display: block; padding: 4px 14px 16px; }
  }
  @container units (max-width: 459px) {
    .ut tbody tr[data-u] { grid-template-columns: 24px minmax(0, 1fr); }
    .ut tbody tr[data-u] > .ut-c { grid-column: 2 !important; }
  }
  [data-mode=vendor] .ut-pick { display: none; }
  .ib-shared { padding: 16px 20px; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 16px 32px; align-items: start; }
  .ib-sh-l { display: grid; gap: 12px; align-content: start; }
  .ib-shared .ib-h { padding: 0; }
  @container content (max-width: 839px) { .ib-shared { grid-template-columns: minmax(0, 1fr); } }
  .ib-same h3 { margin: 0 0 6px; font-size: var(--fs-support); }
  .ib-same dl { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 20px; }
  .ib-same dl > div { display: grid; gap: 1px; font-size: var(--fs-code); padding: 6px 0; border-top: 1px solid var(--line); }
  .ib-same dt { color: var(--text-3); font-size: var(--fs-code); }
  .ib-same dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; }
  .ib-same .faint { margin: 6px 0 0; font-size: var(--fs-code); }
  @container content (max-width: 559px) { .ib-same dl { grid-template-columns: minmax(0, 1fr); } }
  .ib-set { margin: 0; display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: var(--fs-code); color: var(--text-2); }
  .ib-set span { flex: 1 1 100%; }
  .ib-su { padding: 6px 16px; }
  .ib-sets { padding: 4px 16px; }
  .ib-g { border-top: 1px solid var(--line); }
  .ib-g:first-child { border-top: 0; }
  .ib-g > summary { display: flex; justify-content: space-between; gap: 10px; padding: 12px 2px; cursor: pointer; font-size: 13.5px; }
  .ib-g ul { list-style: none; margin: 0 0 12px; padding: 0; display: grid; gap: 10px; }
  .ib-g li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 4px 16px; font-size: 13px; }
  .ib-gt { display: grid; gap: 2px; min-width: 0; }
  .ib-gt small { color: var(--text-3); font-size: var(--fs-mark); overflow-wrap: anywhere; }
  .ib-per { font-style: normal; font-size: var(--fs-mark); color: var(--text-2); }
  .ib-gv small { color: var(--text-3); }
  .ib-gv b { font-size: var(--fs-code); overflow-wrap: anywhere; }
  .ib-why { grid-column: 1 / -1; font-size: var(--fs-code); color: var(--text-2); }
  .ib-why summary { cursor: pointer; font-weight: 600; width: max-content; }
  .ib-why p { margin: 4px 0 0; }
  @container content (max-width: 559px) { .ib-g li { grid-template-columns: minmax(0, 1fr); } }
</style>
