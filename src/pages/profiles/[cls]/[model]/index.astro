---
import ProfileView from '../../../../components/ProfileView.astro';
import { models } from '../../../../lib/data.mjs';
export function getStaticPaths() {
  return Object.entries(models).map(([model, m]) => ({ params: { cls: m.class, model } }));
}
const { cls, model } = Astro.params;
---
<ProfileView cls={cls} model={model} />
