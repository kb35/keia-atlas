---
// The record the operations pages start from, as JSON for the browser (opsBase), and the script that applies what a
// person did in this browser: reserve, send, receive, approve (src/lib/provider-ops-client.mjs). One per page.
import { opsBase } from '../../../lib/provider-ops-load.mjs';
const json = JSON.stringify(opsBase()).replace(/</g, '\\u003c');
---
<script type="application/json" id="po-base" set:html={json}></script>
<script>
  import { boot } from '../../../lib/provider-ops-client.mjs';
  boot();
</script>
