---
// Who may see a provider's operations: only its own people (docs/service-providers.md). Everyone else gets this line,
// in the same words as the other provider pages, and the page's own content (.pf-for) stays hidden. View as decides it
// in the demo; in a real deployment the provider's own sign-in does.
import { href } from '../../../lib/data.mjs';
import { PEOPLE } from '../../../lib/demo.mjs';
const css = PEOPLE.filter((p) => p.vendor === 'northlight').map((p) => `:root[data-who="${p.id}"] .pf-for{display:revert}:root[data-who="${p.id}"] .pf-gate-wrap{display:none}`).join('');
---
<div class="pf-gate-wrap content">
  <div class="card pad pf-gate">
    <p class="overline">A provider's own Keia</p>
    <h1 class="po-gh">This is Northlight AV's own operations</h1>
    <p>Stock, orders, crews and safety paperwork are Northlight AV's own records. They never flow to a client: a client sees only the visit readiness and the handover packs its engagement shares. To see them, pick Sam Okafor (Northlight AV) in View as.</p>
    <a class="btn" href={href('/vendors/northlight/engagement/')}>See Aigna's engagement with Northlight AV</a>
  </div>
</div>
<style is:global set:html={css}></style>
<style is:global>.po-gh { margin: 0; font-size: var(--fs-h3, 20px); }</style>
