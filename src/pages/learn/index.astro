  .tk-phases li.done { background: var(--ph-done); color: #fff; } .tk-phases li.now { background: var(--ph-now); color: #fff; font-weight: 700; }
  .tk-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .tk { border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); }
  .tk-row { display: grid; grid-template-columns: 26px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 9px 12px; }
  .tk-box { appearance: none; width: 22px; height: 22px; border-radius: 6px; border: 2px solid var(--line-strong); background: var(--surface); color: transparent; display: grid; place-items: center; padding: 0; cursor: pointer; transition: background var(--dur-state), border-color var(--dur-state), color var(--dur-state); }
  .tk-box:disabled { cursor: default; }
  button.tk-box:not(:disabled) { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .tk.st-done .tk-box { background: var(--green); border-color: var(--green); color: #fff; box-shadow: none; }
  .tk.st-done .tk-t b { text-decoration: line-through; text-decoration-color: var(--text-3); color: var(--text-2); }
  .tk-t { display: grid; min-width: 0; } .tk-t b { font-size: 14px; } .tk-t small { font-size: 12px; color: var(--text-3); }
  .tk-cap { display: grid; gap: 8px; padding: 0 12px 12px 48px; } .tk-cap[hidden] { display: none; } .tk-cap p { margin: 0; font-size: 13px; color: var(--text-2); }
  .tk-fixed { color: var(--green-ink) !important; }
  .tk-new { border-color: var(--accent); }
  .tk-add { display: grid; gap: 8px; } .tk-add .btn[hidden] { display: none; } .tk-add .btn { justify-self: start; }
  .tk-form { display: grid; gap: 8px; padding: 12px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--accent); } .tk-form[hidden] { display: none; }
  .pill.st-doing { background: var(--accent-soft); color: var(--accent-ink); } .pill.st-blocked { background: var(--red-soft); color: var(--red-ink); }

  /* Your role's home page */
