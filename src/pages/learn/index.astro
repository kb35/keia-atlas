  .rt-opts button b { font-weight: 600; } .rt-opts button small { font-size: 12px; color: var(--text-3); }
  .rt-opts button:hover:not(:disabled) { border-color: var(--accent); background: var(--accent-soft); }
  .rt-opts button.no { border-color: var(--red); color: var(--text-2); }
  .rt-opts button.yes { border-color: var(--green); background: var(--green-soft); color: var(--green-ink); } .rt-opts button.yes small { color: var(--green-ink); }
  .rt-opts button:disabled { cursor: default; } .rt-opts button:disabled:not(.yes) { opacity: .5; }
  .rt-say { font-size: 13.5px; color: var(--accent-ink); } .rt-say:empty { display: none; }
  .rt-got { display: grid; gap: 10px; padding: 12px 14px; border-radius: var(--radius); background: var(--green-soft); border: 1px solid var(--green); }
  .rt-got[hidden] { display: none; }
  .rt-got > p { font-size: 13.5px; color: var(--green-ink); }
  .rt-got .btn { justify-self: start; }
  .rt-read { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .rt-read li { display: grid; grid-template-columns: 10px minmax(0, 1fr); column-gap: 8px; row-gap: 2px; padding: 8px 10px; border-radius: var(--radius); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); font-size: 13px; color: var(--text-2); }
  .rt-read li::before { content: ''; grid-row: 1 / span 2; align-self: start; margin-top: 3px; width: 10px; height: 10px; border-radius: 50%; background: var(--surface-3); box-shadow: inset 0 0 0 1px var(--text-3); }
  .rt-read li.ok::before { background: var(--green); box-shadow: none; } .rt-read li.warn::before { background: var(--amber, #E0A100); box-shadow: none; }
  .rt-from { font: 700 10.5px var(--font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--text-3); }
  .rt-done { font-size: 13.5px; color: var(--green-ink); } .rt-done b { color: var(--text); }

  /* Finding anything */
  .ts-box { display: flex; align-items: center; gap: 10px; padding: 0 14px; height: 46px; border-radius: var(--radius-lg); border: 1.5px solid var(--line-strong); background: var(--surface); color: var(--text-3); }
