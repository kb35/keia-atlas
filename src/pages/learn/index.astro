  .tg-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .tg-steps li { position: relative; display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 2px 10px; padding: 8px 0; }
  .tg-steps li > b, .tg-steps li > small, .tg-steps li > .btn { grid-column: 2; } .tg-steps small { font-size: 12.5px; color: var(--text-2); }
  .tg-steps li > .btn { justify-self: start; margin-top: 6px; } .tg-steps li > .btn[hidden] { display: none; }
  .tg-steps li:not(:last-child)::after { content: ""; position: absolute; left: 12px; top: 34px; bottom: -6px; width: 2px; background: var(--line); }
  .tg-dot { grid-row: 1 / span 3; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--surface-3); color: transparent; transition: background var(--dur-state), color var(--dur-state); }
  .tg-steps li.on .tg-dot { background: var(--green); color: #fff; }
  .tg-every { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; }
  .tg-every span { display: grid; gap: 2px; padding: 10px 12px; border-radius: var(--radius); background: var(--surface-2); color: var(--text-2); }
  .tg-every small { font-size: 12px; } .tg-every b { font: 700 13.5px var(--font-sans); color: var(--text); }

  /* Reporting an issue */
  .tr-rep { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); align-items: start; }
  .tq-drawer { display: grid; gap: 10px; padding: 14px; border-radius: var(--radius-lg); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-md); }
  .tq-top { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0; } .tq-top .faint { font-size: 12.5px; }
  .tq-kinds { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
  .tq-kinds button { appearance: none; text-align: left; display: grid; gap: 2px; padding: 10px; border-radius: var(--radius); border: 1.5px solid var(--line); background: var(--surface); color: var(--text); font: inherit; cursor: pointer; transition: border-color var(--dur-state), background var(--dur-state); }
