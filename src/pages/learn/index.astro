  .tr-room[data-at="3"] .rm-dev:hover > :first-child, .rm-dev.on > :first-child { stroke: var(--accent); stroke-width: 4; }
  .rm-wire.on > .rm-hit, .tr-room[data-at="3"] .rm-wire:hover > .rm-hit { stroke: var(--accent-soft); stroke-width: 12; }
  .rt-host { display: grid; min-width: 0; }
  .rt-step { display: grid; gap: 10px; min-width: 0; }
  .rt-step[hidden] { display: none; }
  .rt-step p { margin: 0; }
