  .ts-kinds span { font-family: var(--font-mono); font-size: 11px; opacity: .75; }
  .ts-res { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .ts-res a { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 10px; align-items: center; padding: 8px 10px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); color: inherit; text-decoration: none; }
  .ts-res a:hover { border-color: var(--accent); }
  .ts-n { display: grid; min-width: 0; } .ts-n b { font-size: 14px; } .ts-n small { font-size: 12px; color: var(--text-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ts-k { justify-self: start; font: 700 10px/1 var(--font-mono); letter-spacing: .05em; text-transform: uppercase; padding: 4px 6px; border-radius: 4px; background: var(--surface-3); color: var(--text-2); }
  .ts-k.k-room { background: var(--blue-soft); color: var(--blue-ink); } .ts-k.k-model { background: var(--violet-soft); color: var(--violet-ink); } .ts-k.k-setting { background: var(--amber-soft); color: var(--amber-ink); } .ts-k.k-project { background: var(--green-soft); color: var(--green-ink); }
  .ts-none { padding: 10px; font-size: 13.5px; color: var(--text-2); }
  .ts-more { margin: 0; font-size: 12.5px; } .ts-more:empty { display: none; }

  /* Making a change */
  .tg-row { display: grid; grid-template-columns: 30px minmax(0, 1fr) auto auto; gap: 12px; align-items: center; padding: 12px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); }
  .tg-ic { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 8px; background: var(--surface-2); color: var(--text-2); }
  .tg-name { display: grid; min-width: 0; } .tg-name b { font-size: 14px; } .tg-name small { font-size: 12px; color: var(--text-3); }
  .tg-val { font: 700 14px var(--font-mono); padding: 4px 8px; border-radius: 6px; }
  .tg-row .btn[hidden] { display: none; }
