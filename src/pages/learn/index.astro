---
// Learn: training for Keia Atlas. Two tracks: "Using Keia Atlas" (how to use the application, the priority) and
// "How the team works" (for people new to the team). Each lesson is bite-size: what it is, why it
// matters to you, an everyday comparison, a hands-on try inside the lesson, one check question and
// a link to do it for real. Pick a role for a short path; progress stays in this browser (rs4-learn).
// Motion: a lesson card grows into the reading view, the rails' highlights glide, lessons cross-fade
// with a small slide in the direction you move, and heights ease. Nothing flips or jumps.
import Shell from '../../layouts/Shell.astro';
import Icon from '../../components/Icon.astro';
import LessonTry from '../../components/LessonTry.astro';
import NetworkPath from '../../components/NetworkPath.astro';
import { href, classes, models, configurations, totals } from '../../lib/data.mjs';
import { ROLES } from '../../lib/demo.mjs';
import { USING, TEAM, PATHS, GROUP, GROUPS } from './_lessons.mjs';
import { GLOSSARY, rich } from './_glossary.mjs';

const ALL = [...USING.map((l) => ({ ...l, track: 'using' })), ...TEAM.map((l) => ({ ...l, track: 'team' }))];
const LESSONS = Object.fromEntries(ALL.map((l) => [l.id, { title: l.title, mins: l.mins, track: l.track }]));
const ROLE_NAMES = Object.fromEntries(Object.entries(ROLES).map(([k, r]) => [k, r.name]));
const TIPS = Object.fromEntries(GLOSSARY.map((g) => [g.id, { t: g.term, d: g.def }]));
const N = { profiles: Object.keys(classes).length, models: Object.keys(models).length, configs: Object.keys(configurations).length, units: totals.units };
const GROUP_WORD = { field: 'For people fixing rooms on site', build: 'For people designing and building rooms', own: 'For people who own the standard', lead: 'For people running projects and teams' };
const ring = 2 * Math.PI * 30;
---
<Shell vendorOk title="Learn" section="learn" crumbs={[{ label: 'Learn' }]}>
  <section class="band ln-band">
    <div class="band-grid">
      <div>
        <div class="meta"><span class="overline">Training</span><span class="faint">· Bite-size, hands-on, about two to four minutes each</span></div>
        <h1>Learn Keia Atlas</h1>
        <p class="lede">Short lessons with something to try in each one. Pick your role for the few that matter to you, or learn everything.</p>
        <div class="band-btns">
          <button type="button" class="btn primary" data-resume><Icon name="arrow" size={16} /><span data-resume-t>Start your path</span></button>
          <span class="ln-badge" data-badge hidden><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 2l2.4 2.2 3.2-.5.9 3.1 2.9 1.5-1.2 3 1.2 3-2.9 1.5-.9 3.1-3.2-.5L12 22l-2.4-2.2-3.2.5-.9-3.1-2.9-1.5 1.2-3-1.2-3 2.9-1.5.9-3.1 3.2.5z" fill="currentColor" /><path d="M8 12.5l2.8 2.8L16.5 9.5" fill="none" stroke="var(--on-accent, #fff)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg><span data-badge-t>Path complete</span></span>
        </div>
      </div>
      <div class="ln-ring" aria-live="polite">
        <svg viewBox="0 0 72 72" aria-hidden="true"><circle cx="36" cy="36" r="30" class="rg-bg" /><circle cx="36" cy="36" r="30" class="rg-fg" data-ring style={`stroke-dasharray:${ring};stroke-dashoffset:${ring}`} /></svg>
        <span class="rg-n"><b data-ring-n>0</b><small>of <span data-ring-of>0</span></small></span>
        <span class="rg-l">lessons done<br />on your path</span>
      </div>
    </div>
  </section>

  <div class="content learn" data-learn data-grp="build">
    <div class="ln-stage" data-stage>
      <!-- The overview: tracks, your path, every lesson, and the glossary. -->
      <section class="ln-over" data-view="over">
        <div class="ln-bar">
          <nav class="ln-tabs" role="tablist" aria-label="Learn">
            <span class="ln-glide" aria-hidden="true"></span>
            <button type="button" role="tab" data-tab="using" aria-selected="true"><Icon name="devices" size={16} />Using Keia Atlas</button>
            <button type="button" role="tab" data-tab="team" aria-selected="false"><Icon name="team" size={16} />How the team works</button>
            <button type="button" role="tab" data-tab="glossary" aria-selected="false"><Icon name="book" size={16} />Glossary</button>
          </nav>
          <label class="ln-role"><span>Your role</span>
            <select data-role-pick aria-label="Your role">
              {Object.entries(ROLE_NAMES).map(([k, n]) => <option value={k}>{n}</option>)}
            </select>
            <small class="faint" data-role-note>Follows View as</small>
          </label>
        </div>

        <div class="ln-panes" data-panes>
          <div class="ln-pane" data-pane="using" role="tabpanel">
            <header class="ln-pathh">
              <div>
                <h2 data-path-h>Your path</h2>
                <p class="faint" data-path-sub>A few lessons, in order</p>
              </div>
              <div class="ln-seg" role="radiogroup" aria-label="Show">
                <span class="ln-glide" aria-hidden="true"></span>
                <button type="button" role="radio" aria-checked="true" data-scope="path">Your path <span data-scope-n="path"></span></button>
                <button type="button" role="radio" aria-checked="false" data-scope="all">Learn everything <span>{USING.length}</span></button>
              </div>
            </header>
            <ol class="ln-cards" data-cards="using">
              {USING.map((l, i) => (
                <li class="lc" data-card={l.id}>
                  <button type="button" class="lc-b" data-open={l.id}>
                    <span class="lc-top"><span class="lc-n mono" data-card-n>{String(i + 1).padStart(2, '0')}</span><span class="lc-ic"><Icon name={l.icon} size={18} /></span><span class="lc-m">{l.mins} min</span><span class="lc-tick" aria-hidden="true"><Icon name="check" size={14} /></span></span>
                    <span class="lc-title">{l.title}</span>
                    <span class="lc-one">{l.card}</span>
                    <span class="lc-on" data-onpath hidden>On your path</span>
                  </button>
                </li>
              ))}
            </ol>
          </div>

          <div class="ln-pane" data-pane="team" role="tabpanel" hidden>
            <header class="ln-pathh">
              <div>
                <h2>How the team works</h2>
                <p class="faint">For people new to the team: how projects run, how devices and rooms are standardised, how support flows, and how a room reaches the internet.</p>
              </div>
            </header>
            <ol class="ln-cards" data-cards="team">
              {TEAM.map((l, i) => (
                <li class="lc" data-card={l.id}>
                  <button type="button" class="lc-b" data-open={l.id}>
                    <span class="lc-top"><span class="lc-n mono">{String(i + 1).padStart(2, '0')}</span><span class="lc-ic"><Icon name={l.icon} size={18} /></span><span class="lc-m">{l.mins} min</span><span class="lc-tick" aria-hidden="true"><Icon name="check" size={14} /></span></span>
                    <span class="lc-title">{l.title}</span>
                    <span class="lc-one">{l.card}</span>
                  </button>
                </li>
              ))}
              <li class="lc lc-extra"><a class="lc-b" href={href('/learn/fields/')}><span class="lc-top"><span class="lc-ic"><Icon name="tag" size={18} /></span></span><span class="lc-title">Device fields, one by one</span><span class="lc-one">What each field on a device means, drawn for one real video bar.</span></a></li>
              <li class="lc lc-extra"><a class="lc-b" href={href('/about/rules/')}><span class="lc-top"><span class="lc-ic"><Icon name="book" size={18} /></span></span><span class="lc-title">The rule book</span><span class="lc-one">How Keia Atlas moves, lays out pages and draws devices and rooms, as short rules for anyone adding to it.</span></a></li>
            </ol>
          </div>

          <div class="ln-pane" data-pane="glossary" role="tabpanel" hidden>
            <header class="ln-pathh">
              <div><h2>Glossary</h2><p class="faint">Keia Atlas's words in plain language. In lessons, hover or tap a dotted word to see its meaning.</p></div>
              <label class="ln-find"><Icon name="search" size={16} /><span class="sr-only">Find a word</span><input type="search" placeholder="Find a word" data-gl-q /></label>
            </header>
            <dl class="gl-list" data-gl-list>
              {GLOSSARY.map((g) => (
                <div class="gl-item" id={`g-${g.id}`} data-g={g.id} data-gq={`${g.term} ${g.def}`.toLowerCase()}>
                  <dt>{g.term}</dt>
                  <dd>{g.def}{g.to && <> <a href={href(g.to)}>See it</a></>}</dd>
                </div>
              ))}
            </dl>
            <p class="faint" data-gl-none hidden>No word matches. Try fewer letters.</p>
          </div>
        </div>
      </section>

      <!-- The reading view: the path rail on the left, one lesson on the right. -->
      <section class="ln-read" data-view="read" hidden>
        <aside class="rd-rail" aria-label="Lessons">
          <button type="button" class="rd-back" data-back><Icon name="back" size={16} />All lessons</button>
          <p class="rd-seq overline" data-seq-name>Your path</p>
          <ol class="rd-list" data-rail>
            <span class="rd-glide" aria-hidden="true"></span>
            {ALL.map((l) => (
              <li data-rail-item={l.id} hidden><button type="button" data-rail-go={l.id}><span class="rd-dot" aria-hidden="true"><Icon name="check" size={11} /></span><span class="rd-t">{l.title}</span><span class="rd-m">{l.mins}m</span></button></li>
            ))}
          </ol>
        </aside>
        <div class="rd-main" data-rd-main>
          {ALL.map((l) => (
            <article class="card lesson" data-lesson={l.id} data-track={l.track} hidden aria-labelledby={`lh-${l.id}`}>
              <header class="ls-h">
                <p class="ls-meta"><span data-pos>Lesson</span><span>·</span><span>{l.mins} min</span><span>·</span><span>{l.track === 'using' ? 'Using Keia Atlas' : 'How the team works'}</span><span class="ls-done" data-ls-done hidden><Icon name="check" size={12} />Done</span></p>
                <h2 id={`lh-${l.id}`} class="ls-title">{l.title}</h2>
              </header>
              <div class="ls-block ls-what"><span class="ls-k">What it is</span><p class="ls-one" set:html={rich(l.one)} /></div>
              <div class="ls-block ls-why">
                {l.track === 'using' ? (
                  <>
                    <span class="ls-k">Why it matters to you <span class="ls-for" data-why-for></span></span>
                    {GROUPS.map((g) => <p data-why={g} set:html={rich(l.why[g])} />)}
                  </>
                ) : (<><span class="ls-k">Why it matters</span><p set:html={rich(l.why)} /></>)}
              </div>
              <div class="ls-block ls-like"><span class="ls-k">It's like</span><p>{l.like}</p></div>

              {l.track === 'using' && (
                <section class="ls-try" data-try-wrap={l.id}>
                  <header class="try-h"><span class="ls-k">Try it</span><p class="try-task">{l.task}</p><span class="try-ok" aria-hidden="true"><Icon name="check" size={13} />Done</span></header>
                  <LessonTry id={l.id} />
                </section>
              )}

              {l.id === 't-standards' && (
                <ol class="tier">
                  <li style="--i:0"><span class="tier-k">Room profile</span><b>Conference room, large</b><span>What the room needs: size, devices, wiring. Each has build options, such as one or two displays.</span><a href={href('/room-profiles/')}>Room profiles</a></li>
                  <li style="--i:1"><span class="tier-k">Device profile <em>{N.profiles}</em></span><b>Video bar</b><span>A kind of device and what healthy looks like. Names no product.</span><a href={href('/profiles/video-bar/')}>Video bar</a></li>
                  <li style="--i:2"><span class="tier-k">Model <em>{N.models}</em></span><b>Poly Studio X52</b><span>One product, with every port from the maker's documents, and whether it is in the standard.</span><a href={href('/models/poly-studio-x52/')}>The model</a></li>
                  <li style="--i:3"><span class="tier-k">Configuration <em>{N.configs}</em></span><b>Studio X in Google Meet mode</b><span>How that model is set up: each line Set or Verify, in order, with a reason.</span><a href={href('/configurations/poly-x-google-meet/')}>The configuration</a></li>
                  <li style="--i:4"><span class="tier-k">Units <em>{N.units.toLocaleString('en-IE')}</em></span><b>nyc-2005-vc01</b><span>One unit in one room, checked against all of the above.</span><a href={href('/devices/')}>Units</a></li>
                </ol>
                <p class="ls-p">Who owns what: the service manager for AV owns device profiles, configurations and which firmware is standard; the service manager for IT infrastructure owns the network and the comms rooms. The Lab tests anything new before either of them decides.</p>
              )}
              {l.id === 't-projects' && (
                <>
                  <ol class="phases">{['Plan', 'Design', 'Procure', 'Deploy', 'Hand over', 'Closed'].map((p, i) => <li style={`--i:${i}`}><b>{p}</b>{i < 5 && <span class="gate"><Icon name="lock" size={12} />Gate</span>}</li>)}</ol>
                  <p class="ls-p">Who does what is a <a class="gl-t" href="#g-raci" data-term="raci">RACI</a>: <b>R</b>esponsible does it, <b>A</b>ccountable signs it off, <b>C</b>onsulted is asked first, <b>I</b>nformed is told after. Every playbook has one built from its own steps.</p>
                </>
              )}
              {l.id === 't-support' && (
                <ol class="flow">
                  <li><b>Someone in the room</b><span>Calls or messages the service desk</span></li>
                  <li><b>Service desk</b><span>Checks for an open incident, then the room's health remotely</span></li>
                  <li><b>On-site technician</b><span>First fix, with the room's guide</span></li>
                  <li><b>Delivery engineer</b><span>When the guide does not cover it</span></li>
                  <li><b>Service vendor</b><span>Hardware under contract</span></li>
                </ol>
              )}
              {l.id === 't-firmware' && (
                <ol class="flow">
                  <li><b>Vendor publishes</b><span>Release notes and known issues</span></li>
                  <li><b>An agent logs it</b><span>Proposed as a change</span></li>
                  <li><b>The Lab tests it</b><span>On every model that runs it</span></li>
                  <li><b>Service manager decides</b><span>Standard, or do not install</span></li>
                  <li><b>Everyone sees it</b><span>Profile, every device, vendor packs</span></li>
                </ol>
              )}
              {l.id === 't-loop' && (
                <div class="loop" aria-hidden="true">
                  <svg viewBox="-40 0 600 260" class="loop-svg">
                    <ellipse cx="260" cy="130" rx="200" ry="90" class="loop-ring" />
                    <ellipse cx="260" cy="130" rx="200" ry="90" class="loop-run" />
                    {[['Standards', 260, 40], ['Projects and tasks', 460, 130], ['Captured fix', 260, 220], ['Change, approved', 60, 130]].map(([t, x, y]) => <g><rect x={x - 78} y={y - 20} width="156" height="40" rx="10" class="loop-node" /><text x={x} y={y + 5} class="loop-t">{t}</text></g>)}
                  </svg>
                </div>
              )}
              {l.id === 't-network' && (
                <>
                  <NetworkPath heading="The path, hop by hop" />
                  <div class="comms">
                    <div><b>IDF</b><span>One on each floor: patch panels, where every data outlet on the floor ends, and switches that give each device power and a network.</span></div>
                    <div><b>MDF</b><span>The building's main comms room: core switches, the firewall pair, the internet circuits and the fibre up to every IDF.</span></div>
                    <div><b>Out-of-band</b><span>A separate way into the network equipment for when the network itself is down.</span></div>
                  </div>
                </>
              )}
              {l.id === 't-vendors' && (
                <p class="ls-p">Vendors photograph each device's label before mounting it. Their records count once the delivery engineer has checked them.</p>
              )}

              <section class="ls-check" data-check>
                <span class="ls-k">Check</span>
                <p class="ck-q">{l.check.q}</p>
                <div class="ck-opts" role="group" aria-label="Answers">
                  {l.check.a.map(([t, ok, why]) => <button type="button" class="ck-o" data-ok={ok ? '1' : '0'} data-why-text={why}>{t}</button>)}
                </div>
                <div class="ck-fb-wrap"><p class="ck-fb" data-fb aria-live="polite"></p></div>
              </section>

              <footer class="ls-go">
                {l.go.to && <a class="btn" href={href(l.go.to)}>{l.go.label}<Icon name="link" size={15} /></a>}
                {l.go.report && <button type="button" class="btn" data-open-report={l.go.report}>{l.go.label}<Icon name="plus" size={15} /></button>}
                {l.go.settings && <button type="button" class="btn" data-open-settings>{l.go.label}<Icon name="gear" size={15} /></button>}
                {l.go.help && <button type="button" class="btn" data-help-on>{l.go.label}<Icon name="about" size={15} /></button>}
                <span class="spacer"></span>
                <button type="button" class="btn ghost" data-prev>Previous</button>
                <button type="button" class="btn primary" data-next>Next</button>
              </footer>
            </article>
          ))}
        </div>
      </section>
    </div>
    <div class="gl-tip" data-tip role="tooltip" hidden><b data-tip-t></b><span data-tip-d></span><button type="button" class="linkish" data-tip-all>All words</button></div>
  </div>

  <script is:inline data-astro-rerun slot="end" define:vars={{ PATHS, GROUP, LESSONS, ROLE_NAMES, TIPS, GROUP_WORD, USING_IDS: USING.map((l) => l.id), TEAM_IDS: TEAM.map((l) => l.id), RING: ring }}>
    (function () {
      var root = document.querySelector('[data-learn]'); if (!root) return;
      var RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
      var EZ = 'cubic-bezier(.22,1,.36,1)';
      var $ = function (s, el) { return (el || root).querySelector(s) || (el ? null : document.querySelector('.ln-band ' + s)); };   // the band sits above the content
      var $$ = function (s, el) { return Array.prototype.slice.call((el || root).querySelectorAll(s)); };
      var stage = $('[data-stage]'), over = $('[data-view="over"]'), read = $('[data-view="read"]'), rdMain = $('[data-rd-main]');
      var get = function (k, d) { try { return localStorage.getItem(k) || d; } catch (_) { return d; } };

      /* ---------- Progress, saved in this browser ---------- */
      var st = { v: 2, done: {}, tries: {}, last: '', role: '', scope: 'path' };
      try {
        var raw = JSON.parse(localStorage.getItem('rs4-learn') || 'null');
        if (raw && raw.v === 2) st = Object.assign(st, raw);
        else if (raw && typeof raw === 'object') {   // the first Learn saved {lessonId: 1}; carry over what maps
          var OLD = { four: 'profiles', rooms: 'room', report: 'report', projects: 't-projects', firmware: 't-firmware', network: 't-network', loop: 't-loop', vendors: 't-vendors', stages: 'stages' };
          Object.keys(raw).forEach(function (k) { if (OLD[k]) st.done[OLD[k]] = 1; });
        }
      } catch (_) {}
      function save() { try { localStorage.setItem('rs4-learn', JSON.stringify(st)); } catch (_) {} }
      function viewRole() { return (window.RS_WHO_ROLE || {})[window.rsWhoId ? window.rsWhoId() : get('rs4-who', 'aoife')] || 'delivery'; }
      function role() { return st.role && PATHS[st.role] ? st.role : viewRole(); }
      function path() { return PATHS[role()] || USING_IDS; }
      function seqList(name) { return name === 'team' ? TEAM_IDS : name === 'all' ? USING_IDS : path(); }
      var cur = null, seqName = 'path';

      /* ---------- Motion helpers (all off with reduced motion) ---------- */
      function heightFrom(host, h0, dur) {
        if (RM || !host) return;
        if (host.__h) host.__h.cancel();
        var h1 = host.getBoundingClientRect().height;
        if (Math.abs(h1 - h0) < 2) return;
        host.__h = host.animate([{ height: h0 + 'px', overflow: 'hidden' }, { height: h1 + 'px', overflow: 'hidden' }], { duration: dur || 460, easing: EZ });
        host.__h.onfinish = function () { host.__h = null; };
      }
      // Run a change inside a box and let the box ease to its new height.
      function grow(host, fn) { var h0 = host.getBoundingClientRect().height; fn(); heightFrom(host, h0); }
      function enter(el, delay, from) {
        if (RM || !el) return;
        el.animate([{ opacity: 0, transform: from || 'translateY(8px)' }, { opacity: 1, transform: 'none' }], { duration: 420, delay: delay || 0, easing: EZ, fill: 'backwards' });
      }
      // Cross-fade one panel for another inside a host, sliding a little in the direction of travel.
      function finishSwap(host) { if (host && host.__run) { var r = host.__run; host.__run = null; r.cleanup(); } }
      function swap(host, a, b, dir, axis) {
        finishSwap(host);
        if (a === b) { if (b) b.hidden = false; return; }
        var h0 = host.getBoundingClientRect().height;
        if (RM || !a || a.hidden) { if (a) a.hidden = true; b.hidden = false; return; }
        var ax = axis === 'y' ? 'translateY(' : 'translateX(';
        var box = { top: a.offsetTop, left: a.offsetLeft, width: a.offsetWidth };
        a.style.position = 'absolute'; a.style.top = box.top + 'px'; a.style.left = box.left + 'px'; a.style.width = box.width + 'px'; a.style.margin = '0'; a.style.pointerEvents = 'none';
        b.hidden = false;
        heightFrom(host, h0, 480);
        var out = a.animate([{ opacity: 1, transform: 'none' }, { opacity: 0, transform: ax + (-18 * dir) + 'px)' }], { duration: 200, easing: 'cubic-bezier(.4,0,1,1)', fill: 'forwards' });
        var inn = b.animate([{ opacity: 0, transform: ax + (26 * dir) + 'px)' }, { opacity: 1, transform: 'none' }], { duration: 440, delay: 70, easing: EZ, fill: 'backwards' });
        var done = false;
        var cleanup = function () {
          if (done) return; done = true;
          a.hidden = true; a.style.position = a.style.top = a.style.left = a.style.width = a.style.margin = a.style.pointerEvents = '';
          out.cancel(); inn.finish(); if (host.__run && host.__run.cleanup === cleanup) host.__run = null;
        };
        out.onfinish = cleanup;
        host.__run = { cleanup: cleanup };
      }
      // A highlight that glides to the chosen item.
      function glide(g, el, instant) {
        if (!g || !el || el.offsetParent === null) return;
        if (instant || RM) g.style.transition = 'none';
        g.style.width = el.offsetWidth + 'px'; g.style.height = el.offsetHeight + 'px';
        g.style.transform = 'translate(' + el.offsetLeft + 'px,' + el.offsetTop + 'px)';
        g.style.opacity = '1';
        if (instant || RM) { g.offsetHeight; g.style.transition = ''; }
      }
      // Re-order or filter a list: items that stay move to their new place, new ones grow in, leaving ones shrink out.
      function flipList(list, mutate) {
        var items = Array.prototype.slice.call(list.children);
        var before = new Map(); items.forEach(function (el) { if (!el.hidden) before.set(el, el.getBoundingClientRect()); });
        var lr = list.getBoundingClientRect(), h0 = lr.height;
        mutate();
        if (RM) return;
        heightFrom(list, h0, 520);
        var k = 0;
        items.forEach(function (el) {
          var a = before.get(el);
          if (el.hidden) {
            if (!a) return;
            var c = el.cloneNode(true); c.hidden = false; c.removeAttribute('data-card');
            c.style.cssText = 'position:absolute;margin:0;pointer-events:none;left:' + (a.left - lr.left) + 'px;top:' + (a.top - lr.top) + 'px;width:' + a.width + 'px;height:' + a.height + 'px';
            list.appendChild(c);
