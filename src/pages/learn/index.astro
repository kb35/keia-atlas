  .tq-fields { display: grid; gap: 8px; } .tq-fields[hidden] { display: none; } .tq-fields .btn { justify-self: start; }
  .tq-inbox { display: grid; gap: 8px; padding: 12px; border-radius: var(--radius-lg); background: var(--surface-2); }
  .tq-ih .avatar { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--accent); color: var(--on-accent); font: 700 11px/1 var(--font-mono); }
  .tq-ih { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0 8px; align-items: center; margin: 0; } .tq-ih .avatar { grid-row: span 2; } .tq-ih small { font-size: 12px; color: var(--text-3); }
  .tq-inbox ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .tq-it { display: grid; grid-template-columns: 10px minmax(0, 1fr); gap: 8px; align-items: start; padding: 8px 10px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); }
  .tq-it i { width: 9px; height: 9px; border-radius: 50%; margin-top: 5px; background: var(--accent); } .tq-it.fw i { background: var(--amber, #d8a200); }
  .tq-it.ur { border-color: color-mix(in srgb, var(--red) 45%, var(--line)); background: color-mix(in srgb, var(--red-soft) 50%, var(--surface)); } .tq-it.ur i { background: var(--red); }
  .tq-it b { display: block; font-size: 13px; } .tq-it small { font-size: 11.5px; color: var(--text-3); }

  /* Projects and tasks */
  .tk-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 16px; }
  .tk-phases { list-style: none; margin: 0; padding: 0; display: flex; gap: 3px; }
