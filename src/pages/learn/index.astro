  .tp-tile, .tp-unit { appearance: none; border: 1px solid var(--line); background: var(--surface); color: var(--text); border-radius: var(--radius); padding: 12px; font: inherit; text-align: left; cursor: pointer; display: grid; gap: 4px; transition: transform var(--dur-state) var(--ease-settle), border-color var(--dur-state), box-shadow var(--dur-state); }
