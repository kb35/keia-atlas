  .rm-body { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 14px; align-items: start; }
  .rm-svg { width: 100%; height: auto; display: block; }
  .rm-wall { fill: var(--surface); stroke: var(--line-strong); stroke-width: 1.5; }
  .rm-table { fill: var(--surface-2); stroke: var(--line-strong); stroke-width: 1.5; }
  .rm-frame { fill: var(--ink); } .rm-screen { transition: fill var(--dur-state); } .rm-screen.on { fill: var(--accent-soft); } .rm-screen.off { fill: #1b1d22; }
  .rm-nosig { fill: #9aa0aa; font: 600 13px var(--font-sans); text-anchor: middle; }
