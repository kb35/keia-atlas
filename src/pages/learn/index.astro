  .rm-box { fill: var(--surface-3); stroke: var(--ink); stroke-width: 1.5; }
  .rm-tbox { fill: var(--surface); stroke: var(--line-strong); stroke-width: 1.5; stroke-dasharray: 4 3; }
  .rm-plate { fill: var(--surface); stroke: var(--ink); stroke-width: 1.5; }
