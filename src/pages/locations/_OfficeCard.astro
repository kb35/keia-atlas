---
// One office as a card (Offices list and region pages): a small plan of the first floor where a floor file exists
// (otherwise the floors as a stack), the local time and whether it is open, the three service lights, and three
// counts that each open their list (rule P10). The name opens the office page; the plan flies into its map.
import { href } from '../../lib/data.mjs';
import HealthGlyph from '../../components/HealthGlyph.astro';
import FloorMap from '../../components/FloorMap.astro';
import { hasFloors, LIGHT_WORD, ROLE_WORD, OPEN_Q } from '../../lib/locations.mjs';
import { building } from '../../lib/floors.mjs';
import { planOf } from '../../lib/floorplan.mjs';

interface Props { o: any; filter?: boolean }
const { o, filter = false } = Astro.props;
const s = o.s;
const M = hasFloors(o.id) ? building(o.id) : null;
const P = M ? planOf(M, M.floors[0].id) : null;
const more = M ? M.floors.length - 1 : 0;
// Every card's picture is 16:7; the floor sits centred in it at its own scale.
const frame = P ? { VW: Math.max(P.VW, (P.VH * 16) / 7), VH: Math.max(P.VH, (P.VW * 7) / 16) } : undefined;
const floors = s.floors ?? [];
const nInc = o.inc.length, nPeople = o.people.length;
const fi = filter ? { 'data-fi': '', 'data-find': `${s.name} ${s.city} ${s.code} ${o.id}`.toLowerCase(), 'data-f-region': s.region, 'data-f-status': '', 'data-vk': o.id, 'data-inc': nInc, 'data-name': s.name } : {};
---
<article class="card oc" data-loc-tz={s.time_zone} {...fi}>
  {P ? (
    <div class="oc-pic">
      {/* The office's first floor: the same floor map as everywhere (FloorMap's thumbnail), live. */}
      <FloorMap site={o.id} floor={P.F.id} detail="thumb" frame={frame} live to={`/locations/${o.id}/?floor=${P.F.id}`} zoom title={`${s.name}, ${P.F.name}`} />
      <span class="oc-cap">{`${P.F.name}${more ? ` and ${more} more` : ''}`}</span>
    </div>
  ) : (
    <a class="oc-pic" href={href(`/locations/${o.id}/`)} data-vt-rec={`loc-${o.id}`} tabindex="-1" aria-hidden="true">
      <svg viewBox="0 0 120 64" class="oc-stack">
        {floors.map((_, i) => <path class="oc-slab" d={`M${30 + 0} ${48 - i * 11} l30 -8 l30 8 l-30 8 z`} style={`--i:${i}`} />)}
      </svg>
      <span class="oc-cap">{`${floors.length} ${floors.length === 1 ? 'floor' : 'floors'} · plan not modelled yet`}</span>
    </a>
  )}
  <div class="oc-body">
    <header class="oc-h">
      <span class="code">{s.code}</span>
      <a class="oc-n" href={href(`/locations/${o.id}/`)}><b>{s.name}</b></a>
    </header>
    <p class="oc-sub">{ROLE_WORD[s.role] ?? 'Office'} · {s.city} · <span data-loc-clock>--:--</span> local</p>
    <p class="oc-open" data-loc-open data-help="loc.open">&nbsp;</p>
    <ul class="oc-lights" data-help="loc.lights">
      {o.lights.map((l) => (
        <li><a href={l.to.startsWith('#') ? href(`/locations/${o.id}/${l.to}`) : href(l.to)} title={`${l.label}: ${l.text}`}><HealthGlyph state={l.tone} size={12} quiet title={l.text} /><span>{l.label}</span><small class="sr">{LIGHT_WORD[l.tone]}: {l.text}</small></a></li>
      ))}
    </ul>
    <dl class="oc-k">
      <div><dt>Open incidents</dt><dd><a class:list={{ bad: nInc > 0 }} href={href(`/incidents/?site=${o.id}&${OPEN_Q}`)}>{nInc}</a></dd></div>
      <div><dt>On site today</dt><dd><a href={href(`/team/?office=${o.id}`)}>{nPeople}</a></dd></div>
      <div><dt>Spaces</dt><dd><a href={href(`/rooms/?site=${o.id}`)} data-vt-rec="dd-rooms">{o.rooms.length}</a></dd></div>
    </dl>
  </div>
</article>

<style>
  .oc { display: grid; grid-template-rows: auto 1fr; overflow: hidden; padding: 0; transition: box-shadow var(--dur-hover) var(--ease-settle), translate var(--dur-hover) var(--ease-settle), transform var(--dur-press) var(--ease-settle); }
  .oc:hover { box-shadow: var(--shadow-md); }   /* and it lifts 2 px (km-lift, motion-library.css) */
  .oc-pic { display: grid; gap: 6px; padding: 14px 16px 8px; background: var(--surface); border-bottom: 1px solid var(--line); text-decoration: none; color: var(--text-2); }
  .oc-pic .oc-stack { width: 100%; height: auto; display: block; aspect-ratio: 16 / 7; }
  .oc-slab { fill: var(--bg); stroke: var(--line-strong); stroke-width: 0.8; }
  .oc-cap { font-size: var(--fs-mark); }
  .oc-body { display: grid; gap: 8px; padding: 12px 16px 14px; align-content: start; }
  .oc-h { display: flex; gap: 8px; align-items: baseline; min-width: 0; }
  .oc-n { color: var(--ink); text-decoration: none; font: var(--fw-title) 17px/1.25 var(--font-display); min-width: 0; }
  .oc-n:hover { text-decoration: underline; }
  .oc-sub { margin: 0; font-size: var(--fs-support); color: var(--text-2); font-variant-numeric: tabular-nums; }
  .oc-open { margin: 0; font-size: var(--fs-code); font-weight: var(--fw-name); color: var(--text-2); }
  .oc-open[data-open="1"] { color: var(--text); }
  .oc-lights { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 0; padding: 0; list-style: none; }
  .oc-lights a { display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-support); color: var(--ink); text-decoration: none; }
  .oc-lights a:hover span { text-decoration: underline; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .oc-k { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 4px 0 0; padding-top: 10px; border-top: 1px solid var(--line); }
  .oc-k div { display: grid; gap: 2px; min-width: 0; }
  .oc-k dt { font-size: var(--fs-mark); color: var(--text-2); }
  .oc-k dd { margin: 0; }
  .oc-k a { font: var(--fw-title) 19px/1.1 var(--font-display); color: var(--ink); text-decoration: none; font-variant-numeric: tabular-nums; }
  .oc-k a:hover { text-decoration: underline; }
  .oc-k a.bad { color: var(--h-fault-ink); }
  @media (prefers-reduced-motion: reduce) { .oc, .oc-rm { transition: none; } }
</style>
