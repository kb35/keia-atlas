---
// One office as a card (Offices list and region pages): a small plan of the first floor where a floor file exists
// (otherwise the floors as a stack), the local time and whether it is open, the three service lights, and three
// counts that each open their list (rule P10). The name opens the office page; the plan flies into its map.
import { href } from '../../lib/data.mjs';
import { planThumb, LIGHT_WORD, ROLE_WORD, OPEN_Q } from '../../lib/locations.mjs';

interface Props { o: any; filter?: boolean }
const { o, filter = false } = Astro.props;
const s = o.s;
const th = planThumb(o.id);
const floors = s.floors ?? [];
const nInc = o.inc.length, nPeople = o.people.length;
const fi = filter ? { 'data-fi': '', 'data-find': `${s.name} ${s.city} ${s.code} ${o.id}`.toLowerCase(), 'data-f-region': s.region, 'data-f-status': '', 'data-vk': o.id, 'data-inc': nInc, 'data-name': s.name } : {};
---
<article class="card oc" data-loc-tz={s.time_zone} {...fi}>
  <a class="oc-pic" href={href(`/locations/${o.id}/`)} data-vt-rec={`loc-${o.id}`} tabindex="-1" aria-hidden="true">
    {th ? (
      <svg viewBox={`-1 -1 ${th.W + 2} ${th.H + 2}`} class="oc-plan">
        <polygon class="oc-out" points={th.outline} />
        {th.rooms.map((r) => <rect class:list={['oc-rm', { 'oc-comms': r.comms }]} x={r.x} y={r.y} width={r.w} height={r.h} data-loc-room={r.id} />)}
      </svg>
    ) : (
      <svg viewBox="0 0 120 64" class="oc-stack">
        {floors.map((_, i) => <path class="oc-slab" d={`M${30 + 0} ${48 - i * 11} l30 -8 l30 8 l-30 8 z`} style={`--i:${i}`} />)}
      </svg>
    )}
    <span class="oc-cap">{th ? `${th.floor}${th.more ? ` and ${th.more} more` : ''}` : `${floors.length} ${floors.length === 1 ? 'floor' : 'floors'} · plan not modelled yet`}</span>
  </a>
  <div class="oc-body">
    <header class="oc-h">
      <span class="code">{s.code}</span>
      <a class="oc-n" href={href(`/locations/${o.id}/`)}><b>{s.name}</b></a>
    </header>
    <p class="oc-sub">{ROLE_WORD[s.role] ?? 'Office'} · {s.city} · <span data-loc-clock>--:--</span> local</p>
    <p class="oc-open" data-loc-open data-help="loc.open">&nbsp;</p>
    <ul class="oc-lights" data-help="loc.lights">
      {o.lights.map((l) => (
        <li><a href={l.to.startsWith('#') ? href(`/locations/${o.id}/${l.to}`) : href(l.to)} title={`${l.label}: ${l.text}`}><i class="hl" data-state={l.tone} aria-hidden="true"></i><span>{l.label}</span><small class="sr">{LIGHT_WORD[l.tone]}: {l.text}</small></a></li>
      ))}
    </ul>
    <dl class="oc-k">
      <div><dt>Open incidents</dt><dd><a class:list={{ bad: nInc > 0 }} href={href(`/incidents/?site=${o.id}&${OPEN_Q}`)}>{nInc}</a></dd></div>
      <div><dt>On site today</dt><dd><a href={href(`/team/?office=${o.id}`)}>{nPeople}</a></dd></div>
      <div><dt>Rooms</dt><dd><a href={href(`/rooms/?site=${o.id}`)} data-vt-rec="dd-rooms">{o.rooms.length}</a></dd></div>
    </dl>
  </div>
</article>

<style>
  .oc { display: grid; grid-template-rows: auto 1fr; overflow: hidden; padding: 0; transition: box-shadow var(--dur-state) var(--ease-settle), transform var(--dur-state) var(--ease-settle); }
  .oc:hover { box-shadow: var(--shadow-2, 0 6px 20px rgb(0 0 0 / 0.08)); }
  .oc-pic { display: grid; gap: 4px; padding: 14px 16px 8px; background: var(--surface-2); border-bottom: 1px solid var(--line); text-decoration: none; color: var(--text-2); }
  .oc-pic svg { width: 100%; height: auto; display: block; aspect-ratio: 16 / 7; }
  .oc-out { fill: var(--bg); stroke: var(--line-strong); stroke-width: 0.25; }
  .oc-rm { fill: color-mix(in srgb, var(--ink) 6%, var(--bg)); stroke: var(--line-strong); stroke-width: 0.12; transition: fill var(--dur-state) var(--ease-settle); }
  .oc-rm.oc-comms { fill: var(--surface-3); }
  .oc-rm[data-st=use] { fill: color-mix(in srgb, var(--blue) 30%, var(--bg)); }
  .oc-rm[data-st=free] { fill: color-mix(in srgb, var(--green) 22%, var(--bg)); }
  .oc-rm[data-st=problem] { fill: color-mix(in srgb, var(--red) 40%, var(--bg)); stroke: var(--red); }
  .oc-slab { fill: var(--bg); stroke: var(--line-strong); stroke-width: 0.8; }
  .oc-cap { font-size: 11.5px; }
  .oc-body { display: grid; gap: 8px; padding: 12px 16px 14px; align-content: start; }
  .oc-h { display: flex; gap: 8px; align-items: baseline; min-width: 0; }
  .oc-n { color: var(--ink); text-decoration: none; font: 700 17px/1.25 var(--font-display); min-width: 0; }
  .oc-n:hover { text-decoration: underline; }
  .oc-sub { margin: 0; font-size: 13px; color: var(--text-2); font-variant-numeric: tabular-nums; }
  .oc-open { margin: 0; font-size: 12.5px; font-weight: 650; color: var(--text-2); }
  .oc-open[data-open="1"] { color: var(--green-ink, var(--green)); }
  .oc-lights { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 0; padding: 0; list-style: none; }
  .oc-lights a { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--ink); text-decoration: none; }
  .oc-lights a:hover span { text-decoration: underline; }
  .oc-lights .hl { width: 10px; height: 10px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .oc-k { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 4px 0 0; padding-top: 10px; border-top: 1px solid var(--line); }
  .oc-k div { display: grid; gap: 2px; min-width: 0; }
  .oc-k dt { font-size: 11.5px; color: var(--text-2); }
  .oc-k dd { margin: 0; }
  .oc-k a { font: 700 19px/1.1 var(--font-display); color: var(--ink); text-decoration: none; font-variant-numeric: tabular-nums; }
  .oc-k a:hover { text-decoration: underline; }
  .oc-k a.bad { color: var(--red-ink); }
  @media (prefers-reduced-motion: reduce) { .oc, .oc-rm { transition: none; } }
</style>
