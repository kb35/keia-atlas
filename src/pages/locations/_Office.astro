---
// An office. Record archetype (page-anatomy.md, B):
//   band      Office · region · local time · open or closed; in use now, problems now, people on site today,
//             open incidents (each drills down, P10); "Open in 3D" where a floor file exists
//   top       the floor map, a floor at a time, rooms coloured by their state now and each one opening the room
//             (or, with no floor file, the floors as lists of rooms), beside the sticky Today panel: the three
//             service lights, who is on site and what needs attention
//   tiles     internet (the circuits where modelled), comms rooms (sizing verdicts), work in the next two weeks
//   sections  rooms by floor, with pictures; comms rooms and racks; open work and incidents; vendors and visits;
//             facts
import Shell from '../../layouts/Shell.astro';
import PageBand from '../../components/PageBand.astro';
// Spaces out of service read Off on the plan (the Out of service capability; src/lib/locations-client.mjs reads it).
import { oosSeed } from '../../lib/capabilities-view.mjs';
import SidePanel from '../../components/SidePanel.astro';
import Section from '../../components/Section.astro';
import DetailTabs from '../../components/DetailTabs.astro';
import FloorMap from '../../components/FloorMap.astro';
import RoomPlanSprite from '../../components/RoomPlanSprite.astro';
import GuideLive from '../../components/GuideLive.astro';
import HealthGlyph from '../../components/HealthGlyph.astro';
import LensStrip from '../../components/LensStrip.astro';
import LensKey from '../../components/LensKey.astro';
import Replay from '../../components/Replay.astro';
import { officeLenses, replayJobs } from '../../lib/lens-data.mjs';
import { href, countryName, plural, fmtDate, KIND, PHASES, PHASE_LABEL, PROJECT_KIND, VENDOR_KIND, DEMO_TODAY } from '../../lib/data.mjs';
import { WORK_KIND } from '../../lib/work.mjs';
import { office, liveModelFor, REGION_SHORT, ROLE_WORD, LIGHT_WORD, OPEN_Q, roomTitle, INC_WORD } from '../../lib/locations.mjs';
import { recHere } from '../../lib/vt.mjs';
import { storeOf } from '../../lib/stock.mjs';
import Restricted from '../../components/Restricted.astro';
import Arrive from '../../components/Arrive.astro';
import { renewalWords } from '../../lib/cover.mjs';
import { hoursWords, windowWords, nextWindow, daysWords } from '../../lib/hours.mjs';
import { localAt } from '../../lib/oncall.mjs';
import { DEMO_NOW_UTC } from '../../lib/oncall-view.mjs';

interface Props { site: string }
const o = office(Astro.props.site);
const s = o.s, M = o.M;
const store = storeOf(o.id);
const today = fmtDate(DEMO_TODAY, { weekday: 'long', day: 'numeric', month: 'long' });
const NUMBERS = [
  { id: 'loc-use', n: '–', label: 'In use now', to: `/locations/?site=${o.id}&status=use` },
  { id: 'loc-problem', n: '–', label: 'Problems now', to: `/locations/?site=${o.id}&status=problem` },
  { n: o.people.length, label: 'On site today', to: `/team/?office=${o.id}` },
  { n: o.inc.length, label: 'Open incidents', to: `/incidents/?site=${o.id}&${OPEN_Q}`, tone: o.inc.length ? 'bad' as const : undefined },
];
const roomsOn = (f) => f.rooms.filter((r) => KIND(r) !== 'comms');
const floorTabs = M ? M.floors.map((f) => ({ id: `floor-${f.id}`, label: f.name, count: roomsOn(o.floors.find((x) => x.id === String(f.id)) ?? { rooms: [] }).length })) : [];
const racks = Object.fromEntries((M?.racks ?? []).map((r) => [r.id, r.space]));
const units = (r) => r.positions.reduce((n, p) => n + p.units.length, 0);
const incIn = (id) => o.inc.filter((v) => v.space.id === id);
const attention = [
  ...o.inc.slice(0, 3).map((v) => ({ tone: v.inc.priority <= 2 ? 'bad' : 'warn', text: v.inc.short_description, sub: `${v.inc.number} · ${INC_WORD[v.inc.state]} · ${v.roomTitle}`, to: v.href })),
  ...o.comms.filter((c) => c.verdict.tone === 'bad').map((c) => ({ tone: 'warn', text: `${c.title} is short for what it serves`, sub: c.verdict.text, to: `/rooms/${c.space.id}/#sizing` })),
  ...(store?.low ? [{ tone: 'warn', text: `IT store: ${plural(store.low, 'line')} below minimum`, sub: `${store.number ? `${store.number} ` : ''}${store.name}`, to: store.href }] : []),
  ...o.comms.filter((c) => c.pill.tone === 'warn').map((c) => ({ tone: 'warn', text: `${c.title}: older network kit`, sub: c.pill.rf.text, to: `/rooms/${c.space.id}/` })),
];
const OPEN_PHASES = PHASES.filter((p) => p !== 'closed').join(',');
// Device swaps due are one item a room and a year; here they are one line for the office and year, opening the work
// plan for this office and that year (so the number in the line is the number the plan shows).
const swaps = new Map();
const rest = [];
for (const w of o.twoWeeks) {
  if (w.kind !== 'refresh') { rest.push(w); continue; }
  const year = w.end.slice(0, 4);
  const cur = swaps.get(year) ?? { ...w, units: 0 };
  cur.units += +(/^Replace (\d+)/.exec(w.title)?.[1] ?? 1);
  swaps.set(year, cur);
}
const swapItems = [...swaps.entries()].map(([year, w]) => ({ ...w, title: `Replace ${plural(w.units, 'device')} due in ${year}`, href: href(`/refresh/?site=${o.id}&year=${year}`) }));
const work2 = [...rest, ...swapItems].filter((w) => w.kind !== 'time-off').sort((a, b) => (a.start ?? '').localeCompare(b.start ?? ''));
// Work that started before today says when it ends; the rest, when it starts.
const dm = (d) => fmtDate(d, { day: 'numeric', month: 'short' });
const when = (w) => (!w.start ? 'No date' : w.start < DEMO_TODAY && w.end ? `Until ${dm(w.end)}` : dm(w.start));
const upcomingVisits = o.visits.filter((v) => (v.end ?? v.start) >= DEMO_TODAY);
const FACTS = [
  ['Kind', ROLE_WORD[s.role] ?? 'Office'],
  ['Where', `${s.city}, ${countryName(s.country)}`],
  ['Region', REGION_SHORT[s.region]],
  ['Time zone', s.time_zone],
  ['Floors', (s.floors ?? []).map((f) => f.name.replace(/:.*$/, '')).join(', ') || 'Not recorded'],
  ['Spaces', `${plural(o.peopleRooms.filter((r) => KIND(r) !== 'desks').length, 'space')}, ${plural(o.desks, 'desk')}, ${plural(o.comms.length, 'comms room')}`],
  ['Devices', plural(o.units, 'unit')],
  ['Mains', s.mains ? `${s.mains.volts} V, ${s.mains.hz} Hz, plug ${s.mains.plugs?.join(', ')}` : 'Not recorded'],
  ['On-site technician', o.tech.length ? o.tech.map((p) => p.name).join(', ') : 'None; covered from another office'],
  ['3D model', M ? 'Modelled: every floor, comms room, cable run and circuit' : 'Not modelled yet'],
];
const json = JSON.stringify({ ...liveModelFor([o.id]), base: href('/') }).replace(/</g, '\\u003c');
// The answer (UI-V2 §3.2): spaces not working first. Written from the open incidents here; the live feed then keeps it
// current (locations-client.mjs, from the same simulation as the plan).
const incSpaces = new Set(o.inc.map((v) => v.space.id)).size;
// Lenses and Replay (UX-V2 §2.5 and §8): each space's reading under every lens, and each floor's open jobs over time.
const LENS_JSON = M ? JSON.stringify(officeLenses(o.id)).replace(/</g, '\\u003c') : '';
const JOBS = M ? replayJobs(o.id) : {};
// Internet circuits in full (the overlooked items, #8): what the carrier needs on a call, and when each contract renews.
const CIRC = (M?.circuits ?? []).map((c) => ({ ...c, renew: renewalWords(c.contract?.renews, DEMO_TODAY) }));
const roleWord = (c) => (c.role === 'primary' ? 'primary' : 'backup');
const soonest = CIRC.filter((c) => c.renew?.soon).sort((a, b) => a.contract.renews.localeCompare(b.contract.renews))[0];
const CIRC_ANSWER = CIRC.length
  ? `${CIRC.length === 1 ? 'One circuit' : `${CIRC.length} circuits`}: ${CIRC.map((c) => `${c.bandwidth && c.bandwidth !== 'Not recorded' ? c.bandwidth.replace(/ symmetric$/, '') : 'bandwidth not recorded'} ${roleWord(c)}`).join(', ')}${soonest ? ` · ${soonest.provider} ${soonest.renew.text.charAt(0).toLowerCase()}${soonest.renew.text.slice(1)}` : ''}`
  : null;
// Office hours and the change window (#7): in the office's own time, with when the window next opens.
const LOCAL = s.time_zone ? localAt(s.time_zone, DEMO_NOW_UTC) : null;
const NEXT_WIN = s.change_window && LOCAL ? nextWindow(s.change_window, LOCAL) : null;
const HOURS_ANSWER = s.office_hours || s.change_window
  ? [s.office_hours ? `Open ${s.office_hours.open} to ${s.office_hours.close}, ${daysWords(s.office_hours.days)}` : null, NEXT_WIN ? `next change window ${NEXT_WIN.text}` : null].filter(Boolean).join(' · ')
  : null;
const ANSWER = incSpaces ? `${plural(incSpaces, 'space')} not working now` : `All spaces working · no open incidents`;
---
<Shell title={s.name} section="office" crumbs={[{ label: 'Locations', to: '/locations/' }, { label: REGION_SHORT[s.region], to: `/locations/${s.region}/` }, { label: s.name }]} about={{ kind: 'office', label: s.name, to: `/locations/${o.id}/` }}>
  <PageBand overline="Office" title={s.name} answer={ANSWER} sim="live" numbers={NUMBERS} rec={`loc-${o.id}`}>
    <Fragment slot="overline">
      <span class="code">{s.code}</span>
      <a href={href(`/locations/${s.region}/`)} data-help="loc.region">{REGION_SHORT[s.region]}</a>
      <span class="ob-tz" data-loc-tz={s.time_zone} data-help="loc.open"><span data-loc-clock>--:--</span> local · <span class="ob-open" data-loc-open>&nbsp;</span></span>
    </Fragment>
    <Fragment slot="lede">{ROLE_WORD[s.role] ?? 'Office'} in {s.city}, {countryName(s.country)}. {plural(o.peopleRooms.filter((r) => KIND(r) !== 'desks').length, 'space')} and {plural(o.desks, 'desk')} on {plural((s.floors ?? []).length, 'floor')}.</Fragment>
    {M ? <a slot="action" class="btn primary" href={href(`/locations/${o.id}/3d/`)} data-help="loc.3d">Open in 3D</a>
      : <span slot="action" class="ob-no3d faint" data-help="loc.3d">3D model: not modelled yet</span>}
  </PageBand>

  <div class="content ofc" data-loc="office" data-loc-racks={JSON.stringify(racks)} data-loc-answer data-cockpit>
    <RoomPlanSprite />
    <div class="g12 top">
      <section class="card s-7 stick ofc-map" aria-label="Floors" {...recHere(`loc-${o.id}`)} data-help="loc.floor">
        {M && (
          <LensStrip>
            <button slot="end" type="button" class="btn small ghost ofc-rpl" data-rpl-toggle aria-expanded="false" data-help="replay">Replay</button>
          </LensStrip>
        )}
        {M ? (
          <DetailTabs tabs={floorTabs} label="Floors" param="floor">
            {M.floors.map((f) => (
              <div slot={`floor-${f.id}`}><FloorMap site={o.id} floor={f.id} interactive vtHere /></div>
            ))}
          </DetailTabs>
        ) : (
          <div class="ofc-floors">
            <p class="faint ofc-note">No floor plan is modelled for this office yet. Its spaces, floor by floor:</p>
            {o.floors.map((f) => (
              <div class="ofc-fl">
                <h3>{f.name}</h3>
                <div class="ofc-chips">
                  {roomsOn(f).map((r) => <a class="ofc-chip" href={href(`/rooms/${r.id}/`)} data-loc-room={r.id} data-vt-rec={r.id} title={roomTitle(r)}><span class="mono">{r.number ?? ''}</span>{r.name}</a>)}
                </div>
              </div>
            ))}
          </div>
        )}
        {M && <div class="sel sel-card" data-sel-box hidden aria-live="polite" data-help="loc.selected"></div>}
        {M && <LensKey />}
        {M && <Replay jobs={JOBS} title={s.name} tz={s.time_zone} />}
        {!M && <p class="ofc-key" aria-label="Key"><span><i data-st="use"></i>In use</span><span><i data-st="free"></i>Free</span><span><i data-st="problem"></i>Problem</span><span><i data-st="closed"></i>Closed</span></p>}
      </section>

      <SidePanel class="s-5" title="Today" meta={today} id="today" help="loc.today">
        {M && <div class="sel sel-side" data-sel-box hidden aria-live="polite" data-help="loc.selected"></div>}
        <div class="td">
          <ul class="td-lights" data-help="loc.lights">
            {o.lights.map((l) => (
              <li><a href={l.to.startsWith('#') ? l.to : href(l.to)}><HealthGlyph state={l.tone} size={12} title={l.text} /><b>{l.label}</b><span>{l.text}</span></a></li>
            ))}
          </ul>
          <div>
            <h3 class="td-h">On site today <span class="faint">{o.people.length}</span></h3>
            {o.people.length ? (
              <ul class="td-people">
                {o.people.map((p) => <li><a href={href(`/team/?p=${p.id}`)} title={`${p.name}, ${p.role}`}><span class="avatar sm" aria-hidden="true">{p.initials}</span><span><b>{p.name}</b><small>{p.role}</small></span></a></li>)}
              </ul>
            ) : <p class="faint td-none">Nobody is booked in today.</p>}
          </div>
          <div>
            <h3 class="td-h">To review</h3>
            <ul class="td-att" data-loc-att></ul>
            <ul class="td-att">
              {attention.map((a) => <li><a href={href(a.to)}><HealthGlyph state={a.tone} size={12} title={a.text} /><span>{a.text}</span><small>{a.sub}</small></a></li>)}
            </ul>
            {!attention.length && <p class="faint td-none" data-loc-att-none>Nothing to review right now.</p>}
          </div>
        </div>
      </SidePanel>
    </div>

    <div class="g12">
      <div class="card side-card s-3" data-help="loc.internet">
        <h3>Internet</h3>
        {M && M.circuits.length ? (
          <ul class="tl">
            {M.circuits.map((c) => <li><b>{c.provider}</b><small>{c.role === 'primary' ? 'Primary' : 'Backup'} · {c.type}{c.bandwidth && c.bandwidth !== 'Not recorded' ? ` · ${c.bandwidth}` : ''}</small></li>)}
          </ul>
        ) : <p class="faint">Circuits not modelled yet. They come with the office's floor file.</p>}
        {CIRC.length > 0 ? <a class="tl-all" href="#circuits">Circuit IDs and support ↓</a> : M && <a class="tl-all" href={href(`/locations/${o.id}/3d/`)}>Follow them in 3D →</a>}
      </div>
      <div class="card side-card s-3" data-help="loc.comms">
        <h3>Comms rooms</h3>
        {o.comms.length ? (
          <ul class="tl">
            {o.comms.map((c) => <li><a href={href(`/rooms/${c.space.id}/`)}><b>{c.title}</b></a><small><HealthGlyph state={c.verdict.tone} size={12} title={c.verdict.text} /> {c.verdict.text}</small></li>)}
          </ul>
        ) : <p class="faint">Not recorded.</p>}
        <a class="tl-all" href="#comms">Racks and sizing ↓</a>
      </div>
      <div class="card side-card s-3" data-help="loc.store">
        <h3>IT store</h3>
        {store ? (
          <>
            <ul class="tl">
              <li><a href={href(store.roomHref)}><b>{store.number ? `${store.number} ` : ''}{store.name}</b></a><small>{plural(store.units.length, 'spare unit')} · {plural(store.consumables.length, 'counted line')}</small></li>
              <li><a href={href(store.href)}><b class:list={{ 'tl-bad': store.low > 0 }}>{store.low ? `${store.low} below minimum` : 'Nothing below minimum'}</b></a><small>Last counted {fmtDate(store.lastCounted)}{store.overdue ? ', a count is overdue' : ''}</small></li>
            </ul>
            <a class="tl-all" href={href(store.href)}>Open the IT store →</a>
          </>
        ) : <p class="faint">No IT store recorded.</p>}
      </div>
      <div class="card side-card s-3" data-help="loc.work">
        <h3>Next two weeks</h3>
        {work2.length ? (
          <ul class="tl">
            {work2.slice(0, 4).map((w) => <li><a href={w.href}><b>{w.title}</b></a><small>{when(w)} · {WORK_KIND[w.kind]}</small></li>)}
          </ul>
        ) : <p class="faint">Nothing booked.</p>}
        <a class="tl-all" href={href(`/work/schedule/?site=${o.id}`)}>See all {work2.length} in Schedule →</a>
      </div>
    </div>

    <Section title="Spaces by floor" id="rooms" help="loc.rooms" aside={plural(o.peopleRooms.length, 'space')}>
      <div class="rf">
        {o.floors.map((f) => roomsOn(f).length > 0 && (
          <div class="rf-floor">
            <h3 class="rf-h">{f.name} <span class="faint">{plural(roomsOn(f).length, 'space')}</span></h3>
            <div class="rf-grid">
              {roomsOn(f).map((r) => (
                <a class:list={['rf-card', { alert: incIn(r.id).length > 0 }]} href={href(`/rooms/${r.id}/`)} data-loc-room={r.id}>
                  <span class="rf-pic" data-vt-rec={r.id}><svg class="rplan" viewBox="0 0 120 80" aria-hidden="true"><use href={`#rp-${r.space_type}`} /></svg></span>
                  <span class="rf-b"><span class="mono rf-no">{r.number ?? s.code}</span><b>{r.name}</b><small>{r.type.profile.name}{r.count ? ` · ${r.count} desks` : ''} · {plural(units(r), 'device')}</small></span>
                  <i class="rf-st" aria-hidden="true"></i>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
      <a slot="aside" href={href(`/rooms/?site=${o.id}`)} data-vt-rec="dd-rooms">All {plural(o.rooms.length, 'space')} in Spaces →</a>
    </Section>

    <Section title="Comms rooms and racks" id="comms" help="loc.comms">
      {o.comms.length ? (
        <div class="cm">
          {o.comms.map((c) => (
            <article class="cm-row">
              <header class="cm-h">
                <a href={href(`/rooms/${c.space.id}/`)}><b>{c.title}</b></a>
                <span class="faint">{c.mdf ? 'Main comms room (MDF)' : 'Floor comms room (IDF)'} · {c.racks.length ? c.racks.map((k) => `${k.name}, ${k.height_u}U`).join('; ') : 'No rack recorded'}</span>
                <span class={`pill ${c.pill.tone}`}>{c.pill.text}</span>
              </header>
              <table class="cm-t to-cards">
                <thead><tr><th scope="col">Sized for</th><th scope="col">Needs</th><th scope="col">Has</th><th scope="col">Verdict</th></tr></thead>
                <tbody>
                  {c.size.rows.map((r) => (
                    <tr><th scope="row" data-label="Sized for">{r.name}</th><td data-label="Needs">{r.need}<small class="faint"> {r.needNote}</small></td><td data-label="Has">{r.have ?? '–'}</td><td data-label="Verdict"><span class={`cm-v t-${r.v.tone}`}>{r.v.text}</span></td></tr>
                  ))}
                </tbody>
              </table>
            </article>
          ))}
        </div>
      ) : <p class="faint">Not recorded.</p>}
      <a slot="aside" href={href(`/cables/?site=${o.id}`)}>Cables at {s.name} →</a>
    </Section>

    {CIRC.length > 0 && (
      <Section title="Internet circuits" id="circuits" help="loc.circuits" data-feature="circuits" data-settle>
        <span slot="aside"><Restricted view="circuits" /> <a href={href(`/locations/${o.id}/3d/`)}>Follow them in 3D</a></span>
        <p class="ci-answer">{CIRC_ANSWER}</p>
        <div class="g12 ci-grid">
          {CIRC.map((c) => (
            <article class:list={['card side-card ci', CIRC.length === 1 ? 's-12' : 's-6']} aria-labelledby={`ci-${c.id}`}>
              <header class="ci-h">
                <h3 id={`ci-${c.id}`}>{c.provider}</h3>
                <span class="pill plain">{c.role === 'primary' ? 'Primary' : 'Backup'}</span>
              </header>
              <p class="ci-bw">{c.bandwidth && c.bandwidth !== 'Not recorded' ? <><b class="rs-tick">{c.bandwidth.replace(/ .*$/, '')}</b> {c.bandwidth.replace(/^\S+ /, '')}</> : <span class="faint">Bandwidth not recorded</span>}</p>
              <dl class="kv ci-kv">
                {c.circuit_id && <div><dt>Circuit ID</dt><dd><span class="mono">{c.circuit_id}</span></dd></div>}
                {c.sla && <div><dt>Service level</dt><dd>{[c.sla.availability ? `${c.sla.availability} available` : null, c.sla.restore ? `restored within ${c.sla.restore}` : null, c.sla.hours].filter(Boolean).join(', ')}</dd></div>}
                {c.support && <div><dt>Support</dt><dd>{c.support.desk}{c.support.hours ? `, ${c.support.hours}` : ''}{c.support.account && <>; account <span class="mono">{c.support.account}</span></>}</dd></div>}
                {c.renew && <div><dt>Contract</dt><dd><span class:list={{ 'ci-soon': c.renew.soon }}>{c.renew.text}</span>{c.renew.soon ? <span class="faint"> ({c.renew.date})</span> : ''}{c.contract?.term_months ? <span class="faint">, {c.contract.term_months}-month term</span> : ''}</dd></div>}
                <div><dt>Kind</dt><dd>{c.type}</dd></div>
              </dl>
              {c.demo && <p class="ci-foot faint">Carrier details are demo values <span class="demo-val" data-help="unit.demo-value">Demo value</span>. The carrier's phone number is kept in the paging tool, not here.</p>}
            </article>
          ))}
        </div>
      </Section>
    )}

    <Section title="Open work and incidents" id="work" help="loc.openwork">
      <GuideLive where="office" site={o.id} />
      <div class="ow">
        <div>
          <h3 class="ow-h">Projects <a href={href(`/projects/?site=${o.id}&phase=${OPEN_PHASES}`)} class="faint">{o.projects.length}</a></h3>
          {o.projects.length ? (
            <ul class="tl">
              {o.projects.map((p) => <li><a href={href(`/projects/${p.id.toLowerCase()}/`)}><b>{p.name}</b></a><small>{p.id} · {PROJECT_KIND[p.kind] ?? p.kind} · {PHASE_LABEL[p.phase] ?? p.phase}</small></li>)}
            </ul>
          ) : <p class="faint">No open projects.</p>}
        </div>
        <div>
          <h3 class="ow-h">Incidents <a href={href(`/incidents/?site=${o.id}&${OPEN_Q}`)} class="faint">{o.inc.length}</a></h3>
          {o.inc.length ? (
            <ul class="tl">
              {o.inc.map((v) => <li><a href={href(v.href)}><b>{v.inc.short_description}</b></a><small><span class={`ri-p p-${v.inc.priority}`}>P{v.inc.priority}</span> {v.inc.number} · {INC_WORD[v.inc.state]} · {v.roomTitle}</small></li>)}
            </ul>
          ) : <p class="faint">No open incidents.</p>}
        </div>
      </div>
    </Section>

    <Section title="Vendors and visits" id="vendors" help="loc.vendors">
      <div class="ow">
        <div>
          <h3 class="ow-h">Vendors <a href={href(`/vendors/?site=${o.id}`)} class="faint">{o.vendors.length}</a></h3>
          {o.vendors.length ? (
            <ul class="tl">
              {o.vendors.map((v) => <li><a href={href(`/vendors/?site=${o.id}&q=${encodeURIComponent(v.name)}`)}><b>{v.name}</b></a><small>{VENDOR_KIND[v.kind] ?? v.kind}</small></li>)}
            </ul>
          ) : <p class="faint">No vendors recorded for this office.</p>}
        </div>
        <div>
          <h3 class="ow-h">Visits <a href={href(`/work/schedule/?site=${o.id}&kind=visit`)} class="faint">{upcomingVisits.length}</a></h3>
          {upcomingVisits.length ? (
            <ul class="tl">
              {upcomingVisits.map((v) => <li><a href={v.href}><b>{v.title}</b></a><small>{fmtDate(v.start)}{v.end && v.end !== v.start ? ` to ${fmtDate(v.end)}` : ''}</small></li>)}
            </ul>
          ) : <p class="faint">No visits booked.</p>}
        </div>
      </div>
    </Section>

    {HOURS_ANSWER && (
      <Section title="Hours and change window" id="hours" help="loc.hours" data-feature="change-windows" data-settle>
        <p class="hw-answer">{HOURS_ANSWER}</p>
        <div class="g12">
          {s.office_hours && (
            <div class="card side-card s-6 hw">
              <h3>Office hours</h3>
              <p class="hw-big"><b class="rs-tick">{s.office_hours.open}</b> to <b class="rs-tick">{s.office_hours.close}</b></p>
              <p class="hw-sub">{daysWords(s.office_hours.days)}, {s.time_zone.split('/')[1].replace(/_/g, ' ')} time. Displays and signage turn on at opening and off an hour after closing.</p>
            </div>
          )}
          {s.change_window && (
            <div class="card side-card s-6 hw">
              <h3>Change window</h3>
              <p class="hw-big"><b class="rs-tick">{s.change_window.from}</b> to <b class="rs-tick">{s.change_window.to}</b></p>
              <p class="hw-sub">Every {windowWords(s.change_window, { long: true }).replace(/ .*$/, '')}{s.change_window.to <= s.change_window.from ? ', running into the next morning' : ''}. Firmware, switch and Wi-Fi changes that could interrupt a meeting happen here, as the <a href={href('/standards/network/')}>network</a> and <a href={href('/standards/wifi/')}>Wi-Fi</a> standards ask.{NEXT_WIN && <> Next: <b>{NEXT_WIN.text}</b>.</>}</p>
            </div>
          )}
        </div>
        {(s.office_hours?.demo || s.change_window?.demo) && <p class="faint hw-foot">Hours and window are demo values <span class="demo-val" data-help="unit.demo-value">Demo value</span>.</p>}
      </Section>
    )}

    <Section title="Facts" id="facts" help="loc.facts">
      <dl class="kv ofc-facts">
        {FACTS.map(([a, b]) => <div><dt>{a}</dt><dd>{b}</dd></div>)}
      </dl>
    </Section>
    <script type="application/json" data-loc-model set:html={json}></script>
    <script type="application/json" data-oos-seed set:html={JSON.stringify(oosSeed.filter((r) => r.space.startsWith(`${Astro.props.site}-`)))}></script>
    {M && <script type="application/json" data-lens-data set:html={LENS_JSON}></script>}
  </div>

  <script>
    import { startLocations } from '../../lib/locations-client.mjs';
    import { startLenses } from '../../lib/lens-client.mjs';
    import { startReplay } from '../../lib/replay-client.mjs';
    function init() {
      const root = document.querySelector('[data-loc="office"]') as any;
      if (!root || root.__loc) return;
      const stops = [startLocations(root), startLenses(root), startReplay(root)];
      document.addEventListener('astro:before-swap', () => stops.forEach((f) => f()), { once: true });
    }
    init();
    document.addEventListener('astro:page-load', init);
  </script>
  <Arrive />
</Shell>

<style>
