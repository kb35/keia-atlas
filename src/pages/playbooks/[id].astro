---
// One playbook (Record): the phases at a glance beside what it is for, the projects using it, then every
// step and gate. A playbook may skip phases; only the ones it has are shown. Deploy holds four device
// steps (Provision, Install, Configure, Commission), shown inside it.
import Shell from '../../layouts/Shell.astro';
import Icon from '../../components/Icon.astro';
import Raci from '../../components/Raci.astro';
import PageBand from '../../components/PageBand.astro';
import SidePanel from '../../components/SidePanel.astro';
import Section from '../../components/Section.astro';
import EmptyState from '../../components/EmptyState.astro';
import { playbooks, projects, PHASE_LABEL, STEP_LABEL, INTEGRATE_STEPS, INTENSITY, phaseId, href, fmtDate, plural } from '../../lib/data.mjs';
import { ROLES, PEOPLE } from '../../lib/demo.mjs';
import { recHere } from '../../lib/vt.mjs';

export function getStaticPaths() {
  return Object.keys(playbooks).map((id) => ({ params: { id } }));
}
const pb = playbooks[Astro.params.id];
const using = Object.values(projects).filter((p) => p.playbook === pb.id);
const holders = (roleId) => PEOPLE.filter((p) => p.roleId === roleId);
const roleName = (r) => ROLES[r]?.name ?? r;
const initialsFor = (r) => { const h = holders(r); return h.length > 2 ? `${h[0].initials} +${h.length - 1}` : h.map((p) => p.initials).join(' ') || '·'; };
// "1 to 3" is weeks; "Under 1" is under a week; anything longer already says its unit.
const wk = (w) => (w === '-' ? '' : /^(under )?\d+( to \d+)?$/i.test(String(w)) ? `${w}${/^(under )?1$/i.test(String(w)) ? ' week' : ' weeks'}` : String(w));
const total = pb.phases.reduce((n, ph) => n + ph.steps.length, 0);
const longLead = pb.phases.reduce((n, ph) => n + ph.steps.filter((s) => s.long_lead).length, 0);
const duration = pb.weeks.min === pb.weeks.max ? `${pb.weeks.min}` : `${pb.weeks.min} to ${pb.weeks.max}`;
const here = (ph) => using.filter((p) => phaseId(p.phase) === ph.phase);
// Deploy's steps by device step, in order; a step with no device step goes last, ungrouped.
const groupsOf = (ph) => {
  if (ph.phase !== 'integrate') return [{ key: null, steps: ph.steps }];
  const g = INTEGRATE_STEPS.map((k) => ({ key: k, steps: ph.steps.filter((s) => s.step === k) })).filter((x) => x.steps.length);
  const rest = ph.steps.filter((s) => !INTEGRATE_STEPS.includes(s.step));
  return rest.length ? [...g, { key: null, steps: rest }] : g;
};
// RACI for this playbook, from its own steps and gates: R where a role does steps, A where it signs the gate.
const ORDER = Object.keys(ROLES);
const raciCols = ORDER.filter((r) => pb.phases.some((ph) => ph.steps.some((st) => st.role === r) || ph.gate.by.includes(r)));
const raciRows = pb.phases.map((ph) => {
  const cells = {};
  for (const r of raciCols) {
    const steps = ph.steps.filter((st) => st.role === r).map((st) => st.title);
    if (ph.gate.by.includes(r)) cells[r] = { letter: 'A', detail: `Signs the gate: ${ph.gate.checks.join('; ')}.${steps.length ? ` Also does: ${steps.join('; ')}.` : ''}` };
    else if (steps.length) cells[r] = { letter: 'R', detail: steps.join('; ') + '.' };
  }
  if (!ph.steps.some((st) => st.role === 'pm') && !ph.gate.by.includes('pm') && raciCols.includes('pm')) cells.pm = { letter: 'I', detail: 'Kept up to date to run the dates.' };
  return { label: PHASE_LABEL[ph.phase], sub: wk(ph.weeks), cells };
});
const NUMBERS = [
  { n: duration, label: 'Weeks', fact: true },
  { n: total, label: 'Steps', to: '#steps' },
  { n: longLead, label: 'Long lead', to: '#steps', tone: longLead ? 'warn' : undefined },
  { n: using.length, label: 'Projects using it', to: '#projects' },
];
---
<Shell title={pb.name} section="playbooks" minStage={3} crumbs={[{ label: 'Playbooks', to: '/playbooks/' }, { label: pb.name }]} about={{ kind: 'playbook', label: pb.name, to: `/playbooks/${pb.id}/` }}>
  <PageBand overline="Playbook" title={pb.name} lede={pb.summary} sim numbers={NUMBERS}>
    <span slot="overline" class="pill plain">Version {pb.version}</span>
    <span slot="overline" class="pill plain">{INTENSITY[pb.intensity]}</span>
    <a slot="action" class="btn primary" href={href(`/edit/?kind=project&pb=${pb.id}`)}><Icon name="plus" size={16} />New project</a>
  </PageBand>

  <div class="content">
    <div class="g12 top">
      <section class="card pad s-7 stick pv-card" aria-label="The phases" {...recHere(pb.id)}>
        <header class="pv-h"><h2>Phases</h2><span class="faint">{plural(pb.phases.length, 'phase')}, {plural(total, 'step')}. Pick one to see its steps.</span></header>
        <ol class="pv">
          {pb.phases.map((ph, i) => (
            <li class="pv-p">
              <a class="pv-row" href={`#ph-${ph.phase}`}>
                <span class="pv-n mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="pv-name"><b>{PHASE_LABEL[ph.phase]}</b><small class="faint">{wk(ph.weeks) || 'Wrap-up'}</small></span>
                <span class="pv-dots" role="img" aria-label={plural(ph.steps.length, 'step')}>{ph.steps.map((s) => <i class={s.long_lead ? 'long' : ''} title={s.title}></i>)}</span>
                <span class="pv-here-c">{here(ph).length > 0 && <span class="pv-here">{here(ph).map((p) => p.id).join(', ')} here</span>}</span>
                <span class="pv-cnt mono">{ph.steps.length}</span>
              </a>
              {ph.phase === 'integrate' && (
                <div class="pv-sub" aria-label="Device steps inside Deploy">
                  {groupsOf(ph).filter((g) => g.key).map((g) => <span class="pv-chip"><b>{STEP_LABEL[g.key]}</b><span class="mono">{g.steps.length}</span></span>)}
                </div>
              )}
            </li>
          ))}
        </ol>
        {longLead > 0 && <p class="pv-key faint"><i class="pv-d long"></i>Long lead: needs starting early</p>}
      </section>

      <SidePanel class="s-5" title="When to use it">
        <a slot="head" class="btn small" href={href(`/edit/?kind=playbook&pb=${pb.id}`)}><Icon name="edit" size={14} />Edit or copy</a>
        <p class="pb-when">{pb.when}</p>
        <dl class="kv pb-facts">
          <div><dt>Version</dt><dd>{pb.version}</dd></div>
          <div><dt>Intensity</dt><dd>{INTENSITY[pb.intensity]}</dd></div>
          <div><dt>Runs for</dt><dd>{duration} weeks</dd></div>
          <div><dt>Phases</dt><dd>{pb.phases.map((ph) => PHASE_LABEL[ph.phase]).join(', ')}</dd></div>
        </dl>
      </SidePanel>
    </div>

    <Section title="Projects using it" id="projects" aside={using.length ? plural(using.length, 'project') : undefined}>
      {using.length > 0 ? (
        <div class="list" data-items>
          {using.map((p) => (
            <a class="row plain" href={href(`/projects/${p.id.toLowerCase()}/`)}>
              <span><b class="name">{p.name}</b><span class="sub mono">{p.id}</span></span>
              <span class="end"><span class="pill deploy">{PHASE_LABEL[phaseId(p.phase)]}</span></span>
            </a>
          ))}
        </div>
      ) : (
        <EmptyState filter={false} text="No project uses this playbook yet." action="New project" to={`/edit/?kind=project&pb=${pb.id}`} />
      )}
    </Section>

    <Section title="Steps and gates" id="steps" aside="Each phase ends at a gate a named role signs off before the next starts.">
      <ol class="pb-phases">
        {pb.phases.map((ph, i) => (
          <li class="pbp" id={`ph-${ph.phase}`}>
            <div class="pbp-h">
              <span class="pbp-n mono">{String(i + 1).padStart(2, '0')}</span>
              <h3>{PHASE_LABEL[ph.phase]}</h3>
              <span class="faint pbp-w">{wk(ph.weeks)}</span>
              {here(ph).map((p) => <a class="pbp-live" href={href(`/projects/${p.id.toLowerCase()}/`)}>{p.id} is here</a>)}
            </div>
            <div class="pbp-steps">
              {groupsOf(ph).map((g) => (
                <>
                  {g.key && <p class="pbp-g overline">{STEP_LABEL[g.key]}</p>}
                  {g.steps.map((s) => (
                    <div class={`st${s.long_lead ? ' long' : ''}`}>
                      <span class={`st-role role-${s.role}`} title={holders(s.role).map((p) => p.name).join(', ')}><span class="st-av">{initialsFor(s.role)}</span>{roleName(s.role)}</span>
                      <span class="st-title">{s.title}</span>
                      <span class="st-tags">
                        {s.long_lead && <span class="st-ll">Long lead: start early</span>}
                        {s.output && <span class="st-out">Produces: {s.output}</span>}
                        {s.note && <span class="st-note">{s.note}</span>}
                      </span>
                    </div>
                  ))}
                </>
              ))}
            </div>
            <div class="gate">
              <span class="gate-h"><Icon name="lock" size={15} />Gate: signed off by {ph.gate.by.map(roleName).join(' and ')}</span>
              <ul>{ph.gate.checks.map((c) => <li>{c}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </Section>

    <Section title="Who does what" id="who" aside="Built from the steps and gates above. Hover a letter for the steps.">
      <div class="card"><Raci rows={raciRows} cols={raciCols} id={`pb-${pb.id}`} caption={`RACI for the ${pb.name} playbook`} /></div>
    </Section>

    {pb.changes?.length > 0 && (
      <Section title="What projects have taught it" id="lessons" aside={plural(pb.changes.length, 'change')}>
        <div class="card pad">
          <ul class="pb-changes">
            {pb.changes.map((c) => (
              <li><span class="mono faint">{fmtDate(c.date)}</span><span>{c.change}</span>{c.from && (projects[c.from.toLowerCase()] ? <a class="tag" href={href(`/projects/${c.from.toLowerCase()}/`)}>{c.from}</a> : <span class="tag">{c.from}</span>)}</li>
            ))}
          </ul>
        </div>
      </Section>
    )}
  </div>
</Shell>
<style is:global>
  .pv-card { display: grid; gap: 12px; }
  .pv-h { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .pv-h h2 { margin: 0; font-size: 18px; }
  .pv-h .faint { font-size: 12.5px; }
  .pv { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .pv-row { display: grid; grid-template-columns: 28px 130px minmax(0, 1fr) minmax(0, auto) 2ch; gap: 12px; align-items: center; padding: 10px 12px; border-radius: var(--radius); background: var(--surface-2); color: inherit; text-decoration: none; transition: background var(--dur-hover) var(--ease-settle); }
  .pv-row:hover { background: var(--surface-3); color: inherit; }
  .pv-n { font-size: 12px; color: var(--text-3); }
  .pv-name { display: grid; gap: 1px; min-width: 0; }
  .pv-name b { font-size: 15px; }
  .pv-name small { font-size: 12px; }
  .pv-dots { display: flex; flex-wrap: wrap; gap: 4px; }
  .pv-dots i, .pv-d { display: inline-block; width: 10px; height: 10px; border-radius: 3px; background: var(--blue); }
  .pv-dots i.long, .pv-d.long { background: var(--amber); }
  .pv-cnt { font-size: 12.5px; color: var(--text-2); min-width: 1.5ch; text-align: right; }
  .pv-here-c { min-width: 0; text-align: right; }
  .pv-here { display: inline-block; font: 700 11px/1 var(--font-mono); padding: 5px 8px; border-radius: 999px; background: var(--blue-soft); color: var(--blue-ink); }
  .pv-sub { display: flex; flex-wrap: wrap; gap: 6px; margin: 6px 0 2px 52px; padding-left: 12px; border: 1px solid color-mix(in srgb, var(--line-strong) 55%, transparent); }
  .pv-chip { display: inline-flex; gap: 6px; align-items: baseline; padding: 4px 9px; border-radius: 999px; background: var(--surface-2); font-size: 12.5px; color: var(--text-2); }
  .pv-chip b { color: var(--text); font-weight: 650; }
  .pv-key { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 12.5px; }
  .pb-when { margin: 0 0 12px; font-size: 14.5px; color: var(--text-2); }
  .pb-facts { margin: 0; }
  .sp-tools .btn { white-space: nowrap; }
  .pb-phases { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .pbp { position: relative; display: grid; grid-template-columns: 200px minmax(0, 1fr) 260px; gap: 18px; padding: 20px 0; border-top: 1px solid var(--line); scroll-margin-top: calc(var(--mast-h, 60px) + 16px); }
  .pbp:first-child { border-top: 0; padding-top: 4px; }
  .pbp-h { display: grid; align-content: start; gap: 4px; }
  .pbp-n { font-size: 12px; color: var(--text-3); }
  .pbp-h h3 { margin: 0; font-size: 22px; }
  .pbp-w { font-size: 13px; }
  .pbp-live { justify-self: start; margin-top: 6px; font: 700 11px/1 var(--font-mono); padding: 5px 8px; border-radius: 999px; background: var(--blue-soft); color: var(--blue-ink); text-decoration: none; }
  .pbp-steps { display: grid; gap: 8px; align-content: start; }
  .pbp-g { margin: 6px 0 -2px; }
  .pbp-g:first-child { margin-top: 0; }
  .st { display: grid; grid-template-columns: 210px minmax(0, 1fr); gap: 4px 14px; align-items: start; padding: 10px 12px; border-radius: var(--radius); background: var(--surface); border: var(--border-card); }
  :root[data-look="classic"] .st { border: 1.5px solid var(--ink); }
  .st.long { border: 1px solid color-mix(in srgb, var(--amber) 55%, transparent); }
  .st-role { display: inline-flex; align-items: center; gap: 7px; font: 600 12px/1.25 var(--font-sans); color: var(--text-2); }
  .st-av { flex: none; min-width: 26px; height: 22px; padding: 0 5px; border-radius: 999px; display: grid; place-items: center; font: 700 9.5px/1 var(--font-mono); background: var(--surface-3); color: var(--text); }
  :root[data-look="classic"] .st-av { background: var(--yellow); color: #15161B; border: 1.5px solid var(--ink); }
  .role-vendor .st-av { background: var(--amber-soft); color: var(--amber-ink); }
  .st-title { font-weight: 600; font-size: 14px; }
  .st-tags { grid-column: 2; display: flex; flex-wrap: wrap; gap: 6px; }
  .st-tags:empty { display: none; }
  .st-ll, .st-out, .st-note { font-size: 11.5px; padding: 3px 8px; border-radius: 999px; }
  .st-ll { background: var(--amber-soft); color: var(--amber-ink); font-weight: 650; }
  .st-out { background: var(--blue-soft); color: var(--blue-ink); }
  .st-note { background: var(--surface-2); color: var(--text-2); }
  .gate { align-self: start; padding: 12px 14px; border-radius: var(--radius-lg); border: 2px dashed var(--line-strong); }
  .gate-h { display: flex; align-items: center; gap: 6px; font: 700 12px/1.3 var(--font-sans); }
  .gate ul { margin: 8px 0 0; padding-left: 18px; font-size: 13px; color: var(--text-2); }
  .pb-changes { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .pb-changes li { display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap; font-size: 14px; }
  @media (max-width: 1100px) { .pbp { grid-template-columns: 1fr; } .st { grid-template-columns: 1fr; } .st-tags { grid-column: 1; } }
  @media (max-width: 760px) { .pv-row { grid-template-columns: 24px minmax(0, 1fr) auto 2ch; } .pv-dots { grid-column: 2 / -1; grid-row: 2; } .pv-sub { margin-left: 36px; } }
</style>
