---
// Level 2: start anywhere. The method's words first (no stages; the smallest start), then what Keia Atlas adds: the
// one explorable, each module On, Connected or Off and the sidebar it makes, and the table of modules. Text from
// docs/keia-method.md (the section is found by its title, src/lib/method.mjs SEC2.modules).
import MethodPage from '../../components/method/MethodPage.astro';
import Section from '../../components/Section.astro';
import ModuleSwitch from '../../components/method/ModuleSwitch.astro';
import { SEC2, md, WORDS, WORDS_FOR, MAPS } from '../../lib/method.mjs';
import { pageBySlug } from './_pages.mjs';
const page = pageBySlug('modules');
const sec = SEC2.modules;
const [lede, ...rest] = sec.paras;
const maps = WORDS_FOR(MAPS.modules);
---
<MethodPage slug="modules" title={sec.title} lede={lede} level={2} num={sec.num} try={page.try}>
  <section class="card pad mp-side" aria-label="Where to start">
    {rest.map((p) => <p set:html={md(p)} />)}
  </section>
  <Section title="In Keia Atlas">
    <div class="g12 top">
      <section class="card pad s-7 mp-pic" aria-labelledby="pic-h">
        <h2 id="pic-h">Switch a module; the sidebar follows</h2>
        <ModuleSwitch />
      </section>
      <section class="card pad s-5" aria-label="What Keia Atlas does">
        <dl class="mp-parts">{sec.parts.map((p) => <div class="mo-part"><dt>{p.label}</dt><dd set:html={md(p.text)} /></div>)}</dl>
      </section>
    </div>
  </Section>
  <Section title="Each module, on its own and with the others on">
    <div class="tablewrap card">
      <table class="mp-table to-cards">
        <thead><tr>{sec.tables[0].head.map((h) => <th>{h}</th>)}</tr></thead>
        <tbody>{sec.tables[0].rows.map((r) => <tr>{r.map((c) => <td set:html={md(c)} />)}</tr>)}</tbody>
      </table>
    </div>
  </Section>
  <Section title="What it maps to">
    <div class="tablewrap card">
      <table class="mp-table to-cards">
        <thead><tr>{WORDS.head.map((h) => <th>{h}</th>)}</tr></thead>
        <tbody>{maps.map((r) => <tr>{r.map((c) => <td set:html={md(c)} />)}</tr>)}</tbody>
      </table>
    </div>
  </Section>
</MethodPage>

<style>
  .method .mo-part { grid-template-columns: minmax(0, 1fr) !important; gap: 4px !important; }
</style>
