---
// One page per idea (Level 2), always in the same order, the card's order: the idea's card from Level 1 first
// (IdeaCard); then the same four lines in full: what it replaces, what you do (with the moves and anything else the
// section says), how you'll know it's working, and what Keia Atlas adds, beside the picture to explore; then why it
// works and its limits; then what it maps to. The method (the first three) comes before the product (the fourth).
// Every word of method text comes from docs/keia-method.md (src/lib/method.mjs).
import MethodPage from '../../components/method/MethodPage.astro';
import Section from '../../components/Section.astro';
import IdeaCard from '../../components/method/IdeaCard.astro';
import ZoomStrip from '../../components/method/ZoomStrip.astro';
import CaptureDemo from '../../components/method/CaptureDemo.astro';
import DrillFrames from '../../components/method/DrillFrames.astro';
import WithDemo from '../../components/method/WithDemo.astro';
import FadeChecklist from '../../components/method/FadeChecklist.astro';
import { IDEAS, LEVEL1, part, moves, md, WORDS, WORDS_FOR, MAPS } from '../../lib/method.mjs';
import { href } from '../../lib/data.mjs';
import { pageBySlug } from './_pages.mjs';

export function getStaticPaths() {
  return IDEAS.map((i) => ({ params: { idea: i.slug } }));
}
const idea = IDEAS.find((i) => i.slug === Astro.params.idea);
const page = pageBySlug(idea.slug);
const instead = part(idea, /^Instead of$/);
const you = part(idea, /^You$/);
const mv = part(idea, /^The moves$/);
const moveList = moves(mv?.text);
const working = part(idea, /^You'll know it's working when$/);
const atlas = part(idea, /^In Keia Atlas$/);
const why = part(idea, /^Why it works$/);
const limits = part(idea, /^Limits$/);
// Anything else the section says ("Urgency when it is real", "Cover", "Progress, never points"...) belongs with what you do.
const known = /^(Instead of|You|The moves|You'll know it's working when|In Keia Atlas|Why it works|Limits)$/;
const more = idea.parts.filter((p) => !known.test(p.label));
const maps = WORDS_FOR(MAPS[idea.slug]);
const step = LEVEL1.story.steps[idea.n - 1];
const PICTURE = {
  'start-from-the-building': { title: 'The zoom: region to port', Comp: ZoomStrip },
  'capture-dont-ask': { title: 'Where each field came from', Comp: CaptureDemo },
  'answer-first': { title: 'The answer, the list, the log', Comp: DrillFrames },
  'own-it-hand-it-on': { title: 'The job moves; the record stays', Comp: WithDemo },
  'learn-as-you-go': { title: 'The same guide, shorter each time', Comp: FadeChecklist },
}[idea.slug];
const Pic = PICTURE.Comp;
---
<MethodPage slug={idea.slug} title={idea.name} lede={idea.summary} level={2} num={`${idea.num} · idea ${idea.n} of 5`} try={page.try}>
  <IdeaCard idea={idea} art />
  {step && (
    <p class="ip-story">In the morning story, this is {step.time}: <span set:html={md(step.text)} /> <a href={href(`/method/#st-${step.time.replace(':', '')}`)}>Read the story</a></p>
  )}
  <Section title="In full, with no software">
    <dl class="mp-parts ip-parts">
      <div><dt>Instead of</dt><dd set:html={md(instead.text)} /></div>
      <div><dt>You</dt><dd set:html={md(you.text)} /></div>
      <div><dt>The moves</dt><dd>{moveList
        ? <ul class="ip-moves">{moveList.map((x) => <li><b>{x.move}</b> <span set:html={md(x.meaning)} /></li>)}</ul>
        : <span set:html={md(mv.text)} />}</dd></div>
      {more.map((p) => <div><dt>{p.label}</dt><dd set:html={md(p.text)} /></div>)}
      <div><dt>You'll know it's working when</dt><dd set:html={md(working.text)} /></div>
    </dl>
  </Section>
  <Section title="In Keia Atlas">
    <div class="g12 top">
      <section class="card pad s-7 mp-pic" aria-labelledby="pic-h">
        <h2 id="pic-h">{PICTURE.title}</h2>
        <Pic />
      </section>
      <div class="card pad s-5 mp-side ip-atlas">
        <p set:html={md(atlas.text)} />
      </div>
    </div>
  </Section>
  <Section title="Why it works, and its limits">
    <dl class="mp-parts">
      <div><dt>Why it works</dt><dd set:html={md(why.text)} /></div>
      <div><dt>Limits</dt><dd set:html={md(limits.text)} /></div>
    </dl>
  </Section>
  <Section title="What it maps to">
    <div class="tablewrap card">
      <table class="mp-table to-cards">
        <thead><tr>{WORDS.head.map((h) => <th>{h}</th>)}</tr></thead>
        <tbody>{maps.map((r) => <tr>{r.map((c) => <td set:html={md(c)} />)}</tr>)}</tbody>
      </table>
    </div>
  </Section>
</MethodPage>

<style>
  .ip-story { margin: 0; font-size: 13.5px; line-height: 1.5; color: var(--text-2); max-width: 100ch; }
  .ip-story a { white-space: nowrap; }
  .ip-moves { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .ip-moves b { font-weight: 600; }
  .ip-atlas p { font-size: 14.5px !important; }
</style>
