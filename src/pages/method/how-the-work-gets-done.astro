---
// Level 2, section 2.8: how the work gets done. The picture is a standing rule and one run of it, step by step,
// with both endings. Then the method's ten rules in full, and the words they map to.
import MethodPage from '../../components/method/MethodPage.astro';
import Section from '../../components/Section.astro';
import RuleRun from '../../components/method/RuleRun.astro';
import { SECTIONS, LEVEL1, md, WORDS, WORDS_FOR, MAPS } from '../../lib/method.mjs';
import { pageBySlug } from './_pages.mjs';
const page = pageBySlug('how-the-work-gets-done');
const sec = SECTIONS['2.8'];
const table = sec.tables[0];
const routine = LEVEL1.routine?.text ?? '';
const lede = routine.split(/(?<=\.)\s/).pop();
const maps = WORDS_FOR(MAPS['how-the-work-gets-done']);
---
<MethodPage slug="how-the-work-gets-done" title={sec.title} lede={lede} level={2} num={sec.num} try={page.try}>
  <div class="g12 top">
    <section class="card pad s-8 mp-pic" aria-labelledby="pic-h">
      <h2 id="pic-h">One rule, one run: a failure is a record, not a mystery</h2>
      <RuleRun />
    </section>
    <section class="card pad s-4 mp-side" aria-labelledby="l1-h">
      <h3 id="l1-h">In one paragraph</h3>
      <p set:html={md(routine)} />
    </section>
  </div>
  <Section title={`The ${table.rows.length} rules`}>
    <div class="tablewrap card">
      <table class="mp-table to-cards">
        <thead><tr>{table.head.map((h) => <th>{h}</th>)}</tr></thead>
        <tbody>{table.rows.map((r) => <tr>{r.map((c) => <td set:html={md(c)} />)}</tr>)}</tbody>
      </table>
    </div>
  </Section>
  <Section title="What it maps to">
    <div class="tablewrap card">
      <table class="mp-table to-cards">
        <thead><tr>{WORDS.head.map((h) => <th>{h}</th>)}</tr></thead>
        <tbody>{maps.map((r) => <tr>{r.map((c) => <td set:html={md(c)} />)}</tr>)}</tbody>
      </table>
    </div>
  </Section>
</MethodPage>
