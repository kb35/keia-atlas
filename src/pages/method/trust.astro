---
// Level 2, section 2.9: why IT can trust it. The picture is still: the record with its eight guarantees around it.
// Then the rows in full, and the standards the record supports (Level 3, section 3.2) that bear on trust.
import MethodPage from '../../components/method/MethodPage.astro';
import Section from '../../components/Section.astro';
import TrustMap from '../../components/method/TrustMap.astro';
import { SECTIONS, STANDARDS, STANDARDS_FOR, md } from '../../lib/method.mjs';
import { pageBySlug } from './_pages.mjs';
const page = pageBySlug('trust');
const sec = SECTIONS['2.9'];
const rows = sec.tables[0].rows;
const std = STANDARDS_FOR(['ISO/IEC 27001', 'ISO/IEC 42001', 'EU AI Act', 'NIS2']);
---
<MethodPage slug="trust" title={sec.title} lede={`${rows.length} guarantees, what each one means, and the standards the evidence supports.`} level={2} num={sec.num} try={page.try}>
  <section class="card pad mp-pic" aria-labelledby="pic-h">
    <h2 id="pic-h">What surrounds the record</h2>
    <TrustMap />
  </section>
  <Section title={`The ${rows.length} guarantees in full`}>
    <div class="tablewrap card">
      <table class="mp-table to-cards">
        <thead><tr><th>Guarantee</th><th>What it means</th></tr></thead>
        <tbody>{rows.map((r) => <tr>{r.map((c) => <td set:html={md(c)} />)}</tr>)}</tbody>
      </table>
    </div>
  </Section>
  <Section title="The standards this evidence supports">
    <div class="mp-prose"><p set:html={md(STANDARDS.intro)} /></div>
    <div class="tablewrap card">
      <table class="mp-table to-cards">
        <thead><tr>{STANDARDS.head.map((h) => <th>{h}</th>)}</tr></thead>
        <tbody>{std.map((r) => <tr>{r.map((c) => <td set:html={md(c)} />)}</tr>)}</tbody>
      </table>
    </div>
  </Section>
</MethodPage>
