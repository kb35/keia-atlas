---
// Level 2, the last section: the problems the method answers (the evidence, placed after the ideas), what each
// costs and where the figure comes from. The picture is four of those figures, each with its source and year, read
// straight from the method's own table (the build stops if a figure is not in the row it claims). No motion: numbers
// are read, not watched.
import MethodPage from '../../components/method/MethodPage.astro';
import Section from '../../components/Section.astro';
import { SEC2, md, plain } from '../../lib/method.mjs';
import { pageBySlug } from './_pages.mjs';

const page = pageBySlug('problems');
const sec = SEC2.problems;
const table = sec.tables[0];
const FIG = [
  { row: 'A console per vendor', n: '4 to 10', label: 'monitoring tools per network team; none surveyed has reached one view' },
  { row: 'Forms that ask', n: '4 h 26 min', label: 'lost per incident reported through the portal, against 1 h 24 min for a walk-in' },
  { row: 'Rooms that fail', n: '75%', label: 'of hybrid meetings hit a technical fault, about 11 minutes each' },
  { row: 'Knowledge that leaves', n: '42%', label: 'of role knowledge is unique to one person' },
].map((f) => {
  const row = table.rows.find((r) => plain(r[0]).startsWith(f.row));
  if (!row || !row[1].includes(f.n)) throw new Error(`problems.astro: "${f.n}" is not in the row "${f.row}" of section ${sec.num}`);
  return { ...f, src: row[2] };
});
// The section's first paragraph says why the table is there: its first sentence is the lede, the rest leads the table.
const lede = (sec.paras[0] ?? '').split(/(?<=\.)\s/)[0];
const why = (sec.paras[0] ?? '').slice(lede.length).trim();
---
<MethodPage slug="problems" title={sec.title} lede={lede} level={2} num={sec.num} try={page.try}>
  <section class="card pad pr-figs" aria-labelledby="pr-h" data-help="method.problems">
    <h2 id="pr-h">Four of the costs, from the table below</h2>
    <ul>
      {FIG.map((f) => <li><b>{f.n}</b><span>{f.label}</span><small>{f.src}</small></li>)}
    </ul>
  </section>
  <Section title={`The ${table.rows.length} problems and what they cost`}>
    {why && <div class="mp-prose pr-why"><p set:html={md(why)} /></div>}
    <div class="tablewrap card">
      <table class="mp-table to-cards">
        <thead><tr>{table.head.map((h) => <th>{h}</th>)}</tr></thead>
        <tbody>{table.rows.map((r) => <tr>{r.map((c) => <td set:html={md(c)} />)}</tr>)}</tbody>
      </table>
    </div>
  </Section>
  <Section title="What the method does not answer">
    <div class="mp-prose">{sec.paras.slice(1).map((p) => <p set:html={md(p)} />)}</div>
  </Section>
</MethodPage>

<style>
  .pr-figs { display: grid; gap: 12px; }
  .pr-why { margin-bottom: 12px; }
  .pr-figs h2 { font: 600 15px/1.3 var(--font-sans); }
  .pr-figs ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gutter); }
  .pr-figs li { display: grid; gap: 4px; align-content: start; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; }
  .pr-figs b { font-size: 30px; line-height: 1; font-weight: 600; font-variant-numeric: tabular-nums; letter-spacing: -.02em; }
  .pr-figs span { font-size: 13px; }
  .pr-figs small { font: 500 11px/1.4 var(--font-mono); color: var(--text-3); }
  @container content (max-width: 899px) { .pr-figs ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @container content (max-width: 459px) { .pr-figs ul { grid-template-columns: minmax(0, 1fr); } }
</style>
