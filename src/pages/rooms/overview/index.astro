---
// The Rooms overview moved to Locations, Overview Like Moved.astro, but it keeps the old
// link's filters (?site=dub&status=problem) and anchor, so drill-downs saved from the old page still land filtered.
import { href } from '../../../lib/data.mjs';
const url = href('/locations/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved to {url}</title>
    <script is:inline define:vars={{ url }}>location.replace(url + location.search + location.hash);</script>
    <meta http-equiv="refresh" content={`0;url=${url}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={url} />
  </head>
  <body><p>This page moved. <a href={url}>Go to its new place</a>.</p></body>
</html>
