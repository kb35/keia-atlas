---
// One incident: the job record (design notes; decision 0024). The ticket stays in ServiceNow; this
// page is what Keia Atlas knows about it and what can be done from here.
//   band      the number, the priority with the reason it was proposed (changeable, the reason kept), the state, a
//             major incident's commander; the answer; four figures; the With chip and the one action beside it
//   summary   the lifecycle with the response target or the default owner clock; the space drawn with the unit lit
//             beside a sticky panel of the unit's facts; on a P1 or P2, "What do you think it is?" before the
//             suggestion (cognitive forcing); Do: the verbs the standing rules declare, and the job's own verbs
//   record    the timeline (People, Rules, Connectors, Changes), then wiring, every device, related work, the ticket
//   raw       the audit log entries for this job
// Everything made here (Take, the call, a rule's run, Resolve) goes through the live layer, so every window sees it.
// A story the demo plays from the start (the 07:52 fault) is held at its own moment and says so.
import Shell from '../../layouts/Shell.astro';
import Icon from '../../components/Icon.astro';
import DeviceArt from '../../components/DeviceArt.astro';
import DeviceGlyph from '../../components/DeviceGlyph.astro';
import RoomScene from '../../components/RoomScene.astro';
import Wiring from '../../components/Wiring.astro';
import PageBand from '../../components/PageBand.astro';
import SidePanel from '../../components/SidePanel.astro';
import DetailTabs from '../../components/DetailTabs.astro';
import HealthGlyph from '../../components/HealthGlyph.astro';
import WithChip from '../../components/WithChip.astro';
import HowCard from '../../components/HowCard.astro';
import Timeline from '../../components/Timeline.astro';
import RulesData from '../../components/RulesData.astro';
import LiveBar from '../../components/LiveBar.astro';
import OpenHere from '../../components/OpenHere.astro';
import Section from '../../components/Section.astro';
import { recHere } from '../../lib/vt.mjs';
import {
  incidents, classes, projects, labTests, INC_STATE, STAGE_LABEL, LOC_LABEL, className, modelName, findTask,
  standardFirmware, advisoriesFor, ADV_LEVEL, incidentPath, href, fmtDate, DEMO_TODAY,
} from '../../lib/data.mjs';
import { incidentView, incidentList, aroundIncident, shortRole, when, spoken, HOLD_LABEL, RES_LABEL, PRIORITY_LABEL, SOURCE_LABEL } from '../../lib/incidents.mjs';
import { person, PEOPLE } from '../../lib/demo.mjs';
import { OWN, HISTORY } from '../../lib/home.mjs';
import { SERVICES } from '../../lib/services.mjs';
import { RULES, actionsFor, clockFor, serviceOf, serviceOwner, runById, runOfNote, cardFor, CHANGES, changePath, rulePath, PEOPLE_MAP, personName, firstName, LOG, LOG_PATH } from '../../lib/rules-view.mjs';
import { evidenceStrength, REVERSAL_WORD, rolledBack, RESPONSE_MIN } from '../../lib/rules.mjs';
import { howTrigger } from '../../lib/howcard.mjs';
import { answerFor, bookingWords, impactLine, handoffs } from '../../lib/incidentcore.mjs';
// Known errors (decision 0029): the known errors this ticket looks like, and a repeat across the fleet it is part of.
import { matchesForIncident, clusters as kiClusters, draftForCluster, CONFIDENCE as KI_CONF } from '../../lib/knownissues-view.mjs';
// On call (the overlooked items, #6): who answers out of hours in this office's region now, in the band.
import { onCallForSite } from '../../lib/oncall-view.mjs';
// Live event priority (src/lib/events.mjs): an incident in an event room during an event is P1, "live client briefing".
import { liveIncident } from '../../lib/events-view.mjs';

export function getStaticPaths() {
  return Object.keys(incidents).map((number) => ({ params: { number } }));
}
const v = incidentView(incidents[Astro.params.number]);
const { inc, space: s, site, pos, unit } = v;
const NOW = v.now;
const item = `inc:${inc.number}`;
const kiMatches = matchesForIncident(inc.number);
const kiRepeat = kiClusters.find((c) => c.incidents.some((i) => i.number === inc.number)) ?? null;
const cls = pos ? classes[pos.cls] : null;
const isRoom = inc.subject.kind === 'room';
const assigned = inc.keia_atlas.assigned ? person(inc.keia_atlas.assigned) : null;
const override = inc.priority_override ?? null;
const overrideBy = override ? person(override.by) : null;
const svc = serviceOf(v), svcOwner = serviceOwner(svc), svcName = SERVICES[svc]?.name ?? 'AV';
const OC = onCallForSite(s.site, NOW);   // at the incident's own moment, in the office's time

// Units at the same desk or kit as the device (or every unit in the room).
const prefix = inc.position?.match(/^([a-z]+-\d+\/)/)?.[1] ?? null;
const roomPositions = [...s.positions.filter((p) => !prefix || p.position.startsWith(prefix)), ...s.olderKit];
const openHere = incidentList.filter((o) => o.open && o.inc.room === s.id && o.inc.number !== inc.number);

// Health: each system the device profile says must know about the device, with what Keia Atlas found there.
const FROM = { 'Device management': 'device_management', Monitoring: 'monitoring', Calendar: 'room_booking', 'Room booking': 'room_booking', 'Asset register': 'inventory', 'Keia Atlas': 'keia_atlas' };
const PLAT = { keia_atlas: 'Keia Atlas record', inventory: 'Asset register', dhcp_dns: 'Addresses and DNS', device_management: 'Device management', room_booking: 'Room booking', monitoring: 'Monitoring' };
const RANK = { ok: 0, warn: 1, bad: 2 };
const WORD = { ok: 'Fine', warn: 'To review', bad: 'Fault' };
const platformKeys = cls ? [...new Set([...Object.keys(cls.platforms ?? {}), ...inc.keia_atlas.evidence.map((e) => FROM[e.from]).filter(Boolean)])] : [];
const health = cls ? platformKeys.map((k) => {
  const ev = inc.keia_atlas.evidence.filter((e) => FROM[e.from] === k);
  const level = ev.reduce((w, e) => (RANK[e.level] > RANK[w] ? e.level : w), 'ok');
  return { k, name: PLAT[k] ?? k, level, word: ev.length ? WORD[level] : 'No problem seen', says: ev.map((e) => e.says).join(' ') };
}) : [];
const std = pos?.model ? standardFirmware(pos.model) : null;
const fwReported = inc.keia_atlas.firmware ?? null;
const fwLevel = std && fwReported ? (fwReported === std.version ? 'ok' : 'warn') : null;
const symptom = cls && inc.keia_atlas.symptom ? cls.discrimination?.[inc.keia_atlas.symptom] : null;
const words = (k) => k.replace(/_/g, ' ').replace(/^./, (c) => c.toUpperCase());
const worst = inc.keia_atlas.evidence.reduce((w, e) => (RANK[e.level] > RANK[w] ? e.level : w), 'ok');
const facts = inc.keia_atlas.facts ?? null;

// Standing rules: what the Do section offers, the run that raised this job, the default owner clock.
const actions = v.open ? actionsFor(inc, { now: NOW }) : [];
const raised = inc.raised_by ? runById(inc.raised_by.run) : null;
const clock = v.open ? clockFor(v, { now: NOW }) : null;
const taken = inc.history.find((h) => h.state === 'in-progress') ?? null;
const target = RESPONSE_MIN[inc.priority] ?? 480;
const targetWords = target < 60 ? `${target} min` : target % 60 === 0 ? `${target / 60} working hours` : `${spoken(target)}`;
const minutesTo = (a, b) => Math.round((Date.parse(`${b}Z`) - Date.parse(`${a}Z`)) / 60000);

// The call before the suggestion (P1 and P2), and the suggestion's evidence strength: a count, never a percentage.
const diag = inc.keia_atlas.diagnosis ?? null;
const strength = diag ? evidenceStrength(diag.signals, diag.suggests) : null;
const fold = !!diag && inc.priority <= 2 && v.open;
const FIT = { agrees: { g: 'fine', w: 'Agrees' }, differs: { g: 'review', w: 'Differs' }, 'not-checked': { g: 'stale', w: 'Not checked' } };

// Who has it, as the record was built (the live layer's changes are replayed on top in the browser).
const own = OWN[item] ?? (inc.state === 'resolved' ? { s: 'done', to: inc.keia_atlas.assigned ?? null, kind: 'person', at: v.closed } : null);
const chipHistory = HISTORY[item] ?? [];
const jobOwner = own?.to ?? null;
const handoffCount = handoffs(inc.history.filter((h) => h.by).map((h) => ({ to: h.by })));
const lastState = [...inc.history].reverse().find((h) => h.state);
const booking = inc.booking ?? null;
const hmOf = (t) => String(t).slice(11, 16);
const resolvedAt = inc.state === 'resolved' ? v.closed : null;
const IMPACT = inc.state === 'resolved'
  ? (booking ? impactLine({ spaceNumber: s.number, spaceName: s.name, booking, resolvedAt }) : `${RES_LABEL[v.resolution?.code] ?? 'Closed'} · took ${spoken(v.age)}`)
  : null;
const runState = raised ? { result: raised.run.result, at: raised.run.at, back: rolledBack(raised.rule, raised.run), rule: { name: raised.rule.name } } : null;
const LIVE = liveIncident(inc.number);
const ANSWER = answerFor({ own, resolved: resolvedAt ? { at: resolvedAt } : null, impact: IMPACT, booking, reason: inc.priority_reason, run: runState, major: inc.major, raisedBy: raised?.rule.name }, PEOPLE_MAP);

const NUMBERS = [
  { n: spoken(v.age), label: v.open ? 'Open' : 'Took', id: 'age' },
  { n: handoffCount, label: handoffCount === 1 ? 'Hand-off' : 'Hand-offs', id: 'handoffs' },
  booking ? { n: hmOf(booking.at), label: `Booking, ${booking.people} people` } : { n: inc.keia_atlas.evidence.length, label: inc.keia_atlas.evidence.length === 1 ? 'Finding' : 'Findings', to: '#evidence' },
];
const fromTicket = [...inc.history].reverse().find((h) => h.source && h.source !== 'keia_atlas');
const SOURCE = fromTicket ? { from: SOURCE_LABEL[fromTicket.source] ?? fromTicket.source, ref: inc.number, at: fromTicket.at } : undefined;
const stateTone = { new: 'new', 'in-progress': 'prog', 'on-hold': 'hold', resolved: 'done' };

// The timeline (design notes): this job's own story, the rules that ran on it, and the changes to its unit and space.
const how = (runId) => { const c = runId ? cardFor(runId, { jobOwner }) : null; return c ? howTrigger(c, { log: href(LOG_PATH) }) : null; };
const ruleWho = (id) => { const r = RULES[id]; return r ? `rule: ${r.name} (${firstName(r.owner)})` : 'Keia Atlas'; };
const TL = [];
inc.history.forEach((h, i) => {
  const runId = runOfNote(inc, i) ?? h.run ?? null;
  const rid = h.rule ?? (runId?.startsWith('M-') ? 'match-tickets' : null);
  if (h.source === 'keia_atlas' && (rid || !h.state)) { TL.push({ at: h.at, order: i, kind: 'rule', who: ruleWho(rid ?? 'match-tickets'), what: h.note ?? 'Added to the record', how: how(runId), state: h.state === 'new' && inc.raised_by ? 'fault' : undefined, stateWords: h.state === 'new' && inc.raised_by ? 'Unable to complete' : undefined }); return; }
  const who = h.by ? personName(h.by) : h.person ?? SOURCE_LABEL[h.source];
  const src = `${SOURCE_LABEL[h.source]} · ${inc.number}`;
  if (h.state === 'new') TL.push({ at: h.at, order: i, kind: 'connector', who, what: `Came in${h.note ? `: ${h.note}` : ''}`, src });
  else if (h.state === 'in-progress') TL.push({ at: h.at, order: i, kind: 'person', who, what: `${h.note ? `Took it: ${h.note}` : 'Took it'}`, src, state: 'progress' });
  else if (h.state === 'on-hold') TL.push({ at: h.at, order: i, kind: 'person', who, what: `Waiting on ${(HOLD_LABEL[h.hold_reason] ?? 'something').replace(/^Waiting for /, '').toLowerCase()}${h.note ? `: ${h.note}` : ''}`, src, state: 'review' });
  else if (h.state === 'resolved') TL.push({ at: h.at, order: i, kind: 'person', who, what: `Resolved, ${RES_LABEL[h.resolution.code].toLowerCase()}: ${h.resolution.notes}`, src, state: 'fine' });
  else TL.push({ at: h.at, order: i, kind: h.by ? 'person' : 'connector', who, what: h.note ?? 'Note', src });
});
TL.push({ at: inc.opened, order: 0.5, kind: 'rule', who: 'Keia Atlas', what: `Proposed P${inc.priority_proposed}${inc.priority_reason ? `: ${inc.priority_reason}` : ', from impact and urgency'}` });
if (override) TL.push({ at: override.at, kind: 'person', who: overrideBy?.name ?? override.by, what: `Changed the priority to P${override.priority}: ${override.reason}` });
if (inc.major) TL.push({ at: inc.major.at, kind: 'person', who: 'Keia Atlas', what: `Declared a major incident: ${inc.major.reason}. Commander: ${personName(inc.major.commander)}`, state: 'fault', stateWords: 'Major incident' });
for (const c of CHANGES.filter((c) => (c.space && c.space === s.id) || (c.incidents ?? []).includes(inc.number))) {
  if (c.run && c.incidents?.includes(inc.number)) continue;   // the run itself is already on the timeline
  TL.push({ at: c.at, kind: 'change', who: personName(c.owner), what: `${c.id}: ${c.title}`, href: href(changePath(c.id)) });
}
for (const r of aroundIncident(v)) {
  if (r.kind === 'install') TL.push({ at: r.at, kind: 'change', who: 'Asset register', what: r.text, sub: r.sub });
  if (r.kind === 'task' && r.at <= NOW) TL.push({ at: r.at, kind: 'change', who: r.prj.id, what: `${r.t.id}: ${r.text}`, href: href(`/projects/${r.prj.id.toLowerCase()}/`) });
}

// Tabs below the timeline.
const related = (inc.keia_atlas.related ?? []).map((r) => ({ id: r, f: findTask(r) }));
const roomProjects = Object.values(projects).filter((p) => p.spaces.some((x) => x.space === s.id));
const labs = pos?.model ? Object.values(labTests).filter((l) => l.models?.includes(pos.model)) : [];
const advs = pos?.model ? advisoriesFor(pos.model) : [];
const relatedCount = related.length + roomProjects.length + labs.length + advs.length + openHere.length;
const logHere = LOG.filter((e) => e.item === item || (e.run && inc.history.some((h) => h.run === e.run)));
const TABS = [
  { id: 'wiring', label: 'Wiring' },
  { id: 'devices', label: prefix ? `Every device in the ${prefix.startsWith('kit') ? 'kit' : 'desk'}` : 'Every device in the space', count: roomPositions.length },
  { id: 'related', label: 'Related work', count: relatedCount },
  { id: 'ticket', label: 'Ticket details' },
];
const taskHref = (prj) => href(`/projects/${prj.id.toLowerCase()}/`);
const incHref = (n) => href(incidentPath(n));
const people = PEOPLE.filter((p) => !p.vendor).map((p) => ({ id: p.id, name: p.name }));
const PAGE = {
  number: inc.number, item, base: own ?? null, held: inc.keia_atlas.held_at ?? null, opened: inc.opened, open: v.open, state: inc.state,
  priority: inc.priority, proposed: inc.priority_proposed, reason: inc.priority_reason ?? null, booking, today: DEMO_TODAY,
  space: { number: s.number ?? null, name: s.name }, svcOwner, svcName, due: clock?.due ?? null, target: targetWords,
  actions: actions.map((a) => ({ rule: a.rule.id, target: a.target, verb: a.verb, again: a.again?.id ?? null, ok: a.check.ok, why: a.check.why })),
  fold, raised: runState, major: inc.major ?? null, people, device: v.deviceTitle ?? v.roomTitle,
};
---
<Shell about={{ kind: 'incident', label: `${inc.number} ${inc.short_description}`, to: v.href }} title={`${inc.number} ${inc.short_description}`} section="incidents" minStage={2}
  crumbs={[{ label: 'Incidents', to: '/incidents/' }, { label: site.name, to: `/incidents/?site=${s.site}` }, { label: v.roomTitle, to: `/rooms/${s.id}/` }, { label: inc.number }]}>
  <PageBand overline="Incident" title={inc.short_description} answer={ANSWER} source={SOURCE} numbers={NUMBERS} sim>
    <Fragment slot="overline">
      <span class="mono ib-no" data-help="incident.number" {...recHere(inc.number)}>{inc.number}</span>
      {LIVE && <a class="pill ib-live" href={href(LIVE.to)} data-feature="events" data-help="incident.live-event" title={`Opened in an event room while ${LIVE.eventTitle} was running, so it is P1`}>P1 · {LIVE.reason}, {LIVE.event}</a>}
      <span class="prio-w" data-prio-host>
        <button type="button" class={`prio-b p-${inc.priority}${inc.major ? ' is-major' : ''}`} data-prio-open data-help="incident.priority" aria-haspopup="dialog" aria-expanded="false" title={`Priority ${inc.priority}: ${PRIORITY_LABEL[inc.priority]}. Change it, with a reason`}>
          <b data-prio-n>P{inc.priority}</b>
          <span class="prio-why" data-prio-why data-help={override ? 'incident.priority-changed' : undefined}>{override ? `changed from P${inc.priority_proposed}: ${override.reason}` : `proposed${inc.priority_reason ? `: ${inc.priority_reason}` : ''}`}</span>
          <svg class="prio-c" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <form class="prio-f" data-prio-form hidden data-help="incident.priority-change">
          <p class="prio-f-h">Change priority</p>
          <div class="prio-seg" role="radiogroup" aria-label="Priority">
            {[1, 2, 3, 4].map((n) => <label><input type="radio" name="p" value={n} checked={n === inc.priority} /><span>P{n}</span></label>)}
          </div>
          <label class="jf-f"><span>Why? The reason is kept</span><input name="why" required maxlength="120" autocomplete="off" placeholder="What the proposal could not know" /></label>
          <div class="jf-act"><button type="submit" class="btn small primary">Change</button><button type="button" class="btn small ghost" data-prio-cancel>Cancel</button></div>
        </form>
      </span>
      <span data-help="incident.state" class={`ist ist-${stateTone[inc.state]}`} data-ist>{INC_STATE[inc.state]}{v.reopened && inc.state !== 'resolved' ? ', reopened' : ''}</span>
      <span class="ib-major" data-major hidden={!inc.major} data-help="incident.major">Major incident · commander <b data-major-who>{inc.major ? personName(inc.major.commander) : ''}</b></span>
      {v.held && <span class="ib-held" data-help="incident.held" title="The demo holds this story at the moment it began, so it can be played from the start">Held at {hmOf(NOW)}</span>}
      {OC?.person && <a class="ib-oncall" href={href('/team/#on-call')} data-feature="oncall" data-help="incident.oncall" title={`${OC.name}: ${OC.person.name} until ${OC.untilFull}, backup ${OC.backup?.name}. ${OC.ooh ? 'Out of hours now, so they answer first.' : 'In office hours the office technician answers first.'}`}>On call: <b>{OC.person.name}</b> until {OC.until}</a>}
    </Fragment>
    <div slot="action" class="ib-own" data-job-owner={jobOwner ?? ''} data-help="incident.owner">
      <WithChip own={own} item={item} history={chipHistory} />
      <span class="ib-verb" data-ib-verb></span>
    </div>
  </PageBand>

  <div class="content inc-page" data-inc={JSON.stringify(PAGE)}>
    <RulesData />
    <HowCard />
    <!-- The lifecycle, and beside it the response target or, while nobody has it, the default owner clock. -->
    <div class="lc-row">
      <ol class="lc" data-help="incident.lifecycle" aria-label="Lifecycle" data-lc>
        {v.steps.list.map((st, i) => (
          <li class:list={['lc-step', `lc-${stateTone[st.state]}`, { now: i === v.steps.list.length - 1, reopen: st.reopen }]} title={st.note ?? undefined}>
            {st.reopen && <span class="lc-reopen" title="Reopened: it went back from Resolved to In progress">Reopened</span>}
            <span class="lc-mark" aria-hidden="true">
              {st.state === 'on-hold' ? <svg viewBox="0 0 24 24" width="14" height="14"><rect x="6" y="5" width="4" height="14" rx="1" fill="currentColor" /><rect x="14" y="5" width="4" height="14" rx="1" fill="currentColor" /></svg>
                : st.state === 'resolved' ? <Icon name="check" size={14} /> : <span class="lc-dot"></span>}
            </span>
            <span class="lc-body">
              <b>{st.label}</b>
              <small>{when(st.at)} · {st.who}</small>
              {st.holdLabel && <small class="lc-extra">{st.holdLabel} · {spoken(st.minutes)}{!st.until ? ' so far' : ''}</small>}
              {st.resolution && <small class="lc-extra">{RES_LABEL[st.resolution.code]}</small>}
              {!st.holdLabel && !st.resolution && st.state !== 'resolved' && <small class="lc-dur">{spoken(st.minutes)}{!st.until ? ' so far' : ''}</small>}
            </span>
          </li>
        ))}
        {v.steps.ahead.map((st) => (
          <li class={`lc-step ahead lc-${stateTone[st.state]}`} data-lc-ahead={st.state}><span class="lc-mark" aria-hidden="true"><span class="lc-dot"></span></span><span class="lc-body"><b>{st.label}</b><small data-lc-when>Not yet</small></span></li>
        ))}
      </ol>
      <p class="clock" data-clock data-help="incident.clock" data-state={clock?.state ?? (taken ? 'taken' : 'done')}>
        {clock?.state === 'running' && <><HealthGlyph state="progress" size={16} title="The default owner clock is running" /><span><b data-clock-left>{spoken(clock.left)}</b> to take it · <span data-clock-words>{clock.words}</span></span></>}
        {clock?.state === 'passed' && <><HealthGlyph state="review" size={16} title="Went to the service owner" /><span data-clock-words>{clock.words}</span></>}
        {(clock?.state === 'taken' || (!clock && taken)) && <><HealthGlyph state="fine" size={16} title="Taken within the target" /><span>Response target {targetWords} · taken in {minutesTo(inc.opened, taken.at)} min</span></>}
        {!clock && !taken && <><HealthGlyph state="fine" size={16} title="Closed" /><span>Response target {targetWords}</span></>}
      </p>
    </div>

    <div class="g12 top">
      <section class="card ip-draw s-7 stick" aria-label={isRoom ? 'The space' : `The space, with ${v.deviceTitle} lit`}>
        <header class="ip-h" data-help="incident.picture">
          <h2>{v.roomTitle}</h2>
          <span class="faint">{s.type.profile.name} · {isRoom ? 'the whole space' : `${v.role} lit`}</span>
          <a class="aside" href={href(`/rooms/${s.id}/`)}>Space page <Icon name="arrow" size={14} /></a>
        </header>
        <RoomScene option={s.option} type={s.space_type} fitted={s.fitted} space={s} uid={`inc-${inc.number}`} highlight={v.sceneKey ? [v.sceneKey] : []} tone={v.open ? 'bad' : null} />
      </section>

      <SidePanel class="s-5 ip-side" title={isRoom ? 'The whole space' : 'The unit'} meta={isRoom ? `${roomPositions.length} devices` : (pos.model ? modelName(pos.model) : className(pos.cls))}>
        <div class="ip-body">
        {isRoom ? (
          <header class="dc-head" data-help="incident.device">
            <span class="dc-art space"><Icon name="room" size={40} /></span>
            <span class="dc-id"><b>Whole space</b><small>{roomPositions.length} devices · {s.type.profile.name}</small><small class="mono">{s.id}</small></span>
          </header>
        ) : (
          <header class="dc-head" data-help="incident.device">
            <span class="dc-art"><DeviceArt model={pos.model} cls={pos.cls} small /></span>
            <span class="dc-id">
              <b class="dc-name"><span data-unit-glyph><HealthGlyph state={v.open ? (worst === 'bad' ? 'fault' : worst === 'warn' ? 'review' : 'fine') : 'fine'} size={16} word={v.open ? (worst === 'bad' ? 'Offline' : worst === 'warn' ? 'To review' : 'Fine') : 'Back in service'} /></span></b>
              <span class="dc-t">{v.deviceTitle}</span>
              <small>{pos.model ? <a href={href(`/models/${pos.model}/`)}>{modelName(pos.model)}</a> : `${className(pos.cls)}, model set per project`}</small>
              <small class="mono dc-tags">{pos.hostname && <><span>{pos.hostname}</span> · </>}<span>{unit.asset_tag}</span></small>
              <a class="dc-open" href={href(`/device/?tag=${unit.asset_tag}`)}>Device page <Icon name="arrow" size={13} /></a>
            </span>
          </header>
        )}

        {facts && (
          <dl class="uf" data-help="incident.facts">
            {facts.map((f) => (
              <div class="uf-r"><dt>{f.label}</dt><dd>{f.level && <HealthGlyph state={f.level} size={12} title={WORD[f.level]} />}<span>{f.to ? <a href={href(f.to)}>{f.value}</a> : f.value}</span></dd></div>
            ))}
            {std && fwReported && <div class="uf-r"><dt>Firmware</dt><dd><HealthGlyph state={fwLevel === 'ok' ? 'fine' : 'review'} size={12} title={fwLevel === 'ok' ? 'On the standard' : 'Doesn’t match'} /><span><span class="mono">{fwReported}</span> · standard {std.version.replace(/\.\d{6}$/, '')}{fwLevel !== 'ok' && ', Doesn’t match'}</span></dd></div>}
          </dl>
        )}

        <section class="dc-sec" id="evidence">
          <h3 data-help="incident.evidence">What the systems say</h3>
          <ul class="ev">
            {inc.keia_atlas.evidence.map((e) => <li class={`ev-${e.level}`}><HealthGlyph state={e.level} size={12} title={WORD[e.level]} /><span><b>{e.from}</b>{e.says}</span></li>)}
          </ul>
        </section>

        {kiMatches.length > 0 && (
          <section class="dc-sec" data-help="incident.known-issue">
            <h3>Looks like a known error</h3>
            {kiMatches.map((m) => <p class="dc-sym"><a href={href(m.issue.path)}><span class="mono">{m.issue.ref ?? m.issue.id}</span> {m.issue.title}</a>: {KI_CONF[m.confidence].toLowerCase()}, {m.issue.maker}.{m.issue.workaround ? ` Workaround: ${m.issue.workaround.text}` : ''}</p>)}
          </section>
        )}
        {kiRepeat && (
          <section class="dc-sec" data-help="incident.repeat">
            <h3>Part of a repeat across the fleet</h3>
            <p class="dc-sym">{kiRepeat.why}, with no known error. <a href={href(draftForCluster(kiRepeat.key).path)}>The case for the manufacturer</a> · <a href={href('/known-issues/#needs-your-decision')}>Known errors</a></p>
          </section>
        )}

        {!facts && !isRoom && (
          <section class="dc-sec">
            <h3 data-help="incident.health">Health checks <small class="faint">when Keia Atlas matched the ticket</small></h3>
            <ul class="dc-health">
              {health.map((hc) => <li title={hc.says || undefined}><HealthGlyph state={hc.level} size={12} title={hc.word} /><span>{hc.name}</span><small class={`w-${hc.level}`}>{hc.word}</small></li>)}
              {std && (
                <li title={fwReported ? `Device management reported ${fwReported}` : 'Device management did not report a version for this ticket'}>
                  <HealthGlyph state={fwLevel ?? 'off'} size={12} title={fwLevel === 'ok' ? 'on the standard' : fwLevel ? 'behind the standard' : 'not reported'} /><span>Firmware <span class="mono">{fwReported ?? 'not reported'}</span></span>
                  <small class={fwLevel ? `w-${fwLevel}` : ''}>{fwLevel === 'ok' ? 'Standard' : fwLevel === 'warn' ? `Standard is ${std.version}` : `Standard ${std.version}`}</small>
                </li>
              )}
            </ul>
          </section>
        )}
        {isRoom && (
          <section class="dc-sec">
            <h3>Devices in the space</h3>
            <ul class="dc-health">
              {roomPositions.map((p) => <li><HealthGlyph state={v.open ? 'fault' : 'fine'} size={12} title={v.open ? 'offline' : 'back online'} /><span>{(p.role ?? className(p.cls)).replace(/:.*$/, '')}</span><small>{v.open ? 'Offline' : 'Back online'}</small></li>)}
            </ul>
          </section>
        )}
        <section class="dc-sec">
          <h3 data-help="incident.next">Next, from the guide</h3>
          {symptom && <p class="dc-sym"><a href={href(`/profiles/${pos.cls}/`)}>{words(inc.keia_atlas.symptom)}</a>: first check {PLAT[symptom.first_check] ?? words(symptom.first_check)}. Likely: {symptom.likely_causes.join(', ')}.</p>}
          <ol class="dc-next">{inc.keia_atlas.next.map((n) => <li>{n}</li>)}</ol>
        </section>
        {inc.keia_atlas.work_note && v.open && (
          <section class="dc-sec dc-note" data-help="incident.worknote" data-note>
            <h3>Work note for ServiceNow</h3>
            <p class="mono" data-note-text>{inc.keia_atlas.work_note}</p>
            <p class="dc-note-act"><button type="button" class="btn small primary" data-note-send>Approve and add to the ticket</button><span class="faint">Goes on the ticket as a work note from you.</span></p>
            <p class="dc-note-done" data-note-done hidden role="status"><Icon name="check" size={14} /><span>Added to the ticket (demo: nothing was sent).</span><button type="button" class="linkish" data-note-undo>Undo</button></p>
          </section>
        )}
        {inc.keia_atlas.captured_fix && <blockquote class="t-fix" data-help="incident.fix"><span class="t-fix-h">Fix captured</span>{inc.keia_atlas.captured_fix}</blockquote>}
        <p class="dc-match" data-help="incident.matched"><Icon name="link" size={13} /><span><b>Matched by</b> {inc.keia_atlas.matched_by}</span></p>
        </div>
      </SidePanel>
    </div>

    {diag && (
      <Section title="What do you think it is?" id="diagnosis" aside={fold ? 'P1 and P2: your call first, then the suggestion' : 'The suggestion, from the evidence'} help="incident.diagnosis">
        <div class="card pad dx" data-dx data-fold={fold ? 'true' : 'false'}>
          {fold && (
            <form class="dx-ask" data-dx-ask>
              <label class="dx-l" for={`dx-${inc.number}`}>Say what you think it is before you read the suggestion. It keeps the diagnosis with people.</label>
              <div class="dx-row">
                <input id={`dx-${inc.number}`} name="call" maxlength="120" autocomplete="off" placeholder="PoE dropped, a cable, the firmware…" />
                <button type="submit" class="btn small primary">Save my call</button>
                <button type="button" class="btn small ghost" data-dx-unsure>Not sure yet</button>
              </div>
            </form>
          )}
          <p class="dx-mine" data-dx-mine hidden><span class="dx-k">Your call</span> <b data-dx-text></b> <span class="faint" data-dx-when></span></p>
          <div class="dx-open" data-dx-open hidden={fold}>
            <p class="dx-s"><span class="dx-k">Suggestion</span> <b>{strength.words}</b>{strength.notChecked.length > 0 && <span class="faint"> · not checked: {strength.notChecked.join(', ').toLowerCase()}</span>}</p>
            <ul class="dx-sig">
              {diag.signals.map((g) => <li><HealthGlyph state={FIT[g.fits].g} size={12} title={FIT[g.fits].w} /><span>{g.says}</span><small>{FIT[g.fits].w}</small></li>)}
            </ul>
            {diag.unlike && <p class="dx-un">{diag.unlike}</p>}
            {diag.ai && <p class="dx-ai">{diag.ai}</p>}
          </div>
        </div>
      </Section>
    )}

    {v.open && (
      <Section title="Do" id="do" aside={actions.length ? 'Standing rules declare their verbs; the job has its own' : 'The job’s own verbs'} help="incident.do">
        <div class="card pad do" data-do>
          {actions.map((a) => (
            <div class="do-r" data-do-rule={a.rule.id} data-do-target={a.target} data-do-again={a.again?.id}>
              {a.again ? (
                <>
                  <div class="do-main">
                    <p class="do-pre" data-do-pre><label><input type="checkbox" data-do-fixed /> <span>The cause is fixed: {a.again.why?.split(':')[1]?.split('.')[0]?.trim() || 'what stopped it'} is put right in the tool</span></label></p>
                    <button type="button" class="btn primary do-go" data-do-go data-verb="run-rule" disabled>Run again</button>
                    <span class="do-state" data-do-state role="status" aria-live="polite"></span>
                  </div>
                  <p class="do-meta"><a href={href(rulePath(a.rule.id))}>{a.rule.name}</a> · owner {personName(a.rule.owner)} · {REVERSAL_WORD[a.rule.reversal.kind]} · <span data-do-who>{firstName(a.rule.owner)}, the rule’s owner, or whoever has the job can run it again</span></p>
                </>
              ) : (
                <>
                  <div class="do-main">
                    <button type="button" class="btn primary do-go" data-do-go data-verb="run-rule" disabled={!a.check.ok}>{a.verb}</button>
                    <span class="do-state" data-do-state role="status" aria-live="polite"></span>
                  </div>
                  <p class="do-meta"><a href={href(rulePath(a.rule.id))}>{a.rule.name}</a> · owner {personName(a.rule.owner)} · {a.rule.reversal.kind === 'none' ? 'reversible: it ends as it started' : REVERSAL_WORD[a.rule.reversal.kind]} · cap {a.rule.caps.per_wave} {a.rule.caps.per_wave === 1 ? 'unit' : 'units'}</p>
                  <ul class="do-checks" aria-label="Checked before it runs">
                    {a.check.checks.filter((c) => c.id !== 'halt').map((c) => <li><HealthGlyph state={c.ok ? 'fine' : 'fault'} size={12} title={c.ok ? 'Holds' : 'Does not hold'} /><span>{c.words}</span></li>)}
                  </ul>
                </>
              )}
            </div>
          ))}
          <div class="do-job" data-do-job>
            <div class="do-verbs" data-do-verbs></div>
            <p class="do-hint faint" data-do-hint></p>
            <div class="do-edit" data-do-edit></div>
          </div>
        </div>
      </Section>
    )}

    <OpenHere kind="job" layer="record" />
    <Section title="Timeline" id="timeline" aside="Every event: who, what, when and where it came from" help="timeline">
      <Timeline entries={TL} today={DEMO_TODAY} id={`tl-${inc.number}`} label="Timeline" />
    </Section>

    <DetailTabs tabs={TABS} label="More about this incident">
        <div slot="wiring">
          <Wiring option={s.option} fitted={s.fitted} heading={isRoom ? 'Wiring' : `Wiring, with the ${v.role.toLowerCase()}'s path lit`} note={isRoom ? 'Hover a device to light its path.' : `Everything its signal passes through is lit. ${prefix ? `The same at every ${prefix.startsWith('kit') ? 'kit' : 'desk'}.` : ''}`} highlight={v.wireNode ? [v.wireNode] : []} />
        </div>

        <div slot="devices">
          <div class="list ip-devs">
            {roomPositions.map((p) => {
              const u = p.current ?? p.units[0];
              const here = p.position === inc.position;
              const other = openHere.filter((o) => o.inc.position === p.position);
              return (
                <a class:list={['row ip-dev-row', { 'is-subject': here }]} href={href(`/device/?tag=${u.asset_tag}`)}>
                  <span class="glyph"><DeviceGlyph cls={p.cls} /></span>
                  <span>
                    <span class="name">{p.older ? p.role : `${shortRole(p)}${p.position.includes('#') ? ` ${p.position.split('#')[1]}` : ''}`}{here && <span class="subj-tag">This incident</span>}</span>
                    <span class="sub">{p.model ? modelName(p.model) : 'Model set per project'}{p.equipment?.location ? ` · ${LOC_LABEL[p.equipment.location]}` : ''}</span>
                    <span class="sub mono faint">{p.hostname ? `${p.hostname} · ` : ''}{u.serial} · {u.asset_tag}</span>
                  </span>
                  <span class="end">
                    {other.map((o) => <span class="rc-st">{o.inc.number}</span>)}
                    <span class={`pill ${u.stage}`}>{STAGE_LABEL[u.stage]}</span>
                  </span>
                </a>
              );
            })}
          </div>
        </div>

        <div slot="related">
          {relatedCount === 0 && <p class="ip-empty">No linked work, projects or Lab tests for this space or device. <a href={href('/projects/')}>See every project</a></p>}
          <div class="rw-grid" id="related">
            {related.map(({ id, f }) => f && (
              <a class="card rw" href={taskHref(f.project)}>
                <span class="rw-k">Linked task</span>
                <b><span class="mono">{id}</span> {f.task.title}</b>
                <small>{f.project.id} {f.project.name}</small>
                <small class={`rw-st st-${f.task.status}`}>{f.task.status === 'blocked' ? `Waiting on: ${f.task.blocked_by}` : f.task.status === 'done' ? 'Done' : f.task.status === 'doing' ? 'Doing' : 'To do'}{f.task.due ? ` · due ${fmtDate(f.task.due, { day: 'numeric', month: 'short' })}` : ''} · {person(f.task.owner).name}</small>
              </a>
            ))}
            {roomProjects.map((p) => {
              const here = p.spaces.find((x) => x.space === s.id);
              return (
                <a class="card rw" href={href(`/projects/${p.id.toLowerCase()}/`)}>
                  <span class="rw-k">Project for this space</span>
                  <b>{p.id} {p.name}</b>
                  <small>This space: {here.state.replace(/-/g, ' ')}{here.note ? `. ${here.note}` : ''}</small>
                </a>
              );
            })}
            {openHere.map((o) => (
              <a class="card rw" href={incHref(o.inc.number)}>
                <span class="rw-k">Also open in this space</span>
                <b><span class="mono">{o.inc.number}</span> {o.inc.short_description}</b>
                <small>P{o.inc.priority} · {INC_STATE[o.inc.state]} · {o.inc.subject.kind === 'room' ? 'Whole space' : o.deviceTitle}</small>
              </a>
            ))}
            {advs.map((a) => (
              <a class="card rw" href={href(`/profiles/${pos.cls}/${pos.model}/`)}>
                <span class="rw-k">Advisory on this model · {ADV_LEVEL[a.level]}</span>
                <b>{a.title}</b>
                <small>{a.action}</small>
              </a>
            ))}
            {labs.map((l) => (
              <a class="card rw" href={href(`/lab/#${l.id.toLowerCase()}`)}>
                <span class="rw-k">In the Lab</span>
                <b><span class="mono">{l.id}</span> {l.title}</b>
                <small>{l.status}</small>
              </a>
            ))}
          </div>
        </div>

        <div slot="ticket">
          <div class="tk-grid">
            <section class="card pad">
              <h3 class="tk-h">In ServiceNow</h3>
              <dl class="tk">
                <div><dt>Number</dt><dd class="mono">{inc.number}</dd></div>
                <div><dt>Opened</dt><dd>{when(inc.opened, { year: true })}</dd></div>
                <div><dt>Caller</dt><dd>{inc.caller}</dd></div>
                <div><dt>Priority</dt><dd>{inc.priority}, {PRIORITY_LABEL[inc.priority].toLowerCase()}</dd></div>
                <div><dt>Proposed priority</dt><dd>{inc.priority_proposed}, {PRIORITY_LABEL[inc.priority_proposed].toLowerCase()}{inc.priority_reason ? ` (${inc.priority_reason})` : ''}{override ? <>. Changed to {override.priority} by {overrideBy?.name ?? override.by}, {when(override.at)}: {override.reason}</> : ', not changed'}</dd></div>
                <div><dt>State</dt><dd>{INC_STATE[inc.state]}{v.hold ? `: ${v.hold.holdLabel.toLowerCase()}` : ''}</dd></div>
                <div><dt>Assignment group</dt><dd>{inc.assignment_group}</dd></div>
                {assigned && <div><dt>Assigned to</dt><dd>{assigned.name}</dd></div>}
                <div><dt>Short description</dt><dd>{inc.short_description}</dd></div>
                {inc.description && <div><dt>Description</dt><dd>{inc.description}</dd></div>}
                {v.resolution && <div><dt>Resolution code</dt><dd>{RES_LABEL[v.resolution.code]}</dd></div>}
                {v.resolution && <div><dt>Resolution notes</dt><dd>{v.resolution.notes}</dd></div>}
              </dl>
            </section>
            <section class="card pad">
              <h3 class="tk-h">Added by Keia Atlas</h3>
              <dl class="tk">
                <div><dt>About</dt><dd>{isRoom ? `The whole space, ${v.roomTitle}` : <>{v.deviceTitle}, <span class="mono">{unit.asset_tag}</span></>}</dd></div>
                <div><dt>Where</dt><dd>{v.where}</dd></div>
                <div><dt>Service</dt><dd>{svcName} · owner {personName(svcOwner)}</dd></div>
                <div><dt>Response target</dt><dd>{targetWords}{inc.priority <= 2 ? ', every minute counts' : ', in working hours'}</dd></div>
                {booking && <div><dt>Booking at risk</dt><dd>{hmOf(booking.at)}, {booking.people} people</dd></div>}
                {inc.major && <div><dt>Major incident</dt><dd>Commander {personName(inc.major.commander)}, since {when(inc.major.at)}</dd></div>}
                <div><dt>Matched by</dt><dd>{inc.keia_atlas.matched_by}</dd></div>
                {inc.keia_atlas.symptom && <div><dt>Symptom in the guide</dt><dd>{words(inc.keia_atlas.symptom)}</dd></div>}
                {symptom && <div><dt>First check</dt><dd>{PLAT[symptom.first_check] ?? words(symptom.first_check)}. Likely: {symptom.likely_causes.join(', ')}</dd></div>}
              </dl>
            </section>
          </div>
        </div>
    </DetailTabs>

    <OpenHere kind="job" layer="raw" />
    <Section title="Raw" id="raw-log" aside="The audit log for this job" help="incident.raw">
      <div class="list raw-l">
        {logHere.length === 0 && <p class="row plain faint">Nothing in the audit log for this job yet.</p>}
        {logHere.map((e) => (
          <a class="row plain raw-r" href={`${href(LOG_PATH)}#${e.id}`}>
            <span><span class="name"><span class="mono raw-t">{when(e.at)}</span> {e.what}</span><span class="sub">{e.who} · {e.src}</span></span>
            <span class="end"><Icon name="arrow" size={14} /></span>
          </a>
        ))}
      </div>
    </Section>
    <LiveBar page={`incident:${inc.number}`} />
  </div>

  <script>
    import { chipOf, verbsFor, apply, VERBS, hasIt } from '../../lib/ownership.mjs';
    import { parkEdit } from '../../lib/handover.mjs';
    import { setGlyph } from '../../lib/health.mjs';
    import { mayRunAgain, runningWords, runLine, rolledBack } from '../../lib/rules.mjs';
    import { answerFor, impactLine, handoffs } from '../../lib/incidentcore.mjs';
    import { play, ruleOf, runsOf, people as rulePeople } from '../../lib/rules-client.mjs';
    import { howTrigger } from '../../lib/howcard.mjs';

    const W = window as any, D = document;
    const TEAMS = [{ id: 'team-network', kind: 'team', name: 'Network team' }, { id: 'team-av-it', kind: 'team', name: 'AV and IT team' }, { id: 'team-desk', kind: 'team', name: 'Service desk' }];
    const VENDORS = [{ id: 'poly', kind: 'vendor', name: 'Poly', clockH: 4 }, { id: 'keystone', kind: 'vendor', name: 'Keystone Service', clockH: 4 }];
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' } as any)[c]);
    const pad = (n: number) => String(n).padStart(2, '0');
    const M = () => (W.rsMotion ? W.rsMotion() : { reduced: true });

    function init() {
      const page = D.querySelector<HTMLElement>('.inc-page[data-inc]'); if (!page || page.dataset.on) return;
      page.dataset.on = '1';
      const P = JSON.parse(page.dataset.inc || '{}');
      const loadT = Date.now();
      const L = () => W.rsLive?.live ?? null;
      const who = () => (W.rsWhoId ? W.rsWhoId() : null);
      const actor = () => (W.rsActorId ? W.rsActorId() : who() ?? 'demo-admin');
      const ppl = () => { const out: any = {}; (W.RS_PEOPLE || []).forEach((p: any) => { out[p.id] = { name: p.name, first: String(p.name).split(' ')[0], initials: p.initials }; }); return out; };
      const first = (id: string) => ppl()[id]?.first ?? id;
      const tl = `tl-${P.number}`;

      // ---- The story's clock: a held story runs from its own moment; anything else is stamped with the real time.
      const zl = (ms: number) => { const d = new Date(ms); return `${d.getUTCFullYear()}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())}T${pad(d.getUTCHours())}:${pad(d.getUTCMinutes())}`; };
      const lastScene = () => {
        const st = state(); const ts = [st.own?.at, st.resolved?.at, ...Object.values(st).filter((x: any) => x && typeof x === 'object' && x.at).map((x: any) => x.at), ...myRuns().map((r: any) => r.at)].filter((t) => t && !/[zZ]|[+-]\d\d:?\d\d$/.test(t));
        return ts.sort().pop() ?? null;
      };
      const now = () => {
        if (!P.held) { const d = new Date(); return `${P.today}T${pad(d.getHours())}:${pad(d.getMinutes())}`; }
        const last = lastScene();
        return zl(Math.max(Date.parse(`${P.held}Z`) + (Date.now() - loadT), last ? Date.parse(`${last}Z`) + 60000 : 0));
      };
      const hm = (t: string) => (/[zZ]|[+-]\d\d:?\d\d$/.test(t) ? new Date(t).toTimeString().slice(0, 5) : String(t).slice(11, 16));

      // ---- What the live layer says about this job now.
      function state(): any { const l = L(); return l ? l.stateOf(P.item, { own: P.base }) : { own: P.base }; }
      const myRuns = () => P.actions.flatMap((a: any) => runsOf(a.rule).filter((r: any) => r.incident === P.number && r.live));
      const lastFix = () => { const r = myRuns().sort((a: any, b: any) => String(a.at).localeCompare(String(b.at))).pop(); if (!r) return null; const rule = ruleOf(r.rule ?? P.actions.find((a: any) => runsOf(a.rule).some((x: any) => x.id === r.id))?.rule); return { ...r, rule, back: rule ? rolledBack(rule, r) : false }; };
      const own = () => state().own ?? P.base;
      const resolved = () => state().resolved ?? null;

      // ---- The band: the answer, the chip's one action, the priority, the major incident.
      function drawBand() {
        const st = state(), fix = lastFix();
        const run = fix ? { result: fix.result, at: fix.at, back: fix.back, rule: { name: fix.rule?.name } } : P.raised;
        const res = resolved();
        const impact = res ? (P.booking ? impactLine({ spaceNumber: P.space.number, spaceName: P.space.name, booking: P.booking, resolvedAt: res.at }) : 'back in service') : null;
        if (res || fix || st.own || st.major || st.priority || own()?.to === who()) W.rsAnswer?.(answerFor({ own: own(), resolved: res, impact, booking: P.booking, reason: st.priority?.reason ?? P.reason, run, major: st.major ?? P.major, raisedBy: P.raised ? P.raised.rule.name : null }, ppl(), who()));
        const box = D.querySelector<HTMLElement>('[data-ib-verb]');
        if (box) {
          const o = own(), v = who();
          const verbs = res ? [] : verbsFor(o, v, { desk: (W.RS_WHO_ROLE || {})[v] === 'desk' });
          const primary = verbs.includes('take') ? 'take' : verbs.includes('resume') ? 'resume' : hasIt(o, v) ? 'resolve' : null;
          const label = primary === 'resolve' ? 'Resolve' : primary ? VERBS[primary] : '';
          const html = primary ? `<button type="button" class="btn primary small" data-job-verb="${primary}" ${primary === 'take' ? 'data-verb="take"' : ''}>${label}</button>` : '';
          if (box.innerHTML !== html) box.innerHTML = html;
        }
        const own0 = D.querySelector<HTMLElement>('[data-job-owner]'); if (own0) own0.dataset.jobOwner = own()?.to ?? '';
        const pr = st.priority;
        if (pr) {
          const b = D.querySelector<HTMLElement>('[data-prio-open]')!;
          b.className = b.className.replace(/p-\d/, `p-${pr.priority}`);
          D.querySelector('[data-prio-n]')!.textContent = `P${pr.priority}`;
          D.querySelector('[data-prio-why]')!.textContent = pr.priority === P.proposed ? `proposed${P.reason ? `: ${P.reason}` : ''}` : `changed from P${P.proposed}: ${pr.reason}`;
        }
        const mj = st.major ?? P.major;
        const mEl = D.querySelector<HTMLElement>('[data-major]');
        if (mEl && mj) { mEl.hidden = false; D.querySelector('[data-major-who]')!.textContent = ppl()[mj.commander]?.name ?? mj.commander; D.querySelector('[data-prio-open]')?.classList.add('is-major'); }
        const ist = D.querySelector<HTMLElement>('[data-ist]');
        if (ist && res) { ist.textContent = 'Resolved'; ist.className = 'ist ist-done'; }
        else if (ist && own()?.s === 'with' && P.state === 'new') { ist.textContent = 'In progress'; ist.className = 'ist ist-prog'; }
        const n = handoffs([P.base, ...(L()?.historyOf(P.item) ?? []).filter((e: any) => e.field === 'own').reverse().map((e: any) => e.after)].filter(Boolean).map((o: any) => ({ to: o.s === 'ready' ? null : o.to })));
        if (n) W.rsKeyNumber?.('handoffs', n, { label: n === 1 ? 'Hand-off' : 'Hand-offs' });
      }

      // ---- The lifecycle and the clock follow Take and Resolve.
      function drawLife() {
        const o = own(), res = resolved();
        const clk = D.querySelector<HTMLElement>('[data-clock]');
        const ip = D.querySelector<HTMLElement>('[data-lc-ahead="in-progress"]');
        if (ip && o && o.s === 'with' && P.state === 'new') { ip.classList.remove('ahead'); ip.querySelector('[data-lc-when]')!.textContent = `${hm(o.at)} · ${o.kind === 'person' ? ppl()[o.to]?.name ?? o.to : o.name}`; }
        const rv = D.querySelector<HTMLElement>('[data-lc-ahead="resolved"]');
        if (rv && res) { rv.classList.remove('ahead'); rv.classList.add('lc-done'); rv.querySelector('[data-lc-when]')!.textContent = `${hm(res.at)} · ${ppl()[res.by]?.name ?? res.by}`; }
        if (clk && clk.dataset.state === 'running' && o && (o.s === 'with' || o.s === 'parked')) {
          const mins = Math.max(0, Math.round((Date.parse(/[zZ]/.test(o.at) ? o.at : `${o.at}Z`) - Date.parse(`${P.opened}Z`)) / 60000));
          clk.dataset.state = 'taken';
          const g = clk.querySelector('.hg'); if (g) setGlyph(g, 'fine', { title: 'Taken within the target' });
          const t = clk.querySelector('span:not(.hg):not(.hg *)'); if (t) t.textContent = P.held ? `Response target ${P.target} · taken in ${mins} min` : `Response target ${P.target} · taken`;
        }
      }

      // ---- The call before the suggestion (P1, P2): folded per person until they have said what they think.
      function drawDiag() {
        const box = D.querySelector<HTMLElement>('[data-dx]'); if (!box) return;
        const mine = state()[`call:${who()}`];
        const open = box.querySelector<HTMLElement>('[data-dx-open]')!, ask = box.querySelector<HTMLElement>('[data-dx-ask]'), me = box.querySelector<HTMLElement>('[data-dx-mine]')!;
        if (box.dataset.fold !== 'true') return;
        const show = !!mine;
        if (ask) ask.hidden = show;
        me.hidden = !show;
        if (show) { me.querySelector('[data-dx-text]')!.textContent = mine.text; me.querySelector('[data-dx-when]')!.textContent = `· ${hm(mine.at)}`; }
        if (open.hidden === !show) return;
        const reveal = () => { open.hidden = !show; };
        if (W.rsHold) W.rsHold(box, reveal); else reveal();
        if (show && !M().reduced) open.animate([{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }], { duration: M().enter, easing: M().ease });
      }

      // ---- Do: each rule's verb, gated; the job's own verbs for the viewer.
      function drawDo() {
        const box = D.querySelector<HTMLElement>('[data-do]'); if (!box) return;
        const o = own(), v = who(), res = resolved();
        box.querySelectorAll<HTMLElement>('[data-do-rule]').forEach((row) => {
          const rule = ruleOf(row.dataset.doRule), go = row.querySelector<HTMLButtonElement>('[data-do-go]')!, st = row.querySelector<HTMLElement>('[data-do-state]')!;
          if (row.dataset.running) return;
          const fix = myRuns().filter((r: any) => runsOf(row.dataset.doRule).some((x: any) => x.id === r.id)).pop();
          if (fix) {
            go.hidden = true; row.querySelector<HTMLElement>('[data-do-pre]')?.setAttribute('hidden', '');
            const line = runLine(rule, fix, rulePeople());
            const whoEl = row.querySelector('[data-do-who]'); if (whoEl) whoEl.textContent = 'Run again done';
            if (st.dataset.run !== fix.id) { st.dataset.run = fix.id; st.innerHTML = `<span class="do-done">${esc(line)}</span> · <button type="button" class="how-link" data-how="${esc(fix.id)}" aria-haspopup="dialog" aria-expanded="false">How was this done?</button>`; }
            return;
          }
          if (res) { go.disabled = true; return; }
          const again = row.dataset.doAgain;
          if (again) {
            const may = mayRunAgain(rule, v, o?.to ?? null);
            const fixed = row.querySelector<HTMLInputElement>('[data-do-fixed]');
            go.disabled = !may || !fixed?.checked;
            row.querySelector('[data-do-who]')!.textContent = may ? (fixed?.checked ? 'Ready to run again' : 'Tick the box once the cause is fixed') : `${first(rule.owner)}, the rule’s owner, or whoever has the job can run it again`;
            if (fixed) fixed.disabled = !may;
          } else {
            const mine = hasIt(o, v);
            go.disabled = !mine || go.dataset.blocked === 'true';
            if (!mine && !st.dataset.run) st.textContent = o?.to === v ? 'Take it first; then this runs under the rule' : `Whoever has the job runs this${o?.to ? ` (${first(o.to)})` : ''}`;
            else if (!st.dataset.run) st.textContent = '';
          }
        });
        const verbs = res ? [] : verbsFor(o, v, { desk: (W.RS_WHO_ROLE || {})[v] === 'desk' });
        const btns: string[] = verbs.map((vb: string) => `<button type="button" class="btn small${vb === 'take' ? ' primary' : ' ghost'}" data-job-verb="${vb}" data-verb="${vb === 'hand' ? 'hand-to' : vb}">${VERBS[vb]}</button>`);
        if (!res && hasIt(o, v)) btns.push('<button type="button" class="btn small" data-job-verb="resolve">Resolve</button>');
        if (!res && P.priority <= 2 && !(state().major ?? P.major) && (hasIt(o, v) || (W.RS_WHO_ROLE || {})[v] === 'desk')) btns.push('<button type="button" class="btn small ghost" data-job-verb="major">Declare a major incident</button>');
        const vb = box.querySelector<HTMLElement>('[data-do-verbs]')!; const html = btns.join('');
        if (vb.innerHTML !== html) vb.innerHTML = html;
        const hint = box.querySelector<HTMLElement>('[data-do-hint]')!;
        hint.textContent = res ? `Resolved. ${res.fix ? `What fixed it: ${res.fix}` : ''}` : btns.length ? '' : o?.to ? `This job is ${o.s === 'ready' ? 'offered to' : 'with'} ${o.kind === 'person' ? ppl()[o.to]?.name ?? o.to : o.name}. Use View as to be them, or the service desk.` : 'Nobody has it yet.';
      }

      function drawAll() { drawBand(); drawLife(); drawDiag(); drawDo(); }

      // ---- Timeline rows from the live layer (every window), each added once.
      const verbWord: any = { with: 'took it', parked: 'parked it', ready: 'offered it', waiting: 'is waiting' };
      function rowFor(e: any) {
        const by = ppl()[e.who]?.name ?? e.who, a = e.after;
        if (e.field === 'own' && a) {
          const what = a.s === 'with' && a.by === a.to ? (e.before?.s === 'parked' ? 'Resumed it' : 'Took it') : a.s === 'with' ? `Handed it to ${a.kind === 'person' ? ppl()[a.to]?.name ?? a.to : a.name}${a.why ? `: ${a.why}` : ''}` : a.s === 'parked' ? `Parked it${a.park?.next ? `. Next: ${a.park.next}` : ''}` : a.s === 'done' ? 'Finished it' : verbWord[a.s] ?? 'Changed who has it';
          return { id: e.id, at: a.at ?? e.at, kind: 'person', who: by, what, state: a.s === 'with' ? 'progress' : undefined };
        }
        if (e.field.startsWith('call:') && a) return { id: e.id, at: a.at, kind: 'person', who: by, what: `Their call: ${a.text}` };
        if (e.field === 'resolved' && a) return { id: e.id, at: a.at, kind: 'person', who: by, what: `Resolved. What fixed it: ${a.fix}`, state: 'fine' };
        if (e.field === 'priority' && a) return { id: e.id, at: a.at, kind: 'person', who: by, what: `Changed the priority to P${a.priority}: ${a.reason}` };
        if (e.field === 'major' && a) return { id: e.id, at: a.at, kind: 'person', who: by, what: `Declared a major incident. Commander: ${ppl()[a.commander]?.name ?? a.commander}`, state: 'fault', stateWords: 'Major incident' };
        return null;
      }
      function runRow(rule: any, run: any) {
        return { id: `run-${run.id}`, at: run.at, kind: 'rule', who: `rule: ${rule.name} (${first(rule.owner)})`, what: run.result === 'done' ? `${run.did}. Read back and matched` : `Unable to complete: ${run.why}`, state: run.result === 'done' ? 'fine' : 'fault', how: howTrigger({ id: run.id, rule: rule.id, title: 'How was this done?', meta: '', rows: [], actions: [], trace: '' } as any, {}) };
      }
      function replayRows() {
        const l = L(); if (!l) return;
        l.historyOf(P.item).slice().reverse().forEach((e: any) => { const r = rowFor(e); if (r) W.rsTimelineAdd?.(tl, r); });
        P.actions.forEach((a: any) => { const rule = ruleOf(a.rule); runsOf(a.rule).filter((r: any) => r.incident === P.number && r.live).forEach((r: any) => W.rsTimelineAdd?.(tl, runRow(rule, r))); });
      }

      // ---- Acting: every change is an event in the live layer.
      const rec = (field: string, after: any, before: any = null) => { const l = L(); if (l) l.record({ item: P.item, field, before, after, who: actor() }); else { localFallback[field] = after; drawAll(); } };
      const localFallback: any = {};
      function doVerb(verb: string, extra: any = {}) {
        const before = own(); const after = apply(verb, before, { who: actor(), at: now(), ...extra });
        rec('own', after, before);
      }
      function openEdit(kind: string, btn?: HTMLElement) {
        const box = D.querySelector<HTMLElement>('[data-do-edit]'); if (!box) return;
        if (box.dataset.open === kind) { box.innerHTML = ''; delete box.dataset.open; return; }
        let html = '';
        const id = `je-${P.number}`;
        if (kind === 'hand') {
          const staff = (P.people as any[]).filter((p) => p.id !== who());
          html = `<form class="jf" data-jf="hand" data-help="handover.hand"><label class="jf-f" for="${id}-to"><span>Hand to</span><select id="${id}-to" name="to" required><option value="">Choose a person, team or vendor</option><optgroup label="Teams">${TEAMS.map((t) => `<option value="team:${t.id}">${esc(t.name)}</option>`).join('')}</optgroup><optgroup label="Vendors">${VENDORS.map((t) => `<option value="vendor:${t.id}">${esc(t.name)} (vendor)</option>`).join('')}</optgroup><optgroup label="People">${staff.map((p) => `<option value="person:${p.id}">${esc(p.name)}</option>`).join('')}</optgroup></select></label><label class="jf-f" for="${id}-why"><span>Why?</span><input id="${id}-why" name="why" maxlength="140" autocomplete="off" placeholder="The one thing only you know"></label><div class="jf-act"><button type="submit" class="btn small primary">Hand to</button><button type="button" class="btn small ghost" data-jf-cancel>Cancel</button><span class="faint">The job moves as a whole: the record, the history and your reason.</span></div></form>`;
        } else if (kind === 'park') {
          html = `<form class="jf" data-jf="park">${parkEdit(own()?.park ?? {}, { id: `${id}-pk` })}</form>`;
        } else if (kind === 'resolve') {
          html = `<form class="jf" data-jf="resolve" data-help="incident.resolve"><label class="jf-f" for="${id}-fix"><span>What fixed it?</span><input id="${id}-fix" name="fix" required maxlength="140" autocomplete="off" placeholder="One line: what you did that worked"></label><div class="jf-act"><button type="submit" class="btn small primary">Resolve</button><button type="button" class="btn small ghost" data-jf-cancel>Cancel</button><span class="faint">The one thing closing asks. It goes on the record and helps the next person.</span></div></form>`;
        } else if (kind === 'major') {
          const opts = (P.people as any[]).map((p) => `<option value="${p.id}"${p.id === P.svcOwner ? ' selected' : ''}>${esc(p.name)}${p.id === P.svcOwner ? ' (service owner)' : ''}</option>`).join('');
          html = `<form class="jf" data-jf="major" data-help="incident.major"><label class="jf-f" for="${id}-cmd"><span>Commander</span><select id="${id}-cmd" name="commander">${opts}</select></label><label class="jf-f" for="${id}-mwhy"><span>Why is it major?</span><input id="${id}-mwhy" name="why" required maxlength="140" autocomplete="off" placeholder="What makes it bigger than one space"></label><div class="jf-act"><button type="submit" class="btn small primary">Declare</button><button type="button" class="btn small ghost" data-jf-cancel>Cancel</button><span class="faint">One person is in charge until it is over.</span></div></form>`;
        }
        const swap = () => { box.innerHTML = html; box.dataset.open = kind; };
        if (W.rsHold) W.rsHold(box.closest('.do') ?? box, swap); else swap();
        const f = box.firstElementChild as HTMLElement;
        if (f && btn && W.rsPopIn) W.rsPopIn(f, btn);
        (f?.querySelector('input, select') as HTMLElement)?.focus({ preventScroll: true });
      }
      const closeEdit = () => { const box = D.querySelector<HTMLElement>('[data-do-edit]'); if (!box || !box.firstElementChild) return; const done = () => { box.innerHTML = ''; delete box.dataset.open; }; if (W.rsPopOut) W.rsPopOut(box.firstElementChild, null, () => (W.rsHold ? W.rsHold(box.closest('.do') ?? box, done) : done())); else done(); };

      async function runRule(row: HTMLElement) {
        const ruleId = row.dataset.doRule!, rule = ruleOf(ruleId), go = row.querySelector<HTMLButtonElement>('[data-do-go]')!, st = row.querySelector<HTMLElement>('[data-do-state]')!;
        row.dataset.running = '1'; go.disabled = true;
        const g = D.querySelector('[data-unit-glyph] .hg');
        const run = await play(ruleId, {
          target: row.dataset.doTarget, incident: P.number, now,
          onStep: (s: any) => {
            go.textContent = s.end ? go.textContent : runningWords(rule, s.state);
            if (s.state === 'read' && g) setGlyph(g, 'progress', { word: 'Being worked on' });
            if (!s.end && s.state !== 'checking') W.rsTimelineAdd?.(tl, { id: `step-${ruleId}-${s.state}-${Date.now()}`, at: now(), kind: 'rule', who: `rule: ${rule.name} (${first(rule.owner)})`, what: s.words, state: 'progress', stateWords: 'Running' });
          },
        });
        delete row.dataset.running;
        if (run && g) setGlyph(g, run.result === 'done' ? 'fine' : 'fault', { word: run.result === 'done' ? 'Back in service' : 'Unable to complete' });
        drawAll();
      }

      // ---- Events.
      // The band sits outside the content, so clicks are heard on the document while this page is up.
      const onClick = (e: Event) => {
        if (!page.isConnected) return;
        const t = e.target as HTMLElement;
        const jv = t.closest<HTMLElement>('[data-job-verb]');
        if (jv) {
          const verb = jv.dataset.jobVerb!;
          if (verb === 'take' || verb === 'resume') { doVerb(verb); closeEdit(); }
          else openEdit(verb, jv);
          return;
        }
        const go = t.closest<HTMLElement>('[data-do-go]');
        if (go) { const row = go.closest<HTMLElement>('[data-do-rule]'); if (row) runRule(row); return; }
        if (t.closest('[data-jf-cancel]') || t.closest('[data-cancel]')) { closeEdit(); return; }
        if (t.closest('[data-dx-unsure]')) { rec(`call:${who()}`, { text: 'Not sure yet', at: now() }); return; }
      };
      D.addEventListener('click', onClick);
      D.addEventListener('astro:before-swap', () => D.removeEventListener('click', onClick), { once: true });
      page.addEventListener('change', (e) => { if ((e.target as HTMLElement).matches('[data-do-fixed]')) drawDo(); });
      page.addEventListener('submit', (e) => {
        const f = e.target as HTMLFormElement; e.preventDefault();
        if (f.matches('[data-dx-ask]')) { const text = String(new FormData(f).get('call') ?? '').trim(); if (!text) { f.querySelector('input')?.focus(); return; } rec(`call:${who()}`, { text, at: now() }); return; }
        const kind = f.dataset.jf, fd = new FormData(f);
        if (kind === 'hand') {
          const [k, id] = String(fd.get('to') ?? '').split(':'); if (!id) return;
          const target = k === 'team' ? TEAMS.find((x) => x.id === id) : k === 'vendor' ? VENDORS.find((x) => x.id === id) : { id, kind: 'person', name: ppl()[id]?.name };
          doVerb('hand', { target, why: String(fd.get('why') ?? '') });
        } else if (kind === 'park') doVerb('park', { card: { where: fd.get('where'), next: fd.get('next'), question: fd.get('question') } });
        else if (kind === 'resolve') {
          const fix = String(fd.get('fix') ?? '').trim(); if (!fix) return;
          const at = now();
          rec('resolved', { at, by: actor(), fix });
          rec('own', { s: 'done', to: actor(), kind: 'person', at, by: actor() }, own());
        } else if (kind === 'major') rec('major', { at: now(), commander: String(fd.get('commander')), reason: String(fd.get('why') ?? '') });
        closeEdit();
      });

      // The priority: a proposal a person may change, with the reason kept (docs/rules/motion.md).
      const pb = D.querySelector<HTMLElement>('[data-prio-open]'), pf = D.querySelector<HTMLFormElement>('[data-prio-form]');
      if (pb && pf) {
        const shut = () => { if (pf.hidden) return; pb.setAttribute('aria-expanded', 'false'); if (W.rsPopOut) W.rsPopOut(pf, pb, () => { pf.hidden = true; }); else pf.hidden = true; };
        pb.addEventListener('click', () => { if (!pf.hidden) { shut(); return; } pf.hidden = false; pb.setAttribute('aria-expanded', 'true'); W.rsPopIn?.(pf, pb); pf.querySelector<HTMLInputElement>('input[name="why"]')?.focus({ preventScroll: true }); });
        pf.querySelector('[data-prio-cancel]')?.addEventListener('click', shut);
        pf.addEventListener('submit', (e) => { e.preventDefault(); const fd = new FormData(pf); const why = String(fd.get('why') ?? '').trim(); if (!why) return; rec('priority', { priority: +String(fd.get('p')), reason: why, at: now() }); shut(); pf.reset(); });
        D.addEventListener('keydown', (e) => { if (e.key === 'Escape') shut(); });
      }

      // The work note for the ticket: it takes effect at once and offers Undo for a few seconds (rule P7).
      const note = page.querySelector<HTMLElement>('[data-note]');
      if (note) {
        const send = note.querySelector<HTMLElement>('[data-note-send]')!, done = note.querySelector<HTMLElement>('[data-note-done]')!, act = note.querySelector<HTMLElement>('.dc-note-act')!;
        let timer: any = null, row: any = null;
        send.addEventListener('click', () => {
          act.hidden = true; done.hidden = false;
          row = W.rsTimelineAdd?.(tl, { id: `note-${Date.now()}`, at: now(), kind: 'person', who: ppl()[actor()]?.name ?? 'You', what: `Approved the work note: ${note.querySelector('[data-note-text]')!.textContent}`, src: 'Keia Atlas' });
          clearTimeout(timer); timer = setTimeout(() => { const u = done.querySelector<HTMLElement>('[data-note-undo]'); if (u) u.hidden = true; }, 6000);
        });
        note.querySelector('[data-note-undo]')!.addEventListener('click', () => { clearTimeout(timer); if (row?.parentNode) row.remove(); row = null; done.hidden = true; act.hidden = false; send.focus(); });
      }

      // Run again, from the card or the Do section.
      W.rsRunAgain = (runId: string) => { const row = D.querySelector<HTMLElement>(`[data-do-again="${runId}"]`); if (row) { const box = row.querySelector<HTMLInputElement>('[data-do-fixed]'); if (box && !box.checked) { box.checked = true; drawDo(); } row.scrollIntoView({ block: 'center', behavior: M().reduced ? 'auto' : 'smooth' }); if (!row.querySelector<HTMLButtonElement>('[data-do-go]')!.disabled) runRule(row); } };

      // ---- The live layer: redraw on any change to this job or its rules, from this window or another.
      const go = () => {
        const l = L(); if (!l) return;
        drawAll(); replayRows();
        const stops = [l.subscribe(P.item, (e: any, info: any) => { drawAll(); const r = rowFor(e); if (r) W.rsTimelineAdd?.(tl, r, { by: info?.remote ? first(e.who) : '' }); }),
          ...P.actions.map((a: any) => l.subscribe(`rule:${a.rule}`, (e: any, info: any) => { if (e.after?.incident === P.number) { W.rsTimelineAdd?.(tl, runRow(ruleOf(a.rule), e.after), { by: info?.remote ? first(e.who) : '' }); } drawAll(); }))];
        D.addEventListener('astro:before-swap', () => stops.forEach((s: any) => s()), { once: true });
      };
      drawAll();
      if (W.rsLive) go(); else D.addEventListener('rs:live-ready', go, { once: true });
      D.addEventListener('rs:demo-change', drawAll);
    }
    D.addEventListener('astro:page-load', init);
  </script>
</Shell>

<style is:global>
  .ist { font: 500 var(--fs-overline)/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; padding: 4px 7px; border-radius: 4px; background: var(--surface-3); color: var(--text-2); white-space: nowrap; }
  .ist-new, .ist-prog { background: var(--h-progress-soft); color: var(--h-progress-ink); }
  .ist-hold { background: var(--h-review-soft); color: var(--h-review-ink); }
  .ist-done { background: var(--h-fine-soft); color: var(--h-fine-ink); }

  /* The priority: the number, then why it was proposed (or changed), and a caret that opens "Change priority".
     Red at more than glyph size only for a P1 or a major incident (design notes); a P2 carries the fault ink on a tint. */
  .prio-w { position: relative; display: inline-flex; min-width: 0; max-width: 100%; }
  .prio-b { appearance: none; display: inline-flex; align-items: center; gap: 7px; min-width: 0; max-width: 100%; min-height: 24px; padding: 3px 8px 3px 3px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); color: var(--text-2); font: 500 var(--fs-code)/1.2 var(--font-sans); cursor: pointer; text-align: left; transition: background-color var(--dur-state) var(--ease-settle), border-color var(--dur-hover) var(--ease-settle); }
  .prio-b:hover { border-color: var(--line-strong); background: var(--surface-2); }
  .prio-b b { font: 600 var(--fs-mark)/1 var(--font-mono); padding: 4px 6px; border-radius: 4px; background: var(--surface-3); color: var(--text); transition: background-color var(--dur-state) var(--ease-settle), color var(--dur-state) var(--ease-settle); }
  .prio-b.p-1 b, .prio-b.is-major b { background: var(--h-fault); color: #fff; }
  .prio-b.p-2 b { background: var(--h-fault-soft); color: var(--h-fault-ink); }
  .prio-b.p-3 b { background: var(--h-review-soft); color: var(--h-review-ink); }
  .prio-why { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .prio-c { flex: none; color: var(--text-3); }
  .prio-f { position: absolute; left: 0; top: calc(100% + 6px); z-index: 30; width: min(340px, calc(100vw - 32px)); display: grid; gap: 10px; padding: 14px; border-radius: var(--radius-lg); border: var(--border-card); background: var(--surface); box-shadow: var(--shadow-lg); text-transform: none; letter-spacing: 0; }
