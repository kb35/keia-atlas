---
// One incident (decision 0024). The ticket stays in ServiceNow; this page is what Keia Atlas knows about it.
// Record anatomy (docs/standards/page-anatomy.md): PageBand with the number, priority and status, the lifecycle
// tracker, then the room drawn with the affected device lit beside a sticky SidePanel about that device (no inner
// scroll). Below, in DetailTabs: the wiring with its path lit, every device in the room, the history around it,
// related work and the ticket's fields. The board card's number flies into the band's number (recHere).
import Shell from '../../layouts/Shell.astro';
import Icon from '../../components/Icon.astro';
import DeviceArt from '../../components/DeviceArt.astro';
import DeviceGlyph from '../../components/DeviceGlyph.astro';
import RoomScene from '../../components/RoomScene.astro';
import Wiring from '../../components/Wiring.astro';
import PageBand from '../../components/PageBand.astro';
import SidePanel from '../../components/SidePanel.astro';
import DetailTabs from '../../components/DetailTabs.astro';
import HealthGlyph from '../../components/HealthGlyph.astro';
import { recHere } from '../../lib/vt.mjs';
import {
  incidents, classes, projects, labTests, INC_STATE, STAGE_LABEL, LOC_LABEL, className, modelName, findTask,
  standardFirmware, advisoriesFor, ADV_LEVEL, incidentPath, href, fmtDate,
} from '../../lib/data.mjs';
import { incidentView, incidentList, aroundIncident, shortRole, when, spoken, whoName, HOLD_LABEL, RES_LABEL, PRIORITY_LABEL, SOURCE_LABEL } from '../../lib/incidents.mjs';
import { person } from '../../lib/demo.mjs';
// Known issues (decision 0029): the known issues this ticket looks like, and a repeat across the fleet it is part of.
import { matchesForIncident, clusters as kiClusters, draftForCluster, CONFIDENCE as KI_CONF } from '../../lib/knownissues-view.mjs';

export function getStaticPaths() {
  return Object.keys(incidents).map((number) => ({ params: { number } }));
}
const v = incidentView(incidents[Astro.params.number]);
const { inc, space: s, site, pos, unit } = v;
const kiMatches = matchesForIncident(inc.number);
const kiRepeat = kiClusters.find((c) => c.incidents.some((i) => i.number === inc.number)) ?? null;
const cls = pos ? classes[pos.cls] : null;
const isRoom = inc.subject.kind === 'room';
const assigned = inc.keia_atlas.assigned ? person(inc.keia_atlas.assigned) : null;
// Priority is proposed; a person may change it, and the reason is kept (priority_override).
const override = inc.priority_override ?? null;
const overrideBy = override ? person(override.by) : null;

// Units at the same desk or kit as the device (or every unit in the room).
const prefix = inc.position?.match(/^([a-z]+-\d+\/)/)?.[1] ?? null;
const roomPositions = [...s.positions.filter((p) => !prefix || p.position.startsWith(prefix)), ...s.olderKit];
const openHere = incidentList.filter((o) => o.open && o.inc.room === s.id && o.inc.number !== inc.number);

// Health: each system the device profile says must know about the device, with what Keia Atlas found there.
const FROM = { 'Device management': 'device_management', Monitoring: 'monitoring', Calendar: 'room_booking', 'Room booking': 'room_booking', 'Asset register': 'inventory', 'Keia Atlas': 'keia_atlas' };
const PLAT = { keia_atlas: 'Keia Atlas record', inventory: 'Asset register', dhcp_dns: 'Addresses and DNS', device_management: 'Device management', room_booking: 'Room booking', monitoring: 'Monitoring' };
const RANK = { ok: 0, warn: 1, bad: 2 };
const WORD = { ok: 'Healthy', warn: 'Check', bad: 'Fault' };
// A system the profile does not list can still have seen it (a microphone is seen through its video bar).
const platformKeys = cls ? [...new Set([...Object.keys(cls.platforms ?? {}), ...inc.keia_atlas.evidence.map((e) => FROM[e.from]).filter(Boolean)])] : [];
const health = cls ? platformKeys.map((k) => {
  const ev = inc.keia_atlas.evidence.filter((e) => FROM[e.from] === k);
  const level = ev.reduce((w, e) => (RANK[e.level] > RANK[w] ? e.level : w), 'ok');
  return { k, name: PLAT[k] ?? k, level, word: ev.length ? WORD[level] : 'No problem seen', says: ev.map((e) => e.says).join(' ') };
}) : [];
const std = pos?.model ? standardFirmware(pos.model) : null;
const fwReported = inc.keia_atlas.firmware ?? null;
const fwLevel = std && fwReported ? (fwReported === std.version ? 'ok' : 'warn') : null;
const symptom = cls && inc.keia_atlas.symptom ? cls.discrimination?.[inc.keia_atlas.symptom] : null;
const words = (k) => k.replace(/_/g, ' ').replace(/^./, (c) => c.toUpperCase());
const worst = inc.keia_atlas.evidence.reduce((w, e) => (RANK[e.level] > RANK[w] ? e.level : w), 'ok');

// The picture: the room drawing, with the device lit (red while the ticket is open).
const sceneKey = v.sceneKey;
const wireNode = v.wireNode;

// Tabs.
const around = aroundIncident(v);
const related = (inc.keia_atlas.related ?? []).map((r) => ({ id: r, f: findTask(r) }));
const roomProjects = Object.values(projects).filter((p) => p.spaces.some((x) => x.space === s.id));
const labs = pos?.model ? Object.values(labTests).filter((l) => l.models?.includes(pos.model)) : [];
const advs = pos?.model ? advisoriesFor(pos.model) : [];
const relatedCount = related.length + roomProjects.length + labs.length + advs.length + openHere.length;
const TABS = [
  { id: 'wiring', label: 'Wiring' },
  { id: 'devices', label: prefix ? `Every device in the ${prefix.startsWith('kit') ? 'kit' : 'desk'}` : 'Every device in the space', count: roomPositions.length },
  { id: 'history', label: 'History', count: around.length },
  { id: 'related', label: 'Related work', count: relatedCount },
  { id: 'ticket', label: 'Ticket details' },
];
const NUMBERS = [
  { n: spoken(v.age), label: v.open ? 'Open for' : 'Took', fact: true },
  v.hold ? { n: spoken(v.hold.minutes), label: 'On hold', fact: true, tone: 'warn' } : null,
  v.resolution ? { n: RES_LABEL[v.resolution.code], label: 'Resolution', fact: true, tone: 'good' } : null,
  { n: inc.keia_atlas.evidence.length, label: inc.keia_atlas.evidence.length === 1 ? 'Finding' : 'Findings', to: '#evidence' },
  { n: relatedCount, label: 'Related', to: '#related' },
].filter(Boolean).slice(0, 4);
// The answer (UI-V2 §3.5): where the job stands and who has it. The ticket's own system is the source mark.
const first = assigned ? assigned.name.split(' ')[0] : null;
const ANSWER = inc.state === 'resolved' ? `Resolved: ${(RES_LABEL[v.resolution?.code] ?? 'closed').toLowerCase()} · took ${spoken(v.age)}`
  : inc.state === 'on-hold' ? `On hold · waiting on ${(HOLD_LABEL[v.hold?.hold] ?? 'something').replace(/^Waiting for /, '').toLowerCase()}${first ? ` · With ${first}` : ''}`
  : inc.state === 'new' ? `New, not taken yet · open for ${spoken(v.age)}`
  : `In progress${first ? ` · With ${first}` : ''} · open for ${spoken(v.age)}`;
const fromTicket = [...inc.history].reverse().find((h) => h.source && h.source !== 'keia_atlas');
const SOURCE = fromTicket ? { from: SOURCE_LABEL[fromTicket.source] ?? fromTicket.source, ref: inc.number, at: fromTicket.at } : undefined;
const kindIcon = { ticket: 'inbox', install: 'box', incident: 'alert', task: 'project' };
const stateTone = { new: 'new', 'in-progress': 'prog', 'on-hold': 'hold', resolved: 'done' };
const taskHref = (prj) => href(`/projects/${prj.id.toLowerCase()}/`);
const incHref = (n) => href(incidentPath(n));
---
<Shell about={{ kind: 'incident', label: `${inc.number} ${inc.short_description}`, to: v.href }} title={`${inc.number} ${inc.short_description}`} section="incidents" minStage={2}
  crumbs={[{ label: 'Incidents', to: '/incidents/' }, { label: site.name, to: `/incidents/?site=${s.site}` }, { label: v.roomTitle, to: `/rooms/${s.id}/` }, { label: inc.number }]}>
  <PageBand overline="Incident" title={inc.short_description} answer={ANSWER} source={SOURCE} numbers={NUMBERS} sim>
    <Fragment slot="overline">
      <span class="mono ib-no" data-help="incident.number" {...recHere(inc.number)}>{inc.number}</span>
      <span data-help="incident.priority" class={`prio p-${inc.priority}`} title={`Priority ${inc.priority}: ${PRIORITY_LABEL[inc.priority]}`}>P{inc.priority} {PRIORITY_LABEL[inc.priority]}</span>
      {override && <span class="prio-was" data-help="incident.priority-changed">changed from P{inc.priority_proposed}: {override.reason}</span>}
      <span data-help="incident.state" class={`ist ist-${stateTone[inc.state]}`}>{INC_STATE[inc.state]}{v.reopened && inc.state !== 'resolved' ? ', reopened' : ''}</span>
      {assigned && <span class="ib-who"><span class="av">{assigned.initials}</span>{assigned.name}</span>}
    </Fragment>
    <Fragment slot="lede">
      {isRoom
        ? <>The whole space: <a href={href(`/rooms/${s.id}/`)}>{v.roomTitle}</a>, {site.name}{site.city ? `, ${site.city}` : ''}.</>
        : <><b>{v.deviceTitle}</b>{v.model ? ` (${v.model})` : ''} in <a href={href(`/rooms/${s.id}/`)}>{v.roomTitle}</a>, {site.name}{site.city ? `, ${site.city}` : ''}.</>}
    </Fragment>
  </PageBand>

  <div class="content inc-page">
    <!-- The lifecycle: each state the ticket has been in, with when and who. On hold is a pause, not a step. -->
    <ol class="lc" data-help="incident.lifecycle" aria-label="Lifecycle">
      {v.steps.list.map((st, i) => (
        <li class:list={['lc-step', `lc-${stateTone[st.state]}`, { now: i === v.steps.list.length - 1, reopen: st.reopen }]} title={st.note ?? undefined}>
          {st.reopen && <span class="lc-reopen" title="Reopened: it went back from Resolved to In progress"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 1 0 3-6.2M4 4v5h5" /></svg>Reopened</span>}
          <span class="lc-mark" aria-hidden="true">
            {st.state === 'on-hold' ? <svg viewBox="0 0 24 24" width="14" height="14"><rect x="6" y="5" width="4" height="14" rx="1" fill="currentColor" /><rect x="14" y="5" width="4" height="14" rx="1" fill="currentColor" /></svg>
              : st.state === 'resolved' ? <Icon name="check" size={14} /> : <span class="lc-dot"></span>}
          </span>
          <span class="lc-body">
            <b>{st.label}</b>
            <small>{when(st.at)} · {st.who}</small>
            {st.holdLabel && <small class="lc-extra">{st.holdLabel} · {spoken(st.minutes)}{!st.until ? ' so far' : ''}</small>}
            {st.resolution && <small class="lc-extra">{RES_LABEL[st.resolution.code]}</small>}
            {!st.holdLabel && !st.resolution && st.state !== 'resolved' && <small class="lc-dur">{spoken(st.minutes)}{!st.until ? ' so far' : ''}</small>}
          </span>
        </li>
      ))}
      {v.steps.ahead.map((st) => (
        <li class={`lc-step ahead lc-${stateTone[st.state]}`}><span class="lc-mark" aria-hidden="true"><span class="lc-dot"></span></span><span class="lc-body"><b>{st.label}</b><small>Not yet</small></span></li>
      ))}
    </ol>

    <div class="g12 top">
      <section class="card ip-draw s-7 stick" aria-label={isRoom ? 'The space' : `The space, with ${v.deviceTitle} lit`}>
        <header class="ip-h" data-help="incident.picture">
          <h2>{v.roomTitle}</h2>
          <span class="faint">{s.type.profile.name} · {isRoom ? 'the whole space' : `${v.role} lit`} · hover to find a device</span>
          <a class="aside" href={href(`/rooms/${s.id}/`)}>Space page <Icon name="arrow" size={14} /></a>
        </header>
        <RoomScene option={s.option} type={s.space_type} fitted={s.fitted} space={s} uid={`inc-${inc.number}`} highlight={sceneKey ? [sceneKey] : []} tone={v.open ? 'bad' : null} />
      </section>

      <SidePanel class={`s-5 ip-side${v.open && worst === 'bad' ? ' rs-radiate' : ''}`} title={isRoom ? 'The whole space' : 'The device'} meta={isRoom ? `${roomPositions.length} devices` : (pos.model ? modelName(pos.model) : className(pos.cls))}>
        <div class="ip-body">
        {isRoom ? (
          <header class="dc-head" data-help="incident.device">
            <span class="dc-art space"><Icon name="room" size={40} /></span>
            <span class="dc-id"><b>Whole space</b><small>{roomPositions.length} devices · {s.type.profile.name}</small><small class="mono">{s.id}</small></span>
          </header>
        ) : (
          <header class="dc-head" data-help="incident.device">
            <span class="dc-art"><DeviceArt model={pos.model} cls={pos.cls} small /></span>
            <span class="dc-id">
              <b>{v.deviceTitle}</b>
              <small>{pos.model ? <a href={href(`/models/${pos.model}/`)}>{modelName(pos.model)}</a> : `${className(pos.cls)}, model set per project`}</small>
              <small class="mono">{pos.hostname ? `${pos.hostname} · ` : ''}{unit.asset_tag}</small>
              <a class="dc-open" href={href(`/device/?tag=${unit.asset_tag}`)}>Device page <Icon name="arrow" size={13} /></a>
            </span>
          </header>
        )}

        <section class="dc-sec" id="evidence">
          <h3 data-help="incident.evidence">Evidence</h3>
          <ul class="ev">
            {inc.keia_atlas.evidence.map((e) => <li class={`ev-${e.level}`}><HealthGlyph state={e.level} size={12} title={WORD[e.level]} /><span><b>{e.from}</b>{e.says}</span><span class="sr-only">{WORD[e.level]}</span></li>)}
          </ul>
        </section>

        {/* Known issues (decision 0029): proposals only; linking happens on the known issue's page. */}
        {kiMatches.length > 0 && (
          <section class="dc-sec" data-help="incident.known-issue">
            <h3>Looks like a known error</h3>
            {kiMatches.map((m) => <p class="dc-sym"><a href={href(m.issue.path)}><span class="mono">{m.issue.ref ?? m.issue.id}</span> {m.issue.title}</a>: {KI_CONF[m.confidence].toLowerCase()}, {m.issue.maker}.{m.issue.workaround ? ` Workaround: ${m.issue.workaround.text}` : ''}</p>)}
          </section>
        )}
        {kiRepeat && (
          <section class="dc-sec" data-help="incident.repeat">
            <h3>Part of a repeat across the fleet</h3>
            <p class="dc-sym">{kiRepeat.why}, with no known error. <a href={href(draftForCluster(kiRepeat.key).path)}>The case for the manufacturer</a> · <a href={href('/known-issues/#needs-your-decision')}>Known errors</a></p>
          </section>
        )}

        {isRoom ? (
          <section class="dc-sec">
            <h3>Devices in the space</h3>
            <ul class="dc-health">
              {roomPositions.map((p) => <li><HealthGlyph state={v.open ? 'fault' : 'fine'} size={12} title={v.open ? 'offline' : 'back online'} /><span>{(p.role ?? className(p.cls)).replace(/:.*$/, '')}</span><small>{v.open ? 'Offline' : 'Back online'}</small></li>)}
            </ul>
          </section>
        ) : (
          <section class="dc-sec">
            <h3 data-help="incident.health">Health checks <small class="faint">when Keia Atlas matched the ticket</small></h3>
            <ul class="dc-health">
              {health.map((hc) => <li title={hc.says || undefined}><HealthGlyph state={hc.level} size={12} title={hc.word} /><span>{hc.name}</span><small class={`w-${hc.level}`}>{hc.word}</small></li>)}
              {std && (
                <li title={fwReported ? `Device management reported ${fwReported}` : 'Device management did not report a version for this ticket'}>
                  <HealthGlyph state={fwLevel ?? 'off'} size={12} title={fwLevel === 'ok' ? 'on the standard' : fwLevel ? 'behind the standard' : 'not reported'} /><span>Firmware <span class="mono">{fwReported ?? 'not reported'}</span></span>
                  <small class={fwLevel ? `w-${fwLevel}` : ''}>{fwLevel === 'ok' ? 'Standard' : fwLevel === 'warn' ? `Standard is ${std.version}` : `Standard ${std.version}`}</small>
                </li>
              )}
            </ul>
          </section>
        )}

        <section class="dc-sec">
          <h3 data-help="incident.next">Next, from the guide</h3>
          {symptom && <p class="dc-sym"><a href={href(`/profiles/${pos.cls}/`)}>{words(inc.keia_atlas.symptom)}</a>: first check {PLAT[symptom.first_check] ?? words(symptom.first_check)}. Likely: {symptom.likely_causes.join(', ')}.</p>}
          <ol class="dc-next">{inc.keia_atlas.next.map((n) => <li>{n}</li>)}</ol>
        </section>

        {inc.keia_atlas.work_note && v.open && (
          <section class="dc-sec dc-note" data-help="incident.worknote" data-min-stage="4" data-note>
            <h3>Work note for ServiceNow <span class="stg">Simulated</span></h3>
            <p class="mono" data-note-text>{inc.keia_atlas.work_note}</p>
            <p class="dc-note-act"><button type="button" class="btn small primary" data-note-send>Approve and add to the ticket</button><span class="faint">Goes on the ticket as a work note from you.</span></p>
            <p class="dc-note-done" data-note-done hidden role="status"><Icon name="check" size={14} /><span>Added to the ticket (demo: nothing was sent).</span><button type="button" class="linkish" data-note-undo>Undo</button></p>
          </section>
        )}
        {inc.keia_atlas.captured_fix && <blockquote class="t-fix" data-help="incident.fix"><span class="t-fix-h">Fix captured</span>{inc.keia_atlas.captured_fix}</blockquote>}
        <p class="dc-match" data-help="incident.matched"><Icon name="link" size={13} /><span><b>Matched by</b> {inc.keia_atlas.matched_by}</span></p>
        </div>
      </SidePanel>
    </div>

    <DetailTabs tabs={TABS} label="More about this incident">
        <div slot="wiring">
          <Wiring option={s.option} fitted={s.fitted} heading={isRoom ? 'Wiring' : `Wiring, with the ${v.role.toLowerCase()}'s path lit`} note={isRoom ? 'Hover a device to light its path.' : `Everything its signal passes through is lit. ${prefix ? `The same at every ${prefix.startsWith('kit') ? 'kit' : 'desk'}.` : ''}`} highlight={wireNode ? [wireNode] : []} />
        </div>

        <div slot="devices">
          <div class="list ip-devs">
            {roomPositions.map((p) => {
              const u = p.current ?? p.units[0];
              const here = p.position === inc.position;
              const other = openHere.filter((o) => o.inc.position === p.position);
              return (
                <a class:list={['row ip-dev-row', { 'is-subject': here, 'rs-radiate': here && v.open }]} href={href(`/device/?tag=${u.asset_tag}`)}>
                  <span class="glyph"><DeviceGlyph cls={p.cls} /></span>
                  <span>
                    <span class="name">{p.older ? p.role : `${shortRole(p)}${p.position.includes('#') ? ` ${p.position.split('#')[1]}` : ''}`}{here && <span class="subj-tag">This incident</span>}</span>
                    <span class="sub">{p.model ? modelName(p.model) : 'Model set per project'}{p.equipment?.location ? ` · ${LOC_LABEL[p.equipment.location]}` : ''}</span>
                    <span class="sub mono faint">{p.hostname ? `${p.hostname} · ` : ''}{u.serial} · {u.asset_tag}</span>
                  </span>
                  <span class="end">
                    {other.map((o) => <span class="rc-st st-issue">{o.inc.number}</span>)}
                    <span class={`pill ${u.stage}`}>{STAGE_LABEL[u.stage]}</span>
                  </span>
                </a>
              );
            })}
          </div>
        </div>

        <div slot="history">
          <p class="faint ih-key"><span class="ih-k k-ticket">This ticket</span><span class="ih-k k-incident">Other incidents in the space</span><span class="ih-k k-task">Project work</span><span class="ih-k k-install">The unit</span></p>
          <ol class="ih" data-history>
            {around.map((r) => (
              <li class:list={['ih-row', `k-${r.kind}`, { same: r.same }]}>
                <span class="ih-when mono">{r.kind === 'task' ? 'Due ' : ''}{when(r.at, { time: !r.dateOnly, year: r.at.slice(0, 4) !== '2026' })}</span>
                <span class="ih-ic" aria-hidden="true"><Icon name={kindIcon[r.kind]} size={14} /></span>
                <span class="ih-body">
                  {r.kind === 'ticket' && (
                    <>
                      <b>{r.h.state ? <span class={`ist ist-${stateTone[r.h.state]}`}>{INC_STATE[r.h.state]}</span> : r.h.source === 'keia_atlas' ? 'Keia Atlas added a note' : 'Note'}{r.h.hold_reason ? ` · ${HOLD_LABEL[r.h.hold_reason]}` : ''}{r.h.resolution ? ` · ${RES_LABEL[r.h.resolution.code]}` : ''}</b>
                      {r.h.note && <span>{r.h.note}</span>}
                      {r.h.resolution && <span>{r.h.resolution.notes}</span>}
                      <small>{r.who} · {SOURCE_LABEL[r.h.source]}</small>
                    </>
                  )}
                  {r.kind === 'incident' && <><a href={incHref(r.other.inc.number)}><b>{r.text}</b></a><small>{r.sub}{r.same ? ' · the same device' : ''}</small></>}
                  {r.kind === 'task' && <><a href={taskHref(r.prj)}><b>{r.text}</b></a><small>{r.sub} · {r.t.status === 'done' ? 'Done' : r.t.status === 'blocked' ? `Waiting on: ${r.t.blocked_by}` : r.t.status === 'doing' ? 'Doing' : 'To do'}</small></>}
                  {r.kind === 'install' && <><b>{r.text}</b><small class="mono">{r.sub}</small></>}
                </span>
              </li>
            ))}
          </ol>
        </div>

        <div slot="related">
          {relatedCount === 0 && <p class="ip-empty">No linked work, projects or Lab tests for this space or device. <a href={href('/projects/')}>See every project</a></p>}
          <div class="rw-grid">
            {related.map(({ id, f }) => f && (
              <a class="card rw" href={taskHref(f.project)}>
                <span class="rw-k">Linked task</span>
                <b><span class="mono">{id}</span> {f.task.title}</b>
                <small>{f.project.id} {f.project.name}</small>
                <small class={`rw-st st-${f.task.status}`}>{f.task.status === 'blocked' ? `Waiting on: ${f.task.blocked_by}` : f.task.status === 'done' ? 'Done' : f.task.status === 'doing' ? 'Doing' : 'To do'}{f.task.due ? ` · due ${fmtDate(f.task.due, { day: 'numeric', month: 'short' })}` : ''} · {person(f.task.owner).name}</small>
              </a>
            ))}
            {roomProjects.map((p) => {
              const here = p.spaces.find((x) => x.space === s.id);
              return (
                <a class="card rw" href={href(`/projects/${p.id.toLowerCase()}/`)}>
                  <span class="rw-k">Project for this space</span>
                  <b>{p.id} {p.name}</b>
                  <small>This room: {here.state.replace(/-/g, ' ')}{here.note ? `. ${here.note}` : ''}</small>
                </a>
              );
            })}
            {openHere.map((o) => (
              <a class="card rw" href={incHref(o.inc.number)}>
                <span class="rw-k">Also open in this space</span>
                <b><span class="mono">{o.inc.number}</span> {o.inc.short_description}</b>
                <small>P{o.inc.priority} · {INC_STATE[o.inc.state]} · {o.inc.subject.kind === 'room' ? 'Whole space' : o.deviceTitle}</small>
              </a>
            ))}
            {advs.map((a) => (
              <a class="card rw" href={href(`/profiles/${pos.cls}/${pos.model}/`)}>
                <span class="rw-k">Warning on this model · {ADV_LEVEL[a.level]}</span>
                <b>{a.title}</b>
                <small>{a.action}</small>
              </a>
            ))}
            {labs.map((l) => (
              <a class="card rw" href={href(`/lab/#${l.id.toLowerCase()}`)}>
                <span class="rw-k">In the Lab</span>
                <b><span class="mono">{l.id}</span> {l.title}</b>
                <small>{l.status}</small>
              </a>
            ))}
          </div>
        </div>

        <div slot="ticket">
          <div class="tk-grid">
            <section class="card pad">
              <h3 class="tk-h">In ServiceNow </h3>
              <dl class="tk">
                <div><dt>Number</dt><dd class="mono">{inc.number}</dd></div>
                <div><dt>Opened</dt><dd>{when(inc.opened, { year: true })}</dd></div>
                <div><dt>Caller</dt><dd>{inc.caller}</dd></div>
                <div><dt>Priority</dt><dd>{inc.priority}, {PRIORITY_LABEL[inc.priority].toLowerCase()}</dd></div>
                <div><dt>Proposed priority</dt><dd>{inc.priority_proposed}, {PRIORITY_LABEL[inc.priority_proposed].toLowerCase()}{override ? <>. Changed to {override.priority} by {overrideBy?.name ?? override.by}, {when(override.at)}: {override.reason}</> : ', not changed'}</dd></div>
                <div><dt>State</dt><dd>{INC_STATE[inc.state]}{v.hold ? `: ${v.hold.holdLabel.toLowerCase()}` : ''}</dd></div>
                <div><dt>Assignment group</dt><dd>{inc.assignment_group}</dd></div>
                {assigned && <div><dt>Assigned to</dt><dd>{assigned.name}</dd></div>}
                <div><dt>Short description</dt><dd>{inc.short_description}</dd></div>
                {inc.description && <div><dt>Description</dt><dd>{inc.description}</dd></div>}
                {v.resolution && <div><dt>Resolution code</dt><dd>{RES_LABEL[v.resolution.code]}</dd></div>}
                {v.resolution && <div><dt>Resolution notes</dt><dd>{v.resolution.notes}</dd></div>}
              </dl>
            </section>
            <section class="card pad">
              <h3 class="tk-h">Added by Keia Atlas</h3>
              <dl class="tk">
                <div><dt>About</dt><dd>{isRoom ? `The whole space, ${v.roomTitle}` : <>{v.deviceTitle}, <span class="mono">{unit.asset_tag}</span></>}</dd></div>
                <div><dt>Where</dt><dd>{v.where}</dd></div>
                <div><dt>Matched by</dt><dd>{inc.keia_atlas.matched_by}</dd></div>
                {inc.keia_atlas.symptom && <div><dt>Symptom in the guide</dt><dd>{words(inc.keia_atlas.symptom)}</dd></div>}
                {fwReported && <div><dt>Firmware reported</dt><dd class="mono">{fwReported}</dd></div>}
                <div><dt>Evidence</dt><dd>{inc.keia_atlas.evidence.length} {inc.keia_atlas.evidence.length === 1 ? 'finding' : 'findings'}</dd></div>
              </dl>
            </section>
          </div>
          <details class="card pad sn-flow">
            <summary><b>How Keia Atlas and ServiceNow connect</b></summary>
            <ol class="snf">
              <li class="snf-sn"><span class="snf-n mono">1</span><b>A ticket arrives in ServiceNow</b><span>The service desk works it there, as today.</span></li>
              <li><span class="snf-n mono">2</span><b>Keia Atlas reads it</b><span>Through ServiceNow's Table API every few minutes, or ServiceNow pushes it on change.</span><span class="stg">Simulated</span></li>
              <li><span class="snf-n mono">3</span><b>Matches space and device</b><span>From the ticket's location, the caller's booking or a named space.</span><span class="stg">Simulated</span></li>
              <li><span class="snf-n mono">4</span><b>Adds evidence</b><span>Device management, monitoring, calendar and open project work.</span><span class="stg">Simulated</span></li>
              <li><span class="snf-n mono">5</span><b>Writes a work note back</b><span>Only once someone approves; ServiceNow stays the record.</span><span class="stg">Simulated</span></li>
            </ol>
          </details>
        </div>
    </DetailTabs>
  </div>


  <script is:inline data-astro-rerun slot="end">
    (function () {
      var page = document.querySelector('.inc-page'); if (!page) return;
      // Stage 4: approve the work note. It takes effect at once and offers Undo for a few seconds (rule P7).
      var note = page.querySelector('[data-note]');
      if (note) {
        var send = note.querySelector('[data-note-send]'), done = note.querySelector('[data-note-done]'), act = note.querySelector('.dc-note-act');
        var list = page.querySelector('[data-history]'), row = null, timer = null;
        var who = (document.querySelector('[data-who-name]') || {}).textContent || 'You';
        send.addEventListener('click', function () {
          act.hidden = true; done.hidden = false;
          var d = new Date(), hm = ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2);
          row = document.createElement('li'); row.className = 'ih-row k-ticket added';
          row.innerHTML = '<span class="ih-when mono">Just now, ' + hm + '</span><span class="ih-ic" aria-hidden="true"></span><span class="ih-body"><b>Work note from Keia Atlas</b><span></span><small>Approved by ' + who.replace(/[<>&]/g, '') + ' · Keia Atlas</small></span>';
          row.querySelector('.ih-body span').textContent = note.querySelector('[data-note-text]').textContent;
          if (list) list.insertBefore(row, list.firstChild);
          clearTimeout(timer);
          timer = setTimeout(function () { var u = done.querySelector('[data-note-undo]'); if (u) u.hidden = true; }, 6000);
        });
        note.querySelector('[data-note-undo]').addEventListener('click', function () {
          clearTimeout(timer);
          if (row && row.parentNode) row.parentNode.removeChild(row);
          row = null; done.hidden = true; act.hidden = false; send.focus();
        });
      }
    })();
  </script>
</Shell>

