---
// The room guide: what the QR code on a room's table opens. Phone first, one page, plain words.
// Order: what we already know is wrong (if anything), the room and whether it is working, the two-tap report
// (GuideReport: tap 1 opens the symptoms in place, tap 2 sends; the status then reads back here), the room
// drawing, how to start a meeting, share a screen and use the touch panel, then access in this room (hearing
// loop, captions, step-free) and the privacy notice for its cameras and microphones. All from the room's own
// data (src/lib/guide.mjs, src/pages/guide/_room.mjs).
import Guide from '../../layouts/Guide.astro';
import RoomScene from '../../components/RoomScene.astro';
import DeviceArt from '../../components/DeviceArt.astro';
import GuideLive from '../../components/GuideLive.astro';
import GuideReport from '../../components/GuideReport.astro';
import HealthGlyph from '../../components/HealthGlyph.astro';
import { href } from '../../lib/data.mjs';
import { PLATFORMS, dayWords } from '../../lib/guide.mjs';
import { guidePaths, guideRoom, knownText } from './_room.mjs';

export const getStaticPaths = guidePaths;
const { room } = Astro.params;
const R = guideRoom(room);
const { x, site, title, office, known, g, privacy, accessRows, access } = R;
const floor = site.floors?.find((f) => f.id === x.floor)?.name;
const seats = x.type.keia_atlas.capacity?.max;
const pins = known.map((v) => v.sceneKey).filter(Boolean);
const G = R.home;
// Start a meeting shows what runs the call (the video bar or codec); the touch panel has its own card.
const startArt = g.bar?.model ?? g.monitor?.model;
const startCls = g.bar?.class ?? g.monitor?.class ?? 'display';
const sub = [office, floor, seats ? `${seats} seats` : null].filter(Boolean).join(' · ');
// The answer, in the employee's words: is this space working, and do we already know if not.
// With a known problem the box above says what it is, so the answer speaks for the rest of the space.
const ANSWER = known.length ? 'Everything else in this space is working' : 'Everything in this space is working';
---
<Guide title={title} office={office} home={G}>
  <div class="g-room" data-guide-room data-room={room}>
    {known.length > 0 && (
      <section class="g-known" aria-labelledby="g-known-h" data-help="guide.known">
        <HealthGlyph state={known[0].inc.state === 'new' ? 'review' : 'progress'} size={24} title="We know" />
        <div>
          <h2 id="g-known-h">We know</h2>
          <ul>
            {known.map((v) => <li><b>{v.inc.short_description}.</b> {knownText(v)}</li>)}
          </ul>
        </div>
      </section>
    )}

    <section class="g-hero" aria-label="The room">
      <div class="g-id">
        <p class="g-over">{x.type.profile.name}</p>
        <h1 transition:name="g-room-title">{title}</h1>
        <p class="g-sub">{sub}</p>
        <p class="g-answer" data-help="guide.answer" data-guide-answer><HealthGlyph state="fine" size={16} title={ANSWER} /><span data-answer-text>{ANSWER}</span></p>
      </div>
      <div class="g-actions">
        <GuideReport room={R.forClient} symptoms={R.symptoms} reportHref={href(`${G}report/`)} requestHref={href(`${G}request/`)} />
      </div>
      <div class="g-pic" transition:name="g-room-pic">
        <RoomScene option={x.option} type={x.space_type} fitted={x.fitted} space={x} uid={`g-${room}`} highlight={pins} tone="bad" label={`Drawing of ${title}`} />
      </div>
    </section>

    <nav class="g-jump" aria-label="On this page">
      <a href="#start">Start a meeting</a>
      {g.share && <a href="#share">Share your screen</a>}
      {g.panelLines && <a href="#panel">The touch panel</a>}
      {accessRows.length > 0 && <a href="#access">Access</a>}
      <a href="#privacy">Privacy</a>
    </nav>

    <div class="g-howto">
      <section class="g-card g-start" id="start" aria-labelledby="h-start">
        <header><h2 id="h-start">Start a meeting</h2><p>{g.joinLede}</p></header>
        <div class="g-plat" role="radiogroup" aria-label="Your meeting app">
          {PLATFORMS.map((p, i) => (
            <label><input type="radio" name="g-plat" value={p.id} checked={i === 0} data-plat /><span>{p.label}</span></label>
          ))}
        </div>
        <div class="g-how">
          <div class="g-art" aria-hidden="true"><DeviceArt model={startArt} cls={startCls} small /></div>
          {PLATFORMS.map((p) => (
            <ol class="g-steps" data-p={p.id}>{g.join[p.id].map((l) => <li>{l}</li>)}</ol>
          ))}
        </div>
      </section>

      {g.share && (
        <section class="g-card" id="share" aria-labelledby="h-share">
          <header><h2 id="h-share">Share your screen</h2><p>{g.share.cable} cable {g.share.where}{g.share.wireless ? ', or without a cable' : ''}.</p></header>
          <div class="g-how">
            <div class="g-art" aria-hidden="true">
              <svg class="g-cable" viewBox="0 0 160 96">
                <rect x="14" y="18" width="70" height="46" rx="4" class="gc-lid" /><rect x="20" y="24" width="58" height="34" rx="2" class="gc-screen" />
                <path d="M6 66h86l-6 8H12z" class="gc-base" />
                <path d="M92 60c18 0 20-22 38-22" class="gc-wire" />
                <rect x="128" y="31" width="22" height="14" rx="4" class="gc-plug" /><rect x="134" y="36" width="10" height="4" rx="2" class="gc-port" />
              </svg>
            </div>
            <ol class="g-steps">{g.share.lines.map((l) => <li>{l}</li>)}</ol>
          </div>
          {g.share.wireless && <p class="g-tip">{g.share.wireless}</p>}
        </section>
      )}

      {g.panelLines && (
        <section class="g-card" id="panel" aria-labelledby="h-panel">
          <header><h2 id="h-panel">The touch panel</h2><p>On the table, closest to the screen.</p></header>
          <div class="g-how">
            <div class="g-art" aria-hidden="true"><DeviceArt model={g.panel.model} cls="touch-controller" small /></div>
            <ol class="g-steps">{g.panelLines.map((l) => <li>{l}</li>)}</ol>
          </div>
        </section>
      )}

      {(g.door || g.board) && (
        <section class="g-card g-extra" aria-label="Also in this room">
          {g.door && <p><b>Booking panel by the door.</b> {g.door.replace(/^The panel by the door /, 'It ')}</p>}
          {g.board && <p><b>Whiteboard camera.</b> {g.board.replace(/^The camera over the whiteboard /, 'It ')}</p>}
        </section>
      )}
    </div>

    <div class="g-more">
      {accessRows.length > 0 && (
        <section class="g-card g-access" id="access" aria-labelledby="h-access" data-help="guide.access">
          <header><h2 id="h-access">Access in this room</h2><p>For hearing, sight and mobility. Tell the office team if anything here is not right.</p></header>
          <ul class="g-rows">
            {accessRows.map((r) => (
              <li>
                <HealthGlyph state={r.state} size={24} title={r.title} />
                <span><b>{r.title}</b><span class="g-row-l">{r.line}</span>{r.note && <span class="g-row-n">{r.note}</span>}</span>
              </li>
            ))}
          </ul>
          <p class="g-fine">Last walked through on {dayWords(access.checked)}. Checked by: {access.checked_by}. Made up for the demo.</p>
        </section>
      )}

      <section class="g-card g-privacy" id="privacy" aria-labelledby="h-privacy" data-help="guide.privacy">
        <header>
          <h2 id="h-privacy">{privacy.any ? 'Cameras and microphones' : 'Privacy in this room'}</h2>
          <p>{privacy.lead}</p>
        </header>
        {privacy.points.length > 0 && <ul class="g-dots">{privacy.points.map((t) => <li>{t}</li>)}</ul>}
        {privacy.never.length > 0 && (
          <div class="g-never">
            <p><b>Never, in any room</b></p>
            <ul>{privacy.never.map((t) => <li>{t}</li>)}</ul>
          </div>
        )}
        {privacy.small && <p class="g-fine">{privacy.small} From Aigna's privacy records; made up for the demo, not legal advice.</p>}
      </section>
    </div>

    <section class="g-end" aria-label="Still stuck?">
      <p>Still stuck? The {office} team can help.</p>
      <a class="btn primary" href={href(`${G}report/`)}>Report a problem</a>
      <a class="g-staff" href={href(`/rooms/${room}/#room-guide`)}>For IT staff: this room in Keia Atlas</a>
    </section>
  </div>
  <GuideLive />
  <script is:inline data-astro-rerun>
    (function () {
      // Remember the meeting app someone picked, for the next room they scan.
      var k = 'rs-guide-platform', v = null;
      try { v = localStorage.getItem(k); } catch (_) {}
      if (v) { var r = document.querySelector('[data-plat][value="' + v + '"]'); if (r) r.checked = true; }
      document.querySelectorAll('[data-plat]').forEach(function (r) { r.addEventListener('change', function () { try { localStorage.setItem(k, r.value); } catch (_) {} }); });
    })();
  </script>
</Guide>

<style>
  /* Sizes come from the guide's own scale (--g-fs-*, src/layouts/Guide.astro): larger than the console's, for a phone held at arm's length. */
  .g-room { display: grid; gap: 16px; }
  /* What we already know: first, calm, specific. The glyph says the state; the tint is the one soft colour. */
  .g-known { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 12px; align-items: start; padding: 14px 16px; border-radius: var(--radius-lg); background: var(--h-progress-soft); color: var(--text); }
  .g-known h2 { font: var(--fw-title) var(--g-fs-body)/24px var(--font-sans); margin: 0 0 4px; }
  .g-known ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; font-size: var(--g-fs-support); line-height: 1.45; }

  .g-hero { display: grid; gap: 14px; }
  .g-answer { display: flex; align-items: center; gap: 8px; margin: 8px 0 0; font-size: var(--g-fs-support); color: var(--text); }
  .g-over { margin: 0; font: 500 var(--fs-overline)/1.2 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--text-3); }
  .g-id h1 { font-size: var(--g-fs-title); line-height: 1.1; margin: 4px 0 4px; letter-spacing: -.01em; }
  .g-sub { margin: 0; color: var(--text-2); font-size: var(--g-fs-support); }
  .g-pic { border-radius: var(--radius-lg); background: var(--surface); border: var(--border-card); padding: 8px; overflow: hidden; }
  /* The drawing without its technical layers: no numbers, rulers, plates, cables or hidden kit. */
  .g-pic :global(.scene-tools), .g-pic :global(.scene-cap), .g-pic :global(.marks), .g-pic :global(.ruler), .g-pic :global(.dim),
  .g-pic :global(.cable-layer), .g-pic :global(.ghosts), .g-pic :global(.scene .pl), .g-pic :global(.scene .hid) { display: none; }
  .g-pic :global(.scene) { display: block; width: 100%; height: auto; max-height: 34svh; }
  .g-actions { display: grid; scroll-margin-top: 72px; }

  .g-jump { display: flex; flex-wrap: wrap; gap: 8px; }
  .g-jump a { font-size: var(--g-fs-support); font-weight: 600; padding: 10px 14px; min-height: 44px; display: inline-flex; align-items: center; border-radius: 999px; background: var(--surface-2); color: var(--text); text-decoration: none; }
  .g-jump a:hover { background: var(--surface-3); color: var(--text); }

  .g-howto, .g-more { display: grid; gap: 16px; }
  .g-card { scroll-margin-top: 72px; display: grid; gap: 14px; padding: 18px 16px; border-radius: var(--radius-lg); background: var(--surface); border: var(--border-card); }
  .g-card header h2 { font-size: var(--g-fs-h); }
  .g-card header p { margin: 4px 0 0; color: var(--text-2); font-size: var(--g-fs-support); line-height: 1.45; }
  .g-how { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; align-items: center; }
  .g-art { display: grid; place-items: center; padding: 8px; border-radius: var(--radius); background: var(--surface-2); min-height: 112px; }
  .g-art :global(svg) { width: min(100%, 260px); height: auto; }
  .g-steps { margin: 0; padding: 0; list-style: none; counter-reset: s; display: grid; gap: 10px; }
  .g-steps li { counter-increment: s; display: grid; grid-template-columns: 30px minmax(0, 1fr); gap: 12px; align-items: start; font-size: var(--g-fs-body); line-height: 1.45; }
  .g-steps li::before { content: counter(s); width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--ink); color: var(--on-ink); font: var(--fw-title) var(--fs-code)/1 var(--font-mono); margin-top: -1px; }
  .g-tip { margin: 0; padding: 10px 12px; border-radius: var(--radius); background: var(--surface-2); color: var(--text); font-size: var(--g-fs-support); }

  /* The meeting app switch: word pills; the matching steps show, and arrive with a short rise. */
  .g-plat { display: flex; flex-wrap: wrap; gap: 6px; padding: 4px; border-radius: 999px; background: var(--surface-2); justify-self: start; }
  .g-plat label { position: relative; }
  .g-plat input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .g-plat span { display: inline-flex; align-items: center; min-height: 40px; padding: 0 16px; border-radius: 999px; font-weight: 600; font-size: var(--g-fs-support); color: var(--text-2); transition: background var(--dur-state) var(--ease-settle), color var(--dur-state); }
  .g-plat input:checked + span { background: var(--surface); color: var(--text); box-shadow: var(--shadow-sm, 0 1px 2px rgba(0,0,0,.08)); }
  .g-plat input:focus-visible + span { outline: 2px solid var(--focus); outline-offset: 2px; }
  .g-start .g-steps { display: none; }
  .g-start:has([value="meet"]:checked) [data-p="meet"], .g-start:has([value="teams"]:checked) [data-p="teams"], .g-start:has([value="zoom"]:checked) [data-p="zoom"] { display: grid; animation: rise var(--dur-enter) var(--ease-settle) backwards; }

  .g-cable .gc-lid { fill: var(--surface); stroke: var(--text-2); stroke-width: 2; }
  .g-cable .gc-screen { fill: var(--h-progress-soft); }
  .g-cable .gc-base { fill: var(--surface-3); stroke: var(--text-2); stroke-width: 2; stroke-linejoin: round; }
  .g-cable .gc-wire { fill: none; stroke: var(--accent); stroke-width: 4; stroke-linecap: round; stroke-dasharray: 90; stroke-dashoffset: 90; animation: g-draw var(--dur-morph) var(--ease-settle) var(--dur-pop) forwards; }
  .g-cable .gc-plug { fill: var(--ink); } .g-cable .gc-port { fill: var(--surface-3); }
  @keyframes g-draw { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .g-cable .gc-wire { animation: none; stroke-dashoffset: 0; } }

  .g-extra { gap: 10px; }
  .g-extra p { margin: 0; font-size: var(--g-fs-support); line-height: 1.45; }

  /* Access and privacy: one row per thing, glyph and word first, then the plain line. */
  .g-rows { margin: 0; padding: 0; list-style: none; display: grid; }
  .g-rows li { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 12px; align-items: start; padding: 12px 0; border-top: 1px solid var(--line); }
  .g-rows li:first-child { border-top: 0; padding-top: 0; }
  .g-rows b { display: block; font: var(--fw-name) var(--g-fs-body)/24px var(--font-sans); }
  .g-row-l, .g-row-n { display: block; font-size: var(--g-fs-support); line-height: 1.45; color: var(--text-2); }
  .g-row-n { margin-top: 4px; color: var(--text); }
  .g-dots { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; }
  .g-dots li { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 10px; font-size: var(--g-fs-support); line-height: 1.45; }
  .g-dots li::before { content: ""; width: 7px; height: 7px; margin: 8px 0 0 4px; border-radius: 50%; background: var(--text-3); }
  .g-never { padding: 12px 14px; border-radius: var(--radius); background: var(--surface-2); }
  .g-never p { margin: 0 0 6px; font-size: var(--g-fs-support); }
  .g-never ul { margin: 0; padding-left: 18px; display: grid; gap: 4px; font-size: var(--g-fs-support); line-height: 1.4; color: var(--text-2); }
  .g-fine { margin: 0; font-size: var(--fs-support); line-height: 1.45; color: var(--text-3); }

  .g-end { display: grid; justify-items: center; gap: 12px; text-align: center; padding: 20px 0 4px; }
  .g-end p { margin: 0; color: var(--text-2); font-size: var(--g-fs-support); }
  .g-end .btn { min-height: 48px; padding-inline: 28px; font-size: var(--g-fs-body); }
  .g-staff { font-size: var(--fs-support); color: var(--text-3); }

  /* Wider: the room beside its two actions, the how-to cards side by side, picture beside the steps. */
  @media (min-width: 600px) {
    .g-how { grid-template-columns: 200px minmax(0, 1fr); gap: 20px; }
    .g-card { padding: 22px 24px; }
  }
  @media (min-width: 900px) {
    .g-hero { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); grid-template-areas: "id id" "pic act"; column-gap: 20px; align-items: start; }
    .g-id { grid-area: id; } .g-pic { grid-area: pic; } .g-actions { grid-area: act; }
    /* Once a report is sent, its status takes the full width and the drawing follows it. */
    .g-hero:has([data-view="sent"]) { grid-template-areas: "id id" "act act" "pic pic"; }
    .g-howto, .g-more { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }
    .g-start, .g-extra { grid-column: 1 / -1; }
    .g-howto .g-how { grid-template-columns: minmax(0, 1fr); }
    .g-start .g-how { grid-template-columns: 240px minmax(0, 1fr); }
  }
</style>
