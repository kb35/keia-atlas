---
// Report a problem from the room guide, as its own page: GuideReport opened at the symptom list. The room
// guide itself does the same in place (tap 1 there opens this list without leaving the page); this page is
// where "Report a problem" at the foot of the guide goes, and the address that works without scripts.
// One tap on a symptom sends it; the status then reads back here. The incident goes through the live layer
// and shows on the Incidents board, the office page and Home in other windows.
import Guide from '../../../layouts/Guide.astro';
import GuideReport from '../../../components/GuideReport.astro';
import GuideLive from '../../../components/GuideLive.astro';
import { href } from '../../../lib/data.mjs';
import { guidePaths, guideRoom } from '../_room.mjs';

export const getStaticPaths = guidePaths;
const R = guideRoom(Astro.params.room);
---
<Guide title={`Report a problem, ${R.title}`} office={R.office} home={R.home}>
  <p class="gp-room"><span>{R.x.type.profile.name}</span> <b transition:name="g-room-title">{R.title}</b></p>
  <GuideReport room={R.forClient} symptoms={R.symptoms} reportHref={href(`${R.home}report/`)} requestHref={href(`${R.home}request/`)} back={href(R.home)} open known={R.knownLine} />
  <a class="gp-staff" href={R.staffBoard}>For IT staff: see it on the Incidents board</a>
  <GuideLive />
</Guide>

<style>
  .gp-room { margin: 0; display: grid; gap: 2px; }
  .gp-room span { font: 500 var(--fs-overline)/1.2 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--text-3); }
  .gp-room b { font: var(--fw-title) var(--g-fs-lead)/1.2 var(--font-display); }
  .gp-staff { justify-self: center; font-size: var(--fs-support); color: var(--text-3); }
</style>
