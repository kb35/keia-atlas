---
// /services/av/, /services/network/ and /services/infrastructure/: one service, whole. The page is _Service.astro.
import Service from './_Service.astro';
import { SERVICE_ORDER } from '../../lib/services.mjs';

export function getStaticPaths() {
  return SERVICE_ORDER.map((id) => ({ params: { id } }));
}
const { id } = Astro.params;
---
<Service id={id} />
