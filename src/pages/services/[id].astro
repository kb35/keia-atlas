---
// /services/<id>/: one service, whole. The live three (AV, Network, IT infrastructure) are _Service.astro; the rest of
// the catalogue (src/lib/catalogue.mjs) is _Catalogue.astro. Events and experience centres has its own folder
// (/services/events/, with a page per event).
import Service from './_Service.astro';
import Catalogue from './_Catalogue.astro';
import { SERVICE_ORDER } from '../../lib/services.mjs';
import { NEW_SERVICES } from '../../lib/catalogue.mjs';

export function getStaticPaths() {
  return [...SERVICE_ORDER, ...NEW_SERVICES.filter((id) => id !== 'events')].map((id) => ({ params: { id } }));
}
const { id } = Astro.params;
---
{SERVICE_ORDER.includes(id) ? <Service id={id} /> : <Catalogue id={id} />}
