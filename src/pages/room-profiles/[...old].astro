---
// A room profile whose id changed (src/lib/moved-types.mjs): the old address sends the browser on.
import Moved from '../../components/Moved.astro';
import { MOVED_TYPES } from '../../lib/moved-types.mjs';
export async function getStaticPaths() {
  return Object.entries(MOVED_TYPES).map(([old, to]) => ({ params: { old }, props: { to } }));
}
const { to } = Astro.props;
---
<Moved to={`/room-profiles/${to}/`} />
