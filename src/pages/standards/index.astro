---
// The standards library (List archetype, docs/standards/page-anatomy.md): every house standard integrators build to,
// by area. Band, filter bar (Area and Based on), the standards as cards or rows, then the public standards the
// library names. Each card opens the standard's page. Data: data/standards/ through ./_lib.mjs.
import Shell from '../../layouts/Shell.astro';
import PageBand from '../../components/PageBand.astro';
import FilterBar from '../../components/FilterBar.astro';
import Section from '../../components/Section.astro';
import EmptyState from '../../components/EmptyState.astro';
import { href, plural, fmtDate, DEMO_TODAY } from '../../lib/data.mjs';
import { library, AREAS, AREA_LABEL, AREA_GLYPH, BASED, KIND_LABEL, publicSources, totals, byId } from './_lib.mjs';

const P = library.map((s, i) => ({ id: s.id, i, name: s.name, rules: s.counts.rules }));
const FACETS = [
  { key: 'area', label: 'Area', options: AREAS.map((a) => ({ value: a.id, label: a.label })) },
  { key: 'based', label: 'Based on', options: Object.entries(BASED).map(([value, label]) => ({ value, label })) },
];
const VIEWS = [{ value: 'cards', label: 'Cards', show: '[data-grid]' }, { value: 'list', label: 'List', show: '[data-list]' }];
const SORT = { options: [{ value: 'area', label: 'By area' }, { value: 'name', label: 'By name' }, { value: 'rules', label: 'Most rules first' }] };
const NUMBERS = [
  { n: totals.standards, label: 'Standards' },
  { n: totals.rules, label: 'Rules' },
  { n: totals.house, label: 'House choices', to: '?based=house' },
  { n: totals.publicSources, label: 'Public standards named', to: '#public-standards' },
];
const coming = library.filter((s) => s.effective > DEMO_TODAY).sort((a, b) => a.effective.localeCompare(b.effective));
const answer = coming.length
  ? `${totals.standards - coming.length} of ${totals.standards} standards in force · ${coming.length} new from ${fmtDate(coming[0].effective, { day: 'numeric', month: 'short' })}`
  : `All ${totals.standards} standards in force · ${plural(totals.rules, 'rule')}`;
const attrs = (s) => ({
  'data-fi': '', 'data-id': s.id,
  'data-find': [s.name, AREA_LABEL[s.area], s.summary, ...(s.publicNames ?? []), ...(s.rules ?? []).map((r) => r.rule)].join(' '),
  'data-f-area': s.area, 'data-f-based': s.based.join('|'),
});
const stdLabel = (id) => byId[id]?.name ?? id;
---
<Shell vendorOk title="Standards" section="standards" crumbs={[{ label: 'Standards' }]}>
  <PageBand overline="Library" title="Standards" answer={answer} lede="How Aigna's offices are built and set up: the rules integrators follow, why, and how each is checked." numbers={NUMBERS} />

  <div class="content stdl">
    <FilterBar facets={FACETS} placeholder="Find a standard, rule or source" label="Find a standard" noun={['standard', 'standards']} scope=".content.stdl" views={VIEWS} viewKey="rs5-standards-view" sort={SORT} />

    <div class="stdl-grid" data-grid>
      {library.map((s) => (
        <a class="card stdl-card" href={href(s.href)} data-help="std.card" data-help-name={s.name} {...attrs(s)}>
          <span class="stdl-top">
            <span class="stdl-glyph" aria-hidden="true"><svg viewBox="0 0 40 28" width="34" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={AREA_GLYPH[s.area]} /></span>
            <span class="overline">{AREA_LABEL[s.area]}</span>
            <span class="faint stdl-ver">v{s.version}</span>
          </span>
          <span class="stdl-name" data-vt-rec={s.id}>{s.name}</span>
          <span class="muted stdl-sum">{s.summary}</span>
          <span class="stdl-counts">
            <span><b class="num">{s.counts.rules}</b> rules</span>
            {s.kind === 'house' && <span><b class="num">{s.counts.must}</b> must</span>}
            {s.kind === 'house' && <span><b class="num">{s.counts.house}</b> house choices</span>}
          </span>
          {s.publicNames?.length > 0 && <span class="stdl-based faint">Leans on {s.publicNames.slice(0, 3).join(', ')}{s.publicNames.length > 3 ? ` and ${s.publicNames.length - 3} more` : ''}</span>}
        </a>
      ))}
    </div>

    <div class="list stdl-list" data-list hidden>
      {library.map((s) => (
        <a class="row stdl-row" href={href(s.href)} data-help="std.card" data-help-name={s.name} {...attrs(s)}>
          <span class="stdl-glyph" aria-hidden="true"><svg viewBox="0 0 40 28" width="30" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={AREA_GLYPH[s.area]} /></span>
          <span class="stdl-rt">
            <b class="name">{s.name}</b>
            <span class="sub">{AREA_LABEL[s.area]} · {s.summary}</span>
          </span>
          <span class="end">
            <span class="faint">{plural(s.counts.rules, 'rule')}</span>
          </span>
        </a>
      ))}
    </div>

    <EmptyState text="No standards match these filters." />

    <Section title="Public standards named" id="public-standards" aside="Named and summarised in our own words. The standards themselves are published, and most are sold, by their bodies." showAll={8} help="std.sources">
      <div class="list stdl-src" data-items>
        {publicSources.map((r) => (
          <div class="row stdl-srow">
            <span class="stdl-sname">
              {r.href ? <a href={r.href} target="_blank" rel="noopener"><b>{r.short}</b></a> : <b>{r.short}</b>}
              <small class="faint">{KIND_LABEL[r.kind]}{r.publisher ? ` · ${r.publisher}` : ''}</small>
            </span>
            <span class="stdl-ssum muted">{r.summary}</span>
            <span class="stdl-sstd">{r.stds.map((id) => <a class="tag" href={href(`/standards/${id}/`)}>{stdLabel(id)}</a>)}</span>
          </div>
        ))}
      </div>
    </Section>
  </div>

  <script is:inline data-astro-rerun define:vars={{ P }} slot="end">
    (function () {
      var grid = document.querySelector('.stdl [data-grid]'), listEl = document.querySelector('.stdl [data-list]'), bar = document.querySelector('[data-fb]'); if (!grid || !listEl || !bar) return;
      var cards = new Map(Array.prototype.map.call(grid.children, function (el) { return [el.dataset.id, el]; }));
      var rows = new Map(Array.prototype.map.call(listEl.children, function (el) { return [el.dataset.id, el]; }));
      var sort = bar.rsFilter ? bar.rsFilter.sort() : (new URLSearchParams(location.search).get('sort') || 'area');
      function reorder() {
        P.slice().sort(function (a, b) {
          var c = 0;
          if (sort === 'name') c = a.name.localeCompare(b.name, 'en');
          else if (sort === 'rules') c = b.rules - a.rules;
          return c || a.i - b.i;
        }).forEach(function (p) { grid.appendChild(cards.get(p.id)); listEl.appendChild(rows.get(p.id)); });
      }
      bar.addEventListener('fb:sort', function (e) { sort = e.detail.value; bar.rsFilter.run(true, reorder); });
      reorder();
    })();
  </script>
</Shell>
<style is:global>
  .stdl-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 20px; }
  .stdl-grid[hidden], .stdl-list[hidden] { display: none; }
  .stdl-card { display: flex; flex-direction: column; gap: 10px; padding: 18px 20px; color: inherit; text-decoration: none; transition: transform var(--dur-hover) var(--ease-settle), box-shadow var(--dur-hover) var(--ease-settle); }
  .stdl-card:hover { color: inherit; transform: translateY(-2px); box-shadow: var(--shadow-md); }
  :root[data-look="classic"] .stdl-card { border: 2px solid var(--ink); }
  .stdl-top { display: flex; align-items: center; gap: 10px; }
  .stdl-glyph { display: inline-grid; place-items: center; flex: none; width: 44px; height: 36px; border-radius: 10px; background: var(--surface-2); color: var(--text-2); box-shadow: inset 0 0 0 1px var(--line); }
  .stdl-ver { margin-left: auto; font: 600 var(--fs-code) var(--font-mono); }
  .stdl-name { font: var(--weight-display) 22px/1.15 var(--font-display); letter-spacing: -.02em; }
  .stdl-sum { font-size: var(--fs-body); }
  .stdl-counts { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: auto; font-size: var(--fs-support); color: var(--text-2); }
  .stdl-counts b { color: var(--text); }
  .stdl-based { font-size: var(--fs-code); }
  .stdl-row { grid-template-columns: auto minmax(0, 1fr) auto; }
  .stdl-row .stdl-glyph { width: 40px; height: 32px; }
  .stdl-rt { display: grid; gap: 2px; min-width: 0; }
  .stdl-rt .sub { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .stdl-srow { grid-template-columns: minmax(0, 14rem) minmax(0, 1fr) minmax(0, 16rem); align-items: start; gap: 6px 18px; }
  .stdl-sname { display: grid; gap: 2px; min-width: 0; overflow-wrap: anywhere; }
  .stdl-ssum { font-size: var(--fs-body); }
  .stdl-sstd { display: flex; flex-wrap: wrap; gap: 5px; justify-content: flex-end; }
  .stdl-sstd .tag { text-decoration: none; white-space: normal; max-width: 100%; height: auto; line-height: 1.3; }
  @container content (max-width: 839px) {
    .stdl-srow { grid-template-columns: minmax(0, 1fr); }
    .stdl-sstd { justify-content: flex-start; }
  }
  @container content (max-width: 559px) {
    .stdl-rt .sub { white-space: normal; }
  }
</style>
