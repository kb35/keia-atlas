---
// One house standard (Record archetype, docs/standards/page-anatomy.md): the band with the standard's headline
// figures, then the checklist of must rules beside a SidePanel (who owns it, what it applies to, related
// standards), then one Section per part of the standard, each rule with why, how to check it and its source,
// and the sources last. Written for integrators: do this, check this. Data: data/standards/<id>.yaml.
import Shell from '../../layouts/Shell.astro';
import PageBand from '../../components/PageBand.astro';
import SidePanel from '../../components/SidePanel.astro';
import Section from '../../components/Section.astro';
import Icon from '../../components/Icon.astro';
import Figure from './_Figure.astro';
import { recHere } from '../../lib/vt.mjs';
import { href, fmtDate, plural } from '../../lib/data.mjs';
import { houseStandards, byId, AREA_LABEL, AREA_GLYPH, KIND_LABEL } from './_lib.mjs';
import { cableStandard, colours } from '../../lib/stock.mjs';

export function getStaticPaths() {
  return houseStandards.map((s) => ({ params: { id: s.id }, props: { s } }));
}
const { s } = Astro.props;
const refOf = Object.fromEntries(s.refs.map((r) => [r.id, r]));
const short = (name) => name.split(/,\s/)[0];
const should = s.counts.rules - s.counts.must;
const NUMBERS = (s.figures ?? []).map((f) => ({ n: f.n, label: f.label }));
const musts = s.sections.map((sec) => ({ sec, rules: sec.rules.filter((r) => r.level === 'must') })).filter((g) => g.rules.length);
const related = (s.related ?? []).map((id) => byId[id]).filter(Boolean);
const APPLIES = [
  ['Device types', s.links.classes], ['Models', s.links.models], ['Setup guides', s.links.configurations], ['Space types', s.links.rooms],
].filter(([, list]) => list.length);
const coded = cableStandard.purposes.filter((p) => p.coded !== false);
---
<Shell vendorOk title={s.name} section="standards" about={{ kind: 'standard', label: s.name, to: `/standards/${s.id}/` }}
  crumbs={[{ label: 'Standards', to: '/standards/' }, ...(AREA_LABEL[s.area] === s.name ? [] : [{ label: AREA_LABEL[s.area], to: `/standards/?area=${s.area}` }]), { label: s.name }]}>
  <PageBand overline="Standard" title={s.name} lede={s.summary} numbers={NUMBERS} rec={s.id}>
    <Fragment slot="overline">
      <a href={href(`/standards/?area=${s.area}`)}>{AREA_LABEL[s.area]}</a>
      <span>Version {s.version}</span>
    </Fragment>
    <button slot="action" type="button" class="btn primary" data-open-report="change">Propose an edit</button>
  </PageBand>

  <div class="content std">
    <div class="g12 top">
      <section class="card pad s-7 stick std-check" aria-labelledby="std-check-h" data-help="std.checklist">
        <div class="std-check-head">
          <span class="std-glyph" aria-hidden="true"><svg viewBox="0 0 40 28" width="40" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={AREA_GLYPH[s.area]} /></span>
          <div>
            <h2 id="std-check-h">The must rules</h2>
            <p class="muted">{plural(s.counts.must, 'rule')} every install follows, in the order of this page. {should > 0 && `${plural(should, 'more rule')} ${should === 1 ? 'is' : 'are'} the default with a written exception.`}</p>
          </div>
        </div>
        {s.intro && <p class="std-intro">{s.intro}</p>}
        <ol class="std-musts">
          {musts.map((g) => (
            <li class="std-mg">
              <a class="std-mg-h" href={`#${g.sec.id}`}>{g.sec.title}</a>
              <ul>
                {g.rules.map((r) => (
                  <li><a href={`#r-${r.id}`}><Icon name="check" size={14} /><span>{r.rule}</span></a>{r.house && <span class="std-house" title="Aigna's own choice">House</span>}</li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </section>

      <SidePanel class="s-5" title="About this standard" meta={`Owner: ${s.owner}`} help="std.facts">
        <dl class="kv std-kv">
          <div><dt>Version</dt><dd>{s.version}, in force since {fmtDate(s.effective)}</dd></div>
          <div><dt>Rules</dt><dd>{s.counts.must} must, {should} should</dd></div>
          <div><dt>House choices</dt><dd>{s.counts.house} of {s.counts.rules}</dd></div>
          <div><dt>Sources</dt><dd><a href="#sources">{plural(s.counts.refs, 'source')}</a></dd></div>
        </dl>
        <h3 class="std-ph">Where it applies</h3>
        <ul class="std-scope">{s.scope.map((t) => <li>{t}</li>)}</ul>
        {APPLIES.map(([label, list]) => (
          <div class="std-links">
            <h3 class="std-ph">{label}</h3>
            <p>{list.map((l) => <a class="tag" href={href(l.href)}>{l.label}</a>)}</p>
          </div>
        ))}
        {related.length > 0 && (
          <div class="std-links">
            <h3 class="std-ph">Related standards</h3>
            <p>{related.map((r) => <a class="tag" href={href(r.href)}>{r.name}</a>)}</p>
          </div>
        )}
      </SidePanel>
    </div>

    {s.sections.map((sec) => (
      <Section title={sec.title} id={sec.id} aside={plural(sec.rules.length, 'rule')} class="std-sec">
        {sec.intro && <p class="std-sec-intro">{sec.intro}</p>}
        {sec.figure && <div class="card pad std-fig"><Figure kind={sec.figure} table={sec.table} /></div>}
        {s.id === 'cabling' && sec.id === 'labels' && (
          <div class="card pad std-colours">
            <ul class="std-sw">
              {coded.map((p) => <li><i style={`--sw:${colours[p.colour].hex}`}></i><span><b>{colours[p.colour].name}</b> {p.name}</span></li>)}
            </ul>
            <p class="std-lab"><span class="faint">A label reads</span> <code>{cableStandard.labelling.example}</code> <a class="btn small" href={href('/standards/cables/')}>The colour and label standard<Icon name="arrow" size={14} /></a></p>
          </div>
        )}
        {sec.table && (
          <div class="card tablewrap std-tw">
            <table class="to-cards std-table">
              <caption>{sec.table.caption}</caption>
              <thead><tr>{sec.table.columns.map((c) => <th scope="col">{c}</th>)}</tr></thead>
              <tbody>{sec.table.rows.map((row) => <tr>{row.map((c, i) => (i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>))}</tr>)}</tbody>
            </table>
            {sec.table.note && <p class="std-tnote faint">{sec.table.note}</p>}
          </div>
        )}
        <div class="std-rules">
          {sec.rules.map((r) => (
            <article class:list={['card', 'std-rule', `lv-${r.level}`]} id={`r-${r.id}`} data-help="std.rule">
              <header class="std-rule-h">
                <span class={`pill plain std-lv ${r.level === 'must' ? 'bad' : 'warn'}`} data-help="std.level" data-help-name={r.level === 'must' ? 'Must' : 'Should'}>{r.level === 'must' ? 'Must' : 'Should'}</span>
                {r.house && <span class="pill plain std-hc" data-help="std.house">House choice</span>}
              </header>
              <p class="std-rule-t">{r.rule}</p>
              <dl class="std-wc">
                <div><dt>Why</dt><dd>{r.why}</dd></div>
                <div><dt>How to check</dt><dd>{r.check}</dd></div>
              </dl>
              {(r.sources ?? []).length > 0 && (
                <p class="std-rs faint">Source {r.sources.map((id, i) => <>{i > 0 && ', '}<a href={`#ref-${id}`}>{short(refOf[id].name)}</a></>)}</p>
              )}
            </article>
          ))}
        </div>
      </Section>
    ))}

    <Section title="Sources" id="sources" aside="Public standards are named and summarised in our own words, never quoted. Most are sold by the bodies that publish them." help="std.sources">
      <div class="list std-refs">
        {s.refs.map((r) => (
          <div class="row std-ref" id={`ref-${r.id}`}>
            <span class="std-ref-k"><span class={`pill plain ${r.kind === 'vendor' ? '' : 'deploy'}`}>{KIND_LABEL[r.kind]}</span></span>
            <span class="std-ref-t">
              {r.href ? <a href={r.href} target="_blank" rel="noopener"><b>{r.name}</b><Icon name="link" size={12} /></a> : <b>{r.name}</b>}
              <span class="muted">{r.summary}</span>
              <small class="faint">{[r.publisher, r.checked && `checked ${fmtDate(r.checked)}`].filter(Boolean).join(' · ')}</small>
            </span>
          </div>
        ))}
      </div>
    </Section>
  </div>
</Shell>

<style is:global>
  .std-check { display: grid; gap: 14px; align-content: start; }
  .std-check-head { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 14px; align-items: start; }
  .std-check-head h2 { margin: 0; font-size: var(--h2-size, 20px); }
  .std-check-head p { margin: 4px 0 0; font-size: 13.5px; }
  .std-glyph { display: inline-grid; place-items: center; width: 56px; height: 46px; border-radius: 12px; background: var(--surface-2); color: var(--text-2); box-shadow: inset 0 0 0 1px var(--line); }
  .std-intro { margin: 0; font-size: 14px; color: var(--text-2); max-width: 75ch; }
  .std-musts { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .std-mg-h { font: 700 11.5px/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--text-3); text-decoration: none; }
  .std-mg-h:hover { color: var(--text); }
  .std-mg ul { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 2px; }
  .std-mg li { display: flex; gap: 8px; align-items: flex-start; justify-content: space-between; }
  .std-mg li a { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 8px; align-items: start; padding: 6px 8px; margin-left: -8px; border-radius: 8px; color: var(--text); text-decoration: none; font-size: 14px; line-height: 1.4; transition: background var(--dur-hover) var(--ease-settle); }
  .std-mg li a:hover { background: var(--surface-2); }
  .std-mg li a svg { margin-top: 3px; color: var(--green-ink); }
  .std-house { flex: none; margin-top: 6px; font: 700 10.5px/1 var(--font-mono); letter-spacing: .05em; text-transform: uppercase; color: var(--violet-ink); background: var(--violet-soft); padding: 4px 6px; border-radius: 5px; }
  .std-kv { margin: 0 0 6px; }
  .std-ph { font: 700 11.5px/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--text-3); margin: 16px 0 8px; }
  .std-scope { margin: 0; padding-left: 18px; display: grid; gap: 5px; font-size: 13.5px; color: var(--text-2); }
  .std-links p { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; }
  .std-links .tag { text-decoration: none; white-space: normal; max-width: 100%; height: auto; line-height: 1.3; }
  .std-sec-intro { margin: 0 0 12px; font-size: 14px; color: var(--text-2); max-width: 80ch; }
  .std-fig, .std-colours, .std-tw { margin-bottom: 14px; }
  .std-table caption { caption-side: top; text-align: left; font-weight: 650; font-size: 13.5px; padding: 12px 14px 4px; }
  .std-table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  .std-table th, .std-table td { text-align: left; vertical-align: top; padding: 9px 14px; border-bottom: 1px solid var(--line); }
  .std-table thead th { font: 700 11px/1.2 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--text-3); background: var(--surface-2); }
  .std-table tbody th { font: 650 13.5px/1.4 var(--font-sans); text-transform: none; letter-spacing: 0; color: var(--text); background: none; }
  .std-table tbody tr:last-child > * { border-bottom: 0; }
  .std-tnote { margin: 0; padding: 10px 14px 12px; font-size: 12.5px; border-top: 1px solid var(--line); }
  .std-rules { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .std-rule { display: grid; gap: 10px; align-content: start; padding: 16px 18px; scroll-margin-top: calc(var(--mast-h, 60px) + 16px); }
  .std-rule:target { box-shadow: 0 0 0 2px var(--accent), var(--shadow-sm); }
  .std-rule-h { display: flex; flex-wrap: wrap; gap: 6px; }
  .std-lv, .std-hc { font-size: 11.5px; padding: 4px 8px; }
  .std-hc { background: var(--violet-soft); color: var(--violet-ink); }
  .std-rule-t { margin: 0; font-weight: 650; font-size: 15px; line-height: 1.4; }
  .std-wc { margin: 0; display: grid; gap: 8px; }
  .std-wc div { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 10px; }
  .std-wc dt { font: 700 11px/1.5 var(--font-mono); letter-spacing: .05em; text-transform: uppercase; color: var(--text-3); padding-top: 1px; }
  .std-wc dd { margin: 0; font-size: 13.5px; color: var(--text-2); line-height: 1.45; }
  .std-rs { margin: 0; font-size: 12.5px; }
  .std-sw { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr)); gap: 8px 16px; }
  .std-sw li { display: flex; gap: 10px; align-items: center; font-size: 13.5px; }
  .std-sw i { flex: none; width: 34px; height: 12px; border-radius: 6px; background: var(--sw); box-shadow: inset 0 0 0 1px rgba(128, 128, 128, .55); }
  .std-lab { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin: 14px 0 0; font-size: 13.5px; }
  .std-lab code { font: 600 13px var(--font-mono); background: var(--surface-2); border: 1px solid var(--line); border-radius: 5px; padding: 2px 7px; }
  .std-lab .btn { margin-left: auto; }
  .std-ref { grid-template-columns: 9.5rem minmax(0, 1fr); align-items: start; scroll-margin-top: calc(var(--mast-h, 60px) + 16px); }
  .std-ref:target { background: var(--surface-2); }
  .std-ref-t { display: grid; gap: 3px; min-width: 0; overflow-wrap: anywhere; font-size: 13.5px; }
  .std-ref-t a { display: inline-flex; gap: 6px; align-items: center; width: fit-content; max-width: 100%; }
  @container content (max-width: 1000px) {
    .std-rules { grid-template-columns: minmax(0, 1fr); }
  }
  @container content (max-width: 559px) {
    .std-wc div { grid-template-columns: minmax(0, 1fr); gap: 2px; }
    .std-ref { grid-template-columns: minmax(0, 1fr); }
    .std-lab .btn { margin-left: 0; }
  }
</style>
