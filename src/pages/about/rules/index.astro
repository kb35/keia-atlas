---
// The rule book (docs/rules/*.md) as a page: one tab per chapter, each rule a card, and small live
// examples beside the chapters where seeing it helps. The Markdown is the only copy of the words;
// this page adds the examples and links rule numbers like "(M6)" to their rule.
import Shell from '../../../layouts/Shell.astro';
import Icon from '../../../components/Icon.astro';
import DeviceArt from '../../../components/DeviceArt.astro';
import DeviceGlyph from '../../../components/DeviceGlyph.astro';
import { artParts, artSource } from '../../../lib/art.mjs';
import { href, modelName } from '../../../lib/data.mjs';

const files = import.meta.glob('../../../../docs/rules/*.md', { eager: true });
const CH = [
  { id: 'summary', file: 'README', label: 'Summary', icon: 'book' },
  { id: 'motion', file: 'motion', label: 'Motion', icon: 'pulse' },
  { id: 'layout', file: 'layout', label: 'Layout', icon: 'types' },
  { id: 'devices', file: 'devices', label: 'Devices', icon: 'devices' },
  { id: 'rooms', file: 'rooms', label: 'Spaces', icon: 'room' },
  { id: 'platform', file: 'platform', label: 'Platform', icon: 'search' },
  { id: 'words', file: 'words', label: 'Words', icon: 'edit' },
  { id: 'looks', file: 'looks', label: 'Looks', icon: 'sun' },
  { id: 'data', file: 'data', label: 'Data', icon: 'box' },
  { id: 'gaps', file: 'gaps', label: 'Known gaps', icon: 'alert' },
];
const byFile = Object.fromEntries(CH.map((c) => [c.file, c.id]));
const esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// Just enough Markdown for the summary's short paragraphs: code and links.
const inline = (s) => esc(s)
  .replace(/`([^`]+)`/g, '<code>$1</code>')
  .replace(/\[([^\]]+)\]\(([^)]+)\)/g, (m, t, u) => (byFile[u.replace(/\.md$/, '')] ? `<a href="#${byFile[u.replace(/\.md$/, '')]}" data-go="${byFile[u.replace(/\.md$/, '')]}">${t}</a>` : `<a href="${u}">${t}</a>`));

const chapters = await Promise.all(CH.map(async (c) => {
  const mod = Object.entries(files).find(([p]) => p.endsWith(`/${c.file}.md`))[1];
  const raw = mod.rawContent();
  let html = await mod.compiledContent();
  html = html.replace(/<h1[^>]*>[\s\S]*?<\/h1>\s*/, '');
  html = html.replace(/href="([a-z-]+)\.md"/g, (m, f) => (byFile[f] ? `href="#${byFile[f]}" data-go="${byFile[f]}"` : m));
  html = html.replace(/<h3 id="([^"]+)">([A-Z]\d+)\.\s*/g, '<h3 id="$1"><span class="r-no">$2</span>');
  html = html.replace(/<li><strong>(Why|Do|Don(?:'|’|&#39;|&#x27;|&rsquo;)t):<\/strong>/g, (m, w) => `<li class="r-${w === 'Why' ? 'why' : w === 'Do' ? 'do' : 'dont'}"><strong>${w}</strong>`);
  html = html.replace(/(<li class="r-(?:why|do|dont)"><strong>[^<]*<\/strong>)([\s\S]*?)<\/li>/g, '$1<span>$2</span></li>');
  // Short code stays on one line (a hyphen is a line break point); long code may wrap at spaces.
  html = html.replace(/<code>([^<]{30,})<\/code>/g, '<code class="long">$1</code>');
  // Each rule becomes its own card: split before every rule heading.
  const parts = html.trim().split(/(?=<h3 id=)/);
  const intro = parts[0].startsWith('<h3') ? '' : parts.shift();
  const rulesHtml = parts.map((p) => `<article class="rule">${p}</article>`).join('');
  const rules = [...raw.matchAll(/^###\s+([A-Z]\d+)\.\s+(.+)$/gm)].map((m) => ({ no: m[1], title: m[2] }));
  const ids = [...html.matchAll(/<h3 id="([^"]+)"><span class="r-no">([A-Z]\d+)<\/span>/g)].map((m) => [m[2], m[1]]);
  return { ...c, raw, intro, rulesHtml, rules, ids, title: (raw.match(/^#\s+(.+)$/m) ?? [])[1] ?? c.label };
}));
// Rule numbers in brackets, like "(M6)" or "(D3, M5)", link to their rule.
const RULE_ID = Object.fromEntries(chapters.flatMap((c) => c.ids));
const RULE_CH = Object.fromEntries(chapters.flatMap((c) => c.rules.map((r) => [r.no, c.id])));
const linkRules = (h) => h.replace(/\(([A-Z]\d+(?:, [A-Z]\d+)*)\)/g, (m, list) => '(' + list.split(', ').map((n) => (RULE_ID[n] ? `<a href="#${RULE_ID[n]}" data-rule="${n}">${n}</a>` : n)).join(', ') + ')');
chapters.forEach((c) => { c.intro = linkRules(c.intro); c.rulesHtml = linkRules(c.rulesHtml); });
const main = chapters.filter((c) => c.rules.length);
const ruleCount = main.reduce((n, c) => n + c.rules.length, 0);
const gaps = chapters.find((c) => c.id === 'gaps');
const gapCount = (gaps.raw.match(/^\d+\.\s/gm) ?? []).length;

// The summary: the README's paragraphs, one card per chapter.
const readme = chapters[0].raw;
const onePage = [...readme.matchAll(/^\*\*(.+?)\.\*\*\s+(.+)$/gm)].map((m, i) => ({ label: m[1], text: m[2], ch: main[i] }));
const using = (readme.split(/^## Using the book\s*$/m)[1] ?? '').trim();

// Live examples. Devices: three video bars of one type, so one morphs into the next.
const MODELS = ['poly-studio-x32', 'poly-studio-x52', 'logitech-meetup-2'];
const MORPH = Object.fromEntries(MODELS.map((m) => {
  const parts = artParts(m) ?? [];
  const o = Object.fromEntries(parts.map((p) => [p.k, p.t === 'path' ? { t: 'path', cls: p.cls, d: p.d } : { t: p.t, cls: p.cls, g: p.g }]));
  const body = parts.find((p) => p.k === 'body');
  if (body) o['clip-body'] = { t: 'rect', cls: 'art-clip', g: body.g };
  return [m, { parts: o, name: modelName(m), src: artSource(m) ?? '' }];
}));
const short = (m) => modelName(m).replace(/^(Poly|Logitech)\s+/, '').replace('Studio ', '');
const POOL = [['display', 'Display'], ['video-bar', 'Video bar'], ['camera', 'Camera'], ['touch-controller', 'Touch panel'], ['microphone', 'Microphone'], ['loudspeaker', 'Speaker'], ['scheduler-panel', 'Room panel'], ['network-switch', 'Switch'], ['codec', 'Codec'], ['amplifier', 'Amplifier']];
const SIGNALS = [['--c-hdmi', 'Video'], ['--c-usb', 'USB'], ['--c-lan', 'Network'], ['--c-poe', 'PoE'], ['--c-hdbt', 'HDBaseT'], ['--c-power', 'Power'], ['--c-audio', 'Audio']];
const SEE = {
  motion: [['/profiles/video-bar/', 'Switch models on a device type', 'Parts and ports move, arrive and leave']],
  layout: [['/rooms/', 'Spaces', 'The List archetype: band, filter bar, cards'], ['/rooms/nyc-20-10/', 'A space page', 'The Record archetype: drawing beside its sticky Key']],
  devices: [['/profiles/video-bar/', 'Video bar device type', 'Drawing, ports and the model switcher'], ['/models/poly-studio-x52/', 'A model page', 'Every port, with sources']],
  rooms: [['/rooms/nyc-20-05/', 'A space drawn to scale', 'Key, outlets in the site\'s plug type, wiring'], ['/room-profiles/conference-room-small/', 'A space type', 'Build options that morph, never jump'], ['/rooms/dub-3-21/', 'A comms room', 'Racks drawn in millimetres']],
  platform: [['/rooms/', 'Spaces', 'Find, filter and radiate red'], ['/search/', 'Search', 'Plain words become chips']],
  words: [['/learn/#glossary', 'The glossary', 'Every Keia Atlas word in plain language']],
  data: [['/about/#built', 'How it is built', 'YAML, schema, cross-checks, pages']],
};
---
<Shell title="The rule book" section="about" crumbs={[{ label: 'About', to: '/about/' }, { label: 'The rule book' }]} about={{ kind: 'page', label: 'the rule book' }}>
  <section class="band">
    <div class="band-grid">
      <div>
        <div class="meta"><span class="overline">How Keia Atlas is built</span></div>
        <h1>The rule book</h1>
        <p class="lede band-answer" data-help="band.answer">{ruleCount} rules in {main.length} chapters · {gapCount} known {gapCount === 1 ? 'gap' : 'gaps'} still open</p>
        <p class="lede">How Keia Atlas moves, lays out a page, draws devices and spaces, and words things. Short numbered rules, each with a why, a do and a don't, for anyone adding to Keia Atlas or building something alongside it.</p>
      </div>
      <dl class="band-stats">
        <div><dt>Rules</dt><dd class="num">{ruleCount}</dd></div>
        <div><dt>Chapters</dt><dd class="num">{main.length}</dd></div>
        <div><a href="#gaps" data-go="gaps"><dt>Known gaps</dt><dd class="num">{gapCount}</dd></a></div>
      </dl>
    </div>
  </section>

  <div class="content rb">
    <div class="tabs rb-tabs" role="tablist" aria-label="Chapters" data-rb-tabs>
      {chapters.map((c, i) => (
        <button type="button" role="tab" id={`rbt-${c.id}`} aria-controls={`rbp-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-ch-tab={c.id}>
{c.label}{c.rules.length > 0 && <span class="rb-n num">{c.rules.length}</span>}
        </button>
      ))}
    </div>

    <div class="rb-panels" data-rb-box>
      {chapters.map((c, i) => (
        <section class:list={['rb-panel', { 'has-aside': ['motion', 'devices', 'platform', 'looks'].includes(c.id) || SEE[c.id] }]} id={`rbp-${c.id}`} role="tabpanel" aria-labelledby={`rbt-${c.id}`} data-ch={c.id} hidden={i !== 0}>
          {c.id === 'summary' ? (
            <div class="rb-main">
              <h2 class="sr-only">The book on one page</h2>
              <ol class="rb-sum">
                {onePage.map((s) => (
                  <li>
                    <button type="button" class="card rb-sc" data-go={s.ch.id}>
                      <span class="rb-sc-top"><Icon name={s.ch.icon} size={16} /><b>{s.label}</b><span class="faint mono">{s.ch.rules[0].no} to {s.ch.rules[s.ch.rules.length - 1].no}</span></span>
                      <span class="rb-sc-t" set:html={inline(s.text)} />
                    </button>
                  </li>
                ))}
              </ol>
              <div class="rb-using card"><Icon name="check" size={18} /><p set:html={inline(using)} /></div>
            </div>
          ) : (
            <div class="rb-main">
              <div class="rb-intro" set:html={c.intro} />
              <div class="rb-rules" set:html={c.rulesHtml} />
            </div>
          )}

          <aside class="rb-aside" aria-label={`Examples: ${c.label}`}>
            {c.id === 'motion' && (
              <div class="card demo" data-demo="moves">
                <p class="demo-h"><span class="overline">Try it</span> Persist, enter, exit <a href={`#${RULE_ID.M2}`} data-rule="M2" class="mono">M2</a></p>
                <div class="dm-box" data-moves-box>
                  <ul class="dm-chips" data-chips>
                    {POOL.slice(0, 4).map(([cls, name]) => <li data-chip={cls}><DeviceGlyph cls={cls} size={26} /><span>{name}</span></li>)}
                  </ul>
                </div>
                <div class="dm-btns"><button type="button" class="btn small" data-add><Icon name="plus" size={14} />Add a device</button><button type="button" class="btn small ghost" data-remove>Remove one</button></div>
                <p class="demo-note">New ones grow from their own centre a beat later, leaving ones shrink to theirs, and the rest slide into place.</p>
                <template data-pool>{POOL.map(([cls, name]) => <li data-chip={cls}><DeviceGlyph cls={cls} size={26} /><span>{name}</span></li>)}</template>
              </div>
            )}
            {c.id === 'motion' && (
              <>
                <div class="card demo" data-demo="hold">
                  <p class="demo-h"><span class="overline">Try it</span> Never jump <a href={`#${RULE_ID.M6}`} data-rule="M6" class="mono">M6</a></p>
                  <div class="dm-seg" role="tablist" aria-label="Example tabs">
                    <button type="button" role="tab" aria-selected="true" data-ht="long">Long tab</button>
                    <button type="button" role="tab" aria-selected="false" data-ht="short">Short tab</button>
                  </div>
                  <div class="dm-hold" data-hold-box>
                    <ul class="dm-lines" data-hp="long">{['Display', 'Video bar', 'Touch panel', 'Room panel', 'Switch'].map((t) => <li><span class="hg-m lit" data-state="fine" aria-hidden="true"></span>{t}</li>)}</ul>
                    <ul class="dm-lines" data-hp="short" hidden><li><span class="hg-m lit" data-state="review" aria-hidden="true"></span>Camera</li></ul>
                  </div>
                  <label class="dm-sw"><input type="checkbox" checked data-hold-on /> Follow the rule</label>
                  <p class="demo-note" data-hold-note>Pick the short tab: the box keeps its height, so this switch stays under your pointer. Untick it and try again.</p>
                </div>
                <div class="card demo" data-demo="check">
                  <p class="demo-h"><span class="overline">Try it</span> Lights come on in turn <a href={`#${RULE_ID.M8}`} data-rule="M8" class="mono">M8</a></p>
                  <ul class="dm-checks">
                    {['Firmware on the standard', 'Camera shutter open', 'Display input', 'Network reachable'].map((t) => <li><span class="hg-m" data-state="off" data-chk aria-hidden="true"></span><span>{t}</span><small class="faint" data-chk-word>Not checked</small></li>)}
                  </ul>
                  <div class="dm-btns"><button type="button" class="btn small" data-run><Icon name="refresh" size={14} />Run the check</button></div>
                </div>
              </>
            )}
            {c.id === 'devices' && (
              <>
                <div class="card demo" data-demo="morph">
                  <p class="demo-h"><span class="overline">Try it</span> One model morphs into the next <a href={`#${RULE_ID.D3}`} data-rule="D3" class="mono">D3</a></p>
                  <div class="dm-seg dm-models" role="radiogroup" aria-label="Model" data-models>
                    <span class="dm-thumb" aria-hidden="true" data-thumb></span>
                    {MODELS.map((m) => <button type="button" role="radio" aria-checked={m === 'poly-studio-x52' ? 'true' : 'false'} data-model={m}>{short(m)}</button>)}
                  </div>
                  <div class="stage dm-stage" data-morph-stage><DeviceArt model="poly-studio-x52" cls="video-bar" label={modelName('poly-studio-x52')} /></div>
                  <p class="demo-note" data-morph-note aria-live="polite">{MORPH['poly-studio-x52'].name}. Traced from the {MORPH['poly-studio-x52'].src}. Drawn at 0.35 px per mm, so sizes compare.</p>
                </div>
                <div class="card demo" data-demo="states">
                  <p class="demo-h"><span class="overline">See it</span> State beside the drawing <a href={`#${RULE_ID.D6}`} data-rule="D6" class="mono">D6</a></p>
                  <ul class="dm-states">
                    <li><span class="dm-g"><DeviceGlyph cls="video-bar" size={34} /></span><span><b>Healthy</b><small>Every check passed</small></span><span class="hg-m" data-state="fine" aria-hidden="true"></span></li>
                    <li><span class="dm-g"><DeviceGlyph cls="video-bar" size={34} /></span><span><b>To review</b><small>Firmware behind the standard</small></span><span class="hg-m" data-state="review" aria-hidden="true"></span></li>
                    <li class="rs-radiate"><span class="dm-g"><DeviceGlyph cls="video-bar" size={34} /></span><span><b>Fault</b><small>Open incident: no picture</small></span><span class="hg-m" data-state="fault" aria-hidden="true"></span></li>
                    <li><span class="dm-g"><DeviceGlyph cls="video-bar" size={34} /></span><span><b>Not checked</b><small>Offline, or not checked yet</small></span><span class="hg-m" data-state="off" aria-hidden="true"></span></li>
                  </ul>
                  <p class="dm-pills"><span class="pill plan">Plan</span><span class="pill procure">Procure</span><span class="pill deploy">Deploy</span><span class="pill manage">Manage</span><span class="pill retire">Retire</span></p>
                </div>
                <div class="card demo">
                  <p class="demo-h"><span class="overline">See it</span> Ports coloured by signal <a href={`#${RULE_ID.D5}`} data-rule="D5" class="mono">D5</a></p>
                  <div class="legend dm-sig">{SIGNALS.map(([t, n]) => <span style={`--c:var(${t})`}>{n}</span>)}</div>
                </div>
              </>
            )}
            {c.id === 'platform' && (
              <>
                <div class="card demo" data-demo="archive">
                  <p class="demo-h"><span class="overline">Try it</span> Undo and archive <a href={`#${RULE_ID.P7}`} data-rule="P7" class="mono">P7</a></p>
                  <div class="dm-box" data-arch-box>
                    <ul class="dm-arch" data-arch-list>
                      {['Spare HDMI cable, Level 3 store', 'Loan kit returned to the Lab', 'Old room panel, awaiting collection'].map((t, i) => <li data-arch={i}><span>{t}</span><button type="button" class="btn small ghost" data-arch-btn>Archive</button></li>)}
                    </ul>
                    <p class="dm-empty" data-arch-empty hidden>All archived. Archived things are kept, not deleted. <button type="button" class="linkish" data-arch-all>Bring them back</button></p>
                  </div>
                  <p class="dm-toast" role="status" aria-live="polite" data-arch-toast hidden><span data-arch-say></span><button type="button" class="btn small" data-arch-undo>Undo</button></p>
                </div>
                <div class="card demo">
                  <p class="demo-h"><span class="overline">Try it</span> On every page <a href={`#${RULE_ID.P2}`} data-rule="P2" class="mono">P2 to P4</a></p>
                  <div class="dm-btns">
                    <button type="button" class="btn small ghost" data-open-search><Icon name="search" size={14} />Search</button>
                    <button type="button" class="btn small ghost" data-open-report><Icon name="plus" size={14} />Report</button>
                    <button type="button" class="btn small ghost" data-view-as><Icon name="team" size={14} />View as</button>
                  </div>
                </div>
              </>
            )}
            {c.id === 'looks' && (
              <div class="card demo">
                <p class="demo-h"><span class="overline">See it</span> Colour has jobs <a href={`#${RULE_ID.T4}`} data-rule="T4" class="mono">T4</a></p>
                <p class="dm-pills"><span class="pill manage">Healthy</span><span class="pill warn">To review</span><span class="pill bad">Fault</span><span class="pill deploy">In progress</span><span class="pill plan">Planning</span><span class="pill">Off</span></p>
                <p class="demo-note">The same words in every look. Change the look or the mode and they keep their jobs.</p>
                <div class="dm-btns">
                  <button type="button" class="btn small primary" data-open-settings><Icon name="gear" size={14} />Change the look</button>
                  <button type="button" class="btn small ghost" data-toggle-mode><Icon name="auto" size={14} />Light or dark</button>
                </div>
              </div>
            )}
            {SEE[c.id] && (
              <div class="card demo see">
                <p class="demo-h"><span class="overline">See it in Keia Atlas</span></p>
                <ul class="dm-see">
                  {SEE[c.id].map(([to, t, s]) => <li><a href={href(to)}><b>{t}</b><small>{s}</small><Icon name="arrow" size={14} /></a></li>)}
                </ul>
              </div>
            )}
          </aside>

          <nav class="rb-next" aria-label="Chapters">
            {i > 0 ? <button type="button" class="btn small ghost" data-go={chapters[i - 1].id} data-go-top><Icon name="back" size={14} />{chapters[i - 1].label}</button> : <span></span>}
            {i < chapters.length - 1 && <button type="button" class="btn small" data-go={chapters[i + 1].id} data-go-top>{chapters[i + 1].label}<Icon name="arrow" size={14} /></button>}
          </nav>
        </section>
      ))}
    </div>
  </div>

  <script is:inline data-astro-rerun define:vars={{ MORPH, RULE_CH }}>
    (function () {
      var root = document.querySelector('.rb'); if (!root) return;
      var M = function () { return window.rsMotion ? window.rsMotion() : { reduced: true }; };
      // Shell's helpers load after the page body on a first visit, so fall back to a plain swap until they exist.
      var hold = function (b, swap) { if (window.rsHold) window.rsHold(b, swap); else swap(); };
      var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-ch-tab]'));
      var ids = tabs.map(function (t) { return t.dataset.chTab; });
      var box = root.querySelector('[data-rb-box]');
      var now = ids[0];

      /* ---------- Chapters: held box (M6), the next one comes from the side you moved towards (M5) ---------- */
      function open(id, opts) {
        opts = opts || {};
        if (ids.indexOf(id) < 0) return;
        var from = now, dir = ids.indexOf(id) >= ids.indexOf(from) ? 1 : -1;
        var next = root.querySelector('[data-ch="' + id + '"]');
        var swap = function () {
          root.querySelectorAll('[data-ch]').forEach(function (p) { p.hidden = p.dataset.ch !== id; });
          tabs.forEach(function (t) { var on = t.dataset.chTab === id; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; });
          now = id;
        };
        if (id === from) { swap(); }
        else {
          hold(box, swap);
          var m = M();
          if (opts.animate !== false && !m.reduced) {
            next.animate([{ opacity: 0, transform: 'translateX(' + (24 * dir) + 'px)' }, { opacity: 1, transform: 'none' }], { duration: m.enter, easing: m.ease, fill: 'backwards' });
          }
        }
        if (opts.hash !== false) history.replaceState(history.state, '', '#' + id);
        if (opts.top) { var tb = root.querySelector('[data-rb-tabs]'); if (tb.getBoundingClientRect().top < 0) tb.scrollIntoView({ block: 'start', behavior: M().reduced ? 'auto' : 'smooth' }); }
        if (id === 'devices') placeThumb();
      }
      tabs.forEach(function (t) {
        t.addEventListener('click', function () { open(t.dataset.chTab); });
        t.addEventListener('keydown', function (e) {
          if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
          e.preventDefault();
          var i = ids.indexOf(t.dataset.chTab), n = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
          n.focus(); open(n.dataset.chTab);
        });
      });
      function goRule(no) {
        var ch = RULE_CH[no]; if (!ch) return;
        open(ch, { animate: false });
        var h = root.querySelector('[data-ch="' + ch + '"] .r-no');
        root.querySelectorAll('[data-ch="' + ch + '"] .r-no').forEach(function (x) { if (x.textContent === no) h = x; });
        var card = h && h.closest('.rule'); if (!card) return;
        card.scrollIntoView({ block: 'center', behavior: M().reduced ? 'auto' : 'smooth' });
        card.classList.remove('flash'); void card.offsetWidth; card.classList.add('flash');
      }
      root.addEventListener('click', function (e) {
        var g = e.target.closest('[data-go]');
        if (g) { e.preventDefault(); open(g.dataset.go, { top: g.hasAttribute('data-go-top') }); return; }
        var r = e.target.closest('[data-rule]');
        if (r) { e.preventDefault(); goRule(r.dataset.rule); }
      });
      document.querySelectorAll('.band [data-go]').forEach(function (a) { a.addEventListener('click', function (e) { e.preventDefault(); open(a.dataset.go); root.scrollIntoView({ block: 'start' }); }); });
      var h0 = (location.hash || '').slice(1);
      if (ids.indexOf(h0) >= 0) open(h0, { animate: false, hash: false });
      else if (h0) {
        var el = document.getElementById(h0), p = el && el.closest('[data-ch]');
