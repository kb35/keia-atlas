---
// The accessibility statement (docs/accessibility.md, the only copy of the words): what works, how to change the
// settings, what does not work yet, and how to tell us. Linked from Settings › Accessibility, About and the front
// door's footer. Target: WCAG 2.2 AA, and EN 301 549 for the European Accessibility Act.
import Shell from '../../layouts/Shell.astro';
import PageBand from '../../components/PageBand.astro';
import { Content } from '../../../docs/accessibility.md';
---
<Shell title="Accessibility" section="about" crumbs={[{ label: 'About this project', to: '/about/' }, { label: 'Accessibility' }]}>
  <PageBand overline="About Keia Atlas" title="Accessibility" lede="What works for people who use a keyboard, a screen reader, larger text or less motion; how to change it; and what does not work yet." />
  <div class="content">
    <article class="card pad a11y-doc"><Content /></article>
  </div>
</Shell>

<style>
  .a11y-doc { max-width: 78ch; font-size: var(--fs-body); line-height: 1.6; }
  .a11y-doc :global(h1) { display: none; }
  .a11y-doc :global(h2) { font-size: var(--fs-h3); margin: 28px 0 8px; }
  .a11y-doc :global(h2:first-of-type) { margin-top: 0; }
  .a11y-doc :global(h3) { font-size: var(--fs-body); margin: 18px 0 6px; }
  .a11y-doc :global(p), .a11y-doc :global(ul), .a11y-doc :global(ol), .a11y-doc :global(table) { margin: 0 0 12px; }
  .a11y-doc :global(li) { margin: 4px 0; }
  .a11y-doc :global(table) { border-collapse: collapse; width: 100%; font-size: var(--fs-support); }
  .a11y-doc :global(th), .a11y-doc :global(td) { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .a11y-doc :global(a) { text-decoration: underline; }
</style>
