---
// The last cell of an equipment row: what the usage rules flag, and any open incident on the unit.
// Each incident is a link to its page.
import { incByDevice } from './_engineer.mjs';
interface Props { e: any }
const { e } = Astro.props;
const inc = incByDevice[e.tag] ?? [];
---
<span class="ut-sig">
  {e.flag && <span class:list={['uflag', e.flag.tone]}>{e.flag.text}</span>}
  {inc.map((x) => <a class="uc bad" href={x.href} title={x.title}>{x.number}</a>)}
</span>
