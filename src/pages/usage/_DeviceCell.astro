---
// The first cell of an equipment row: the device's glyph and name (a link to its page), and under it the
// room, the site and the model.
import DeviceGlyph from '../../components/DeviceGlyph.astro';
import { href, sites, modelName } from '../../lib/data.mjs';
interface Props { e: any; cls?: string; title?: string }
const { e, cls = e.cls, title = e.name } = Astro.props;
const where = `${e.roomName} · ${sites[e.site].code} · ${e.model ? modelName(e.model) : 'No set model'}${e.older ? ' · older kit' : ''}`;
---
<a class="ut-dev ut-main" href={href(`/device/?tag=${e.tag}`)}>
  <span class="ut-dg"><DeviceGlyph cls={cls} size={24} /></span>
  <span class="ut-nm"><b>{title}</b><small title={where}>{where}</small></span>
</a>
