---
// The audit log (Keia Method 2.9: "a record that cannot be quietly edited"; design notes; BUILD-PLAN V5 H3): the raw
// layer behind every "How was this done?" card. Each run of a standing rule with its trace, line by line (what it
// called, what came back, the rule's version, and where AI drafted anything, the model, the region and the prompt
// version); every hand-off, priority and state change on a job. Newest first. Nothing is edited in place: a change
// is a new entry. Each entry has an address (#run-RUN-5120), so a card links straight to its trace.
import Shell from '../../../layouts/Shell.astro';
import PageBand from '../../../components/PageBand.astro';
import FilterBar from '../../../components/FilterBar.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { LOG, rulePath, RULES } from '../../../lib/rules-view.mjs';
import { at } from '../../../lib/rules.mjs';
import { href, DEMO_TODAY, incidentPath } from '../../../lib/data.mjs';

const KIND = { run: 'Rule runs', hand: 'Who has it', priority: 'Priority', state: 'State', ai: 'Drafted by AI' };
const FACETS = [
  { key: 'kind', label: 'Kind', options: Object.entries(KIND).map(([value, label]) => ({ value, label })) },
  { key: 'rule', label: 'Rule', options: Object.values(RULES).map((r) => ({ value: r.id, label: r.name })) },
];
const runs = LOG.filter((e) => e.kind === 'run');
const ANSWER = `${LOG.length} entries · nothing edited in place: every change is a new entry`;
const NUMBERS = [
  { n: runs.length, label: 'Rule runs', to: '?kind=run' },
  { n: runs.filter((e) => /^Unable/.test(e.what)).length, label: 'Unable to complete', to: '?kind=run&q=unable' },
  { n: LOG.filter((e) => e.kind === 'ai').length, label: 'Drafted by AI', to: '?kind=ai' },
  { n: LOG.filter((e) => e.kind === 'hand' || e.kind === 'priority').length, label: 'Hand-offs and priorities', to: '?kind=hand,priority' },
];
const itemHref = (item) => (item?.startsWith('inc:') ? href(incidentPath(item.slice(4))) : null);
---
<Shell title="Audit log" section="audit-log" crumbs={[{ label: 'Support', to: '/support/' }, { label: 'Audit log' }]}>
  <PageBand overline="Support · Raw" title="Audit log" answer={ANSWER} numbers={NUMBERS} sim />
  <div class="content log-page">
    <FilterBar facets={FACETS} placeholder="Find a run, rule, job or person" label="Find in the log" noun={['entry', 'entries']} scope=".content.log-page" />
    <ol class="lg" data-lg>
      {LOG.map((e) => (
        <li class={`lg-e lg-${e.kind}`} id={e.id} data-fi data-find={`${e.what} ${e.who} ${e.run ?? ''} ${e.item ?? ''}`} data-f-kind={e.kind} data-f-rule={e.rule ?? ''}>
          <div class="lg-h">
            <time class="mono lg-t" datetime={e.at}>{at(e.at, DEMO_TODAY)}</time>
            <span class="lg-k">{KIND[e.kind]}</span>
            <span class="lg-w">{e.what}</span>
          </div>
          <p class="lg-m">
            <span>{e.who}</span><span class="lg-src">{e.src}</span>
            {e.run && <span class="mono">{e.run}</span>}
            {e.rule && <a href={href(rulePath(e.rule))}>The rule</a>}
            {itemHref(e.item) && <a href={itemHref(e.item)}>{e.item.slice(4)}</a>}
          </p>
          {e.lines && (
            <table class="lg-tr">
              <caption class="sr-only">Trace of {e.run}</caption>
              <thead><tr><th scope="col">Time</th><th scope="col">What it did</th><th scope="col">What came back</th><th scope="col">Where</th></tr></thead>
              <tbody>
                {e.lines.map((l) => <tr class={/Refused|Does not match/.test(l.got) ? 'lg-bad' : ''}><td class="mono">{l.t}</td><td>{l.what}</td><td>{l.got}</td><td class="mono">{l.src}</td></tr>)}
              </tbody>
            </table>
          )}
        </li>
      ))}
    </ol>
    <EmptyState text="No entries match these filters." />
  </div>
</Shell>

<style>
  .log-page { gap: 20px; padding-top: 18px; }
  .lg { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; background: var(--surface); border: var(--border-card); border-radius: var(--radius-lg); overflow: hidden; }
  .lg-e { display: grid; gap: 6px; padding: 14px 20px; border-top: var(--border-rule, 1px solid var(--line)); scroll-margin-top: calc(var(--mast-h, 60px) + var(--fb-h, 0px) + 16px); transition: background-color var(--dur-state) var(--ease-settle); }
  .lg-e:first-child { border-top: 0; }
  .lg-e:target { background: var(--accent-soft); }
  .lg-h { display: grid; grid-template-columns: 110px 120px minmax(0, 1fr); gap: 12px; align-items: baseline; }
  .lg-t { font-size: var(--fs-code); color: var(--text-2); font-variant-numeric: tabular-nums; }
  .lg-k { font: 500 var(--fs-overline)/1 var(--font-mono); letter-spacing: .09em; text-transform: uppercase; color: var(--text-3); }
  .lg-w { font-size: var(--fs-body); font-weight: var(--fw-name); overflow-wrap: anywhere; }
  .lg-m { margin: 0 0 0 242px; display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: var(--fs-support); color: var(--text-2); }
  .lg-src { font: 500 var(--fs-mark)/1.5 var(--font-mono); color: var(--quiet); padding: 0 5px; border: 1px solid var(--line); border-radius: 4px; }
  .lg-tr { margin: 4px 0 0 242px; width: calc(100% - 242px); border-collapse: collapse; font-size: var(--fs-code); table-layout: fixed; }
  .lg-tr th { text-align: left; font: 500 var(--fs-overline)/1.2 var(--font-mono); letter-spacing: .07em; text-transform: uppercase; color: var(--text-3); padding: 6px 8px; border-bottom: 1px solid var(--line); }
  .lg-tr th:first-child { width: 104px; } .lg-tr th:last-child { width: 150px; }
  .lg-tr td { padding: 6px 8px; border-bottom: 1px solid var(--line); vertical-align: top; overflow-wrap: anywhere; }
  .lg-tr td.mono { font-size: var(--fs-mark); color: var(--text-2); }
  .lg-tr tr.lg-bad td { color: var(--h-fault-ink); }
  /* Narrow: the trace becomes stacked lines, one per step, instead of a squeezed table. */
  @media (max-width: 767px) {
    .lg-e { padding: 12px 16px; }
    .lg-h { grid-template-columns: minmax(0, 1fr) auto; }
    .lg-w { grid-column: 1 / -1; }
    .lg-m, .lg-tr { margin-left: 0; width: 100%; }
    .lg-tr thead { display: none; }
    .lg-tr, .lg-tr tbody, .lg-tr tr, .lg-tr td { display: block; }
    .lg-tr tr { padding: 6px 0; border-bottom: 1px solid var(--line); }
    .lg-tr td { border: 0; padding: 1px 0; }
  }
</style>
