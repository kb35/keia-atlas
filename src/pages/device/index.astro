---
// One unit (a physical device), like a device page in NetBox: where it is, what it is, how it is
// connected and addressed, the configuration and firmware it should have, advisories for its model,
// and its history of work and incidents. One template, filled from device/data.json by asset tag
// (?tag=AG-000123), so every unit in the fleet has a page without a file per unit.
// With no tag, the page is a search across every unit.
//
// Layout (rule book L1): one 12-column grid, equal gutters, cards that
// line up on both edges. First row: the drawing, big, beside the facts. Second row: Health,
// Configuration, and Work and incidents (the unit's history, newest first). Usage and wiring below.
import Shell from '../../layouts/Shell.astro';
import DeviceArt from '../../components/DeviceArt.astro';
import DeviceGlyph from '../../components/DeviceGlyph.astro';
import Icon from '../../components/Icon.astro';
import PageBand from '../../components/PageBand.astro';
import SimTag from '../../components/SimTag.astro';
import { models, spaces, STAGES, STAGE_LABEL, TASK_STATUS, INC_STATE } from '../../lib/data.mjs';
import { artParts, artSource } from '../../lib/art.mjs';
import '../../styles/viz.css';
import '../../styles/classification.css';
const used = [...new Set(Object.values(spaces).flatMap((s) => [...s.positions, ...s.olderKit].map((p) => p.model).filter(Boolean)))];
const clsUsed = [...new Set(Object.values(spaces).flatMap((s) => [...s.positions, ...s.olderKit].map((p) => p.cls)))];
const words = { stages: STAGES.map((s) => [s, STAGE_LABEL[s]]), task: TASK_STATUS, inc: INC_STATE };
const mm = (id) => models[id]?.dimensions_mm;
const dims = (id) => { const d = mm(id); return d?.width ? [d.width, d.height, d.depth].filter(Boolean).map((n) => (+n).toLocaleString('en-IE', { maximumFractionDigits: 1 })).join(' × ') + ' mm' : ''; };
---
<Shell vendorOk title="Unit" section="devices" crumbs={[{ label: 'Units', to: '/devices/' }, { label: 'Find a unit' }]}>
  <div id="dv" data-dv data-words={JSON.stringify(words)}>
    <PageBand overline="Unit" title="Find a unit" heartbeat>
      <span slot="overline" data-dv-status hidden></span>
      <span slot="overline" data-dv-sim hidden><SimTag kind="simulated" /></span>
      <span slot="answer" data-dv-lede>Search every unit by hostname, serial number, asset tag, space or model. Scanning an asset tag lands here.</span>
      <div slot="numbers" data-dv-kn></div>
    </PageBand>
    <div class="content dv-content">
      <label class="dv-search" data-help="unit.find"><span class="sr-only">Find a unit</span><input type="search" data-dv-q placeholder="Find a unit, hostname or serial" autocomplete="off" /></label>
      <ul class="dv-results" data-dv-results></ul>
      <div class="dv-grid g12" data-dv-body hidden></div>
      <p class="faint" data-dv-loading>Loading the fleet…</p>
    </div>
  </div>
  {used.map((m) => <template data-art={m} data-traced={artParts(m) ? '1' : ''} data-src={artSource(m) ?? ''} data-dims={dims(m)}><DeviceArt model={m} cls={models[m].class} label={`${models[m].manufacturer} ${models[m].model}, drawn front-on`} /></template>)}
  {clsUsed.map((c) => <template data-glyph={c}><DeviceGlyph cls={c} size={120} /></template>)}
  <template data-icon="check"><Icon name="check" size={12} /></template>

  <script is:inline data-astro-rerun slot="end">
    (function () {
      var root = document.querySelector('[data-dv]'); if (!root) return;
      var W = JSON.parse(root.dataset.words);
      var preview = /\.html$/.test(location.pathname);
      var L = function (p) { return '../' + p + (preview ? 'index.html' : ''); };
      var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
      var tick = document.querySelector('template[data-icon=check]').innerHTML;
      // Each drawing keeps its own clip outline: give every copy a fresh id so two on one page never share one.
      var seq = 0;
      var artTpl = function (u) { return (u.pos.model && document.querySelector('template[data-art="' + u.pos.model + '"]')) || null; };
      var art = function (u) {
        var t = artTpl(u) || document.querySelector('template[data-glyph="' + u.pos.cls + '"]');
        if (!t) return '';
        var id = 'art-clip-u' + (++seq);
        return t.innerHTML.replace(/art-clip-main/g, id);
      };
      var fmt = function (d) { return d ? new Date(d).toLocaleDateString('en-IE', { day: 'numeric', month: 'short', year: 'numeric' }) : 'Not recorded'; };
      var LEVEL = { 'do-not-install': 'Do not install', act: 'Action needed', check: 'Check', info: 'Good to know' };
      var STAGES = W.stages, STAGE = Object.fromEntries(STAGES);
      var PLAT = { keia_atlas: 'Keia Atlas', inventory: 'Asset register', dhcp_dns: 'Addresses and DNS', device_management: 'Device management', room_booking: 'Room booking', monitoring: 'Monitoring' };
      var OPEN = function (st) { return st !== 'resolved' && st !== 'closed'; };
      var cap = function (s) { s = String(s || ''); return s.charAt(0).toUpperCase() + s.slice(1).replace(/-/g, ' '); };
      var D = null;
      // KI: known issues per unit (decision 0029, src/pages/known-issues/units.json.js); the page works without it.
      var KI = {};
      Promise.all([fetch('data.json').then(function (r) { return r.json(); }), fetch('../known-issues/units.json').then(function (r) { return r.ok ? r.json() : {}; }).catch(function () { return {}; })])
        .then(function (a) { D = a[0]; KI = a[1] || {}; route(); }).catch(function () { root.querySelector('[data-dv-loading]').textContent = 'Could not load the list of units.'; });

      function roomLabel(r) { return (r.number ? r.number + ' ' : '') + r.name; }
      function route() {
        root.querySelector('[data-dv-loading]').hidden = true;
        var q = new URLSearchParams(location.search), tag = (q.get('tag') || '').toUpperCase(), host = q.get('host');
        var u = tag ? D.units.find(function (x) { return x.tag === tag; }) : host ? D.units.find(function (x) { return x.host === host; }) : null;
        if (u) show(u); else search();
      }
      function search() {
        var input = root.querySelector('[data-dv-q]'), list = root.querySelector('[data-dv-results]');
        var run = function () {
          var v = input.value.trim().toLowerCase();
          seq = 0;
          if (v.length < 2) { list.innerHTML = '<li class="faint">Type at least two characters. ' + D.units.length.toLocaleString('en-IE') + ' units across ' + Object.keys(D.sites).length + ' sites.</li>'; return; }
          var hits = D.units.filter(function (x) {
            var r = D.rooms[x.room], m = x.pos.model ? D.models[x.pos.model].name : '';
            return [x.tag, x.serial, x.host, roomLabel(r), D.sites[r.site].name, m, x.pos.role].join(' ').toLowerCase().indexOf(v) >= 0;
          }).slice(0, 50);
          list.innerHTML = hits.length ? hits.map(function (x) {
            var r = D.rooms[x.room];
            return '<li><a class="dv-hit" href="?tag=' + x.tag + '"><span class="dv-hit-art">' + art(x) + '</span><span><b>' + esc(x.host || x.pos.role) + '</b><small>' + esc(x.pos.role) + (x.pos.model ? ' · ' + esc(D.models[x.pos.model].name) : '') + '</small></span><span class="mono faint">' + x.tag + '</span><span class="faint">' + esc(roomLabel(r)) + ', ' + esc(D.sites[r.site].code) + '</span></a></li>';
          }).join('') : '<li class="faint">No unit matches. Try fewer letters, or a hostname, serial or space.</li>';
        };
        input.addEventListener('input', run); run(); input.focus({ preventScroll: true });
      }
      function row(k, v, more) { return '<div class="dv-row"' + (more ? ' data-more hidden' : '') + '><dt>' + k + '</dt><dd>' + v + '</dd></div>'; }
      // Long lists show their first few rows, so the cards in a row stay the same height; the rest are a click away.
      var FIRST = 5;
      function showAll(n, what) { return n > FIRST ? '<button type="button" class="btn small dv-all" data-help="section.showall" data-show-all>Show all ' + n + ' ' + what + '</button>' : ''; }
      // Classification (docs/rules/data.md F10): the small label beside Restricted content. Same as src/components/Restricted.astro.
      function R(what) { return '<span class="cls-tag" data-help="classification.restricted"><b>Restricted:</b> ' + esc(what) + '</span>'; }
      function demoVal() { return ' <span class="demo-val" data-help="unit.demo-value">Demo value</span>'; }
      function head(title, aside) { return '<header class="dv-ch"><h2>' + title + '</h2>' + (aside || '') + '</header>'; }
      // The path you can climb: Units > site > room > this unit. Each step is a link but the last.
      function crumbs(u, r, s, nm) {
        var nav = document.querySelector('.mast .crumbs'); if (!nav) return;
        var steps = [['Units', L('devices/')], [s.name, L('devices/') + '?site=' + r.site], [roomLabel(r), L('rooms/' + u.room + '/')], [nm]];
        nav.innerHTML = steps.map(function (c, i) { return (i ? '<span class="sep" aria-hidden="true">/</span>' : '') + (c[1] ? '<a href="' + c[1] + '">' + esc(c[0]) + '</a>' : '<span aria-current="page">' + esc(c[0]) + '</span>'); }).join('');
      }
      function show(u) {
        var r = D.rooms[u.room], s = D.sites[r.site], m = u.pos.model ? D.models[u.pos.model] : null;
        var nm = u.name ? u.name.charAt(0).toUpperCase() + u.name.slice(1) : (u.host || u.pos.role);
        var status = u.legacy ? 'Being replaced' : (STAGE[u.stage] || u.stageLabel);
        var inc = r.incidents.filter(function (i) { return !i.position || i.position === u.pos.key; });
        var openInc = inc.filter(function (i) { return OPEN(i.state); });
        document.title = nm + ' · Keia Atlas';
        crumbs(u, r, s, nm);
        document.getElementById('pb-title').textContent = nm;
        var stEl = root.querySelector('[data-dv-status]');
        var sec = m && m.sec;
        stEl.innerHTML = '<span class="pill ' + u.stage + '" data-help="unit.status">' + status + '</span>' + (openInc.length ? ' <span class="pill bad">' + openInc.length + ' open incident' + (openInc.length > 1 ? 's' : '') + '</span>' : '') +
          (sec && sec.chip ? ' <a class="ss-chip ' + sec.tone + '" href="#security" data-help="unit.security-chip">' + esc(sec.chip) + '</a>' : '') +
          (u.pw === false ? ' <a class="ss-chip bad" href="#security" data-help="unit.password-chip">Default password not changed</a>' : '');
        stEl.hidden = false;
        root.querySelector('[data-dv-sim]').hidden = !u.usage;
        // The answer (UI-V2 §3.4): an open incident first; otherwise its status. Where it is goes in the line's tooltip.
        var advN0 = m ? m.advisories.length : 0;
        var answer = openInc.length ? openInc[0].title + (openInc.length > 1 ? ' · ' + (openInc.length - 1) + ' more open' : '')
          : status + ' · no open incidents' + (advN0 ? ' · ' + advN0 + (advN0 === 1 ? ' advisory' : ' advisories') + ' to review' : '');
        var lede = root.querySelector('[data-dv-lede]');
        lede.textContent = answer;
        var ans = lede.closest('p'); if (ans) ans.title = answer + '\n' + u.pos.role + (m ? ', ' + m.name : '') + ', in ' + roomLabel(r) + ' at ' + s.name + (s.city ? ', ' + s.city : '') + '.';
        root.querySelector('.dv-search').hidden = true;
        root.querySelector('[data-dv-results]').hidden = true;
        // Key numbers in the band: how many need attention, each a link to the card that holds them.
        var openTasks = r.tasks.filter(function (t) { return t.status !== 'done'; }).length, advN = m ? m.advisories.length : 0;
        var kn = function (n, label, to, tone) { return '<li class="kn-i' + (tone ? ' t-' + tone : '') + '" data-help="number:' + label + '" data-help-name="' + label + '"><a href="' + to + '"><b class="num">' + n + '</b><span>' + label + '</span></a></li>'; };
        root.querySelector('[data-dv-kn]').innerHTML = '<ul class="kn" aria-label="Key numbers">' +
          kn(openInc.length, 'Open incidents', '#history', openInc.length ? 'bad' : '') +
          kn(openTasks, 'Open tasks in space', '#history', '') +
          kn(advN, 'Advisories', '#advisories', advN ? 'warn' : '') +
          kn(u.conn.length, 'Connections', '#connections', '') + '</ul>';
        var at = STAGES.findIndex(function (x) { return x[0] === u.stage; });
        var tpl = artTpl(u), traced = tpl && tpl.dataset.traced, dimsTxt = tpl ? tpl.dataset.dims : '';
        var body = '';

        // Row 1: the drawing, big, with its lifecycle underneath; the facts beside it.
        body += '<section class="card dv-card s-5 c-art' + (openInc.length ? ' rs-radiate' : '') + '" data-help="unit.picture" aria-label="Drawing and lifecycle">' +
          '<div class="stage dv-stage' + (traced ? '' : ' generic') + '">' + art(u) +
          '<p class="dv-cap">' + (traced ? 'Front, to scale' + (dimsTxt ? ', ' + esc(dimsTxt) : '') + '. Traced from ' + esc(tpl.dataset.src) + '.' : 'No traced drawing for ' + (m ? esc(m.name) : 'this unit') + ' yet: the outline for its kind.') + '</p></div>' +
          '<ol class="dv-life" aria-label="Lifecycle">' + STAGES.map(function (x, i) { return '<li class="' + (i < at ? 'done' : i === at ? 'now ' + x[0] : '') + '"' + (i === at ? ' aria-current="step"' : '') + '><i></i><span>' + x[1] + '</span></li>'; }).join('') + '</ol>' +
          '</section>';
        body += '<section class="card dv-card s-7 c-facts" data-help="unit.facts" aria-label="Facts">' +
          '<div class="dv-facts"><div><p class="overline">Where</p><dl class="dv-kv">' +
            row('Office', '<a href="' + L('devices/') + '?site=' + r.site + '">' + esc(s.name) + '</a>' + (s.city ? ', ' + esc(s.city) : '')) +
            row('Space', '<a href="' + L('rooms/' + u.room + '/') + '">' + esc(roomLabel(r)) + '</a>' + (r.floor ? ', floor ' + esc(r.floor) : '')) +
            row('Built to', '<a href="' + L('room-profiles/' + r.typeId + '/') + '">' + esc(r.type) + '</a>') +
            row('Position', esc(u.pos.role) + (u.pos.location ? ' · ' + esc(u.pos.location) : '')) +
            (u.rack ? row('Rack', esc(u.rack.name) + ', U' + u.rack.u + (u.rack.size > 1 ? ' to U' + (u.rack.u + u.rack.size - 1) : '')) : '') +
            row('Model', m ? '<a href="' + L('profiles/' + u.pos.cls + '/' + u.pos.model + '/') + '">' + esc(m.name) + '</a>' : 'Set per project') +
            row('Profile', '<a href="' + L('profiles/' + u.pos.cls + '/') + '">' + esc(u.pos.className) + '</a>') +
          '</dl></div><div><p class="overline">Identity</p><dl class="dv-kv">' +
            row('Status', '<span class="pill ' + u.stage + '">' + status + '</span>') +
            row('Hostname', u.host ? '<span class="mono">' + esc(u.host) + '</span>' : 'None') +
            row('Serial', '<span class="mono">' + esc(u.serial) + '</span>') +
            row('Asset tag', '<span class="mono">' + esc(u.tag) + '</span>') +
            (u.net ? row('IP address', '<span class="mono">' + u.net.ip + '</span> ' + R(D.restricted.ipPlan)) + row('MAC', '<span class="mono">' + u.net.mac + '</span>') : '') +
            row('Installed', u.installed ? fmt(u.installed) : (u.stage === 'manage' || u.stage === 'retire' ? 'Not recorded' : 'Not yet')) +
            (u.retired ? row('Taken out', fmt(u.retired)) : '') +
          '</dl></div></div></section>';

        // Advisories for this model change what you do next: one line each, open for the action.
        if (m && m.advisories.length) {
          body += '<section class="card dv-card" data-help="unit.advisories" id="advisories">' + head('Advisories for the ' + esc(m.name), '<span class="faint dv-aside">' + m.advisories.length + '</span>') +
            '<div class="dv-advs">' + m.advisories.map(function (a) {
              return '<details class="dv-adv lv-' + a.level + '"><summary><b class="dv-adv-lv">' + LEVEL[a.level] + '</b><span class="dv-adv-t">' + esc(a.title) + '</span></summary><p>' + esc(a.action) + ' <span class="mono faint">' + a.id + '</span></p></details>';
            }).join('') + '</div></section>';
        }

        // Known errors for this firmware (decision 0029): what the maker publishes about the version this unit runs.
        var kis = KI[u.tag] || [];
        if (kis.length) {
          body += '<section class="card dv-card" data-help="unit.known-issues" id="known-issues">' + head('Known errors for this firmware', '<a class="faint dv-aside" href="' + L('known-issues/') + '">All known errors</a>') +
            '<ul class="dv-kis">' + kis.map(function (k) {
              return '<li><a href="' + k.to + '"><span class="mono">' + esc(k.id) + '</span> ' + esc(k.t) + '</a><small class="faint"> · ' + esc(k.maker) + ', ' + (k.sure ? 'this unit runs ' + esc(k.fw) : 'version not tracked yet') + ' · ' + esc(k.st) + (k.fx ? ', fixed in ' + esc(k.fx) : '') + '</small></li>';
            }).join('') + '</ul></section>';
        }

        // Security support and privacy: when the maker stops fixing security holes (with a warning within 12 months),
        // whether the default password was changed, and for a sensing unit its privacy record. Side by side when both show.
        var pv = u.privacy ? D.privacy[u.privacy] : null;
        var hasSec = Boolean(sec) || u.pw !== null;
        var sp = hasSec && pv ? 's-6' : 's-12';
        if (hasSec) {
          var pwTxt = u.pw === true ? 'Yes' : u.pw === false ? '<span class="ss-chip bad">No: still the maker\'s default</span>' : 'Not recorded';
          var cite = function (x) { return x ? (x.url ? ' <a class="faint" href="' + esc(x.url) + '">' + esc(x.title) + '</a>' : ' <span class="faint">' + esc(x.title) + '</span>') : ''; };
          body += '<section class="card dv-card ' + sp + ' c-sec" data-help="unit.security" id="security">' + head('Security support', sec && sec.chip ? '<span class="ss-chip ' + sec.tone + '">' + esc(sec.chip) + '</span>' : '') +
            '<dl class="dv-kv dv-sec">' +
              (sec ? row('Firmware line', esc(sec.line)) +
                row('Support', esc(sec.text) + (sec.endsDemo ? demoVal() : cite(sec.endsSrc))) +
                row('Report a flaw', sec.contact ? '<a href="' + esc(sec.contact.url) + '">' + esc(sec.contact.url.replace(/^https?:\/\//, '').replace(/\/$/, '')) + '</a>' + (sec.contact.demo ? demoVal() : '') : 'The maker publishes no page')
                : row('Support', m ? 'Not recorded for this model' : 'No model is set for this position, so no maker dates')) +
              row('Default password changed', pwTxt + ' ' + R(D.restricted.passwords)) +
            '</dl>' + (sec ? '<p class="faint dv-foot">From the model\'s record. The maker sets the dates; Keia Atlas tracks them and does not vouch for them.</p>' : '') + '</section>';
        }
        if (pv) {
          body += '<section class="card dv-card ' + sp + ' c-privacy" data-help="unit.privacy" id="privacy">' + head('Privacy', '<span class="faint dv-aside">' + esc(pv.name) + '</span>') +
            (u.spare ? '<p class="dv-sub">In the store it captures nothing. Once fitted at this office, this record applies.</p>' : '') +
            '<dl class="dv-kv dv-priv">' + pv.rows.map(function (x, i) { return row(esc(x[0]), esc(x[1]), i >= 6); }).join('') + '</dl>' + showAll(pv.rows.length, 'rows') +
            (pv.never.length ? '<p class="dv-sub dv-never"><b>Switched off:</b> ' + pv.never.map(esc).join('; ') + '.</p>' : '') +
            '<p class="faint dv-foot">Aigna\'s record for these devices (demo). Keia Atlas keeps the record; it is not legal advice.</p></section>';
        }

        // Row 2: Health, Configuration, and the unit's history.
        body += '<section class="card dv-card s-4 c-health" data-help="unit.health">' + head('Health', '<button type="button" class="btn small" data-help="unit.check" data-dv-check>Check again</button>') + '<ul class="dv-checks">' +
          u.platforms.map(function (p) { var bad = p === 'device_management' && u.stage === 'deploy'; return '<li><span class="dv-c" data-c' + (bad ? ' data-bad' : '') + '>' + '<span class="sp"></span>' + tick + '<svg class="x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M7 7l10 10M17 7L7 17"/></svg></span><b>' + (PLAT[p] || p) + '</b><span class="faint">' + ({ keia_atlas: 'Recorded where the space type expects it', inventory: 'Active record in this space', dhcp_dns: u.net ? 'Reservation ' + u.net.ip + ' and DNS ' + u.host : 'Not networked', device_management: bad ? 'Not enrolled yet: finish provisioning' : m && m.fw ? 'Online, firmware ' + m.fw.version + ' (standard)' : 'Online', room_booking: 'Calendar resource linked', monitoring: 'Reporting, no critical alerts' }[p] || '') + '</span></li>'; }).join('') +
          '</ul><p class="faint dv-foot">These checks are simulated. With real feeds they read the real systems.</p></section>';

        var cfg = '';
        if (m && m.config) {
          var val = function (x) {
            var v = { 'Device Name': u.host, 'Host Name': u.host, 'Space Name': roomLabel(r), 'Location': s.country, 'Time Zone': s.tz, 'Time zone': s.tz, 'Room calendar': (s.city || s.name).replace(/ /g, '-') + '-' + roomLabel(r).replace(/ /g, '-'), 'Enroll a device with a code': 'Device name: ' + u.host, 'Sign-in Address': u.host + '@sip.aigna.example' }[x.name];
            return v || x.value;
          };
          cfg += '<p class="dv-sub">' + esc(m.config.name) + ', version ' + esc(m.config.version) + (m.fw ? ', on firmware <span class="mono">' + esc(m.fw.version) + '</span>' : '') + '. Set from this unit\'s record.</p>' +
            '<dl class="dv-kv dv-cfg">' + m.config.perDevice.map(function (x, i) { return row(esc(x.name), '<span class="mono">' + esc(val(x)) + '</span>', i >= FIRST); }).join('') + '</dl>' + showAll(m.config.perDevice.length, 'values');
        } else {
          cfg += '<p class="dv-sub">Nothing to set on this unit itself. It works as it comes, or it is set up through the device it connects to.</p>';
        }
        body += '<section class="card dv-card s-4 c-config" data-help="unit.config">' + head('Setup guide', m && m.config ? '<a class="btn small" href="' + L('configurations/' + m.config.id + '/') + '">Every setting</a>' : '') + cfg + '</section>';

        // History: incidents, tasks in this room, Lab tests of this model, and the unit's own dates. Newest first.
        var H = [];
        inc.forEach(function (i) { H.push({ d: i.opened, k: 'inc', open: OPEN(i.state), href: L('incidents/' + i.number.toLowerCase() + '/'), id: i.number, t: i.title, sub: 'Incident · P' + i.priority + ' · ' + (W.inc[i.state] || cap(i.state)) }); });
        r.tasks.forEach(function (t) { H.push({ d: t.due, k: 'task', open: t.status !== 'done', href: L('projects/' + t.project.toLowerCase() + '/'), id: t.id, t: t.title, sub: 'Task · ' + esc(t.projectName || t.project) + ' · ' + (W.task[t.status] || cap(t.status)) + (t.status !== 'done' ? ', due' : '') }); });
        if (m) m.labs.forEach(function (l) { H.push({ d: l.end || l.start, k: 'lab', href: L('lab/') + '#' + l.id.toLowerCase(), id: l.id, t: l.title, sub: 'Lab test of the ' + esc(m.name) + ' · ' + cap(l.status) }); });
        if (u.installed) H.push({ d: u.installed, k: 'life', t: 'Installed', sub: 'Went live in ' + esc(roomLabel(r)) });
        if (u.retired) H.push({ d: u.retired, k: 'life', t: 'Taken out', sub: 'Retired' });
        H.sort(function (a, b) { return (b.d || '').localeCompare(a.d || ''); });
        var when = function (h) { if (!h.d) return 'No date'; var dt = new Date(h.d); return dt.toLocaleDateString('en-IE', { day: 'numeric', month: 'short' }) + '<small>' + dt.getFullYear() + '</small>'; };
        var hx = H.map(function (h, i) {
          return '<li class="hx hx-' + h.k + (h.open ? ' open' : '') + '"' + (i >= FIRST - 1 ? ' data-more hidden' : '') + '><time>' + when(h) + '</time><i aria-hidden="true"></i><div>' +
            (h.href ? '<a href="' + h.href + '"><span class="mono">' + esc(h.id) + '</span> ' + esc(h.t) + '</a>' : '<b>' + esc(h.t) + '</b>') + '<small>' + h.sub + '</small></div></li>';
        }).join('');
        body += '<section class="card dv-card s-4 c-history" data-help="unit.history" id="history">' + head('Work and incidents', '<span class="faint dv-aside">Newest first</span>') +
          (H.length ? '<ol class="dv-hx">' + hx + '</ol>' + (H.length >= FIRST ? '<button type="button" class="btn small dv-all" data-help="section.showall" data-show-all>Show all ' + H.length + '</button>' : '') : '<p class="faint">No work or incidents on this unit yet.</p>') + '</section>';

        // Row 3: usage and how it is wired. However many cards there are, they fill the row.
        var r3 = [];
        if (u.usage) {
          var us = u.usage;
          r3.push('<section class="card dv-card SPAN c-usage" data-help="unit.usage">' + head('Usage') +
            (us.flag ? '<p class="dv-use-f"><span class="uflag ' + us.flag.tone + '">' + esc(us.flag.text) + '</span></p>' : '') +
            '<dl class="dv-kv dv-use">' + us.lines.map(function (l) { return row(esc(l[0]), esc(l[1])); }).join('') + '</dl>' +
            '<p class="src-note"><b>Source:</b> ' + esc(us.source) + '</p>' +
            '<a class="btn small" href="' + L('usage/equipment/') + '#' + us.tab + '">' + esc(us.label) + ' across the fleet</a></section>');
        }
        if (u.conn.length) {
          r3.push('<section class="card dv-card SPAN c-conn" data-help="unit.connections" id="connections">' + head('Connections', '<span class="faint dv-aside">' + u.conn.length + ' cable' + (u.conn.length > 1 ? 's' : '') + '</span>') + '<table class="dv-t"><thead><tr><th>Port</th><th>Goes to</th><th>Cable</th></tr></thead><tbody>' +
            u.conn.map(function (c) { return '<tr><td class="mono">' + esc(c.port) + '</td><td>' + esc(c.to) + '</td><td>' + esc(c.cable) + '</td></tr>'; }).join('') + '</tbody></table></section>');
        }
        if (u.net || r.path.idf || r.path.mdf) {
          r3.push('<section class="card dv-card SPAN c-net" data-help="unit.network">' + head('Network') + '<ol class="dv-path">' +
            '<li><b>' + esc(u.host || u.pos.role) + '</b>' + (u.net ? '<small class="mono">' + u.net.fqdn + '</small>' : '') + '</li>' +
            (r.path.idf ? '<li><a href="' + L('rooms/' + r.path.idf.id + '/') + '">' + esc(r.path.idf.name) + '</a><small>Floor switch</small></li>' : '<li><b>Floor comms room</b><small>Not recorded for this site yet</small></li>') +
            (r.path.mdf && (!r.path.idf || r.path.mdf.id !== r.path.idf.id) ? '<li><a href="' + L('rooms/' + r.path.mdf.id + '/') + '">' + esc(r.path.mdf.name) + '</a><small>Core and firewall</small></li>' : '') +
            '<li><b>Internet</b><small>Meeting services and device management</small></li></ol></section>');
        }
        var span3 = r3.length === 1 ? 's-12' : r3.length === 2 ? 's-6' : 's-4';
        r3.forEach(function (h) { body += h.replace('SPAN', span3); });
        var el = root.querySelector('[data-dv-body]'); el.innerHTML = body; el.hidden = false;
        // Frame the drawing on the unit itself, so it fills the stage. The caption gives its real size. Small
        // units are enlarged at most about twice, so a touch panel never looks as big as a video bar.
        var svg = el.querySelector('.dv-stage > svg.model-art');
        if (svg) try {
          var b = svg.getBBox(), pad = Math.max(b.width, b.height) * 0.08;
          var w = Math.max(b.width + pad * 2, 150), h = Math.max(b.height + pad * 2, 84);
          svg.setAttribute('viewBox', [b.x + b.width / 2 - w / 2, b.y + b.height / 2 - h / 2, w, h].map(function (n) { return n.toFixed(1); }).join(' '));
        } catch (_) {}
        el.querySelectorAll('[data-show-all]').forEach(function (more) {
          more.addEventListener('click', function () {
            var card = more.closest('.dv-card');
            var swap = function () { card.querySelectorAll('[data-more]').forEach(function (li) { li.hidden = false; }); more.remove(); };
            if (window.rsHold) window.rsHold(el, swap); else swap();
          });
        });
        // Health checks: a spinner, then a light, one row after another (motion tokens, rule book M1 and M7).
        var timers = [];
        var run = function () {
          var M = window.rsMotion ? window.rsMotion() : { reduced: true };
          var cs = el.querySelectorAll('[data-c]');
          timers.forEach(clearTimeout); timers = [];
          cs.forEach(function (c) { c.className = 'dv-c'; });
          if (M.reduced) { cs.forEach(function (c) { c.classList.add(c.hasAttribute('data-bad') ? 'bad' : 'ok'); }); return; }
          cs.forEach(function (c, i) {
            timers.push(setTimeout(function () { c.classList.add('checking'); }, M.delay + i * M.pop));
            timers.push(setTimeout(function () { c.classList.remove('checking'); c.classList.add(c.hasAttribute('data-bad') ? 'bad' : 'ok'); }, M.delay + i * M.pop + M.morph));
          });
        };
        el.querySelector('[data-dv-check]').addEventListener('click', run); run();
      }
    })();
  </script>
</Shell>
<style is:global>
  /* Search mode */
  .dv-search input { width: min(560px, 100%); margin-top: 14px; font: 500 var(--fs-h3)/1.2 var(--font-sans); padding: 12px 14px; border-radius: 12px; border: 2px solid var(--line-strong); background: var(--surface); color: var(--text); }
  .dv-search[hidden] { display: none; }
  .dv-results { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .dv-results[hidden] { display: none; }
  .dv-hit { display: grid; grid-template-columns: 70px minmax(0, 1fr) auto 200px; gap: 14px; align-items: center; padding: 8px 12px; border-radius: var(--radius); background: var(--surface); border: var(--border-card); color: inherit; text-decoration: none; }
  .dv-hit:hover { color: inherit; box-shadow: var(--shadow-md); }
  .dv-hit b { display: block; font-size: var(--fs-body); } .dv-hit small { display: block; font-size: var(--fs-code); color: var(--text-3); }
  .dv-hit-art { width: 70px; height: 36px; display: grid; place-items: center; color: var(--text-2); }
  .dv-hit-art svg, .dv-hit-art .model-art { max-width: 100%; max-height: 100%; }

  /* Known errors for this firmware (decision 0029): one line each, a link to the known issue. */
  .dv-kis { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-size: var(--fs-body); }
  .dv-kis li { padding: 8px 12px; border-radius: var(--radius); background: var(--surface-2); overflow-wrap: anywhere; }

  /* Advisories for this model, in their own card: one line each; open for the action. */
  .dv-advs { display: grid; gap: 6px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr)); }
  .dv-adv { border-radius: var(--radius); background: var(--surface); border: 1.5px solid var(--line-strong); font-size: var(--fs-support); }
  .dv-adv summary { display: grid; grid-template-columns: 100px minmax(0, 1fr); gap: 8px; align-items: baseline; padding: 7px 12px; cursor: pointer; list-style: none; }
  .dv-adv summary::-webkit-details-marker { display: none; }
  .dv-adv-t { font-weight: var(--fw-name); min-width: 0; }
  .dv-adv p { margin: 0; padding: 0 12px 9px 120px; color: var(--text-2); font-size: var(--fs-code); }
  .dv-adv-lv { font: 500 var(--fs-overline)/1.4 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }
  .dv-adv.lv-do-not-install { border-color: var(--red); background: color-mix(in srgb, var(--red) 6%, var(--surface)); } .dv-adv.lv-do-not-install .dv-adv-lv { color: var(--red-ink); }
  .dv-adv.lv-act { border-color: var(--amber); } .dv-adv.lv-act .dv-adv-lv { color: var(--amber-ink); } .dv-adv.lv-check .dv-adv-lv { color: var(--blue-ink); }

  /* One grid: the shared 12 columns (.g12), equal gutters. Cards in a row stretch to the same height. */
  .dv-grid[hidden] { display: none; }
  .dv-card { min-width: 0; padding: 14px 16px; display: flex; flex-direction: column; gap: 10px; }
  :root[data-look="classic"] .dv-card { border: 2px solid var(--ink); box-shadow: var(--shadow-panel); }
  .dv-ch { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 28px; }
  .dv-ch h2 { margin: 0; font: var(--fw-title) var(--fs-h3)/1.2 var(--font-display); }
  .dv-aside { font-size: var(--fs-code); }
  .dv-sub { margin: 0; font-size: var(--fs-code); color: var(--text-3); }
  .dv-foot { margin: auto 0 0; font-size: var(--fs-code); }
  .dv-card > .btn { align-self: flex-start; }
  .dv-row[hidden] { display: none; }

  /* The drawing: as big as its column allows, on the drafting-grid stage. */
  .c-art { padding: 10px; gap: 8px; }
  .dv-stage { position: relative; flex: 1 0 auto; min-height: 210px; color: var(--text-2); overflow: hidden; }
  .dv-stage > .model-art, .dv-stage > svg { position: absolute; inset: 4px 8px 26px; width: calc(100% - 16px); height: calc(100% - 30px); view-transition-name: art-hero; }
  .dv-stage.generic > .model-art, .dv-stage.generic > svg { inset: 24px 30% 40px; width: 40%; height: calc(100% - 64px); aspect-ratio: auto; }
  .dv-stage.generic .model-art.generic svg { width: 100%; height: 100%; }
  .dv-cap { position: absolute; left: 10px; right: 10px; bottom: 6px; margin: 0; font-size: var(--fs-mark); line-height: 1.3; color: var(--text-3); }
