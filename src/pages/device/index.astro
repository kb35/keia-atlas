  .dv-row dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  .dv-row .pill { padding: 3px 8px; font-size: var(--fs-code); }
  .dv-cfg .dv-row { grid-template-columns: minmax(96px, 42%) minmax(0, 1fr); }
  .dv-cfg .mono { font-size: var(--fs-code); }
  .dv-use .dv-row { grid-template-columns: minmax(110px, 48%) minmax(0, 1fr); }
  .dv-sec .dv-row, .dv-priv .dv-row { grid-template-columns: minmax(110px, 30%) minmax(0, 1fr); align-items: baseline; }
  .dv-never { overflow-wrap: anywhere; }
  [data-dv-status] .ss-chip { text-decoration: none; }

  /* Health */
  .dv-checks { list-style: none; margin: 0; padding: 0; }
  .dv-checks li { display: grid; grid-template-columns: 18px minmax(96px, 40%) minmax(0, 1fr); gap: 10px; align-items: center; min-height: 32px; border-top: 1px solid var(--line); font-size: var(--fs-support); }
  .dv-checks li:first-child { border-top: 0; }
  .dv-checks .faint { font-size: var(--fs-code); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dv-c { display: grid; place-items: center; color: #fff; }
  .dv-c > * { grid-area: 1 / 1; }
  .dv-c .sp { width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--h-progress, var(--blue)); border-top-color: transparent; transform: rotate(45deg); opacity: 0; }
