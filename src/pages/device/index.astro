  .hx.hx-inc i { border-color: var(--red); } .hx.hx-inc.open i { background: var(--red); }
  .hx.hx-task.open i { border-color: var(--blue); background: var(--blue); } .hx.hx-task i { border-color: var(--blue); }
  .hx.hx-lab i { border-color: var(--violet); } .hx.hx-life i { border-color: var(--green); background: var(--green); }
  .hx a, .hx b { font-weight: 600; } .hx a .mono { font-weight: 500; font-size: var(--fs-code); color: var(--text-3); }
  .hx small { display: block; margin-top: 2px; font-size: var(--fs-mark); color: var(--text-3); }
  .hx.hx-inc.open small { color: var(--red-ink); }

  /* Usage, connections, network */
  .dv-use-f { margin: 0; } .c-usage .src-note { margin: 0; }
  .dv-t { width: 100%; min-width: 0; border-collapse: collapse; font-size: var(--fs-code); table-layout: fixed; }
