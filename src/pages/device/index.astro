  .dv-life li { position: relative; display: grid; justify-items: center; gap: 5px; text-align: center; font-size: clamp(10px, .78vw, 11px); line-height: 1.2; color: var(--text-3); }
  .dv-life li::before { content: ""; position: absolute; top: 5px; right: 50%; width: 100%; height: 2px; background: var(--line-strong); }
  .dv-life li:first-child::before { display: none; }
  .dv-life i { position: relative; width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--line-strong); background: var(--surface); transition: background var(--dur-state) var(--ease-settle); }
  .dv-life li.done i { background: var(--text-2); border-color: var(--text-2); } .dv-life li.done::before, .dv-life li.now::before { background: var(--text-2); }
  .dv-life li.now { color: var(--text); font-weight: var(--fw-title); }
