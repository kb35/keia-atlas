      }
      addLocal();

      // ---- Sort ----
      var KEYS = {
        soon: function (r) { return r.dataset.when + r.dataset.kr; },
        kind: function (r) { return r.dataset.kr + r.dataset.when; },
        person: function (r) { return r.dataset.pn + '|' + r.dataset.when; },
        site: function (r) { return r.dataset.sr + r.dataset.when + r.dataset.kr; },
