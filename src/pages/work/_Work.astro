      }
      var rc = root.querySelector('[data-rc]'), rcEmpty = root.querySelector('[data-rc-empty]');
      function renderRecent(fresh) {
        if (!rc) return;
        var evs = L ? L.live.events().slice(-8).reverse() : [];
        rc.innerHTML = evs.map(function (e, i) {
          var p = person(e.who), link = linkOfItem(e.item);
          return '<li class="rc-i' + (fresh && i === 0 ? ' m-enter' : '') + (e.undoes ? ' rc-undo' : '') + '"><span class="ov-av" title="' + esc(p.n) + '">' + esc(p.i) + '</span>' +
            '<span class="rc-b"><span><b>' + esc(p.n) + '</b> ' + esc(e.note === 'Undo' ? 'undid a change: ' : e.note === 'Redo' ? 'redid a change: ' : '') + esc(say(e)) + '</span>' +
            '<small>' + esc(p.role || '') + ' · ' + esc(ago(e.at)) + '</small></span>' +
            '<span class="rc-act"><button type="button" class="btn small ghost" data-rc-history="' + esc(e.item) + '">History</button>' + (link ? '<a class="rc-open" href="' + esc(link) + '" aria-label="Open ' + esc(titleOf(e.item)) + '">Open</a>' : '') + '</span></li>';
