      });
      var refresh = function () { document.dispatchEvent(new CustomEvent('rs:find-refresh')); };
      function go() {
        L = W.rsLive; if (!L || !document.body.contains(root)) return;
        var base = function (item) { return baseOf(item); };
        var describe = function (e) { return say(e).replace(/^./, function (c) { return c.toUpperCase(); }); };
        ['task:', 'refresh:'].forEach(function (pre) { L.register(pre, { base: base, describe: describe }); });
        var seen = {};
        L.live.events().forEach(function (e) { if (D.items[e.item] && !seen[e.item]) { seen[e.item] = 1; paint(e.item, null); } });
        refresh(); renderRecent(false);
        var stop = L.live.subscribe('*', function (e) {
          if (!document.body.contains(root)) return;
          if (D.items[e.item]) { paint(e.item, e.who); refresh(); }
          renderRecent(true);
        });
        cleanups.push(stop);
      }
      if (W.rsLive) go(); else { document.addEventListener('rs:live-ready', go, { once: true }); if (rcEmpty) rcEmpty.hidden = false; }

      // ---- The queue's figures follow who has each job (the live layer), and With you follows who is signed in ----
      var q = root.querySelector('[data-ov-q]');
      function syncQueue() {
        if (!q) return;
        var LL = W.rsLive && W.rsLive.live, me = W.rsWhoId ? W.rsWhoId() : 'anna', all = me === 'everyone';
        var n = { ready: 0, mine: 0, some: 0, waiting: 0 };
        q.querySelectorAll('[data-item]').forEach(function (row) {
          var base = null; try { base = JSON.parse(row.dataset.base || 'null'); } catch (_) {}
          var o = LL ? (LL.stateOf(row.dataset.item, { own: base }).own || base) : base;
