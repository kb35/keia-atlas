          if (!it.e) return 'No date yet';
          var n = Math.round((Date.parse(it.e) - Date.parse(D.today)) / 864e5);
          return n < 0 ? -n + (n === -1 ? ' day' : ' days') + ' late' : n === 0 ? 'Due today' : n === 1 ? 'Due tomorrow' : 'Due ' + fd(it.e) + (s.start && s.start !== it.s ? ', starts ' + fd(s.start) : '');
