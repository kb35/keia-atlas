  .rpt-m { display: grid; gap: 2px; min-width: 0; }
  @container content (max-width: 559px) { .rpt-r { grid-template-columns: 56px minmax(0, 1fr); } .rpt-r .end { grid-column: 2; justify-self: start; } }
  /* The queue: the same row as the Queue page. */
