      // ---- The live layer: changes made anywhere are replayed here, marked with who, and listed ----
      var L = null;
      var baseOf = function (id) { var it = D.items[id]; return it ? { owner: it.w[0] || null, start: it.k === 'refresh' ? null : it.s, status: it.st } : {}; };
      function whenText(it, s) {
        if (it.k === 'refresh') return s.start ? 'Booked ' + fd(s.start) : 'By ' + fd(it.e) + ' ' + (it.e || '').slice(0, 4);
