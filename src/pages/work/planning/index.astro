          const yl = f.year ? fyLabel(+f.year.replace('fy', '')) : '';
          const name = c.op === 'cut' ? `Cut ${c.percent}% from ${yl}` : c.op === 'new-office' ? `Open a ${(D.sizes[c.size] || 'medium').toLowerCase()} ${c.city} office in ${yl}` : c.op === 'early' ? `Refresh every ${(D.classes.find((x: any) => x.id === c.class) || { name: c.class }).name.toLowerCase()} in ${yl}` : `Delay the ${c.group === 'network' ? 'network' : 'AV'} refresh ${c.years === 1 ? 'a year' : `${c.years} years`}`;
          const id = `typed-${Date.now().toString(36)}`;
          const sc: Sc = { id, name, say: 'Typed on the Planning page.', owner: live.who(), changes: [c] };
          live.live.record({ item: 'scenario:' + id, field: 'defined', before: null, after: sc, who: live.who(), note: 'Scenario added' });
