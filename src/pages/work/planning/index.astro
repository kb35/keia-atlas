      }

      /* ---- The live layer. */
      let stop: (() => void) | null = null;
      const go = () => {
        live = W.rsLive; if (!live) return;
        live.register('scenario:', { base: () => ({ adopted: false }), describe: (e: any) => (e.field === 'defined' ? 'Scenario added' : e.after ? 'Adopted into the plan' : 'Taken out of the plan') });
        readAdopted();
        for (const s of scenarios) paintCard(s.id, false);
        paintAll(false);
        if (stop) stop();
        stop = live.live.subscribe('scenario:', (e: any, info: any) => {
          const id = e.item.slice(9);
          if (e.field === 'defined') { if (!scById()[id] && e.after) { scenarios.push({ ...(e.after as Sc), id, typed: true }); addCard(scenarios[scenarios.length - 1], e.who); if (bar.rsFilter) bar.rsFilter.refresh(); paintYear(false); } return; }
          readAdopted(); paintCard(id, !!(info && info.remote), e.who, info && info.remote ? null : e); paintAll(true);
