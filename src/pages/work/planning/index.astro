        }
      };
      bar.addEventListener('fb:sort', () => bar.rsFilter.run(true, order));
      const s0 = new URLSearchParams(location.search).get('sort'); if (s0 && s0 !== 'amount') order();

      /* ---- Compare: the chosen scenario against the plan, side by side. */
      function showCompare(id: string, animate: boolean) {
