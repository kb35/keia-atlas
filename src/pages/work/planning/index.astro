        live.live.record({ item: 'scenario:' + id, field: 'adopted', before: !!now.adopted, after: on, who: live.who(), note: on ? 'Adopted into the plan' : 'Taken out of the plan' });
      }
      function paintCard(id: string, mark: boolean, who?: string | null, ev?: any) {
        const card = q(`[data-sc="${id}"]`); if (!card) return;
        const st = state(id), on = !!st.adopted;
        card.classList.toggle('is-adopted', on);
        const btn = q('[data-sc-adopt]', card); if (btn) { btn.textContent = on ? 'Take out of the plan' : 'Adopt'; btn.classList.toggle('is-on', on); btn.classList.toggle('primary', !on); btn.classList.toggle('ghost', on); }
        const lab = q('[data-sc-state]', card);
        if (lab) { lab.hidden = !on; if (on) { const last = (live.live.historyOf('scenario:' + id) as any[]).find((e) => e.field === 'adopted' && !e.undoneBy); lab.textContent = last ? `Adopted by ${live.name(last.who)}, ${new Date(last.at).toLocaleString('en-IE', { hour: '2-digit', minute: '2-digit', day: 'numeric', month: 'short' })}` : 'Adopted'; } }
        const undo = q('[data-sc-undo]', card) as HTMLElement | null;
        if (undo) { if (ev && !ev.undoes) { undo.hidden = false; undo.dataset.ev = ev.id; clearTimeout((undo as any).__t); (undo as any).__t = setTimeout(() => { undo.hidden = true; }, M().linger || 4000); } else undo.hidden = true; }
        if (mark && W.rsMarkChanged) W.rsMarkChanged(card, who ? live.name(who) : null);
      }
      function readAdopted() {
        if (!live) return;
        const evs = (live.live.events() as any[]).filter((e) => e.item.startsWith('scenario:'));
        // Typed scenarios: their definition is an event too, so they come back on every open of the page.
        for (const e of evs) if (e.field === 'defined' && e.after && !scById()[e.item.slice(9)]) { scenarios.push({ ...(e.after as Sc), id: e.item.slice(9), typed: true }); addCard(scenarios[scenarios.length - 1], e.who); }
        const order: string[] = [];
        for (const s of scenarios) { const st = state(s.id); if (st.adopted) { const last = evs.filter((e) => e.item === 'scenario:' + s.id && e.field === 'adopted' && !e.undoneBy).pop(); order.push(`${last ? last.at : ''}|${s.id}`); } }
        adopted = order.sort().map((x) => x.split('|')[1]);
      }
      const esc = (s: unknown) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string);
      function addCard(s: Sc, who: string | null) {
        const grid = q('[data-sc-grid]'); if (!grid || q(`[data-sc="${s.id}"]`)) return;
        const res = applyScenario(D.baseline, s, D.ctx), rows = compare(D.baseline, res, D.ctx);
