        const rows = compare(D.baseline, applyScenario(D.baseline, s, D.ctx), D.ctx);
        const host = q('[data-compare-host]'), box = q('[data-compare]'); if (!host || !box) return;
        for (const b of qa('[data-sc-compare]')) b.setAttribute('aria-pressed', String(b.dataset.scCompare === id));
        const draw = () => { const n = q('[data-compare-name]'); if (n) n.textContent = s.name; box.innerHTML = compareHtml(rows, s.name); };
        if (animate && W.rsPanelSwap) W.rsPanelSwap(host, draw); else if (animate && W.rsHold) W.rsHold(host, draw); else draw();
      }
      root.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        const c = t.closest('[data-sc-compare]') as HTMLElement | null; if (c) { showCompare(c.dataset.scCompare!, true); const sec = q('#compare'); if (sec && sec.getBoundingClientRect().top > innerHeight - 80) sec.scrollIntoView({ behavior: M().reduced ? 'auto' : 'smooth', block: 'start' }); return; }
        const a = t.closest('[data-sc-adopt]') as HTMLElement | null; if (a) { adopt(a.dataset.scAdopt!, !a.classList.contains('is-on')); return; }
        const u = t.closest('[data-sc-undo]') as HTMLElement | null; if (u && u.dataset.ev && live) { live.live.undo(u.dataset.ev, { who: live.who(), base: {} }); return; }
        const h = t.closest('[data-sc-history]') as HTMLElement | null; if (h && live) { const s = scById()[h.dataset.scHistory!]; live.history('scenario:' + h.dataset.scHistory, s ? s.name : 'Scenario'); }
      });

      /* ---- Adopt: a live-layer event (who, when, Undo in History); adopted scenarios feed every figure. */
      const state = (id: string) => (live ? live.live.stateOf('scenario:' + id, { adopted: false, adoptedAt: null }) : { adopted: false });
      function adopt(id: string, on: boolean) {
        if (!live) return;
