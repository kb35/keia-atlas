        el.dataset.find = `${s.name} ${s.say} ${s.changes.map((c) => c.op).join(' ')}`; el.dataset.fRegion = region; el.dataset.fSite = ''; el.dataset.fKind = kind; el.dataset.fStatus = 'estimated'; el.dataset.fYear = yearIds.join('|'); void years;
        el.innerHTML = `<header class="pl-sch"><h3>${esc(s.name)}</h3><span class="pl-adopted" data-sc-state hidden></span></header><p class="pl-say">${esc(s.say)}</p><ul class="pl-notes">${res.notes.map((n: string) => `<li>${esc(n)}</li>`).join('')}</ul><p class="pl-effect"><b>Effect:</b> ${esc(effectWords(rows))}</p>` +
          `<dl class="pl-sc-year" data-sc-year><div><dt>Spend, <span data-sc-ylabel></span></dt><dd class="num" data-sc-v="spend"></dd></div><div><dt>Devices</dt><dd class="num" data-sc-v="units"></dd></div><div><dt>Technician hours</dt><dd class="num" data-sc-v="tech"></dd></div></dl>` +
          `<footer class="pl-scf"><span class="faint">Typed by ${esc(who ? live.name(who) : 'you')}</span><span class="pl-scb"><button type="button" class="btn small ghost" data-sc-compare="${esc(s.id)}" aria-pressed="false" data-help="planning.compare-btn">Compare</button><button type="button" class="btn small primary" data-sc-adopt="${esc(s.id)}" data-help="planning.adopt">Adopt</button><button type="button" class="btn small ghost" data-sc-undo hidden>Undo</button><button type="button" class="btn small ghost" data-sc-history="${esc(s.id)}" data-help="live.history">History</button></span></footer>`;
        const form = q('[data-try]'); if (form && form.nextSibling) grid.insertBefore(el, form.nextSibling); else grid.appendChild(el);
        // Its estimated lines, for the Budget view.
        const host = q('[data-new-lines]');
        if (host) for (const y of res.years) for (const p of y.estimated.projects) {
          const a = document.createElement('a'); a.className = 'row plain pl-line'; a.href = '#scenarios'; a.hidden = true; a.dataset.scLine = s.id; a.dataset.i = '900'; a.dataset.eur = String(p.eur); a.dataset.s = '99'; a.dataset.name = p.name; a.setAttribute('data-help', 'planning.line'); a.dataset.plGoto = 'scenarios';
          a.dataset.find = `${p.name} ${s.name} Estimated ${fyLabel(y.n)}`; a.dataset.fRegion = p.region; a.dataset.fSite = ''; a.dataset.fKind = p.kind; a.dataset.fStatus = 'estimated'; a.dataset.fYear = y.id;
          a.innerHTML = `<span><span class="name">${esc(p.name)}</span><span class="sub">${esc(s.name)} · ${p.units} units in ${p.rooms} spaces, ${p.staff} staff</span></span><span class="end"><span class="pill plain pl-st st-estimated">Estimated</span><span class="pl-amt num"><b>${esc(money(p.eur))}</b><small>${esc(fyLabel(y.n))} · ${esc(D.kindLabel[p.kind] || p.kind)}</small></span><span class="pl-open faint">Scenario →</span></span>`;
          host.appendChild(a);
        }
        const m = M(); if (!m.reduced && who === (live && live.who())) el.animate([{ opacity: 0, transform: 'scale(.94)' }, { opacity: 1, transform: 'none' }], { duration: m.enter, easing: m.ease });
      }

      /* ---- Try a scenario: the form makes one from its fields; the live layer keeps it. */
      const form = q('[data-try]') as HTMLFormElement | null;
      if (form) {
        const opSel = q('[data-try-op]', form) as HTMLSelectElement;
        const showFields = () => { for (const f of qa('[data-for]', form)) f.hidden = !f.dataset.for!.split(' ').includes(opSel.value); };
        opSel.addEventListener('change', () => { if (W.rsHold) W.rsHold(form, showFields); else showFields(); });
