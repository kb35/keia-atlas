---
// Home: the dark cockpit (design notes, BUILD-PLAN V3). One skeleton for every role:
//   Band     the answer sentence ("Dublin: 1 space with a fault · 33 spaces ready · checked 40 s ago") and four
//            figures that say how many need you; each opens the list it counts
//   Summary  the figures opened, in the role's order: Ready for you, the role's first section (My day, the queue,
//            For your approval, the projects, the estate, the team), With you | To review, the floors or the estate
//   Record   everything else, below the "Open pages like this here" boundary: done automatically today, what changed
//            overnight, knowledge to review, your tasks, and the role's detail (firmware, gates, regions...)
// Quiet when fine: nothing fine is coloured, nothing moves; the heartbeat proves it was checked. When something is not
// fine it shows once: the sentence changes, one figure takes the fault colour, the row appears (docs/rules/motion.md).
// Work has one owner and moves as a whole: every job row carries its With chip, and Take, Hand to, Park and Resume
// act on it (src/lib/ownership.mjs, through the live layer so every window agrees). Welcome back replaces Home once
// after time away (the demo switch in Settings), with the same handover card that parks a job.
// Role changes what comes first, never what exists (P4). The page draws whoever is viewing in the browser
// (src/lib/home-client.mjs), so View as re-renders in place.
import Shell from '../layouts/Shell.astro';
import Icon from '../components/Icon.astro';
import PageBand from '../components/PageBand.astro';
import Section from '../components/Section.astro';
import KeyNumbers from '../components/KeyNumbers.astro';
import StageBar from '../components/StageBar.astro';
import LiveBar from '../components/LiveBar.astro';
import GuideLive from '../components/GuideLive.astro';
import HealthGlyph from '../components/HealthGlyph.astro';
import HandoverCard from '../components/HandoverCard.astro';
import OpenHere from '../components/OpenHere.astro';
import SmallMultiples from '../components/SmallMultiples.astro';
import LeadershipHome from '../components/LeadershipHome.astro';
import PartnerHome from '../components/PartnerHome.astro';
// Room checks due for the viewer (the Room checks capability, src/lib/modules.mjs).
import HomeChecks from '../components/HomeChecks.astro';
import PortfolioHome from '../components/PortfolioHome.astro';
import '../styles/withchip.css';
import '../styles/handover.css';
import '../styles/home.css';
import { homeData, ITEMS, SPACE_HEALTH, SITE_HEALTH } from '../lib/home.mjs';
import { lights, nextGate } from '../lib/project-status.mjs';
import { building } from '../lib/floors.mjs';
import {
  advisories, ADV_LEVEL, ADV_ORDER, models as MODELS, firmwareLines, sites, siteStats, SITE_ORDER, totals, href, modelName,
  projects, PHASE_LABEL, fmtDate, DEMO_TODAY, labTests, LAB_STATUS, countryName, REGION_LABEL,
} from '../lib/data.mjs';
import { PEOPLE, person, INBOX_SEED } from '../lib/demo.mjs';
import { PATHS } from './learn/_lessons.mjs';
import { vendors as VENDORS } from '../lib/data.mjs';
import { serviceModel } from '../lib/services-view.mjs';
import { experience, serviceLevels } from '../lib/experience.mjs';
import { SERVICE_ORDER } from '../lib/services.mjs';
import { leadership } from '../lib/costs.mjs';
import { partnerBand } from '../lib/vendors.mjs';
import { portfolio } from '../lib/engagements.mjs';
import { sparkSvg } from '../lib/spark.mjs';
import { tally } from '../lib/health.mjs';
import Arrive from '../components/Arrive.astro';
import { homeLines } from '../lib/oncall-view.mjs';

const H = homeData();
// Leadership (V7): "are we OK, and what does it cost?" The AV service's experience across every office (the same figures
// as the AV service page), the finance connector's month, and what is to review (src/lib/costs.mjs; all simulated).
const FIRST_NAME = Object.fromEntries(PEOPLE.map((p) => [p.id, p.name.split(' ')[0]]));
const avM = serviceModel('av');
const LEAD = leadership({
  vendors: Object.values(VENDORS), experience: experience('av', avM.sites.map((s) => ({ id: s.id, weight: Math.max(1, siteStats[s.id]?.spaces.length ?? s.units.length) }))),
  behind: avM.behind, today: DEMO_TODAY, servicesWithin: SERVICE_ORDER.every((s) => serviceLevels(s).every((r) => r.kept)), owners: FIRST_NAME,
});
const SPARK_FMT = { '%': (x) => `${Math.round(x)}%`, min: (x) => `${Math.round(x)} min`, eur: (x) => `€${Math.round(x).toLocaleString('en-IE')}` };
const LEAD_TO = { ontime: '/services/av/#experience', first: '/services/av/#experience', lost: '/services/av/#experience', cost: '#costs' };
H.cockpit.lead = {
  answer: LEAD.answer,
  figures: LEAD.figures.map((f) => ({ id: f.id, n: f.n, label: f.label, to: LEAD_TO[f.id], title: `${f.title} · from ${f.source.from}, ${f.source.at}`,
    spark: sparkSvg(f.spark, { state: f.state, fmt: SPARK_FMT[f.fmt], span: f.id === 'cost' ? '12 months' : '30 days' }) })),
};
// Partners (V7): the jobs handed to each partner's company, with the contract clock (src/lib/vendors.mjs; simulated).
H.cockpit.partner = Object.fromEntries(PEOPLE.filter((p) => p.vendor).map((p) => { const B = partnerBand(p.id); return [p.id, { withYou: B.withYou, waiting: B.waiting, past: B.past, spaces: B.spaces, answer: B.answer }]; }));
// Providers with more than one client (docs/service-providers.md): the portfolio leads their Home (simulated).
H.cockpit.portfolio = Object.fromEntries(PEOPLE.filter((p) => p.vendor).map((p) => [p.id, portfolio(p.vendor)]).filter(([, P]) => P.cards.length > 1)
  .map(([id, P]) => [id, { clients: P.cards.length, jobs: P.jobs, past: P.past, crews: P.crews.length, answer: P.answer }]));
// Welcome back is shown for Anna (the demo switch in Settings); keep the blob to the people who need it.
H.cockpit.welcome = { anna: H.cockpit.welcome.anna };
const json = JSON.stringify(H).replace(/</g, '\\u003c');
const OPEN_STATES = 'new,in-progress,on-hold';
const TASK_KINDS = 'provision,install,configure,commission,task';

// ---- The pictures: every office's floors at one scale, and the estate as one card per office -------------------
const FIRST = Object.fromEntries(PEOPLE.map((p) => [p.id, p.name.split(' ')[0]]));
const health = Object.fromEntries(Object.entries(SPACE_HEALTH).map(([id, h]) => [id, { h: h.h, why: h.why, who: h.who }]));
const offices = SITE_ORDER.filter((s) => sites[s].kind !== 'remote');
const floorsOf = (s) => building(s)?.floors ?? [];
const floorCards = offices.flatMap((s) => floorsOf(s).map((f) => ({ key: `${s}-${f.id}`, site: s, floor: f.id, title: `${sites[s].name.replace(/ office$/, '')}, ${f.name}`, to: `/locations/${s}/?floor=${f.id}` })));
// One card per office: the floor with the space that most needs a look, else the first floor.
const rank = (id) => (health[id]?.h === 'fault' ? 0 : health[id]?.h === 'review' ? 1 : 2);
const estateCards = offices.map((s) => {
  const fl = floorsOf(s), worst = fl.map((f) => ({ f, r: Math.min(2, ...Object.keys(health).filter((id) => id.startsWith(`${s}-${f.id}-`)).map(rank)) })).sort((a, b) => a.r - b.r)[0];
  const sh = SITE_HEALTH[s];
  const f = worst?.f ?? fl[0];
  return { key: s, site: s, floor: f?.id, title: sites[s].name.replace(/ office$/, ''), to: `/locations/${s}/?floor=${f?.id}`, figure: tally(sh.fault.length, sh.review.length), sub: fl.length > 1 ? `${f.name} of ${fl.length} floors` : undefined };
}).filter((c) => c.floor);

// ---- Static blocks for the record layer (the same for everyone of a role) --------------------------------------------
const openAdv = Object.values(advisories).filter((a) => a.status !== 'closed').sort((a, b) => ADV_ORDER.indexOf(a.level) - ADV_ORDER.indexOf(b.level));
const fwLines = Object.values(firmwareLines).map((f) => ({
  ...f, standard: f.releases.find((r) => r.status === 'standard')?.version ?? null, lab: f.releases.find((r) => r.status === 'lab')?.version ?? null,
  to: `/profiles/${MODELS[f.models[0]]?.class}/${f.models[0]}/#firmware`,
}));
const openInc = ITEMS.filter((it) => it.kind === 'incident');
const review = [
  { id: 'PRO-039', title: 'Video bar device type: add a symptom for the external camera switching back after a reboot', by: 'Anna Byrne', to: 'sofia' },
  { id: 'PRO-035', title: 'New device model: Logitech Rally Bar Mini', by: 'Nora Walsh', to: 'sofia', note: 'Sent back for edits' },
];
const projList = Object.values(projects).filter((p) => p.phase !== 'closed').map((p) => {
  const L = lights(p), G = nextGate(p), open = p.tasks.filter((t) => t.status !== 'done'), blocked = open.filter((t) => t.status === 'blocked');
  const worst = ['bad', 'warn', 'ok', 'off'].find((s) => [L.schedule, L.cost, L.scope].some((l) => l.state === s)) ?? 'ok';
  return { p, L, G, open, blocked, worst };
}).sort((a, b) => ['bad', 'warn', 'ok', 'off'].indexOf(a.worst) - ['bad', 'warn', 'ok', 'off'].indexOf(b.worst) || (a.G?.date ?? '9').localeCompare(b.G?.date ?? '9'));
const gates = projList.filter((x) => x.G && !x.G.signed).sort((a, b) => a.G.date.localeCompare(b.G.date));
const blockedTasks = projList.flatMap((x) => x.blocked.map((t) => ({ t, p: x.p })));
const redProjects = projList.filter((x) => x.worst === 'bad');
const urgent = INBOX_SEED.filter((x) => x.kind === 'urgent' && x.status !== 'done');
const days = (d) => Math.round((new Date(d) - new Date(DEMO_TODAY)) / 864e5);
const short = (d) => fmtDate(d, { day: 'numeric', month: 'short' });
const REGIONS = ['emea', 'amer', 'apac'].map((r) => {
  const ss = SITE_ORDER.filter((s) => sites[s].region === r);
  return { r, label: REGION_LABEL[r].replace('Europe, Middle East and Africa', 'EMEA'), sites: ss.filter((s) => sites[s].kind !== 'remote').length, rooms: ss.reduce((n, s) => n + (siteStats[s]?.spaces.length ?? 0), 0), inc: openInc.filter((i) => sites[i.site]?.region === r).length };
});
const labWaiting = Object.values(labTests).filter((l) => ['passed', 'testing', 'queued'].includes(l.status));
const pms = PEOPLE.filter((p) => p.roleId === 'pm');
// A project manager sees the projects they run; everyone else sees them all.
const pmCss = pms.map((pm) => `:root[data-who="${pm.id}"] [data-pm]:not([data-pm="${pm.id}"]){display:none}`).join('');
// On call (the overlooked items, #6): the line for whoever is viewing, when they are on the rota this week or next.
// Every line is drawn once; the viewer's own shows (View as switches it with the rest of Home).
const OCL = homeLines();
const oclCss = Object.keys(OCL).map((id) => `:root[data-who="${id}"] .ocl-home{display:block}:root[data-who="${id}"] [data-oncall-for="${id}"]{display:grid}`).join('');
---
<Shell title="Home" section="home" vendorOk crumbs={[{ label: 'Home' }]}>
  <PageBand overline="Home" title="Anna, ready for you" answer={H.cockpit ? ' ' : ''} heartbeat>
    <span slot="overline"><span class="faint">{fmtDate(DEMO_TODAY, { weekday: 'long', day: 'numeric', month: 'long' })}</span><span class="faint" aria-hidden="true"> · </span><span class="faint" data-who-where></span></span>
    <a slot="action" class="btn primary" data-home-action href={href('/support/')}>Open Support</a>
    <KeyNumbers slot="numbers" items={[
      { n: 0, label: 'Ready for you', id: 'k0', to: '#ready' },
      { n: 0, label: 'With you', id: 'k1', to: '#with' },
      { n: 0, label: 'Today', id: 'k2', to: '#day' },
      { n: 0, label: 'To review', id: 'k3', to: '#review' },
    ]} />
  </PageBand>

  <div class="content home" data-home aria-busy="true">
    <!-- Welcome back: replaces Home once after time away (design notes). The same card as Hand over for cover. -->
    <section data-sec="welcome" id="welcome" hidden aria-label="Welcome back">
      <HandoverCard variant="welcome" id="wb" overline="While you were away" title="What happened while you were away" meta="" />
    </section>

    <div class="layer" data-layer="summary" id="summary">
      <!-- On call: "You're on call until Monday 08:00", only for the people on the rota. -->
      <section class="ck card ocl-home" data-feature="oncall" data-settle aria-label="On call" data-help="home.oncall">
        {Object.entries(OCL).map(([id, l]) => (
          <div class:list={['ocl-line', `k-${l.kind}`]} data-oncall-for={id}>
            <span class="ocl-ic" aria-hidden="true"><Icon name="schedule" size={16} /></span>
            <p class="ocl-t"><b>{l.lead}</b> <span class="rs-tick">{l.when}</span></p>
            <p class="ocl-s">{l.sub}</p>
            <a class="ocl-a" href={href('/team/#on-call')}>The rota <span aria-hidden="true">→</span></a>
          </div>
        ))}
      </section>
      <!-- Hand over for cover: on the colleague's Home while the person is away (design notes, step 4). -->
      <section data-sec="cover" id="cover" hidden aria-label="Covering">
        <HandoverCard variant="cover" id="cv" overline="Hand over for cover" title="Covering" meta="" />
      </section>

      <!-- Ready for you: offered to you, due now. Empty means nothing new: the section stays out of the way. -->
      <section class="ck card" data-sec="ready" id="ready" aria-labelledby="h-ready" hidden>
        <header class="ck-h"><h2 id="h-ready" data-help="home.ready">Ready for you</h2><span class="ck-n" data-n="ready"></span></header>
        <ol class="jobs" data-list="ready"></ol>
      </section>

      <!-- My day: where you are, the day in order, the current time. -->
      <section class="ck card hp-day" aria-labelledby="h-day" data-help="home.day" data-sec="day" id="day" data-day hidden>
        <header class="ck-h">
          <h2 id="h-day">My day</h2>
          <span class="day-place" data-day-place></span>
          <a class="aside" data-day-full href={href(`/work/schedule/?view=day&d=${DEMO_TODAY}`)}>Full schedule <span aria-hidden="true">→</span></a>
        </header>
        <div class="day-bar" data-day-bar data-chart-bar="each" aria-hidden="true"></div>
        <ol class="day-list" data-day-list></ol>
        <p class="hp-empty" data-day-empty hidden>Nothing booked today. Your open work is below.</p>
      </section>

      <!-- Checks due: the room check rounds for the viewer, while Room checks is on. -->
      <HomeChecks />

      <!-- The service desk's queue: every open incident, worst first, each with its With chip. -->
      <section class="ck card" data-sec="queue" id="queue" aria-labelledby="h-queue" hidden>
        <header class="ck-h"><h2 id="h-queue" data-help="home.queue">The queue</h2><span class="ck-n" data-n="queue"></span><a class="aside" href={href(`/incidents/?state=${OPEN_STATES}`)} data-vt-rec="dd-incidents">See all in Incidents <span aria-hidden="true">→</span></a></header>
        <ol class="jobs" data-list="queue"></ol>
        <GuideLive where="home" />
      </section>

      <!-- Service owners: For your approval (reports sent with Report land here, live). -->
      <section class="ck card" data-sec="approval" id="approval" aria-labelledby="h-inbox" hidden>
        <header class="ck-h" data-help="home.inbox"><h2 id="h-inbox">For your approval</h2><span class="aside faint" data-inbox-summary></span></header>
        <ol class="inbox" data-inbox></ol>
        <div class="hp-sub" data-help="home.review">
          <h3>Proposals waiting for your review</h3>
          {review.map((c) => (
            <a class="mini-row" href={href(`/changes/#${c.id.toLowerCase()}`)} data-to={c.to}>
              <span class="mono faint">{c.id}</span><span>{c.title}<small>{c.by}{c.note ? ` · ${c.note}` : ''}</small></span><span class="mr-arrow" aria-hidden="true">→</span>
            </a>
          ))}
          <a class="hp-more" href={href('/changes/')}>Every proposal and who approved it <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <!-- People managers: the team today. -->
      <section class="ck card" data-sec="team" id="team" aria-labelledby="h-team" hidden>
        <header class="ck-h" data-help="home.team"><h2 id="h-team">Your team today</h2><a class="aside" href={href('/work/schedule/?view=day&scope=team')}>Team schedule <span aria-hidden="true">→</span></a></header>
        <div class="team-rows" data-team></div>
      </section>

      <!-- Projects by status: the programme as a list, worst first. -->
      <section class="ck card" data-sec="projects" id="projects" aria-labelledby="h-proj" hidden>
        <header class="ck-h" data-help="home.projects"><h2 id="h-proj">Projects by status</h2><a class="aside" data-projects-all href={href('/projects/')}>All projects <span aria-hidden="true">→</span></a></header>
        <div class="proj-mini">
          {projList.map(({ p, L, G, open, blocked, worst }) => (
            <a class="pm-row" href={href(`/projects/${p.id.toLowerCase()}/`)} data-pm={p.owner} data-help="home.project-row" data-vt-rec={p.id}>
              <span class="pm-lights" aria-label={`Schedule ${L.schedule.word}, cost ${L.cost.word}, scope ${L.scope.word}`}>{[L.schedule, L.cost, L.scope].map((l) => <HealthGlyph state={l.state} size={12} />)}</span>
              <span class="pm-name"><b>{p.name}</b><small>{p.id} · {sites[p.site]?.name} · {PHASE_LABEL[p.phase]}{G ? ` · gate ${short(G.date)}` : ''}</small></span>
              <span class="pm-word">{worst === 'bad' ? [L.schedule, L.cost, L.scope].find((l) => l.state === 'bad').word : worst === 'warn' ? [L.schedule, L.cost, L.scope].find((l) => l.state === 'warn').word : 'On plan'}</span>
              <span class="pm-n">{blocked.length ? `${blocked.length} waiting` : `${open.length} open`}</span>
            </a>
          ))}
        </div>
      </section>

      <!-- With you | To review: one row, the two lists every role has. -->
      <div class="g12 ck-row" data-sec="work">
        <section class="ck card s-7" id="with" aria-labelledby="h-with">
          <header class="ck-h"><h2 id="h-with" data-help="home.with">With you</h2><span class="ck-n" data-n="with"></span></header>
          <ol class="jobs" data-list="with"></ol>
          <div class="ck-empty" data-empty="with" hidden><p>Nothing with you. Take something from Ready for you, or pick up work in the Work list.</p><a class="btn ghost small" href={href('/work/list/')}>Open the Work list</a></div>
        </section>
        <section class="ck card s-5" id="review" aria-labelledby="h-review">
          <header class="ck-h"><h2 id="h-review" data-help="home.to-review">To review</h2><span class="ck-n" data-n="review"></span></header>
          <ol class="rv" data-list="review"></ol>
          <div class="ck-empty" data-empty="review" hidden><p>Nothing to review. Things someone should look at, where nothing is down, show here.</p></div>
        </section>
      </div>

      <!-- Your office's floors, every space a quiet ring unless it is not fine. -->
      <section class="ck card" data-sec="floors" id="floors" aria-labelledby="h-floors" hidden>
        <header class="ck-h"><h2 id="h-floors" data-help="home.floors"><span data-floors-name>Your office</span>, every space</h2><span class="ck-say" data-floors-say></span><a class="aside" data-floors-link href={href('/locations/')}>Open the office <span aria-hidden="true">→</span></a></header>
        <SmallMultiples cards={floorCards} health={health} people={FIRST} min={300} label="Your office's floors" />
      </section>

      <!-- The estate: one card per office, the same tiny plan at the same scale (design notes). -->
      <section class="ck card" data-sec="estate" id="estate" aria-labelledby="h-estate" hidden>
        <header class="ck-h"><h2 id="h-estate" data-help="home.estate">The estate</h2><span class="ck-say" data-estate-say></span><a class="aside" href={href('/locations/')}>Locations <span aria-hidden="true">→</span></a></header>
        <SmallMultiples cards={estateCards} health={health} people={FIRST} min={200} label="Every office, one card each" />
      </section>

      <!-- Leadership: what it costs, and what is to review (V7). Partners: the jobs with their company (V7). -->
      <LeadershipHome part="summary" L={LEAD} />
      <PortfolioHome />
      <PartnerHome />

      <!-- Vendors: only their installation. -->
      <section class="ck card" data-sec="install" id="install" aria-labelledby="h-vend" hidden>
        <header class="ck-h" data-help="home.vendor"><h2 id="h-vend">Your installation</h2></header>
        <p class="ck-p">Your spaces, the tasks assigned to your company, and the records Aigna needs from you: serial numbers, MAC addresses and photos.</p>
        <a class="btn ghost small" href={href('/vendor/')}>Open your installation <Icon name="arrow" size={14} /></a>
      </section>
    </div>

    <OpenHere kind="home" layer="record" />

    <div class="layer" data-layer="record" id="record-layer">
      <LeadershipHome part="record" L={LEAD} />
      <!-- Quiet by design: what was done for you, and what moved while you were not looking. Folded; one press opens. -->
      <section class="ck card quiet" data-sec="quiet" id="quiet" aria-label="Done automatically, changed overnight, knowledge to review">
        <details class="qd" data-q="auto"><summary data-help="home.auto"><span class="qd-t">Done automatically today</span><span class="qd-n" data-qn="auto"></span><Icon name="arrow" size={14} /></summary><ol class="qd-list" data-ql="auto"></ol></details>
        <details class="qd" data-q="changed"><summary data-help="home.changed"><span class="qd-t">What changed overnight</span><span class="qd-n" data-qn="changed"></span><Icon name="arrow" size={14} /></summary><ol class="qd-list" data-ql="changed"></ol></details>
        <details class="qd" data-q="knowledge"><summary data-help="home.knowledge"><span class="qd-t">Knowledge to review</span><span class="qd-n" data-qn="knowledge"></span><Icon name="arrow" size={14} /></summary><ol class="qd-list" data-ql="knowledge"></ol></details>
      </section>

      <!-- The task list: Today, This week, Later; one tap ticks a task through the live layer. -->
      <Section title="Your tasks" help="home.tasks" id="h-tasks-sec" class="ck card hp-tasks" data-sec="tasks">
        <span slot="aside" class="faint" data-task-summary></span>
        <div class="tasks-home" data-tasks>
          {['today', 'week', 'later', 'done'].map((g) => (
            <div class="tg" data-group={g} hidden>
              <h3 class="tg-h" data-help="home.tasks-group"><span>{{ today: 'Today', week: 'This week', later: 'Later', done: 'Done today' }[g]}</span><small data-n></small></h3>
              <ol class="tg-list" data-rows></ol>
            </div>
          ))}
        </div>
        <p class="hp-empty" hidden data-task-empty>Nothing assigned to you right now.</p>
        <a class="hp-more" data-tasks-all data-vt-rec="dd-work-list" href={href(`/work/list/?kind=${TASK_KINDS}`)}>See all in the Work list <span aria-hidden="true">→</span></a>
        <div class="tick-toast" data-toast hidden role="status"></div>
      </Section>

      <!-- Engineers: the next device, into its Deploy batch; provisioning waiting. -->
      <section class="ck card" data-sec="device" aria-labelledby="h-device" hidden>
        <header class="ck-h" data-help="home.device"><h2 id="h-device">Next device</h2></header>
        <div data-device></div>
      </section>
      <section class="ck card" data-sec="provision" aria-labelledby="h-prov" hidden>
        <header class="ck-h" data-help="home.provision"><h2 id="h-prov">Provisioning waiting</h2></header>
        <div class="mini-list" data-provision></div>
        <a class="hp-more" data-provision-all data-vt-rec="dd-work-list" href={href('/work/list/?kind=provision')}>See all in the Work list <span aria-hidden="true">→</span></a>
      </section>
      <section class="ck card" data-sec="vnext" aria-labelledby="h-vnext" hidden>
        <header class="ck-h" data-help="home.device"><h2 id="h-vnext">Next device</h2></header>
        <div data-device-vendor></div>
      </section>

      <!-- Service owners: firmware and advisories. -->
      <section class="ck card" data-sec="firmware" aria-labelledby="h-fw" hidden>
        <header class="ck-h" data-help="home.firmware"><h2 id="h-fw">Firmware and advisories</h2><a class="aside" href={href('/known-issues/')}>Known errors <span aria-hidden="true">→</span></a></header>
        <div class="g12 fw-grid">
          <div class="s-5 fw-lines">
            <h3 class="overline">Firmware standard</h3>
            {fwLines.map((f) => (
              <a class="mini-row" href={href(f.to)}><span class="mono faint">{f.standard ?? '?'}</span><span>{f.name}<small>{f.standard ? `${f.standard} is the standard` : 'No standard set'}{f.lab ? ` · ${f.lab} in the Lab` : ''} · {f.models.length} models</small></span><span class="mr-arrow" aria-hidden="true">→</span></a>
            ))}
          </div>
          <div class="s-7 fw-adv">
            <h3 class="overline">Advisories</h3>
            {openAdv.map((a) => (
              <a class="mini-row" href={href(`/profiles/${MODELS[a.models[0]].class}/${a.models[0]}/`)}><HealthGlyph state={a.level === 'do-not-install' || a.level === 'act' ? 'fault' : 'review'} size={12} /><span>{a.title}<small>{ADV_LEVEL[a.level]} · {a.models.map(modelName).join(', ')}</small></span><span class="mr-arrow" aria-hidden="true">→</span></a>
            ))}
          </div>
        </div>
      </section>

      <!-- The Lab: the innovation engineer and the AV service owner. -->
      <section class="ck card" data-sec="lab" aria-labelledby="h-lab" hidden>
        <header class="ck-h" data-help="home.lab"><h2 id="h-lab">In the Lab</h2><a class="aside" href={href('/lab/')}>The Lab <span aria-hidden="true">→</span></a></header>
        <div class="mini-list">
          {labWaiting.map((l) => (
            <a class="mini-row" href={href(`/lab/#${l.id.toLowerCase()}`)}><span class="mono faint">{l.id}</span><span>{l.title}<small>{LAB_STATUS[l.status]}{l.status === 'passed' ? ': waiting for the service owner' : ''}</small></span><span class="mr-arrow" aria-hidden="true">→</span></a>
          ))}
        </div>
      </section>

      <!-- Project managers: gates due, and everything waiting on something. -->
      <section class="ck card" data-sec="gates" aria-labelledby="h-gates" hidden>
        <header class="ck-h" data-help="home.gates"><h2 id="h-gates">Gates due</h2></header>
        <div class="mini-list">
          {gates.map(({ p, G }) => (
            <a class="mini-row" href={href(`/projects/${p.id.toLowerCase()}/`)} data-pm={p.owner}>
              <span class={`gate-d${G.late ? ' late' : days(G.date) <= 14 ? ' soon' : ''}`}>{short(G.date)}</span>
              <span>{G.phase} gate, {p.name}<small>{G.late ? `${G.slip} days over · ` : ''}{G.signer} signs</small></span><span class="mr-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>
      <section class="ck card" data-sec="blocked" id="blocked" aria-labelledby="h-blocked" hidden>
        <header class="ck-h" data-help="home.blocked"><h2 id="h-blocked">Waiting on, your projects</h2></header>
        <div class="mini-list">
          {blockedTasks.map(({ t, p }) => (
            <a class="mini-row" href={href(`/projects/${p.id.toLowerCase()}/tasks/${t.id.toLowerCase()}/`)} data-pm={p.owner}><HealthGlyph state="review" size={12} /><span>{t.title}<small>{p.name} · {person(t.owner).name} · {t.blocked_by}</small></span><span class="mr-arrow" aria-hidden="true">→</span></a>
          ))}
        </div>
      </section>

      <!-- Leadership: what is stuck, and the regions. -->
      <section class="ck card" data-sec="stuck" aria-labelledby="h-stuck" hidden>
        <header class="ck-h" data-help="home.stuck"><h2 id="h-stuck">What is stuck</h2></header>
        <div class="mini-list">
          {urgent.map((x) => (
            <a class="mini-row" href={href(x.about.to)}><HealthGlyph state="fault" size={12} /><span>{x.about.label}<small>Urgent · {person(x.by).name} to {person(x.to).name} · {x.fields.happened?.slice(0, 90)}…</small></span><span class="mr-arrow" aria-hidden="true">→</span></a>
          ))}
          {redProjects.map(({ p, L }) => (
            <a class="mini-row" href={href(`/projects/${p.id.toLowerCase()}/`)}><HealthGlyph state="fault" size={12} /><span>{p.name}<small>{[L.schedule, L.cost, L.scope].filter((l) => l.state === 'bad').map((l) => l.why).join(' ')}</small></span><span class="mr-arrow" aria-hidden="true">→</span></a>
          ))}
          {blockedTasks.slice(0, 5).map(({ t, p }) => (
            <a class="mini-row" href={href(`/projects/${p.id.toLowerCase()}/tasks/${t.id.toLowerCase()}/`)}><HealthGlyph state="review" size={12} /><span>{t.title}<small>Waiting on · {p.name} · {person(t.owner).name} · {t.blocked_by}</small></span><span class="mr-arrow" aria-hidden="true">→</span></a>
          ))}
        </div>
        <a class="hp-more" data-vt-rec="dd-work-list" href={href(`/work/list/?kind=${TASK_KINDS}&status=blocked`)}>See all {blockedTasks.length} waiting on something in the Work list <span aria-hidden="true">→</span></a>
      </section>
      <section class="ck card" data-sec="regions" aria-labelledby="h-reg" hidden>
        <header class="ck-h" data-help="home.regions"><h2 id="h-reg">The regions</h2></header>
        <table class="reg-t">
          <thead><tr><th>Region</th><th>Offices</th><th>Spaces</th><th>Incidents</th></tr></thead>
          <tbody>
            {REGIONS.map((x) => (
              <tr><th scope="row">{x.label}</th><td><a href={href(`/locations/?region=${x.r}`)}>{x.sites}</a></td><td><a href={href(`/rooms/?region=${x.r}`)} data-vt-rec="dd-rooms">{x.rooms}</a></td><td><a href={href(`/incidents/?region=${x.r}&state=${OPEN_STATES}`)} data-vt-rec="dd-incidents">{x.inc}</a></td></tr>
            ))}
          </tbody>
        </table>
      </section>

      <details class="home-more card" data-sec="across" hidden>
        <summary data-help="home.across"><span><b>Across Aigna</b><small>{totals.offices} offices · {totals.spaces} spaces · {totals.units.toLocaleString('en-IE')} devices</small></span><Icon name="arrow" size={16} /></summary>
        <div class="site-tiles">
          {SITE_ORDER.map((sid) => {
            const s = sites[sid], st = siteStats[sid];
            return (
              <a class="site-tile" href={href(`/rooms/?site=${sid}`)}>
                <span class="code">{s.code}</span>
                <b>{s.name}</b>
                <small>{s.kind === 'remote' ? `Home offices, ${({ amer: 'Americas', emea: 'EMEA', apac: 'APAC' })[s.region] ?? 'worldwide'}` : `${s.city}, ${countryName(s.country)}`}</small>
                <StageBar stages={st.stages} />
              </a>
            );
          })}
        </div>
      </details>

      <!-- First visit: a short tour for your role (Learn). Dismissed or finished, it stays away. -->
      <aside class="tour card" data-help="home.tour" data-tour hidden aria-labelledby="h-tour">
        <span class="tour-ic" aria-hidden="true"><Icon name="book" size={20} /></span>
        <span class="tour-t"><b id="h-tour" data-tour-h>New here? Start the 5 minute tour</b><small data-tour-s>A few short lessons picked for your role, each with something to try.</small></span>
        <a class="btn primary small" href={href('/learn/#start')} data-tour-go>Start the tour <Icon name="arrow" size={14} /></a>
        <button type="button" class="icon-btn tour-x" data-tour-x aria-label="Dismiss the tour" title="Not now"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg></button>
      </aside>
    </div>
    <LiveBar page="home" />
  </div>

  <script is:inline data-astro-rerun set:html={`window.RS_HOME = ${json};`} slot="end"></script>
  <script is:inline data-astro-rerun define:vars={{ PATHS }} slot="end">
    (function () {
      /* The tour card: shown until dismissed or the path is done; folds away on the tokens. */
      var el = document.querySelector('[data-tour]'); if (!el) return;
      var get = function (k) { try { return localStorage.getItem(k); } catch (_) { return null; } };
      if (get('rs4-tour') === 'dismissed') return;
      var st = {}; try { st = JSON.parse(get('rs4-learn') || '{}') || {}; } catch (_) {}
      var role = st.role || (window.RS_WHO_ROLE || {})[window.rsWhoId ? window.rsWhoId() : 'anna'] || 'delivery';
      var path = PATHS[role] || [], done = st.done || {};
      var n = path.filter(function (id) { return done[id]; }).length;
      if (path.length && n === path.length) return;
      if (n > 0) {
        el.querySelector('[data-tour-h]').textContent = 'Pick up the tour where you left off';
        el.querySelector('[data-tour-s]').textContent = n + ' of ' + path.length + ' lessons done on your path.';
        el.querySelector('[data-tour-go]').firstChild.textContent = 'Resume ';
      }
      el.hidden = false;
      el.querySelector('[data-tour-x]').addEventListener('click', function () {
        try { localStorage.setItem('rs4-tour', 'dismissed'); } catch (_) {}
        var M = window.rsMotion ? window.rsMotion() : { reduced: true, page: 420, ease: 'ease' };
        if (M.reduced) { el.hidden = true; return; }
        var h = el.getBoundingClientRect().height, gap = parseFloat(getComputedStyle(el.parentElement).rowGap) || 0;
        el.style.overflow = 'hidden';
        el.animate([{ height: h + 'px', opacity: 1, marginBottom: '0px' }, { height: '0px', opacity: 0, marginBottom: -gap + 'px', paddingTop: '0px', paddingBottom: '0px', borderWidth: '0px' }], { duration: M.page, easing: M.ease, fill: 'forwards' })
          .onfinish = function () { el.hidden = true; };
      });
    })();
  </script>
  <script is:inline data-astro-rerun define:vars={{ INBOX_SEED, PEOPLE }} slot="end">
    (function () {
      /* For your approval: what was waiting when the demo started plus reports sent from any page (rs4-inbox). */
      var root = document.querySelector('[data-inbox]'); if (!root) return;
      var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
      var base = (document.querySelector('link[rel=icon]').getAttribute('href') || '/').replace(/favicon\.svg$/, '');
      var KIND = { urgent: 'Urgent issue', firmware: 'New firmware found', change: 'Proposal' };
      var ORDER = { urgent: 0, firmware: 1, change: 2 };
      var ago = function (iso) { var m = Math.round((Date.now() - new Date(iso).getTime()) / 60000); if (m < 1) return 'just now'; if (m < 60) return m + ' min ago'; var h = Math.round(m / 60); if (h < 24) return h + ' h ago'; var d = new Date(iso); return d.getDate() + ' ' + ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][d.getMonth()]; };
      function render() {
        var who = window.rsWhoId ? window.rsWhoId() : 'anna', all = who === 'everyone';
        var local = []; try { local = JSON.parse(localStorage.getItem('rs4-inbox') || '[]'); } catch (_) {}
        var everything = local.concat(INBOX_SEED);
        var mine = everything.filter(function (x) { return all || x.to === who; }).sort(function (a, b) { return ORDER[a.kind] - ORDER[b.kind] || b.at.localeCompare(a.at); });
        var waiting = mine.filter(function (x) { return x.status !== 'done'; }).length;
        if (window.rsKeyNumber && !all) { var li = document.querySelector('.kn-i[data-kn="k0"]'); if (li && li.dataset.knId === 'approval') window.rsKeyNumber('k0', waiting, { tone: waiting ? 'warn' : '' }); }
        document.querySelector('[data-inbox-summary]').textContent = mine.length ? mine.filter(function (x) { return x.kind === 'urgent'; }).length + ' urgent · ' + mine.length + ' in all' : '';
        root.innerHTML = mine.length ? mine.map(function (x, i) {
          var by = PEOPLE.find(function (p) { return p.id === x.by; }) || { name: x.by };
          var f = x.fields || {};
          var text = f.happened || f.why || f.notes || f.what || '';
          var head = x.kind === 'firmware' ? (f.model || x.about.label) + ' on ' + (f.version || 'a new version') : x.kind === 'change' ? (f.what || 'Edit to ' + x.about.label) : (x.about.label);
          return '<li class="ib ib-' + x.kind + (local.some(function (l) { return l.id === x.id; }) ? ' ib-new' : '') + '" data-help="home.inbox-item" style="--i:' + i + '">' +
            '<span class="ib-dot" aria-hidden="true"></span>' +
            '<div class="ib-body"><p class="ib-top"><span class="ib-kind">' + KIND[x.kind] + '</span><span class="faint">' + esc(by.name) + (all ? ' to ' + esc((PEOPLE.find(function (p) { return p.id === x.to; }) || { name: x.to }).name) : '') + ' · ' + ago(x.at) + '</span></p>' +
            '<b>' + esc(head) + '</b><p>' + esc(text) + '</p>' +
            (x.about && x.about.to ? '<a class="ib-link" href="' + base + x.about.to.replace(/^\//, '') + '">' + esc(x.about.label) + ' →</a>' : '') + '</div>' +
            '<div class="ib-act"><button type="button" class="btn small" data-done="' + x.id + '">' + (x.kind === 'urgent' ? 'Take it' : 'Review') + '</button></div></li>';
        }).join('') : '<li class="hp-empty">Nothing waiting. Reports people send from any page land here.</li>';
        document.querySelectorAll('.mini-row[data-to]').forEach(function (a) { a.hidden = !all && a.dataset.to !== who; });
      }
      root.addEventListener('click', function (e) {
        var b = e.target.closest('[data-done]'); if (!b) return;
        var li = b.closest('li'); b.textContent = b.textContent === 'Take it' ? 'Yours: assigned to you' : 'Opened'; b.disabled = true; li.classList.add('ib-taken');
      });
      render();
      window.__rsInboxRender = render;
      if (!window.__rsInboxHook) {
        window.__rsInboxHook = true;
        document.addEventListener('rs:inbox', function () { if (document.querySelector('[data-inbox]') && window.__rsInboxRender) window.__rsInboxRender(); });
      }
    })();
  </script>
  <script>
    import { start } from '../lib/home-client.mjs';
    document.addEventListener('astro:page-load', start);
  </script>
</Shell>
<style is:global set:html={pmCss + oclCss}></style>
<Arrive />
