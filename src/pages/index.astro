<style is:global>
  /* Global, nested under .content.home: most of Home is drawn in the browser, so scoped styles would miss it. */
  @keyframes rs-ib-in { from { opacity: 0; transform: translateX(-10px); } }
  @keyframes rs-pulse { 50% { box-shadow: 0 0 0 6px color-mix(in srgb, var(--red) 25%, transparent); } }
  @keyframes rs-th-in { from { opacity: 0; transform: translateY(8px); } }
  :root[data-who="everyone"] .home .hp-who { display: block; margin: -4px 0 8px; font: 700 var(--overline-size, 11px)/1.2 var(--font-sans); letter-spacing: var(--overline-track, .1em); text-transform: var(--overline-case, uppercase); color: var(--accent-ink); }
  :root[data-who="everyone"] .home .tour { display: none; }
  /* The line under the title: who you are; after View as, for a few seconds, what this role does. */
  .hp-lede { display: grid; }
  .hp-lede > span { grid-area: 1 / 1; transition: opacity var(--dur-state) var(--ease-settle), transform var(--dur-state) var(--ease-settle); }
  .hp-caption { opacity: 0; transform: translateY(6px); color: var(--accent-ink); font-weight: 600; pointer-events: none; }
  :root.hp-captioned .hp-caption { opacity: 1; transform: none; }
  :root.hp-captioned .hp-lede-who { opacity: 0; transform: translateY(-6px); }
  @media (prefers-reduced-motion: reduce) { .hp-lede > span { transition: none; } }
  .content.home {
  gap: 20px;
  .hp-row { align-items: stretch; }
  .hp { display: none; padding: 18px 20px; min-width: 0; }
  .hp-who, .hp-everyone-only { display: none; }
  .hp-h { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 12px; margin-bottom: 12px; }
  .hp-h h2 { display: flex; align-items: center; gap: 10px; font-size: 19px; margin: 0; }
  .hp-h h2 svg { color: var(--text-3); }
  .hp-h .aside { margin-left: auto; font-size: 13.5px; white-space: nowrap; }
  .hp-sub { margin-top: 16px; padding-top: 14px; border-top: var(--border-rule); }
  .hp-sub h3, .fw-grid h3 { font: 700 var(--overline-size, 11px)/1.2 var(--font-sans); letter-spacing: var(--overline-track, .1em); text-transform: uppercase; color: var(--text-3); margin: 0 0 6px; }
  .hp-more { display: inline-flex; gap: 6px; align-items: center; margin-top: 10px; font-size: 13.5px; }
  .hp-empty { color: var(--text-2); font-size: 14px; list-style: none; padding: 8px 0; margin: 0; }

  /* The line under the title: who you are; after View as, for a few seconds, what this role does. */

  /* My day */
  .hp-day { padding: 18px 20px; }
  .hp-day[hidden] { display: none; }
  .day-place { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; }
  .day-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--text-3); flex: none; }
  .day-dot.office { background: var(--green, #2f7a4f); } .day-dot.home { background: var(--accent); } .day-dot.visiting { background: var(--amber, #d8a200); } .day-dot.away { background: var(--red); }
  .day-bar { position: relative; height: 58px; margin: 6px 0 12px; }
  .day-bar[hidden] { display: none; }
  .day-tick { position: absolute; top: 0; bottom: 0; font: 500 11px/1 var(--font-mono); color: var(--text-3); transform: translateX(-50%); display: grid; align-content: end; justify-items: center; gap: 4px; }
  .day-tick i { display: block; width: 1px; height: 30px; background: var(--line); }
  .day-blk { position: absolute; top: 6px; height: 26px; border-radius: 6px; background: var(--accent-soft); color: var(--accent-ink); font-size: 12px; font-weight: 600; padding: 0 8px; display: flex; align-items: center; overflow: hidden; white-space: nowrap; text-decoration: none; box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 45%, transparent); animation: rs-grow var(--dur-enter) var(--ease-settle) both; animation-delay: calc(var(--delay-enter) + var(--i, 0) * var(--stagger)); transform-origin: left center; }
  .day-blk span { overflow: hidden; text-overflow: ellipsis; }
  .day-blk.k-incident { background: var(--red-soft); color: var(--red-ink); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--red) 45%, transparent); }
  .day-blk.k-lab { background: var(--violet-soft); color: var(--violet-ink); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--violet-ink) 35%, transparent); }
  .day-blk.k-visit { background: var(--amber-soft); color: var(--amber-ink); top: 34px; height: 8px; padding: 0; font-size: 0; box-shadow: none; }
  .day-blk.blocked { background: var(--surface-3); color: var(--text-2); box-shadow: inset 0 0 0 1px var(--line-strong); }
  .day-now { position: absolute; top: 0; bottom: 14px; transform: translateX(-50%); display: grid; justify-items: center; gap: 2px; z-index: 2; pointer-events: none; }
  .day-now i { display: block; width: 2px; flex: 1; height: 100%; background: var(--red); border-radius: 1px; }
  .day-now b { font: 700 10px/1 var(--font-sans); color: var(--red-ink); background: var(--surface); padding: 2px 4px; border-radius: 4px; }
  .day-list { list-style: none; margin: 0; padding: 0; }
  .day-i a { display: grid; grid-template-columns: 64px 8px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 9px 4px; border-top: var(--border-rule); color: inherit; text-decoration: none; transition: background var(--dur-hover); }
  .day-i:first-child a { border-top: 0; }
  .day-i a:hover { background: var(--surface-2); }
  .day-t b { display: block; font: 600 13px/1.2 var(--font-mono); } .day-t small { color: var(--text-3); font-size: 11.5px; }
  .day-k { width: 8px; height: 28px; border-radius: 4px; background: var(--accent); }
  .day-k.k-incident { background: var(--red); } .day-k.k-lab { background: var(--violet-ink); } .day-k.k-visit { background: var(--amber, #d8a200); }
  .day-b b { display: block; font-size: 14.5px; } .day-b small { display: block; color: var(--text-2); font-size: 12.5px; }
  .day-arrow { color: var(--text-3); }

  /* Next up and Next device: the picture, then the words. */
  .next { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 16px; align-items: center; color: inherit; text-decoration: none; padding: 6px; border-radius: var(--radius); transition: background var(--dur-hover); }
  .next:hover { background: var(--surface-2); }
  .next-plan { display: block; padding: 6px; border-radius: var(--radius); background: var(--surface-2); }
  .next-plan.next-none { aspect-ratio: 3 / 2; }
  .next-k { display: block; font: 700 var(--overline-size, 11px)/1.2 var(--font-sans); letter-spacing: var(--overline-track, .1em); text-transform: uppercase; color: var(--text-3); margin-bottom: 4px; }
  .next-b b { display: block; font-size: 18px; line-height: 1.25; } .next-b small { display: block; color: var(--text-2); font-size: 13px; margin-top: 4px; }
  .next-go { display: inline-block; margin-top: 8px; font-size: 13.5px; font-weight: 600; color: var(--accent-ink); }

  .mini-list { display: grid; }
  .mini-row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 9px 4px; border-top: var(--border-rule); color: inherit; text-decoration: none; font-size: 14px; }
  .mini-row:first-of-type { border-top: 0; }
  .mini-row small { display: block; color: var(--text-2); font-size: 12.5px; }
  .mini-row:hover { background: var(--surface-2); }
  .mini-row[hidden] { display: none; }
  .mr-arrow { color: var(--text-3); }
  .prio { font: 700 11px/1 var(--font-mono); padding: 4px 6px; border-radius: 5px; background: var(--surface-3); }
  .prio.p1, .prio.p2 { background: var(--red-soft); color: var(--red-ink); }
  .gate-d { font: 600 13px/1.2 var(--font-mono); white-space: nowrap; }
  .gate-d.soon { color: var(--amber-ink, #8a6100); } .gate-d.late { color: var(--red-ink); }

  .tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .tiles[hidden] { display: none; }
  .tile { display: grid; gap: 2px; padding: 12px; border-radius: var(--radius); background: var(--surface-2); color: inherit; text-decoration: none; transition: background var(--dur-hover); }
  .tile:hover { background: var(--surface-3); }
  .tile b { font-size: 24px; line-height: 1.1; } .tile span { font-size: 12.5px; color: var(--text-2); }
  .tile.t-warn b { color: var(--amber-ink, #8a6100); }

  .inbox { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .inbox .ib { display: grid; grid-template-columns: 12px minmax(0, 1fr) auto; gap: 12px; align-items: start; padding: 12px 14px; border-radius: var(--radius); background: var(--surface-2); animation: rs-ib-in var(--dur-enter, 440ms) var(--ease-settle) both; animation-delay: calc(var(--i, 0) * var(--stagger)); transition: opacity var(--dur-state), background var(--dur-state); }
  .inbox .ib-urgent { background: color-mix(in srgb, var(--red-soft) 55%, var(--surface)); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--red) 45%, transparent); }
  .inbox .ib-dot { width: 10px; height: 10px; border-radius: 50%; margin-top: 6px; background: var(--text-3); }
  .inbox .ib-urgent .ib-dot { background: var(--red); animation: rs-pulse var(--dur-pulse) var(--ease-settle) 2; }
  .inbox .ib-firmware .ib-dot { background: var(--amber, #d8a200); }
  .inbox .ib-change .ib-dot { background: var(--accent); }
  .inbox .ib-top { display: flex; gap: 8px; flex-wrap: wrap; margin: 0 0 2px; font-size: 12.5px; }
  .inbox .ib-kind { font-weight: 700; text-transform: uppercase; letter-spacing: .06em; font-size: 11px; }
  .inbox .ib-urgent .ib-kind { color: var(--red-ink); }
  .inbox .ib-body b { display: block; font-size: 15px; }
  .inbox .ib-body p:not(.ib-top) { margin: 2px 0 4px; font-size: 13.5px; color: var(--text-2); }
  .inbox .ib-link { font-size: 13px; }
  .inbox .ib-taken { opacity: .6; }
  .inbox .ib-new { box-shadow: inset 0 0 0 1px var(--accent); }

  /* The task list */
  .tasks-home { display: grid; gap: 6px; }
  .tg[hidden] { display: none; }
  .tg-h { display: flex; align-items: baseline; gap: 8px; margin: 10px 0 2px; font: 700 var(--overline-size, 11px)/1.2 var(--font-sans); letter-spacing: var(--overline-track, .1em); text-transform: uppercase; color: var(--text-3); }
  .tg-h small { font: 600 12px/1 var(--font-mono); color: var(--text-3); }
  .tg:first-child .tg-h { margin-top: 0; }
  .tg-list { list-style: none; margin: 0; padding: 0; }
  .th { display: grid; grid-template-columns: 24px minmax(0, 1fr) auto auto; gap: 12px; align-items: center; padding: 8px 6px; border-top: var(--border-rule); border-radius: 8px; transition: background var(--dur-state) var(--ease-settle); }
  .stagger .th { animation: rs-th-in var(--dur-enter) var(--ease-settle) both; animation-delay: calc(var(--delay-enter) + min(var(--i, 0), 12) * var(--stagger)); }
  .th:first-child { border-top: 0; }
  .th:hover { background: var(--surface-2); }
  .th.st-done { background: color-mix(in srgb, var(--green-soft) 70%, var(--surface)); }
  .th.st-done .th-main b { text-decoration: line-through; color: var(--text-2); }
  .th-none { grid-template-columns: 1fr; color: var(--text-2); font-size: 14px; }
  .th-main { display: block; min-width: 0; color: inherit; text-decoration: none; }
  .th-main b { display: block; font-size: 14.5px; }
  .th-main small { display: block; font-size: 12.5px; color: var(--text-2); }
  .th-due { font-size: 13px; color: var(--text-2); white-space: nowrap; }
  .th-due.soon { color: var(--amber-ink, #8a6100); font-weight: 700; }
  .th-due.late { color: var(--red-ink); font-weight: 700; }
  .st-done .th-due { color: var(--text-3); font-weight: 400; }
  .tbox { width: 22px; height: 22px; border-radius: 6px; border: 2px solid var(--line-strong); background: var(--surface); color: transparent; display: grid; place-items: center; padding: 0; cursor: pointer; transition: background var(--dur-state) var(--ease-settle), border-color var(--dur-state), color var(--dur-state); }
  .tbox:hover { border-color: var(--green, #2f7a4f); }
  .tbox[aria-pressed="true"] { background: var(--green, #2f7a4f); border-color: var(--green, #2f7a4f); color: #fff; }
  .tbox svg { transition: transform var(--dur-state) var(--ease-settle); transform: scale(.4); }
  .tbox[aria-pressed="true"] svg { transform: none; }
  .st-doing .tbox { border-color: var(--accent); background: linear-gradient(90deg, var(--accent) 50%, var(--surface) 50%); }
  .st-doing .tbox[aria-pressed="true"] { background: var(--green, #2f7a4f); }
  .st-blocked .tbox { border-color: var(--red); background: var(--red-soft); }
  .tbox.k { border: 0; background: var(--surface-3); color: var(--text-2); font: 700 10px/1 var(--font-mono); cursor: default; width: 26px; }
  .k-incident .tbox.k { background: var(--red-soft); color: var(--red-ink); }
  .pill.st-blocked { background: var(--red-soft); color: var(--red-ink); }
  .tick-toast { position: sticky; bottom: 12px; margin-top: 10px; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 8px 8px 14px; border-radius: var(--radius); background: var(--ink); color: var(--surface); font-size: 13.5px; opacity: 0; transform: translateY(6px); transition: opacity var(--dur-state) var(--ease-settle), transform var(--dur-state) var(--ease-settle); z-index: 3; }
  .tick-toast.on { opacity: 1; transform: none; }
  .tick-toast[hidden] { display: none; }
  .tick-toast .btn { color: inherit; border-color: color-mix(in srgb, var(--surface) 40%, transparent); }
  .hp-tasks .livebar { margin-top: 12px; }

  .proj-mini { display: grid; }
  .pm-row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; gap: 12px; align-items: center; padding: 9px 4px; border-top: var(--border-rule); color: inherit; text-decoration: none; }
  .pm-row:first-child { border-top: 0; }
  .pm-row:hover { background: var(--surface-2); }
  .pm-row[hidden] { display: none; }
  .pm-lights { display: inline-flex; gap: 4px; }
  .pm-lights .hl { width: 10px; height: 10px; }
  .pm-name b { display: block; font-size: 14.5px; } .pm-name small { color: var(--text-2); font-size: 12.5px; }
  .pm-word { font-size: 13px; font-weight: 600; white-space: nowrap; color: var(--text-2); }

  .reg-t { width: 100%; border-collapse: collapse; font-size: 14px; }
  .reg-t th, .reg-t td { text-align: left; padding: 8px 4px; border-top: var(--border-rule); }
  .reg-t thead th { border-top: 0; font: 700 var(--overline-size, 11px)/1.2 var(--font-sans); letter-spacing: var(--overline-track, .1em); text-transform: uppercase; color: var(--text-3); }
  .reg-t td a { font-weight: 600; }
  .team-rows { display: grid; }
  .team-row { display: grid; grid-template-columns: 32px minmax(0, 1fr) auto auto; gap: 12px; align-items: center; padding: 8px 4px; border-top: var(--border-rule); color: inherit; text-decoration: none; }
  .team-row:first-child { border-top: 0; }
  .team-row:hover { background: var(--surface-2); }
  .team-n b { display: block; font-size: 14px; } .team-n small { color: var(--text-2); font-size: 12px; }
  .team-p { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; white-space: nowrap; }
  .team-w { font-size: 12.5px; white-space: nowrap; }
  .av { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: var(--surface-3); font: 700 11px/1 var(--font-mono); }
  .fw-grid { margin-top: 4px; }

  .tour { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto auto; gap: 14px; align-items: center; padding: 12px 12px 12px 16px; background: color-mix(in srgb, var(--accent-soft) 45%, var(--surface)); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent); }
  .tour[hidden] { display: none; }
  .tour-ic { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: var(--accent); color: var(--on-accent); }
  .tour-t b { display: block; font-size: 15px; } .tour-t small { display: block; font-size: 13px; color: var(--text-2); }
  .tour .btn { white-space: nowrap; }

  .home-more summary { list-style: none; display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; cursor: pointer; }
  .home-more summary::-webkit-details-marker { display: none; }
  .home-more summary b { display: block; font-size: 16px; } .home-more summary small { color: var(--text-2); font-size: 13px; }
  .home-more summary svg { transition: transform var(--dur-state) var(--ease-settle); }
  .home-more[open] summary svg { transform: rotate(90deg); }
  .site-tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; padding: 0 20px 20px; }
  .site-tile { display: grid; gap: 4px; padding: 12px 14px; border: 1px solid var(--line); border-radius: var(--radius); color: inherit; text-decoration: none; transition: transform var(--dur-state) var(--ease-settle), border-color var(--dur-state); }
  .site-tile:hover { transform: translateY(-2px); border-color: var(--accent); }
  .site-tile small { color: var(--text-2); font-size: 12.5px; }

  /* Narrow shapes, by the width the block has (L10). */
  @container content (max-width: 839px) {
    .hp-row > .s-7, .hp-row > .s-5 { grid-column: 1 / -1; }
  }
  @container content (max-width: 699px) {
    .th { grid-template-columns: 24px minmax(0, 1fr) auto; } .th .pill { display: none; }
    .pm-row { grid-template-columns: auto minmax(0, 1fr) auto; } .pm-word { display: none; }
    .team-row { grid-template-columns: 32px minmax(0, 1fr); } .team-p, .team-w { grid-column: 2; }
    .tiles { grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); }
    .tour { grid-template-columns: 40px minmax(0, 1fr) auto; } .tour .btn { grid-column: 2 / 4; justify-self: start; grid-row: 2; } .tour-x { grid-column: 3; grid-row: 1; }
    .day-i a { grid-template-columns: 56px 8px minmax(0, 1fr); } .day-arrow { display: none; }
  }
  @container content (max-width: 559px) {
    .next { grid-template-columns: 1fr; } .next-plan { max-width: 200px; }
    .day-bar { height: 50px; } .day-tick:nth-child(even) { display: none; }
    .hp-h .aside { margin-left: 0; width: 100%; }
    .th { grid-template-columns: 24px minmax(0, 1fr); } .th-due { grid-column: 2; margin-top: -4px; }
  }
  @media (prefers-reduced-motion: reduce) { .inbox .ib, .inbox .ib-urgent .ib-dot, .day-blk, .stagger .th { animation: none; } .hp-lede > span, .tick-toast, .th, .tbox { transition: none; } }
  }
</style>
<!-- Which blocks each role sees comes last, so it wins over the hidden default above. -->
<style is:global set:html={panelCss}></style>
