---
// Home: one page, a different first screen per role (decision 0022).
// Each role's first screen answers "what needs me today?" with the person's own numbers, never global totals:
//   technician       today at your office, Next up (with the room drawing), incidents at your office
//   delivery engineer the next device to set up (into the Deploy batch), provisioning waiting
//   service managers  For your approval, your service's health, firmware and advisories
//   project manager   projects by status light, gates due, blocked tasks
//   head              the estate in four numbers, what is stuck, the regions
//   service desk      new incidents, what is in progress or on hold, tickets not matched to a room
//   vendor            your installation and the next device
// Every role gets "My day" (where you are, the day in order, the current time) and the task list grouped
// Today, This week, Later, where one tap ticks a task through the live layer (who, when, undo).
// The work is built once (src/lib/home.mjs, from src/lib/work.mjs) and carried as JSON; the page draws whoever
// is viewing in the browser, so View as and a stage change re-render in place, with no reload (gaps.md #2).
import Shell from '../layouts/Shell.astro';
import Icon from '../components/Icon.astro';
import PageBand from '../components/PageBand.astro';
import Section from '../components/Section.astro';
import KeyNumbers from '../components/KeyNumbers.astro';
import StageBar from '../components/StageBar.astro';
import LiveBar from '../components/LiveBar.astro';
import RoomPlanSprite from '../components/RoomPlanSprite.astro';
import { homeData, ITEMS } from '../lib/home.mjs';
import { lights, nextGate } from '../lib/project-status.mjs';
import {
  advisories, ADV_LEVEL, ADV_ORDER, models as MODELS, firmwareLines, sites, siteStats, SITE_ORDER, totals, spaces, href, modelName,
  projects, PHASE_LABEL, PHASES, OPEN_PHASES, fmtDate, DEMO_TODAY, labTests, LAB_STATUS, countryName, commsRooms, REGION_LABEL,
} from '../lib/data.mjs';
import { PEOPLE, person, INBOX_SEED } from '../lib/demo.mjs';
import { PATHS } from './learn/_lessons.mjs';
import GuideLive from '../components/GuideLive.astro';

const H = homeData();
const json = JSON.stringify(H).replace(/</g, '\\u003c');
const OPEN_STATES = 'new,in-progress,on-hold';
const TASK_KINDS = 'provision,install,configure,commission,task';

// ---- Static blocks: the same for everyone of a role, shown by data-role on <html> ----------------------------------
const openAdv = Object.values(advisories).filter((a) => a.status !== 'closed').sort((a, b) => ADV_ORDER.indexOf(a.level) - ADV_ORDER.indexOf(b.level));
const fwLines = Object.values(firmwareLines).map((f) => ({
  ...f, standard: f.releases.find((r) => r.status === 'standard')?.version ?? null, lab: f.releases.find((r) => r.status === 'lab')?.version ?? null,
  to: `/profiles/${MODELS[f.models[0]]?.class}/${f.models[0]}/#firmware`,
}));
const installing = Object.values(spaces).filter((s) => s.stages.deploy > 0 && !s.positions.some((p) => p.legacy));
const openInc = ITEMS.filter((it) => it.kind === 'incident');
const roomsWithInc = new Set(openInc.map((i) => i.room).filter(Boolean)).size;
const inService = Object.values(spaces).filter((s) => s.stages.manage > 0 && !s.stages.deploy).length;
const homeOffices = Object.values(spaces).filter((s) => /^r(em|am|ap)-/.test(s.id)).length;
const netProjects = Object.values(projects).filter((p) => ['network-refresh', 'infra-refresh'].includes(p.kind) && p.phase !== 'closed');
const HEALTH = {
  'sm-av': [
    { n: inService, label: 'Rooms in service', to: '/rooms/?status=service' },
    { n: roomsWithInc, label: 'Rooms with an open incident', to: '/rooms/?issues=1', tone: roomsWithInc ? 'warn' : undefined },
    { n: installing.length, label: 'Rooms being installed', to: '/rooms/?status=installing' },
  ],
  'sm-infra': [
    { n: commsRooms.length, label: 'Comms rooms', to: '/rooms/?kind=comms' },
    { n: homeOffices, label: 'Home offices', to: '/rooms/?kind=kits' },
    { n: netProjects.length, label: 'Network projects live', to: `/projects/?kind=network-refresh,infra-refresh` },
  ],
};
const review = [
  { id: 'CHG-039', title: 'Video bar profile: add a symptom for the external camera switching back after a reboot', by: 'Aoife Byrne', to: 'sofia' },
  { id: 'CHG-035', title: 'New device model: Logitech Rally Bar Mini', by: 'Niamh Walsh', to: 'sofia', note: 'You asked for changes' },
];
// Projects, with their lights, next gate and blocked tasks. Rows carry the project manager, so a PM sees theirs.
const projList = Object.values(projects).filter((p) => p.phase !== 'closed').map((p) => {
  const L = lights(p), G = nextGate(p), open = p.tasks.filter((t) => t.status !== 'done'), blocked = open.filter((t) => t.status === 'blocked');
  const worst = ['bad', 'warn', 'ok', 'off'].find((s) => [L.schedule, L.cost, L.scope].some((l) => l.state === s)) ?? 'ok';
  return { p, L, G, open, blocked, worst };
}).sort((a, b) => ['bad', 'warn', 'ok', 'off'].indexOf(a.worst) - ['bad', 'warn', 'ok', 'off'].indexOf(b.worst) || (a.G?.date ?? '9').localeCompare(b.G?.date ?? '9'));
const gates = projList.filter((x) => x.G && !x.G.signed).sort((a, b) => a.G.date.localeCompare(b.G.date));
const blockedTasks = projList.flatMap((x) => x.blocked.map((t) => ({ t, p: x.p })));
const redProjects = projList.filter((x) => x.worst === 'bad');
const urgent = INBOX_SEED.filter((x) => x.kind === 'urgent' && x.status !== 'done');
const days = (d) => Math.round((new Date(d) - new Date(DEMO_TODAY)) / 864e5);
const short = (d) => fmtDate(d, { day: 'numeric', month: 'short' });
const REGIONS = ['emea', 'amer', 'apac'].map((r) => {
  const ss = SITE_ORDER.filter((s) => sites[s].region === r);
  return { r, label: REGION_LABEL[r].replace('Europe, Middle East and Africa', 'EMEA'), sites: ss.filter((s) => sites[s].kind !== 'remote').length, rooms: ss.reduce((n, s) => n + (siteStats[s]?.spaces ?? 0), 0), inc: openInc.filter((i) => sites[i.site]?.region === r).length };
});
const labWaiting = Object.values(labTests).filter((l) => ['passed', 'testing', 'queued'].includes(l.status));
const pms = PEOPLE.filter((p) => p.roleId === 'pm');

// Which blocks each role sees. "Everyone (overview)" sees every block, each saying whose first screen it is.
const PANELS = {
  next: ['tech'], office: ['tech'], device: ['delivery', 'network'], provision: ['delivery', 'network'],
  inbox: ['sm-av', 'sm-infra'], health: ['sm-av', 'sm-infra'], firmware: ['sm-av', 'sm-infra'],
  projects: ['pm', 'programme', 'head'], gates: ['pm', 'programme'], blocked: ['pm', 'programme'],
  stuck: ['head'], regions: ['head'], desknew: ['desk'], deskopen: ['desk'], vendor: ['vendor', 'service-vendor'], vnext: ['vendor'],
  team: ['delivery-manager', 'eng-manager', 'pm-manager', 'tech-manager'], lab: ['innovation', 'sm-av'],
  tasks: ['delivery', 'tech', 'network', 'pm', 'innovation', 'programme', 'sm-av', 'sm-infra', 'vendor', 'head', 'delivery-manager', 'eng-manager', 'pm-manager', 'tech-manager'],
};
const WHO_SEES = {
  next: 'What on-site technicians see first', office: 'What on-site technicians see', device: 'What delivery and network engineers see first', provision: 'What delivery engineers see',
  inbox: 'What service managers see first', health: 'What service managers see', firmware: 'What service managers see',
  projects: 'What project managers, the programme manager and the head of the service see first', gates: 'What project managers see', blocked: 'What project managers see',
  stuck: 'What the head of the service sees first', regions: 'What the head of the service sees', desknew: 'What the service desk sees first', deskopen: 'What the service desk sees',
  vendor: 'What vendors see first', vnext: 'What vendors see', team: 'What people managers see first', lab: 'What the innovation engineer and the AV service manager see', tasks: 'What everyone with tasks sees',
};
const panelCss = Object.entries(PANELS).map(([k, roles]) => [...roles.map((r) => `:root[data-role="${r}"] .hp-${k}`), `:root[data-who="everyone"] .hp-${k}`].join(',') + '{display:block}').join('')
  // A project manager sees only the projects they run; everyone else sees them all.
  + pms.map((pm) => `:root[data-who="${pm.id}"] [data-pm]:not([data-pm="${pm.id}"]){display:none}`).join('');
---
<Shell title="Home" section="home" vendorOk crumbs={[{ label: 'Home' }]}>
  <RoomPlanSprite />
  <PageBand overline="Home" title="Aoife, ready for you">
    <span slot="overline"><span data-greet>Hello</span> · <span class="faint">{fmtDate(DEMO_TODAY, { weekday: 'long', day: 'numeric', month: 'long' })}</span></span>
    <span slot="lede" class="hp-lede"><span class="hp-lede-who"><span data-who-role>AV and IT delivery engineer</span> · <span data-who-where></span></span><span class="hp-caption" data-caption aria-live="polite"></span></span>
    <a slot="action" class="btn primary" data-home-action href={href('/work/')}>Open Work overview</a>
    <!-- Four figures, filled for whoever is viewing (src/lib/home.mjs numbersFor): each opens the list it counts (rule P10). -->
    <KeyNumbers slot="numbers" items={[
      { n: 0, label: 'Today', id: 'k0', to: '/work/schedule/?view=day' },
      { n: 0, label: 'Open tasks', id: 'k1', to: `/work/list/?kind=${TASK_KINDS}` },
      { n: 0, label: 'Open incidents', id: 'k2', to: `/incidents/?state=${OPEN_STATES}` },
      { n: 0, label: 'Projects', id: 'k3', to: '/projects/' },
    ]} />
  </PageBand>

  <div class="content home" data-home>
    <!-- 1. My day: where you are, the day in order, the current time. Drawn for whoever is viewing. -->
    <section class="card hp-day" aria-labelledby="h-day" data-help="home.day" data-day>
      <header class="hp-h">
        <h2 id="h-day"><Icon name="schedule" />My day</h2>
        <span class="day-place" data-day-place></span>
        <a class="aside" data-day-full href={href(`/work/schedule/?view=day&d=${DEMO_TODAY}`)}>Full schedule →</a>
      </header>
      <div class="day-bar" data-day-bar aria-hidden="true"></div>
      <ol class="day-list" data-day-list></ol>
      <p class="hp-empty" data-day-empty hidden>Nothing on today. Your open work is below.</p>
    </section>

    <!-- 2. The answer for each role: one row of two cards. -->
    <div class="g12 hp-row">
      <!-- Technician: the next job, with the room drawing, and what is open at your office. -->
      <section class="hp hp-next card s-7" aria-labelledby="h-next">
        <p class="hp-who" data-help="home.who">{WHO_SEES.next}</p>
        <header class="hp-h" data-help="home.next"><h2 id="h-next"><Icon name="room" />Next up</h2></header>
        <div data-next></div>
      </section>
      <section class="hp hp-office card s-5" aria-labelledby="h-office">
        <p class="hp-who" data-help="home.who">{WHO_SEES.office}</p>
        <header class="hp-h" data-help="home.office"><h2 id="h-office"><Icon name="alert" />At <span data-office-name>your office</span></h2></header>
        <div class="mini-list" data-office-inc></div>
        <a class="hp-more" data-office-all data-vt-rec="dd-incidents" href={href(`/incidents/?state=${OPEN_STATES}`)}>See all in Incidents →</a>
      </section>

      <!-- Delivery and network engineers: the next device, into its Deploy batch; provisioning waiting. -->
      <section class="hp hp-device card s-7" aria-labelledby="h-device">
        <p class="hp-who" data-help="home.who">{WHO_SEES.device}</p>
        <header class="hp-h" data-help="home.device"><h2 id="h-device"><Icon name="devices" />Next device</h2></header>
        <div data-device></div>
      </section>
      <section class="hp hp-provision card s-5" aria-labelledby="h-prov">
        <p class="hp-who" data-help="home.who">{WHO_SEES.provision}</p>
        <header class="hp-h" data-help="home.provision"><h2 id="h-prov"><Icon name="check" />Provisioning waiting</h2></header>
        <div class="mini-list" data-provision></div>
        <a class="hp-more" data-provision-all data-vt-rec="dd-work-list" href={href(`/work/list/?kind=provision`)}>See all in the Work list →</a>
      </section>

      <!-- Service managers: For your approval (reports sent with Report land here, live), and the service's health. -->
      <section class="hp hp-inbox card s-7" aria-labelledby="h-inbox">
        <p class="hp-who" data-help="home.who">{WHO_SEES.inbox}</p>
        <header class="hp-h" data-help="home.inbox"><h2 id="h-inbox"><Icon name="inbox" />For your approval</h2><span class="aside faint" data-inbox-summary></span></header>
        <ol class="inbox" data-inbox></ol>
        <div class="hp-sub" data-help="home.review">
          <h3>Changes waiting for your review</h3>
          {review.map((c) => (
            <a class="mini-row" href={href(`/changes/#${c.id.toLowerCase()}`)} data-to={c.to}>
              <span class="mono faint">{c.id}</span><span>{c.title}<small>{c.by}{c.note ? ` · ${c.note}` : ''}</small></span><Icon name="arrow" size={16} />
            </a>
          ))}
          <a class="hp-more" href={href('/changes/')}>Every change and who approved it <Icon name="arrow" size={14} /></a>
        </div>
      </section>
      <section class="hp hp-health card s-5" aria-labelledby="h-health">
        <p class="hp-who" data-help="home.who">{WHO_SEES.health}</p>
        <header class="hp-h" data-help="home.health"><h2 id="h-health"><Icon name="pulse" />Your service's health</h2></header>
        {Object.entries(HEALTH).map(([sm, tiles]) => (
          <div class="tiles" data-sm={sm}>
            {tiles.map((t) => (
              <a class={`tile${t.tone ? ` t-${t.tone}` : ''}`} href={href(t.to)} data-help="home.tile" data-vt-rec={`dd${new URL(t.to, 'http://x').pathname.replace(/[^a-z0-9]+/gi, '-').replace(/-$/, '')}`}><b>{t.n.toLocaleString('en-IE')}</b><span>{t.label}</span></a>
            ))}
          </div>
        ))}
      </section>

      <!-- Project managers, the programme manager and the head: projects by status light, and the gates due. -->
      <section class="hp hp-projects card s-7" aria-labelledby="h-proj">
        <p class="hp-who" data-help="home.who">{WHO_SEES.projects}</p>
        <header class="hp-h" data-help="home.projects"><h2 id="h-proj"><Icon name="project" />Projects by status</h2><a class="aside" data-projects-all href={href('/projects/')}>All projects →</a></header>
        <div class="proj-mini">
          {projList.map(({ p, L, G, open, blocked, worst }) => (
            <a class="pm-row" href={href(`/projects/${p.id.toLowerCase()}/`)} data-pm={p.owner} data-help="home.project-row" data-vt-rec={p.id}>
              <span class="pm-lights" aria-label={`Schedule ${L.schedule.word}, cost ${L.cost.word}, scope ${L.scope.word}`}>{[L.schedule, L.cost, L.scope].map((l) => <i class="hl" data-state={l.state}></i>)}</span>
              <span class="pm-name"><b>{p.name}</b><small>{p.id} · {sites[p.site]?.name} · {PHASE_LABEL[p.phase]}{G ? ` · gate ${short(G.date)}` : ''}</small></span>
              <span class="pm-word">{worst === 'bad' ? [L.schedule, L.cost, L.scope].find((l) => l.state === 'bad').word : worst === 'warn' ? [L.schedule, L.cost, L.scope].find((l) => l.state === 'warn').word : 'On plan'}</span>
              {blocked.length ? <span class="pill bad">{blocked.length} blocked</span> : <span class="pill plain">{open.length} open</span>}
            </a>
          ))}
        </div>
      </section>
      <section class="hp hp-gates card s-5" aria-labelledby="h-gates">
        <p class="hp-who" data-help="home.who">{WHO_SEES.gates}</p>
        <header class="hp-h" data-help="home.gates"><h2 id="h-gates"><Icon name="calendar" />Gates due</h2></header>
        <div class="mini-list">
          {gates.map(({ p, G }) => (
            <a class="mini-row" href={href(`/projects/${p.id.toLowerCase()}/`)} data-pm={p.owner}>
              <span class={`gate-d${G.late ? ' late' : days(G.date) <= 14 ? ' soon' : ''}`}>{short(G.date)}</span>
              <span>{G.phase} gate, {p.name}<small>{G.late ? `${G.slip} days over · ` : ''}{G.signer} signs</small></span><Icon name="arrow" size={16} />
            </a>
          ))}
        </div>
      </section>

      <!-- Head of the service: what is stuck, and the regions. -->
      <section class="hp hp-stuck card s-7" aria-labelledby="h-stuck">
        <p class="hp-who" data-help="home.who">{WHO_SEES.stuck}</p>
        <header class="hp-h" data-help="home.stuck"><h2 id="h-stuck"><Icon name="alert" />What is stuck</h2></header>
        <div class="mini-list">
          {urgent.map((x) => (
            <a class="mini-row" href={href(x.about.to)}><span class="pill bad">Urgent</span><span>{x.about.label}<small>{person(x.by).name} to {person(x.to).name} · {x.fields.happened?.slice(0, 90)}…</small></span><Icon name="arrow" size={16} /></a>
          ))}
          {redProjects.map(({ p, L }) => (
            <a class="mini-row" href={href(`/projects/${p.id.toLowerCase()}/`)}><span class="pill bad">Project</span><span>{p.name}<small>{[L.schedule, L.cost, L.scope].filter((l) => l.state === 'bad').map((l) => l.why).join(' ')}</small></span><Icon name="arrow" size={16} /></a>
          ))}
          {blockedTasks.slice(0, 5).map(({ t, p }) => (
            <a class="mini-row" href={href(`/projects/${p.id.toLowerCase()}/tasks/${t.id.toLowerCase()}/`)}><span class="pill bad">Blocked</span><span>{t.title}<small>{p.name} · {person(t.owner).name} · {t.blocked_by}</small></span><Icon name="arrow" size={16} /></a>
          ))}
        </div>
        <a class="hp-more" data-vt-rec="dd-work-list" href={href(`/work/list/?kind=${TASK_KINDS}&status=blocked`)}>See all {blockedTasks.length} blocked in the Work list →</a>
      </section>
      <section class="hp hp-regions card s-5" aria-labelledby="h-reg">
        <p class="hp-who" data-help="home.who">{WHO_SEES.regions}</p>
        <header class="hp-h" data-help="home.regions"><h2 id="h-reg"><Icon name="globe" />The regions</h2></header>
        <table class="reg-t">
          <thead><tr><th>Region</th><th>Offices</th><th>Rooms</th><th>Incidents</th></tr></thead>
          <tbody>
            {REGIONS.map((x) => (
              <tr><th scope="row">{x.label}</th><td><a href={href(`/locations/?region=${x.r}`)}>{x.sites}</a></td><td><a href={href(`/rooms/?region=${x.r}`)} data-vt-rec="dd-rooms">{x.rooms}</a></td><td><a href={href(`/incidents/?region=${x.r}&state=${OPEN_STATES}`)} data-vt-rec="dd-incidents">{x.inc}</a></td></tr>
            ))}
          </tbody>
        </table>
      </section>

      <!-- Service desk: what just came in, and what is under way or waiting. -->
      <section class="hp hp-desknew card s-7" aria-labelledby="h-dnew">
        <p class="hp-who" data-help="home.who">{WHO_SEES.desknew}</p>
        <header class="hp-h" data-help="home.desk-new"><h2 id="h-dnew"><Icon name="inbox" />New incidents</h2></header>
        <div class="mini-list" data-desk-new></div>
        <a class="hp-more" data-vt-rec="dd-incidents" href={href('/incidents/?state=new')}>See all <span data-desk-new-n></span> in Incidents →</a>
      </section>
      <section class="hp hp-deskopen card s-5" aria-labelledby="h-dopen">
        <p class="hp-who" data-help="home.who">{WHO_SEES.deskopen}</p>
        <header class="hp-h" data-help="home.desk-open"><h2 id="h-dopen"><Icon name="alert" />In progress and on hold</h2></header>
        <div class="mini-list" data-desk-open></div>
        <a class="hp-more" data-vt-rec="dd-incidents" href={href('/incidents/?state=in-progress,on-hold')}>See all <span data-desk-open-n></span> in Incidents →</a>
      </section>
      <GuideLive where="home" />

      <!-- Vendors: only their installation. -->
      <section class="hp hp-vendor card s-7" aria-labelledby="h-vend">
        <p class="hp-who" data-help="home.who">{WHO_SEES.vendor}</p>
        <header class="hp-h" data-help="home.vendor"><h2 id="h-vend"><Icon name="kit" />Your installation</h2></header>
        <p>Your rooms, the tasks assigned to your company, and the records Aigna needs from you: serial numbers, MAC addresses and photos.</p>
        <a class="btn primary" href={href('/vendor/')}>Open your installation <Icon name="arrow" size={16} /></a>
      </section>
      <section class="hp hp-vnext card s-5" aria-labelledby="h-vnext">
        <p class="hp-who" data-help="home.who">{WHO_SEES.vnext}</p>
        <header class="hp-h" data-help="home.device"><h2 id="h-vnext"><Icon name="devices" />Next device</h2></header>
        <div data-device-vendor></div>
      </section>

      <!-- People managers: the team today. -->
      <section class="hp hp-team card s-12" aria-labelledby="h-team">
        <p class="hp-who" data-help="home.who">{WHO_SEES.team}</p>
        <header class="hp-h" data-help="home.team"><h2 id="h-team"><Icon name="team" />Your team today</h2><a class="aside" href={href('/work/schedule/?view=day&scope=team')}>Team schedule →</a></header>
        <div class="team-rows" data-team></div>
      </section>

      <!-- The Lab: for the innovation engineer and the AV service manager. -->
      <section class="hp hp-lab card s-12" aria-labelledby="h-lab">
        <p class="hp-who" data-help="home.who">{WHO_SEES.lab}</p>
        <header class="hp-h" data-help="home.lab"><h2 id="h-lab"><Icon name="flask" />In the Lab</h2><a class="aside" href={href('/lab/')}>The Lab →</a></header>
        <div class="mini-list">
          {labWaiting.map((l) => (
            <a class="mini-row" href={href(`/lab/#${l.id.toLowerCase()}`)}>
              <span class="mono faint">{l.id}</span><span>{l.title}<small>{LAB_STATUS[l.status]}{l.status === 'passed' ? ': waiting for the service manager' : ''}</small></span><Icon name="arrow" size={16} />
            </a>
          ))}
        </div>
      </section>
    </div>

    <!-- 3. The task list: Today, This week, Later; one tap ticks a task through the live layer. -->
    <Section title="Your tasks" help="home.tasks" id="h-tasks-sec" class="hp hp-tasks card">
      <span slot="aside" class="faint" data-task-summary></span>
      <p class="hp-who" data-help="home.who">{WHO_SEES.tasks}</p>
      <div class="tasks-home" data-tasks>
        {['today', 'week', 'later', 'done'].map((g) => (
          <div class="tg" data-group={g} hidden>
            <h3 class="tg-h" data-help="home.tasks-group"><span>{{ today: 'Today', week: 'This week', later: 'Later', done: 'Done today' }[g]}</span><small data-n></small></h3>
            <ol class="tg-list" data-rows></ol>
          </div>
        ))}
      </div>
      <p class="hp-empty" hidden data-task-empty>Nothing assigned to you right now.</p>
      <!-- Every count drills down (rule P10): the same open tasks, this person's, in the Work list. -->
      <a class="hp-more" data-tasks-all data-vt-rec="dd-work-list" href={href(`/work/list/?kind=${TASK_KINDS}`)}>See all in the Work list →</a>
      <div class="tick-toast" data-toast hidden role="status"></div>
      <LiveBar page="home" />
    </Section>

    <!-- 4. Service managers: firmware and advisories, full width. -->
    <section class="hp hp-firmware card" aria-labelledby="h-fw">
      <p class="hp-who" data-help="home.who">{WHO_SEES.firmware}</p>
