---
// The front door (FRONT-DOOR-V2.md). Five seconds: seven words, one sentence, two doors, and the product itself,
// four levels deep, with the zoom that joins them. Then the two halves of the work, each one screen with the product
// in it: Run it (the fault the hero found, fixed in five clicks) and Deliver it (a new floor set up in batches and
// checked by the record). Then one morning as five visual moments, one per idea; three ways in; one honest strip.
// Every door is open: no sign-up, no form, no "request a demo".
//
// Why /welcome/ and not the root: the console's Home is "/" and is linked from the sidebar, the mark, lessons,
// help cards and every role's first screen. /welcome/ adds a page and changes nothing that exists.
import Front from '../../layouts/Front.astro';
import HeroZoom from '../../components/front/HeroZoom.astro';
import FixIt from '../../components/front/FixIt.astro';
import Deliver from '../../components/front/Deliver.astro';
import Moments from '../../components/front/Moments.astro';
import IsoFloor from '../../components/front/IsoFloor.astro';
import { building } from '../../lib/floors.mjs';
import { floorScene } from '../../lib/isofloor.mjs';
import { href } from '../../lib/data.mjs';
import { NAME, LINE, LINKS } from '../../lib/brand.mjs';

// The headline names what the record holds; the sentence says how it is kept and what that buys.
const HEADLINE = 'Every room, device and job. One living record.';
const SENTENCE = 'Written as the work happens and handed on whole, from the whole estate down to one port.';
const WAYS = [
  { id: 'demo', word: 'Open the demo', what: 'A fictional company, eleven offices, one September morning. Open it as Liam, the Dublin technician, and break a room.', note: 'No sign-up', to: href('/'), as: 'liam', primary: true },
  { id: 'run', word: 'Run it for your team', what: 'Your estate as YAML in a private repository. Validation runs on every change; the site builds itself.', note: 'Getting started', to: LINKS.gettingStarted },
  { id: 'read', word: 'Read the method', what: 'Five ideas, the words they use and what they map to in ITIL, PMI and ISO/IEC 20000. One screen, then as deep as you like.', note: 'Ten minutes', to: href('/method/') },
];
const STANDS = [
  ['Real today', 'Schemas, validation, floor plans, room drawings, build sheets, the room guide.'],
  ['Simulated', 'Live health, bookings, every connector and any automatic work. Every company, person, room and fault in the demo is made up.'],
  ['Next', 'The API, export and database mode, in that order.'],
  ['Out of scope', 'Laptops and phones. Real estate and space planning are connected, never owned.'],
];
const LINKROW = [
  ['v0.1 preview', LINKS.releases], ['Apache 2.0', LINKS.licence], ['Method CC BY-SA 4.0', LINKS.ccbysa], ['Source', LINKS.source], ['Roadmap', LINKS.roadmap], ['Security', LINKS.security], ['The words', href('/method/words/')],
];
// The demo door's picture: the third floor, small, with the one fault the hero found.
const M = building('dub');
const S = floorScene(M, '3', { width: 520, height: 260, pad: 22, rings: 'all' });
const IDEA_WORDS = ['Start from the building', 'Capture, don’t ask', 'Answer first', 'Own it, hand it on', 'Learn as you go'];
---
<Front title={`${NAME}: ${LINE}`} description={HEADLINE}>
  <section class="fd-hero" aria-labelledby="fd-h" data-shot="hero">
    <div class="fd-lead">
      <h1 id="fd-h">{HEADLINE}</h1>
      <p class="fd-sentence">{SENTENCE}</p>
      <div class="fd-doors">
        <a class="fd-door fd-primary" href={href('/')} data-as="liam">Open the demo <small>no sign-up</small></a>
        <a class="fd-door" href={href('/method/')}>Read the method</a>
      </div>
    </div>
    <HeroZoom />
    <p class="fd-honest">The demo's Dublin office, one September morning. Simulated: every company, room and fault is made up.</p>
  </section>

  <div class="fd-screen"><FixIt /></div>

  <div class="fd-screen"><Deliver /></div>

  <section class="fd-screen" aria-labelledby="fd-morning">
    <header class="fd-head">
      <p class="fd-eyebrow">One morning · 07:52 to 08:31</p>
      <h2 id="fd-morning">Five ideas, in the order they happen</h2>
      <p class="fd-sub">The method behind both halves, seen once each as the morning unfolds. Each has its own page.</p>
    </header>
    <Moments />
  </section>

  <section class="fd-screen" aria-labelledby="fd-ways" data-shot="ways">
    <header class="fd-head">
      <p class="fd-eyebrow">Three ways in</p>
      <h2 id="fd-ways">Open it, run it, or read it first</h2>
    </header>
    <ul class="fd-ways">
      {WAYS.map((w) => (
        <li>
          <a class:list={['fd-way', `fd-way-${w.id}`, { 'is-primary': w.primary }]} href={w.to} data-as={w.as}>
            <span class="fd-way-pic" aria-hidden="true">
              {w.id === 'demo' && <IsoFloor scene={S} states={{ 'dub-3-09': 'fault' }} label="" />}
              {w.id === 'run' && (
                <svg viewBox="0 0 320 150" class="fd-pic-run">
                  <rect class="pr-file" x="26" y="18" width="150" height="118" rx="10" />
                  <rect class="pr-line pr-key" x="44" y="40" width="34" height="7" rx="3.5" /><rect class="pr-line" x="84" y="40" width="58" height="7" rx="3.5" />
                  <rect class="pr-line pr-key" x="44" y="58" width="52" height="7" rx="3.5" /><rect class="pr-line" x="102" y="58" width="38" height="7" rx="3.5" />
                  <rect class="pr-line pr-key" x="56" y="76" width="26" height="7" rx="3.5" /><rect class="pr-line" x="88" y="76" width="66" height="7" rx="3.5" />
                  <rect class="pr-line pr-key" x="56" y="94" width="40" height="7" rx="3.5" /><rect class="pr-line" x="102" y="94" width="34" height="7" rx="3.5" />
                  <rect class="pr-line pr-key" x="44" y="112" width="30" height="7" rx="3.5" /><rect class="pr-line" x="80" y="112" width="52" height="7" rx="3.5" />
                  <path class="pr-arrow" d="M190 77h48" /><path class="pr-arrow" d="M231 69l8 8-8 8" />
                  <circle class="pr-ring" cx="272" cy="77" r="20" /><path class="pr-tick" d="M262 78l7 7 13-14" />
                </svg>
              )}
              {w.id === 'read' && (
                <ol class="fd-pic-read">{IDEA_WORDS.map((n, i) => <li style={`--i:${i}`}><i>{i + 1}</i><span>{n}</span></li>)}</ol>
              )}
            </span>
            <b>{w.word}</b>
            <span class="fd-way-what">{w.what}</span>
            <small>{w.note} →</small>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="fd-stands" aria-labelledby="fd-where" data-shot="stands">
    <h2 id="fd-where" class="fd-stands-h">Where it stands</h2>
    <dl class="fd-stand">
      {STANDS.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
    </dl>
    <p class="fd-links">{LINKROW.map(([w, to]) => <a href={to}>{w}</a>)}</p>
  </section>
</Front>

<style is:global>
  /* Every section below the hero opens the same way: a short label, a heading that states the answer, one sentence. */
  .fd-head { display: grid; gap: 10px; max-width: 980px; }
  .fd-eyebrow { margin: 0; font-size: 13.5px; font-weight: 550; color: var(--text-3); letter-spacing: .005em; }
  .fd-head h2 { margin: 0; font: 600 clamp(26px, 2.9vw, 38px)/1.1 var(--font-sans); letter-spacing: -.03em; text-wrap: balance; max-width: 34ch; }
  .fd-sub { margin: 0; font-size: 16px; line-height: 1.5; color: var(--text-2); max-width: 96ch; text-wrap: pretty; }
  @container fd (max-width: 699px) { .fd-head h2 { font-size: 26px; } .fd-sub { font-size: 15px; } }
</style>

<style>
  /* The first screen is the whole composition: headline, one line, both doors and the entire visual, at 1280 x 800,
     1440 x 900 and 1920 x 1080 without scrolling. The text keeps to three short rows; the stage takes what is left. */
  .fd-hero { display: grid; gap: 24px; padding: 28px 0 8px; justify-items: center; }
  .fd-lead { display: grid; gap: 14px; justify-items: center; text-align: center; max-width: 1200px; }
  .fd-lead h1 { margin: 0; font: 600 clamp(34px, 3.4vw, 50px)/1.05 var(--font-sans); letter-spacing: -.035em; color: var(--text); text-wrap: balance; }
  .fd-sentence { margin: 0; font-size: clamp(15.5px, 1.3vw, 18px); line-height: 1.5; color: var(--text-2); max-width: 92ch; text-wrap: pretty; }
  .fd-doors { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 4px; }
  .fd-door {
    display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 22px; border-radius: 12px;
    font: 550 15.5px/1 var(--font-sans); color: var(--text); text-decoration: none; background: var(--surface); border: 1px solid var(--line-strong);
    transition: background var(--dur-hover) var(--ease-settle), border-color var(--dur-hover) var(--ease-settle), transform var(--dur-press, 80ms) var(--ease-settle);
  }
  .fd-door:hover { color: var(--text); background: var(--surface-2); border-color: var(--text-3); }
  .fd-door:active { transform: scale(.97); }
  .fd-door small { font-size: 12.5px; font-weight: 500; opacity: .75; }
  .fd-primary { background: var(--ink); color: var(--on-ink); border-color: var(--ink); }
  .fd-primary:hover { background: var(--ink); color: var(--on-ink); border-color: var(--ink); opacity: .9; }
  .fd-hero :global(.hz) { width: 100%; }
  .fd-honest { margin: -10px 0 0; font-size: 12.5px; color: var(--text-3); text-align: center; }

  .fd-screen { display: grid; gap: 28px; padding-top: 104px; }

  /* Three doors, each with its own picture. */
  .fd-ways { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .fd-ways li { display: grid; min-width: 0; }
  .fd-way { display: grid; grid-template-rows: auto auto 1fr auto; gap: 8px; padding: 14px 14px 20px; border-radius: 20px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-md); color: var(--text); text-decoration: none; transition: border-color var(--dur-hover) var(--ease-settle), transform var(--dur-hover) var(--ease-settle), box-shadow var(--dur-hover) var(--ease-settle); }
  .fd-way:hover { color: var(--text); border-color: var(--text-3); transform: translateY(-3px); box-shadow: var(--shadow-lg); }
  .fd-way:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .fd-way b { font: 600 20px/1.2 var(--font-sans); letter-spacing: -.02em; padding: 8px 10px 0; }
  .fd-way-what { font-size: 14.5px; line-height: 1.5; color: var(--text-2); padding: 0 10px; }
  .fd-way small { display: inline-flex; align-items: center; width: max-content; min-height: 36px; margin: 6px 10px 0; padding: 0 14px; border-radius: 999px; font-size: 13.5px; font-weight: 550; color: var(--text); background: var(--surface-2); border: 1px solid var(--line-strong); }
  .fd-way.is-primary small { background: var(--ink); color: var(--on-ink); border-color: var(--ink); }
  .fd-way-pic {
    --pic-bg: #EFE9DF; --pic-light: #FFFDF9;
    display: grid; place-items: center; height: 180px; padding: 14px 18px; border-radius: 14px; overflow: clip; box-shadow: inset 0 0 0 1px var(--hairline);
    background: radial-gradient(90% 80% at 24% 8%, var(--pic-light) 0%, transparent 62%), var(--pic-bg);
  }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .fd-way-pic { --pic-bg: #15130F; --pic-light: #2B2621; } }
  :root[data-theme="dark"] .fd-way-pic { --pic-bg: #15130F; --pic-light: #2B2621; }
  .fd-way-pic :global(.ifl) { width: 100%; max-height: 100%; }
  .fd-pic-run { width: 100%; height: 100%; }
  .pr-file { fill: var(--surface); stroke: var(--line-strong); stroke-width: 1.2; }
  .pr-line { fill: var(--surface-3); } .pr-key { fill: var(--text-3); opacity: .55; }
  .pr-arrow { fill: none; stroke: var(--text-3); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .pr-ring { fill: var(--surface); stroke: var(--h-fine, var(--green)); stroke-width: 2.4; }
  .pr-tick { fill: none; stroke: var(--h-fine, var(--green)); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .fd-pic-read { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; width: 100%; }
  .fd-pic-read li { display: flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 550; color: var(--text); }
  .fd-pic-read i { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; border: 1.6px solid var(--text-3); font: 600 11.5px/1 var(--font-sans); font-style: normal; color: var(--text-2); flex: none; font-variant-numeric: tabular-nums; }
  .fd-pic-read li:first-child i { border-color: var(--h-fault, var(--red)); color: var(--h-fault-ink, var(--red-ink)); }

  /* Where it stands: one small strip, then the links. */
  .fd-stands { display: grid; gap: 16px; padding: 96px 0 8px; }
  .fd-stands-h { margin: 0; font-size: 13.5px; font-weight: 550; color: var(--text-3); }
  .fd-stand { margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .fd-stand div { display: grid; gap: 4px; align-content: start; padding-top: 12px; border-top: 1px solid var(--line-strong); }
  .fd-stand dt { font-size: 14px; font-weight: 600; }
  .fd-stand dd { margin: 0; font-size: 13.5px; line-height: 1.5; color: var(--text-2); }
  .fd-links { margin: 8px 0 0; display: flex; flex-wrap: wrap; gap: 6px 22px; font-size: 13.5px; }
  .fd-links a { display: inline-flex; align-items: center; min-height: 32px; color: var(--text-2); }
  .fd-links a:hover { color: var(--text); }

  @container fd (max-width: 1099px) {
    .fd-stand { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @container fd (max-width: 899px) {
    .fd-ways { grid-template-columns: minmax(0, 1fr); }
    .fd-way-pic { height: 160px; }
  }
  @container fd (max-width: 699px) {
    .fd-hero { padding-top: 24px; gap: 22px; }
    .fd-lead { gap: 12px; }
    .fd-lead h1 { font-size: 32px; }
    .fd-screen { padding-top: 80px; gap: 22px; }
    .fd-stands { padding-top: 72px; }
    .fd-honest { margin-top: -12px; }
    .fd-door { flex: 1 1 100%; justify-content: center; }
  }
  @container fd (max-width: 459px) {
    .fd-stand { grid-template-columns: minmax(0, 1fr); }
  }
</style>
