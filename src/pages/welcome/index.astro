---
// The front door (FRONT-DOOR-V2.md). Five seconds: seven words, one sentence, two doors, and the product itself,
// four levels deep, with the zoom that joins them. One minute: one morning as five visual moments, one per idea.
// Then three ways in and one honest block. Every door is open: no sign-up, no form, no "request a demo".
//
// Why /welcome/ and not the root: the console's Home is "/" and is linked from the sidebar, the mark, lessons,
// help cards and every role's first screen. /welcome/ adds a page and changes nothing that exists.
import Front from '../../layouts/Front.astro';
import HeroZoom from '../../components/front/HeroZoom.astro';
import Moments from '../../components/front/Moments.astro';
import { href } from '../../lib/data.mjs';
import { NAME, LINE, LINKS } from '../../lib/brand.mjs';

const HEADLINE = 'Fix the room before the meeting starts.';
const SENTENCE = 'One living record of every room, device and job, written as the work happens: a fault shows at 07:52 and is fixed by 08:31.';
const WAYS = [
  { word: 'Open the demo', what: 'A fictional company, eleven offices, one September morning. Open it as Liam, the Dublin technician, and break a room.', note: 'No sign-up', to: href('/'), as: 'liam', primary: true },
  { word: 'Run it for your team', what: 'Your estate as YAML in a private repository. Validation runs on every change; the site builds itself.', note: 'Getting started', to: LINKS.gettingStarted },
  { word: 'Read the method', what: 'Five ideas, the words they use and what they map to in ITIL, PMI and ISO/IEC 20000. One screen, then as deep as you like.', note: 'Ten minutes', to: href('/method/') },
];
const STANDS = [
  ['Real today', 'Schemas, validation, floor plans, room drawings, build sheets, the room guide.'],
  ['Simulated', 'Live health, bookings, every connector and any automatic work. Every company, person, room and fault in the demo is made up.'],
  ['Next', 'The API, export and database mode, in that order.'],
  ['Out of scope', 'Laptops and phones. Real estate and space planning are connected, never owned.'],
];
const LINKROW = [
  ['v0.1 preview', LINKS.releases], ['Apache 2.0', LINKS.licence], ['Method CC BY-SA 4.0', LINKS.ccbysa], ['Source', LINKS.source], ['Roadmap', LINKS.roadmap], ['Security', LINKS.security], ['The words', href('/method/words/')],
];
---
<Front title={`${NAME}: ${LINE}`} description={HEADLINE}>
  <section class="fd-hero" aria-labelledby="fd-h">
    <div class="fd-lead">
      <h1 id="fd-h">{HEADLINE}</h1>
      <p class="fd-sentence">{SENTENCE}</p>
      <div class="fd-doors">
        <a class="fd-door fd-primary" href={href('/')} data-as="liam">Open the demo <small>no sign-up</small></a>
        <a class="fd-door" href={href('/method/')}>Read the method</a>
      </div>
    </div>
    <HeroZoom />
    <p class="fd-honest">The demo's Dublin office, one September morning. Simulated: every company, room and fault is made up.</p>
  </section>

  <section class="fd-screen" aria-labelledby="fd-morning">
    <p class="fd-over">One morning · 07:52 to 08:31</p>
    <h2 id="fd-morning">Five ideas, in the order they happen</h2>
    <Moments />
  </section>

  <section class="fd-screen" aria-labelledby="fd-ways">
    <p class="fd-over">Three ways in</p>
    <h2 id="fd-ways">Open it, run it, or read it first</h2>
    <ul class="fd-ways">
      {WAYS.map((w) => (
        <li>
          <a class:list={['fd-way', { 'is-primary': w.primary }]} href={w.to} data-as={w.as}>
            <b>{w.word}</b>
            <span>{w.what}</span>
            <small>{w.note} →</small>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="fd-screen fd-stands" aria-labelledby="fd-where">
    <p class="fd-over">Where it stands</p>
    <h2 id="fd-where">What is real, what is simulated, what is not planned</h2>
    <dl class="fd-stand">
      {STANDS.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
    </dl>
    <p class="fd-links">{LINKROW.map(([w, to]) => <a href={to}>{w}</a>)}</p>
  </section>
</Front>

<style>
  .fd-hero { display: grid; gap: 36px; padding: 44px 0 8px; justify-items: center; }
  .fd-lead { display: grid; gap: 20px; justify-items: center; text-align: center; max-width: 760px; }
  .fd-lead h1 { margin: 0; font: 600 clamp(38px, 5.6vw, 70px)/1.02 var(--font-sans); letter-spacing: -.035em; color: var(--text); text-wrap: balance; }
  .fd-sentence { margin: 0; font-size: clamp(16px, 1.5vw, 19px); line-height: 1.5; color: var(--text-2); max-width: 58ch; text-wrap: pretty; }
  .fd-doors { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 6px; }
  .fd-door {
    display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 22px; border-radius: 12px;
    font: 550 15.5px/1 var(--font-sans); color: var(--text); text-decoration: none; background: var(--surface); border: 1px solid var(--line-strong);
    transition: background var(--dur-hover) var(--ease-settle), border-color var(--dur-hover) var(--ease-settle), transform var(--dur-press, 80ms) var(--ease-settle);
  }
  .fd-door:hover { color: var(--text); background: var(--surface-2); border-color: var(--text-3); }
  .fd-door:active { transform: scale(.97); }
  .fd-door small { font-size: 12.5px; font-weight: 500; opacity: .75; }
  .fd-primary { background: var(--ink); color: var(--on-ink); border-color: var(--ink); }
  .fd-primary:hover { background: var(--ink); color: var(--on-ink); border-color: var(--ink); opacity: .9; }
  .fd-hero :global(.hz) { width: 100%; }
  .fd-honest { margin: -20px 0 0; font-size: 13px; color: var(--text-3); text-align: center; }

  .fd-screen { display: grid; gap: 12px; padding-top: 112px; }
  .fd-over { margin: 0; font: 500 11px/1.2 var(--font-mono); letter-spacing: .09em; text-transform: uppercase; color: var(--text-3); }
  .fd-screen h2 { margin: 0 0 28px; font: 600 clamp(26px, 3vw, 38px)/1.12 var(--font-sans); letter-spacing: -.028em; max-width: 30ch; text-wrap: balance; }

  .fd-ways { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .fd-ways li { display: grid; min-width: 0; }
  .fd-way { display: grid; grid-template-rows: auto 1fr auto; gap: 10px; padding: 24px 24px 20px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-md); color: var(--text); text-decoration: none; transition: border-color var(--dur-hover) var(--ease-settle), transform var(--dur-hover) var(--ease-settle); }
  .fd-way:hover { color: var(--text); border-color: var(--text-3); transform: translateY(-2px); }
  .fd-way b { font: 600 19px/1.2 var(--font-sans); letter-spacing: -.015em; }
  .fd-way span { font-size: 14.5px; line-height: 1.5; color: var(--text-2); }
  .fd-way small { font-size: 13.5px; font-weight: 550; color: var(--accent-ink); }
  .fd-way.is-primary { background: var(--ink); color: var(--on-ink); border-color: var(--ink); }
  .fd-way.is-primary:hover { color: var(--on-ink); }
  .fd-way.is-primary span { color: color-mix(in srgb, var(--on-ink) 72%, transparent); }
  .fd-way.is-primary small { color: var(--on-ink); }

  .fd-stands { padding-bottom: 24px; }
  .fd-stand { margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .fd-stand div { display: grid; gap: 6px; align-content: start; padding-top: 14px; border-top: 1px solid var(--line-strong); }
  .fd-stand dt { font-size: 14px; font-weight: 600; }
  .fd-stand dd { margin: 0; font-size: 13.5px; line-height: 1.5; color: var(--text-2); }
  .fd-links { margin: 28px 0 0; display: flex; flex-wrap: wrap; gap: 6px 22px; font-size: 13.5px; }
  .fd-links a { display: inline-flex; align-items: center; min-height: 32px; color: var(--text-2); }
  .fd-links a:hover { color: var(--text); }

  @container fd (max-width: 1099px) {
    .fd-ways { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .fd-stand { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @container fd (max-width: 899px) {
    .fd-ways { grid-template-columns: minmax(0, 1fr); }
  }
  @container fd (max-width: 699px) {
    .fd-hero { padding-top: 32px; gap: 28px; }
    .fd-lead { gap: 16px; }
    .fd-screen { padding-top: 80px; }
    .fd-screen h2 { margin-bottom: 20px; }
    .fd-honest { margin-top: -12px; }
    .fd-door { flex: 1 1 100%; justify-content: center; }
  }
  @container fd (max-width: 459px) {
    .fd-stand { grid-template-columns: minmax(0, 1fr); }
  }
</style>
