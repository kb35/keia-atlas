{
  "name": "keia-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "A device-centric workplace technology console: space types, device models, ports, wiring and refresh planning, built on Keia.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "validate": "node tools/validate.mjs",
    "connect": "node tools/connectors/cli.mjs",
    "test": "node --env-file=tests/clock.env --test \"tests/**/*.test.mjs\"",
    "dev": "astro dev",
    "contrast": "node tools/contrast-check.mjs",
    "glitch": "node tools/glitch-check.mjs",
    "build": "npm run validate && node tools/contrast-check.mjs && astro build",
    "preview": "astro preview",
    "preview:files": "npm run build && node tools/static-preview.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "^7.3.5",
    "three": "^0.186.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "postcss": "^8.5.28"
  }
}
